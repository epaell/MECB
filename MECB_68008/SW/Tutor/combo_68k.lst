01:002060BC 72A0            	  5909: 	MOVEQ		#-96,d1			* set for no floating bits
01:002060BE 922B0594        	  5910: 	SUB.b		FAC1_e(a3),d1		* subtract FAC1 exponent
01:002060C2 6500E4FA        	  5911: 	BCS		LAB_OFER			* do overflow if too big
                            	  5912: 
01:002060C6 660E            	  5913: 	BNE.s		LAB_284G			* branch if exponent was not $A0
                            	  5914: 
01:002060C8 4A2B0595        	  5915: 	TST.b		FAC1_s(a3)			* test FAC1 sign
01:002060CC 6A1A            	  5916: 	BPL.s		LAB_284H			* branch if FAC1 +ve
                            	  5917: 
01:002060CE 4480            	  5918: 	NEG.l		d0
01:002060D0 6916            	  5919: 	BVS.s		LAB_284H			* branch if was $80000000
                            	  5920: 
01:002060D2 6000E4EA        	  5921: 	BRA		LAB_OFER			* do overflow if too big
                            	  5922: 
                            	  5923: LAB_284G
01:002060D6 B23C0020        	  5924: 	CMP.b		#$20,d1			* compare with minimum result for integer
01:002060DA 6502            	  5925: 	BCS.s		LAB_284L			* if < minimum just do shift
                            	  5926: 
01:002060DC 7000            	  5927: 	MOVEQ		#0,d0				* else return zero
                            	  5928: LAB_284L
01:002060DE E2A8            	  5929: 	LSR.l		d1,d0				* shift integer
                            	  5930: 
01:002060E0 4A2B0595        	  5931: 	TST.b		FAC1_s(a3)			* test FAC1 sign (b7)
01:002060E4 6A02            	  5932: 	BPL.s		LAB_284H			* branch if FAC1 +ve
                            	  5933: 
01:002060E6 4480            	  5934: 	NEG.l		d0				* negate integer value
                            	  5935: LAB_284H
01:002060E8 221F            	  5936: 	MOVE.l	(sp)+,d1			* restore d1
                            	  5937: LAB_284J
01:002060EA 2740042A        	  5938: 	MOVE.l	d0,Itemp(a3)		* save result to Itemp
01:002060EE 4E75            	  5939: 	RTS
