                            	  3927: *-------------------------------------------------------------------------
                            	  3928: * File RAMTEST   RAMTEST                                          11/02/81
                            	  3929: 
                            	  3930: ***********************************************************************
                            	  3931: * MEMORY TEST SUBROUTINE.                                             *
                            	  3932: *                                                                     *
                            	  3933: *        A0=BEGINNING ADDRESS (MUST BE EVEN ADDRESS)                  *
                            	  3934: *        A1=ENDING ADDRESS+1  (MUST BE EVEN ADDRESS)                  *
                            	  3935: *        A2=FAILING ADDRESS                                           *
                            	  3936: *        D0=DATA WRITTEN TO RAM                                       *
                            	  3937: *        D1=DATA READ FROM RAM                                        *
                            	  3938: *                                                                     *
                            	  3939: *        ZERO FLAG IS SET IF TEST IS SUCCESSFUL                       *
                            	  3940: *           REGISTERS D2,D3,D4 DESTROYED                              *
                            	  3941: ***********************************************************************
                            	  3942: 
                            	  3943: *       -1ST TEST-
                            	  3944: RAMTEST  DS      0
01:00201C74 2608            	  3945:          MOVE.L  A0,D3          D3 = BEGINNING ADDRESS
01:00201C76 2443            	  3946:          MOVE.L  D3,A2          USE A2 AS POINTER IN MEMORY
01:00201C78 70FE            	  3947: WALK3    MOVEQ   #-2,D0         PREPARE FOR "WALKING BIT" TEST
                            	  3948: WALK0
01:00201C7A 3480            	  3949:          MOVE.W  D0,(A2)        STORE D0 INTO MEMORY
01:00201C7C 3212            	  3950:          MOVE.W  (A2),D1        D1 CONTAINS RAM DATA
01:00201C7E B240            	  3951:          CMP.W   D0,D1          WRITTEN VS. READ
01:00201C80 6642            	  3952:          BNE.S   RAMERR         STOP ON ERROR
01:00201C82 E358            	  3953:          ROL.W   #1,D0          ROLL A ZERO IN A FIELD OF ONES
01:00201C84 65F4            	  3954:          BCS.S   WALK0          CONTINUE TILL DONE
                            	  3955: 
01:00201C86 7001            	  3956:          MOVEQ   #$00000001,D0  THIS TIME, WALK A 1 THROUGH ZEROS
                            	  3957: WALK1
01:00201C88 3480            	  3958:          MOVE.W  D0,(A2)        STORE D0 INTO MEMORY
01:00201C8A 3212            	  3959:          MOVE.W  (A2),D1        D1 CONTAINS RAM DATA
01:00201C8C B240            	  3960:          CMP.W   D0,D1          WRITTEN VS. READ
01:00201C8E 6634            	  3961:          BNE.S   RAMERR         STOP ON ERROR
01:00201C90 D040            	  3962:          ASL.W   #1,D0          ROLL A ONE TO THE NEXT POSITION
01:00201C92 64F4            	  3963:          BCC.S   WALK1          CONTINUE TILL DONE
                            	  3964: 
01:00201C94 45EA0100        	  3965:          LEA     $0100(A2),A2   GO TO NEXT 256TH POSITION
01:00201C98 B5C9            	  3966:          CMP.L   A1,A2          CHECK TO SEE IF DONE
01:00201C9A 6DDC            	  3967:          BLT.S   WALK3          CONTINUE
                            	  3968: 
                            	  3969: * -2ND TEST-
01:00201C9C 2443            	  3970:          MOVE.L  D3,A2          SET A2 TO POINT TO START OF MEMORY
01:00201C9E 7000            	  3971:          MOVEQ   #$00000000,D0  CLEAR D0
                            	  3972: MTCLR
01:00201CA0 34C0            	  3973:          MOVE.W  D0,(A2)+       CLEAR MEMORY
01:00201CA2 B5C9            	  3974:          CMP.L   A1,A2          DONE?
01:00201CA4 66FA            	  3975:          BNE.S   MTCLR          NO... ZERO ALL OF MEMORY
                            	  3976: 
01:00201CA6 74FF            	  3977:          MOVEQ   #-1,D2         SET D2 = FFFF
                            	  3978: MTSTOR1
01:00201CA8 3222            	  3979:          MOVE.W  -(A2),D1       FIRST READ BACK MEMORY
01:00201CAA B240            	  3980:          CMP.W   D0,D1          CHK AGAINST WHAT WAS WRITTEN
01:00201CAC 6616            	  3981:          BNE.S   RAMERR         STOP ON ERROR
01:00201CAE 3482            	  3982:          MOVE.W  D2,(A2)        STORE COMPLEMENT
01:00201CB0 B5C3            	  3983:          CMP.L   D3,A2          DONE?
01:00201CB2 66F4            	  3984:          BNE.S   MTSTOR1        NO... COMPLEMENT ALL OF MEMORY
01:00201CB4 3002            	  3985:          MOVE.W  D2,D0          D0=WHAT WAS WRITTEN
01:00201CB6 4642            	  3986:          NOT.W   D2             SAVE COMPLEMENT FOR LATER
                            	  3987: 
                            	  3988: MTSTOR0
01:00201CB8 3212            	  3989:          MOVE.W  (A2),D1        READ BACK MEMORY
01:00201CBA B240            	  3990:          CMP.W   D0,D1          CHK AGAINST WHAT WAS WRITTEN
01:00201CBC 6606            	  3991:          BNE.S   RAMERR         STOP ON ERROR
01:00201CBE 34C2            	  3992:          MOVE.W  D2,(A2)+       STORE COMPLEMENT
01:00201CC0 B5C9            	  3993:          CMP.L   A1,A2          DONE?
01:00201CC2 66F4            	  3994:          BNE     MTSTOR0        NO...KEEP LOOPING, YES...
                            	  3995: 
01:00201CC4 2043            	  3996: RAMERR   MOVE.L  D3,A0          RESTORE A0
01:00201CC6 4E75            	  3997:          RTS                    RETURN
                            	  3998: 
