01:00202304 0C505330        	  4799:          CMPI.W  #'S0',(A0)     HEADER RECORD?
01:00202308 6612            	  4800:          BNE.S   TAPEOUT2       NO
01:0020230A 137C00020009    	  4801:          MOVE.B  #2,9(A1)       YES, PC0 INPUT, PC1 OUTPUT
01:00202310 363C02BC        	  4802:          MOVE.W  #700,D3        OUTPUT NULLS (HEADER)
01:00202314 4200            	  4803: TAPEOUT1 CLR.B   D0
01:00202316 6120            	  4804:          BSR.S   TAPEO
01:00202318 5343            	  4805:          SUBQ.W  #1,D3
01:0020231A 66F8            	  4806:          BNE.S   TAPEOUT1
01:0020231C BBCE            	  4807: TAPEOUT2 CMP.L   A6,A5          SEE IF AT OR BEYOND END OF LINE
01:0020231E 6512            	  4808:          BCS.S   TAPEOUT4       NO. KEEP GOING.
01:00202320 16380654        	  4809:          MOVE.B  TAPENULS,D3    OUTPUT NULLS AFTER EACH RECORD
01:00202324 4200            	  4810: TAPEOUT5 CLR.B   D0             YES. OUTPUT A NULL
01:00202326 6110            	  4811:          BSR.S   TAPEO
