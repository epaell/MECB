                            	  5868: 
01:00202CE3 00              	  5869:          DC.B    0              PAD BYTE
                            	  5870: 
                            	  5871: TBLOPCE  DS      0
                            	  5872: 
                            	  5873: * WITHOUT LABEL FIELD
                            	  5874: * 012345678901234567890123456789012345678901234567890
                            	  5875: * AAAAAA DDDDDDDDDDDDDDDDDDDD OPCODE  OPERAND
                            	  5876: *        FDATA                FOC     FOP
                            	  5877: 
                            	  5878: * 012345678901234567890123456789012345678901234567890
                            	  5879: * AAAAAA DDDDDDDDDDDDDDDDDDDD LLLLLLLL OPCODE  OPERAND
                            	  5880: *        FDATA                FOL      FOC     FOP
                            	  5881: 
                            	  5882: * A3 = STORE POINTER
                            	  5883: * A4 = PROGRAM COUNTER
                            	  5884: * A5 = SOURCE PTR BEGINNING
                            	  5885: * A6 = SOURCE PTR END+1
                            	  5886: *
                            	  5887: OUTBSIZE EQU     80        BUFFER SIZE
                            	  5888: FDATA    EQU     10        OFFSET TO DATA
                            	  5889: FOL      EQU     31        OFFSET TO LABEL
                            	  5890: FOC      EQU     31        OFFSET TO OP-CODE (NO LABEL FIELD)
                            	  5891: FOP      EQU     39        OFFSET TO OPERAND (NO LABEL FIELD)
                            	  5892: 
01:00202CE4 4E51FFDE        	  5893: CODE68K  LINK    A1,#0-(ESKE-ESKB)
01:00202CE8 2F49001E        	  5894:          MOVE.L  A1,LINK(A7)    SAVE LINKAGE
01:00202CEC 224F            	  5895:          MOVE.L  A7,A1          A1 = BASE REGISTER TO DATA
                            	  5896: 
01:00202CEE 1CBC0020        	  5897:          MOVE.B  #BLANK,(A6)    INSURE LAST CHAR IS SPACE
                            	  5898: 
01:00202CF2 204B            	  5899:          MOVE.L  A3,A0
01:00202CF4 704F            	  5900:          MOVEQ   #OUTBSIZE-1,D0
01:00202CF6 10FC0020        	  5901: M300     MOVE.B  #BLANK,(A0)+   SPACE FILL BUFFER
01:00202CFA 51C8FFFA        	  5902:          DBRA    D0,M300
01:00202CFE 5588            	  5903:          SUBQ.L  #2,A0
01:00202D00 2348001A        	  5904:          MOVE.L  A0,PTRBUFE(A1) PTR TO END OF BUFFER
                            	  5905: 
01:00202D04 234C000E        	  5906:          MOVE.L  A4,PCOUNTER(A1)  FORMAT PC
01:00202D08 280C            	  5907:          MOVE.L  A4,D4          D4 = P-COUNTER
01:00202D0A 200C            	  5908:          MOVE.L  A4,D0
                            	  5909: 
01:00202D0C 2F0E            	  5910:          MOVE.L  A6,-(A7)       SAVE A6
01:00202D0E 2C4B            	  5911:          MOVE.L  A3,A6
01:00202D10 6100F11A        	  5912:          BSR     FRELADDR       FORM RELATIVE ADDRESS
01:00202D14 2C5F            	  5913:          MOVE.L  (A7)+,A6       RESTORE A6
                            	  5914: 
01:00202D16 7E01            	  5915:          MOVEQ   #1,D7          POSSIBLE ERROR CODE
01:00202D18 200C            	  5916:          MOVE.L  A4,D0
01:00202D1A E298            	  5917:          ROR.L   #1,D0
01:00202D1C 6B00013A        	  5918:          BMI     ERDONE         PC ODD ADDRESS
                            	  5919: 
01:00202D20 7E1F            	  5920:          MOVEQ   #FOL,D7        POSSIBLE ERROR CODE
01:00202D22 0C1D0020        	  5921:          CMPI.B  #BLANK,(A5)+
01:00202D26 66000130        	  5922:          BNE     ERDONE         1ST CHAR NOT SPACE
                            	  5923: 
01:00202D2A 137C0002000A    	  5924:          MOVE.B  #2,TNB(A1)     INZ # OF BYTES
01:00202D30 337C0040000C    	  5925:          MOVE.W  #$40,TLENGTH(A1)  SIZE = .W (DEFAULT)
01:00202D36 4229000B        	  5926:          CLR.B   TLSPEC(A1)     DEFAULT (SIZE NOT SPECIFIED)
                            	  5927: 
01:00202D3A 204B            	  5928:          MOVE.L  A3,A0          A0 = STORE ADDRESS
01:00202D3C 41E8001F        	  5929:          ADD.L   #FOC,A0
                            	  5930: 
01:00202D40 61000108        	  5931: M340     BSR     GETCHARF       GET PAST SPACES
01:00202D44 0C000020        	  5932:          CMPI.B  #BLANK,D0
01:00202D48 67F6            	  5933:          BEQ     M340
                            	  5934: 
01:00202D4A 538D            	  5935:          SUBQ.L  #1,A5          FORMAT OP-CODE
01:00202D4C 610000FC        	  5936: M350     BSR     GETCHARF
01:00202D50 10C0            	  5937:          MOVE.B  D0,(A0)+
01:00202D52 0C00002E        	  5938:          CMPI.B  #'.',D0
01:00202D56 6628            	  5939:          BNE.S   M352
                            	  5940: 
01:00202D58 1355000B        	  5941:          MOVE.B  (A5),TLSPEC(A1)  NOT DEFAULT
01:00202D5C 0C150057        	  5942:          CMPI.B  #'W',(A5)
01:00202D60 671E            	  5943:          BEQ.S   M352
01:00202D62 0C150053        	  5944:          CMPI.B  #'S',(A5)
01:00202D66 6718            	  5945:          BEQ.S   M352           .SHORT = .WORD
01:00202D68 4269000C        	  5946:          CLR.W   TLENGTH(A1)
01:00202D6C 0C150042        	  5947:          CMPI.B  #'B',(A5)
01:00202D70 670E            	  5948:          BEQ.S   M352           SIZE = .W
01:00202D72 337C0080000C    	  5949:          MOVE.W  #$80,TLENGTH(A1)
01:00202D78 0C15004C        	  5950:          CMPI.B  #'L',(A5)
01:00202D7C 660000D4        	  5951:          BNE     ERF
                            	  5952: 
01:00202D80 0C000020        	  5953: M352     CMPI.B  #BLANK,D0
01:00202D84 66C6            	  5954:          BNE     M350           NOT SPACE CONTINUE
                            	  5955: 
                            	  5956: * SEARCH OP-CODE TABLE
01:00202D86 41FAFC58        	  5957:          LEA     TBLOPC(PC),A0  A0 = PTR TO TABLE OF CODES
01:00202D8A 244B            	  5958: M410     MOVE.L  A3,A2          A3 = START OF STORE BUFFER
01:00202D8C 45EA001F        	  5959:          ADD.L   #FOC,A2        A2 = PTR TO OP-CODE JUST FORMATTED
                            	  5960: 
01:00202D90 1018            	  5961: M415     MOVE.B  (A0)+,D0       XXXXXXDD
01:00202D92 4880            	  5962:          EXT.W   D0             XXXXSSDD  SIGN EXTENDED
01:00202D94 0200007F        	  5963:          ANDI.B  #$7F,D0
01:00202D98 B01A            	  5964:          CMP.B   (A2)+,D0
01:00202D9A 6606            	  5965:          BNE.S   M420           NON-MATCH
01:00202D9C 4A40            	  5966:          TST.W   D0
01:00202D9E 6AF0            	  5967:          BPL     M415           SIGN RESET; CONTINUE
01:00202DA0 6018            	  5968:          BRA.S   M430           MATCH COMPLETE
                            	  5969: 
01:00202DA2 4A40            	  5970: M420     TST.W   D0             SEQUENCE TO NEXT CODE
01:00202DA4 6B04            	  5971:          BMI.S   M426
01:00202DA6 1018            	  5972: M424     MOVE.B  (A0)+,D0
01:00202DA8 6AFC            	  5973:          BPL     M424           FINISH THIS OP-CODE
01:00202DAA 5688            	  5974: M426     ADDQ.L  #3,A0          ADJUST PTR TO TABLE
01:00202DAC 45FAFF36        	  5975:          LEA     TBLOPCE(PC),A2
01:00202DB0 B5C8            	  5976:          CMP.L   A0,A2
01:00202DB2 66D6            	  5977:          BNE     M410
                            	  5978: 
01:00202DB4 7E1F            	  5979: M428     MOVEQ   #FOC,D7        ERROR CODE
01:00202DB6 600000A0        	  5980:          BRA     ERDONE
                            	  5981: 
                            	  5982: * GET GOTO INDEX
                            	  5983: * GET FIRST WORD MASK
01:00202DBA 1012            	  5984: M430     MOVE.B  (A2),D0        MUST TERMINATE OP-CODE
01:00202DBC 0C000020        	  5985:          CMPI.B  #BLANK,D0        WITH SPACE OR PERIOD
01:00202DC0 6706            	  5986:          BEQ.S   M432
01:00202DC2 0C00002E        	  5987:          CMPI.B  #'.',D0
01:00202DC6 66EC            	  5988:          BNE     M428           ERROR
                            	  5989: M432
                            	  5990: 
01:00202DC8 7000            	  5991:          CLR.L   D0
01:00202DCA 1018            	  5992:          MOVE.B  (A0)+,D0       D0 =  KEYS  INDEX
01:00202DCC 1200            	  5993:          MOVE.B  D0,D1          D1 =  KEYS (INDEX)
01:00202DCE 0200003F        	  5994:          ANDI.B  #$3F,D0        D0 =        INDEX
01:00202DD2 D080            	  5995:          ASL.L   #1,D0          INDEX * TWO
01:00202DD4 1418            	  5996:          MOVE.B  (A0)+,D2
01:00202DD6 E14A            	  5997:          LSL.W   #8,D2
01:00202DD8 1418            	  5998:          MOVE.B  (A0)+,D2       D2 = FIRST WORD MASK
01:00202DDA 3282            	  5999:          MOVE.W  D2,(A1)        *D2,TDATA(A1)
                            	  6000: 
                            	  6001: * INSURE .S .W MATCH OP-CODE
                            	  6002: 
01:00202DDC 1629000B        	  6003:          MOVE.B  TLSPEC(A1),D3  D3 = .n SPECIFIED
01:00202DE0 671A            	  6004:          BEQ.S   M4326          NOT SPECIFIED
01:00202DE2 08010006        	  6005:          BTST    #6,D1
01:00202DE6 670E            	  6006:          BEQ.S   M4324          .W ALLOWED (.S NOT ALLOWED)
01:00202DE8 0C030057        	  6007:          CMPI.B  #'W',D3
01:00202DEC 67C6            	  6008:          BEQ     M428           .W NOT ALLOWED
01:00202DEE 0C030042        	  6009:          CMPI.B  #'B',D3
01:00202DF2 67C0            	  6010:          BEQ     M428           .B NOT ALLOWED
01:00202DF4 6006            	  6011:          BRA.S   M4326
                            	  6012: 
01:00202DF6 0C030053        	  6013: M4324    CMPI.B  #'S',D3
01:00202DFA 67B8            	  6014:          BEQ     M428           .S NOT ALLOWED
                            	  6015: M4326
                            	  6016: 
                            	  6017: * CALCULATE GOTO ADDRESS
                            	  6018: 
01:00202DFC 41FAFB96        	  6019:          LEA     TBLKEYS(PC),A0 A0 = PTR TO KEYS
01:00202E00 30300000        	  6020:          MOVE.W  (A0,D0),D0     D0 = 16 BIT OFFSET
01:00202E04 45FAF884        	  6021:          LEA     XBASE(PC),A2   A2 = BASE ADDRESS
01:00202E08 D5C0            	  6022:          ADD.L   D0,A2          A2 = COMPUTED GO TO  ADDRESS
                            	  6023: 
                            	  6024: * FORMAT OPERAND IF REGUIRED
                            	  6025: 
01:00202E0A 4A01            	  6026:          TST.B   D1             LOOK AT KEY
01:00202E0C 6B20            	  6027:          BMI.S   M440           OPERAND NOT REQUIRED
                            	  6028: 
