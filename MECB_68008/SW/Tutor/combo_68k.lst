01:00206CD4 277CC90FDAA20590	  7766: 	MOVE.l	#$C90FDAA2,FAC1_m(a3)	* 2pi mantissa (32 bit)
01:00206CDC 377C83000594    	  7767: 	MOVE.w	#$8300,FAC1_e(a3)		* 2pi exponent and sign
