                            	  5636: ****************************************************************************
                            	  5637: *
                            	  5638: *        ROUTINES TO TEST FOR VALID EFFECTIVE ADDRESSES
                            	  5639: *
                            	  5640: *        EA16BIT   tests that -32768 <= D5 <= 65535.  (signed or unsigned)
                            	  5641: *        EA16BITS  tests that -32768 <= D5 <= 32767.  (signed only)
                            	  5642: *        EA8BIT    tests that   -128 <= D5 <=   255.  (signed or unsigned)
                            	  5643: *        EA8BITS   tests that   -128 <= D5 <=   127.  (signed only)
                            	  5644: *
                            	  5645: *        The 16-bit tests branch to ER if invalid, else return.
                            	  5646: *        The  8-bit tests return condition codes <EQ> if valid, else <NE>.
                            	  5647: *        D5 is preserved unless a branch to ER results.
                            	  5648: *        D1 is destroyed.
                            	  5649: *
                            	  5650: ****************************************************************************
                            	  5651: 
                            	  5652: EA16BIT:
01:00202960 610C            	  5653:          BSR.S   EA16BITC       CHECK RANGE -32768 TO 32767.  IF
01:00202962 2205            	  5654:          MOVE.L  D5,D1          INVALID, CHECK WHETHER THE HIGH 16
01:00202964 4841            	  5655:          SWAP    D1             BITS ARE 0 (WHICH IMPLIES THAT
01:00202966 4A41            	  5656:          TST.W   D1             D5 <= 65535).  IF NOT, FALL THRU TO
01:00202968 6728            	  5657:          BEQ.S   EASEX          THE 16-BIT SIGNED TEST--WE WILL
                            	  5658: *                               FAIL AND GO TO ER.
                            	  5659: 
                            	  5660: EA16BITS:
01:0020296A 487A04E8        	  5661:          PEA     ER(PC)         SET UP TO RETURN TO ER IF INVALID.
                            	  5662: 
01:0020296E 223C00007FFF    	  5663: EA16BITC MOVE.L  #$7FFF,D1      D1  <--  2^16-1.
01:00202974 600E            	  5664:          BRA.S   EAS            GO TO THE COMMON TEST ROUTINE.
                            	  5665: 
                            	  5666: 
                            	  5667: EA8BIT:
01:00202976 610A            	  5668:          BSR.S   EA8BITC        CHECK RANGE -128 TO 127.  IF INVALID,
01:00202978 2205            	  5669:          MOVE.L  D5,D1          CHECK WHETHER THE HIGH 24 BITS ARE
01:0020297A E089            	  5670:          LSR.L   #8,D1          0 (WHICH IMPLIES THAT D5 <= 255).
01:0020297C 4E75            	  5671:          RTS
                            	  5672: 
                            	  5673: EA8BITS:
01:0020297E 6102            	  5674:          BSR.S   EA8BITC        JUST CHECK FOR -127 <= D5 <= 128.
01:00202980 4E75            	  5675:          RTS                    ; (BSR PUTS NEEDED ADDRESS ON STACK!)
                            	  5676: 
01:00202982 727F            	  5677: EA8BITC  MOVEQ   #$7F,D1        D1  <--  2^8 - 1.
                            	  5678: 
                            	  5679: *                  *** NOTE: THIS ROUTINE PLAYS WITH THE STACK ***
01:00202984 BA81            	  5680: EAS      CMP.L   D1,D5          IF D5 > 2^N-1, RETURN WITH <NE> (INVAL).
01:00202986 6E0A            	  5681:          BGT.S   EASEX
01:00202988 4681            	  5682:          NOT.L   D1             IF D5 < -2^N,  RETURN WITH <NE> (INVAL).
01:0020298A BA81            	  5683:          CMP.L   D1,D5
01:0020298C 6D04            	  5684:          BLT.S   EASEX
                            	  5685: 
01:0020298E 588F            	  5686:          ADDQ.L  #4,A7          POP THE RETURN ADDRESS OFF THE STACK,
01:00202990 7200            	  5687:          CLR.L   D1             SET <EQ> (VALID), AND RETURN.
                            	  5688: 
01:00202992 4E75            	  5689: EASEX    RTS
