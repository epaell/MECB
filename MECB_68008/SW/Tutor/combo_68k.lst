01:00200E8A 7C02            	  2070:          MOVEQ   #2,D6          THE BYTE COUNT
01:00200E8C 7800            	  2071:          CLR.L   D4             CLEAR THE CHECKSUM
01:00200E8E 2CFC53303F3F    	  2072:          MOVE.L  #'S0??',(A6)+  START OF S RECORD
01:00200E94 2CFC30303030    	  2073:          MOVE.L  #'0000',(A6)+  DUMMY ADDRESS
