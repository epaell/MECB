                            	  5720: 
                            	  5721: *************************************************************************************
                            	  5722: *
                            	  5723: * set numeric variable, pack FAC1 into Lvarpl
                            	  5724: 
                            	  5725: LAB_PFAC
01:00205FDE 2F08            	  5726: 	MOVE.l	a0,-(sp)			* save pointer
01:00205FE0 206B0472        	  5727: 	MOVEA.l	Lvarpl(a3),a0		* get destination pointer
01:00205FE4 082B000605B5    	  5728: 	BTST		#6,Dtypef(a3)		* test data type
01:00205FEA 670C            	  5729: 	BEQ.s		LAB_277C			* branch if floating
                            	  5730: 
01:00205FEC 610000C6        	  5731: 	BSR		LAB_2831			* convert FAC1 floating to fixed
                            	  5732: 							* result in d0 and Itemp
01:00205FF0 2080            	  5733: 	MOVE.l	d0,(a0)			* save in var
01:00205FF2 205F            	  5734: 	MOVE.l	(sp)+,a0			* restore pointer
01:00205FF4 4E75            	  5735: 	RTS
                            	  5736: 
                            	  5737: 
                            	  5738: *************************************************************************************
                            	  5739: *
                            	  5740: * normalise round and pack FAC1 into (a0)
                            	  5741: 
                            	  5742: LAB_2778
01:00205FF6 2F08            	  5743: 	MOVE.l	a0,-(sp)			* save pointer
                            	  5744: LAB_277C
01:00205FF8 6100FD60        	  5745: 	BSR		LAB_24D5			* normalise FAC1
01:00205FFC 612C            	  5746: 	BSR.s		LAB_27BA			* round FAC1
01:00205FFE 202B0590        	  5747: 	MOVE.l	FAC1_m(a3),d0		* get FAC1 mantissa
01:00206002 E098            	  5748: 	ROR.l		#8,d0				* align 24/32 bit mantissa
01:00206004 4840            	  5749: 	SWAP		d0				* exponent/sign into 0-15
01:00206006 C07C007F        	  5750: 	AND.w		#$7F,d0			* clear exponent and sign bit
01:0020600A 022B00800595    	  5751: 	ANDI.b	#$80,FAC1_s(a3)		* clear non sign bits in sign
01:00206010 806B0594        	  5752: 	OR.w		FAC1_e(a3),d0		* OR in exponent and sign
01:00206014 4840            	  5753: 	SWAP		d0				* move exponent and sign back to 16-31
01:00206016 2080            	  5754: 	MOVE.l	d0,(a0)			* store in destination
01:00206018 205F            	  5755: 	MOVE.l	(sp)+,a0			* restore pointer
01:0020601A 4E75            	  5756: 	RTS
