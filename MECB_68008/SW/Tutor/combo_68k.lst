                            	  4002: *-------------------------------------------------------------------------
                            	  4003: * File TM        TM  Transparent mode                             12/28/81
                            	  4004: 
                            	  4005: *    TM  [[EXIT CHAR]TRAILING CHAR]
                            	  4006: *
                            	  4007: *  In transparent mode the terminal is physically connected to the
                            	  4008: *  host; at the same time the terminal is watched by TM software
                            	  4009: *  for the EXIT character.  When the exit character is transmitted
                            	  4010: *  by the terminal it goes directly to the host; and at the same
                            	  4011: *  time the TM software reconfigures the hardware.  If a nonnull
                            	  4012: *  trailing character is present it is now sent via port 2 to
                            	  4013: *  the host.
                            	  4014: 
                            	  4015: *   TRANSPARENT MODE
                            	  4016: 
01:00201CC8 41FA0012        	  4017: TMCMD    LEA     P2CMD0(PC),A0
01:00201CCC 610001FE        	  4018:          BSR     FNEXTF         FIND NEXT FIELD
01:00201CD0 11DD04EB        	  4019:          MOVE.B  (A5)+,TMCHARS+1 QUIT CHARACTER
01:00201CD4 610001F6        	  4020:          BSR     FNEXTF         FIND NEXT FIELD
01:00201CD8 11DD04EA        	  4021:          MOVE.B  (A5)+,TMCHARS  OPTIONAL TRAILING CHAR
01:00201CDC 3E3804EA        	  4022: P2CMD0   MOVE.W  TMCHARS,D7
01:00201CE0 610003E8        	  4023:          BSR     GETSER1        ADDRESS FOR PORT1 INTO A0
01:00201CE4 4BFA007A        	  4024:          LEA     MSG006(PC),A5  "TRANSPARENT MODE"
01:00201CE8 6100E814        	  4025:          BSR     FIXDCRLF       SET UP FOR MESSAGE
01:00201CEC 2007            	  4026:          MOVE.L  D7,D0          EXIT CHARACTER
01:00201CEE 61000120        	  4027:          BSR     PNT2HX         PRINT 2 HEX CHARACTERS
01:00201CF2 3CFC203D        	  4028:          MOVE.W  #' =',(A6)+
01:00201CF6 1007            	  4029:          MOVE.B  D7,D0          SEE IF CONTROL CHAR
01:00201CF8 0C000020        	  4030:          CMPI.B  #BLANK,D0
01:00201CFC 6A0A            	  4031:          BPL.S   P2CMD01
01:00201CFE 2CFC2043544C    	  4032:          MOVE.L  #' CTL',(A6)+
01:00201D04 06000040        	  4033:          ADDI.B  #64,D0         MAKE IT A PRINTABLE CHARACTER
01:00201D08 1CFC0020        	  4034: P2CMD01  MOVE.B  #BLANK,(A6)+
01:00201D0C 1CC0            	  4035:          MOVE.B  D0,(A6)+
01:00201D0E 3CFC0D0A        	  4036:          MOVE.W  #$0D0A,(A6)+
01:00201D12 61000334        	  4037:          BSR     OUT1CR         GO PRINT BUFFER WITH CRLF
                            	  4038: 
01:00201D16 10390000064C    	  4039:          MOVE.B  MD1CON.L,D0    PROGRAM ACIA FOR TRANSPARENT MODE
01:00201D1C 0200009F        	  4040:          ANDI.B  #$9F,D0
01:00201D20 00000040        	  4041:          ORI.B   #$40,D0        FORCE RTS HIGH
01:00201D24 1080            	  4042:          MOVE.B  D0,(A0)
01:00201D26 08100000        	  4043: P2CMD2   BTST.B  #$0,(A0)      READ STATUS
01:00201D2A 67FA            	  4044:          BEQ.S   P2CMD2
01:00201D2C 10280001        	  4045:          MOVE.B  1(A0),D0       RECEIVE CHAR FROM PORT 1
01:00201D30 0200007F        	  4046:          ANDI.B  #$7F,D0
01:00201D34 B007            	  4047:          CMP.B   D7,D0          SEE IF QUIT CHARACTER (CTL A USUALLY)
01:00201D36 66EE            	  4048:          BNE.S   P2CMD2
01:00201D38 10390000064C    	  4049:          MOVE.B  MD1CON.L,D0    REPROGRAM FOR NON-TRANSPARENT
01:00201D3E 0200009F        	  4050:          ANDI.B  #$9F,D0
01:00201D42 1080            	  4051:          MOVE.B  D0,(A0)
                            	  4052: 
01:00201D44 E047            	  4053:          ASR.W   #8,D7
01:00201D46 4A07            	  4054:          TST.B   D7
01:00201D48 6712            	  4055:          BEQ.S   P2CMD6
                            	  4056: * SPECIAL SECOND CHAR TO HOST SEQUENCE
01:00201D4A 203C00001000    	  4057:          MOVE.L  #DELAYC1,D0
01:00201D50 5380            	  4058: P2CMD4   SUBQ.L  #1,D0          DELAY; ALLOW HOST TO SYNC
01:00201D52 66FC            	  4059:          BNE.S   P2CMD4
01:00201D54 61000386        	  4060:          BSR     GETSER2
01:00201D58 11470001        	  4061:          MOVE.B  D7,1(A0)       SEND CHAR
01:00201D5C 6000E8D0        	  4062: P2CMD6   BRA     MACSBUG
                            	  4063: 
01:00201D60 2A5452414E535041	  4064: MSG006   DC.B    '*TRANSPARENT* EXIT=$',EOT
