01:00200EE8 7C03            	  2109:          MOVEQ   #3,D6          BYTE COUNT
01:00200EEA 200B            	  2110:          MOVE.L  A3,D0          FIX UP CHECKSUM
01:00200EEC D800            	  2111:          ADD.B   D0,D4          LOW BYTE
01:00200EEE E040            	  2112:          ASR     #8,D0          SHIFT IT OVER
01:00200EF0 D800            	  2113:          ADD.B   D0,D4          MIDDLE BYTE
