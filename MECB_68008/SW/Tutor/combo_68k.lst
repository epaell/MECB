01:00200FD4 00468000        	  2271:          ORI.W   #$8000,D6      (GANPM)  SET NEED PLUS MINUS
01:00200FD8 6094            	  2272: GAP111S  BRA     GAP111
                            	  2273: 
                            	  2274: * (*) (-) SET ARITHMETIC OPERATOR
                            	  2275: 
01:00200FDA 4A06            	  2276: GAP121   TST.B   D6             (GAPMS)
01:00200FDC 6644            	  2277:          BNE.S   GAE            MULTI OPERATORS
01:00200FDE 1C00            	  2278:          MOVE.B  D0,D6          (GAPMS)
01:00200FE0 024600FF        	  2279:          ANDI.W  #$00FF,D6      RESET (GANPM) NEED PLUS MINUS
01:00200FE4 60F2            	  2280:          BRA     GAP111S
                            	  2281: 
                            	  2282: *  ]  CLOSE INDIRECT
                            	  2283: 
