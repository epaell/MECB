01:00206AF6 41EB05CE        	  7461: 	LEA		Hexss(a3),a0		* point to string
01:00206AFA 7830            	  7462: 	MOVEQ		#$30,d4			* "0" character for ABCD
                            	  7463: NextH1
01:00206AFC 1600            	  7464: 	MOVE.b	d0,d3				* copy lowest byte
01:00206AFE E898            	  7465: 	ROR.l		#4,d0				* shift nibble into 0-3
01:00206B00 C63C000F        	  7466: 	AND.b		#$0F,d3			* just this nibble
01:00206B04 1A03            	  7467: 	MOVE.b	d3,d5				* copy it
01:00206B06 DA3C00F6        	  7468: 	ADD.b		#$F6,d5			* set extend bit
01:00206B0A C704            	  7469: 	ABCD		d4,d3				* decimal add extend and character to zero
01:00206B0C 11832000        	  7470: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:00206B10 51CAFFEA        	  7471: 	DBF		d2,NextH1			* decrement and loop if not done
                            	  7472: 
01:00206B14 60A2            	  7473: 	BRA.s		EndBHS			* go process string
