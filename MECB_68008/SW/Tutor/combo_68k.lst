                            	  5795: 
                            	  5796: *************************************************************************************
                            	  5797: *
                            	  5798: * get FAC1 sign
                            	  5799: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5800: 
                            	  5801: LAB_27CA
01:00206056 7000            	  5802: 	MOVEQ		#0,d0				* clear d0
01:00206058 102B0594        	  5803: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:0020605C 67F6            	  5804: 	BEQ.s		RTS_017			* exit if zero (already correct SGN(0)=0)
                            	  5805: 
                            	  5806: 
                            	  5807: *************************************************************************************
                            	  5808: *
                            	  5809: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5810: * no = 0 check
                            	  5811: 
                            	  5812: LAB_27CE
01:0020605E 102B0595        	  5813: 	MOVE.b	FAC1_s(a3),d0		* else get FAC1 sign (b7)
                            	  5814: 
                            	  5815: 
                            	  5816: *************************************************************************************
                            	  5817: *
                            	  5818: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5819: * no = 0 check, sign in d0
                            	  5820: 
                            	  5821: LAB_27D0
01:00206062 4880            	  5822: 	EXT.w		d0				* make word
01:00206064 48C0            	  5823: 	EXT.l		d0				* make longword
01:00206066 E080            	  5824: 	ASR.l		#8,d0				* move sign bit through byte to carry
01:00206068 65EA            	  5825: 	BCS.s		RTS_017			* exit if carry set
