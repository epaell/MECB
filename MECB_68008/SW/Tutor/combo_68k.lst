                            	  2800: *-------------------------------------------------------------------------
                            	  2801: * File LOAD      LO & VE (Load & Verify) Commands.                02/22/82
                            	  2802: 
                            	  2803: * THIS FUNCTION
                            	  2804: *   1.) READS A "S-RECORD"
                            	  2805: *   2.) FORMATS THE DATA ON THE STACK
                            	  2806: *   3.) CALCULATES THE CHECKSUM
                            	  2807: *   4.) THEN STORES (VERIFIES) THE DATA TO MEMORY
                            	  2808: *
                            	  2809: * WHEN VERIFYING RECORDS MAKE BE SKIPPED WHILE DISPLAYING THE MISS-MATCHED
                            	  2810: *  RECORDS.  DISPLAY FORMAT
                            	  2811: *   S1CCAAAA.-.-.-33.-
                            	  2812: *     CC                     BYTE COUNT
                            	  2813: *       AAAA                 ADDRESS
                            	  2814: *           .-.-.-  .-       DATA FIELDS THAT MATCHED
                            	  2815: *                 33         DATA MISS MATCH (DISPLAY DATA FROM S-RECORD)
                            	  2816: 
                            	  2817: *   ***LOAD*** AND ***VERIFY***  'S' RECORDS
                            	  2818: *
                            	  2819: *        D4 = ERROR FLAG
                            	  2820: *
                            	  2821: *        D5 = V000I0CC
                            	  2822: *             0.......  = LOAD
                            	  2823: *             8.......  = VERIFY
                            	  2824: *             ....0...  = CALCULATE CHECKSUM
                            	  2825: *             ....8...  = IGNORE CHECKSUM
                            	  2826: *             ......CC  = CHECKSUM
                            	  2827: 
01:0020141E 7A01            	  2828: VECMD    MOVEQ   #1,D5          MARK THE MODE
01:00201420 E29D            	  2829:          ROR.L   #1,D5          D5 = $80000000
01:00201422 6002            	  2830:          BRA.S   CHKCHKS        GO CHECK CHECKSUM OPTION
                            	  2831: 
01:00201424 7A00            	  2832: LOCMD    CLR.L   D5             READ MODE
01:00201426 7800            	  2833: CHKCHKS  CLR.L   D4             RESET ERROR FLAG
01:00201428 61001184        	  2834:          BSR     SCANPORT       SET UP OUTPUT P1,P2,P3 ETC
                            	  2835: 
                            	  2836: * SEE IF CHECKSUM -C OPTION AND =SEND THIS OPTION
                            	  2837: 
01:0020142C BBCE            	  2838: READ01   CMP.L   A6,A5          SEE IF AT END OF BUFFER
01:0020142E 643C            	  2839:          BCC.S   READ09
01:00201430 101D            	  2840:          MOVE.B  (A5)+,D0       GET A CHARACTER
01:00201432 0C00003D        	  2841: READ03   CMPI.B  #'=',D0        SEE IF EQUAL SIGN
01:00201436 6730            	  2842:          BEQ.S   READ08
                            	  2843: 
01:00201438 0C000058        	  2844:          CMPI.B  #'X',D0        SEE IF ECHO
01:0020143C 6606            	  2845:          BNE.S   READ021
01:0020143E 1A3C00FF        	  2846:          MOVE.B  #-1,D5         D5.B = ECHO TO PORT ONE
01:00201442 60E8            	  2847:          BRA     READ01
                            	  2848: 
01:00201444 0C00002D        	  2849: READ021  CMPI.B  #'-',D0        SEE IF MINUS SIGN
01:00201448 66E2            	  2850:          BNE.S   READ01
01:0020144A BBCE            	  2851:          CMP.L   A6,A5          SEE IF AT END OF BUFFER
01:0020144C 671E            	  2852:          BEQ.S   READ09
01:0020144E 101D            	  2853:          MOVE.B  (A5)+,D0       GRAB SECOND CHARACTER
01:00201450 0C000043        	  2854:          CMPI.B  #'C',D0        SEE IF LETTER C AS IN -C
01:00201454 66DC            	  2855:          BNE     READ03
01:00201456 00458000        	  2856:          ORI.W   #$8000,D5      MARK AS IGNORE CHECKSUM
01:0020145A 60D0            	  2857:          BRA     READ01
                            	  2858: 
01:0020145C 7C00            	  2859: READS1   CLR.L   D6             D6 = TYPE "S1"
01:0020145E 5983            	  2860:          SUBQ.L  #4,D3          BYTE COUNT
                            	  2861: 
01:00201460 7000            	  2862:          CLR.L   D0
01:00201462 6100013C        	  2863:          BSR     READHEX4       FORM ADDRESS
01:00201466 6066            	  2864:          BRA.S   READS202
                            	  2865: 
01:00201468 61000C02        	  2866: READ08   BSR     OUTPUT2        SEND REST OF LINE(+CR) TO PORT
                            	  2867: 
01:0020146C 11C504E2        	  2868: READ09   MOVE.B  D5,ECHOPT1     MOVE ECHO FLAG
01:00201470 21F80630061C    	  2869:          MOVE.L  OUTPORT1,OUTTO SEND OUTPUT TO CONSOLE
                            	  2870: 
                            	  2871: 
01:00201476 4FF80786        	  2872: READ0    LEA     SYSTACK,A7     FORCE STACK (FOR ERROR RECOVERY)
                            	  2873: 
01:0020147A 4E54FFBC        	  2874:          LINK    A4,#-((BUFFSIZE/2)+4)  CREATE BUFFER ON STACK
                            	  2875: 
01:0020147E 4205            	  2876:          CLR.B   D5             ZERO CHECKSUM
                            	  2877: 
01:00201480 61000C6C        	  2878:          BSR     FIXBUF         START OF INPUT BUFFER
01:00201484 61000F94        	  2879:          BSR     PORTIN2        GET A RECORD FROM PORT
                            	  2880: 
01:00201488 264D            	  2881:          MOVE.L  A5,A3 SAVE     START ADDRESS OF BUFFER
01:0020148A 101B            	  2882: READ00   MOVE.B  (A3)+,D0       GET FIRST CHARACTER
01:0020148C BDCB            	  2883:          CMP.L   A3,A6
01:0020148E 65E6            	  2884:          BCS     READ0          END OF BUFFER WITHOUT "S"
                            	  2885: 
01:00201490 0C000053        	  2886: READ005  CMPI.B  #'S',D0        SEE IF IT IS AN S
01:00201494 66F4            	  2887:          BNE     READ00         GET ANOTHER CHARACTER
01:00201496 610000C4        	  2888:          BSR     GETCHR         GET RECORD TYPE
01:0020149A 2C00            	  2889:          MOVE.L  D0,D6
                            	  2890: 
01:0020149C 610000B0        	  2891:          BSR     READHEX        GET CHAR COUNT
01:002014A0 7600            	  2892:          CLR.L   D3
01:002014A2 1600            	  2893:          MOVE.B  D0,D3
                            	  2894: 
01:002014A4 0C060030        	  2895:          CMPI.B  #'0',D6        'S0'???
01:002014A8 67CC            	  2896:          BEQ     READ0          JUST IGNORE
01:002014AA 0C060031        	  2897:          CMPI.B  #'1',D6
01:002014AE 67AC            	  2898:          BEQ.S   READS1         S1 RECORD TYPE (2 BYTE ADDRESS)
01:002014B0 0C060038        	  2899:          CMPI.B  #'8',D6
01:002014B4 670000F6        	  2900:          BEQ     READS8         S8 RECORD TYPE
01:002014B8 0C060039        	  2901:          CMPI.B  #'9',D6
01:002014BC 670000FE        	  2902:          BEQ     READS9         S9 RECORD TYPE
01:002014C0 0C060032        	  2903:          CMPI.B  #'2',D6
01:002014C4 66CA            	  2904:          BNE.S   READ005        KEEP LOOKING FOR "Sn"
                            	  2905: 
01:002014C6 7C02            	  2906: READS2   MOVEQ   #2,D6          D6 = TYPE = S2 (3 BYTE ADDRESS)
01:002014C8 610000D0        	  2907:          BSR     READHEX6
01:002014CC 5B83            	  2908:          SUBQ.L  #5,D3          BYTE COUNT
01:002014CE 2943FFBC        	  2909: READS202 MOVE.L  D3,CC(A4)
                            	  2910: 
01:002014D2 2940FFC0        	  2911:          MOVE.L  D0,ADDRESS(A4) ADDRESS + OFFSET
01:002014D6 45ECFFC4        	  2912:          LEA     LDATA(A4),A2   A2 = STORE TO STACK POINTER
                            	  2913: 
01:002014DA 6172            	  2914: READ100  BSR.S   READHEX        GET DATA BYTE
01:002014DC 14C0            	  2915:          MOVE.B  D0,(A2)+       MOVE DATA TO STACK
01:002014DE 51CBFFFA        	  2916:          DBRA    D3,READ100
                            	  2917: 
01:002014E2 4A45            	  2918:          TST.W   D5
01:002014E4 6B0A            	  2919:          BMI.S   READ120        IGNORE CHECKSUM
