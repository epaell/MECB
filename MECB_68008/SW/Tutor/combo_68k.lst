01:00205E02 7A1E            	  5335: 	MOVEQ		#30,d5			* loop 31 times
01:00205E04 7801            	  5336: 	MOVEQ		#1,d4				* set shift count
01:00205E06 6006            	  5337: 	BRA.s		LAB_LOCC			* entry point for loop
                            	  5338: 
                            	  5339: LAB_LAAD
01:00205E08 E8A2            	  5340: 	ASR.l		d4,d2				* x1 >> i
01:00205E0A 9282            	  5341: 	SUB.l		d2,d1				* y = y - x1
01:00205E0C DC90            	  5342: 	ADD.l		(a0),d6			* z = z + tanh(i)
                            	  5343: LAB_LOCC
01:00205E0E 2400            	  5344: 	MOVE.l	d0,d2				* x1 = x
01:00205E10 2601            	  5345: 	MOVE.l	d1,d3				* y1 = Y
01:00205E12 E8A3            	  5346: 	ASR.l		d4,d3				* y1 >> i
01:00205E14 6402            	  5347: 	BCC.s		LAB_LOLP
                            	  5348: 
01:00205E16 5283            	  5349: 	ADDQ.l	#1,d3
                            	  5350: LAB_LOLP
01:00205E18 9083            	  5351: 	SUB.l		d3,d0				* x = x - y1
01:00205E1A 6AEC            	  5352: 	BPL.s		LAB_LAAD			* branch if > 0
                            	  5353: 
01:00205E1C 2002            	  5354: 	MOVE.l	d2,d0				* get x back
01:00205E1E 5848            	  5355: 	ADDQ.w	#4,a0				* next entry
01:00205E20 5284            	  5356: 	ADDQ.l	#1,d4				* next i
01:00205E22 E28B            	  5357: 	LSR.l		#1,d3				* /2
01:00205E24 6704            	  5358: 	BEQ.s		LAB_LOCX			* branch y1 = 0
                            	  5359: 
01:00205E26 51CDFFF0        	  5360: 	DBF		d5,LAB_LOLP			* decrement and loop if not done
                            	  5361: 
