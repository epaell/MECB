01:00202336 60E4            	  4818:          BRA.S   TAPEOUT2       GO DO ANOTHER
                            	  4819: *
                            	  4820: * OUTPUTS THE CHARACTER IN D0.B TO TAPE
                            	  4821: * A LOGIC `0' IS RECORDED AS ONE SQUARE WAVE PERIOD OF
                            	  4822: *        1 MILLISEC DURATION, 50% DUTY CYCLE
                            	  4823: * A LOGIC `1' IS RECORDED AS ONE SQUARE WAVE PERIOD OF
                            	  4824: *        500 MICROSEC DURATION, 50% DUTY CYCLE
                            	  4825: *
01:00202338 003C0010        	  4826: TAPEO    ORI.B   #%10000,CCR    SET X BIT IN SR
01:0020233C E310            	  4827:          ROXL.B  #1,D0          DATA BIT INTO X
01:0020233E E312            	  4828: TAPEO1   ROXL.B  #1,D2          DATA BIT INTO D2
01:00202340 613E            	  4829:          BSR.S   TIMERTST       WAIT UNTIL LAST PULSE DONE
01:00202342 08A900000021    	  4830:          BCLR.B  #0,$21(A1)     HALT TIMER
01:00202348 721E            	  4831:          MOVEQ   #30,D1         TIMER COUNT FOR A `1'
01:0020234A 08020000        	  4832:          BTST.L  #0,D2          SENDING A `1'?
01:0020234E 6606            	  4833:          BNE.S   TAPEO2         YES.
01:00202350 068100000020    	  4834:          ADDI.L  #32,D1         NO. TIMER COUNT FOR 0
01:00202356 03C90025        	  4835: TAPEO2   MOVEP.L D1,$25(A1)     SET TIMER PRELOAD REGISTER
01:0020235A 08E900010019    	  4836:          BSET.B  #1,$19(A1)     SEND 1 TO TAPE
01:00202360 08E900000021    	  4837:          BSET.B  #0,$21(A1)     START TIMER
01:00202366 6118            	  4838:          BSR.S   TIMERTST       WAIT UNTIL PULSE DONE
01:00202368 08A900000021    	  4839:          BCLR.B  #0,$21(A1)     HALT TIMER
01:0020236E 08A900010019    	  4840:          BCLR.B  #1,$19(A1)     SEND 0 TO TAPE
01:00202374 08E900000021    	  4841:          BSET.B  #0,$21(A1)     START TIMER
