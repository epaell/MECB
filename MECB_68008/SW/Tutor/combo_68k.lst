                            	  3236: 
                            	  3237: *                  A3 = POINTER TO LINE ASSEMBLED
                            	  3238: *                  A4 = PROGRAM COUNTER
                            	  3239: *                  A6 = POINTER END OF LINE ASSEMBLED
                            	  3240: *                  D0-D2 = DATA ASSEMBLED
                            	  3241: *                  D6 = NUMBER OF BYTES ASSEMBLED
                            	  3242: *                  D7 = ERROR FLAG & POSITION OF ERROR
                            	  3243: 
