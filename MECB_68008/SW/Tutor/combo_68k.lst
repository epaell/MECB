                            	  4118: *
                            	  4119: *  PRINT HEX ROUTINES
                            	  4120: *
                            	  4121: *
                            	  4122: * PRINT 8 HEX CHARACTERS
                            	  4123: *
                            	  4124: *  D0,D1,D2 DESTROYED
                            	  4125: *
01:00201DFA 4840            	  4126: PNT8HX   SWAP    D0             FLIP REG HALVES
01:00201DFC 610A            	  4127:          BSR.S   PNT4HX         DO TOP WORD
01:00201DFE 4840            	  4128:          SWAP    D0             NOW DO LOWER WORD
01:00201E00 6006            	  4129:          BRA.S   PNT4HX
                            	  4130: * PRINT 6 HEX CHARACTERS
01:00201E02 4840            	  4131: PNT6HX   SWAP    D0             FLIP REGISTER HALVES
01:00201E04 610A            	  4132:          BSR.S   PNT2HX
01:00201E06 4840            	  4133:          SWAP    D0             FLIP BACK REG HALVES
                            	  4134: * PRINT 4 HEX CHARACTERS IN D0.W
01:00201E08 3200            	  4135: PNT4HX   MOVE.W  D0,D1          SAVE IN TEMP
01:00201E0A E058            	  4136:          ROR.W   #8,D0          GET BITS 15-8 INTO LOWER BYTE
01:00201E0C 6102            	  4137:          BSR.S   PNT2HX         PRINT IT
01:00201E0E 3001            	  4138:          MOVE.W  D1,D0          PULL IT BACK
                            	  4139: * PRINT 2 HEX CHARACTERS IN D0.B
01:00201E10 3400            	  4140: PNT2HX   MOVE.W  D0,D2          SAVE IN TEMP REG
01:00201E12 E850            	  4141:          ROXR.W  #4,D0          FORM UPPER NIBBLE
01:00201E14 6102            	  4142:          BSR.S   PUTHEX         PUT ASCII INTO PRINT BUFFER
01:00201E16 3002            	  4143:          MOVE.W  D2,D0          GET BACK FROM TEMP
                            	  4144: * CONVERT D0.NIBBLE TO HEX & PUT IT IN PRINT BUFFER
                            	  4145: *
01:00201E18 0200000F        	  4146: PUTHEX   ANDI.B  #$0F,D0        SAVE LOWER NIBBLE
01:00201E1C 00000030        	  4147:          ORI.B   #$30,D0        CONVERT TO ASCII
01:00201E20 0C000039        	  4148:          CMPI.B  #$39,D0        SEE IF IT IS>9
01:00201E24 6F02            	  4149:          BLE.S   SAVHEX
01:00201E26 5E40            	  4150:          ADD     #7,D0          ADD TO MAKE 10=>A
01:00201E28 1CC0            	  4151: SAVHEX   MOVE.B  D0,(A6)+       PUT IT IN PRINT BUFFER
01:00201E2A 4E75            	  4152:          RTS
                            	  4153: 
                            	  4154: * FORMAT RELATIVE ADDRESS  AAAAAA+Rn
                            	  4155: *        ENTER     D0 = VALUE
                            	  4156: *                  A6 = STORE POINTER
                            	  4157: *
01:00201E2C 48E74780        	  4158: FRELADDR MOVEM.L D1/D5-D7/A0,-(A7)
01:00201E30 41F8044C        	  4159:          LEA     OFFSET,A0
01:00201E34 7EFF            	  4160:          MOVEQ   #-1,D7         D7 = DIFF. BEST FIT
01:00201E36 7C00            	  4161:          CLR.L   D6             D6 = OFFSET POSITION
                            	  4162: 
01:00201E38 2200            	  4163: FREL10   MOVE.L  D0,D1
01:00201E3A 4A90            	  4164:          TST.L   (A0)
01:00201E3C 670C            	  4165:          BEQ.S   FREL15         ZERO OFFSET
01:00201E3E 9290            	  4166:          SUB.L   (A0),D1        D1 = DIFF.
01:00201E40 6B08            	  4167:          BMI.S   FREL15         NO FIT
                            	  4168: 
01:00201E42 B287            	  4169:          CMP.L   D7,D1
01:00201E44 6404            	  4170:          BCC.S   FREL15         OLD FIT BETTER
                            	  4171: 
01:00201E46 2E01            	  4172:          MOVE.L  D1,D7          D7 = NEW BEST FIT
01:00201E48 2A06            	  4173:          MOVE.L  D6,D5          D5 = POSITION
                            	  4174: 
01:00201E4A 5888            	  4175: FREL15   ADDQ.L  #4,A0
01:00201E4C 5286            	  4176:          ADDQ.L  #1,D6
01:00201E4E 0C460008        	  4177:          CMPI.W  #8,D6
01:00201E52 66E4            	  4178:          BNE     FREL10         MORE OFFSETS TO CHECK
                            	  4179: 
01:00201E54 4A87            	  4180:          TST.L   D7
01:00201E56 6B1C            	  4181:          BMI.S   FREL25         NO FIT
01:00201E58 4A46            	  4182:          TST     D6
01:00201E5A 6606            	  4183:          BNE.S   FREL20
01:00201E5C 4AB8044C        	  4184:          TST.L   OFFSET
01:00201E60 6712            	  4185:          BEQ.S   FREL25         R0 = 000000; NO FIT
                            	  4186: 
01:00201E62 2007            	  4187: FREL20   MOVE.L  D7,D0
01:00201E64 619C            	  4188:          BSR     PNT6HX         FORMAT OFFSET
01:00201E66 1CFC002B        	  4189:          MOVE.B  #'+',(A6)+     +
01:00201E6A 1CFC0052        	  4190:          MOVE.B  #'R',(A6)+     R
01:00201E6E 06050030        	  4191:          ADDI.B  #'0',D5        MAKE ASCII
01:00201E72 600A            	  4192:          BRA.S   FREL30
                            	  4193: 
01:00201E74 618C            	  4194: FREL25   BSR     PNT6HX         FORMAT ADDRESS AS IS
01:00201E76 1A3C0020        	  4195:          MOVE.B  #BLANK,D5
01:00201E7A 1CC5            	  4196:          MOVE.B  D5,(A6)+       THREE SPACES FOR ALIGNMENT
01:00201E7C 1CC5            	  4197:          MOVE.B  D5,(A6)+
01:00201E7E 1CC5            	  4198: FREL30   MOVE.B  D5,(A6)+
                            	  4199: 
01:00201E80 4CDF01E2        	  4200:          MOVEM.L (A7)+,D1/D5-D7/A0
01:00201E84 4E75            	  4201:          RTS
                            	  4202: 
                            	  4203: *
                            	  4204: *
                            	  4205: *   PRINT HEX (ZERO SURPRESS)
                            	  4206: *
01:00201E86 7800            	  4207: PNTZHX   CLR.L   D4             IS ZERO WHEN SURPRESSING
01:00201E88 2200            	  4208:          MOVE.L  D0,D1          SAVE IN TEMP
01:00201E8A 6738            	  4209:          BEQ.S   PNTZ81         IF ZERO
01:00201E8C 6A08            	  4210:          BPL.S   PNTZ0
01:00201E8E 4481            	  4211:          NEG.L   D1             CHANGE TO POSITIVE VALUE
01:00201E90 6B32            	  4212:          BMI.S   PNTZ81         WATCH OUT SPECIAL CASE $80000000
01:00201E92 1CFC002D        	  4213:          MOVE.B  #'-',(A6)+     PUT SIGN INTO BUFFER
01:00201E96 7408            	  4214: PNTZ0    MOVEQ   #8,D2          8 POSSIBLE CHARACTERS
01:00201E98 2001            	  4215: PNTZ1    MOVE.L  D1,D0          UNSAVE IT
01:00201E9A 2602            	  4216:          MOVE.L  D2,D3          COUNT DOWN FROM HERE
01:00201E9C 5383            	  4217:          SUBQ.L  #1,D3          BACK OFF ONE
01:00201E9E 670C            	  4218:          BEQ.S   PNTZ4          IF NO ROTATE SKIP THIS
01:00201EA0 E880            	  4219: PNTZ2    ASR.L   #4,D0          ROTATE LRIGHT
01:00201EA2 02800FFFFFFF    	  4220:          ANDI.L  #$FFFFFFF,D0   CLEAR TOP NIBBLE
01:00201EA8 5383            	  4221:          SUBQ.L  #1,D3
01:00201EAA 66F4            	  4222:          BNE     PNTZ2
