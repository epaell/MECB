                            	  3923: 
                            	  3924: *************************************************************************************
                            	  3925: *
                            	  3926: * do this dimension size (d1) * array data size (Asptl)
                            	  3927: 
                            	  3928: * do a 16 x 32 bit multiply
                            	  3929: * d1 holds the 16 bit multiplier
                            	  3930: * Asptl holds the 32 bit multiplicand
                            	  3931: 
                            	  3932: * d0	bbbb  bbbb
                            	  3933: * d1	0000  aaaa
                            	  3934: *	----------
                            	  3935: * d0	rrrr  rrrr
                            	  3936: 
                            	  3937: LAB_1F7C
01:002056CE 202B05A8        	  3938: 	MOVE.l	Asptl(a3),d0		* get result
01:002056D2 2400            	  3939: 	MOVE.l	d0,d2				* copy it
01:002056D4 4842            	  3940: 	SWAP		d2				* shift high word to low word
01:002056D6 C0C1            	  3941: 	MULU.w	d1,d0				* d1 * low word = low result
01:002056D8 C4C1            	  3942: 	MULU.w	d1,d2				* d1 * high word = high result
01:002056DA 4842            	  3943: 	SWAP		d2				* align words for test
01:002056DC 4A42            	  3944: 	TST.w		d2				* must be zero
01:002056DE 6600EEDA        	  3945: 	BNE		LAB_OMER			* if overflow go do "Out of memory" error
                            	  3946: 
01:002056E2 D082            	  3947: 	ADD.l		d2,d0				* calculate result
01:002056E4 6500EED4        	  3948: 	BCS		LAB_OMER			* if overflow go do "Out of memory" error
                            	  3949: 
01:002056E8 D0AB05A8        	  3950: 	ADD.l		Asptl(a3),d0		* add original
01:002056EC 6500EECC        	  3951: 	BCS		LAB_OMER			* if overflow go do "Out of memory" error
                            	  3952: 
01:002056F0 4E75            	  3953: 	RTS
