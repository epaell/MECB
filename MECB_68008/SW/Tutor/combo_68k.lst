                            	  2672: * File HE        HELP Command                                     12/01/81
                            	  2673: 
                            	  2674: * HELP  COMMAND
                            	  2675: *  PRINT: REGISTERS AND COMMANDS IN TABLES
                            	  2676: 
01:002012E0 4BFA0066        	  2677: HECMD    LEA     MSG002(PC),A5
01:002012E4 6100F204        	  2678:          BSR     FIXDATA
01:002012E8 61000D5E        	  2679:          BSR     OUT1CR         PRINT
                            	  2680: 
01:002012EC 49FAF416        	  2681:          LEA     SOLIST(PC),A4  A4 = POINTER TO COMMAND LIST
                            	  2682: 
01:002012F0 61000DFC        	  2683:          BSR     FIXBUF
01:002012F4 143C0008        	  2684:          MOVE.B  #8,D2          D2 = # CMDS PER LINE
01:002012F8 321C            	  2685: HELP4    MOVE.W  (A4)+,D1       GET 2 BYTE COMMAND
01:002012FA 0C41FFFF        	  2686:          CMPI.W  #$FFFF,D1
01:002012FE 6740            	  2687:          BEQ.S   HELP6          DONE PRINT LAST BUFFER
01:00201300 548C            	  2688:          ADDQ.L  #2,A4          BUMP POINTER UP BY 2
01:00201302 4A41            	  2689:          TST.W   D1             IS THE INVISIBLE INDICATOR ON?
01:00201304 6BF2            	  2690:          BMI     HELP4          YES... THEN BYPASS THIS ONE
01:00201306 3601            	  2691:          MOVE.W  D1,D3          SAVE XX FOR "XX" AND "NOXX" IN HELP
01:00201308 02417F7F        	  2692:          ANDI.W  #$7F7F,D1      REMOVE CONTROL BITS
01:0020130C 3CC1            	  2693:          MOVE.W  D1,(A6)+       NO.... MOVE THIS COMMAND TO "PRINT" LINE
01:0020130E 2CFC20202020    	  2694:          MOVE.L  #'    ',(A6)+  MOVE BLANKS FOR SPACING
01:00201314 6118            	  2695:          BSR.S   HELP81         PRINT THE LINE IF FULL
01:00201316 08030007        	  2696:          BTST    #7,D3          IS "NO" OPTION SUPPORTED?
01:0020131A 6710            	  2697:          BEQ.S   EOHLOOP        NO...BYPASS THIS COMMAND, ELSE...
01:0020131C 3CFC4E4F        	  2698:          MOVE.W  #'NO',(A6)+    "NO  "   IN MSG
01:00201320 02437F7F        	  2699:          ANDI.W  #$7F7F,D3      RESET CONTROL BITS
01:00201324 3CC3            	  2700:          MOVE.W  D3,(A6)+       "NOCC"   IN MSG (WHERE CC=COMMAND CODE)
01:00201326 3CFC2020        	  2701:          MOVE.W  #'  ',(A6)+    "NOCC  " IN MSG    "    "    "      "
01:0020132A 6102            	  2702:          BSR.S   HELP81         PRINT THE LINE IF FULL
01:0020132C 60CA            	  2703: EOHLOOP  BRA     HELP4          NEXT COMMAND.
                            	  2704: 
                            	  2705: *        DISPLAY LINE OF COMMANDS (IF FULL)
                            	  2706: 
01:0020132E 5302            	  2707: HELP81   SUBQ.B  #1,D2          D2 = COUNT OF COMMANDS PER LINE
01:00201330 660C            	  2708:          BNE.S   HELP85         NOT FULL, JUST RETURN FOR MORE
01:00201332 61000D14        	  2709:          BSR     OUT1CR         YES, THEN WRITE IT
01:00201336 61000DB6        	  2710:          BSR     FIXBUF         SET-UP LINE FOR NEXT COMMANDS
01:0020133A 143C0008        	  2711:          MOVE.B  #8,D2          D2 = MAX NUMBER CAN BE PLACED IN LINE
01:0020133E 4E75            	  2712: HELP85   RTS
                            	  2713: 
01:00201340 61000D06        	  2714: HELP6    BSR     OUT1CR         PRINT ANY REMAINING PORTION
                            	  2715: *        BRA     HELP1          SEE IF COMPLETE
01:00201344 6000F2E8        	  2716:          BRA     MACSBUG        HELP IS COMPLETE SO RETURN
