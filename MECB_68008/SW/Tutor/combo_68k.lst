                            	  5404: *************************************************************************************
                            	  5405: *
                            	  5406: * multiply FAC1 by FAC2
                            	  5407: 
                            	  5408: LAB_MULTIPLY
01:00205E82 48E7F800        	  5409: 	MOVEM.l	d0-d4,-(sp)			* save registers
01:00205E86 4A2B0594        	  5410: 	TST.b		FAC1_e(a3)			* test FAC1 exponent
01:00205E8A 6776            	  5411: 	BEQ.s		LAB_MUUF			* if exponent zero go make result zero
                            	  5412: 
01:00205E8C 102B059C        	  5413: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00205E90 6770            	  5414: 	BEQ.s		LAB_MUUF			* if exponent zero go make result zero
                            	  5415: 
01:00205E92 176B059E0595    	  5416: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare becomes sign
                            	  5417: 
01:00205E98 D02B0594        	  5418: 	ADD.b		FAC1_e(a3),d0		* multiply exponents by adding
01:00205E9C 640A            	  5419: 	BCC.s		LAB_MNOC			* branch if no carry
                            	  5420: 
01:00205E9E 903C0080        	  5421: 	SUB.b		#$80,d0			* normalise result
01:00205EA2 6400E71A        	  5422: 	BCC		LAB_OFER			* if no carry do overflow
                            	  5423: 
01:00205EA6 6006            	  5424: 	BRA.s		LAB_MADD			* branch
                            	  5425: 
                            	  5426: 							* no carry for exponent add
                            	  5427: LAB_MNOC
01:00205EA8 903C0080        	  5428: 	SUB.b		#$80,d0			* normalise result
01:00205EAC 6554            	  5429: 	BCS.s		LAB_MUUF			* return zero if underflow
                            	  5430: 
                            	  5431: LAB_MADD
01:00205EAE 17400594        	  5432: 	MOVE.b	d0,FAC1_e(a3)		* save exponent
                            	  5433: 
                            	  5434: 							* d1 (FAC1) x d2 (FAC2)
01:00205EB2 222B0590        	  5435: 	MOVE.l	FAC1_m(a3),d1		* get FAC1 mantissa
01:00205EB6 242B0598        	  5436: 	MOVE.l	FAC2_m(a3),d2		* get FAC2 mantissa
                            	  5437: 
01:00205EBA 3801            	  5438: 	MOVE.w	d1,d4				* copy low word FAC1
01:00205EBC 2001            	  5439: 	MOVE.l	d1,d0				* copy long word FAC1
01:00205EBE 4840            	  5440: 	SWAP		d0				* high word FAC1 to low word FAC1
01:00205EC0 3600            	  5441: 	MOVE.w	d0,d3				* copy high word FAC1
                            	  5442: 
01:00205EC2 C2C2            	  5443: 	MULU		d2,d1				* low word FAC2 x low word FAC1
01:00205EC4 C0C2            	  5444: 	MULU		d2,d0				* low word FAC2 x high word FAC1
01:00205EC6 4842            	  5445: 	SWAP		d2				* high word FAC2 to low word FAC2
01:00205EC8 C8C2            	  5446: 	MULU		d2,d4				* high word FAC2 x low word FAC1
01:00205ECA C6C2            	  5447: 	MULU		d2,d3				* high word FAC2 x high word FAC1
                            	  5448: 
                            	  5449: * done multiply, now add partial products
                            	  5450: 
                            	  5451: *			d1 =					aaaa  ----	FAC2_L x FAC1_L
                            	  5452: *			d0 =				bbbb  aaaa		FAC2_L x FAC1_H
                            	  5453: *			d4 =				bbbb  aaaa		FAC2_H x FAC1_L
                            	  5454: *			d3 =			cccc  bbbb			FAC2_H x FAC1_H
                            	  5455: *			product =		mmmm  mmmm
                            	  5456: 
01:00205ECC D2BC00008000    	  5457: 	ADD.L		#$8000,d1			* round up lowest word
01:00205ED2 4241            	  5458: 	CLR.w		d1				* clear low word, don't need it
01:00205ED4 4841            	  5459: 	SWAP		d1				* align high word
01:00205ED6 D280            	  5460: 	ADD.l		d0,d1				* add FAC2_L x FAC1_H (can't be carry)
                            	  5461: LAB_MUF1
01:00205ED8 D284            	  5462: 	ADD.l		d4,d1				* now add intermediate (FAC2_H x FAC1_L)
01:00205EDA 6406            	  5463: 	BCC.s		LAB_MUF2			* branch if no carry
                            	  5464: 
01:00205EDC D6BC00010000    	  5465: 	ADD.l		#$10000,d3			* else correct result
                            	  5466: LAB_MUF2
01:00205EE2 D2BC00008000    	  5467: 	ADD.l		#$8000,d1			* round up low word
01:00205EE8 4241            	  5468: 	CLR.w		d1				* clear low word
01:00205EEA 4841            	  5469: 	SWAP		d1				* align for final add
01:00205EEC D283            	  5470: 	ADD.l		d3,d1				* add FAC2_H x FAC1_H, result
01:00205EEE 6B08            	  5471: 	BMI.s		LAB_MUF3			* branch if normalisation not needed
                            	  5472: 
01:00205EF0 D281            	  5473: 	ADD.l		d1,d1				* shift mantissa
01:00205EF2 532B0594        	  5474: 	SUBQ.b	#1,FAC1_e(a3)		* adjust exponent
01:00205EF6 670A            	  5475: 	BEQ.s		LAB_MUUF			* branch if underflow
                            	  5476: 
                            	  5477: LAB_MUF3
01:00205EF8 27410590        	  5478: 	MOVE.l	d1,FAC1_m(a3)		* save mantissa
                            	  5479: LAB_MUEX
01:00205EFC 4CDF001F        	  5480: 	MOVEM.l	(sp)+,d0-d4			* restore registers
01:00205F00 4E75            	  5481: 	RTS
                            	  5482: 							* either zero or underflow result
                            	  5483: LAB_MUUF
01:00205F02 7000            	  5484: 	MOVEQ		#0,d0				* quick clear
01:00205F04 27400590        	  5485: 	MOVE.l	d0,FAC1_m(a3)		* clear mantissa
01:00205F08 37400594        	  5486: 	MOVE.w	d0,FAC1_e(a3)		* clear sign and exponent
01:00205F0C 60EE            	  5487: 	BRA.s		LAB_MUEX			* restore regs & exit
                            	  5488: 
                            	  5489: 
                            	  5490: *************************************************************************************
                            	  5491: *
                            	  5492: * do FAC2/FAC1, result in FAC1
                            	  5493: * fast hardware divide version
                            	  5494: 
                            	  5495: LAB_DIVIDE
01:00205F0E 2F07            	  5496: 	MOVE.l	d7,-(sp)			* save d7
01:00205F10 7000            	  5497: 	MOVEQ		#0,d0				* clear FAC2 exponent
01:00205F12 2400            	  5498: 	MOVE.l	d0,d2				* clear FAC1 exponent
                            	  5499: 
01:00205F14 142B0594        	  5500: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00205F18 6700E690        	  5501: 	BEQ		LAB_DZER			* if zero go do /0 error
                            	  5502: 
01:00205F1C 102B059C        	  5503: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00205F20 6766            	  5504: 	BEQ.s		LAB_DIV0			* if zero return zero
                            	  5505: 
01:00205F22 9042            	  5506: 	SUB.w		d2,d0				* get result exponent by subtracting
01:00205F24 D07C0080        	  5507: 	ADD.w		#$80,d0			* correct 16 bit exponent result
                            	  5508: 
01:00205F28 176B059E0595    	  5509: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare is result sign
                            	  5510: 
                            	  5511: * now to do 32/32 bit mantissa divide
                            	  5512: 
01:00205F2E 422B059F        	  5513: 	CLR.b		flag(a3)			* clear 'flag' byte
01:00205F32 262B0590        	  5514: 	MOVE.l	FAC1_m(a3),d3		* get FAC1 mantissa
01:00205F36 282B0598        	  5515: 	MOVE.l	FAC2_m(a3),d4		* get FAC2 mantissa
01:00205F3A B883            	  5516: 	CMP.l		d3,d4				* compare FAC2 with FAC1 mantissa
01:00205F3C 6744            	  5517: 	BEQ.s		LAB_MAN1			* set mantissa result = 1 if equal
                            	  5518: 
01:00205F3E 6506            	  5519: 	BCS.s		AC1gtAC2			* branch if FAC1 > FAC2
                            	  5520: 
01:00205F40 9883            	  5521: 	SUB.l		d3,d4				* subtract FAC1 from FAC2, result now must be <1
01:00205F42 562B059F        	  5522: 	ADDQ.b	#3,flag(a3)			* FAC2>FAC1 so set 'flag' byte
                            	  5523: AC1gtAC2
01:00205F46 6146            	  5524: 	BSR.s		LAB_32_16			* do 32/16 divide
01:00205F48 4841            	  5525: 	SWAP		d1				* move 16 bit result to high word
01:00205F4A 2802            	  5526: 	MOVE.l	d2,d4				* copy remainder longword
01:00205F4C 6142            	  5527: 	BSR.s		LAB_3216			* do 32/16 divide again (skip copy d4 to d2)
01:00205F4E 84C5            	  5528: 	DIVU.w	d5,d2				* now divide remainder to make guard word
01:00205F50 1E2B059F        	  5529: 	MOVE.b	flag(a3),d7			* now normalise, get flag byte back
01:00205F54 6708            	  5530: 	BEQ.s		LAB_DIVX			* skip add if null
                            	  5531: 
                            	  5532: * else result was >1 so we need to add 1 to result mantissa and adjust exponent
                            	  5533: 
01:00205F56 E20F            	  5534: 	LSR.b		#1,d7				* shift 1 into eXtend
01:00205F58 E291            	  5535: 	ROXR.l	#1,d1				* shift extend result >>
01:00205F5A E252            	  5536: 	ROXR.w	#1,d2				* shift extend guard word >>
01:00205F5C 5200            	  5537: 	ADDQ.b	#1,d0				* adjust exponent
                            	  5538: 
                            	  5539: * now round result to 32 bits
                            	  5540: 
                            	  5541: LAB_DIVX
01:00205F5E D442            	  5542: 	ADD.w		d2,d2				* guard bit into eXtend bit
01:00205F60 6408            	  5543: 	BCC.s		L_DIVRND			* branch if guard=0
                            	  5544: 
01:00205F62 5281            	  5545: 	ADDQ.l	#1,d1				* add guard to mantissa
01:00205F64 6404            	  5546: 	BCC.s		L_DIVRND			* branch if no overflow
                            	  5547: 
                            	  5548: LAB_SET1
01:00205F66 E291            	  5549: 	ROXR.l	#1,d1				* shift extend result >>
01:00205F68 5240            	  5550: 	ADDQ.w	#1,d0				* adjust exponent
                            	  5551: 
                            	  5552: 							* test for over/under flow
                            	  5553: L_DIVRND
01:00205F6A 3600            	  5554: 	MOVE.w	d0,d3				* copy exponent
01:00205F6C 6B1A            	  5555: 	BMI.s		LAB_DIV0			* if -ve return zero
                            	  5556: 
01:00205F6E 0243FF00        	  5557: 	ANDI.w	#$FF00,d3			* mask word high byte
01:00205F72 6600E64A        	  5558: 	BNE		LAB_OFER			* branch if overflow
                            	  5559: 
                            	  5560: 							* move result into FAC1
                            	  5561: LAB_XDIV
01:00205F76 2E1F            	  5562: 	MOVE.l	(sp)+,d7			* restore d7
01:00205F78 17400594        	  5563: 	MOVE.b	d0,FAC1_e(a3)		* save result exponent
01:00205F7C 27410590        	  5564: 	MOVE.l	d1,FAC1_m(a3)		* save result mantissa
01:00205F80 4E75            	  5565: 	RTS
                            	  5566: 
                            	  5567: * FAC1 mantissa = FAC2 mantissa so set result mantissa
                            	  5568: 
                            	  5569: LAB_MAN1
01:00205F82 7201            	  5570: 	MOVEQ		#1,d1				* set bit
01:00205F84 E2A9            	  5571: 	LSR.l		d1,d1				* bit into eXtend
01:00205F86 60DE            	  5572: 	BRA.s		LAB_SET1			* set mantissa, adjust exponent and exit
                            	  5573: 
                            	  5574: * result is zero
                            	  5575: 
                            	  5576: LAB_DIV0
01:00205F88 7000            	  5577: 	MOVEQ		#0,d0				* zero exponent & sign
01:00205F8A 2200            	  5578: 	MOVE.l	d0,d1				* zero mantissa
01:00205F8C 60E8            	  5579: 	BRA		LAB_XDIV			* exit divide
                            	  5580: 
                            	  5581: * divide 16 bits into 32, AB/Ex
                            	  5582: *
                            	  5583: * d4			AAAA	BBBB			* 32 bit numerator
                            	  5584: * d3			EEEE	xxxx			* 16 bit denominator
                            	  5585: *
                            	  5586: * returns -
                            	  5587: *
                            	  5588: * d1			xxxx	DDDD			* 16 bit result
                            	  5589: * d2				HHHH	IIII		* 32 bit remainder
                            	  5590: 
                            	  5591: LAB_32_16
01:00205F8E 2404            	  5592: 	MOVE.l	d4,d2				* copy FAC2 mantissa		(AB)
                            	  5593: LAB_3216
01:00205F90 2A03            	  5594: 	MOVE.l	d3,d5				* copy FAC1 mantissa		(EF)
01:00205F92 4245            	  5595: 	CLR.w		d5				* clear low word d1		(Ex)
01:00205F94 4845            	  5596: 	SWAP		d5				* swap high word to low word	(xE)
                            	  5597: 
                            	  5598: * d3			EEEE	FFFF			* denominator copy
                            	  5599: * d5		0000	EEEE				* denominator high word
                            	  5600: * d2			AAAA	BBBB			* numerator copy
                            	  5601: * d4			AAAA	BBBB			* numerator
                            	  5602: 
01:00205F96 88C5            	  5603: 	DIVU.w	d5,d4				* do FAC2/FAC1 high word	(AB/E)
01:00205F98 6802            	  5604: 	BVC.s		LAB_LT_1			* if no overflow DIV was ok
                            	  5605: 
01:00205F9A 78FF            	  5606: 	MOVEQ		#-1,d4			* else set default value
                            	  5607: 
                            	  5608: * done the divide, now check the result, we have ...
                            	  5609: 
                            	  5610: * d3			EEEE	FFFF			* denominator copy
                            	  5611: * d5		0000	EEEE				* denominator high word
                            	  5612: * d2			AAAA	BBBB			* numerator copy
                            	  5613: * d4			MMMM	DDDD			* result MOD and DIV
                            	  5614: 
                            	  5615: LAB_LT_1
01:00205F9C 3C04            	  5616: 	MOVE.w	d4,d6				* copy 16 bit result
01:00205F9E 3204            	  5617: 	MOVE.w	d4,d1				* copy 16 bit result again
                            	  5618: 
                            	  5619: * we now have ..
                            	  5620: * d3			EEEE	FFFF			* denominator copy
                            	  5621: * d5		0000	EEEE				* denominator high word
                            	  5622: * d6			xxxx  DDDD			* result DIV copy
                            	  5623: * d1			xxxx  DDDD			* result DIV copy
                            	  5624: * d2			AAAA	BBBB			* numerator copy
                            	  5625: * d4			MMMM	DDDD			* result MOD and DIV
                            	  5626: 
                            	  5627: * now multiply out 32 bit denominator by 16 bit result
                            	  5628: * QRS = AB*D
                            	  5629: 
01:00205FA0 CCC3            	  5630: 	MULU.w	d3,d6				* FFFF * DDDD =       rrrr  SSSS
01:00205FA2 C8C5            	  5631: 	MULU.w	d5,d4				* EEEE * DDDD = QQQQ  rrrr
                            	  5632: 
                            	  5633: * we now have ..
                            	  5634: * d3			EEEE	FFFF			* denominator copy
                            	  5635: * d5		0000	EEEE				* denominator high word
                            	  5636: * d6				rrrr  SSSS		* 48 bit result partial low
                            	  5637: * d1			xxxx  DDDD			* result DIV copy
                            	  5638: * d2			AAAA	BBBB			* numerator copy
                            	  5639: * d4			QQQQ	rrrr			* 48 bit result partial
                            	  5640: 
01:00205FA4 3E06            	  5641: 	MOVE.w	d6,d7				* copy low word of low multiply
                            	  5642: 
                            	  5643: * d7				xxxx	SSSS		* 48 bit result partial low
                            	  5644: 
01:00205FA6 4246            	  5645: 	CLR.w		d6				* clear low word of low multiply
01:00205FA8 4846            	  5646: 	SWAP		d6				* high word of low multiply to low word
                            	  5647: 
                            	  5648: * d6			0000	rrrr			* high word of 48 bit result partial low
                            	  5649: 
01:00205FAA D886            	  5650: 	ADD.l		d6,d4
                            	  5651: 
                            	  5652: * d4			QQQQ	RRRR			* 48 bit result partial high longword
                            	  5653: 
01:00205FAC 7C00            	  5654: 	MOVEQ		#0,d6				* clear to extend numerator to 48 bits
                            	  5655: 
                            	  5656: * now do GHI = AB0 - QRS (which is the remainder)
                            	  5657: 
01:00205FAE 9C47            	  5658: 	SUB.w		d7,d6				* low word subtract
                            	  5659: 
                            	  5660: * d6				xxxx	IIII		* remainder low word
                            	  5661: 
01:00205FB0 9584            	  5662: 	SUBX.l	d4,d2				* high longword subtract
                            	  5663: 
                            	  5664: * d2			GGGG	HHHH			* remainder high longword
                            	  5665: 
                            	  5666: * now if we got the divide correct then the remainder high longword will be +ve
                            	  5667: 
01:00205FB2 6A08            	  5668: 	BPL.s		L_DDIV			* branch if result is ok (<needed)
                            	  5669: 
                            	  5670: * remainder was -ve so DDDD is too big
                            	  5671: 
                            	  5672: LAB_REMM
01:00205FB4 5341            	  5673: 	SUBQ.w	#1,d1				* adjust DDDD
                            	  5674: 
                            	  5675: * d3				xxxx	FFFF		* denominator copy
                            	  5676: * d6				xxxx	IIII		* remainder low word
                            	  5677: 
01:00205FB6 DC43            	  5678: 	ADD.w		d3,d6				* add EF*1 low remainder low word
                            	  5679: 
                            	  5680: * d5			0000	EEEE			* denominator high word
                            	  5681: * d2			GGGG	HHHH			* remainder high longword
                            	  5682: 
01:00205FB8 D585            	  5683: 	ADDX.l	d5,d2				* add extend EF*1 to remainder high longword
01:00205FBA 6BF8            	  5684: 	BMI.s		LAB_REMM			* loop if result still too big
                            	  5685: 
                            	  5686: * all done and result correct or <
                            	  5687: 
                            	  5688: L_DDIV
01:00205FBC 4842            	  5689: 	SWAP		d2				* remainder mid word to high word
                            	  5690: 
                            	  5691: * d2			HHHH	GGGG			* (high word /should/ be $0000)
                            	  5692: 
01:00205FBE 3406            	  5693: 	MOVE.w	d6,d2				* remainder in high word
                            	  5694: 
                            	  5695: * d2				HHHH	IIII		* now is 32 bit remainder
                            	  5696: * d1			xxxx	DDDD			* 16 bit result
                            	  5697: 
01:00205FC0 4E75            	  5698: 	RTS
