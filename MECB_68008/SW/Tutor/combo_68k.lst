                            	  3229: 
                            	  3230: *                  A3 = STORE POINTER
                            	  3231: *                  A4 = PROGRAM COUNTER
                            	  3232: *                  A5 = POINTER TO DATA TO ASSEMBLE
                            	  3233: *                  A6 = POINTER TO END OF SOURCE DATA
                            	  3234: 
