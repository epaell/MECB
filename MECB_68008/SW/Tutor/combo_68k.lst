01:00205E70 377C8200059C    	  5396: 	MOVE.w	#$8200,FAC2_e(a3)		* set exponent & sign
01:00205E76 176B0595059E    	  5397: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* clear sign compare
01:00205E7C 6100FE62        	  5398: 	BSR		LAB_ADD			* and add for final result
