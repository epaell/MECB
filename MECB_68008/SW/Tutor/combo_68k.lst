                            	  7125: *-------------------------------------------------------------------------
                            	  7126: * File DCODE68K  68K ONE LINE DISASSEMBLER                        07/28/82
                            	  7127: 
                            	  7128: *        CALLING SEQUENCE:
                            	  7129: *   D0,D1,D2 = CODE TO BE DISASSEMBLED
                            	  7130: *   A4 = VALUE OF PROGRAM COUNTER FOR THE CODE
                            	  7131: *   A5 = POINTER TO STORE DATA (BUFSIZE = 80 ASSUMED)
                            	  7132: *        JSR       DCODE68K
                            	  7133: 
                            	  7134: *        RETURN:
                            	  7135: *   A4 = VALUE OF PROGRAM COUNTER FOR NEXT INSTRUCTION
                            	  7136: *   A5 = POINTER TO LINE AS DISASSEMBLED
                            	  7137: *   A6 = POINTER TO END OF LINE
                            	  7138: *
                            	  7139: * 01234567890123456789012345678901234567890123456789
                            	  7140: * AAAAAA FDATA.DDDDDDDDDDDDDD FOC.... FOP.....
                            	  7141: 
                            	  7142: *FDATA   EQU     10             DATA FIELD
                            	  7143: *FOC     EQU     31             OP-CODE FIELD
                            	  7144: *FOP     EQU     39             OPERAND FIELD
                            	  7145: 
                            	  7146: * CAUSES ORGIN MODULO 4
                            	  7147: LONG     MACRO
                            	  7148:          DS      0
                            	  7149:          DS.B    (*-X)&2
                            	  7150:          ENDM
                            	  7151: 
                            	  7152: 
                            	  7153: X        DS      0              BASE ADDRESS THIS MODULE
                            	  7154:          LONG
                            	     1M          DS      0
                            	     2M          DS.B    (*-X)&2
                            	  7155: 
