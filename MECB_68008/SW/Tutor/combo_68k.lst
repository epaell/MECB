                            	  3595: *-------------------------------------------------------------------------
                            	  3596: * File OF        OF & PERIOD Command                              12/18/81
                            	  3597: 
                            	  3598: * .*  HANDLER
                            	  3599: *   GET TWO CHARACTERS FOLLOWING PERIOD
                            	  3600: 
01:002019E8 E149            	  3601: PERCMD   LSL.W   #8,D1
01:002019EA 1215            	  3602:          MOVE.B  (A5),D1        D1 = 2ND,3RD CHARACTERS
01:002019EC 538D            	  3603:          SUBQ.L  #1,A5          A5 = POINTER TO 2ND CHAR  (1ST REAL CHARACTER)
                            	  3604: 
01:002019EE 41FA0030        	  3605:          LEA     REGTBL(PC),A0
01:002019F2 7E00            	  3606: PER4     CLR.L   D7
01:002019F4 3E18            	  3607:          MOVE.W  (A0)+,D7       SAVE FIRST WORD FOR END OF TABLE TEST
01:002019F6 3018            	  3608:          MOVE.W  (A0)+,D0       GET REAL REGISTER ID INTO D0
01:002019F8 0C47FFFF        	  3609:          CMPI.W  #$FFFF,D7      ARE WE AT THE END OF THE TABLE?
01:002019FC 6700EA98        	  3610:          BEQ     WHAT           YES...THEN WE DIDNT FIND IT
                            	  3611: 
01:00201A00 0C000040        	  3612:          CMPI.B  #'@',D0
01:00201A04 660E            	  3613:          BNE.S   PER3           NOT @
                            	  3614: 
                            	  3615: * THIRD CHAR MUST BE NUMERIC 0 - 7
01:00201A06 1001            	  3616:          MOVE.B  D1,D0          ALLEGED DIGIT
01:00201A08 0C000030        	  3617:          CMPI.B  #'0',D0
01:00201A0C 6BE4            	  3618:          BMI     PER4           NOT A DIGIT
01:00201A0E 0C000038        	  3619:          CMPI.B  #'8',D0
01:00201A12 6ADE            	  3620:          BPL     PER4           NOT A DIGIT
                            	  3621: 
01:00201A14 B041            	  3622: PER3     CMP.W   D1,D0
01:00201A16 66DA            	  3623:          BNE     PER4           MISS-MATCH
                            	  3624: 
                            	  3625: *******************************************************************
                            	  3626: *        AT THIS TIME WE HAVE FOUND THE ENTRY IN THE "REG TABLE"  *
                            	  3627: *        WE NOW NEED TO EXTRACT AND USE THE OFFSET                *
                            	  3628: *******************************************************************
                            	  3629: 
01:00201A18 41FAE5E6        	  3630:          LEA     FIRST(PC),A0   A0 = Start of VERSAbug RO
01:00201A1C D1C7            	  3631:          ADD.L   D7,A0          Add offset
01:00201A1E 4ED0            	  3632:          JMP     (A0)           Now go to the calculated location
                            	  3633: 
                            	  3634: 
                            	  3635: ***************
                            	  3636: REGTBL   EQU  *
                            	  3637: ***************
                            	  3638: 
01:00201A20 1A62            	  3639:          DC.W    SETA7-FIRST    Stack Register Routine
01:00201A22 4137            	  3640:          DC.W    'A7'           *
                            	  3641: 
01:00201A24 1A56            	  3642:          DC.W    SETPC-FIRST    Program Counter Routine
01:00201A26 5043            	  3643:          DC.W    'PC'           *
                            	  3644: 
01:00201A28 1A5C            	  3645:          DC.W    SETSR-FIRST    Status Register Routine
01:00201A2A 5352            	  3646:          DC.W    'SR'           *
                            	  3647: 
01:00201A2C 1A72            	  3648:          DC.W    SETUS-FIRST    User Stack Routine
01:00201A2E 5553            	  3649:          DC.W    'US'           *
                            	  3650: 
01:00201A30 1A6C            	  3651:          DC.W    SETSS-FIRST    System Stack Routine
01:00201A32 5353            	  3652:          DC.W    'SS'           *
                            	  3653: 
01:00201A34 1A4A            	  3654:          DC.W    SETD-FIRST     Data Register Routine
01:00201A36 4440            	  3655:          DC.W    'D@'           *
                            	  3656: 
01:00201A38 1A50            	  3657:          DC.W    SETA-FIRST     Address Register Routine
01:00201A3A 4140            	  3658:          DC.W    'A@'           *
                            	  3659: 
01:00201A3C 1B2A            	  3660:          DC.W    PNTCLSA-FIRST  All Address Registers Routine
01:00201A3E 4120            	  3661:          DC.W    'A '           *
                            	  3662: 
01:00201A40 1B20            	  3663:          DC.W    PNTCLSD-FIRST  All Data Registers Routine
01:00201A42 4420            	  3664:          DC.W    'D '           *
                            	  3665: 
01:00201A44 1A78            	  3666:          DC.W    SETRN-FIRST    All Registers Routine
01:00201A46 5240            	  3667:          DC.W    'R@'           *
                            	  3668: 
01:00201A48 FFFF            	  3669:          DC.W    $FFFF          END OF TABLE
                            	  3670: 
                            	  3671: *    PRINT & INPUT REGISTER ROUTINES
                            	  3672: 
01:00201A4A 49F80408        	  3673: SETD     LEA     REGS,A4        START OF REGISTERS
01:00201A4E 6034            	  3674:          BRA.S   SETR
                            	  3675: 
01:00201A50 49F80428        	  3676: SETA     LEA     REGS+32,A4     OFFSET IN REGISTER TABLE
01:00201A54 602E            	  3677:          BRA.S   SETR
                            	  3678: 
01:00201A56 49F80400        	  3679: SETPC    LEA     REGPC,A4       WHERE PC IS
01:00201A5A 6030            	  3680:          BRA.S   SETR0
                            	  3681: 
01:00201A5C 49F80404        	  3682: SETSR    LEA     REGSR,A4       WHERE SR IS
01:00201A60 602A            	  3683:          BRA.S   SETR0
                            	  3684: 
01:00201A62 22380404        	  3685: SETA7    MOVE.L  REGSR,D1       GET CONDITION CODES
01:00201A66 02412000        	  3686:          ANDI.W  #$2000,D1      CHECK SUPERVISOR BIT
01:00201A6A 6706            	  3687:          BEQ.S   SETUS
01:00201A6C 49F80444        	  3688: SETSS    LEA     REGA7,A4       WHERE SUPERVISOR STACK IS
01:00201A70 601A            	  3689:          BRA.S   SETR0
                            	  3690: 
01:00201A72 49F80448        	  3691: SETUS    LEA     REGUS,A4       USER STACK
01:00201A76 6014            	  3692:          BRA.S   SETR0
                            	  3693: 
01:00201A78 49F8044C        	  3694: SETRN    LEA     OFFSET,A4      SET OFFSET
01:00201A7C 0C010037        	  3695:          CMPI.B  #'7',D1
01:00201A80 6700EA2C        	  3696:          BEQ     SYNTAX         NOT ALLOWED TO CHANGE A7
                            	  3697: 
                            	  3698: 
                            	  3699: *  ROUTINE TO ENTER DATA FOR A SINGLE REGISTER
                            	  3700: *   A5-A6 ARE COMMAND BUFFER
                            	  3701: *   D0 HAS REGISTER DIGIT A4 HAS CLASS OFFSET
                            	  3702: 
01:00201A84 61000578        	  3703: SETR     BSR     GETHEX         GET REG NUMBER
01:00201A88 E588            	  3704:          LSL.L   #2,D0          SHIFT LEFT...MULT BY 4
01:00201A8A D9C0            	  3705:          ADD.L   D0,A4          A4 NOW HAS EXACT ADDRESS
01:00201A8C 548D            	  3706: SETR0    ADDQ.L  #2,A5          NOW FIND PARAMETERS
01:00201A8E 103C003A        	  3707:          MOVE.B  #':',D0        SEE IF COLON IN COMMAND
01:00201A92 6154            	  3708:          BSR.S   SCAN
01:00201A94 671E            	  3709:          BEQ.S   SETR5
                            	  3710: *SEE IF ANY PARAMER (HEX)
01:00201A96 41FA0016        	  3711:          LEA     SETR4(PC),A0   WHERE TO GO IF NO PARAMETERS
01:00201A9A 61000430        	  3712:          BSR     FNEXTF         FIND NEXT FIELD
                            	  3713: 
01:00201A9E 0C00002E        	  3714:          CMPI.B  #'.',D0
01:00201AA2 6706            	  3715:          BEQ.S   SEMACS         PERIOD; GET OUT
                            	  3716: 
01:00201AA4 6100F4AC        	  3717:          BSR     GETA           GET ADDRESS VALUE
01:00201AA8 2880            	  3718:          MOVE.L  D0,(A4)        SAVE NEW VALUE
01:00201AAA 6000EB82        	  3719: SEMACS   BRA     MACSBUG
                            	  3720: 
                            	  3721: *JUST PRINT IT
                            	  3722: 
01:00201AAE 6148            	  3723: SETR4    BSR.S   PRINTR         FIX UP TO PRINT
01:00201AB0 6000E9EE        	  3724:          BRA     MSG            GO PRINT MESSAGE-GO TO MACSBUG
                            	  3725: 
01:00201AB4 6102            	  3726: SETR5    BSR.S   SETSR1
01:00201AB6 60F2            	  3727:          BRA     SEMACS
                            	  3728: 
01:00201AB8 613E            	  3729: SETSR1   BSR.S   PRINTR         FIX UP TO PRINT
01:00201ABA 1CFC0020        	  3730:          MOVE.B  #BLANK,(A6)+   SPACE
01:00201ABE 1CFC003F        	  3731:          MOVE.B  #'?',(A6)+     PROMPT
01:00201AC2 1CFC0020        	  3732:          MOVE.B  #BLANK,(A6)+   SPACE
01:00201AC6 6100059A        	  3733:          BSR     OUTPUT         PRINT IT
                            	  3734: 
01:00201ACA 61000622        	  3735:          BSR     FIXBUF
01:00201ACE 61000626        	  3736:          BSR     PORTIN1
                            	  3737: 
01:00201AD2 41FA0012        	  3738:          LEA     SETSR15(PC),A0 A0=DEFAULT (NO PARM) ADDRESS
01:00201AD6 610003F4        	  3739:          BSR     FNEXTF         FIND FIELD
                            	  3740: 
01:00201ADA 0C00002E        	  3741:          CMPI.B  #'.',D0
01:00201ADE 67CA            	  3742:          BEQ     SEMACS         PERIOD; GET OUT
                            	  3743: 
01:00201AE0 6100F470        	  3744:          BSR     GETA           CONVERT IT
01:00201AE4 2880            	  3745:          MOVE.L  D0,(A4)        STORE NEW DATA
                            	  3746: 
                            	  3747: SETSR15  DS      0
01:00201AE6 4E75            	  3748:          RTS
                            	  3749: 
                            	  3750: 
                            	  3751: * SEE IF CHARACTER IS IN BUFFER
                            	  3752: 
01:00201AE8 204D            	  3753: SCAN     MOVE.L  A5,A0          A0 IS WORKING SCANNER
01:00201AEA B1CE            	  3754: SCAN2    CMP.L   A6,A0          SEE IF AT END OF BUFFER
01:00201AEC 6208            	  3755:          BHI.S   RETURN5
01:00201AEE B010            	  3756:          CMP.B   (A0),D0        LOOK AT CHARACTER
01:00201AF0 6704            	  3757:          BEQ.S   RETURN5
01:00201AF2 5288            	  3758:          ADDQ.L  #1,A0          GET PAST CHARACTER
01:00201AF4 60F4            	  3759:          BRA.S   SCAN2
01:00201AF6 4E75            	  3760: RETURN5  RTS
                            	  3761: 
                            	  3762: * ROUTINE TO SET UP TO PRINT REG
                            	  3763: 
01:00201AF8 610005F4        	  3764: PRINTR   BSR     FIXBUF
                            	  3765: 
01:00201AFC 568E            	  3766:          ADDQ.L  #3,A6          GET PAST REG NAME (.XX)
01:00201AFE 1CFC003D        	  3767:          MOVE.B  #'=',(A6)+     PUT IN EQUAL SIGN
01:00201B02 2014            	  3768:          MOVE.L  (A4),D0        GET VALUE
01:00201B04 B8FC0404        	  3769:          CMPA.L  #REGSR,A4      SEE IF THIS IS CONDITION CODES
01:00201B08 6606            	  3770:          BNE.S   PRINTR2
01:00201B0A 610002FC        	  3771:          BSR     PNT4HX         JUST PRINT WORD
01:00201B0E 4E75            	  3772:          RTS
                            	  3773: 
01:00201B10 610002E8        	  3774: PRINTR2  BSR     PNT8HX         PRINT THE VALUE
01:00201B14 4E75            	  3775:          RTS
                            	  3776: 
                            	  3777: *
                            	  3778: *   PRINT ALL REGISTERS IN A CLASS (A OR D OR R)
                            	  3779: *
                            	  3780: 
                            	  3781: OFCMD    DS      0              "OF" Command -Display Offset registers-
01:00201B16 1E3C0052        	  3782: SETO     MOVE.B  #'R',D7
01:00201B1A 47F8044C        	  3783:          LEA     OFFSET,A3
01:00201B1E 6012            	  3784:          BRA.S   PNTCLSB
                            	  3785: 
01:00201B20 1E3C0044        	  3786: PNTCLSD  MOVE.B  #'D',D7        CLASS=DATA
01:00201B24 47F80408        	  3787:          LEA     REGS,A3        OFFSET
01:00201B28 6008            	  3788:          BRA.S   PNTCLSB
                            	  3789: 
01:00201B2A 1E3C0041        	  3790: PNTCLSA  MOVE.B  #'A',D7        CLASS=ADDRESS
01:00201B2E 47F80428        	  3791:          LEA     REGS+32,A3     OFFSET
01:00201B32 6104            	  3792: PNTCLSB  BSR.S   PNTCLS
01:00201B34 6000EAF8        	  3793:          BRA     MACSBUG
                            	  3794: 
01:00201B38 610005B4        	  3795: PNTCLS   BSR     FIXBUF
01:00201B3C 7C00            	  3796:          CLR.L   D6             REGISTER COUNTER
01:00201B3E 611C            	  3797: PNTCLS1  BSR.S   PNTREG         PRINT THE REGISTER
01:00201B40 0C060004        	  3798:          CMPI.B  #4,D6          DISPLAY AFTER 3&7
01:00201B44 660A            	  3799:          BNE.S   PNTCLS2
01:00201B46 61000500        	  3800:          BSR     OUT1CR
01:00201B4A 610005A2        	  3801:          BSR     FIXBUF
01:00201B4E 60EE            	  3802:          BRA     PNTCLS1        DO SOME MORE
                            	  3803: 
01:00201B50 0C060008        	  3804: PNTCLS2  CMPI.B  #8,D6          AT END?
01:00201B54 66E8            	  3805:          BNE     PNTCLS1
01:00201B56 610004F0        	  3806:          BSR     OUT1CR         PRINT IT
01:00201B5A 4E75            	  3807:          RTS
                            	  3808: 
                            	  3809: *  SUBROUTINE TO PRINT REGISTER  X#=01234567.
                            	  3810: 
01:00201B5C 1CC7            	  3811: PNTREG   MOVE.B  D7,(A6)+       CLASS
01:00201B5E 1006            	  3812:          MOVE.B  D6,D0          REG#
01:00201B60 610002B6        	  3813:          BSR     PUTHEX
01:00201B64 1CFC003D        	  3814:          MOVE.B  #'=',(A6)+     EQUAL SIGN
01:00201B68 2006            	  3815:          MOVE.L  D6,D0          COMPUTE ADDRESS OF REG
01:00201B6A E588            	  3816:          LSL.L   #2,D0          MULT BY FOUR
01:00201B6C D08B            	  3817:          ADD.L   A3,D0          ADD IN OFFSET
01:00201B6E 2840            	  3818:          MOVE.L  D0,A4          SET UP TO GET DEFFERED
01:00201B70 B8FC0444        	  3819:          CMPA.L  #REGA7,A4      SEE IF REG A7
01:00201B74 660E            	  3820:          BNE.S   PNTREG1
01:00201B76 20380404        	  3821:          MOVE.L  REGSR,D0       GET STATUS REGISTER
01:00201B7A 02402000        	  3822:          ANDI.W  #$2000,D0      CHECK SUPERVISOR BIT
01:00201B7E 6604            	  3823:          BNE.S   PNTREG1
01:00201B80 49F80448        	  3824:          LEA     REGUS,A4       TAKE ADDRESS OF USER STACK
01:00201B84 2014            	  3825: PNTREG1  MOVE.L  (A4),D0        GET REG CONTENT
01:00201B86 61000272        	  3826:          BSR     PNT8HX         PUT IN BUFFER
01:00201B8A 1CFC0020        	  3827:          MOVE.B  #BLANK,(A6)+   SPACE
01:00201B8E 5286            	  3828:          ADDQ.L  #1,D6          BUMP REG#
01:00201B90 4E75            	  3829:          RTS
