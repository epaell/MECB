                            	  5885: 
                            	  5886: LAB_2828
01:002060A8 65B8            	  5887: 	BCS.s		LAB_27D0			* if FAC1 > FAC2 return d0=-1,C=1/-ve d0=+1,
                            	  5888: 							* C=0/+ve
                            	  5889: 
