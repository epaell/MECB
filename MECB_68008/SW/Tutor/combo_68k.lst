01:00205DE0 4A2B0594        	  5312: 	TST.b		FAC1_e(a3)			* test exponent
01:00205DE4 6748            	  5313: 	BEQ.s		LAB_LONN			* if 0 skip calculation
                            	  5314: 
01:00205DE6 122B0594        	  5315: 	MOVE.b	FAC1_e(a3),d1		* get exponent
01:00205DEA 923C0082        	  5316: 	SUB.b		#$82,d1			* normalise and two integer bits
01:00205DEE 4401            	  5317: 	NEG.b		d1				* negate for shift
