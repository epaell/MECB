                            	   863: *************************************************************
                            	   864: * -FIXDATA- SUBROUTINE...  MOVES MESSAGE POINTED TO BY (A5) *
                            	   865: *                          INTO "BUFFER". EOT, ($04), ENDS  *
                            	   866: *                          THE MOVE. AT COMPLETION (A5) IS  *
                            	   867: *                          POINTING AT THE BEGINNING, (A6)  *
                            	   868: *                          POINTS AT END.                   *
                            	   869: *************************************************************
                            	   870: 
01:002004EA 4DF80540        	   871: FIXDATA  LEA     BUFFER,A6
01:002004EE 0C150004        	   872: FIXDADD  CMPI.B  #EOT,(A5)
01:002004F2 6704            	   873:          BEQ.S   FIXD2
01:002004F4 1CDD            	   874:          MOVE.B  (A5)+,(A6)+
01:002004F6 60F6            	   875:          BRA     FIXDADD
01:002004F8 4BF80540        	   876: FIXD2    LEA     BUFFER,A5
01:002004FC 4E75            	   877:          RTS
                            	   878: 
                            	   879: 
                            	   880: ************************************************************
                            	   881: * -FIXDCRLF- SUBROUTINE INSERTS A CARRIAGE RETURN AND LINE *
                            	   882: *                       FEED IN FRONT OF THE TEXT, THEN    *
                            	   883: *                       USES THE REMAINING PORTION OF THE  *
                            	   884: *                       FIXDATA.                           *
                            	   885: ************************************************************
                            	   886: 
01:002004FE 4DF80540        	   887: FIXDCRLF LEA     BUFFER,A6
01:00200502 3CFC0D0A        	   888:          MOVE.W  #$0D0A,(A6)+   CR,LF
01:00200506 60E6            	   889:          BRA     FIXDADD
