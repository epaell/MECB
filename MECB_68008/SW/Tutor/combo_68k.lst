                            	  7159: *        ..........XXXXXX       EFFECTIVE ADDRESS
                            	  7160: *        .........0......       WORD
                            	  7161: *        .........1......       LONG
                            	  7162: *        .....0..........       REGISTER TO MEMORY
                            	  7163: *        .....1..........       MEMORY TO REGISTER
                            	  7164: *
                            	  7165: 
