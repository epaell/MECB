                            	  5366: LAB_LONN
01:00205E2E 2800            	  5367: 	MOVE.l	d0,d4				* save cordic result
01:00205E30 7A00            	  5368: 	MOVEQ		#0,d5				* set default exponent sign
01:00205E32 4A87            	  5369: 	TST.l		d7				* check original exponent sign
01:00205E34 6716            	  5370: 	BEQ.s		LAB_LOXO			* branch if original was 0
                            	  5371: 
01:00205E36 6A04            	  5372: 	BPL.s		LAB_LOXP			* branch if was +ve
                            	  5373: 
01:00205E38 4487            	  5374: 	NEG.l		d7				* make original exponent +ve
01:00205E3A 7A80            	  5375: 	MOVEQ		#$80-$100,d5		* make sign -ve
                            	  5376: LAB_LOXP
01:00205E3C 17450595        	  5377: 	MOVE.b	d5,FAC1_s(a3)		* save original exponent sign
01:00205E40 4847            	  5378: 	SWAP		d7				* 16 bit shift
01:00205E42 E18F            	  5379: 	LSL.l		#8,d7				* easy first part
01:00205E44 7A88            	  5380: 	MOVEQ		#$88-$100,d5		* start with byte
                            	  5381: LAB_LONE
01:00205E46 5385            	  5382: 	SUBQ.l	#1,d5				* decrement exponent
01:00205E48 DE87            	  5383: 	ADD.l		d7,d7				* shift mantissa
01:00205E4A 6AFA            	  5384: 	BPL.s		LAB_LONE			* loop if not normal
                            	  5385: 
                            	  5386: LAB_LOXO
01:00205E4C 27470590        	  5387: 	MOVE.l	d7,FAC1_m(a3)		* save original exponent as mantissa
01:00205E50 17450594        	  5388: 	MOVE.b	d5,FAC1_e(a3)		* save exponent for this
01:00205E54 277CB17217F80598	  5389: 	MOVE.l	#$B17217F8,FAC2_m(a3)	* LOG(2) mantissa
01:00205E5C 377C8000059C    	  5390: 	MOVE.w	#$8000,FAC2_e(a3)		* LOG(2) exponent & sign
