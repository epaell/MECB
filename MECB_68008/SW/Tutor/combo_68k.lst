01:00200F68 660C            	  2213:          BNE.S   GAP113
                            	  2214: 
                            	  2215: *  [  SET INDIRECT
                            	  2216: 
01:00200F6A 00458000        	  2217:          ORI.W   #$8000,D5      SET LEFT BRACKET (GALB)
                            	  2218: 
01:00200F6E 101D            	  2219: GAP111   MOVE.B  (A5)+,D0       GET BYTE
01:00200F70 BDCD            	  2220:          CMP.L   A5,A6
01:00200F72 650000FA        	  2221:          BCS     GAP191         END OF BUFFER
                            	  2222: GAP113   DS      0
                            	  2223: 
01:00200F76 0C00002B        	  2224:          CMPI.B  #'+',D0
01:00200F7A 675E            	  2225:          BEQ.S   GAP121         PLUS SIGN
                            	  2226: 
01:00200F7C 0C00002D        	  2227:          CMPI.B  #'-',D0
01:00200F80 6758            	  2228:          BEQ.S   GAP121         MINUS SIGN
                            	  2229: 
01:00200F82 0C00005D        	  2230:          CMPI.B  #']',D0
01:00200F86 675E            	  2231:          BEQ.S   GAP131         RIGHT BRACKET (INDIRECT)
                            	  2232: 
01:00200F88 0C000028        	  2233:          CMPI.B  #'(',D0
01:00200F8C 676C            	  2234:          BEQ.S   GAP141         LEFT PARIN
                            	  2235: 
01:00200F8E 0C00002C        	  2236:          CMPI.B  #',',D0
01:00200F92 67000092        	  2237:          BEQ     GAP161         COMMA
                            	  2238: 
01:00200F96 0C000029        	  2239:          CMPI.B  #')',D0
01:00200F9A 670000CC        	  2240:          BEQ     GAP181         RIGHT PARIN
                            	  2241: 
