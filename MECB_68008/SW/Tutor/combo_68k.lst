                            	  2747: *-------------------------------------------------------------------------
                            	  2748: * File HEX2DEC   HEX2DEC convert hex to decimal                   11/02/81
                            	  2749: 
                            	  2750: 
                            	  2751: *    CONVERT BINARY TO DECIMAL  REG D0 PUT IN (A6) BUFFER AS ASCII
                            	  2752: 
01:002013BA 48E77B00        	  2753: HEX2DEC  MOVEM.L D1-D4/D6-D7,-(A7)   SAVE REGISTERS
01:002013BE 2E00            	  2754:          MOVE.L  D0,D7          SAVE IT HERE
01:002013C0 6A08            	  2755:          BPL.S   HX2DC
01:002013C2 4487            	  2756:          NEG.L   D7             CHANGE TO POSITIVE
01:002013C4 6B4E            	  2757:          BMI.S   HX2DC57        SPECIAL CASE (-0)
01:002013C6 1CFC002D        	  2758:          MOVE.B  #'-',(A6)+     PUT IN NEG SIGN
01:002013CA 4244            	  2759: HX2DC    CLR.W   D4             FOR ZERO SURPRESS
01:002013CC 7C0A            	  2760:          MOVEQ   #10,D6         COUNTER
01:002013CE 7401            	  2761: HX2DC0   MOVEQ   #1,D2          VALUE TO SUB
01:002013D0 2206            	  2762:          MOVE.L  D6,D1          COUNTER
01:002013D2 5381            	  2763:          SUBQ.L  #1,D1          ADJUST - FORM POWER OF TEN
01:002013D4 671A            	  2764:          BEQ.S   HX2DC2         IF POWER IS ZERO
01:002013D6 3602            	  2765: HX2DC1   MOVE.W  D2,D3          D3=LOWER WORD
01:002013D8 C6FC000A        	  2766:          MULU    #10,D3
01:002013DC 4842            	  2767:          SWAP    D2             D2=UPPER WORD
01:002013DE C4FC000A        	  2768:          MULU    #10,D2
01:002013E2 4843            	  2769:          SWAP    D3             ADD UPPER TO UPPER
01:002013E4 D443            	  2770:          ADD.W   D3,D2
01:002013E6 4842            	  2771:          SWAP    D2             PUT UPPER IN UPPER
01:002013E8 4843            	  2772:          SWAP    D3             PUT LOWER IN LOWER
01:002013EA 3403            	  2773:          MOVE.W  D3,D2          D2=UPPER & LOWER
01:002013EC 5381            	  2774:          SUBQ.L  #1,D1
01:002013EE 66E6            	  2775:          BNE     HX2DC1
01:002013F0 7000            	  2776: HX2DC2   CLR.L   D0             HOLDS SUB AMT
01:002013F2 BE82            	  2777: HX2DC22  CMP.L   D2,D7
01:002013F4 6D06            	  2778:          BLT.S   HX2DC3         IF NO MORE SUB POSSIBLE
01:002013F6 5280            	  2779:          ADDQ.L  #1,D0          BUMP SUBS
01:002013F8 9E82            	  2780:          SUB.L   D2,D7          COUNT DOWN BY POWERS OF TEN
01:002013FA 60F6            	  2781:          BRA.S   HX2DC22        DO MORE
01:002013FC 4A00            	  2782: HX2DC3   TST.B   D0             ANY VALUE?
01:002013FE 6604            	  2783:          BNE.S   HX2DC4
01:00201400 4A44            	  2784:          TST.W   D4             ZERO SURPRESS
01:00201402 6708            	  2785:          BEQ.S   HX2DC5
01:00201404 06000030        	  2786: HX2DC4   ADDI.B  #$30,D0        BINARY TO ASCII
01:00201408 1CC0            	  2787:          MOVE.B  D0,(A6)+       PUT IN BUFFER
01:0020140A 1800            	  2788:          MOVE.B  D0,D4          MARK AS NON ZERO SURPRESS
01:0020140C 5386            	  2789: HX2DC5   SUBQ.L  #1,D6          NEXT POWER
01:0020140E 66BE            	  2790:          BNE     HX2DC0
01:00201410 4A44            	  2791:          TST.W   D4             SEE IF ANYTHING PRINTED
01:00201412 6604            	  2792:          BNE.S   HX2DC6
01:00201414 1CFC0030        	  2793: HX2DC57  MOVE.B  #'0',(A6)+     PRINT AT LEST A ZERO
01:00201418 4CDF00DE        	  2794: HX2DC6   MOVEM.L (A7)+,D1-D4/D6-D7   RESTORE REGISTERS
01:0020141C 4E75            	  2795:          RTS                    END OF ROUTINE
