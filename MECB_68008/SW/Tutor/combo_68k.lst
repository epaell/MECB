01:002020FA 6706            	  4553:          BEQ.S   PORTIN1X
01:002020FC 2F380620        	  4554:          MOVE.L  INFROM,-(A7)   PUSH ON STACK
01:00202100 4E75            	  4555:          RTS                    GO DO IT
01:00202102 2F38062C        	  4556: PORTIN1X MOVE.L  INPORT1,-(A7)  GO TO IO ROUTINE
01:00202106 4E75            	  4557:          RTS                    NORMALLY GOES TO PORTIN10
                            	  4558: 
01:00202108 48E7F9E0        	  4559: PORTIN1N MOVEM.L D0-D4/D7/A0-A2,-(A7)
01:0020210C 4A3804E8        	  4560:          TST.B   XONOFF+2
01:00202110 6608            	  4561:          BNE.S   PORTIN1V       OVERRIDE "No Auto Line Feed"
01:00202112 7E01            	  4562:          MOVEQ   #1,D7          "No Auto Line Feed" Entry point
01:00202114 6006            	  4563:          BRA.S   PORTIN1W
                            	  4564: 
                            	  4565: * ENTRY ALSO POSSIBLE FROM:  PORTIN2
01:00202116 48E7F9E0        	  4566: PORTIN10 MOVEM.L D0-D4/D7/A0-A2,-(A7)
01:0020211A 7E00            	  4567: PORTIN1V CLR.L   D7             "Auto Line Feed" Entry point.
01:0020211C 7600            	  4568: PORTIN1W CLR.L   D3             FLAG AS PORT1
01:0020211E 61AA            	  4569:          BSR     GETSER1        MOVE ADDRESS INTO A0
                            	  4570: 
01:00202120 610002DC        	  4571: READBUF  BSR     INCHNE         GO GET SOME DATA  (NO ECHO)
01:00202124 4A00            	  4572:          TST.B   D0             CHECK FOR NULLS
01:00202126 67F8            	  4573:          BEQ.S   READBUF
01:00202128 3800            	  4574:          MOVE.W  D0,D4          SAVE FOR A WHILE
01:0020212A 6100FF6E        	  4575:          BSR     OUTCH1         ECHO WHAT IS IN D0
01:0020212E 3004            	  4576:          MOVE.W  D4,D0          RESTORE IT
01:00202130 0C00000A        	  4577:          CMPI.B  #LF,D0         SEE IF LINE FEED
01:00202134 67EA            	  4578:          BEQ.S   READBUF        DONT PUT IT IN BUFFER
                            	  4579: 
01:00202136 0C000018        	  4580:          CMPI.B  #CTLX,D0       SEE IF CTRL-X "CANCEL LINE"
01:0020213A 6610            	  4581:          BNE.S   CHKCTLH        No... Then go check for backspace
01:0020213C 700D            	  4582:          MOVEQ   #CR,D0         Yes.. 1) Send a carriage return
01:0020213E 6100FF5A        	  4583:          BSR     OUTCH1         *
01:00202142 700A            	  4584:          MOVEQ   #LF,D0         *     2) Send a line feed
01:00202144 6100FF54        	  4585:          BSR     OUTCH1         *
01:00202148 2C4D            	  4586:          MOVE.L  A5,A6          *     3) Set BUFFER at start again
01:0020214A 60D4            	  4587:          BRA.S   READBUF        *     4) Restart this routine
                            	  4588: 
01:0020214C 0C000008        	  4589: CHKCTLH  CMPI.B  #CTLH,D0       CTRL-H? (Backspace)
01:00202150 6714            	  4590:          BEQ.S   BS4CTLH        Yes...  Go backspace 1 character
01:00202152 0C00007F        	  4591:          CMPI.B  #DEL,D0        DEL?    (Also a Backspace)
01:00202156 6624            	  4592:          BNE.S   CHKCTLD        No....  Then go check for CTRL D
01:00202158 BDCD            	  4593: BKSPACE  CMP.L   A5,A6          Yes...  Usually need an extra "Backspace"
01:0020215A 67C4            	  4594:          BEQ     READBUF        If at start of buffer, don't back up any more.
01:0020215C 103C0008        	  4595:          MOVE.B  #CTLH,D0       Backspace cursor.
01:00202160 6100FF38        	  4596:          BSR     OUTCH1         *
01:00202164 6004            	  4597:          BRA.S   BLANKIT        Bypass check for start of buffer
                            	  4598: 
                            	  4599: BS4CTLH  DS      0              CTL-H already backed up 1 character.
01:00202166 BDCD            	  4600:          CMP.L   A5,A6          At beginning of buffer?
01:00202168 67B6            	  4601:          BEQ     READBUF        Yes...  Then don't back up any more.
01:0020216A 7020            	  4602: BLANKIT  MOVEQ   #$20,D0        Now blank out previous character.
01:0020216C 6100FF2C        	  4603:          BSR     OUTCH1         *
01:00202170 1026            	  4604:          MOVE.B  -(A6),D0       Remove last character from buffer.
01:00202172 103C0008        	  4605:          MOVE.B  #CTLH,D0       Backup cursor again.
01:00202176 6100FF22        	  4606:          BSR     OUTCH1         *
01:0020217A 60A4            	  4607:          BRA     READBUF        Go get next character.
                            	  4608: 
01:0020217C 0C000004        	  4609: CHKCTLD  CMPI.B  #CTLD,D0       CTL D?  (REPRINT)
01:00202180 6626            	  4610:          BNE.S   CHKCR          No....  Then go check if a "CR".
01:00202182 700D            	  4611:          MOVEQ   #CR,D0         Yes...  Print "CR"
01:00202184 6100FF14        	  4612:          BSR     OUTCH1         *
01:00202188 700A            	  4613:          MOVEQ   #LF,D0         Print "LF"
01:0020218A 6100FF0E        	  4614:          BSR     OUTCH1         *
01:0020218E 2F0D            	  4615:          MOVE.L  A5,-(A7)       SAVE ON STACK FOR A MOMENT
01:00202190 6100FED0        	  4616:          BSR     OUTPUT         GO PRINT BUFFER
01:00202194 2A5F            	  4617:          MOVE.L  (A7)+,A5       GET BACK FROM STACK
01:00202196 6088            	  4618:          BRA     READBUF
                            	  4619: 
01:00202198 1CC0            	  4620: CHARSAVE MOVE.B  D0,(A6)+       SAVE DATA INTO BUFFER
01:0020219A 220E            	  4621:          MOVE.L  A6,D1          CALCULATE ROOM USED
01:0020219C 928D            	  4622:          SUB.L   A5,D1          DONT USE MORE THAN "BUFFSIZE"
01:0020219E 0C410080        	  4623:          CMPI.W  #BUFFSIZE,D1
01:002021A2 6B00FF7C        	  4624:          BMI     READBUF        We're OK, go get next character.
01:002021A6 60B0            	  4625:          BRA     BKSPACE        If not, handle as though a "CNTL-H"
                            	  4626: 
01:002021A8 0C00000D        	  4627: CHKCR    CMPI.B  #CR,D0         CR?  (End of command line).
01:002021AC 66EA            	  4628:          BNE.S   CHARSAVE       No.. Then go store this character.
                            	  4629: 
01:002021AE 4A07            	  4630:          TST.B   D7             Check "Auto Line Feed" switch
01:002021B0 6606            	  4631:          BNE.S   NOAUTOLF       Yes.. Bypass sending Line feed.
01:002021B2 700A            	  4632:          MOVEQ   #LF,D0         No... Set one up and...
01:002021B4 6100FEE4        	  4633:          BSR     OUTCH1         .     Send it!
                            	  4634: NOAUTOLF DS      0
                            	  4635: 
01:002021B8 4CDF079F        	  4636:  MOVEM.L (A7)+,D0-D4/D7/A0-A2 Restore Regs.
01:002021BC 4E75            	  4637:          RTS                    RETURN TO CALLER
