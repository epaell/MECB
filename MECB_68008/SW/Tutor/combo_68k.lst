                            	  2162: *-------------------------------------------------------------------------
                            	  2163: * File GETA      GET ADDRESS Subroutine                           12/01/81
                            	  2164: 
                            	  2165: * GET ADDRESS
                            	  2166: *  ENTER (A5) POINTER START OF BUFFER
                            	  2167: *        (A6) POINTER END OF BUFFER
                            	  2168: *
                            	  2169: *  RETURN:  D0 = ADDRESS
                            	  2170: 
                            	  2171: *        (A6) POINTER END OF BUFFER
                            	  2172: *
                            	  2173: *  RETURN:  D0 = ADDRESS
                            	  2174: 
                            	  2175: 
                            	  2176: * FORMATS HANDLED:
                            	  2177: *  1.  NUMBER        DEFAULTS TO HEX
                            	  2178: *  2.  $NUMBER       HEX
                            	  2179: *  3.  &NUMBER       DECIMAL
                            	  2180: *  4.  (A@)
                            	  2181: *  5.  NUMBER(A@)
                            	  2182: *  6.  (A@,D@)
                            	  2183: *  7.  NUMBER(A@,D@)
                            	  2184: *  8.  [NUMBER]      MEMORY INDIRECT
                            	  2185: *
                            	  2186: *   FORMATS 1,2,3,8  ADD OFFSET R0 UNLESS R1 - R7 SPECIFIED
                            	  2187: 
                            	  2188: 
                            	  2189: * WORK REGISTERS
                            	  2190: *  D4    VALUE BEING BUILT
                            	  2191: *
                            	  2192: *  D5    FLAG REGISTER
                            	  2193: *     = 8000XXXX  R@ GIVEN (GARO)
                            	  2194: *     = XXXX80XX  [  GIVEN (GALB)
                            	  2195: *     = XXXXXX80  (  GIVEN (GALP)
                            	  2196: *
                            	  2197: *  D6    FLAG REGISTER
                            	  2198: *     = 8000XXXX  A@ GIVEN           (GAAVF)
                            	  2199: *     = XXXX80XX  NEED PLUS OR MINUS (GANPM)
                            	  2200: *     = XXXXXX2B  +  PLUS GIVEN      (GAPMS)
                            	  2201: *             2D  -  MINUS GIVEN
                            	  2202: 
01:00200F52 48E70E80        	  2203: GETA     MOVEM.L D4-D6/A0,-(A7) SAVE SOME REGISTERS
01:00200F56 7800            	  2204:          CLR.L   D4             VALUE BEING BUILT
01:00200F58 7A00            	  2205:          CLR.L   D5             FLAG REG
01:00200F5A 7C00            	  2206:          CLR.L   D6             FLAG REG
                            	  2207: 
01:00200F5C 101D            	  2208:          MOVE.B  (A5)+,D0       GET BYTE
01:00200F5E BDCD            	  2209:          CMP.L   A5,A6
