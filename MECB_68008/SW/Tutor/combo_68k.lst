                            	  7476: *************************************************************************************
                            	  7477: *
                            	  7478: * ctrl-c check routine. includes limited "life" byte save for INGET routine
                            	  7479: 
                            	  7480: VEC_CC
01:00206B16 4A2B05E8        	  7481: 	TST.b		ccflag(a3)			* check [CTRL-C] check flag
01:00206B1A 661E            	  7482: 	BNE.s		RTS_022			* exit if [CTRL-C] check inhibited
                            	  7483: 
01:00206B1C 4EAB040C        	  7484: 	JSR		V_INPT(a3)			* scan input device
01:00206B20 640E            	  7485: 	BCC.s		LAB_FBA0			* exit if buffer empty
                            	  7486: 
01:00206B22 174005E9        	  7487: 	MOVE.b	d0,ccbyte(a3)		* save received byte
01:00206B26 177C002005EA    	  7488: 	MOVE.b	#$20,ccnull(a3)		* set "life" timer for bytes countdown
01:00206B2C 6000DF06        	  7489: 	BRA		LAB_1636			* return to BASIC
                            	  7490: 
                            	  7491: LAB_FBA0
01:00206B30 4A2B05EA        	  7492: 	TST.b		ccnull(a3)			* get countdown byte
01:00206B34 6704            	  7493: 	BEQ.s		RTS_022			* exit if finished
                            	  7494: 
01:00206B36 532B05EA        	  7495: 	SUBQ.b	#1,ccnull(a3)		* else decrement countdown
                            	  7496: RTS_022
01:00206B3A 4E75            	  7497: 	RTS
                            	  7498: 
                            	  7499: 
                            	  7500: *************************************************************************************
                            	  7501: *
                            	  7502: * get byte from input device, no waiting
                            	  7503: * returns with carry set if byte in A
                            	  7504: 
                            	  7505: INGET
01:00206B3C 4EAB040C        	  7506: 	JSR		V_INPT(a3)			* call scan input device
01:00206B40 650A            	  7507: 	BCS.s		LAB_FB95			* if byte go reset timer
                            	  7508: 
01:00206B42 102B05EA        	  7509: 	MOVE.b	ccnull(a3),d0		* get countdown
01:00206B46 67F2            	  7510: 	BEQ.s		RTS_022			* exit if empty
                            	  7511: 
01:00206B48 102B05E9        	  7512: 	MOVE.b	ccbyte(a3),d0		* get last received byte
                            	  7513: LAB_FB95
01:00206B4C 177C000005EA    	  7514: 	MOVE.b	#$00,ccnull(a3)		* clear timer because we got a byte
01:00206B52 003C0001        	  7515: 	ORI.b		#1,CCR			* set carry, flag we got a byte
01:00206B56 4E75            	  7516: 	RTS
