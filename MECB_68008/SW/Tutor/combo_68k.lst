                            	  5769: *************************************************************************************
                            	  5770: *
                            	  5771: * round FAC1
                            	  5772: 
                            	  5773: LAB_27BA
01:0020602A 102B0594        	  5774: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:0020602E 6720            	  5775: 	BEQ.s		LAB_27C4			* branch if zero
                            	  5776: 
01:00206030 202B0590        	  5777: 	MOVE.l	FAC1_m(a3),d0		* get FAC1
01:00206034 D0BC00000080    	  5778: 	ADD.l		#$80,d0			* round to 24 bit
01:0020603A 640A            	  5779: 	BCC.s		LAB_27C3			* branch if no overflow
                            	  5780: 
01:0020603C E290            	  5781: 	ROXR.l	#1,d0				* shift FAC1 mantissa
01:0020603E 522B0594        	  5782: 	ADDQ.b	#1,FAC1_e(a3)		* correct exponent
01:00206042 6500E57A        	  5783: 	BCS		LAB_OFER			* if carry do overflow error & warm start
                            	  5784: 
