                            	  5860: *************************************************************************************
                            	  5861: *
                            	  5862: * compare FAC1 with FAC2
                            	  5863: * returns d0=+1 Cb=0 if FAC1 > FAC2
                            	  5864: * returns d0= 0 Cb=0 if FAC1 = FAC2
                            	  5865: * returns d0=-1 Cb=1 if FAC1 < FAC2
                            	  5866: 
                            	  5867: LAB_27FA
01:00206088 122B059C        	  5868: 	MOVE.b	FAC2_e(a3),d1		* get FAC2 exponent
01:0020608C 67C8            	  5869: 	BEQ.s		LAB_27CA			* branch if FAC2 exponent=0 & get FAC1 sign
                            	  5870: 							* d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5871: 
01:0020608E 102B059E        	  5872: 	MOVE.b	FAC_sc(a3),d0		* get FAC sign compare
01:00206092 6BCA            	  5873: 	BMI.s		LAB_27CE			* if signs <> do return d0=-1,C=1/-ve
                            	  5874: 							* d0=+1,C=0/+ve & return
                            	  5875: 
01:00206094 102B0595        	  5876: 	MOVE.b	FAC1_s(a3),d0		* get FAC1 sign
