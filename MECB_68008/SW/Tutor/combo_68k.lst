                            	  5891: LAB_282E
01:002060AE 60B2            	  5892: 	BRA.s		LAB_27D0			* return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5893: 
                            	  5894: LAB_282F
01:002060B0 7000            	  5895: 	MOVEQ		#0,d0				* clear result
01:002060B2 4E75            	  5896: 	RTS
