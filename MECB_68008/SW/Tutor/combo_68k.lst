                            	  3171: *-------------------------------------------------------------------------
                            	  3172: * File MMDI      Modify Memory command WITH asm/disasm            11/27/81
                            	  3173: 
                            	  3174: * MODIFY MEMORY
                            	  3175: *  COMMON REGISTER USAGE
                            	  3176: *   A6  IO BUFFER POINTER  END
                            	  3177: *   A5  IO BUFFER POINTER  START
                            	  3178: *   A4  ADDRESS TO MODIFY
                            	  3179: *   A3
                            	  3180: *   A2
                            	  3181: *   A1
                            	  3182: *   A0
                            	  3183: *   D7  DATA READ (DATA STORED)
                            	  3184: *   D6  SIZE  1/2/4 BYTES  (ASM/DISASM 2 - 10 BYTES)
                            	  3185: *   D5  OVERRIDE BYTE (80XX=NON VERIFY)  (XX80=BYTE SIZE)
                            	  3186: *
                            	  3187: * ;OPTIONS
                            	  3188: *   ;W  WORD
                            	  3189: *   ;L  LONG WORD (4 BYTES)
                            	  3190: *   ;DI DISASSEMBLE
                            	  3191: *     ;O  ODD ADDRESSES ONLY
                            	  3192: *     ;V  EVEN ADDRESSES ONLY
                            	  3193: *       ;N  NON-VERIFY
                            	  3194: *
                            	  3195: 
01:002016D8 61000810        	  3196: MMDI     BSR     CKWADR
01:002016DC 61000812        	  3197:          BSR     CKADDR
01:002016E0 7C00            	  3198:          CLR.L   D6             SIZE = 0
01:002016E2 D9C6            	  3199: MMDI22   ADD.L   D6,A4          PC = PC + SIZE
01:002016E4 61000A08        	  3200: MMDI23   BSR     FIXBUF         A5 & A6 = POINTER TO BUFFER
                            	  3201: 
                            	  3202: *                  ENTRY
                            	  3203: *                   A4 = PROGRAM COUNTER
                            	  3204: *                   A5 = POINTER TO STORE DISASSEMBLED LINE
01:002016E8 4CD40007        	  3205:          MOVEM.L   (A4),D0-D2          DATA TO DISASSEMBLE
01:002016EC 610027D0        	  3206:          BSR       DCODE68K
                            	  3207: *                  RETURN
                            	  3208: *                   A4 = NEW PROGRAM COUNTER
                            	  3209: *                   A5 = PTR START BUFFER
                            	  3210: *                   A6 = PRT END BUFFER
                            	  3211: *                   D6 = NUMBER OF BYTES DISASSEMBLED
                            	  3212: 
01:002016F0 1CFC003F        	  3213:          MOVE.B  #'?',(A6)+
