                            	  7518: 
                            	  7519: *************************************************************************************
                            	  7520: *
                            	  7521: * perform MAX()
                            	  7522: 
                            	  7523: LAB_MAX
01:00206B58 6100E552        	  7524: 	BSR		LAB_EVEZ			* evaluate expression (no decrement)
01:00206B5C 4A2B05B5        	  7525: 	TST.b		Dtypef(a3)			* test data type
01:00206B60 6B00DA40        	  7526: 	BMI		LAB_TMER			* if string do Type missmatch Error/warm start
                            	  7527: 
                            	  7528: LAB_MAXN
01:00206B64 612C            	  7529: 	BSR.s		LAB_PHFA			* push FAC1, evaluate expression,
                            	  7530: 							* pull FAC2 & compare with FAC1
01:00206B66 64FC            	  7531: 	BCC.s		LAB_MAXN			* branch if no swap to do
                            	  7532: 
01:00206B68 6100F4B2        	  7533: 	BSR		LAB_279B			* copy FAC2 to FAC1
01:00206B6C 60F6            	  7534: 	BRA.s		LAB_MAXN			* go do next
                            	  7535: 
                            	  7536: 
                            	  7537: *************************************************************************************
                            	  7538: *
                            	  7539: * perform MIN()
                            	  7540: 
                            	  7541: LAB_MIN
01:00206B6E 6100E53C        	  7542: 	BSR		LAB_EVEZ			* evaluate expression (no decrement)
01:00206B72 4A2B05B5        	  7543: 	TST.b		Dtypef(a3)			* test data type
01:00206B76 6B00DA2A        	  7544: 	BMI		LAB_TMER			* if string do Type missmatch Error/warm start
                            	  7545: 
                            	  7546: LAB_MINN
01:00206B7A 6116            	  7547: 	BSR.s		LAB_PHFA			* push FAC1, evaluate expression,
                            	  7548: 							* pull FAC2 & compare with FAC1
01:00206B7C 63FC            	  7549: 	BLS.s		LAB_MINN			* branch if no swap to do
                            	  7550: 
01:00206B7E 6100F49C        	  7551: 	BSR		LAB_279B			* copy FAC2 to FAC1
01:00206B82 60F6            	  7552: 	BRA.s		LAB_MINN			* go do next (branch always)
                            	  7553: 
                            	  7554: * exit routine. don't bother returning to the loop code
                            	  7555: * check for correct exit, else so syntax error
                            	  7556: 
                            	  7557: LAB_MMEC
01:00206B84 B03C0029        	  7558: 	CMP.b		#')',d0			* is it end of function?
01:00206B88 6600DA44        	  7559: 	BNE		LAB_SNER			* if not do MAX MIN syntax error
                            	  7560: 
01:00206B8C 588F            	  7561: 	LEA		4(sp),sp			* dump return address (faster)
01:00206B8E 6000E67A        	  7562: 	BRA		LAB_IGBY			* update BASIC execute pointer (to chr past ")")
                            	  7563: 							* and return
                            	  7564: 
                            	  7565: * check for next, evaluate & return or exit
                            	  7566: * this is the routine that does most of the work
                            	  7567: 
                            	  7568: LAB_PHFA
01:00206B92 6100E678        	  7569: 	BSR		LAB_GBYT			* get next BASIC byte
01:00206B96 B03C002C        	  7570: 	CMP.b		#',',d0			* is there more ?
01:00206B9A 66E8            	  7571: 	BNE.s		LAB_MMEC			* if not go do end check
                            	  7572: 
01:00206B9C 3F2B0594        	  7573: 	MOVE.w	FAC1_e(a3),-(sp)		* push exponent and sign
01:00206BA0 2F2B0590        	  7574: 	MOVE.l	FAC1_m(a3),-(sp)		* push mantissa
                            	  7575: 
01:00206BA4 6100E506        	  7576: 	BSR		LAB_EVEZ			* evaluate expression (no decrement)
01:00206BA8 4A2B05B5        	  7577: 	TST.b		Dtypef(a3)			* test data type
01:00206BAC 6B00D9F4        	  7578: 	BMI		LAB_TMER			* if string do Type missmatch Error/warm start
                            	  7579: 
                            	  7580: 
                            	  7581: 							* pop FAC2 (MAX/MIN expression so far)
01:00206BB0 275F0598        	  7582: 	MOVE.l	(sp)+,FAC2_m(a3)		* pop mantissa
                            	  7583: 
01:00206BB4 301F            	  7584: 	MOVE.w	(sp)+,d0			* pop exponent and sign
01:00206BB6 3740059C        	  7585: 	MOVE.w	d0,FAC2_e(a3)		* save exponent and sign
01:00206BBA 176B0595059E    	  7586: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* get FAC1 sign
