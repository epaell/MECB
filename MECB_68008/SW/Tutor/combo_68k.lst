                            	  1151:          DC.W    \1CMD-FIRST    *************************************
                            	  1152:          ENDC
                            	  1153:          IFNC    '\1','PER'     If not PERCMD...
                            	  1154:          IFEQ    '\1'&($FF00)   If 1 digit code, 2nd will be a blank.
                            	  1155:          DC.W    '\1 '+FLAG     * "\1"....Command  -  -  (Single Digit)
                            	  1156:          ENDC
                            	  1157:          IFNE    '\1'&($FF00)   If 2 digit code, leave as is.
                            	  1158:          DC.W    '\1'+FLAG      * "\1"...Command
                            	  1159:          ENDC
