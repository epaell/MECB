                            	  5701: *************************************************************************************
                            	  5702: *
                            	  5703: * unpack memory (a0) into FAC1
                            	  5704: 
                            	  5705: LAB_UFAC
01:00205FC2 2010            	  5706: 	MOVE.l	(a0),d0			* get packed value
01:00205FC4 4840            	  5707: 	SWAP		d0				* exponent and sign into least significant word
01:00205FC6 37400594        	  5708: 	MOVE.w	d0,FAC1_e(a3)		* save exponent and sign
01:00205FCA 6708            	  5709: 	BEQ.s		LAB_NB1T			* branch if exponent (and the rest) zero
                            	  5710: 
01:00205FCC 807C0080        	  5711: 	OR.w		#$80,d0			* set MSb
01:00205FD0 4840            	  5712: 	SWAP		d0				* word order back to normal
01:00205FD2 E180            	  5713: 	ASL.l		#8,d0				* shift exponent & clear guard byte
                            	  5714: LAB_NB1T
01:00205FD4 27400590        	  5715: 	MOVE.l	d0,FAC1_m(a3)		* move into FAC1
                            	  5716: 
01:00205FD8 102B0594        	  5717: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00205FDC 4E75            	  5718: 	RTS
