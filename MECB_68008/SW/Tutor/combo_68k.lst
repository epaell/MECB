                            	  2641: * File BO        BOOT Command                                      30/07/06
                            	  2642: 
                            	  2643: * BOOT  COMMAND
                            	  2644: *  BOOT CP/M 68K
01:0020129E 2E7C00080000    	  2645: BOCMD    MOVE.L   #$80000,A7           ; set up the stack pointer outside of the CPM area
01:002012A4 327C6200        	  2646:          MOVE.L   #$6200,a1            ; location for BIOS
01:002012A8 3A3C0102        	  2647:          MOVE.W   #BIOSMV,D5           ; copy CPM BIOS to destination
01:002012AC 4E48            	  2648:          TRAP     #8
01:002012AE 7003            	  2649:          MOVE.L   #3,d0                ; CPM v1.3
01:002012B0 3A3C0100        	  2650:          MOVE.W   #CPM400MV,D5
01:002012B4 4E48            	  2651:          TRAP     #8                   ; copy CPM binary to destination
01:002012B6 327C0400        	  2652:          MOVE.L   #$0400,a1
01:002012BA 7003            	  2653:          MOVE.L   #3,d0                ; CPM v1.3
01:002012BC 3A3C0100        	  2654:          MOVE.W   #CPM400MV,D5
01:002012C0 4E48            	  2655:          TRAP     #8                   ; copy CPM binary to right location
01:002012C2 11FC00620460    	  2656:          MOVE.B   #$62,$0460           ; patch to start BIOS at $6200
01:002012C8 4EF80400        	  2657:          JMP      $0400                ; start up CPM
                            	  2658: 
