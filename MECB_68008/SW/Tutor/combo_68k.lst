01:0020609C 660A            	  5878: 	BNE.s		LAB_2828			* branch if different
                            	  5879: 
01:0020609E 222B0598        	  5880: 	MOVE.l	FAC2_m(a3),d1		* get FAC2 mantissa
01:002060A2 B2AB0590        	  5881: 	CMP.l		FAC1_m(a3),d1		* compare mantissas
01:002060A6 6708            	  5882: 	BEQ.s		LAB_282F			* exit if mantissas equal
                            	  5883: 
