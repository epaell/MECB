                            	  7667: *************************************************************************************
                            	  7668: *
                            	  7669: * perform SQR()
                            	  7670: 
                            	  7671: * d0 is number to find the root of
                            	  7672: * d1 is the root result
                            	  7673: * d2 is the remainder
                            	  7674: * d3 is a counter
                            	  7675: * d4 is temp
                            	  7676: 
                            	  7677: LAB_SQR
01:00206C48 4A2B0595        	  7678: 	TST.b		FAC1_s(a3)			* test FAC1 sign
01:00206C4C 6B00D974        	  7679: 	BMI		LAB_FCER			* if -ve do function call error
                            	  7680: 
01:00206C50 4A2B0594        	  7681: 	TST.b		FAC1_e(a3)			* test exponent
01:00206C54 67F0            	  7682: 	BEQ.s		RTS_023			* exit if zero
                            	  7683: 
01:00206C56 48E77800        	  7684: 	MOVEM.l	d1-d4,-(sp)			* save registers
01:00206C5A 202B0590        	  7685: 	MOVE.l	FAC1_m(a3),d0		* copy FAC1
01:00206C5E 7400            	  7686: 	MOVEQ		#0,d2				* clear remainder
01:00206C60 2202            	  7687: 	MOVE.l	d2,d1				* clear root
                            	  7688: 
01:00206C62 761F            	  7689: 	MOVEQ		#$1F,d3			* $1F for DBF, 64 pairs of bits to
                            	  7690: 							* do for a 32 bit result
01:00206C64 082B00000594    	  7691: 	BTST		#0,FAC1_e(a3)		* test exponent odd/even
01:00206C6A 6606            	  7692: 	BNE.s		LAB_SQE2			* if odd only 1 shift first time
                            	  7693: 
                            	  7694: LAB_SQE1
01:00206C6C D080            	  7695: 	ADD.l		d0,d0				* shift highest bit of number ..
01:00206C6E D582            	  7696: 	ADDX.l	d2,d2				* .. into remainder .. never overflows
01:00206C70 D281            	  7697: 	ADD.l		d1,d1				* root = root * 2 .. never overflows
                            	  7698: LAB_SQE2
01:00206C72 D080            	  7699: 	ADD.l		d0,d0				* shift highest bit of number ..
01:00206C74 D582            	  7700: 	ADDX.l	d2,d2				* .. into remainder .. never overflows
                            	  7701: 
01:00206C76 2801            	  7702: 	MOVE.l	d1,d4				* copy root
01:00206C78 D884            	  7703: 	ADD.l		d4,d4				* 2n
01:00206C7A 5284            	  7704: 	ADDQ.l	#1,d4				* 2n+1
                            	  7705: 
01:00206C7C B484            	  7706: 	CMP.l		d4,d2				* compare 2n+1 to remainder
01:00206C7E 6504            	  7707: 	BCS.s		LAB_SQNS			* skip sub if remainder smaller
                            	  7708: 
01:00206C80 9484            	  7709: 	SUB.l		d4,d2				* subtract temp from remainder
01:00206C82 5281            	  7710: 	ADDQ.l	#1,d1				* increment root
                            	  7711: LAB_SQNS
01:00206C84 51CBFFE6        	  7712: 	DBF		d3,LAB_SQE1			* loop if not all done
                            	  7713: 
01:00206C88 27410590        	  7714: 	MOVE.l	d1,FAC1_m(a3)		* save result mantissa
01:00206C8C 102B0594        	  7715: 	MOVE.b	FAC1_e(a3),d0		* get exponent (d0 is clear here)
01:00206C90 907C0080        	  7716: 	SUB.w		#$80,d0			* normalise
01:00206C94 E248            	  7717: 	LSR.w		#1,d0				* /2
01:00206C96 6402            	  7718: 	BCC.s		LAB_SQNA			* skip increment if carry clear
                            	  7719: 
01:00206C98 5240            	  7720: 	ADDQ.w	#1,d0				* add bit zero back in (allow for half shift)
                            	  7721: LAB_SQNA
01:00206C9A D07C0080        	  7722: 	ADD.w		#$80,d0			* re-bias to $80
01:00206C9E 17400594        	  7723: 	MOVE.b	d0,FAC1_e(a3)		* save it
01:00206CA2 4CDF001E        	  7724: 	MOVEM.l	(sp)+,d1-d4			* restore registers
01:00206CA6 6000F0B2        	  7725: 	BRA		LAB_24D5			* normalise FAC1 & return
                            	  7726: 
