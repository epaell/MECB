01:00206046 C03C0000        	  5786: 	AND.b		#$00,d0			* clear guard byte
01:0020604A 27400590        	  5787: 	MOVE.l	d0,FAC1_m(a3)		* save back to FAC1
01:0020604E 4E75            	  5788: 	RTS
