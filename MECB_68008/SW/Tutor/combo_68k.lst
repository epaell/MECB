01:00200782 41FA0036        	  1251: INITVMSG LEA     VECT(PC),A0    A0 = START OF VECTOR TABLE
01:00200786 43F80010        	  1252:          LEA     AV4,A1         A1 = FIRST VECTOR TO INITIALIZE
01:0020078A 700A            	  1253:          MOVEQ   #10,D0         D0 = COUNT
01:0020078C 22C8            	  1254: VECTI    MOVE.L  A0,(A1)+       MOVE ADDRESS TO VECTOR
01:0020078E D1C0            	  1255:          ADD.L   D0,A0          BUMP ADDRESS
01:00200790 B2FC0030        	  1256:          CMPA.L  #AV11+4,A1
01:00200794 66F6            	  1257:          BNE     VECTI
                            	  1258: 
01:00200796 43F80060        	  1259:          LEA     AV24,A1        A1 = NEXT VECTOR TO INITIALIZE
01:0020079A 22C8            	  1260: VECTI2   MOVE.L  A0,(A1)+       MOVE ADDRESS TO VECTOR
01:0020079C D1C0            	  1261:          ADD.L   D0,A0          BUMP ADDRESS
01:0020079E B2FC00C0        	  1262:          CMPA.L  #AV48,A1
01:002007A2 66F6            	  1263:          BNE     VECTI2
                            	  1264: 
01:002007A4 207900210000    	  1265:          MOVE.L  $210000,A0     CHECK IF THE ONBOARD ROM HAS A TRAP HANDLER
01:002007AA B1FC54524150    	  1266:          CMP.L   #'TRAP',A0     IF IT EXISTS IT WILL HAVE THE MAGIC NUMBER
01:002007B0 6606            	  1267:          BNE     VECTI3         IF NO HANDLER THE EXIT
01:002007B2 4EB900210004    	  1268:          JSR     $210004        OTHERWISE CALL FUNCTION TO INSTALL HANDLER
                            	  1269: VECTI3
01:002007B8 4E75            	  1270:          RTS
                            	  1271: 
