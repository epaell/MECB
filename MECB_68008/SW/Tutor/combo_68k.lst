                            	  7595: *
                            	  7596: * perform WIDTH
                            	  7597: 
                            	  7598: LAB_WDTH
01:00206BC8 B03C002C        	  7599: 	CMP.b		#',',d0			* is next byte ","
01:00206BCC 672C            	  7600: 	BEQ.s		LAB_TBSZ			* if so do tab size
                            	  7601: 
01:00206BCE 6100EF9A        	  7602: 	BSR		LAB_GTBY			* get byte parameter, result in d0 and Itemp
01:00206BD2 4A00            	  7603: 	TST.b		d0				* test result
01:00206BD4 6712            	  7604: 	BEQ.s		LAB_NSTT			* branch if set for infinite line
                            	  7605: 
01:00206BD6 B03C0010        	  7606: 	CMP.b		#$10,d0			* else make min width = 16d
01:00206BDA 6500D9E6        	  7607: 	BCS		LAB_FCER			* if less do function call error & exit
                            	  7608: 
                            	  7609: * this next compare ensures that we can't exit WIDTH via an error leaving the
                            	  7610: * tab size greater than the line length.
                            	  7611: 
01:00206BDE B02B05E2        	  7612: 	CMP.b		TabSiz(a3),d0		* compare with tab size
01:00206BE2 6404            	  7613: 	BCC.s		LAB_NSTT			* branch if >= tab size
                            	  7614: 
01:00206BE4 174005E2        	  7615: 	MOVE.b	d0,TabSiz(a3)		* else make tab size = terminal width
                            	  7616: LAB_NSTT
01:00206BE8 174005E6        	  7617: 	MOVE.b	d0,TWidth(a3)		* set the terminal width
01:00206BEC 6100E61E        	  7618: 	BSR		LAB_GBYT			* get BASIC byte back
01:00206BF0 672C            	  7619: 	BEQ.s		WExit				* exit if no following
                            	  7620: 
01:00206BF2 B03C002C        	  7621: 	CMP.b		#',',d0			* else is it ","
01:00206BF6 6600D9D6        	  7622: 	BNE		LAB_SNER			* if not do syntax error
                            	  7623: 
                            	  7624: LAB_TBSZ
01:00206BFA 6100EF6A        	  7625: 	BSR		LAB_SGBY			* increment and get byte, result in d0 and Itemp
01:00206BFE 4A00            	  7626: 	TST.b		d0				* test TAB size
01:00206C00 6B00D9C0        	  7627: 	BMI		LAB_FCER			* if >127 do function call error & exit
                            	  7628: 
01:00206C04 B03C0001        	  7629: 	CMP.b		#1,d0				* compare with min-1
01:00206C08 6500D9B8        	  7630: 	BCS		LAB_FCER			* if <=1 do function call error & exit
                            	  7631: 
01:00206C0C 122B05E6        	  7632: 	MOVE.b	TWidth(a3),d1		* set flags for width
01:00206C10 6708            	  7633: 	BEQ.s		LAB_SVTB			* skip check if infinite line
                            	  7634: 
01:00206C12 B02B05E6        	  7635: 	CMP.b		TWidth(a3),d0		* compare TAB with width
01:00206C16 6E00D9AA        	  7636: 	BGT		LAB_FCER			* branch if too big
                            	  7637: 
                            	  7638: LAB_SVTB
01:00206C1A 174005E2        	  7639: 	MOVE.b	d0,TabSiz(a3)		* save TAB size
                            	  7640: 
                            	  7641: * calculate tab column limit from TAB size. The Iclim is set to the last tab
                            	  7642: * position on a line that still has at least one whole tab width between it
                            	  7643: * and the end of the line.
                            	  7644: 
                            	  7645: WExit
01:00206C1E 102B05E6        	  7646: 	MOVE.b	TWidth(a3),d0		* get width
01:00206C22 670A            	  7647: 	BEQ.s		LAB_WDLP			* branch if infinite line
                            	  7648: 
01:00206C24 B02B05E2        	  7649: 	CMP.b		TabSiz(a3),d0		* compare with tab size
01:00206C28 6404            	  7650: 	BCC.s		LAB_WDLP			* branch if >= tab size
                            	  7651: 
01:00206C2A 174005E2        	  7652: 	MOVE.b	d0,TabSiz(a3)		* else make tab size = terminal width
                            	  7653: LAB_WDLP
01:00206C2E 902B05E2        	  7654: 	SUB.b		TabSiz(a3),d0		* subtract tab size
01:00206C32 64FA            	  7655: 	BCC.s		LAB_WDLP			* loop while no borrow
                            	  7656: 
01:00206C34 D02B05E2        	  7657: 	ADD.b		TabSiz(a3),d0		* add tab size back
01:00206C38 D02B05E2        	  7658: 	ADD.b		TabSiz(a3),d0		* add tab size back again
                            	  7659: 
01:00206C3C 4400            	  7660: 	NEG.b		d0				* make -ve
01:00206C3E D02B05E6        	  7661: 	ADD.b		TWidth(a3),d0		* subtract remainder from width
01:00206C42 174005E7        	  7662: 	MOVE.b	d0,Iclim(a3)		* save tab column limit
                            	  7663: RTS_023
01:00206C46 4E75            	  7664: 	RTS
