                            	  5942: *************************************************************************************
                            	  5943: *
                            	  5944: * perform INT()
                            	  5945: 
                            	  5946: LAB_INT
01:002060F0 70A0            	  5947: 	MOVEQ		#-96,d0			* set for no floating bits
01:002060F2 902B0594        	  5948: 	SUB.b		FAC1_e(a3),d0		* subtract FAC1 exponent
01:002060F6 6310            	  5949: 	BLS.s		LAB_IRTS			* exit if exponent >= $A0
                            	  5950: 							* (too big for fraction part!)
                            	  5951: 
01:002060F8 B03C0020        	  5952: 	CMP.b		#$20,d0			* compare with minimum result for integer
01:002060FC 6400025E        	  5953: 	BCC		LAB_POZE			* if >= minimum go return 0
                            	  5954: 							* (too small for integer part!)
