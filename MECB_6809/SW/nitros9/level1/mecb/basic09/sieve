PROCEDURE sieve
   BASE 0
   DIM i,k,prime,count:INTEGER; flags(8191):BOOLEAN
   PRINT DATE$
   PRINT "Only one iteration"
   FOR i:=0 TO SIZE(flags)-1
      flags(i):=TRUE
   NEXT i
   count:=0
   FOR i:=0 TO SIZE(flags)-1
      IF flags(i) THEN
         prime:=i+i+3
         FOR k:=i+prime TO SIZE(flags)-1 STEP prime
            flags(k):=FALSE
         NEXT k
         count:=count+1
      ENDIF
   NEXT i
   PRINT count;" primes"
   PRINT DATE$
