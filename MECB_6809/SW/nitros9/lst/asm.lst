                      (            os9.d):01089         
                      (            os9.d):01090         ********************************
                      (            os9.d):01091         * Interrupt Polling Table Format
                      (            os9.d):01092         *
                      (            os9.d):01093                             ORG       0
0000                  (            os9.d):01094         Q$POLL              RMB       2                   Absolute Polling Address
0002                  (            os9.d):01095         Q$FLIP              RMB       1                   Flip (EOR) Byte ..normally Zero
0003                  (            os9.d):01096         Q$MASK              RMB       1                   Polling Mask (after Flip)
0004                  (            os9.d):01097         Q$SERV              RMB       2                   Absolute Service routine Address
0006                  (            os9.d):01098         Q$STAT              RMB       2                   Static Storage Address
0008                  (            os9.d):01099         Q$PRTY              RMB       1                   Priority (Low Numbers=Top Priority)
                      (            os9.d):01100                             IFGT      Level-1
0009                  (            os9.d):01101         Q$MAP               RMB       2                   NitrOS-9 Level 2 and above
                      (            os9.d):01102                             ENDC
     0009             (            os9.d):01103         POLSIZ              EQU       .
                      (            os9.d):01104         
                      (            os9.d):01105         ********************
