                      (           mecb.d):00246         ; FujiNet commands
                      (           mecb.d):00247         ;
     00FF             (           mecb.d):00248         FUJICMD_RESET                       equ   $FF ; done
     00FE             (           mecb.d):00249         FUJICMD_GET_SSID                    equ   $FE ; F
