                      (            os9.d):01064         *********************
                      (            os9.d):01065         * Device Table Format
                      (            os9.d):01066         *
                      (            os9.d):01067                             ORG       0
0000                  (            os9.d):01068         V$DRIV              RMB       2                   Device Driver module
0002                  (            os9.d):01069         V$STAT              RMB       2                   Device Driver Static storage
0004                  (            os9.d):01070         V$DESC              RMB       2                   Device Descriptor module
0006                  (            os9.d):01071         V$FMGR              RMB       2                   File Manager module
