                      (            os9.d):00816         **************************
                      (            os9.d):00817         * Module Field Definitions
                      (            os9.d):00818         *
                      (            os9.d):00819         * ID Field - First two bytes of a NitrOS-9 module
                      (            os9.d):00820         *
     0087             (            os9.d):00821         M$ID1               EQU       $87                 Module ID code byte one
     00CD             (            os9.d):00822         M$ID2               EQU       $CD                 Module ID code byte two
     87CD             (            os9.d):00823         M$ID12              EQU       M$ID1*256+M$ID2
                      (            os9.d):00824         
                      (            os9.d):00825         *
                      (            os9.d):00826         * Module Type/Language Field Masks
                      (            os9.d):00827         *
     00F0             (            os9.d):00828         TypeMask            EQU       %11110000           Type Field
     000F             (            os9.d):00829         LangMask            EQU       %00001111           Language Field
                      (            os9.d):00830         
                      (            os9.d):00831         *
                      (            os9.d):00832         * Module Type Values
                      (            os9.d):00833         *
     00F0             (            os9.d):00834         Devic               EQU       $F0                 Device Descriptor Module
     00E0             (            os9.d):00835         Drivr               EQU       $E0                 Physical Device Driver
     00D0             (            os9.d):00836         FlMgr               EQU       $D0                 File Manager
     00C0             (            os9.d):00837         Systm               EQU       $C0                 System Module
     0050             (            os9.d):00838         ShellSub            EQU       $50                 Shell+ shell sub module
     0040             (            os9.d):00839         Data                EQU       $40                 Data Module
     0030             (            os9.d):00840         Multi               EQU       $30                 Multi-Module
     0020             (            os9.d):00841         Sbrtn               EQU       $20                 Subroutine Module
     0010             (            os9.d):00842         Prgrm               EQU       $10                 Program Module
                      (            os9.d):00843         
                      (            os9.d):00844         *
                      (            os9.d):00845         * Module Language Values
                      (            os9.d):00846         *
     0001             (            os9.d):00847         Objct               EQU       1                   6809 Object Code Module
     0002             (            os9.d):00848         ICode               EQU       2                   Basic09 I-code
     0003             (            os9.d):00849         PCode               EQU       3                   Pascal P-code
     0004             (            os9.d):00850         CCode               EQU       4                   C I-code
     0005             (            os9.d):00851         CblCode             EQU       5                   Cobol I-code
     0006             (            os9.d):00852         FrtnCode            EQU       6                   Fortran I-code
     0007             (            os9.d):00853         Obj6309             EQU       7                   6309 object code
                      (            os9.d):00854         *
                      (            os9.d):00855         * Module Attributes / Revision byte
                      (            os9.d):00856         *
                      (            os9.d):00857         * Field Masks
                      (            os9.d):00858         *
     00F0             (            os9.d):00859         AttrMask            EQU       %11110000           Attributes Field
     000F             (            os9.d):00860         RevsMask            EQU       %00001111           Revision Level Field
                      (            os9.d):00861         *
                      (            os9.d):00862         * Attribute Flags
                      (            os9.d):00863         *
     0080             (            os9.d):00864         ReEnt               EQU       %10000000           Re-Entrant Module
     0040             (            os9.d):00865         ModProt             EQU       %01000000           Gimix Module protect bit (0=protected, 1=write enable)
     0020             (            os9.d):00866         ModNat              EQU       %00100000           6309 native mode attribute
     0040             (            os9.d):00867         BufWrits            EQU       ModProt             SCF buffered read supported (Coco only at this point)
     0010             (            os9.d):00868         BufReads            EQU       %00010000           SCF buffered write supported (Coco only at this point)
                      (            os9.d):00869         * LCB - propose we add Buffered Read/Buffered Write attribute bits for Coco (in descriptors and
                      (            os9.d):00870         *   drivers for SCF), with one of them replacing ModProt. SCF would check Read/ReadLn and Write/WritLn
                      (            os9.d):00871         *   calls, and if both the driver and descriptor have the appropriate bit set, it would do buffered 32
                      (            os9.d):00872         *   byte (for now) reads/writes like the Grfdrv write call does now, for all bytes that are ASCII >$1F
                      (            os9.d):00873         *   (ie non-control chars, which need special processing)
                      (            os9.d):00874         
                      (            os9.d):00875         
                      (            os9.d):00876         ********************
                      (            os9.d):00877         * Device Type Values
                      (            os9.d):00878         *
                      (            os9.d):00879         * These values define various classes of devices, which are
                      (            os9.d):00880         * managed by a file manager module.  The Device Type is embedded
                      (            os9.d):00881         * in a device's device descriptor.
                      (            os9.d):00882         *
     0000             (            os9.d):00883         DT.SCF              EQU       0                   Sequential Character File Manager
     0001             (            os9.d):00884         DT.RBF              EQU       1                   Random Block File Manager
     0002             (            os9.d):00885         DT.Pipe             EQU       2                   Pipe File Manager
     0003             (            os9.d):00886         DT.SBF              EQU       3                   Sequential Block File Manager
     0004             (            os9.d):00887         DT.NFM              EQU       4                   Network File Manager
     0005             (            os9.d):00888         DT.CDFM             EQU       5                   CD-ROM File Manager
     0006             (            os9.d):00889         DT.RFM              EQU       6                   Remote File Manager
                      (            os9.d):00890         
