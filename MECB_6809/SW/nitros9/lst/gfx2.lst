                      (       cocovtio.d):00473         ******************************************************************************
                      (       cocovtio.d):00474         ******************************************************************************
                      (       cocovtio.d):00475         **                                                                          **
                      (       cocovtio.d):00476         ** NitrOS-9 Windowing system Global data definitions                        **
                      (       cocovtio.d):00477         **                                                                          **
                      (       cocovtio.d):00478         ******************************************************************************
                      (       cocovtio.d):00479         ******************************************************************************
                      (       cocovtio.d):00480         **                                                                          **
                      (       cocovtio.d):00481         ** System memory block 0 layout:                                            **
                      (       cocovtio.d):00482         **                                                                          **
                      (       cocovtio.d):00483         ** $0000-$0001 : FHL/Isted WD 1002-05 - interface base address              **
                      (       cocovtio.d):00484         ** $0002       : FHL/Isted WD 1002-05 - boot device physical drive #        **
                      (       cocovtio.d):00485         ** $0008       : Bruce Isted Serial mouse - button counter & rx count       **
                      (       cocovtio.d):00486         ** $0009-$000B : Bruce Isted Serial mouse - RX buffer                       **
                      (       cocovtio.d):00487         ** $000C-$000D : Bruce Isted Serial mouse - Current X position              **
                      (       cocovtio.d):00488         ** $000E-$000F : Bruce Isted Serial mouse - Current Y position              **
                      (       cocovtio.d):00489         ** $0010-$001F : unused (User definable)                                    **
                      (       cocovtio.d):00490         ** $0020-$00FF : system direct page & some IRQ vectors                      **
                      (       cocovtio.d):00491         ** $0100-$011F : Task usage table                                           **
                      (       cocovtio.d):00492         ** $0120-$017F : Virtual DAT tasks (pointed to by <D.TskIPt)                **
                      (       cocovtio.d):00493         ** $0180-$019F : Grfdrv direct screen write buffer (6809)                   **
                      (       cocovtio.d):00494         ** $0180-$01BF : Grfdrv direct screen write buffer (6309)                   **
                      (       cocovtio.d):00495         ** $01A0-$01FF : Unused? (6809)                                             **
                      (       cocovtio.d):00496         ** $01C0-$01FF : Unused? (6309)                                             **
                      (       cocovtio.d):00497         ** $0200-$02FF : memory block usage map ($80=Not RAM,$01=in use,$02=module) **
                      (       cocovtio.d):00498         ** $0300-$03FF : system's system call dispatch table                        **
                      (       cocovtio.d):00499         ** $0400-$04FF : user's sysem call dispatch table                           **
                      (       cocovtio.d):00500         ** $0500-$05FF : process descriptor pointer table                           **
                      (       cocovtio.d):00501         ** $0600-$07FF : System task (Task 0, ID 1) process descriptor              **
                      (       cocovtio.d):00502         ** $0800-$08FF : System's stack space (initial ptr is $0900)                **
                      (       cocovtio.d):00503         ** $0900-$09FF : SMAP table ($01=in used, $80=NOT RAM)                      **
                      (       cocovtio.d):00504         ** $0A00-$0FFF : module directory DAT Images (8 bytes each)                 **
                      (       cocovtio.d):00505         ** $1000-$10FF : System Global memory (pointed to by D.CCMem)               **
                      (       cocovtio.d):00506         ** $1100-$11FF : GRFDRV global memory (DP=$11 in GRFDRV)                    **
                      (       cocovtio.d):00507         ** $1200-$1247 : shared buffer between Grf/WindInt & GRFDRV (GP buffers)    **
                      (       cocovtio.d):00508         ** $1248-$127F : ????  (unused)                                             **
                      (       cocovtio.d):00509         ** $1280-$1A7F : the window tables (32 of $40 bytes each)                   **
                      (       cocovtio.d):00510         ** $1A80-$1C7F : the screen tables (16 of $20 bytes each)                   **
                      (       cocovtio.d):00511         ** $1C80-$2000 : the CC3 global mem stack (for windowing)                   **
                      (       cocovtio.d):00512         **                                                                          **
                      (       cocovtio.d):00513         ******************************************************************************
                      (       cocovtio.d):00514         ******************************************************************************
                      (       cocovtio.d):00515         
                      (       cocovtio.d):00516         * User settable values for VTIO/TC9IO/GrfInt/WindInt & GrfDrv
     0019             (       cocovtio.d):00517         MaxLines            EQU       25                  Max. Y coord text value
     0000             (       cocovtio.d):00518         Meg                 SET       false               "true" if 1 or 2 meg machine
                      (       cocovtio.d):00519         
     0000             (       cocovtio.d):00520         COMP                EQU       0                   composite monitor
     0001             (       cocovtio.d):00521         RGB                 EQU       1                   RGB Analog monitor
     0002             (       cocovtio.d):00522         MONO                EQU       2                   monochrome monitor
                      (       cocovtio.d):00523         
     0001             (       cocovtio.d):00524         Monitor             SET       RGB
                      (       cocovtio.d):00525         
                      (       cocovtio.d):00526         * EOU Beta 6 - expanded bit flags
                      (       cocovtio.d):00527         * These are in V.ULCase in static mem for each window
     0001             (       cocovtio.d):00528         KeyMse              EQU       %00000001           keyboard mouse enabled
     0002             (       cocovtio.d):00529         NumLck              EQU       %00000010           Numlock enabled (TC-9 use only)
     0004             (       cocovtio.d):00530         CapsLck             EQU       %00000100           Capslock enabled
     0008             (       cocovtio.d):00531         KeyClick            EQU       %00001000           Key click enabled
                      (       cocovtio.d):00532         * reserved     EQU       %1111xxxx             Reserved for future use
                      (       cocovtio.d):00533         
                      (       cocovtio.d):00534         * EOU Beta 6 new global definitions added for EOU Beta 6
                      (       cocovtio.d):00535         * Repurpose old G.KyMse in CC3 Global mem ($1063) for system wide setting
     0080             (       cocovtio.d):00536         MseCLEAR            EQU       %10000000           Right mouse button active as clear
                      (       cocovtio.d):00537         * Current experiments show that this is working, and I have replaced left/right mouse to change
                      (       cocovtio.d):00538         * Button 2 window change direction to use button 1. Leavingt this in if beta testers find the new
                      (       cocovtio.d):00539         * method too hard to use (although it allows you to change direction at any time; the older mouse
                      (       cocovtio.d):00540         * x/y only let you change direction on a graphics window).
                      (       cocovtio.d):00541         *MsePreCl       EQU       %01000000           * EXPERIMENTAL * - if left mouse button down, then
                      (       cocovtio.d):00542         *                                              tapping right button is Previous Window
                      (       cocovtio.d):00543         
                      (       cocovtio.d):00544         * Global Definitions
     0280             (       cocovtio.d):00545         MaxRows             EQU       640                 maximum X co-ordinate allowed on mouse
                      (       cocovtio.d):00546                             IFEQ      MaxLines-25
     00C6             (       cocovtio.d):00547         MaxLine             EQU       198                 maximum Y co-ordinate allowed on mouse
                      (       cocovtio.d):00548                             ELSE
0019                  (       cocovtio.d):00549         MaxLine             EQU       191                 maximum Y co-ordinate allowed on mouse
                      (       cocovtio.d):00550                             ENDC
                      (       cocovtio.d):00551         
                      (       cocovtio.d):00552         *****************************************************************************
                      (       cocovtio.d):00553         * Static memory area for each window (VTIO/TC9IO)
                      (       cocovtio.d):00554         * Should set up a write buffer (using parm area?) between SCF, VTIO & Grfdrv
                      (       cocovtio.d):00555         * so we can 'burst mode' text output (copy up to 48 chars to Grfdrv's parm
                      (       cocovtio.d):00556         * area, and have grfdrv loop through & write all 48 chars to screen in 1 loop
                      (       cocovtio.d):00557         * May have to have smaller limit for text to gfx screens, as it will run much
                      (       cocovtio.d):00558         * slower, unless GrfDrv is made Partially/Fully Re-Entrant
                      (       cocovtio.d):00559         *
                      (       cocovtio.d):00560         * STRONG CAUTION:  scfdefs MUST be included first before this file if
                      (       cocovtio.d):00561         * V.SCF is to be resolved properly in pass 1!!
