                      (       cocovtio.d):00279         * Standard system get/put buffer defs
                      (       cocovtio.d):00280         *
                      (       cocovtio.d):00281         *
                      (       cocovtio.d):00282         * system group numbers
                      (       cocovtio.d):00283         *
                      (       cocovtio.d):00284                             ORG       200
00C8                  (       cocovtio.d):00285         Grp.Fnt             RMB       1                   font group
00C9                  (       cocovtio.d):00286         Grp.Clip            RMB       1                   clipboard group
00CA                  (       cocovtio.d):00287         Grp.Ptr             RMB       1                   pointer group
00CB                  (       cocovtio.d):00288         Grp.Pat2            RMB       1                   pattern group 2 color
00CC                  (       cocovtio.d):00289         Grp.Pat4            RMB       1                   pattern group 4 color
00CD                  (       cocovtio.d):00290         Grp.Pat6            RMB       1                   pattern group 16 color
00CE                  (       cocovtio.d):00291         Grp.Wnd             RMB       1                   Special 4 color GShell chars (scroll arrows, etc.)
00CF                  (       cocovtio.d):00292         Grp.Cd16            RMB       1                   16 color playing card set (courtesy Paul Shoemaker)
                      (       cocovtio.d):00293         * Card buffers are: 1=card back, 2-14=A to K Diamonds, 15-27=A to K Hearts,
                      (       cocovtio.d):00294         *   28-40=A to K Spades, 41-53=A to K Clubs, 54=Joker, 55=Empty card slot.
                      (       cocovtio.d):00295         
                      (       cocovtio.d):00296         *
                      (       cocovtio.d):00297         * font buffer numbers (standard 3 - others are in /dd/sys/fontlist.txt)
                      (       cocovtio.d):00298         *
                      (       cocovtio.d):00299                             ORG       1
0001                  (       cocovtio.d):00300         Fnt.S8x8            RMB       1                   standard 8x8 font
0002                  (       cocovtio.d):00301         Fnt.S6x8            RMB       1                   standard 6x8 font
0003                  (       cocovtio.d):00302         Fnt.G8x8            RMB       1                   standard graphics 8x8 font
                      (       cocovtio.d):00303         *
                      (       cocovtio.d):00304         * pattern buffer numbers - 1-8 are stock system, 9-16 are MVCanvas extended ones.
                      (       cocovtio.d):00305         *
                      (       cocovtio.d):00306                             ORG       1
0001                  (       cocovtio.d):00307         Pat.Dot             RMB       1                   dot pattern
0002                  (       cocovtio.d):00308         Pat.Vrt             RMB       1                   vertical line pattern
0003                  (       cocovtio.d):00309         Pat.Hrz             RMB       1                   horizontal line pattern
0004                  (       cocovtio.d):00310         Pat.XHtc            RMB       1                   cross hatch pattern
0005                  (       cocovtio.d):00311         Pat.LSnt            RMB       1                   left slanted lines
0006                  (       cocovtio.d):00312         Pat.RSnt            RMB       1                   right slanted lines
0007                  (       cocovtio.d):00313         Pat.SDot            RMB       1                   small dot pattern
0008                  (       cocovtio.d):00314         Pat.BDot            RMB       1                   large dot pattern
                      (       cocovtio.d):00315         * MVCanvas extended set
0009                  (       cocovtio.d):00316         Pat.Bubl            RMB       1                   bubble pattern
000A                  (       cocovtio.d):00317         Pat.Bskt            RMB       1                   basket weave pattern
000B                  (       cocovtio.d):00318         Pat.Wafl            RMB       1                   waffle iron pattern
000C                  (       cocovtio.d):00319         Pat.Shng            RMB       1                   shingle pattern
000D                  (       cocovtio.d):00320         Pat.Bric            RMB       1                   brick pattern
000E                  (       cocovtio.d):00321         Pat.SmGr            RMB       1                   small grid pattern
000F                  (       cocovtio.d):00322         Pat.Dmnd            RMB       1                   diamond floor
0010                  (       cocovtio.d):00323         Pat.Flor            RMB       1                   floor tile pattern
