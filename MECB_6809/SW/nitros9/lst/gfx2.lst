                      (            os9.d):01329         ***************************
                      (            os9.d):01330         * Level 3 Defs
                      (            os9.d):01331         *
                      (            os9.d):01332         * These definitions apply to NitrOS-9 Level 3
                      (            os9.d):01333         *
00FF                  (            os9.d):01334         L3.Start            EQU       $2000               Start off at slot 1
00FF                  (            os9.d):01335         L3.Size             EQU       $40                 Go for 64 pages: 2 slots total
00FF                  (            os9.d):01336         L3.Blks             EQU       L3.Size/$20         Number of slots
00FF                  (            os9.d):01337         L3.End              EQU       L3.Start+L3.Size*$0100 end of L3 memory
00FF                  (            os9.d):01338         L3.SCF              EQU       $0660               SCF block ptr
00FF                  (            os9.d):01339         L3.RBF              EQU       L3.SCF+1            RBF block ptr
                      (            os9.d):01340                             ENDC
                      (            os9.d):01341         
                      (            os9.d):01342                             ENDC
                      (/basic09/gfx2.asm):00031                             use       scf.d
