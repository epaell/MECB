0002                  (       cocovtio.d):00329         Ptr.Pen             RMB       1                   Pencil pointer
0003                  (       cocovtio.d):00330         Ptr.LCH             RMB       1                   Large cross hair pointer
0004                  (       cocovtio.d):00331         Ptr.Slp             RMB       1                   Wait timer pointer
0005                  (       cocovtio.d):00332         Ptr.Ill             RMB       1                   Illegal action pointer
0006                  (       cocovtio.d):00333         Ptr.Txt             RMB       1                   Text pointer
0007                  (       cocovtio.d):00334         Ptr.SCH             RMB       1                   Small cross hair pointer
