                      (       cocovtio.d):00047                             RMB       1                   (I assume reserved for a 3rd parameter byte)
0040                  (       cocovtio.d):00048         V.Chr1              RMB       1                   same as under cursor character
0040                  (       cocovtio.d):00049         V.CColr             RMB       1                   cursor color
0040                  (       cocovtio.d):00050         V.Col               RMB       1                   number of columns for this screen
0040                  (       cocovtio.d):00051         V.Row               RMB       1                   number of rows
0040                  (       cocovtio.d):00052         V.Alpha             RMB       1                   0 when in alpha mode
0040                  (       cocovtio.d):00053         V.PIA1              RMB       1                   PIA1Base value
0040                  (       cocovtio.d):00054         V.Rdy               RMB       1                   device ready (see SS.DStat 0=not ready)
0040                  (       cocovtio.d):00055         V.CFlg1             RMB       1                   VDG display code values
0040                  (       cocovtio.d):00056         V.SBAdd             RMB       2                   (2) address of block screen is in
0040                  (       cocovtio.d):00057         V.GBuff             RMB       2                   allocation for graphics buffers (block#)
0040                  (       cocovtio.d):00058         V.AGBuf             RMB       4                   (2) additional graphics buffer
0040                  (       cocovtio.d):00059         V.FFMem             RMB       2                   Flood fill alloc'ed mem
0040                  (       cocovtio.d):00060         V.FFSPt             RMB       2                   Flood fill current stack pointer
0040                  (       cocovtio.d):00061         V.FFSTp             RMB       1                   Flood fill stack top
0040                  (       cocovtio.d):00062         V.FF6               RMB       1                   flood fill flag
0040                  (       cocovtio.d):00063         V.FFFlag            RMB       1                   Error in FloodFill - E$Write if FFill stack overflows, 0 if no error
0040                  (       cocovtio.d):00064         V.MTabl             RMB       2                   (2) address of mask table for pixels in byte
0040                  (       cocovtio.d):00065         V.PixBt             RMB       1                   bit mask for modes (0=$07, 1=$03 )#pixels/byte
0040                  (       cocovtio.d):00066         V.GCrsX             RMB       1                   graphics cursor X value
0040                  (       cocovtio.d):00067         V.GCrsY             RMB       1                   graphics cursor Y
0040                  (       cocovtio.d):00068         V.Msk1              RMB       1                   mask byte 1
0040                  (       cocovtio.d):00069         V.Msk2              RMB       1                   mask byte 2 (00,55,AA,FF) Full byte Color Mask
0040                  (       cocovtio.d):00070         V.MCol              RMB       1                   Start pixel in a byte mask ($C0=4 color, $80=2 color)
0040                  (       cocovtio.d):00071         V.4A                RMB       1                   End pixel in a byte mask ($03=4 color,$01=2 color)
0040                  (       cocovtio.d):00072         V.PMask             RMB       1                   Full byte pixel mask for colors (i.e. $55, $CC etc)
0040                  (       cocovtio.d):00073         V.4C                RMB       1
0040                  (       cocovtio.d):00074         V.4D                RMB       1
0040                  (       cocovtio.d):00075         V.4E                RMB       1                   Flood Fill full byte color mask
0040                  (       cocovtio.d):00076         V.4F                RMB       1
0040                  (       cocovtio.d):00077         V.Caps              RMB       1                   caps lock info: $00=lower $FF=upper
0040                  (       cocovtio.d):00078         V.ClkCnt            RMB       1                   clock count ??
0040                  (       cocovtio.d):00079         V.KyDly             RMB       1                   key repeat initial delay
0040                  (       cocovtio.d):00080         V.KySpd             RMB       1                   key repeat secondary delay
0040                  (       cocovtio.d):00081         V.WrChr             RMB       1                   character to write
0040                  (       cocovtio.d):00082         V.CurCo             RMB       1                   current CO-module in use
                      (       cocovtio.d):00083         * start of CoWP-specific static memory
0040                  (       cocovtio.d):00084         V.Co80X             RMB       1                   V.54
0040                  (       cocovtio.d):00085         V.Co80Y             RMB       1                   V.55
