0040                  (       cocovtio.d):00121         V.Flash             RMB       2                   Cursor flash routine address.
0040                  (       cocovtio.d):00122         v.FlashTime         RMB       1                   Cursor flash time
0040                  (       cocovtio.d):00123         v.FlashCount        RMB       1                   Cursor flash count
0040                  (       cocovtio.d):00124         V.NoFlash           RMB       1                   When this is non-zero do not flash cursor
                      (       cocovtio.d):00125         * If we make ClrBlk vector, throw it in here so the various comoduels, as well as VTIO,
                      (       cocovtio.d):00126         * can all use it (clearing text/graphics screens, clearing full width line (pure text or
                      (       cocovtio.d):00127         * CoHr/Co42 graphics lines), and possibly Clear to end of line could all use it.
0040                  (       cocovtio.d):00128         V.ClrBlk            RMB       2                   Vector to mini-stack blast clearing routine
0040                  (       cocovtio.d):00129         V.CpyBlk            RMB       2                   Vector to mini-stack blast copying routine
                      (       cocovtio.d):00130         * CoHR vars
0040                  (       cocovtio.d):00131         V.51ScrnA           RMB       2                   * Screen address.
0040                  (       cocovtio.d):00132         V.51XPos            RMB       1                   * X co-ordinate
0040                  (       cocovtio.d):00133         V.51YPos            RMB       1                   * Y co-ordinate
0040                  (       cocovtio.d):00134         V.51EscSeq          RMB       1                   * In escape sequence
0040                  (       cocovtio.d):00135         V.51ReverseFlag     RMB       1                   * Reverse video flag
0040                  (       cocovtio.d):00136         V.51UnderlineFlag   RMB       1                   * Underline flag
0040                  (       cocovtio.d):00137         V.51CtrlDispatch    RMB       2                   * Ctrl char dispatch address, currently processing
0040                  (       cocovtio.d):00138         V.51BytePixOffset   RMB       1                   * byte offset in screen line, of character X position
0040                  (       cocovtio.d):00139         V.51OldCursorPosX   RMB       1                   * Position of old cursor before update
0040                  (       cocovtio.d):00140         V.51OldCursorPosY   RMB       1
0040                  (       cocovtio.d):00141         V.51CursorChanged   RMB       1                   * Has cursor position changed ? 1=yes,0=no
0040                  (       cocovtio.d):00142         V.51CursorOn        RMB       1                   * Is cursor on ? 1=yes 0=no
0040                  (       cocovtio.d):00143         V.51XORFlag         RMB       1                   * and data to screen (0) or Xor (1)
0040                  (       cocovtio.d):00144         V.51ScreenMask1     RMB       1                   * screen masks for drawing characters on screen
0040                  (       cocovtio.d):00145         V.51ScreenMask2     RMB       1
