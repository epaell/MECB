     0000             (/../../defs/os9.d):01120         R$CC                EQU       0                   Condition Codes register
     0001             (/../../defs/os9.d):01121         R$A                 EQU       1                   A Accumulator
     0002             (/../../defs/os9.d):01122         R$B                 EQU       2                   B Accumulator
     0001             (/../../defs/os9.d):01123         R$D                 EQU       R$A                 Combined A:B Accumulator
                      (/../../defs/os9.d):01124                             IFNE      H6309
0005                  (/../../defs/os9.d):01125         R$E                 EQU       3                   E Accumulator
0005                  (/../../defs/os9.d):01126         R$F                 EQU       4                   F Accumulator
0005                  (/../../defs/os9.d):01127         R$W                 EQU       R$E                 Combined E:F Accumulator
0005                  (/../../defs/os9.d):01128         R$Q                 EQU       R$A                 Combined A:B:E:F Accumulator
0005                  (/../../defs/os9.d):01129         R$DP                EQU       5                   Direct Page register
0005                  (/../../defs/os9.d):01130         R$X                 EQU       6                   X Index register
0005                  (/../../defs/os9.d):01131         R$Y                 EQU       8                   Y Index register
0005                  (/../../defs/os9.d):01132         R$U                 EQU       10                  User Stack register
0005                  (/../../defs/os9.d):01133         R$PC                EQU       12                  Program Counter register
0005                  (/../../defs/os9.d):01134         R$Size              EQU       14                  Total register package size
                      (/../../defs/os9.d):01135                             ELSE
