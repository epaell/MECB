0300.                 (    cssnames3.asm):00143         otbuff              rmb       buflen              output buffer
0400.                 (    cssnames3.asm):00144         wlbuff              rmb       buflen              word list buffer
                      (    cssnames3.asm):00145         **
0500.                 (    cssnames3.asm):00146         teblok              rmb       ioblen              std err output iob
0540.                 (    cssnames3.asm):00147         inblok              rmb       ioblen              input iob
0580.                 (    cssnames3.asm):00148         otblok              rmb       ioblen              output iob
05C0.                 (    cssnames3.asm):00149         wlblok              rmb       ioblen              word list iob
                      (    cssnames3.asm):00150         **
0600.                 (    cssnames3.asm):00151         endprg              rmb       (tabsiz+$0100)      table space
                      (    cssnames3.asm):00152         **
