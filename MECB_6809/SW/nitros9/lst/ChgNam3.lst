                      (/../../defs/scf.d):00097         * SCF Static Storage
                      (/../../defs/scf.d):00098         *
                      (/../../defs/scf.d):00099         * SCF devices must reserve this space for SCF
                      (/../../defs/scf.d):00100         *
                      (/../../defs/scf.d):00101                             ORG       V.USER
0006                  (/../../defs/scf.d):00102         V.TYPE              RMB       1                   Device type or parity
0007                  (/../../defs/scf.d):00103         V.LINE              RMB       1                   Lines left until end of page
0008                  (/../../defs/scf.d):00104         V.PAUS              RMB       1                   Immediate Pause request
0009                  (/../../defs/scf.d):00105         V.DEV2              RMB       2                   Attached device's static
000B                  (/../../defs/scf.d):00106         V.INTR              RMB       1                   Interrupt char
000C                  (/../../defs/scf.d):00107         V.QUIT              RMB       1                   Quit char
000D                  (/../../defs/scf.d):00108         V.PCHR              RMB       1                   Pause char
000E                  (/../../defs/scf.d):00109         V.ERR               RMB       1                   Accumulated errors
000F                  (/../../defs/scf.d):00110         V.XON               RMB       1                   X-On char
0010                  (/../../defs/scf.d):00111         V.XOFF              RMB       1                   X-Off char
0011                  (/../../defs/scf.d):00112         V.KANJI             RMB       1                   Kanji mode flag
0012                  (/../../defs/scf.d):00113         V.KBUF              RMB       2                   Kana - Kanji convert routine work address
0014                  (/../../defs/scf.d):00114         V.MODADR            RMB       2                   Kana - Kanji convert module address
0016                  (/../../defs/scf.d):00115         V.PDLHd             RMB       2                   Open path descriptor list head pointer
0018                  (/../../defs/scf.d):00116         V.RSV               RMB       5                   Reserve bytes for future expansion
     001D             (/../../defs/scf.d):00117         V.SCF               EQU       .                   Total SCF manager static overhead
