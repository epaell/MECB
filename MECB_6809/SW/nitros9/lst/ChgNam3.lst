0006.                 (    cssnames3.asm):00124         botmov              rmb       2                   moving bottom
0008.                 (    cssnames3.asm):00125         bottom              rmb       2                   next empty location
000A.                 (    cssnames3.asm):00126         txtend              rmb       2                   end of source text
000C.                 (    cssnames3.asm):00127         ramend              rmb       2                   end of text buffer
000E.                 (    cssnames3.asm):00128         temp1               rmb       2
