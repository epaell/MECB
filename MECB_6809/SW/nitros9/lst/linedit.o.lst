                      (       linedit.as):00001         ;;; LINEDIT
                      (       linedit.as):00002         ;;;
                      (       linedit.as):00003         ;;; A line editor routine.
                      (       linedit.as):00004         ;;;
                      (       linedit.as):00005         ;;; Other modules needed: STRLEN,IS_PRINT, FPUTS, FPUTC, FGETC, MEMMOVE
                      (       linedit.as):00006         ;;;
                      (       linedit.as):00007         ;;; Entry:  A = The input path.
                      (       linedit.as):00008         ;;;         B = The output path.
                      (       linedit.as):00009         ;;;         X = The null terminated string to edit.
                      (       linedit.as):00010         ;;;
                      (       linedit.as):00011         ;;; Exit:   B = The key that ended the editing.
                      (       linedit.as):00012         ;;;
                      (       linedit.as):00013         ;;; This routine does not use cursor positioning. It uses backspacing, so you can use
                      (       linedit.as):00014         ;;; it without requiring special GOTO XY commands.
                      (       linedit.as):00015         ;;; It is slow, especially when lines get longer than one line.
                      (       linedit.as):00016         ;;; If the buffer contains data, you will be able to edit.
                      (       linedit.as):00017         ;;; To enter new data pass a buffer of blanks.
                      (       linedit.as):00018         
                      (       linedit.as):00019                             section   .text
                      (       linedit.as):00020         
                      (       linedit.as):00021         * these variable are all referenced via the
                      (       linedit.as):00022         * U stack pointer.
                      (       linedit.as):00023         
