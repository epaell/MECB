                      (            os9.d):00308         *******************
                      (            os9.d):00309         * File Access Modes
                      (            os9.d):00310         *
     0001             (            os9.d):00311         READ.               EQU       %00000001
     0002             (            os9.d):00312         WRITE.              EQU       %00000010
     0003             (            os9.d):00313         UPDAT.              EQU       READ.+WRITE.
     0004             (            os9.d):00314         EXEC.               EQU       %00000100
     0008             (            os9.d):00315         PREAD.              EQU       %00001000
     0010             (            os9.d):00316         PWRIT.              EQU       %00010000
     0020             (            os9.d):00317         PEXEC.              EQU       %00100000
     0040             (            os9.d):00318         SHARE.              EQU       %01000000
     0080             (            os9.d):00319         DIR.                EQU       %10000000
     0020             (            os9.d):00320         ISIZ.               EQU       %00100000
                      (            os9.d):00321         
                      (            os9.d):00322         **************
                      (            os9.d):00323         * Signal Codes
                      (            os9.d):00324         *
                      (            os9.d):00325                             ORG       0
0000                  (            os9.d):00326         S$Kill              RMB       1                   Non-Interceptable Abort
0001                  (            os9.d):00327         S$Wake              RMB       1                   Wake-up Sleeping Process
0002                  (            os9.d):00328         S$Abort             RMB       1                   Keyboard Abort
0003                  (            os9.d):00329         S$Intrpt            RMB       1                   Keyboard Interrupt
0004                  (            os9.d):00330         S$Window            RMB       1                   Window Change
     0004             (            os9.d):00331         S$HUP               EQU       S$Window            Hang Up
0005                  (            os9.d):00332         S$Alarm             RMB       1                   CoCo individual process' alarm signal
                      (            os9.d):00333         
                      (            os9.d):00334                             ifgt      Level-1
                      (            os9.d):00335                             ORG       $80
0006                  (            os9.d):00336         S$FS2Sig            RMB       1                   FS2 VIRQ Signal code (VRN)
0006                  (            os9.d):00337         S$KQ3Sig            EQU       S$FS2Sig            KQ3 VIRQ Signal code (VRN)
