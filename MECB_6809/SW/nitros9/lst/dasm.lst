                      (            os9.d):00132                             NAM       os9.d
                      (            os9.d):00133                             IFEQ      Level-1
                      (            os9.d):00134                             TTL       NitrOS-9            Level 1 System Symbol Definitions
                      (            os9.d):00135                             ELSE
                      (            os9.d):00136                             IFEQ      Level-2
                      (            os9.d):00137                             TTL       NitrOS-9            Level 2 System Symbol Definitions
                      (            os9.d):00138                             ELSE
                      (            os9.d):00139                             TTL       NitrOS-9            Level 3 System Symbol Definitions
                      (            os9.d):00140                             ENDC
                      (            os9.d):00141                             ENDC
