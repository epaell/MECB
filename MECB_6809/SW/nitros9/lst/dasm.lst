                      (            os9.d):00143         * Common definitions
     0001             (            os9.d):00144         true                EQU       1                   useful name
     0000             (            os9.d):00145         false               EQU       0                   useful name
                      (            os9.d):00146         
                      (            os9.d):00147                             PAG
                      (            os9.d):00148         *****************************************
                      (            os9.d):00149         * System Service Request Code Definitions
                      (            os9.d):00150         *
                      (            os9.d):00151                             ORG       0
0000                  (            os9.d):00152         F$Link              RMB       1                   Link to Module
0001                  (            os9.d):00153         F$Load              RMB       1                   Load Module from File
0002                  (            os9.d):00154         F$UnLink            RMB       1                   Unlink Module
0003                  (            os9.d):00155         F$Fork              RMB       1                   Start New Process
0004                  (            os9.d):00156         F$Wait              RMB       1                   Wait for Child Process to Die
0005                  (            os9.d):00157         F$Chain             RMB       1                   Chain Process to New Module
0006                  (            os9.d):00158         F$Exit              RMB       1                   Terminate Process
0007                  (            os9.d):00159         F$Mem               RMB       1                   Set Memory Size
0008                  (            os9.d):00160         F$Send              RMB       1                   Send Signal to Process
0009                  (            os9.d):00161         F$Icpt              RMB       1                   Set Signal Intercept
000A                  (            os9.d):00162         F$Sleep             RMB       1                   Suspend Process
000B                  (            os9.d):00163         F$SSpd              RMB       1                   Suspend Process
000C                  (            os9.d):00164         F$ID                RMB       1                   Return Process ID
000D                  (            os9.d):00165         F$SPrior            RMB       1                   Set Process Priority
000E                  (            os9.d):00166         F$SSWI              RMB       1                   Set Software Interrupt
000F                  (            os9.d):00167         F$PErr              RMB       1                   Print Error
0010                  (            os9.d):00168         F$PrsNam            RMB       1                   Parse Pathlist Name
0011                  (            os9.d):00169         F$CmpNam            RMB       1                   Compare Two Names
0012                  (            os9.d):00170         F$SchBit            RMB       1                   Search Bit Map
0013                  (            os9.d):00171         F$AllBit            RMB       1                   Allocate in Bit Map
0014                  (            os9.d):00172         F$DelBit            RMB       1                   Deallocate in Bit Map
0015                  (            os9.d):00173         F$Time              RMB       1                   Get Current Time
0016                  (            os9.d):00174         F$STime             RMB       1                   Set Current Time
0017                  (            os9.d):00175         F$CRC               RMB       1                   Generate CRC ($17)
                      (            os9.d):00176         
                      (            os9.d):00177                             IFGT      Level-1
                      (            os9.d):00178         
                      (            os9.d):00179         * NitrOS-9 Level 2 system calls
0018                  (            os9.d):00180         F$GPrDsc            RMB       1                   Get Process Descriptor copy ($18)
0018                  (            os9.d):00181         F$GBlkMp            RMB       1                   Get System Block Map copy ($19)
0018                  (            os9.d):00182         F$GModDr            RMB       1                   Get Module Directory copy ($1A)
0018                  (            os9.d):00183         F$CpyMem            RMB       1                   Copy External Memory ($1B)
0018                  (            os9.d):00184         F$SUser             RMB       1                   Set User ID number ($1C)
0018                  (            os9.d):00185         F$UnLoad            RMB       1                   Unlink Module by name ($1D)
0018                  (            os9.d):00186         F$Alarm             RMB       1                   Color Computer 3 Alarm Call ($1E)
                      (            os9.d):00187                             RMB       2                   Reserved - For overlap of other systems ($1F)
0018                  (            os9.d):00188         F$NMLink            RMB       1                   Color Computer 3 Non-Mapping Link ($21)
0018                  (            os9.d):00189         F$NMLoad            RMB       1                   Color Computer 3 Non-Mapping Load ($22)
                      (            os9.d):00190         
                      (            os9.d):00191                             ELSE
                      (            os9.d):00192         
                      (            os9.d):00193         * NitrOS-9 Level 1 system call padding
0018                  (            os9.d):00194                             RMB       11
                      (            os9.d):00195         
                      (            os9.d):00196                             ENDC
                      (            os9.d):00197         
0023                  (            os9.d):00198         F$Debug             RMB       1                   Drop the system into the debugger ($23)
                      (            os9.d):00199         
                      (            os9.d):00200                             IFGT      Level-1
                      (            os9.d):00201         
                      (            os9.d):00202                             ORG       $25
0024                  (            os9.d):00203         F$TPS               RMB       1                   Return System's Ticks Per Second
0024                  (            os9.d):00204         F$TimAlm            RMB       1                   CoCo individual process alarm call
                      (            os9.d):00205         
                      (            os9.d):00206                             ENDC
                      (            os9.d):00207         
                      (            os9.d):00208                             ORG       $27                 Beginning of System Reserved Calls
                      (            os9.d):00209         * NitrOS-9 common system calls
0027                  (            os9.d):00210         F$VIRQ              RMB       1                   Install/Delete Virtual IRQ
0028                  (            os9.d):00211         F$SRqMem            RMB       1                   System Memory Request
0029                  (            os9.d):00212         F$SRtMem            RMB       1                   System Memory Return
002A                  (            os9.d):00213         F$IRQ               RMB       1                   Enter IRQ Polling Table
002B                  (            os9.d):00214         F$IOQu              RMB       1                   Enter I/O Queue
002C                  (            os9.d):00215         F$AProc             RMB       1                   Enter Active Process Queue
002D                  (            os9.d):00216         F$NProc             RMB       1                   Start Next Process
002E                  (            os9.d):00217         F$VModul            RMB       1                   Validate Module
002F                  (            os9.d):00218         F$Find64            RMB       1                   Find Process/Path Descriptor
0030                  (            os9.d):00219         F$All64             RMB       1                   Allocate Process/Path Descriptor
0031                  (            os9.d):00220         F$Ret64             RMB       1                   Return Process/Path Descriptor
0032                  (            os9.d):00221         F$SSvc              RMB       1                   Service Request Table Initialization
0033                  (            os9.d):00222         F$IODel             RMB       1                   Delete I/O Module
                      (            os9.d):00223         
                      (            os9.d):00224                             IFGT      Level-1
                      (            os9.d):00225         
0034                  (            os9.d):00226         F$SLink             RMB       1                   System Link
0034                  (            os9.d):00227         F$Boot              RMB       1                   Bootstrap System
0034                  (            os9.d):00228         F$BtMem             RMB       1                   Bootstrap Memory Request
0034                  (            os9.d):00229         F$GProcP            RMB       1                   Get Process ptr
0034                  (            os9.d):00230         F$Move              RMB       1                   Move Data (low bound first)
0034                  (            os9.d):00231         F$AllRAM            RMB       1                   Allocate RAM blocks
0034                  (            os9.d):00232         F$AllImg            RMB       1                   Allocate Image RAM blocks
0034                  (            os9.d):00233         F$DelImg            RMB       1                   Deallocate Image RAM blocks
0034                  (            os9.d):00234         F$SetImg            RMB       1                   Set Process DAT Image
0034                  (            os9.d):00235         F$FreeLB            RMB       1                   Get Free Low Block
0034                  (            os9.d):00236         F$FreeHB            RMB       1                   Get Free High Block
0034                  (            os9.d):00237         F$AllTsk            RMB       1                   Allocate Process Task number
0034                  (            os9.d):00238         F$DelTsk            RMB       1                   Deallocate Process Task number
0034                  (            os9.d):00239         F$SetTsk            RMB       1                   Set Process Task DAT registers
0034                  (            os9.d):00240         F$ResTsk            RMB       1                   Reserve Task number
0034                  (            os9.d):00241         F$RelTsk            RMB       1                   Release Task number
0034                  (            os9.d):00242         F$DATLog            RMB       1                   Convert DAT Block/Offset to Logical
0034                  (            os9.d):00243         F$DATTmp            RMB       1                   Make temporary DAT image (Obsolete)
0034                  (            os9.d):00244         F$LDAXY             RMB       1                   Load A [X,[Y]]
0034                  (            os9.d):00245         F$LDAXYP            RMB       1                   Load A [X+,[Y]]
0034                  (            os9.d):00246         F$LDDDXY            RMB       1                   Load D [D+X,[Y]]
0034                  (            os9.d):00247         F$LDABX             RMB       1                   Load A from 0,X in task B
0034                  (            os9.d):00248         F$STABX             RMB       1                   Store A at 0,X in task B
0034                  (            os9.d):00249         F$AllPrc            RMB       1                   Allocate Process Descriptor
0034                  (            os9.d):00250         F$DelPrc            RMB       1                   Deallocate Process Descriptor
0034                  (            os9.d):00251         F$ELink             RMB       1                   Link using Module Directory Entry
0034                  (            os9.d):00252         F$FModul            RMB       1                   Find Module Directory Entry
0034                  (            os9.d):00253         F$MapBlk            RMB       1                   Map Specific Block
0034                  (            os9.d):00254         F$ClrBlk            RMB       1                   Clear Specific Block
0034                  (            os9.d):00255         F$DelRAM            RMB       1                   Deallocate RAM blocks
0034                  (            os9.d):00256         F$GCMDir            RMB       1                   Pack module directory
0034                  (            os9.d):00257         F$AlHRAM            RMB       1                   Allocate HIGH RAM Blocks
                      (            os9.d):00258         
                      (            os9.d):00259         * Alan DeKok additions
0034                  (            os9.d):00260         F$ReBoot            RMB       1                   Reboot machine (reload OS9Boot) or drop to RSDOS
0034                  (            os9.d):00261         F$CRCMod            RMB       1                   CRC mode, toggle or report current status
0034                  (            os9.d):00262         F$XTime             RMB       1                   Get Extended time packet from RTC (fractions of second)
0034                  (            os9.d):00263         F$VBlock            RMB       1                   Verify modules in a block of memory, add to module directory
