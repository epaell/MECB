     0001             (            scf.d):00003         SCF.D               SET       1
                      (            scf.d):00004         
                      (            scf.d):00005         ********************************************************************
                      (            scf.d):00006         * scf.d - Sequential Character File Manager Definitions
                      (            scf.d):00007         *
                      (            scf.d):00008         * SCF stands for 'Sequential Character Filemanager' and is a package of subroutines
                      (            scf.d):00009         * that define the logical structure of a serial device.
                      (            scf.d):00010         *
                      (            scf.d):00011         * The data structures in this file give SCF its 'personality' and are used
                      (            scf.d):00012         * by SCF itself, as well as applications that will require disk I/O.
                      (            scf.d):00013         *
                      (            scf.d):00014         * Edt/Rev  YYYY/MM/DD  Modified by
                      (            scf.d):00015         * Comment
                      (            scf.d):00016         * ------------------------------------------------------------------
                      (            scf.d):00017         *          1984/01/11  YO
                      (            scf.d):00018         * Added V.KANJI, V.KBUF, V.MODADR for new kanji input process.
                      (            scf.d):00019         *
                      (            scf.d):00020         *          1985/04/20  Mark G. Hawkins
                      (            scf.d):00021         * Added V.PDLHd Path Descriptor List Head.
                      (            scf.d):00022         *
                      (            scf.d):00023         *          1985/04/21  Mark G. Hawkins
                      (            scf.d):00024         * Added PD.PLP and PD.PST for modem handling.
                      (            scf.d):00025         *
                      (            scf.d):00026         *          1987/06/23  Kevin K. Darling
                      (            scf.d):00027         * Updated with Dev Desc info.
                      (            scf.d):00028         *
                      (            scf.d):00029         *          1998/10/03  Boisy G. Pitre
                      (            scf.d):00030         * Consolidated L1/L2 scfdefs.
                      (            scf.d):00031         *
                      (            scf.d):00032         *          2003/01/21  Boisy G. Pitre
                      (            scf.d):00033         * Added symbolics for enhanced SCF line editing.
                      (            scf.d):00034         *
                      (            scf.d):00035         *          2003/06/02  Boisy G. Pitre
                      (            scf.d):00036         * Updated comments for clarity.
                      (            scf.d):00037         *
                      (            scf.d):00038         *          2004/05/17  Boisy G. Pitre
                      (            scf.d):00039         * Added higher baud rates.
                      (            scf.d):00040         
                      (            scf.d):00041                             NAM       scf.d
                      (            scf.d):00042                             TTL       Sequential          File Manager Definitions
                      (            scf.d):00043         
                      (            scf.d):00044                             PAG
                      (            scf.d):00045         *******************************
                      (            scf.d):00046         * SCF Device Descriptor Offsets
                      (            scf.d):00047         *
                      (            scf.d):00048         * These definitions are for SCF device descriptors.
                      (            scf.d):00049         
                      (            scf.d):00050                             ORG       M$DTyp
0012                  (            scf.d):00051         IT.DVC              RMB       1                   Device type (DT.SCF)
0013                  (            scf.d):00052         IT.UPC              RMB       1                   Uppercase flag
0014                  (            scf.d):00053         IT.BSO              RMB       1                   Backspace behavior
0015                  (            scf.d):00054         IT.DLO              RMB       1                   Delete behavior
0016                  (            scf.d):00055         IT.EKO              RMB       1                   Echo flag
0017                  (            scf.d):00056         IT.ALF              RMB       1                   Auto linefeed flag
0018                  (            scf.d):00057         IT.NUL              RMB       1                   End-of-line null count
0019                  (            scf.d):00058         IT.PAU              RMB       1                   Page pause flag
001A                  (            scf.d):00059         IT.PAG              RMB       1                   Number of lines per page
001B                  (            scf.d):00060         IT.BSP              RMB       1                   Backspace character
001C                  (            scf.d):00061         IT.DEL              RMB       1                   Delete-line character
001D                  (            scf.d):00062         IT.EOR              RMB       1                   End-of-record character
001E                  (            scf.d):00063         IT.EOF              RMB       1                   End-of-file character
001F                  (            scf.d):00064         IT.RPR              RMB       1                   Reprint-line character
0020                  (            scf.d):00065         IT.DUP              RMB       1                   Duplicate-last-line character
0021                  (            scf.d):00066         IT.PSC              RMB       1                   Pause character
0022                  (            scf.d):00067         IT.INT              RMB       1                   Interrupt character
0023                  (            scf.d):00068         IT.QUT              RMB       1                   Quit character
0024                  (            scf.d):00069         IT.BSE              RMB       1                   Backspace echo character
0025                  (            scf.d):00070         IT.OVF              RMB       1                   Bell character
0026                  (            scf.d):00071         IT.PAR              RMB       1                   Parity
0027                  (            scf.d):00072         IT.BAU              RMB       1                   Baud rate
0028                  (            scf.d):00073         IT.D2P              RMB       2                   Attached device name string offset
002A                  (            scf.d):00074         IT.XON              RMB       1                   X-ON character
002B                  (            scf.d):00075         IT.XOFF             RMB       1                   X-OFF character
002C                  (            scf.d):00076         IT.COL              RMB       1                   Number of columns for display
002D                  (            scf.d):00077         IT.ROW              RMB       1                   Number of rows for display
002E                  (            scf.d):00078         IT.XTYP             RMB       1                   Extended type (added by BRI)
                      (            scf.d):00079         
                      (            scf.d):00080                             IFGT      Level-1
                      (            scf.d):00081         * Window Descriptor Additions
                      (            scf.d):00082         * For CoCo window, where IT.PAR = $80
                      (            scf.d):00083                             ORG       IT.ROW+1
002F                  (            scf.d):00084         IT.WND              RMB       1                   Window number (matches device name) ($2E)
002F                  (            scf.d):00085         IT.VAL              RMB       1                   Use defaults on Init (0=no, 1=yes)
002F                  (            scf.d):00086         IT.STY              RMB       1                   Screen type default
002F                  (            scf.d):00087         IT.CPX              RMB       1                   Column start default
002F                  (            scf.d):00088         IT.CPY              RMB       1                   Row start default
002F                  (            scf.d):00089         IT.FGC              RMB       1                   Foreground color default
002F                  (            scf.d):00090         IT.BGC              RMB       1                   Background color default
002F                  (            scf.d):00091         IT.BDC              RMB       1                   Border color default
                      (            scf.d):00092                             ENDC
                      (            scf.d):00093         
                      (            scf.d):00094         
                      (            scf.d):00095                             PAG
                      (            scf.d):00096         ********************
                      (            scf.d):00097         * SCF Static Storage
                      (            scf.d):00098         *
                      (            scf.d):00099         * SCF devices must reserve this space for SCF
                      (            scf.d):00100         *
                      (            scf.d):00101                             ORG       V.USER
0006                  (            scf.d):00102         V.TYPE              RMB       1                   Device type or parity
0007                  (            scf.d):00103         V.LINE              RMB       1                   Lines left until end of page
0008                  (            scf.d):00104         V.PAUS              RMB       1                   Immediate Pause request
0009                  (            scf.d):00105         V.DEV2              RMB       2                   Attached device's static
000B                  (            scf.d):00106         V.INTR              RMB       1                   Interrupt char
000C                  (            scf.d):00107         V.QUIT              RMB       1                   Quit char
000D                  (            scf.d):00108         V.PCHR              RMB       1                   Pause char
000E                  (            scf.d):00109         V.ERR               RMB       1                   Accumulated errors
000F                  (            scf.d):00110         V.XON               RMB       1                   X-On char
0010                  (            scf.d):00111         V.XOFF              RMB       1                   X-Off char
0011                  (            scf.d):00112         V.KANJI             RMB       1                   Kanji mode flag
0012                  (            scf.d):00113         V.KBUF              RMB       2                   Kana - Kanji convert routine work address
0014                  (            scf.d):00114         V.MODADR            RMB       2                   Kana - Kanji convert module address
0016                  (            scf.d):00115         V.PDLHd             RMB       2                   Open path descriptor list head pointer
0018                  (            scf.d):00116         V.RSV               RMB       5                   Reserve bytes for future expansion
     001D             (            scf.d):00117         V.SCF               EQU       .                   Total SCF manager static overhead
                      (            scf.d):00118         
                      (            scf.d):00119         
                      (            scf.d):00120                             PAG
                      (            scf.d):00121         ***********************
                      (            scf.d):00122         * Character Definitions
                      (            scf.d):00123         *
     0000             (            scf.d):00124         C$NULL              SET       0                   Null char
     0001             (            scf.d):00125         C$RPET              SET       $01                 (CTRL-A - SOH) Repeat last input line
     0003             (            scf.d):00126         C$INTR              SET       $03                 (CTRL-C - ETX) Keyboard interrupt
     0004             (            scf.d):00127         C$RPRT              SET       $04                 (CTRL-D - EOT) Reprint current input line
     0005             (            scf.d):00128         C$QUIT              SET       $05                 (CTRL-E - ENQ) Keyboard Abort
     0007             (            scf.d):00129         C$BELL              SET       $07                 (CTRL-G - BEL) Line overflow warning
     0008             (            scf.d):00130         C$BSP               SET       $08                 (CTRL-H - BS ) Back space
     0009             (            scf.d):00131         C$RARR              SET       $09                 Right Arrow
     0005             (            scf.d):00132         C$EL                SET       $05                 Erase Line
     000A             (            scf.d):00133         C$LF                SET       $0A                 Line feed
     000B             (            scf.d):00134         C$HOME              SET       $0B                 Home position Code
     0015             (            scf.d):00135         C$Clsgr             SET       $15                 Graphic screen clear (use FM-11)
     0016             (            scf.d):00136         C$Clsall            SET       $16                 Graphic & character clear (use FM-11)
     000D             (            scf.d):00137         C$CR                SET       $0D                 Carriage return
     000C             (            scf.d):00138         C$FORM              SET       $0C                 (CTRL-L - FF ) Form Feed ... screen clear
     000F             (            scf.d):00139         C$SI                SET       $0F                 Shift IN Code
     000E             (            scf.d):00140         C$SO                SET       $0E                 Shift OUT Code
     0010             (            scf.d):00141         C$DELETE            SET       $10                 Delete char (for SCF enhanced line editing)
     0011             (            scf.d):00142         C$XON               SET       $11                 (CTRL-Q - DC1) Transmit Enable
     0011             (            scf.d):00143         C$INSERT            SET       C$XON               Insert char (for SCF enhanced line editing)
     0013             (            scf.d):00144         C$XOFF              SET       $13                 (CTRL-S - DC3) Transmit Disable
     0013             (            scf.d):00145         C$PLINE             SET       C$XOFF              Print remaining line (for SCF enhanced line editing)
     0017             (            scf.d):00146         C$PAUS              SET       $17                 (CTRL-W - ETB) Pause character
     0018             (            scf.d):00147         C$DEL               SET       $18                 (CTRL-X - CAN) Delete line
     0019             (            scf.d):00148         C$SHRARR            SET       $19                 Shift Right-Arrow
     001B             (            scf.d):00149         C$EOF               SET       $1B                 (CTRL-[ - ESC) END of file
     001C             (            scf.d):00150         C$RGT               SET       $1C                 Cursor right
     001D             (            scf.d):00151         C$LFT               SET       $1D                 Cursor left
     001E             (            scf.d):00152         C$UP                SET       $1E                 Cursor up
     001F             (            scf.d):00153         C$DWN               SET       $1F                 Cursor down
     0020             (            scf.d):00154         C$SPAC              SET       $20                 Space
     002E             (            scf.d):00155         C$PERD              SET       '.
     002C             (            scf.d):00156         C$COMA              SET       ',
                      (            scf.d):00157         
                      (            scf.d):00158         
                      (            scf.d):00159                             PAG
                      (            scf.d):00160         *********************************************
                      (            scf.d):00161         * Sequential Character Path Descriptor Format
                      (            scf.d):00162         *
                      (            scf.d):00163         * A path descriptor is created for every new path that is open
                      (            scf.d):00164         * via the I$Open system call (processed by IOMan).  Process
                      (            scf.d):00165         * descriptors track state information of a path.
                      (            scf.d):00166         *
                      (            scf.d):00167                             ORG       PD.FST
000A                  (            scf.d):00168         PD.DV2              RMB       2                   Output device table pointer
000C                  (            scf.d):00169         PD.RAW              RMB       1                   Read/Write or ReadLn/WritLn mode
000D                  (            scf.d):00170         PD.MAX              RMB       2                   ReadLn high byte count
000F                  (            scf.d):00171         PD.MIN              RMB       1                   Devices are "mine" if clear
0010                  (            scf.d):00172         PD.STS              RMB       2                   Status routine module addr
0012                  (            scf.d):00173         PD.STM              RMB       2                   Reserved for status routine
                      (            scf.d):00174                             ORG       PD.OPT
0020                  (            scf.d):00175                             RMB       1                   Device type
0021                  (            scf.d):00176         PD.UPC              RMB       1                   Case (0=both, 1=upper only)
0022                  (            scf.d):00177         PD.BSO              RMB       1                   Backspace (0=BSE, 1=BSE,SP,BSE)
0023                  (            scf.d):00178         PD.DLO              RMB       1                   Delete (0=BSE over line, 1=CRLF)
0024                  (            scf.d):00179         PD.EKO              RMB       1                   Echo (0=No Echo)
0025                  (            scf.d):00180         PD.ALF              RMB       1                   Auto linefeed (0=No auto LF)
0026                  (            scf.d):00181         PD.NUL              RMB       1                   End of Line null count
0027                  (            scf.d):00182         PD.PAU              RMB       1                   Page pause (0=No end of page pause)
0028                  (            scf.d):00183         PD.PAG              RMB       1                   Lines per page
0029                  (            scf.d):00184         PD.BSP              RMB       1                   Backspace character
002A                  (            scf.d):00185         PD.DEL              RMB       1                   Delete Line character
002B                  (            scf.d):00186         PD.EOR              RMB       1                   End of Record character (read only)
002C                  (            scf.d):00187         PD.EOF              RMB       1                   End of File character
002D                  (            scf.d):00188         PD.RPR              RMB       1                   Repront Line character
002E                  (            scf.d):00189         PD.DUP              RMB       1                   Dup Last Line character
002F                  (            scf.d):00190         PD.PSC              RMB       1                   Pause character
0030                  (            scf.d):00191         PD.INT              RMB       1                   Keyboard interrupt character (CTRL-C)
0031                  (            scf.d):00192         PD.QUT              RMB       1                   Keyboard quit character (CTRL-E)
0032                  (            scf.d):00193         PD.BSE              RMB       1                   Backspace echo character
0033                  (            scf.d):00194         PD.OVF              RMB       1                   Line overflow character (BELL)
0034                  (            scf.d):00195         PD.PAR              RMB       1                   Parity code
0035                  (            scf.d):00196         PD.BAU              RMB       1                   ACIA baud rate (Color Computer)
0036                  (            scf.d):00197         PD.D2P              RMB       2                   Offset of DEV2 name
0038                  (            scf.d):00198         PD.XON              RMB       1                   ACIA X-ON character
0039                  (            scf.d):00199         PD.XOFF             RMB       1                   ACIA X-OFF character
     001A             (            scf.d):00200         OPTCNT              EQU       .-PD.OPT            Total user settable options
003A                  (            scf.d):00201         PD.ERR              RMB       1                   Most recent I/O error status
003B                  (            scf.d):00202         PD.TBL              RMB       2                   Device table addr (copy)
003D                  (            scf.d):00203         PD.PLP              RMB       2                   Path Descriptor List Pointer
003F                  (            scf.d):00204         PD.PST              RMB       1                   Current path status
                      (            scf.d):00205         
                      (            scf.d):00206         
                      (            scf.d):00207         * PD.PST values Path Descriptor Status byte
                      (            scf.d):00208         *
     0001             (            scf.d):00209         PST.DCD             EQU       %00000001           Set if DCD is lost on Serial port
                      (            scf.d):00210         
                      (            scf.d):00211         
                      (            scf.d):00212         * PD.PAR definitions
                      (            scf.d):00213         *
                      (            scf.d):00214         * Parity
     0000             (            scf.d):00215         PARNONE             EQU       %00000000
     0020             (            scf.d):00216         PARODD              EQU       %00100000
     0060             (            scf.d):00217         PAREVEN             EQU       %01100000
     00A0             (            scf.d):00218         PARMARK             EQU       %10100000
     00E0             (            scf.d):00219         PARSPACE            EQU       %11100000
     00E0             (            scf.d):00220         PARMASK             EQU       %11100000
                      (            scf.d):00221         
                      (            scf.d):00222         * PD.BAU definitions
                      (            scf.d):00223         *
                      (            scf.d):00224         * Baud rate
     0000             (            scf.d):00225         B110                EQU       %00000000
     0001             (            scf.d):00226         B300                EQU       %00000001
     0002             (            scf.d):00227         B600                EQU       %00000010
     0003             (            scf.d):00228         B1200               EQU       %00000011
     0004             (            scf.d):00229         B2400               EQU       %00000100
     0005             (            scf.d):00230         B4800               EQU       %00000101
     0006             (            scf.d):00231         B9600               EQU       %00000110
     0007             (            scf.d):00232         B19200              EQU       %00000111
     0008             (            scf.d):00233         B38400              EQU       %00001000
     0009             (            scf.d):00234         B57600              EQU       %00001001
     000A             (            scf.d):00235         B115200             EQU       %00001010
                      (            scf.d):00236         * Word size
     0000             (            scf.d):00237         WORD8               EQU       %00000000
     0020             (            scf.d):00238         WORD7               EQU       %00100000
                      (            scf.d):00239         * Stop bits
     0000             (            scf.d):00240         STOP1               EQU       %00000000
     0010             (            scf.d):00241         STOP2               EQU       %00010000
                      (            scf.d):00242         
                      (            scf.d):00243                             ENDC
                      (         defsfile):00003          use xcom9.d
                      (          xcom9.d):00001                  ttl  XCom9 Defs
                      (          xcom9.d):00002                  page
                      (          xcom9.d):00003         *
                      (          xcom9.d):00004         *        XCom9.defs
                      (          xcom9.d):00005         *
                      (          xcom9.d):00006                  use  xcom9_levdef.asm     define the symbol MyLev=1 or 2
     0002             ( xcom9_levdef.asm):00001         MyLev equ 2
                      (          xcom9.d):00007                ifeq  MyLev-1
0040                  (          xcom9.d):00008         MaxRam   equ   1024*2          gives min capture buff of 750 bytes
                      (          xcom9.d):00009                endc
                      (          xcom9.d):00010                ifeq  MyLev-2
     2000             (          xcom9.d):00011         MaxRam   equ   1024*8          gives min capture buff of 6.75KB
                      (          xcom9.d):00012                endc
                      (          xcom9.d):00013         
     0000             (          xcom9.d):00014         stdin    equ   0
     0001             (          xcom9.d):00015         stdout   equ   1
     0002             (          xcom9.d):00016         stderr   equ   2
     0100             (          xcom9.d):00017         lkeybuf  equ   256             max read size from modem or console
     0100             (          xcom9.d):00018         rplysiz  equ   lkeybuf
     0028             (          xcom9.d):00019         MaxTxSiz equ   40              less than acia buff size
     007F             (          xcom9.d):00020         Poff     equ   %01111111       mask to turn off parity bit
     0012             (          xcom9.d):00021         TGLR     equ   $12             cntl-R toggle receive file
     00FE             (          xcom9.d):00022         ClrCarry equ   %11111110
     0001             (          xcom9.d):00023         SetCarry equ   %00000001
     0008             (          xcom9.d):00024         SetMinus equ   %00001000
     0001             (          xcom9.d):00025         SetSig   equ   %00000001
                      (          xcom9.d):00026         *
                      (          xcom9.d):00027         *        Command equates
                      (          xcom9.d):00028         *
     0005             (          xcom9.d):00029         C$Panic  equ   C$QUIT          panic exit - default to os9 abort char
                      (          xcom9.d):00030         *C$panic equ   $19             panic exit - good alternate choice
     0040             (          xcom9.d):00031         brkcmd   equ   '@  send a break on modem port (6850 only)
     0024             (          xcom9.d):00032         shlcmd   equ   '$  Shell
     0041             (          xcom9.d):00033         asccmd   equ   'A  toggle A(scii only mode -
     0042             (          xcom9.d):00034         baucmd   equ   'B  set Baud rate on modem port (req modified acia) -**
     0044             (          xcom9.d):00035         adlcmd   equ   'D  Auto dialer
     0045             (          xcom9.d):00036         echcmd   equ   'E  toggle local E(cho
     0046             (          xcom9.d):00037         flocmd   equ   'F  define chars which F(low cntl me
     0048             (          xcom9.d):00038         hlpcmd   equ   'H  H(elp command
     004F             (          xcom9.d):00039         optcmd   equ   'O  show O(ption settings
     0051             (          xcom9.d):00040         qutcmd   equ   'Q  Q(uit return to os9
     0052             (          xcom9.d):00041         rcvcmd   equ   'R  R(eceive a file - log it to disk
     0053             (          xcom9.d):00042         sndcmd   equ   'S  S(end a file from disk
     0054             (          xcom9.d):00043         etrcmd   equ   'T  Ext file transfer
     0058             (          xcom9.d):00044         xprcmd   equ   'X  setup or stop X(modem file transfer
     0059             (          xcom9.d):00045         ymdmcmd  equ   'Y  setup or stop Y(modem file transfer
     002F             (          xcom9.d):00046         dircmd   equ   '/  Change directory
                      (          xcom9.d):00047         *
                      (          xcom9.d):00048         *        XMODEM equates
                      (          xcom9.d):00049         *
     0001             (          xcom9.d):00050         C$SOH    equ   $01  ^A start of block
     0002             (          xcom9.d):00051         C$STX    equ   $02  ^B start of text (Ymodem)
     0004             (          xcom9.d):00052         C$EOT    equ   $04  ^D end of transmission
     0006             (          xcom9.d):00053         C$ACK    equ   $06  ^F block ok
     0015             (          xcom9.d):00054         C$NAK    equ   $15  ^U resend block
     0018             (          xcom9.d):00055         C$CAN    equ   $18  ^X cancel xmodem
                      (          xcom9.d):00056         *
                      (          xcom9.d):00057         *
                      (          xcom9.d):00058         *        xmodem state variables
                      (          xcom9.d):00059         *
     0000             (          xcom9.d):00060         XS.Idle  equ   0    not in xmodem mode
     0001             (          xcom9.d):00061         XS.Wsoh  equ   1    Rx waiting for SOH
     0002             (          xcom9.d):00062         XS.Rdat  equ   2    Rx getting data bytes
     0010             (          xcom9.d):00063         XS.Wrsp  equ   $10  Tx waiting for response
     0020             (          xcom9.d):00064         XS.IniS  equ   $20  Tx waiting users ok to start
                      (          xcom9.d):00065         *
     0001             (          xcom9.d):00066         XS.Sdat  equ   $1   tx blk contains data
     0002             (          xcom9.d):00067         XS.Seot  equ   $2   tx blk contains eot
                      (          xcom9.d):00068         *
                      (          xcom9.d):00069         *        Timer equates
                      (          xcom9.d):00070         *
                      (          xcom9.d):00071                ifeq  MyLev-2
     0064             (          xcom9.d):00072         VTikPsec equ   100  tiks per second only affects BREAK cmd
                      (          xcom9.d):00073                endc
                      (          xcom9.d):00074                ifeq  MyLev-1
0040                  (          xcom9.d):00075         VTikPsec equ   10   tiks per second only affects BREAK cmd
                      (          xcom9.d):00076                endc
     0100             (          xcom9.d):00077         VTxTmo   equ   $0100 minutes & secs of txmitter timeout (1 min 0 sec)
     000A             (          xcom9.d):00078         VRxTmo   equ   $000A minutes & secs of Rxcver timeout   (0 min 10Sec)
     0016             (          xcom9.d):00079         VIniTmo  equ   $0016 initial Rx wait                    (0 min 22Sec)
                      (          xcom9.d):00080         *
     000A             (          xcom9.d):00081         VErrLim  equ   10   max numb of consecutive errors
                      (          xcom9.d):00082         *
                      (          xcom9.d):00083         
