                      (         sub1.asm):00254         * Open Path - Opens a path to the an existing file or device
                      (         sub1.asm):00255         *             as specified by the path list
                      (         sub1.asm):00256         * entry:
                      (         sub1.asm):00257         *       a -> access mode (D S PE PW PR E W R)
                      (         sub1.asm):00258         *       x -> address of the path list
                      (         sub1.asm):00259         *
                      (         sub1.asm):00260         * exit:
                      (         sub1.asm):00261         *       a -> path number
                      (         sub1.asm):00262         *       x -> address of the last btye of the path list + 1
                      (         sub1.asm):00263         *
                      (         sub1.asm):00264         * error:
                      (         sub1.asm):00265         *       CC -> Carry set on error
                      (         sub1.asm):00266         *       b  -> error code (if any)
                      (         sub1.asm):00267         
0043 8601             (         sub1.asm):00268                             lda       #READ.
0045 308D15B9         (         sub1.asm):00269                             leax      >SinTbl,pcr
0049 103F84           (         sub1.asm):00270                             os9       I$Open
004C 3402             (         sub1.asm):00271                             pshs      a                   save that path number
                      (         sub1.asm):00272         
                      (         sub1.asm):00273         * Read  - Reads n bytes from the specified path
                      (         sub1.asm):00274         * entry:
                      (         sub1.asm):00275         *       a -> path number
                      (         sub1.asm):00276         *       x -> address in which to store the data
                      (         sub1.asm):00277         *       y -> is the number of bytes to read
                      (         sub1.asm):00278         *
                      (         sub1.asm):00279         * exit:
                      (         sub1.asm):00280         *       y -> number of bytes read
                      (         sub1.asm):00281         *
                      (         sub1.asm):00282         * error:
                      (         sub1.asm):00283         *       CC -> Carry set on error
                      (         sub1.asm):00284         *       b  -> error code (if any)
                      (         sub1.asm):00285         
004E 8E0126           (         sub1.asm):00286                             ldx       #SinDat
0051 108E0169         (         sub1.asm):00287                             ldy       #SinTblSz
0055 103F89           (         sub1.asm):00288                             os9       I$Read              load it in data
                      (         sub1.asm):00289         
0058 3502             (         sub1.asm):00290                             puls      a                   clean up stack
                      (         sub1.asm):00291         
                      (         sub1.asm):00292         * Close Path - Terminates I/O path
                      (         sub1.asm):00293         *              (performs an impledd I$Detach call)
                      (         sub1.asm):00294         * entry:
                      (         sub1.asm):00295         *       a -> path number
                      (         sub1.asm):00296         *
                      (         sub1.asm):00297         * error:
                      (         sub1.asm):00298         *       CC -> Carry set on error
                      (         sub1.asm):00299         *       b  -> error code (if any)
                      (         sub1.asm):00300         
005A 103F8F           (         sub1.asm):00301                             os9       I$Close
                      (         sub1.asm):00302         
                      (         sub1.asm):00303         
005D 8601             (         sub1.asm):00304                             lda       #READ.
005F 308D149F         (         sub1.asm):00305                             leax      >Font,pcr
0063 103F84           (         sub1.asm):00306                             os9       I$Open
0066 3402             (         sub1.asm):00307                             pshs      a                   No need for this here
                      (         sub1.asm):00308         
                      (         sub1.asm):00309         * Seek  - Repositions a file pointer
                      (         sub1.asm):00310         * entry:
                      (         sub1.asm):00311         *       a -> path number
                      (         sub1.asm):00312         *       x -> MS 16 bits of the desired file position
                      (         sub1.asm):00313         *       u -> LS 16 bits of the desired file position
                      (         sub1.asm):00314         *
                      (         sub1.asm):00315         * error:
                      (         sub1.asm):00316         *       CC -> Carry set on error
                      (         sub1.asm):00317         *       b  -> error code (if any)
                      (         sub1.asm):00318         
0068 8E0000           (         sub1.asm):00319                             ldx       #0
006B 108E0000         (         sub1.asm):00320                             ldy       #0                  No need for this here
006F CE0103           (         sub1.asm):00321                             ldu       #$0103              file position
0072 103F88           (         sub1.asm):00322                             os9       I$Seek
                      (         sub1.asm):00323         
0075 8E4D3F           (         sub1.asm):00324                             ldx       #$4D3F              save address
0078 108E0308         (         sub1.asm):00325                             ldy       #$0308              num of bytes to read
007C A6E4             (         sub1.asm):00326                             lda       ,s                  get the path ?? should still be set
007E 103F89           (         sub1.asm):00327                             os9       I$Read
                      (         sub1.asm):00328         
0081 3502             (         sub1.asm):00329                             puls      a                   get that same path number no need
0083 103F8F           (         sub1.asm):00330                             os9       I$Close             close the file
