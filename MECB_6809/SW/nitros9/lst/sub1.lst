                      (         sub1.asm):00001         ********************************************************************
                      (         sub1.asm):00002         * sub1 - Sub1 Sub Battle Simulator subroutine
                      (         sub1.asm):00003         *
                      (         sub1.asm):00004         * There is a lot of extraneous and unneccessary instructions throughout
                      (         sub1.asm):00005         * the code. But since we use the jump table at module enter be careful
                      (         sub1.asm):00006         * when removing any thing and adjust it accordingly.
                      (         sub1.asm):00007         * No explicit edition byte in source.
                      (         sub1.asm):00008         *
                      (         sub1.asm):00009         * Edt/Rev  YYYY/MM/DD  Modified by
                      (         sub1.asm):00010         * Comment
                      (         sub1.asm):00011         * ------------------------------------------------------------------
                      (         sub1.asm):00012         *   0      2003/03/29  Paul W. Zibaila
                      (         sub1.asm):00013         * Disassembly of original distribution.
                      (         sub1.asm):00014         
                      (         sub1.asm):00015                             nam       sub1
                      (         sub1.asm):00016                             ttl       Sub1 Sub Battle Simulator subroutine
                      (         sub1.asm):00017         
                      (         sub1.asm):00018                             ifp1
