     0000             (           mecb.d):00208         WIFI_IDLE                           equ   0
     0001             (           mecb.d):00209         WIFI_NOSSID                         equ   1
     0002             (           mecb.d):00210         WIFI_SCAN_COMPLETE                  equ   2
     0003             (           mecb.d):00211         WIFI_CONNECTED                      equ   3
     0004             (           mecb.d):00212         WIFI_CONNECT_FAIL                   equ   4
