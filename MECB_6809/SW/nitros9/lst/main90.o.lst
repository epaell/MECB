0000                  (        main90.as):00104         SIGCODE             rmb       1                   Intercept signal RMB
0001                  (        main90.as):00105         PATH                rmb       1                   Screen path number
0002                  (        main90.as):00106         PATH2               rmb       1                   Second screen path number
0003                  (        main90.as):00107         WINDOW              rmb       1                   Holds 0 or 2 to keep track
                      (        main90.as):00108         *                          of which window is being used
0004                  (        main90.as):00109         PROCID              rmb       1                   Holds process id
0005                  (        main90.as):00110         RESPON              rmb       2                   Holds response bytes
                      (        main90.as):00111         
                      (        main90.as):00112         
0007                  (        main90.as):00113         PORT                rmb       2                   Joystick port (0=right,1=left)
0009                  (        main90.as):00114         BUTTON              rmb       1                   Joystick button status
000A                  (        main90.as):00115         JOYSTX              rmb       2                   Joystick X value
000C                  (        main90.as):00116         JOYSTY              rmb       2                   Joystick Y value
                      (        main90.as):00117         
000E                  (        main90.as):00118         PLAYRS              rmb       1                   Holds 0 or 1 (for 1 or 2 players)
                      (        main90.as):00119         
000F                  (        main90.as):00120         PACMN1              rmb       1                   Holds number of pacmen left(player1)
0010                  (        main90.as):00121         PACMN2              rmb       1                   Holds number of pacmen left(player2)
0011                  (        main90.as):00122         PLCRNT              rmb       1                   Holds current player number(1 or 2)
0012                  (        main90.as):00123         PACMAN              rmb       1                   Holds current number of men left
                      (        main90.as):00124         *                         this will be either PACMN1 or PACMN2
                      (        main90.as):00125         
0013                  (        main90.as):00126         PXNEW               rmb       2                   New pacman X position
0015                  (        main90.as):00127         PYNEW               rmb       2                   New pacman Y position
0017                  (        main90.as):00128         POFSET              rmb       2                   Pacman offset from start of array
0019                  (        main90.as):00129         BUFF                rmb       1                   Holds current pacman buffer #
                      (        main90.as):00130         
001A                  (        main90.as):00131         CYCLE               rmb       1                   Used to cycle between buffers
                      (        main90.as):00132         
001B                  (        main90.as):00133         HITFLG              rmb       1                   A 1 here = pacman caught
001C                  (        main90.as):00134         GHTHIT              rmb       1                   Ghost hit flag
001D                  (        main90.as):00135         POWFLG              rmb       1                   When pacman eats a power pill then
                      (        main90.as):00136         *                         this location holds a timer value
                      (        main90.as):00137         
001E                  (        main90.as):00138         BONFLG              rmb       1                   Bonus on screen flag
001F                  (        main90.as):00139         BONTIM              rmb       1                   Bonus timer
0020                  (        main90.as):00140         BONBUF              rmb       1                   Current bonus buffer
0021                  (        main90.as):00141         BONUSX              rmb       2                   Bonus X location at bottom of scrn
0023                  (        main90.as):00142         BONUSY              rmb       2                   Bonus Y location at bottom of scrn
0025                  (        main90.as):00143         BONCNT              rmb       1                   Bonus counter
0026                  (        main90.as):00144         BONTAB              rmb       10                  Bonus item table
                      (        main90.as):00145         
0030                  (        main90.as):00146         BONTMP              rmb       2                   Temporary storage
0032                  (        main90.as):00147         BTEMP               rmb       15                  Used to hold BONUSX,BONUSY,BONCNT
                      (        main90.as):00148         *                          and BONTAB  for 2 player mode
0041                  (        main90.as):00149         SNDPR1              rmb       2
0043                  (        main90.as):00150         SNDPR2              rmb       2
                      (        main90.as):00151         
                      (        main90.as):00152         *     Ghost tables, One 20 byte table for each ghost
                      (        main90.as):00153         
0045                  (        main90.as):00154         G1OFST              rmb       2                   Ghost position offset from start of array
0047                  (        main90.as):00155         G1XNEW              rmb       2                   Screen X location of ghost
0049                  (        main90.as):00156         G1YNEW              rmb       2                   Screen Y location of ghost
004B                  (        main90.as):00157         G1XOLD              rmb       2                   Pseudo scrn X location of ghost
004D                  (        main90.as):00158         G1YOLD              rmb       2                   Pseudo scrn Y location of ghost
004F                  (        main90.as):00159         G1STAT              rmb       1                   Status flag for ghost
                      (        main90.as):00160         *                          -2 = Eyes are caged,timer not run out
                      (        main90.as):00161         *                          -1 = Ghost caged,timer not run out
                      (        main90.as):00162         *                           0 = Ghost still in cage but moving out
                      (        main90.as):00163         *                           1 = Ghost is free of cage,can move around
                      (        main90.as):00164         *                           2 = Ghost has been turned into eyes
0050                  (        main90.as):00165         G1BUFF              rmb       1                   Holds current buffer # for ghost
0051                  (        main90.as):00166         G1TIME              rmb       1                   Ghost time out counter
0052                  (        main90.as):00167         TIMVAL              rmb       1                   Ghost initial time out value
0053                  (        main90.as):00168         G1DIR               rmb       1                   Ghost dir. (0=up,1=lf,2=rt,3=dn)
0054                  (        main90.as):00169         DIROFF              rmb       1                   Direction offset (-69,-1,1,69)
0055                  (        main90.as):00170         G1UPDT              rmb       1                   Holds update value to be count down
0056                  (        main90.as):00171         UPDATE              rmb       1                   Initial update value
0057                  (        main90.as):00172                             rmb       2                   Extra bytes
                      (        main90.as):00173         
