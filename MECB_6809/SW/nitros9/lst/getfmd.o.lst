                      (        getfmd.as):00001         ;;; GETFMD
                      (        getfmd.as):00002         ;;;
                      (        getfmd.as):00003         ;;; Get the last modified date/time of a file.
                      (        getfmd.as):00004         ;;
                      (        getfmd.as):00005         ;;; Entry:  A = The path of the file.
                      (        getfmd.as):00006         ;;;         X = A 6-byte buffer that holds the date/time.
                      (        getfmd.as):00007         ;;;
                      (        getfmd.as):00008         ;;; Exit:   None.
                      (        getfmd.as):00009         ;;;
                      (        getfmd.as):00010         ;;; Error:  B = A non-zero error code.
                      (        getfmd.as):00011         ;;;        CC = Carry flag set to indicate error.
                      (        getfmd.as):00012         ;;;
                      (        getfmd.as):00013         ;;; Even though OS-9 doesn't save seconds in its files, this routine stores a zero in this position.
                      (        getfmd.as):00014         ;;; This is done to make the routine compatible with DATESTR.
                      (        getfmd.as):00015         
