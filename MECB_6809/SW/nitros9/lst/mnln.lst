0004                  (       cocovtio.d):00058         V.AGBuf             RMB       4                   (2) additional graphics buffer
0004                  (       cocovtio.d):00059         V.FFMem             RMB       2                   Flood fill alloc'ed mem
0004                  (       cocovtio.d):00060         V.FFSPt             RMB       2                   Flood fill current stack pointer
0004                  (       cocovtio.d):00061         V.FFSTp             RMB       1                   Flood fill stack top
0004                  (       cocovtio.d):00062         V.FF6               RMB       1                   flood fill flag
0004                  (       cocovtio.d):00063         V.FFFlag            RMB       1                   Error in FloodFill - E$Write if FFill stack overflows, 0 if no error
0004                  (       cocovtio.d):00064         V.MTabl             RMB       2                   (2) address of mask table for pixels in byte
0004                  (       cocovtio.d):00065         V.PixBt             RMB       1                   bit mask for modes (0=$07, 1=$03 )#pixels/byte
0004                  (       cocovtio.d):00066         V.GCrsX             RMB       1                   graphics cursor X value
0004                  (       cocovtio.d):00067         V.GCrsY             RMB       1                   graphics cursor Y
0004                  (       cocovtio.d):00068         V.Msk1              RMB       1                   mask byte 1
0004                  (       cocovtio.d):00069         V.Msk2              RMB       1                   mask byte 2 (00,55,AA,FF) Full byte Color Mask
0004                  (       cocovtio.d):00070         V.MCol              RMB       1                   Start pixel in a byte mask ($C0=4 color, $80=2 color)
0004                  (       cocovtio.d):00071         V.4A                RMB       1                   End pixel in a byte mask ($03=4 color,$01=2 color)
0004                  (       cocovtio.d):00072         V.PMask             RMB       1                   Full byte pixel mask for colors (i.e. $55, $CC etc)
0004                  (       cocovtio.d):00073         V.4C                RMB       1
0004                  (       cocovtio.d):00074         V.4D                RMB       1
0004                  (       cocovtio.d):00075         V.4E                RMB       1                   Flood Fill full byte color mask
0004                  (       cocovtio.d):00076         V.4F                RMB       1
0004                  (       cocovtio.d):00077         V.Caps              RMB       1                   caps lock info: $00=lower $FF=upper
0004                  (       cocovtio.d):00078         V.ClkCnt            RMB       1                   clock count ??
0004                  (       cocovtio.d):00079         V.KyDly             RMB       1                   key repeat initial delay
0004                  (       cocovtio.d):00080         V.KySpd             RMB       1                   key repeat secondary delay
0004                  (       cocovtio.d):00081         V.WrChr             RMB       1                   character to write
