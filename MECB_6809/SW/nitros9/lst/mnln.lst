     0003             ( ../objs/mnln.asm):00274         CY_REV              equ       3
                      ( ../objs/mnln.asm):00275         
                      ( ../objs/mnln.asm):00276         *  Motion Types
     0000             ( ../objs/mnln.asm):00277         MT_NORM             equ       0
     0001             ( ../objs/mnln.asm):00278         MT_WANDER           equ       1
     0002             ( ../objs/mnln.asm):00279         MT_FOLLOW           equ       2
     0003             ( ../objs/mnln.asm):00280         MT_MOVE             equ       3
     0004             ( ../objs/mnln.asm):00281         MT_EGO              equ       4
                      ( ../objs/mnln.asm):00282         
                      ( ../objs/mnln.asm):00283         *  Loop Directions
     0000             ( ../objs/mnln.asm):00284         RIGHT               equ       $00
     0001             ( ../objs/mnln.asm):00285         LEFT                equ       $01
     0002             ( ../objs/mnln.asm):00286         DOWN                equ       $02
     0003             ( ../objs/mnln.asm):00287         UP                  equ       $03
     0004             ( ../objs/mnln.asm):00288         IGNORE              equ       $04
                      ( ../objs/mnln.asm):00289         
                      ( ../objs/mnln.asm):00290         
                      ( ../objs/mnln.asm):00291         * VIEW OBJECTS FLAGS
                      ( ../objs/mnln.asm):00292         
     0001             ( ../objs/mnln.asm):00293         O_DRAWN             equ       $01       * 0  - object has been drawn
     0002             ( ../objs/mnln.asm):00294         O_BLKIGNORE         equ       $02       * 1  - ignore blocks and condition lines
     0004             ( ../objs/mnln.asm):00295         O_PRIFIXED          equ       $04       * 2  - fixes priority agi cannot change it based on position
     0008             ( ../objs/mnln.asm):00296         O_HRZNIGNORE        equ       $08       * 3  - ignore horizon
     0010             ( ../objs/mnln.asm):00297         O_UPDATE            equ       $10       * 4  - update every cycle
     0020             ( ../objs/mnln.asm):00298         O_CYCLE             equ       $20       * 5  - the object cycles
     0040             ( ../objs/mnln.asm):00299         O_ANIMATE           equ       $40       * 6  - animated
     0080             ( ../objs/mnln.asm):00300         O_BLOCK             equ       $80       * 7  - resting on a block
     0100             ( ../objs/mnln.asm):00301         O_WATER             equ       $100      * 8  - only allowed on water
     0200             ( ../objs/mnln.asm):00302         O_OBJIGNORE         equ       $200      * 9  - ignore other objects when determining contacts
     0400             ( ../objs/mnln.asm):00303         O_REPOS             equ       $400      * 10 - set whenever a obj is repositioned
                      ( ../objs/mnln.asm):00304         *                                that way the interpeter doesn't check it's next movement for one cycle
     0800             ( ../objs/mnln.asm):00305         O_LAND              equ       $800      * 11 - only allowed on land
     1000             ( ../objs/mnln.asm):00306         O_SKIPUPDATE        equ       $1000     * 12 - does not update obj for one cycle
     2000             ( ../objs/mnln.asm):00307         O_LOOPFIXED         equ       $2000     * 13 - agi cannot set the loop depending on direction
     4000             ( ../objs/mnln.asm):00308         O_MOTIONLESS        equ       $4000     * 14 - no movement.
                      ( ../objs/mnln.asm):00309         *                                if position is same as position in last cycle then this flag is set.
                      ( ../objs/mnln.asm):00310         *                                follow/wander code can then create a new direction
                      ( ../objs/mnln.asm):00311         *                                (ie, if it hits a wall or something)
     8000             ( ../objs/mnln.asm):00312         O_UNUSED            equ       $8000
                      ( ../objs/mnln.asm):00313         
