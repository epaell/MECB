                      (       cocovtio.d):00964         *****************************************************************************
                      (       cocovtio.d):00965         * This table is located in the graphics table memory and is offset from
                      (       cocovtio.d):00966         * graphics table pointer stored at $1075-$1076. This is used exclusively by
                      (       cocovtio.d):00967         * WindInt.
                      (       cocovtio.d):00968         * NOTE: USING UNUSED BYTES IN CC3 GLOBAL MEM, SET UP SEPARATE PTRS FOR EACH
                      (       cocovtio.d):00969         *  OF THE BELOW SO WE CAN SPEED UP ACCESS BY NOT HAVING TO DO A LOAD/LEAx
                      (       cocovtio.d):00970         *  COMBINATION EVERY TIME
                      (       cocovtio.d):00971                             ORG       $0240
0240                  (       cocovtio.d):00972                             RMB       WN.SIZ              (+$240) copy of last accessed window descriptor
0262                  (       cocovtio.d):00973                             RMB       MN.SIZ              (+$262) copy of last accessed menu descriptor
0279                  (       cocovtio.d):00974                             RMB       MI.SIZ              (+$279) copy of last accessed item descriptor
028E                  (       cocovtio.d):00975                             RMB       65                  (+$28E) menu handling table (16 entrys of 4 bytes)
                      (       cocovtio.d):00976         
                      (       cocovtio.d):00977         *****************************************************************************
                      (       cocovtio.d):00978         * WindInt menu handling table entry definition
                      (       cocovtio.d):00979                             ORG       0
0000                  (       cocovtio.d):00980         MnuXNum             RMB       1                   menu #
0001                  (       cocovtio.d):00981         MnuXStrt            RMB       1                   X start text co-ordinate
0002                  (       cocovtio.d):00982         MnuXEnd             RMB       1                   X end text co-ordinate
0003                  (       cocovtio.d):00983                             RMB       1                   unused?
     0004             (       cocovtio.d):00984         MnuHSiz             EQU       .
                      (       cocovtio.d):00985         
                      (       cocovtio.d):00986         *****************************************************************************
                      (       cocovtio.d):00987         * Character binary switches
     0080             (       cocovtio.d):00988         Blink               EQU       %10000000           Blink characters (hardware text only)
     0080             (       cocovtio.d):00989         TChr                EQU       %10000000           transparent characters (both currently)
     0040             (       cocovtio.d):00990         Under               EQU       %01000000           underline characters (both)
     0020             (       cocovtio.d):00991         Bold                EQU       %00100000           bold characters (gfx only, maybe txt with color changes?)
     0010             (       cocovtio.d):00992         Prop                EQU       %00010000           proportional spacing of characters (gfx only)
     0008             (       cocovtio.d):00993         Scale               EQU       %00001000           automatic window scaling (gfx only)
     0004             (       cocovtio.d):00994         Invers              EQU       %00000100           inverse characters (both)
     0002             (       cocovtio.d):00995         NoCurs              EQU       %00000010           no cursor display (both)
     0001             (       cocovtio.d):00996         Protect             EQU       %00000001           device window protection (both)
