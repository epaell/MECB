                      ( ../objs/scrn.asm):00153         * Clears the area allocated to the screen in sierra
                      ( ../objs/scrn.asm):00154         * entry:
                      ( ../objs/scrn.asm):00155         *      d -> value to be written to screen
                      ( ../objs/scrn.asm):00156         *      x -> may contain a value so we save it
                      ( ../objs/scrn.asm):00157         * exit:
                      ( ../objs/scrn.asm):00158         *      d -> preserved
                      ( ../objs/scrn.asm):00159         *      x -> restored to initial value
                      ( ../objs/scrn.asm):00160         *      u -> contains starting address of the screen
                      ( ../objs/scrn.asm):00161         
