     0013             (       rescue.asm):00323         start               equ       *
                      (       rescue.asm):00324         * install our signal handler
0013 308D01DC         (       rescue.asm):00325                             leax      >sighand,pcr        point to the signal handler routine
0017 CE0000           (       rescue.asm):00326                             ldu       #$0000              clear U
001A 103F09           (       rescue.asm):00327                             os9       F$Icpt              install the signal handler
001D 1A50             (       rescue.asm):00328                             orcc      #IntMasks           mask interrupts (to load S, apparently)
001F 10CE5E23         (       rescue.asm):00329                             lds       #$5E23              load stack pointer
0023 1CAF             (       rescue.asm):00330                             andcc     #^IntMasks          unmask interrupts
                      (       rescue.asm):00331         
                      (       rescue.asm):00332         * read a character
0025 8604             (       rescue.asm):00333         rdloop              lda       #$04                read one character
0027 172BAA           (       rescue.asm):00334                             lbsr      routines            do read routine
002A 24F9             (       rescue.asm):00335                             bcc       rdloop              ...until we get something
                      (       rescue.asm):00336         
                      (       rescue.asm):00337         * welcome the user to ROF and get monitor type
002C 1701C5           (       rescue.asm):00338                             lbsr      Welcome             do welcome message and monitor type
                      (       rescue.asm):00339         
                      (       rescue.asm):00340         * set the monitor type
002F 8601             (       rescue.asm):00341                             lda       #stdout             to standard out
0031 C692             (       rescue.asm):00342                             ldb       #SS.Montr
0033 BE0CC9           (       rescue.asm):00343                             ldx       >mtype              get value of montype flag
0036 103F8E           (       rescue.asm):00344                             os9       I$SetStt            set it!
                      (       rescue.asm):00345         
                      (       rescue.asm):00346         * following code section needs to open a window and get address in 68K
                      (       rescue.asm):00347         * get a 160x192x16 game screen using SS.AScrn
0039 8601             (       rescue.asm):00348                             lda       #stdout             to standard out
003B C68B             (       rescue.asm):00349                             ldb       #SS.AScrn           SS.AScrn is the man!
