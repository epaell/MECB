                      (           mecb.d):00180         ; Definition of DCB offsets from common section
                      (           mecb.d):00181         ;
     0000             (           mecb.d):00182         DCB_DEVICE                          equ   0
     0001             (           mecb.d):00183         DCB_COMMAND                         equ   1
     0002             (           mecb.d):00184         DCB_AUX1                            equ   2
     0003             (           mecb.d):00185         DCB_AUX2                            equ   3
     0004             (           mecb.d):00186         DCB_CHECKSUM                        equ   4
     0004             (           mecb.d):00187         DCB_TX_BUFFER                       equ   4
     0006             (           mecb.d):00188         DCB_TX_BUFFER_LEN                   equ   6
     0008             (           mecb.d):00189         DCB_RX_BUFFER                       equ   8
     000A             (           mecb.d):00190         DCB_RX_BUFFER_LEN                   equ   10
     000C             (           mecb.d):00191         DCB_TIMEOUT                         equ   12
                      (           mecb.d):00192         
     000E             (           mecb.d):00193         DCB_SIZE                            equ   14
