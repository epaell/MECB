                      (            scf.d):00096         ********************
                      (            scf.d):00097         * SCF Static Storage
                      (            scf.d):00098         *
                      (            scf.d):00099         * SCF devices must reserve this space for SCF
                      (            scf.d):00100         *
                      (            scf.d):00101                             ORG       V.USER
0006                  (            scf.d):00102         V.TYPE              RMB       1                   Device type or parity
0007                  (            scf.d):00103         V.LINE              RMB       1                   Lines left until end of page
0008                  (            scf.d):00104         V.PAUS              RMB       1                   Immediate Pause request
0009                  (            scf.d):00105         V.DEV2              RMB       2                   Attached device's static
000B                  (            scf.d):00106         V.INTR              RMB       1                   Interrupt char
000C                  (            scf.d):00107         V.QUIT              RMB       1                   Quit char
000D                  (            scf.d):00108         V.PCHR              RMB       1                   Pause char
000E                  (            scf.d):00109         V.ERR               RMB       1                   Accumulated errors
000F                  (            scf.d):00110         V.XON               RMB       1                   X-On char
0010                  (            scf.d):00111         V.XOFF              RMB       1                   X-Off char
0011                  (            scf.d):00112         V.KANJI             RMB       1                   Kanji mode flag
0012                  (            scf.d):00113         V.KBUF              RMB       2                   Kana - Kanji convert routine work address
0014                  (            scf.d):00114         V.MODADR            RMB       2                   Kana - Kanji convert module address
0016                  (            scf.d):00115         V.PDLHd             RMB       2                   Open path descriptor list head pointer
0018                  (            scf.d):00116         V.RSV               RMB       5                   Reserve bytes for future expansion
     001D             (            scf.d):00117         V.SCF               EQU       .                   Total SCF manager static overhead
                      (            scf.d):00118         
                      (            scf.d):00119         
                      (            scf.d):00120                             PAG
                      (            scf.d):00121         ***********************
                      (            scf.d):00122         * Character Definitions
                      (            scf.d):00123         *
     0000             (            scf.d):00124         C$NULL              SET       0                   Null char
     0001             (            scf.d):00125         C$RPET              SET       $01                 (CTRL-A - SOH) Repeat last input line
     0003             (            scf.d):00126         C$INTR              SET       $03                 (CTRL-C - ETX) Keyboard interrupt
     0004             (            scf.d):00127         C$RPRT              SET       $04                 (CTRL-D - EOT) Reprint current input line
     0005             (            scf.d):00128         C$QUIT              SET       $05                 (CTRL-E - ENQ) Keyboard Abort
     0007             (            scf.d):00129         C$BELL              SET       $07                 (CTRL-G - BEL) Line overflow warning
     0008             (            scf.d):00130         C$BSP               SET       $08                 (CTRL-H - BS ) Back space
     0009             (            scf.d):00131         C$RARR              SET       $09                 Right Arrow
     0005             (            scf.d):00132         C$EL                SET       $05                 Erase Line
     000A             (            scf.d):00133         C$LF                SET       $0A                 Line feed
     000B             (            scf.d):00134         C$HOME              SET       $0B                 Home position Code
     0015             (            scf.d):00135         C$Clsgr             SET       $15                 Graphic screen clear (use FM-11)
     0016             (            scf.d):00136         C$Clsall            SET       $16                 Graphic & character clear (use FM-11)
     000D             (            scf.d):00137         C$CR                SET       $0D                 Carriage return
     000C             (            scf.d):00138         C$FORM              SET       $0C                 (CTRL-L - FF ) Form Feed ... screen clear
     000F             (            scf.d):00139         C$SI                SET       $0F                 Shift IN Code
     000E             (            scf.d):00140         C$SO                SET       $0E                 Shift OUT Code
     0010             (            scf.d):00141         C$DELETE            SET       $10                 Delete char (for SCF enhanced line editing)
     0011             (            scf.d):00142         C$XON               SET       $11                 (CTRL-Q - DC1) Transmit Enable
     0011             (            scf.d):00143         C$INSERT            SET       C$XON               Insert char (for SCF enhanced line editing)
     0013             (            scf.d):00144         C$XOFF              SET       $13                 (CTRL-S - DC3) Transmit Disable
     0013             (            scf.d):00145         C$PLINE             SET       C$XOFF              Print remaining line (for SCF enhanced line editing)
     0017             (            scf.d):00146         C$PAUS              SET       $17                 (CTRL-W - ETB) Pause character
     0018             (            scf.d):00147         C$DEL               SET       $18                 (CTRL-X - CAN) Delete line
     0019             (            scf.d):00148         C$SHRARR            SET       $19                 Shift Right-Arrow
     001B             (            scf.d):00149         C$EOF               SET       $1B                 (CTRL-[ - ESC) END of file
     001C             (            scf.d):00150         C$RGT               SET       $1C                 Cursor right
     001D             (            scf.d):00151         C$LFT               SET       $1D                 Cursor left
     001E             (            scf.d):00152         C$UP                SET       $1E                 Cursor up
     001F             (            scf.d):00153         C$DWN               SET       $1F                 Cursor down
     0020             (            scf.d):00154         C$SPAC              SET       $20                 Space
     002E             (            scf.d):00155         C$PERD              SET       '.
     002C             (            scf.d):00156         C$COMA              SET       ',
                      (            scf.d):00157         
                      (            scf.d):00158         
                      (            scf.d):00159                             PAG
                      (            scf.d):00160         *********************************************
                      (            scf.d):00161         * Sequential Character Path Descriptor Format
                      (            scf.d):00162         *
                      (            scf.d):00163         * A path descriptor is created for every new path that is open
                      (            scf.d):00164         * via the I$Open system call (processed by IOMan).  Process
                      (            scf.d):00165         * descriptors track state information of a path.
                      (            scf.d):00166         *
                      (            scf.d):00167                             ORG       PD.FST
000A                  (            scf.d):00168         PD.DV2              RMB       2                   Output device table pointer
000C                  (            scf.d):00169         PD.RAW              RMB       1                   Read/Write or ReadLn/WritLn mode
000D                  (            scf.d):00170         PD.MAX              RMB       2                   ReadLn high byte count
000F                  (            scf.d):00171         PD.MIN              RMB       1                   Devices are "mine" if clear
0010                  (            scf.d):00172         PD.STS              RMB       2                   Status routine module addr
0012                  (            scf.d):00173         PD.STM              RMB       2                   Reserved for status routine
                      (            scf.d):00174                             ORG       PD.OPT
0020                  (            scf.d):00175                             RMB       1                   Device type
0021                  (            scf.d):00176         PD.UPC              RMB       1                   Case (0=both, 1=upper only)
0022                  (            scf.d):00177         PD.BSO              RMB       1                   Backspace (0=BSE, 1=BSE,SP,BSE)
0023                  (            scf.d):00178         PD.DLO              RMB       1                   Delete (0=BSE over line, 1=CRLF)
0024                  (            scf.d):00179         PD.EKO              RMB       1                   Echo (0=No Echo)
0025                  (            scf.d):00180         PD.ALF              RMB       1                   Auto linefeed (0=No auto LF)
0026                  (            scf.d):00181         PD.NUL              RMB       1                   End of Line null count
0027                  (            scf.d):00182         PD.PAU              RMB       1                   Page pause (0=No end of page pause)
0028                  (            scf.d):00183         PD.PAG              RMB       1                   Lines per page
0029                  (            scf.d):00184         PD.BSP              RMB       1                   Backspace character
002A                  (            scf.d):00185         PD.DEL              RMB       1                   Delete Line character
002B                  (            scf.d):00186         PD.EOR              RMB       1                   End of Record character (read only)
002C                  (            scf.d):00187         PD.EOF              RMB       1                   End of File character
002D                  (            scf.d):00188         PD.RPR              RMB       1                   Repront Line character
002E                  (            scf.d):00189         PD.DUP              RMB       1                   Dup Last Line character
002F                  (            scf.d):00190         PD.PSC              RMB       1                   Pause character
0030                  (            scf.d):00191         PD.INT              RMB       1                   Keyboard interrupt character (CTRL-C)
0031                  (            scf.d):00192         PD.QUT              RMB       1                   Keyboard quit character (CTRL-E)
0032                  (            scf.d):00193         PD.BSE              RMB       1                   Backspace echo character
0033                  (            scf.d):00194         PD.OVF              RMB       1                   Line overflow character (BELL)
0034                  (            scf.d):00195         PD.PAR              RMB       1                   Parity code
0035                  (            scf.d):00196         PD.BAU              RMB       1                   ACIA baud rate (Color Computer)
0036                  (            scf.d):00197         PD.D2P              RMB       2                   Offset of DEV2 name
0038                  (            scf.d):00198         PD.XON              RMB       1                   ACIA X-ON character
0039                  (            scf.d):00199         PD.XOFF             RMB       1                   ACIA X-OFF character
     001A             (            scf.d):00200         OPTCNT              EQU       .-PD.OPT            Total user settable options
003A                  (            scf.d):00201         PD.ERR              RMB       1                   Most recent I/O error status
003B                  (            scf.d):00202         PD.TBL              RMB       2                   Device table addr (copy)
003D                  (            scf.d):00203         PD.PLP              RMB       2                   Path Descriptor List Pointer
003F                  (            scf.d):00204         PD.PST              RMB       1                   Current path status
                      (            scf.d):00205         
                      (            scf.d):00206         
                      (            scf.d):00207         * PD.PST values Path Descriptor Status byte
                      (            scf.d):00208         *
     0001             (            scf.d):00209         PST.DCD             EQU       %00000001           Set if DCD is lost on Serial port
                      (            scf.d):00210         
                      (            scf.d):00211         
                      (            scf.d):00212         * PD.PAR definitions
                      (            scf.d):00213         *
                      (            scf.d):00214         * Parity
     0000             (            scf.d):00215         PARNONE             EQU       %00000000
     0020             (            scf.d):00216         PARODD              EQU       %00100000
     0060             (            scf.d):00217         PAREVEN             EQU       %01100000
     00A0             (            scf.d):00218         PARMARK             EQU       %10100000
     00E0             (            scf.d):00219         PARSPACE            EQU       %11100000
     00E0             (            scf.d):00220         PARMASK             EQU       %11100000
                      (            scf.d):00221         
                      (            scf.d):00222         * PD.BAU definitions
                      (            scf.d):00223         *
                      (            scf.d):00224         * Baud rate
     0000             (            scf.d):00225         B110                EQU       %00000000
     0001             (            scf.d):00226         B300                EQU       %00000001
     0002             (            scf.d):00227         B600                EQU       %00000010
     0003             (            scf.d):00228         B1200               EQU       %00000011
     0004             (            scf.d):00229         B2400               EQU       %00000100
     0005             (            scf.d):00230         B4800               EQU       %00000101
     0006             (            scf.d):00231         B9600               EQU       %00000110
     0007             (            scf.d):00232         B19200              EQU       %00000111
     0008             (            scf.d):00233         B38400              EQU       %00001000
     0009             (            scf.d):00234         B57600              EQU       %00001001
     000A             (            scf.d):00235         B115200             EQU       %00001010
                      (            scf.d):00236         * Word size
     0000             (            scf.d):00237         WORD8               EQU       %00000000
     0020             (            scf.d):00238         WORD7               EQU       %00100000
                      (            scf.d):00239         * Stop bits
     0000             (            scf.d):00240         STOP1               EQU       %00000000
     0010             (            scf.d):00241         STOP2               EQU       %00010000
                      (            scf.d):00242         
                      (            scf.d):00243                             ENDC
                      (      ../defsfile):00005                  use   rbf.d
                      (            rbf.d):00001                             IFNE      RBF.D-1
                      (            rbf.d):00002         
     0001             (            rbf.d):00003         RBF.D               SET       1
                      (            rbf.d):00004         
                      (            rbf.d):00005         ********************************************************************
                      (            rbf.d):00006         * rbf.d - Random Block File Manager Definitions
                      (            rbf.d):00007         *
                      (            rbf.d):00008         * RBF stands for 'Random Block Filemanager' and is a package of subroutines
                      (            rbf.d):00009         * that define the logical structure of a disk and allows access to the files
                      (            rbf.d):00010         * in that structure.
                      (            rbf.d):00011         *
                      (            rbf.d):00012         * The data structures in this file give RBF its 'personality' and are used
                      (            rbf.d):00013         * by RBF itself, as well as applications that will require disk I/O.
                      (            rbf.d):00014         *
                      (            rbf.d):00015         * Edt/Rev  YYYY/MM/DD  Modified by
                      (            rbf.d):00016         * Comment
                      (            rbf.d):00017         * ------------------------------------------------------------------
                      (            rbf.d):00018         *          1982/07/13  Robert F. Doggett
                      (            rbf.d):00019         * PD.Exten added to path descriptor and PE Entries defined.
                      (            rbf.d):00020         *
                      (            rbf.d):00021         *          1982/07/15  Robert F. Doggett
                      (            rbf.d):00022         * V.FileHd inserted in driver static storage.
                      (            rbf.d):00023         *
                      (            rbf.d):00024         *          1982/09/10  WGP
                      (            rbf.d):00025         * Level One/Level Two condionals added.
                      (            rbf.d):00026         *
                      (            rbf.d):00027         *          1982/09/17  WGP
                      (            rbf.d):00028         *
                      (            rbf.d):00029         *          1982/09/17  Robert F. Doggett
                      (            rbf.d):00030         * PD.SLE renamed to PD.Creat.
                      (            rbf.d):00031         *
                      (            rbf.d):00032         *          1982/09/17  Robert F. Doggett
                      (            rbf.d):00033         * V.DiskID, V.BMapSz, V.MapSct added for smart multi-sector bitmap searching.
                      (            rbf.d):00034         *
                      (            rbf.d):00035         *          1982/09/20  Robert F. Doggett
                      (            rbf.d):00036         * Reserved areas added in static storage.
                      (            rbf.d):00037         
                      (            rbf.d):00038         *          1983/06/07  Robert F. Doggett
                      (            rbf.d):00039         * Added InDriver flag in PD.SMF.
                      (            rbf.d):00040         *
                      (            rbf.d):00041         *          1983/06/13  Robert F. Doggett
                      (            rbf.d):00042         * Added PE.Req tmp save for PE.Lock.
                      (            rbf.d):00043         *
                      (            rbf.d):00044         *          1983/08/08  Robert F. Doggett
                      (            rbf.d):00045         * Reserved PD.SToff for Japanese.
                      (            rbf.d):00046         *
                      (            rbf.d):00047         *          1983/11/19  Robert F. Doggett
                      (            rbf.d):00048         * Added V.ResBit in drive tables.
                      (            rbf.d):00049         *
                      (            rbf.d):00050         *          1983/12/12  Robert F. Doggett
                      (            rbf.d):00051         * Added PE.Prior to save process priority.
                      (            rbf.d):00052         *
                      (            rbf.d):00053         *          1983/12/13  Robert F. Doggett
                      (            rbf.d):00054         * Added BufBusy bit in state flag (PD.SMF).
                      (            rbf.d):00055         *
                      (            rbf.d):00056         *          1984/07/06  Mark G. Hawkins
                      (            rbf.d):00057         * Added Bit Definitions for DD.FMT.
                      (            rbf.d):00058         *
                      (            rbf.d):00059         *          1987/06/23  Kevin K. Darling
                      (            rbf.d):00060         * Updated with Dev Desc Info
                      (            rbf.d):00061         *
                      (            rbf.d):00062         *          2003/06/02  Boisy G. Pitre
                      (            rbf.d):00063         * Updated comments for clarity.
                      (            rbf.d):00064         * Added TYP.256-TYP.2048 definitions for future expansion.
                      (            rbf.d):00065         *
                      (            rbf.d):00066         *          2004/04/14  Boisy G. Pitre
                      (            rbf.d):00067         * Added new entries to device descriptor as per OS-9 Level One V2.00.00
                      (            rbf.d):00068         * addendum.  Pointed out by Rodney Hamilton.
                      (            rbf.d):00069         *
                      (            rbf.d):00070         *              2005/05/31  P.Harvey-Smith.
                      (            rbf.d):00071         * Added defines for bit 2 of IT.DNS, which the format command uses to
                      (            rbf.d):00072         * determine if a drive should have it's track 0 as single or double density
                      (            rbf.d):00073         *
                      (            rbf.d):00074         *          2005/11/23  Robert Gault
                      (            rbf.d):00075         * Added IT.MPI giving it duplicate location with IT.TFM. This will not be
                      (            rbf.d):00076         * transferred to the path descriptor, thus the  equ *  rahter than  rmb 1.
                      (            rbf.d):00077         *
                      (            rbf.d):00078         *          2005/12/11  Boisy G. Pitre
                      (            rbf.d):00079         * Added IT.SOFF1-ITSOFF3 and IT.LLDRV for SuperDrivers.
                      (            rbf.d):00080         
                      (            rbf.d):00081                             NAM       rbf.d
                      (            rbf.d):00082                             TTL       Random              Block File Manager Definitions
                      (            rbf.d):00083         
                      (            rbf.d):00084                             PAG
                      (            rbf.d):00085         *******************************
                      (            rbf.d):00086         * RBF Device Descriptor Offsets
                      (            rbf.d):00087         *
                      (            rbf.d):00088         * These definitions are for RBF device descriptors.
                      (            rbf.d):00089         
                      (            rbf.d):00090                             ORG       M$DTyp
0012                  (            rbf.d):00091                             RMB       1                   Device type (DT.RBF)
0013                  (            rbf.d):00092         IT.DRV              RMB       1                   Drive number
0014                  (            rbf.d):00093         IT.STP              RMB       1                   Step rate
0015                  (            rbf.d):00094         IT.TYP              RMB       1                   Disk device type information
0016                  (            rbf.d):00095         IT.DNS              RMB       1                   Density capability
0017                  (            rbf.d):00096         IT.CYL              RMB       2                   Number of cylinders
0019                  (            rbf.d):00097         IT.SID              RMB       1                   Number of surfaces
001A                  (            rbf.d):00098         IT.VFY              RMB       1                   Verify disk writes (0 = verify, 1 = don't)
001B                  (            rbf.d):00099         IT.SCT              RMB       2                   Default sectors/track
001D                  (            rbf.d):00100         IT.T0S              RMB       2                   Default sectors/track for track 0 sector 0
001F                  (            rbf.d):00101         IT.ILV              RMB       1                   Sector interleave offset
0020                  (            rbf.d):00102         IT.SAS              RMB       1                   Segment allocation size
                      (            rbf.d):00103         * The following fields are from the OS-9 Level One V2.00.00 Addendum
0021                  (            rbf.d):00104         IT.TFM              RMB       1                   DMA Transfer Mode
0022                  (            rbf.d):00105         IT.Exten            RMB       2                   Path Extension (PE) for record locking
0024                  (            rbf.d):00106         IT.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
                      (            rbf.d):00107         * The following fields are not copied to the path descriptor
0025                  (            rbf.d):00108         IT.WPC              RMB       1                   Write precomp cyl/4 (HD)
0026                  (            rbf.d):00109         IT.OFS              RMB       2                   Starting cylinder offset (HD)
0028                  (            rbf.d):00110         IT.RWC              RMB       2                   Reduced write current cylinder (HD)
                      (            rbf.d):00111         * These fields have been added because of SuperDriver.  They probably
                      (            rbf.d):00112         * can be used in other drivers
                      (            rbf.d):00113                             ORG       IT.WPC
0025                  (            rbf.d):00114         IT.SOFF1            RMB       1
0026                  (            rbf.d):00115         IT.SOFF2            RMB       1
0027                  (            rbf.d):00116         IT.SOFF3            RMB       1
0028                  (            rbf.d):00117         IT.LLDRV            RMB       2
002A                  (            rbf.d):00118         IT.MPI              RMB       1
                      (            rbf.d):00119         
                      (            rbf.d):00120         
                      (            rbf.d):00121         * IT.TYP Definitions
                      (            rbf.d):00122         *
     0080             (            rbf.d):00123         TYP.HARD            EQU       %10000000           Hard disk
     0000             (            rbf.d):00124         TYP.FLP             EQU       %00000000           Floppy disk
     0040             (            rbf.d):00125         TYP.NSF             EQU       %01000000           Non-standard format
     0000             (            rbf.d):00126         TYP.SOF             EQU       %00000000           Standard NitrOS-9 format
                      (            rbf.d):00127         
                      (            rbf.d):00128         * IT.TYP bit definitions if bit 7 of IT.TYP is set (hard disk)
     0000             (            rbf.d):00129         TYPH.256            EQU       %00000000           256 byte sector media
     0001             (            rbf.d):00130         TYPH.512            EQU       %00000001           512 byte sector media
     0002             (            rbf.d):00131         TYPH.1024           EQU       %00000010           1024 byte sector media
     0003             (            rbf.d):00132         TYPH.2048           EQU       %00000011           2048 byte sector media
     0003             (            rbf.d):00133         TYPH.SSM            EQU       %00000011           Sector size mask
     000C             (            rbf.d):00134         TYPH.DRSV           EQU       %00001100           Driver-reserved bits
     0010             (            rbf.d):00135         TYPH.DSQ            EQU       %00010000           Drive size query flag
                      (            rbf.d):00136         
                      (            rbf.d):00137         * IT.TYP bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (            rbf.d):00138         TYP.5               EQU       %00000000           5" media
     0001             (            rbf.d):00139         TYP.3               EQU       %00000001           3.5" media
     0002             (            rbf.d):00140         TYP.SBO             EQU       %00000010           Sector base offset (clear = 0; sect = 1)
     0000             (            rbf.d):00141         TYP.256             EQU       %00000000           256 byte sector media
     0004             (            rbf.d):00142         TYP.512             EQU       %00000100           512 byte sector media
     0020             (            rbf.d):00143         TYP.CCF             EQU       %00100000           CoCo format
     0000             (            rbf.d):00144         TYP.NCCF            EQU       %00000000           Non-CoCo format
                      (            rbf.d):00145         
                      (            rbf.d):00146         * IT.DNS Definitions
                      (            rbf.d):00147         *
                      (            rbf.d):00148         
                      (            rbf.d):00149         * If bit 7 of IT.TYP is set, IT.DNS is driver-dependent
                      (            rbf.d):00150         
                      (            rbf.d):00151         * IT.DNS bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (            rbf.d):00152         DNS.FM              EQU       %00000000           Single-density (FM)
     0001             (            rbf.d):00153         DNS.MFM             EQU       %00000001           Double-density (MFM)
     0000             (            rbf.d):00154         DNS.STD             EQU       %00000000           Single track distance (48/135 tpi)
     0002             (            rbf.d):00155         DNS.DTD             EQU       %00000010           Double track distance (96 tpi)
                      (            rbf.d):00156         
                      (            rbf.d):00157         * Added PHS,2005-05-31, as format seems to use these
     0000             (            rbf.d):00158         DNS.FM0             EQU       %00000000           Single density track 0
     0004             (            rbf.d):00159         DNS.MFM0            EQU       %00000100           Double density track 0
                      (            rbf.d):00160         
                      (            rbf.d):00161         * Floppy disk step rate definitions
     0000             (            rbf.d):00162         STP.30ms            EQU       0                   30ms step rate
     0001             (            rbf.d):00163         STP.20ms            EQU       1                   20ms step rate
     0002             (            rbf.d):00164         STP.12ms            EQU       2                   12ms step rate
     0003             (            rbf.d):00165         STP.6ms             EQU       3                   6ms step rate
                      (            rbf.d):00166         
                      (            rbf.d):00167                             PAG
                      (            rbf.d):00168         *************************************
                      (            rbf.d):00169         * Random Block Path Descriptor Format
                      (            rbf.d):00170         *
                      (            rbf.d):00171         * A path descriptor is created for every new path that is open
                      (            rbf.d):00172         * via the I$Open system call (processed by IOMan).  Process
                      (            rbf.d):00173         * descriptors track state information of a path.
                      (            rbf.d):00174         *
                      (            rbf.d):00175                             ORG       PD.FST
000A                  (            rbf.d):00176         PD.SMF              RMB       1                   State flags
000B                  (            rbf.d):00177         PD.CP               RMB       4                   Current logical byte position
000F                  (            rbf.d):00178         PD.SIZ              RMB       4                   File size
0013                  (            rbf.d):00179         PD.SBL              RMB       3                   Segment beginning lsn
0016                  (            rbf.d):00180         PD.SBP              RMB       3                   Segment beginning psn
0019                  (            rbf.d):00181         PD.SSZ              RMB       3                   Segment size
001C                  (            rbf.d):00182         PD.DSK              RMB       2                   Disk id
001E                  (            rbf.d):00183         PD.DTB              RMB       2                   Drive table ptr
                      (            rbf.d):00184                             ORG       PD.OPT
0020                  (            rbf.d):00185                             RMB       1                   Device type
0021                  (            rbf.d):00186         PD.DRV              RMB       1                   Drive number
0022                  (            rbf.d):00187         PD.STP              RMB       1                   Step rate
0023                  (            rbf.d):00188         PD.TYP              RMB       1                   Disk device type (5" 8" other)
0024                  (            rbf.d):00189         PD.DNS              RMB       1                   Density capability
0025                  (            rbf.d):00190         PD.CYL              RMB       2                   Number of cylinders
0027                  (            rbf.d):00191         PD.SID              RMB       1                   Number of surfaces
0028                  (            rbf.d):00192         PD.VFY              RMB       1                   0=verify disk writes
0029                  (            rbf.d):00193         PD.SCT              RMB       2                   Default sectors/track
002B                  (            rbf.d):00194         PD.T0S              RMB       2                   Default sectors/track tr00,s0
002D                  (            rbf.d):00195         PD.ILV              RMB       1                   Sector interleave offset
002E                  (            rbf.d):00196         PD.SAS              RMB       1                   Segment allocation size
002F                  (            rbf.d):00197         PD.TFM              RMB       1                   DMA Transfer Mode
0030                  (            rbf.d):00198         PD.Exten            RMB       2                   Path Extension (PE) for record locking
0032                  (            rbf.d):00199         PD.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
0033                  (            rbf.d):00200         PD.ATT              RMB       1                   File attributes
0034                  (            rbf.d):00201         PD.FD               RMB       3                   File descriptor psn (i.e. 3-byte inode number)
0037                  (            rbf.d):00202         PD.DFD              RMB       3                   Directory file descriptor psn (i.e. 3-byte inode number)
003A                  (            rbf.d):00203         PD.DCP              RMB       4                   File directory entry ptr
003E                  (            rbf.d):00204         PD.DVT              RMB       2                   User readable dev tbl ptr
                      (            rbf.d):00205         
                      (            rbf.d):00206         * State Flags
     0001             (            rbf.d):00207         BUFMOD              EQU       $01                 Buffer modified
     0002             (            rbf.d):00208         SINBUF              EQU       $02                 Sector in buffer
     0004             (            rbf.d):00209         FDBUF               EQU       $04                 File descriptor in buffer
                      (            rbf.d):00210         *EOFSEC equ $08 End of file sector
                      (            rbf.d):00211         *EOF equ $10 End of file
     0020             (            rbf.d):00212         InDriver            EQU       $20                 Currently in Disk Driver, or queued
     0040             (            rbf.d):00213         BufBusy             EQU       $40                 Buffer is currently busy
                      (            rbf.d):00214         
                      (            rbf.d):00215                             IFNE      Level-1
                      (            rbf.d):00216         ************************************
                      (            rbf.d):00217         * Random Block Path Extension Format
                      (            rbf.d):00218         *
                      (            rbf.d):00219         * RBF paths under Level Two have additional information that
                      (            rbf.d):00220         * is referenced by the path extension area.  These are 64-byte
                      (            rbf.d):00221         * allocs from the same table (D.PthDBT) as the Path Descriptors.
                      (            rbf.d):00222         *
                      (            rbf.d):00223                             ORG       0
0000                  (            rbf.d):00224         PE.PE               RMB       1                   PE path number
0001                  (            rbf.d):00225         PE.PDptr            RMB       2                   Back ptr to this PE's Path Descriptor
0003                  (            rbf.d):00226         PE.NxFil            RMB       2                   Drive Open-File list ptr
0005                  (            rbf.d):00227         PE.Confl            RMB       2                   Circular File Conflict list
0007                  (            rbf.d):00228         PE.Lock             RMB       1                   Path lockout status
0008                  (            rbf.d):00229         PE.LoLck            RMB       4                   Low Locked Logical addr
000C                  (            rbf.d):00230         PE.HiLck            RMB       4                   High Locked Logical addr
0010                  (            rbf.d):00231         PE.Wait             RMB       2                   PE ptr to (next) locked-out PE
0012                  (            rbf.d):00232         PE.TmOut            RMB       2                   Max ticks to wait for locked segment
0014                  (            rbf.d):00233         PE.Owner            RMB       1                   Process ID of owner of locked segment
0015                  (            rbf.d):00234         PE.Req              RMB       1                   Temp for PE.Lock in GAIN when LockSeg fails
0016                  (            rbf.d):00235         PE.Prior            RMB       1                   Temp for process priority while in driver
0017                  (            rbf.d):00236         PE.SigSg            RMB       1                   Signal code to send
0018                  (            rbf.d):00237         PE.SigID            RMB       1                   Process ID to send the signal to
0019                  (            rbf.d):00238                             RMB       32-.                Reserved
0020                  (            rbf.d):00239         PE.FilNm            RMB       32                  Temp for filename during directory search
                      (            rbf.d):00240         
                      (            rbf.d):00241         * PE.Lock status codes
     0000             (            rbf.d):00242         Unlocked            EQU       0                   No portion of file is locked
     0001             (            rbf.d):00243         RcdLock             EQU       1                   Record from LoLck to HiLck locked
     0002             (            rbf.d):00244         FileLock            EQU       2                   Entire file locked
     0004             (            rbf.d):00245         EofLock             EQU       4                   End of file is locked
                      (            rbf.d):00246                             ENDC
                      (            rbf.d):00247         
                      (            rbf.d):00248         
                      (            rbf.d):00249                             PAG
                      (            rbf.d):00250         ***********************
                      (            rbf.d):00251         * LSN0 Disk Data Format
                      (            rbf.d):00252         *
                      (            rbf.d):00253         * Logical Sector Number 0 is the first sector on an RBF formatted device
                      (            rbf.d):00254         * and contains information about the device's size and format.
                      (            rbf.d):00255         *
                      (            rbf.d):00256                             ORG       0
0000                  (            rbf.d):00257         DD.TOT              RMB       3                   Total number of sectors
0003                  (            rbf.d):00258         DD.TKS              RMB       1                   Track size in sectors
0004                  (            rbf.d):00259         DD.MAP              RMB       2                   Number of bytes in allocation bit map
0006                  (            rbf.d):00260         DD.BIT              RMB       2                   Number of sectors/bit
0008                  (            rbf.d):00261         DD.DIR              RMB       3                   Address of root directory fd
000B                  (            rbf.d):00262         DD.OWN              RMB       2                   Owner
000D                  (            rbf.d):00263         DD.ATT              RMB       1                   Attributes
000E                  (            rbf.d):00264         DD.DSK              RMB       2                   Disk ID
0010                  (            rbf.d):00265         DD.FMT              RMB       1                   Disk format; density/sides
0011                  (            rbf.d):00266         DD.SPT              RMB       2                   Sectors/track
0013                  (            rbf.d):00267         DD.RES              RMB       2                   Reserved for future use
     0015             (            rbf.d):00268         DD.SIZ              EQU       .                   Device descriptor minimum size
0015                  (            rbf.d):00269         DD.BT               RMB       3                   System bootstrap sector
0018                  (            rbf.d):00270         DD.BSZ              RMB       2                   Size of system bootstrap
001A                  (            rbf.d):00271         DD.DAT              RMB       5                   Creation date
001F                  (            rbf.d):00272         DD.NAM              RMB       32                  Volume name
003F                  (            rbf.d):00273         DD.OPT              RMB       32                  Option area
                      (            rbf.d):00274         
                      (            rbf.d):00275         *************************
                      (            rbf.d):00276         * 2012/11/09 Gene Heskett - Some additions for bootlink etc use.
                      (            rbf.d):00277                             ORG       $60                 More options from device descriptor
0060                  (            rbf.d):00278         VD.STP              RMB       1                   This is for the /sh and /ih virtual disks in HDBDOS
0061                  (            rbf.d):00279         VD.OFS              RMB       3                   This is DT.WPC and DT.OSF combined, might be more
                      (            rbf.d):00280         
                      (            rbf.d):00281         * DD.FMT Bit Definitions - valid only if device is a floppy disk
     0001             (            rbf.d):00282         FMT.SIDE            EQU       %00000001           Single Sided=0, Double Sided=1
     0002             (            rbf.d):00283         FMT.DNS             EQU       %00000010           Single Density=0, Double Density=1
     0004             (            rbf.d):00284         FMT.TDNS            EQU       %00000100           Track Density: 48/135 TPI=0, 96 TPI=1
     0020             (            rbf.d):00285         FMT.T0DN            EQU       %00100000           Track 0 Density, see FMT.DNS
                      (            rbf.d):00286         
                      (            rbf.d):00287         
                      (            rbf.d):00288                             PAG
                      (            rbf.d):00289         ************************
                      (            rbf.d):00290         * File Descriptor Format
                      (            rbf.d):00291         *
                      (            rbf.d):00292         * The file descriptor is a sector that is present for every file
                      (            rbf.d):00293         * on an RBF device.  It contains attributes, modification dates,
                      (            rbf.d):00294         * and segment information on a file.
                      (            rbf.d):00295         *
                      (            rbf.d):00296                             ORG       0
0000                  (            rbf.d):00297         FD.ATT              RMB       1                   Attributes
0001                  (            rbf.d):00298         FD.OWN              RMB       2                   Owner
0003                  (            rbf.d):00299         FD.DAT              RMB       5                   Date last modified
0008                  (            rbf.d):00300         FD.LNK              RMB       1                   Link count
0009                  (            rbf.d):00301         FD.SIZ              RMB       4                   File size
000D                  (            rbf.d):00302         FD.Creat            RMB       3                   File creation date (YY/MM/DD)
     0010             (            rbf.d):00303         FD.SEG              EQU       .                   Beginning of segment list
                      (            rbf.d):00304         * Segment List Entry Format
                      (            rbf.d):00305                             ORG       0
0000                  (            rbf.d):00306         FDSL.A              RMB       3                   Segment beginning physical sector number
0003                  (            rbf.d):00307         FDSL.B              RMB       2                   Segment size
     0005             (            rbf.d):00308         FDSL.S              EQU       .                   Segment list entry size
     00FB             (            rbf.d):00309         FD.LS1              EQU       FD.SEG+((256-FD.SEG)/FDSL.S-1)*FDSL.S
     00FA             (            rbf.d):00310         FD.LS2              EQU       (256/FDSL.S-1)*FDSL.S
     0010             (            rbf.d):00311         MINSEC              SET       16
                      (            rbf.d):00312         
                      (            rbf.d):00313         
                      (            rbf.d):00314                             PAG
                      (            rbf.d):00315         ************************
                      (            rbf.d):00316         * Directory Entry Format
                      (            rbf.d):00317         *
                      (            rbf.d):00318         * Directory entries are part of a directory and define the name
                      (            rbf.d):00319         * of the file, as well as a pointer to its file descriptor.
                      (            rbf.d):00320         *
                      (            rbf.d):00321                             ORG       0
0000                  (            rbf.d):00322         DIR.NM              RMB       29                  File name
001D                  (            rbf.d):00323         DIR.FD              RMB       3                   File descriptor physical sector number
     0020             (            rbf.d):00324         DIR.SZ              EQU       .                   Directory record size
                      (            rbf.d):00325         
                      (            rbf.d):00326         
                      (            rbf.d):00327                             PAG
                      (            rbf.d):00328         ********************
                      (            rbf.d):00329         * RBF Static Storage
                      (            rbf.d):00330         *
                      (            rbf.d):00331         * Overall Disk Static Storage
                      (            rbf.d):00332         *
                      (            rbf.d):00333         * Note:  This does not reserve any memory for drive tables.  Each
                      (            rbf.d):00334         *        driver is responsible for reserving sufficient memory for
                      (            rbf.d):00335         *        the appropriate number of tables.
                      (            rbf.d):00336         *
                      (            rbf.d):00337                             ORG       V.USER              Reserve required           ($06)
0006                  (            rbf.d):00338         V.NDRV              RMB       1                   Number of drives           ($07)
0007                  (            rbf.d):00339                             RMB       8                   reserved                   ($08)
     000F             (            rbf.d):00340         DRVBEG              EQU       .                   Beginning of drive tables  ($10)
                      (            rbf.d):00341         
                      (            rbf.d):00342         
                      (            rbf.d):00343                             PAG
                      (            rbf.d):00344         ****************
                      (            rbf.d):00345         * Global Storage For Disk Drive Tables
                      (            rbf.d):00346         *
                      (            rbf.d):00347         * Each table contains the first 'DD.SIZ' bytes from
                      (            rbf.d):00348         * LSN 0, and the current track, stepping rate,
                      (            rbf.d):00349         * bitmap use flag, and disk type.
                      (            rbf.d):00350         *
                      (            rbf.d):00351                             ORG       0
0000                  (            rbf.d):00352                             RMB       DD.SIZ              Device descriptor, LSN 0
0015                  (            rbf.d):00353         V.TRAK              RMB       2                   Current track
0017                  (            rbf.d):00354         V.BMB               RMB       1                   Bit-map use flag
0018                  (            rbf.d):00355         V.FileHd            RMB       2                   Open file list for this drive
001A                  (            rbf.d):00356         V.DiskID            RMB       2                   Disk ID
001C                  (            rbf.d):00357         V.BMapSz            RMB       1                   Bitmap Size
001D                  (            rbf.d):00358         V.MapSct            RMB       1                   Lowest reasonable bitmap sector
001E                  (            rbf.d):00359         V.ResBit            RMB       1                   Reserved bitmap sector (for compaction)
001F                  (            rbf.d):00360         V.ScTkOf            RMB       1                   Sector/Track byte (Combined from descriptor)
0020                  (            rbf.d):00361         V.ScOfst            RMB       1                   Sector offset split from byte above
0021                  (            rbf.d):00362         V.TkOfst            RMB       1                   Track offset split from byte above
0022                  (            rbf.d):00363                             RMB       4                   Reserved
     0026             (            rbf.d):00364         DRVMEM              EQU       .
                      (            rbf.d):00365         
                      (            rbf.d):00366                             ENDC
                      (            rbf.d):00367         
                      (      ../defsfile):00006                  use   coco.d
                      (           coco.d):00001                             IFNE      COCO.D-1
     0001             (           coco.d):00002         COCO.D              SET       1
                      (           coco.d):00003         
                      (           coco.d):00004         ********************************************************************
                      (           coco.d):00005         * CoCoDefs - NitrOS-9 System Definitions for the Tandy Color Computer
                      (           coco.d):00006         *
                      (           coco.d):00007         * Edt/Rev  YYYY/MM/DD  Modified by
                      (           coco.d):00008         * Comment
                      (           coco.d):00009         * ------------------------------------------------------------------
                      (           coco.d):00010         *          1998/10/13  Boisy G. Pitre
                      (           coco.d):00011         * Added defs by Bruce Isted from his Eliminator archive.
                      (           coco.d):00012         *
                      (           coco.d):00013         *          1998/10/31  Boisy G. Pitre
                      (           coco.d):00014         * Merged cc3global.defs into this file.
                      (           coco.d):00015         *
                      (           coco.d):00016         *          2002/04/30  Boisy G. Pitre
                      (           coco.d):00017         * Merged Level One and Level Two sysdefs.
                      (           coco.d):00018         *
                      (           coco.d):00019         *          2002/06/22  Boisy G. Pitre
                      (           coco.d):00020         * Removed PIA.U4 and PIA.U8, improved comments
                      (           coco.d):00021         *
                      (           coco.d):00022         *          2003/11/05  Robert Gault
                      (           coco.d):00023         * Made changes in window globals and grfdrv memory to handle regW
                      (           coco.d):00024         * in 6809 systems.
                      (           coco.d):00025         *
                      (           coco.d):00026         *          2003/11/30  Boisy G. Pitre
                      (           coco.d):00027         * Statics now are prefaced with V. to identify them easier in source.
                      (           coco.d):00028         *
                      (           coco.d):00029         *          2004/07/18  Boisy G. Pitre
                      (           coco.d):00030         * Moved CoCo 3 Window stuff into cc3iodefs
                      (           coco.d):00031         *
                      (           coco.d):00032         *          2012/02/24  Boisy G. Pitre
                      (           coco.d):00033         * Consolidated all CoCo-specific defs files into here.
                      (           coco.d):00034         
                      (           coco.d):00035                             NAM       CoCoDefs
                      (           coco.d):00036                             IFEQ      Level-1
                      (           coco.d):00037                             TTL       NitrOS-9            System Definitions for the Tandy Color Computer
                      (           coco.d):00038                             ELSE
                      (           coco.d):00039                             IFEQ      Level-2
                      (           coco.d):00040                             TTL       NitrOS-9            Level 2 System Type Definitions
                      (           coco.d):00041                             ELSE
                      (           coco.d):00042                             IFEQ      Level-3
                      (           coco.d):00043                             TTL       NitrOS-9            Level 3 System Type Definitions
                      (           coco.d):00044                             ENDC
                      (           coco.d):00045                             ENDC
                      (           coco.d):00046                             ENDC
                      (           coco.d):00047         
                      (           coco.d):00048         
                      (           coco.d):00049         **********************
                      (           coco.d):00050         * CPU Type Definitions
                      (           coco.d):00051         *
     0001             (           coco.d):00052         Color               SET       1
     0002             (           coco.d):00053         Color3              SET       2
                      (           coco.d):00054                             IFEQ      Level-1
0026                  (           coco.d):00055         CPUType             SET       Color
                      (           coco.d):00056                             ELSE
     0002             (           coco.d):00057         CPUType             SET       Color3
                      (           coco.d):00058                             ENDC
                      (           coco.d):00059         
                      (           coco.d):00060         
                      (           coco.d):00061         ******************************
                      (           coco.d):00062         * Clock Speed Type Definitions
                      (           coco.d):00063         *
     0001             (           coco.d):00064         OneMHz              EQU       1
     0002             (           coco.d):00065         TwoMHz              EQU       2
                      (           coco.d):00066                             IFEQ      CPUType-Color
0026                  (           coco.d):00067         CPUSpeed            SET       OneMHz
                      (           coco.d):00068                             ELSE
     0002             (           coco.d):00069         CPUSpeed            SET       TwoMHz
                      (           coco.d):00070                             ENDC
                      (           coco.d):00071         
                      (           coco.d):00072         
                      (           coco.d):00073         **********************************
                      (           coco.d):00074         * Power Line Frequency Definitions
                      (           coco.d):00075         *
     0032             (           coco.d):00076         Hz50                EQU       50                  Assemble clock for 50 hz power
     003C             (           coco.d):00077         Hz60                EQU       60                  Assemble clock for 60 hz power
                      (           coco.d):00078                             IFNDEF    PwrLnFrq
     003C             (           coco.d):00079         PwrLnFrq            SET       Hz60                Set to Appropriate freq
                      (           coco.d):00080                             ENDC
                      (           coco.d):00081         
                      (           coco.d):00082         
                      (           coco.d):00083         **********************************
                      (           coco.d):00084         * Ticks per second
                      (           coco.d):00085         *
                      (           coco.d):00086                             IFNDEF    TkPerSec
                      (           coco.d):00087                             IFEQ      PwrLnFrq-Hz50
0026                  (           coco.d):00088         TkPerSec            SET       50
                      (           coco.d):00089                             ELSE
     003C             (           coco.d):00090         TkPerSec            SET       60
                      (           coco.d):00091                             ENDC
                      (           coco.d):00092                             ENDC
                      (           coco.d):00093         
                      (           coco.d):00094         
                      (           coco.d):00095         ******************
                      (           coco.d):00096         * ACIA type set up
                      (           coco.d):00097         *
                      (           coco.d):00098                             ORG       1
0001                  (           coco.d):00099         ACIA6850            RMB       1                   MC6850 acia.
0002                  (           coco.d):00100         ACIA6551            RMB       1                   SY6551 acia.
0003                  (           coco.d):00101         ACIA2661            RMB       1                   SC2661 acia.
     0002             (           coco.d):00102         ACIATYPE            SET       ACIA6551
                      (           coco.d):00103         
                      (           coco.d):00104         
                      (           coco.d):00105         ****************************************
                      (           coco.d):00106         * Special character Bit position equates
                      (           coco.d):00107         *
     0001             (           coco.d):00108         SHIFTBIT            EQU       %00000001
     0002             (           coco.d):00109         CNTRLBIT            EQU       %00000010
     0004             (           coco.d):00110         ALTERBIT            EQU       %00000100
     0008             (           coco.d):00111         UPBIT               EQU       %00001000
     0010             (           coco.d):00112         DOWNBIT             EQU       %00010000
     0020             (           coco.d):00113         LEFTBIT             EQU       %00100000
     0040             (           coco.d):00114         RIGHTBIT            EQU       %01000000
     0080             (           coco.d):00115         SPACEBIT            EQU       %10000000
                      (           coco.d):00116         
                      (           coco.d):00117         
                      (           coco.d):00118         ******************
                      (           coco.d):00119         * Device addresses for miscellaneous hardware
                      (           coco.d):00120         *
     FF68             (           coco.d):00121         A.AciaP             SET       $FF68               Aciapak Address
     FF6C             (           coco.d):00122         A.ModP              SET       $FF6C               ModPak Address
     FF40             (           coco.d):00123         DPort               SET       $FF40               Disk controller base address
     FF7F             (           coco.d):00124         MPI.Slct            SET       $FF7F               Multi-Pak slot select
     0003             (           coco.d):00125         MPI.Slot            SET       $03                 Multi-Pak default slot
     FF00             (           coco.d):00126         PIA0Base            EQU       $FF00
     FF20             (           coco.d):00127         PIA1Base            EQU       $FF20
                      (           coco.d):00128         
                      (           coco.d):00129         
                      (           coco.d):00130         ******************
                      (           coco.d):00131         * VDG Devices
                      (           coco.d):00132         *
     FFC0             (           coco.d):00133         A.TermV             SET       $FFC0               VDG Term
     FFC1             (           coco.d):00134         A.V1                SET       $FFC1               Possible additional VDG Devices
     FFC2             (           coco.d):00135         A.V2                SET       $FFC2
     FFC3             (           coco.d):00136         A.V3                SET       $FFC3
     FFC4             (           coco.d):00137         A.V4                SET       $FFC4
     FFC5             (           coco.d):00138         A.V5                SET       $FFC5
     FFC6             (           coco.d):00139         A.V6                SET       $FFC6
     FFC7             (           coco.d):00140         A.V7                SET       $FFC7
                      (           coco.d):00141         
                      (           coco.d):00142         
                      (           coco.d):00143                             IFEQ      Level-1
                      (           coco.d):00144         
                      (           coco.d):00145         ********************************
                      (           coco.d):00146         * Boot defs for NitrOS-9 Level 1
                      (           coco.d):00147         *
                      (           coco.d):00148         * These defs are not strictly for 'Boot', but are for booting the
                      (           coco.d):00149         * system.
                      (           coco.d):00150         *
0004                  (           coco.d):00151         Bt.Start            EQU       $EE00               Start address of the boot track in memory
                      (           coco.d):00152         
                      (           coco.d):00153                             ELSE
                      (           coco.d):00154         
                      (           coco.d):00155         ******************************************
                      (           coco.d):00156         * Boot defs for NitrOS-9 Level 2 and above
                      (           coco.d):00157         *
                      (           coco.d):00158         * These defs are not strictly for 'Boot', but are for booting the
                      (           coco.d):00159         * system.
                      (           coco.d):00160         *
     ED00             (           coco.d):00161         Bt.Start            SET       $ED00               Start address of the boot track in memory
     003B             (           coco.d):00162         Bt.Block            EQU       $3B                 Block to map in for the 'OS9BOOT' screen
     8A34             (           coco.d):00163         Bt.Flag             EQU       $8A34               Flag in Bt.Block to verify that it's unchanged
     0002             (           coco.d):00164         Bt.Offst            EQU       2                   Offset into the screen where the current ptr is
                      (           coco.d):00165         
                      (           coco.d):00166                             ENDC
                      (           coco.d):00167         
                      (           coco.d):00168         * On the CoCo, the boot track is all of track 34
                      (           coco.d):00169         
     0022             (           coco.d):00170         Bt.Track            EQU       34                  Boot track
     0000             (           coco.d):00171         Bt.Sec              EQU       0                   Start LSN of boot area on boot track
                      (           coco.d):00172         
                      (           coco.d):00173         
     1080             (           coco.d):00174         Bt.Size             EQU       $1080               Maximum size of bootfile
                      (           coco.d):00175         
                      (           coco.d):00176         
                      (           coco.d):00177                             IFEQ      Level-1
                      (           coco.d):00178         
                      (           coco.d):00179         *************************************************
                      (           coco.d):00180         *
                      (           coco.d):00181         * NitrOS-9 Level 1 Section
                      (           coco.d):00182         *
                      (           coco.d):00183         *************************************************
                      (           coco.d):00184         
0004                  (           coco.d):00185         HW.Page             SET       $FF                 Device descriptor hardware page
                      (           coco.d):00186         
                      (           coco.d):00187                             ELSE
                      (           coco.d):00188         
                      (           coco.d):00189         *************************************************
                      (           coco.d):00190         *
                      (           coco.d):00191         * NitrOS-9 Level 2 Section
                      (           coco.d):00192         *
                      (           coco.d):00193         *************************************************
                      (           coco.d):00194         
                      (           coco.d):00195         ****************************************
                      (           coco.d):00196         * Dynamic Address Translator Definitions
                      (           coco.d):00197         *
     0008             (           coco.d):00198         DAT.BlCt            EQU       8                   D.A.T. blocks/address space
     2000             (           coco.d):00199         DAT.BlSz            EQU       (256/DAT.BlCt)*256  D.A.T. block size
     0010             (           coco.d):00200         DAT.ImSz            EQU       DAT.BlCt*2          D.A.T. Image size
     FFE0             (           coco.d):00201         DAT.Addr            EQU       -(DAT.BlSz/256)     D.A.T. MSB Address bits
     FF91             (           coco.d):00202         DAT.Task            EQU       $FF91               Task Register address
     0020             (           coco.d):00203         DAT.TkCt            EQU       32                  Number of DAT Tasks
     FFA0             (           coco.d):00204         DAT.Regs            EQU       $FFA0               DAT Block Registers base address
     333E             (           coco.d):00205         DAT.Free            EQU       $333E               Free Block Number
     003F             (           coco.d):00206         DAT.BlMx            EQU       $3F                 Maximum Block number
     0040             (           coco.d):00207         DAT.BMSz            EQU       $40                 Memory Block Map size
     0000             (           coco.d):00208         DAT.WrPr            EQU       0                   no write protect
     0000             (           coco.d):00209         DAT.WrEn            EQU       0                   no write enable
     0000             (           coco.d):00210         SysTask             EQU       0                   Coco System Task number
     003F             (           coco.d):00211         IOBlock             EQU       $3F
     003F             (           coco.d):00212         ROMBlock            EQU       $3F
     007F             (           coco.d):00213         IOAddr              EQU       $7F
     0001             (           coco.d):00214         ROMCount            EQU       1                   number of blocks of ROM (High RAM Block)
     0001             (           coco.d):00215         RAMCount            EQU       1                   initial blocks of RAM
     0005             (           coco.d):00216         MoveBlks            EQU       DAT.BlCt-ROMCount-2 Block numbers used for copies
     0001             (           coco.d):00217         BlockTyp            EQU       1                   chk only first bytes of RAM block
     0002             (           coco.d):00218         ByteType            EQU       2                   chk entire block of RAM
     0001             (           coco.d):00219         Limited             EQU       1                   chk only upper memory for ROM modules
     0002             (           coco.d):00220         UnLimitd            EQU       2                   chk all NotRAM for modules
                      (           coco.d):00221         * NOTE: this check assumes any NotRAM with a module will
                      (           coco.d):00222         *       always start with $87CD in first two bytes of block
     0001             (           coco.d):00223         RAMCheck            EQU       BlockTyp            chk only beg bytes of block
     0001             (           coco.d):00224         ROMCheck            EQU       Limited             chk only upper few blocks for ROM
     003F             (           coco.d):00225         LastRAM             EQU       IOBlock             maximum RAM block number
                      (           coco.d):00226         
                      (           coco.d):00227         ***************************
                      (           coco.d):00228         * Color Computer 3 Specific
                      (           coco.d):00229         *
     0001             (           coco.d):00230         MappedIO            EQU       true                (Actually False but it works better this way)
                      (           coco.d):00231         
                      (           coco.d):00232         ********************
                      (           coco.d):00233         * Hardware addresses
                      (           coco.d):00234         *
     FF00             (           coco.d):00235         GIMERegs            EQU       $FF00               Base address of GIME registers
     FF92             (           coco.d):00236         IrqEnR              EQU       $FF92               GIME IRQ enable/status register
     FF9A             (           coco.d):00237         BordReg             EQU       $FF9A               Border color register
     FFB0             (           coco.d):00238         PalAdr              EQU       $FFB0               Palette registers
                      (           coco.d):00239         
     0007             (           coco.d):00240         HW.Page             SET       $07                 Device descriptor hardware page
                      (           coco.d):00241         
                      (           coco.d):00242         * KrnBlk defines the block number of the 8K RAM block that is mapped to
                      (           coco.d):00243         * the top of CPU address space ($E000-$FFFF) for the system process, and
                      (           coco.d):00244         * which holds the Kernel. The top 2 pages of this CPU address space ($FFE0-
                      (           coco.d):00245         * $FFFF) has two special properties. Firstly, it contains the I/O space.
                      (           coco.d):00246         * Secondly, the parts that contain RAM map are not affected by the DAT
                      (           coco.d):00247         * mappings but, instead, *always* map that RAM to a fixed RAM block
                      (           coco.d):00248         * (KrnBlk). When a user process is mapped in, and requests enough memory,
                      (           coco.d):00249         * it will end up with its own block assigned for CPU address space $E000-
                      (           coco.d):00250         * $FFFF but the top of the address space is unusable by the user process:
                      (           coco.d):00251         * it still contains the I/O and the bit of RAM that's mapped to KrnBlk.
                      (           coco.d):00252         * Usually, the value of KrnBlk is fixed for a particular hardware design;
                      (           coco.d):00253         * For the COCO GIME, it's always $3F.
     003F             (           coco.d):00254         KrnBlk              SET       $3F
                      (           coco.d):00255         
                      (           coco.d):00256                             ENDC
                      (           coco.d):00257                             ENDC
                      (           coco.d):00258         
                      (1/cmds/minted.asm):00015                             endc
