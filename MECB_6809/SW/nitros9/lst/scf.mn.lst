                      (1/modules/scf.asm):00222         * Default input buffer setting for SCF devices when Opened/Created
                      (1/modules/scf.asm):00223         *               123456789!123456789!1234567890
                      (1/modules/scf.asm):00224         *msg      fcc   'by B.Nobel,C.Boyle,W.Gale-1993'
0011 7777772E6E697472 (1/modules/scf.asm):00225         msg                 fcc       'www.nitros9.org'
     6F73392E6F7267
     000F             (1/modules/scf.asm):00226         msgsize             equ       *-msg               Size of default input buffer message
0020 0D               (1/modules/scf.asm):00227                             fcb       C$CR                2nd CR for buffer pad fill
     00F1             (1/modules/scf.asm):00228         blksize             equ       256-msgsize         Size of blank space after it
                      (1/modules/scf.asm):00229         
                      (1/modules/scf.asm):00230         * Return bad pathname error
0021 3520             (1/modules/scf.asm):00231         opbpnam             puls      y
0023 53               (1/modules/scf.asm):00232         bpnam               comb                          Set carry for error
0024 C6D7             (1/modules/scf.asm):00233                             ldb       #E$BPNam            Get error code
0026 39               (1/modules/scf.asm):00234         oerr                rts                           Return to caller
                      (1/modules/scf.asm):00235         
                      (1/modules/scf.asm):00236         * I$Create/I$Open entry point
                      (1/modules/scf.asm):00237         * Entry: Y= Path dsc. ptr
0027 AE23             (1/modules/scf.asm):00238         open                ldx       PD.DEV,y            Get device table pointer
0029 AFA83B           (1/modules/scf.asm):00239                             stx       PD.TBL,y            Save it
002C EE26             (1/modules/scf.asm):00240                             ldu       PD.RGS,y            Get callers register stack pointer
002E 3420             (1/modules/scf.asm):00241                             pshs      y                   Save path descriptor pointer
0030 AE44             (1/modules/scf.asm):00242                             ldx       R$X,u               Get pointer to device pathname
0032 103F10           (1/modules/scf.asm):00243                             os9       F$PrsNam            Parse it
0035 25EA             (1/modules/scf.asm):00244                             bcs       opbpnam             Error, exit
0037 4D               (1/modules/scf.asm):00245                             tsta                          End of pathname?
0038 2B07             (1/modules/scf.asm):00246                             bmi       open1               Yes, go on
003A 30A4             (1/modules/scf.asm):00247                             leax      ,y                  Point to actual device name
003C 103F10           (1/modules/scf.asm):00248                             os9       F$PrsNam            Parse it again
003F 24E0             (1/modules/scf.asm):00249                             bcc       opbpnam             Return to caller with bad path name if more
0041 10AF44           (1/modules/scf.asm):00250         open1               sty       R$X,u               Save updated name pointer to caller
0044 3520             (1/modules/scf.asm):00251                             puls      y                   Restore path descriptor pointer
0046 CC0100           (1/modules/scf.asm):00252                             ldd       #256                Get size of input buffer in bytes
0049 103F28           (1/modules/scf.asm):00253                             os9       F$SRqMem            Allocate it
004C 25D8             (1/modules/scf.asm):00254                             bcs       oerr                Can't allocate it return with error
004E EF28             (1/modules/scf.asm):00255                             stu       PD.BUF,y            Save buffer address to path descriptor
0050 308CBE           (1/modules/scf.asm):00256                             leax      <msg,pc             Get ptr to init string
                      (1/modules/scf.asm):00257                             IFNE      H6309
                      (1/modules/scf.asm):00258                             ldw       #msgsize            get size of default message
                      (1/modules/scf.asm):00259                             tfm       x+,u+               Copy it into buffer (leaves X pointing to 2nd CR)
                      (1/modules/scf.asm):00260                             ldw       #blksize            Size of rest of buffer
                      (1/modules/scf.asm):00261                             tfm       x,u+                Fill rest of buffer with CR's
                      (1/modules/scf.asm):00262                             ELSE
