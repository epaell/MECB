                      (      to_lower.as):00003         ;;; Convert a character to lowercase.
                      (      to_lower.as):00004         ;;;
                      (      to_lower.as):00005         ;;; Other modules needed: IS_UPPER
                      (      to_lower.as):00006         ;;;
                      (      to_lower.as):00007         ;;; Entry:  B = The character to convert to lowercase
                      (      to_lower.as):00008         ;;;
                      (      to_lower.as):00009         ;;; Exit:   B = The lowercase version of the character.
                      (      to_lower.as):00010         ;;;
                      (      to_lower.as):00011         ;;; All registers are preserved.
                      (      to_lower.as):00012         
