0000 3401             (      to_lower.as):00015         TO_LOWER:           pshs      cc
0002 170000           (      to_lower.as):00016                             lbsr      IS_UPPER            only uppercase can be converted
0005 2602             (      to_lower.as):00017                             bne       tolox               no upper, exit
0007 CB20             (      to_lower.as):00018                             addb      #$20                make lowercase
