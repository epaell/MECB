                      (            scf.d):00160         *********************************************
                      (            scf.d):00161         * Sequential Character Path Descriptor Format
                      (            scf.d):00162         *
                      (            scf.d):00163         * A path descriptor is created for every new path that is open
                      (            scf.d):00164         * via the I$Open system call (processed by IOMan).  Process
                      (            scf.d):00165         * descriptors track state information of a path.
                      (            scf.d):00166         *
                      (            scf.d):00167                             ORG       PD.FST
FFFF                  (            scf.d):00168         PD.DV2              RMB       2                   Output device table pointer
FFFF                  (            scf.d):00169         PD.RAW              RMB       1                   Read/Write or ReadLn/WritLn mode
FFFF                  (            scf.d):00170         PD.MAX              RMB       2                   ReadLn high byte count
FFFF                  (            scf.d):00171         PD.MIN              RMB       1                   Devices are "mine" if clear
FFFF                  (            scf.d):00172         PD.STS              RMB       2                   Status routine module addr
FFFF                  (            scf.d):00173         PD.STM              RMB       2                   Reserved for status routine
                      (            scf.d):00174                             ORG       PD.OPT
FFFF                  (            scf.d):00175                             RMB       1                   Device type
FFFF                  (            scf.d):00176         PD.UPC              RMB       1                   Case (0=both, 1=upper only)
FFFF                  (            scf.d):00177         PD.BSO              RMB       1                   Backspace (0=BSE, 1=BSE,SP,BSE)
FFFF                  (            scf.d):00178         PD.DLO              RMB       1                   Delete (0=BSE over line, 1=CRLF)
FFFF                  (            scf.d):00179         PD.EKO              RMB       1                   Echo (0=No Echo)
FFFF                  (            scf.d):00180         PD.ALF              RMB       1                   Auto linefeed (0=No auto LF)
FFFF                  (            scf.d):00181         PD.NUL              RMB       1                   End of Line null count
FFFF                  (            scf.d):00182         PD.PAU              RMB       1                   Page pause (0=No end of page pause)
FFFF                  (            scf.d):00183         PD.PAG              RMB       1                   Lines per page
FFFF                  (            scf.d):00184         PD.BSP              RMB       1                   Backspace character
FFFF                  (            scf.d):00185         PD.DEL              RMB       1                   Delete Line character
FFFF                  (            scf.d):00186         PD.EOR              RMB       1                   End of Record character (read only)
FFFF                  (            scf.d):00187         PD.EOF              RMB       1                   End of File character
FFFF                  (            scf.d):00188         PD.RPR              RMB       1                   Repront Line character
FFFF                  (            scf.d):00189         PD.DUP              RMB       1                   Dup Last Line character
FFFF                  (            scf.d):00190         PD.PSC              RMB       1                   Pause character
FFFF                  (            scf.d):00191         PD.INT              RMB       1                   Keyboard interrupt character (CTRL-C)
FFFF                  (            scf.d):00192         PD.QUT              RMB       1                   Keyboard quit character (CTRL-E)
FFFF                  (            scf.d):00193         PD.BSE              RMB       1                   Backspace echo character
FFFF                  (            scf.d):00194         PD.OVF              RMB       1                   Line overflow character (BELL)
FFFF                  (            scf.d):00195         PD.PAR              RMB       1                   Parity code
FFFF                  (            scf.d):00196         PD.BAU              RMB       1                   ACIA baud rate (Color Computer)
FFFF                  (            scf.d):00197         PD.D2P              RMB       2                   Offset of DEV2 name
FFFF                  (            scf.d):00198         PD.XON              RMB       1                   ACIA X-ON character
FFFF                  (            scf.d):00199         PD.XOFF             RMB       1                   ACIA X-OFF character
     001A             (            scf.d):00200         OPTCNT              EQU       .-PD.OPT            Total user settable options
FFFF                  (            scf.d):00201         PD.ERR              RMB       1                   Most recent I/O error status
FFFF                  (            scf.d):00202         PD.TBL              RMB       2                   Device table addr (copy)
FFFF                  (            scf.d):00203         PD.PLP              RMB       2                   Path Descriptor List Pointer
FFFF                  (            scf.d):00204         PD.PST              RMB       1                   Current path status
