                      (            os9.d):01078         
                      (            os9.d):01079         *******************************
                      (            os9.d):01080         * Device Static Storage Offsets
                      (            os9.d):01081         *
                      (            os9.d):01082                             ORG       0
0000                  (            os9.d):01083         V.PAGE              RMB       1                   Port Extended Address
0001                  (            os9.d):01084         V.PORT              RMB       2                   Device 'Base' Port Address
0003                  (            os9.d):01085         V.LPRC              RMB       1                   Last Active Process ID
0004                  (            os9.d):01086         V.BUSY              RMB       1                   Active Process ID (0=UnBusy)
