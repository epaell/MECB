                      (      basic09.asm):00280         * Embedded L3C2C (JSR <u0024/fcb 6 (error handler)) @ L3DD5,CMPTRU,
                      (      basic09.asm):00281         *            L3F2E,L44C2,L458C,FPOVRF,L4FC7) Moved it to just after L40CC.
                      (      basic09.asm):00282         * Changed LDB #0 @ L4409 to CLRB (part of Boolean routines)
                      (      basic09.asm):00283         * Changed LDB #0 @ L5046 to CLRB
                      (      basic09.asm):00284         * Removed L3C2F (dupe of L011F), changed LBSR's @ L471F & STRF10 to
                      (      basic09.asm):00285         *            it
                      (      basic09.asm):00286         * Moved L3C32 to after INIT1 (shorten LEAX)
                      (      basic09.asm):00287         *
                      (      basic09.asm):00288         *  V1.21   1995/03/01  NitrOS-9 Project
                      (      basic09.asm):00289         * Modified Integer Multiply to use MULD @ INML25
                      (      basic09.asm):00290         *
                      (      basic09.asm):00291         *  V1.21   1995/03/10  NitrOS-9 Project
                      (      basic09.asm):00292         * Modified Negate of REAL #'s to use EIM @ NEGRL (saves 4 cyc)
                      (      basic09.asm):00293         * Changed L3FBB (Real add with dest var=0) to use LDQ/STQ (saves
                      (      basic09.asm):00294         *            6 cyc)
                      (      basic09.asm):00295         *
                      (      basic09.asm):00296         *  V1.21   1995/03/13  NitrOS-9 Project
                      (      basic09.asm):00297         * Changed NEGA/NEGB/SBCA #0 to NEGD @ FLOAT1 & FIX4A
                      (      basic09.asm):00298         * Changed BPL L451E to BPL L451F @ FLOAT1 (eliminates 2nd useless
                      (      basic09.asm):00299         *            TSTA)
                      (      basic09.asm):00300         *
                      (      basic09.asm):00301         *  V1.21   1995/03/15  NitrOS-9 Project
                      (      basic09.asm):00302         * Changed LDB $B,y/ANDB #$FE/STB $B,y & LDB 5,y/ANDB #$FE/STB $B,y
                      (      basic09.asm):00303         *            to AIM's @ L3FE5 (Real Add & Subtract)
                      (      basic09.asm):00304         * Changed ADCB 3,y/ADCA 2,y to ADCD 2,y @ L4039 (Real Add/Subtact)
                      (      basic09.asm):00305         * Changed SBCB 3,y/SBCA 2,y TO SBCD 2,y @ L400B (Real Add/Subtact)
                      (      basic09.asm):00306         * Changed LDA 5,y/ANDA #$FE/STA 5,y to AIM #$FE,5,y @ ABSFNR (ABS
                      (      basic09.asm):00307         *            for real #'s
                      (      basic09.asm):00308         * Changed NEGA/NEGB/SBCA #0 to NEGD @ L45B5 (ABS for Integers)
                      (      basic09.asm):00309         * Ditched special checks for 0 or 2 in Integer Multiply (INMUL),
                      (      basic09.asm):00310         *            since overhead from checks is as slow or slower as straight MULD
                      (      basic09.asm):00311         *            except in dest. var=0's case
                      (      basic09.asm):00312         *
                      (      basic09.asm):00313         *  V1.21   1995/03/16  NitrOS-9 Project
                      (      basic09.asm):00314         * Changed 2 LDD/STD's @ L3F93 to LDQ/STQ
                      (      basic09.asm):00315         *
                      (      basic09.asm):00316         *  V1.21   1995/03/18  NitrOS-9 Project
                      (      basic09.asm):00317         * Changed Integer Divide (and MOD) routines to use DIVQ
                      (      basic09.asm):00318         *
                      (      basic09.asm):00319         *  V1.21   1995/03/20  NitrOS-9 Project
                      (      basic09.asm):00320         * Changed L3F7C (copy Real # to temp var from inc'd X) to use
                      (      basic09.asm):00321         *            LDQ/STQ/LDB #4/ABX
                      (      basic09.asm):00322         * Moved Integer MOD routine (INDV10) to nearer divide (changes LBSR
                      (      basic09.asm):00323         *            to BSR)
                      (      basic09.asm):00324         *
                      (      basic09.asm):00325         *  V1.21   1995/04/23  NitrOS-9 Project
                      (      basic09.asm):00326         * Changed Real Add/Subtract mantissa shift (L4082-L40C9) to use
                      (      basic09.asm):00327         *            <u0014 (unused in BASIC09) to hold shift count instead of stack
                      (      basic09.asm):00328         *            (saves 2 cyc for STA vs. PSHS, saves 1 cyc per DEC, & saves 5 cyc
                      (      basic09.asm):00329         *            by eliminating LEAS 1,s) (6809)
                      (      basic09.asm):00330         *
                      (      basic09.asm):00331         *  V1.21   1995/04/26  NitrOS-9 Project
                      (      basic09.asm):00332         * Split real add/subtract out & made two versions: 6809 & 6309
                      (      basic09.asm):00333         *
                      (      basic09.asm):00334         *  V1.21   1995/06/09  NitrOS-9 Project
                      (      basic09.asm):00335         * Modified 6309 REAL add/subtract routine - now 13-15% faster
                      (      basic09.asm):00336         *
                      (      basic09.asm):00337         *  V1.21   1995/06/20  NitrOS-9 Project
                      (      basic09.asm):00338         * Took out useless LDB 2,s @ L412D (Real Multiply)
                      (      basic09.asm):00339         *
                      (      basic09.asm):00340         *  V1.21   1995/07/18  NitrOS-9 Project
                      (      basic09.asm):00341         * Changed sign fix in Real Add @ L4071 to use TFR w,d/lsrb/lslb/orb
                      (      basic09.asm):00342         *            ,y/std $a,y
                      (      basic09.asm):00343         * Split real multiply out & made two versions: 6809 & 6309
                      (      basic09.asm):00344         *
                      (      basic09.asm):00345         *  V1.21   1995/08/11  NitrOS-9 Project
                      (      basic09.asm):00346         * Removed useless LEAS 1,s in Init routine
                      (      basic09.asm):00347         * Split real divide out & made two versions: 6809 & 6309
                      (      basic09.asm):00348         *
                      (      basic09.asm):00349         *  V1.21   1995/08/15  NitrOS-9 Project
                      (      basic09.asm):00350         * Removed useless: STA <u00BD in start, useless CLR <u0035 @ START05,
                      (      basic09.asm):00351         *            Changed LDD #1 to LDB #1/STD <u002D to STB <u002E in start, and
                      (      basic09.asm):00352         *            START05/START15 routine to use W instead of stack for base address
                      (      basic09.asm):00353         * Changed 'bye <CR>' buffer fill @ L08E5 to use LDQ/STQ
                      (      basic09.asm):00354         *
                      (      basic09.asm):00355         *  V1.21   1995/11/12  NitrOS-9 Project
                      (      basic09.asm):00356         * Changed NXTIN1 to use INCD instead of ADDD #1 (NEXT Integer STEP 1
                      (      basic09.asm):00357         * Changed NXTINT to TFR A,E instead of PSHS A, changed TST ,S+ to
                      (      basic09.asm):00358         *            TSTE (NEXT Integer STEP <>1)
                      (      basic09.asm):00359         *
                      (      basic09.asm):00360         *  V1.21   1995/11/16  NitrOS-9 Project
                      (      basic09.asm):00361         * Changed to L345E (REAL NEXT STEP 1) to do direct call to REAL add
                      (      basic09.asm):00362         *            routine (changed BSR L321E/BSR FORSTM to LBSR L3FB1)
                      (      basic09.asm):00363         * As per above, changed same call @ NXTRL (REAL NEXT STEP <>1), and
                      (      basic09.asm):00364         *            eliminated L321E completely
                      (      basic09.asm):00365         * @ NXTRL1 & NXTRL2, eliminated L3221 calls, replaced BSR L3221's
                      (      basic09.asm):00366         *            with LBSR RLCMP (Real Compare) (in REAL NEXT, both cases)
                      (      basic09.asm):00367         *
                      (      basic09.asm):00368         *  V1.21   1995/11/25  NitrOS-9 Project
                      (      basic09.asm):00369         * Remove L50A1 & L509E (calls to REAL Multiply & REAL divide),
                      (      basic09.asm):00370         *            changed CNVOPR to call them directly (prints exponents?)
                      (      basic09.asm):00371         *
                      (      basic09.asm):00372         *  V1.21   1995/11/30  NitrOS-9 Project
                      (      basic09.asm):00373         * Changed RUNS30 to use SUBR (saves 1 byte/9 cyc on RUN (mlsub)
                      (      basic09.asm):00374         *
                      (      basic09.asm):00375         *  V1.21   1995/12/05  NitrOS-9 Project
                      (      basic09.asm):00376         * Changed L3A48 (called by REM) to use ABX instead of CLRA/LEAX D,X
                      (      basic09.asm):00377         *            (used to jump ahead in I-Code to skip remark text)
                      (      basic09.asm):00378         * Attempted to just move L33DF (NEXT) & L34E5 (FOR) Tables to just
                      (      basic09.asm):00379         *            after L3446 for 8 bit offsets - also removed LSLB @ L33EA
                      (      basic09.asm):00380         *
                      (      basic09.asm):00381         *  V1.21   1995/02/12  NitrOS-9 Project
                      (      basic09.asm):00382         * Changed routines around BADNUM to skip ORCC if not necessary (blo&
                      (      basic09.asm):00383         *            bcs)
                      (      basic09.asm):00384         * Changed LEAX to 8 bit from 16 @ CIRCOR
                      (      basic09.asm):00385         *
                      (      basic09.asm):00386         *  V1.21   2014/06/07  RG (NitrOS-9 Project)
                      (      basic09.asm):00387         * Changed Date$ to conform with Y2K changes in F$Time
