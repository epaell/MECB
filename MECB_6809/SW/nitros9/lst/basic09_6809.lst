                      (      basic09.asm):00390         * BASIC09 - Copyright (C) 1980 by Microware & Motorola
                      (      basic09.asm):00391         ***********
                      (      basic09.asm):00392         * Basic09 & RunB programs have extended memory module headers. Layout is as
                      (      basic09.asm):00393         *  follows:
                      (      basic09.asm):00394         *   Offset  | Name       | Purpose
                      (      basic09.asm):00395         *   --------+------------+----------
                      (      basic09.asm):00396         *   $0000   |  M$ID      | Module sync bytes ($87CD)
                      (      basic09.asm):00397         *   $0002   |  M$Size    | Size of module
                      (      basic09.asm):00398         *   $0004   |  M$Name    | Offset to module name
                      (      basic09.asm):00399         *   $0006   |  M$Type    | Type/Language ($22 for RUNB modules)
                      (      basic09.asm):00400         *   $0007   |  M$Revs    | Attributes/Revision level
                      (      basic09.asm):00401         *   $0008   |  M$Parity  | Header parity check
                      (      basic09.asm):00402         *   $0009   |  M$Exec    | Execution offset (start of tokenized RUNB code)
                      (      basic09.asm):00403         *   $000B   |  ???       | Data area size required
                      (      basic09.asm):00404         *   $000D   |  ???       | ???
                      (      basic09.asm):00405         *   $0017   |  ???       | Flags:
                      (      basic09.asm):00406         *           |            |   x0000000 - 1=Packed, 0=Not packed
                      (      basic09.asm):00407         *           |            |   0x000000 - ??? but 1 when CRC has just been made
                      (      basic09.asm):00408         *           |            |   0000000x - 1=Line with compiler error
                      (      basic09.asm):00409         *           |            |              0=No lines with compiler errors
                      (      basic09.asm):00410         *   $0018   |  ???       | Size of module name
                      (      basic09.asm):00411         
                      (      basic09.asm):00412         * Version Numbers
     0001             (      basic09.asm):00413         B09Vrsn             equ       1
     0001             (      basic09.asm):00414         B09Major            equ       1
     0000             (      basic09.asm):00415         B09Minor            equ       0
                      (      basic09.asm):00416         
                      (      basic09.asm):00417                             nam       Basic09
                      (      basic09.asm):00418                             ttl       BASIC for OS-9
                      (      basic09.asm):00419         
