                      (/kernel/krnp2.asm):00065         * Install system calls.
0041 318CCF           (/kernel/krnp2.asm):00066                             leay      SvcTbl,pcr ; point to the system call table
0044 103F32           (/kernel/krnp2.asm):00067                             os9       F$SSvc    ; install the system calls
                      (/kernel/krnp2.asm):00068         * Allocate a process descriptor for the initial process.
0047 9E49             (/kernel/krnp2.asm):00069                             ldx       <D.PrcDBT ; get process descriptor table in X
0049 103F30           (/kernel/krnp2.asm):00070                             os9       F$All64   ; allocate a new 64 byte page
004C 2546             (/kernel/krnp2.asm):00071                             bcs       FatalErr  ; failed to allocate
004E 9F49             (/kernel/krnp2.asm):00072                             stx       <D.PrcDBT ; save off
0050 109F4B           (/kernel/krnp2.asm):00073                             sty       <D.Proc   ; save off new process descriptor pointer
0053 1F40             (/kernel/krnp2.asm):00074                             tfr       s,d       ; transfer the stack pointer to D
0055 4A               (/kernel/krnp2.asm):00075                             deca                ; set address to 1 minus stack's MSB
0056 C601             (/kernel/krnp2.asm):00076                             ldb       #$01      ; set page count to 1 (256 bytes)
0058 ED27             (/kernel/krnp2.asm):00077                             std       P$ADDR,y  ; save off in P$ADDR and P$PagCnt
005A 8680             (/kernel/krnp2.asm):00078                             lda       #SysState ; get system state flag
005C A72D             (/kernel/krnp2.asm):00079                             sta       P$State,y ; set the state in the process descriptor
005E DE2A             (/kernel/krnp2.asm):00080                             ldu       <D.Init   ; get init module address in U
                      (/kernel/krnp2.asm):00081         
                      (/kernel/krnp2.asm):00082         * ChdDir should identify system device, result in a call to IOCall which links and
                      (/kernel/krnp2.asm):00083         * initializes IOMan. This could fail if IOMan is not loaded.
0060 8D36             (/kernel/krnp2.asm):00084                             bsr       ChdDir    ; attempt to change directories
0062 2405             (/kernel/krnp2.asm):00085                             bcc       open@     ; success
                      (/kernel/krnp2.asm):00086         * Maybe we failed because we didn't have all the modules we needed? Load and
                      (/kernel/krnp2.asm):00087         * validate the boot file and then try again.
0064 170478           (/kernel/krnp2.asm):00088                             lbsr      LoadBoot  ; else attempt to load bootfile
0067 8D2F             (/kernel/krnp2.asm):00089                             bsr       ChdDir    ; then try to change directories again
0069 3402             (/kernel/krnp2.asm):00090         open@               pshs      a
006B 860D             (/kernel/krnp2.asm):00091                             lda       #$0d      ; write a final new line before transferring to OS
006D AD9FFFE9         (/kernel/krnp2.asm):00092                             jsr       [S.CharOut]
0071 860A             (/kernel/krnp2.asm):00093                             lda       #$0a
0073 AD9FFFE9         (/kernel/krnp2.asm):00094                             jsr       [S.CharOut]
0077 3502             (/kernel/krnp2.asm):00095                             puls      a
0079 8D2B             (/kernel/krnp2.asm):00096                             bsr       OpenCons  ; try to open the console
007B 2409             (/kernel/krnp2.asm):00097                             bcc       ChainProg ; branch if successful
                      (/kernel/krnp2.asm):00098         
                      (/kernel/krnp2.asm):00099         * Maybe we were able to get this far without needing anything from the boot file, but now
                      (/kernel/krnp2.asm):00100         * we need it for the console device.
007D 17045F           (/kernel/krnp2.asm):00101                             lbsr      LoadBoot  ; else attempt to load bootfile
0080 8D24             (/kernel/krnp2.asm):00102                             bsr       OpenCons  ; try to open the console again
0082 2402             (/kernel/krnp2.asm):00103                             bcc       ChainProg ; branch if carry is clear to ChainProg
0084 20FE             (/kernel/krnp2.asm):00104         forever@            bra       forever@  ; branch unconditionally to forever@
                      (/kernel/krnp2.asm):00105         
                      (/kernel/krnp2.asm):00106         * Hmm. No check for success. Probably should "bcs fatalerr" here?
                      (/kernel/krnp2.asm):00107         
0086 EC4E             (/kernel/krnp2.asm):00108         ChainProg           ldd       InitStr,u ; get the offset to the 'GO' program from the Init module
0088 30CB             (/kernel/krnp2.asm):00109                             leax      d,u       ; point X to the address of the name
008A 8601             (/kernel/krnp2.asm):00110                             lda       #Objct    ; object code
008C 5F               (/kernel/krnp2.asm):00111                             clrb                ; no optional data area needed
008D 108E0000         (/kernel/krnp2.asm):00112                             ldy       #$0000    ; no parameter area needed
0091 103F05           (/kernel/krnp2.asm):00113                             os9       F$Chain   ; chain to it
0094 6E9FFFFE         (/kernel/krnp2.asm):00114         FatalErr            jmp       [$FFFE]   ; jump to the RESET vector
                      (/kernel/krnp2.asm):00115         
                      (/kernel/krnp2.asm):00116         * Change the directory.
                      (/kernel/krnp2.asm):00117         * Entry: U = The address of the Init module.
0098 5F               (/kernel/krnp2.asm):00118         ChdDir              clrb                ; clear carry
0099 ECC810           (/kernel/krnp2.asm):00119                             ldd       <SysStr,u ; get system device
009C 2707             (/kernel/krnp2.asm):00120                             beq       ex@       ; branch if none - carry still clear
009E 30CB             (/kernel/krnp2.asm):00121                             leax      d,u       ; address of the path list
00A0 8605             (/kernel/krnp2.asm):00122                             lda       #READ.+EXEC. ; access mode
00A2 103F86           (/kernel/krnp2.asm):00123                             os9       I$ChgDir  ; change directory to it
00A5 39               (/kernel/krnp2.asm):00124         ex@                 rts                 ; carry set -> error
                      (/kernel/krnp2.asm):00125         
                      (/kernel/krnp2.asm):00126         * Open the console device.
                      (/kernel/krnp2.asm):00127         * Entry: U = The address of the Init module
00A6 5F               (/kernel/krnp2.asm):00128         OpenCons            clrb                ; clear B
00A7 ECC812           (/kernel/krnp2.asm):00129                             ldd       <StdStr,u ; get the offset to the console device in the Init module
00AA 30CB             (/kernel/krnp2.asm):00130                             leax      d,u       ; point X to the address of the name
00AC 8603             (/kernel/krnp2.asm):00131                             lda       #UPDAT.   ; open for update
00AE 103F84           (/kernel/krnp2.asm):00132                             os9       I$Open    ; open it
00B1 2511             (/kernel/krnp2.asm):00133                             bcs       ex@       ; branch if error
00B3 9E4B             (/kernel/krnp2.asm):00134                             ldx       <D.Proc   ; get process descriptor
00B5 A78826           (/kernel/krnp2.asm):00135                             sta       P$Path+0,x ; save path to console to stdin...
