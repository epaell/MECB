                      (        fwait.asm):00001         ;;; F$Wait
                      (        fwait.asm):00002         ;;;
                      (        fwait.asm):00003         ;;; Suspend the calling process to wait for a child to terminate.
                      (        fwait.asm):00004         ;;;
                      (        fwait.asm):00005         ;;; Entry:  None
                      (        fwait.asm):00006         ;;;
                      (        fwait.asm):00007         ;;; Exit:   A = The process ID of the terminated child process.
                      (        fwait.asm):00008         ;;;         B = The exit status of the terminated child process.
                      (        fwait.asm):00009         ;;;
                      (        fwait.asm):00010         ;;; Error:  B = A non-zero error code.
                      (        fwait.asm):00011         ;;;        CC = Carry flag set to indicate error.
                      (        fwait.asm):00012         ;;;
                      (        fwait.asm):00013         ;;;
                      (        fwait.asm):00014         ;;; F$Wait suspends the calling process until one of its children terminates. The kerenel returns the child’s
                      (        fwait.asm):00015         ;;; process ID and exit status. If the child terminated due to a signal, the exit status byte in B contains the
                      (        fwait.asm):00016         ;;; signal code.
                      (        fwait.asm):00017         ;;;
                      (        fwait.asm):00018         ;;; If the caller has more than one child, the kernel activates the caller when the first one terminates. Therefore,
                      (        fwait.asm):00019         ;;; you need call F$Wait to detect the termination of each child.
                      (        fwait.asm):00020         ;;;
                      (        fwait.asm):00021         ;;; The kernel immediately reactivates the caller if a child terminates before F$Wait. If the caller has no children,
                      (        fwait.asm):00022         ;;; F$Wait returns an error.
                      (        fwait.asm):00023         ;;; A return from F$Wait with the carry bit set indicates failure; otherwise, the call functioned properly and the
                      (        fwait.asm):00024         ;;; child's exit status resides in B.
                      (        fwait.asm):00025         
010E 109E4B           (        fwait.asm):00026         FWait               ldy       <D.Proc   ; get the current process descriptor
0111 9E49             (        fwait.asm):00027                             ldx       <D.PrcDBT ; get the pointer to the process descriptor table
0113 A623             (        fwait.asm):00028                             lda       P$CID,y   ; get the child ID of this process
0115 2604             (        fwait.asm):00029                             bne       findchild@ ; branch this process has a child
0117 53               (        fwait.asm):00030                             comb                ; else set the carry
0118 C6E2             (        fwait.asm):00031                             ldb       #E$NoChld ; and return an error that this process has no children
011A 39               (        fwait.asm):00032                             rts                 ; return to the caller
011B 103F2F           (        fwait.asm):00033         findchild@          os9       F$Find64  ; find the process descriptor for the child
011E A62D             (        fwait.asm):00034                             lda       P$State,y ; get the state value
0120 8501             (        fwait.asm):00035                             bita      #Dead     ; has the child terminated?
0122 2613             (        fwait.asm):00036                             bne       terminated@ ; branch if so
0124 A622             (        fwait.asm):00037                             lda       P$SID,y   ; else check if the child has siblings
0126 26F3             (        fwait.asm):00038                             bne       findchild@ ; branch if so
0128 6F41             (        fwait.asm):00039                             clr       R$A,u     ; clear the A register
012A 9E4B             (        fwait.asm):00040                             ldx       <D.Proc   ; get the current process descriptor
012C 1A50             (        fwait.asm):00041                             orcc      #FIRQMask+IRQMask ; mask interrupts
012E DC4F             (        fwait.asm):00042                             ldd       <D.WProcQ ; get head wait queue pointer
0130 ED0E             (        fwait.asm):00043                             std       P$Queue,x ; and set the current process' queue pointer to it
0132 9F4F             (        fwait.asm):00044                             stx       <D.WProcQ ; store current process at the head of the wait queue
0134 160229           (        fwait.asm):00045                             lbra      SetupReturn ; branch unconditionally to SetupReturn
0137 9E4B             (        fwait.asm):00046         terminated@         ldx       <D.Proc   ; get the current process descriptor
0139 A6A4             (        fwait.asm):00047         SignalProcess       lda       P$ID,y    ; get process ID in process descriptor
013B E6A836           (        fwait.asm):00048                             ldb       <P$Signal,y ; and signal in process descriptor
013E ED41             (        fwait.asm):00049                             std       R$A,u     ; save both to caller's D register
0140 3472             (        fwait.asm):00050                             pshs      u,y,x,a   ; save registers
     0000             (        fwait.asm):00051         _stk1A@             set       0         ; define assembler symbol
     0001             (        fwait.asm):00052         _stk1X@             set       1         ; define assembler symbol
     0003             (        fwait.asm):00053         _stk1Y@             set       3         ; define assembler symbol
     0005             (        fwait.asm):00054         _stk1U@             set       5         ; define assembler symbol
0142 3101             (        fwait.asm):00055                             leay      P$PID,x   ; get parent process ID
