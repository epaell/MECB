00BB A78827           (/kernel/krnp2.asm):00137                             sta       P$Path+1,x ; ...stdout
00BE 103F82           (/kernel/krnp2.asm):00138                             os9       I$Dup     ; duplicate it
00C1 A78828           (/kernel/krnp2.asm):00139                             sta       P$Path+2,x ; ...and stderr
00C4 39               (/kernel/krnp2.asm):00140         ex@                 rts                 ; return to the caller
                      (/kernel/krnp2.asm):00141         
                      (/kernel/krnp2.asm):00142         
                      (/kernel/krnp2.asm):00143                             use       funlink.asm ; include source file funlink.asm
                      (      funlink.asm):00001         ;;; F$Unlink
                      (      funlink.asm):00002         ;;;
                      (      funlink.asm):00003         ;;; Decrement a module's link count.
                      (      funlink.asm):00004         ;;;
                      (      funlink.asm):00005         ;;; Entry:  U = The address of the module header.
                      (      funlink.asm):00006         ;;;
                      (      funlink.asm):00007         ;;; Exit:   None
                      (      funlink.asm):00008         ;;;
                      (      funlink.asm):00009         ;;; Error:  B = A non-zero error code.
                      (      funlink.asm):00010         ;;;        CC = Carry flag set to indicate error.
                      (      funlink.asm):00011         ;;;
                      (      funlink.asm):00012         ;;; F$Wait suspends the calling process until one of its children terminates. The kerenel returns the child’s
                      (      funlink.asm):00013         ;;; process ID and exit status. If the child terminated due to a signal, the exit status byte in B contains the
                      (      funlink.asm):00014         ;;; signal code.
                      (      funlink.asm):00015         ;;;
                      (      funlink.asm):00016         ;;; If the caller has more than one child, the kernel activates the caller when the first one terminates. Therefore,
                      (      funlink.asm):00017         ;;; you need call F$Wait to detect the termination of each child.
                      (      funlink.asm):00018         ;;;
                      (      funlink.asm):00019         ;;; The kernel immediately reactivates the caller if a child terminates before F$Wait. If the caller has no children,
                      (      funlink.asm):00020         ;;; F$Wait returns an error.
                      (      funlink.asm):00021         ;;; A return from F$Wait with the carry bit set indicates failure; otherwise, the call functioned properly and the
                      (      funlink.asm):00022         ;;; child's exit status resides in B.
                      (      funlink.asm):00023         
                      (      funlink.asm):00024                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (      funlink.asm):00025         
00C5 EC48             (      funlink.asm):00026         FUnlink             ldd       R$U,u     ; get the pointer to the module to unlink
00C7 2743             (      funlink.asm):00027                             beq       okex@     ; branch if it's empty
00C9 9E26             (      funlink.asm):00028                             ldx       <D.ModDir ; get the pointer to the first module in the module directory
00CB 10A384           (      funlink.asm):00029         FUnlinkPssdModMod   cmpd      MD$MPtr,x ; compare the passed module address to the one in this module directory entry
00CE 2708             (      funlink.asm):00030                             beq       found@    ; if we've found it, branch
00D0 3004             (      funlink.asm):00031                             leax      MD$ESize,x ; else go to next entry
00D2 9C28             (      funlink.asm):00032                             cmpx      <D.ModDir+2 ; are we at the end of the module directory?
00D4 25F5             (      funlink.asm):00033                             bcs       FUnlinkPssdModMod ; if not, go check next entry for match
00D6 2034             (      funlink.asm):00034                             bra       okex@     ; else exit
00D8 A602             (      funlink.asm):00035         found@              lda       MD$Link,x ; get the module's link count
00DA 2705             (      funlink.asm):00036                             beq       dealloc@  ; branch if zero
00DC 4A               (      funlink.asm):00037                             deca                ; else decrement by one
00DD A702             (      funlink.asm):00038                             sta       MD$Link,x ; and save count
00DF 262B             (      funlink.asm):00039                             bne       okex@     ; branch if post-dec wasn't zero
                      (      funlink.asm):00040         * If here, deallocate module
00E1 10AE84           (      funlink.asm):00041         dealloc@            ldy       MD$MPtr,x ; get the module pointer in the current module directory
00E4 109C66           (      funlink.asm):00042                             cmpy      <D.BTLO   ; compare against the bottom of boot memory
00E7 2423             (      funlink.asm):00043                             bcc       okex@     ; branch if the branch if the pointer is in the boot memory area; we don't unlink modules there
00E9 E626             (      funlink.asm):00044                             ldb       M$Type,y  ; get the type of module
00EB C1D0             (      funlink.asm):00045                             cmpb      #FlMgr    ; is it a file manager?
