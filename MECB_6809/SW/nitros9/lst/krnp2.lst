                      (        ficpt.asm):00002         ;;;
                      (        ficpt.asm):00003         ;;; Set a signal intercept routine.
                      (        ficpt.asm):00004         ;;;
                      (        ficpt.asm):00005         ;;; Entry:  X = The address of the intercept routine.
                      (        ficpt.asm):00006         ;;;         U = Starting address of the routine’s memory area.
                      (        ficpt.asm):00007         ;;;
                      (        ficpt.asm):00008         ;;; Exit:   None
                      (        ficpt.asm):00009         ;;;
                      (        ficpt.asm):00010         ;;; F$Icpt set a signal intercept routine that the kernel calls whenever the process receives a signal.
                      (        ficpt.asm):00011         ;;; Store the address of the signal handler routine in X and the base address of the routine’s storage area in U.
                      (        ficpt.asm):00012         ;;; Terminate the signal intercept routine with an RTI instruction.
                      (        ficpt.asm):00013         ;;;
                      (        ficpt.asm):00014         ;;; If a process doesn't used F$Icpt system call , the process terminates if it receives a signal.
                      (        ficpt.asm):00015         ;;;
                      (        ficpt.asm):00016         ;;; When the process receives a signal, the kernel sets U to the starting address of the intercept routine’s memory area,
                      (        ficpt.asm):00017         ;;; and B to the signal code, then calls the signal intercept routine.
                      (        ficpt.asm):00018         ;;;
                      (        ficpt.asm):00019         ;;; Note: The value of DP cannot be the same as it was when you called F$Icpt.
                      (        ficpt.asm):00020         
