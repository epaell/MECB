                      (/kernel/krnp2.asm):00148                             use       fsleep.asm ; include source file fsleep.asm
                      (       fsleep.asm):00001         ;; F$Sleep
                      (       fsleep.asm):00002         ;;;
                      (       fsleep.asm):00003         ;;; Suspend the calling process and put it in the sleep queue.
                      (       fsleep.asm):00004         ;;;
                      (       fsleep.asm):00005         ;;; Entry:  X = The number of ticks to sleep.
                      (       fsleep.asm):00006         ;;;
                      (       fsleep.asm):00007         ;;; Exit:   X = The requested ticks to sleep minus the number of ticks the process slept.
                      (       fsleep.asm):00008         ;;;        CC = Carry flag clear to indicate success.
                      (       fsleep.asm):00009         ;;;
                      (       fsleep.asm):00010         ;;; Error:  B = A non-zero error code.
                      (       fsleep.asm):00011         ;;;        CC = Carry flag set to indicate error.
                      (       fsleep.asm):00012         ;;;
                      (       fsleep.asm):00013         ;;; If X contains 0, the kernel puts the process to sleep until it receives a signal. Putting a process to sleep
                      (       fsleep.asm):00014         ;;; is the correct way to wait for a signal or interrupt without wasting CPU time.
                      (       fsleep.asm):00015         ;;;
                      (       fsleep.asm):00016         ;;; If X contains 1, the kernel puts the process to sleep for the remainder of its current time slice. The kernel
                      (       fsleep.asm):00017         ;;; inserts the process into the active process queue immediately. The process resumes execution when it reaches the
                      (       fsleep.asm):00018         ;;; front of the queue.
                      (       fsleep.asm):00019         ;;;
                      (       fsleep.asm):00020         ;;; If X contains any other value, the kernel puts the process to for the specified number of ticks. The kernel
                      (       fsleep.asm):00021         ;;; inserts the process into the active process queue after the second to last tick. The process resumes execution
                      (       fsleep.asm):00022         ;;; when it reaches the front of the queue.
                      (       fsleep.asm):00023         ;;;
