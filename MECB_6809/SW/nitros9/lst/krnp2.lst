025D 4C               (        fsend.asm):00042         FSendIncreaseBy     inca                ; increase A by 1
025E 26F5             (        fsend.asm):00043                             bne       FSendProcDesc ; branch if not error
0260 5F               (        fsend.asm):00044                             clrb                ; clear the carry
0261 39               (        fsend.asm):00045                             rts                 ; return to the caller
0262 9E49             (        fsend.asm):00046         getprocess@         ldx       <D.PrcDBT ; get the process descriptor table pointer
