                      (        fsend.asm):00001         ;;; F$Send
                      (        fsend.asm):00002         ;;;
                      (        fsend.asm):00003         ;;; Send a signal to a process.
                      (        fsend.asm):00004         ;;;
                      (        fsend.asm):00005         ;;; Entry:  A = The process ID of the process to receive the signal.
                      (        fsend.asm):00006         ;;;         B = The signal to send.
                      (        fsend.asm):00007         ;;;
                      (        fsend.asm):00008         ;;; Exit:  CC = Carry flag clear to indicate success.
                      (        fsend.asm):00009         ;;;
                      (        fsend.asm):00010         ;;; Error:  B = A non-zero error code.
                      (        fsend.asm):00011         ;;;        CC = Carry flag set to indicate error.
                      (        fsend.asm):00012         ;;;
                      (        fsend.asm):00013         ;;; The signal is a single byte value in the rage 0 through 255. If the destination process
                      (        fsend.asm):00014         ;;; is sleeping or waiting, the kernel activates the process so that it can process the signal.
                      (        fsend.asm):00015         ;;; If the process installed a signal intercept routine using F$Icpt, F$Send calls into it.
                      (        fsend.asm):00016         ;;; Otherwise, the signal terminates the receiving process, and the process returns that
                      (        fsend.asm):00017         ;;; signal as its exit status. An exception is the wakeup signal: S$Wake. It doesn't cause
                      (        fsend.asm):00018         ;;; the kernel to invoke signal intercept routine.
                      (        fsend.asm):00019         ;;;
                      (        fsend.asm):00020         ;;; The signal codes are:
                      (        fsend.asm):00021         ;;;
                      (        fsend.asm):00022         ;;;            - S$Kill - terminate the process (cannot be intercepted)
                      (        fsend.asm):00023         ;;;            - S$Wake - wake up the process.
                      (        fsend.asm):00024         ;;;            - S$Abort - keyboard termination sequence typed
                      (        fsend.asm):00025         ;;;            - S$Intrpt - keyboard interrupt sequence typed
                      (        fsend.asm):00026         ;;;
                      (        fsend.asm):00027         ;;; The kernel reserves all signal between 0 and 127. Signals 128 to 255 are user-defined
                      (        fsend.asm):00028         ;;; and can be used for interprocess communication.
                      (        fsend.asm):00029         ;;;
                      (        fsend.asm):00030         ;;; If you call F$Send for a process that has a signal pending, the kernel returns an error.
                      (        fsend.asm):00031         ;;; In that case, call F$Sleep for a few ticks to save CPU time, then try F$Send again.
                      (        fsend.asm):00032         
                      (        fsend.asm):00033                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (        fsend.asm):00034         
