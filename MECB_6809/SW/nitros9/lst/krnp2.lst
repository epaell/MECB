0146 2003             (        fwait.asm):00057                             bra       looptop@  ; branch to the top of the search loop
                      (        fwait.asm):00058         * Find the process
0148 103F2F           (        fwait.asm):00059         loop@               os9       F$Find64  ; find the process descriptor
014B A622             (        fwait.asm):00060         looptop@            lda       P$SID,y   ; get that process' sibling ID
014D A1E4             (        fwait.asm):00061                             cmpa      _stk1A@,s ; is it the same as the one we're looking for?
014F 26F7             (        fwait.asm):00062                             bne       loop@     ; if not, go get the next one
0151 EE63             (        fwait.asm):00063                             ldu       _stk1Y@,s ; get process descriptor saved earlier on the stack
0153 E642             (        fwait.asm):00064                             ldb       P$SID,u   ; get the sibling ID from the previous process descriptor
0155 E722             (        fwait.asm):00065                             stb       P$SID,y   ; save and store it in the next sibling
0157 103F31           (        fwait.asm):00066                             os9       F$Ret64   ; return the process descriptor to the free pool
015A 35F2             (        fwait.asm):00067                             puls      pc,u,y,x,a ; pull all registers and return to the caller
                      (/kernel/krnp2.asm):00145                             use       fexit.asm ; include source file fexit.asm
                      (        fexit.asm):00001         ;;; F$Exit
                      (        fexit.asm):00002         ;;;
                      (        fexit.asm):00003         ;;; Terminate the calling process.
                      (        fexit.asm):00004         ;;;
                      (        fexit.asm):00005         ;;; Entry:  B = The status code to return to the parent process.
                      (        fexit.asm):00006         ;;;
                      (        fexit.asm):00007         ;;; Exit:   The process is terminated.
                      (        fexit.asm):00008         ;;;
                      (        fexit.asm):00009         ;;; F$Exit is the only way a process can terminate itself. F$Exit deallocates the process’ data memory area and
                      (        fexit.asm):00010         ;;; unlinks the process' primary module. It also closes all open paths automatically.
                      (        fexit.asm):00011         ;;;
                      (        fexit.asm):00012         ;;; F$Wait always returns to the parent the status code passed by the child when it exits. Therefore, if the parent
                      (        fexit.asm):00013         ;;; calls F$Wait and receives the status code, it knows the child has died.
                      (        fexit.asm):00014         ;;;
                      (        fexit.asm):00015         ;;; Exit unlinks only the primary module. Unlink any module that is loaded or linked to by the process before
                      (        fexit.asm):00016         ;;; calling F$Exit.
                      (        fexit.asm):00017         
                      (        fexit.asm):00018                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (        fexit.asm):00019         
015C 9E4B             (        fexit.asm):00020         FExit               ldx       <D.Proc   ; get pointer to current process descriptor
015E E642             (        fexit.asm):00021                             ldb       R$B,u     ; get exit code
0160 E78836           (        fexit.asm):00022                             stb       P$Signal,x ; save it as the process' signal
                      (        fexit.asm):00023         * Close all open paths that this process has
0163 C610             (        fexit.asm):00024                             ldb       #NumPaths ; get the number pf paths
0165 318826           (        fexit.asm):00025                             leay      P$PATH,x  ; point Y to the base of the path table in the process descriptor
