0267 2408             (        fsend.asm):00048                             bcc       FSendRecvProcDesc ; branch if found
0269 C6E0             (        fsend.asm):00049                             ldb       #E$IPrcID ; else return an illegal process ID error
026B 39               (        fsend.asm):00050                             rts                 ; return to the caller
026C 53               (        fsend.asm):00051         badid@              comb                ; set the carry flag
026D C6E0             (        fsend.asm):00052                             ldb       #E$IPrcID ; return an illegal process ID error
026F 35A2             (        fsend.asm):00053                             puls      pc,y,a    ; recover the stack and return to the caller
                      (        fsend.asm):00054         * Entry: A = recipient process ID
0271 3422             (        fsend.asm):00055         FSendRecvProcDesc   pshs      y,a       ; save the receipient process descriptor and
0273 E642             (        fsend.asm):00056                             ldb       R$B,u     ; get the signal to send from the caller
0275 2611             (        fsend.asm):00057                             bne       checkpending@ ; branch if not S$Kill
0277 9E4B             (        fsend.asm):00058                             ldx       <D.Proc   ; else get current process descriptor
0279 EC09             (        fsend.asm):00059                             ldd       P$User,x  ; and its user id
027B 2705             (        fsend.asm):00060                             beq       condemn@  ; branch if super user ID (it can send S$Kill)
027D 10A329           (        fsend.asm):00061                             cmpd      P$User,y  ; same as user of recipient process?
0280 26EA             (        fsend.asm):00062                             bne       badid@    ; no, cannot send S$Kill to another user's process
0282 A62D             (        fsend.asm):00063         condemn@            lda       P$State,y ; get state of recipient
0284 8A02             (        fsend.asm):00064                             ora       #Condem   ; set condemn bit
0286 A72D             (        fsend.asm):00065                             sta       P$State,y ; and set it back
0288 1A50             (        fsend.asm):00066         checkpending@       orcc      #FIRQMask+IRQMask ; mask interrupts
