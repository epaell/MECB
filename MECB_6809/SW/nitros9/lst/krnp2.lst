0252 260E             (        fsend.asm):00036                             bne       getprocess@ ; if not 0, go find the process descriptor
0254 4C               (        fsend.asm):00037                             inca                ; else increment A
0255 9E4B             (        fsend.asm):00038         FSendProcDesc       ldx       <D.Proc   ; get the current process descriptor
0257 A184             (        fsend.asm):00039                             cmpa      P$ID,x    ; and the process ID
0259 2702             (        fsend.asm):00040                             beq       FSendIncreaseBy ; branch if 0
