028F 4A               (        fsend.asm):00069                             deca                ; is the pending signal the wake signal?
0290 2705             (        fsend.asm):00070                             beq       sendit@   ; branch if so
0292 53               (        fsend.asm):00071                             comb                ; else set the carry flag
0293 C6E9             (        fsend.asm):00072                             ldb       #E$USigP  ; indicate signal already pending
0295 35A2             (        fsend.asm):00073                             puls      pc,y,a    ; recover the stack and return to the caller
0297 E642             (        fsend.asm):00074         sendit@             ldb       R$B,u     ; get the signal to send from the caller
0299 E7A836           (        fsend.asm):00075                             stb       <P$Signal,y ; store it in the recipient process descriptor
029C 8E0043           (        fsend.asm):00076                             ldx       #(D.SProcQ-P$Queue) ; get pointer to sleep queue
029F 2026             (        fsend.asm):00077                             bra       findprocess@ ; go find the process
02A1 AC61             (        fsend.asm):00078         match@              cmpx      $01,s     ; same as process descriptor of recipient?
02A3 2622             (        fsend.asm):00079                             bne       findprocess@ ; branch if not
02A5 A60D             (        fsend.asm):00080                             lda       P$State,x ; else get state of recipient
02A7 8540             (        fsend.asm):00081                             bita      #TimSleep ; is it in a timed sleep?
02A9 272F             (        fsend.asm):00082                             beq       activate@ ; branch if not
02AB EE04             (        fsend.asm):00083                             ldu       P$SP,x    ; else get recipient stack pointer
02AD EC44             (        fsend.asm):00084                             ldd       R$X,u     ; get the number of ticks it's sleeping
02AF 2729             (        fsend.asm):00085                             beq       activate@ ; if X == 0 (sleep forever), then branch
02B1 EE0E             (        fsend.asm):00086                             ldu       P$Queue,x ; get the queue pointer of the recipient
02B3 2725             (        fsend.asm):00087                             beq       activate@ ; branch if empty
02B5 3406             (        fsend.asm):00088                             pshs      b,a       ; save off D temporarily
02B7 A64D             (        fsend.asm):00089                             lda       P$State,u ; get the process' state
02B9 8540             (        fsend.asm):00090                             bita      #TimSleep ; is it in a timed sleep
02BB 3506             (        fsend.asm):00091                             puls      b,a       ; restore D
02BD 271B             (        fsend.asm):00092                             beq       activate@ ; branch if it isn't
02BF EE44             (        fsend.asm):00093                             ldu       P$SP,u    ; else get recipient stack pointer
02C1 E344             (        fsend.asm):00094                             addd      P$SP,u    ; add it to D
02C3 ED44             (        fsend.asm):00095                             std       P$SP,u    ; save it back
02C5 2013             (        fsend.asm):00096                             bra       activate@ ; and continue
02C7 3184             (        fsend.asm):00097         findprocess@        leay      ,x        ; point Y to the sender's process descriptor
02C9 AE2E             (        fsend.asm):00098                             ldx       P$Queue,y ; get the pointer to its current queue
02CB 26D4             (        fsend.asm):00099                             bne       match@    ; branch if not empty
02CD 8E0041           (        fsend.asm):00100                             ldx       #(D.WProcQ-P$Queue) ; else load X with the wait queue pointer
02D0 3184             (        fsend.asm):00101         loop@               leay      ,x        ; set Y to that entry
02D2 AE2E             (        fsend.asm):00102                             ldx       P$Queue,y ; and load X with the queue pointer of that process
02D4 2714             (        fsend.asm):00103                             beq       ex@       ; branch if empty
02D6 AC61             (        fsend.asm):00104                             cmpx      $01,s     ; is it the recipient process descriptor?
02D8 26F6             (        fsend.asm):00105                             bne       loop@     ; branch if not
02DA EC0E             (        fsend.asm):00106         activate@           ldd       P$Queue,x ; get the queue pointer in the first process descriptor
02DC ED2E             (        fsend.asm):00107                             std       P$Queue,y ; and save it to the second process descriptor
02DE A68836           (        fsend.asm):00108                             lda       <P$Signal,x ; get the signal from the first process descriptor
02E1 4A               (        fsend.asm):00109                             deca                ; decrement it
