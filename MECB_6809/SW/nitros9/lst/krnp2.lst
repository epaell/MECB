                      (      fsprior.asm):00041                             bne       FSpriorCarryError ; no, return error
03A3.                 (      fsprior.asm):00042         FSpriorNewPriority  lda       R$B,u     ; get new priority
                      (      fsprior.asm):00043                             sta       P$Prior,y ; set it
                      (      fsprior.asm):00044                             clrb                ; clear errors
                      (      fsprior.asm):00045                             rts                 ; return
03A3.                 (      fsprior.asm):00046         FSpriorCarryError   comb                ; set carry for error
                      (      fsprior.asm):00047                             ldb       #E$BPrcID ; load B from #E$BPrcID
03A3.                 (      fsprior.asm):00048         FSpriorReturn       rts                 ; return to caller
                      (      fsprior.asm):00049         
                      (      fsprior.asm):00050                           ENDC
                      (/kernel/krnp2.asm):00151                             use       fid.asm   ; include source file fid.asm
                      (          fid.asm):00001         ;;; F$ID
                      (          fid.asm):00002         ;;;
                      (          fid.asm):00003         ;;; Return a caller’s process ID and user ID.
                      (          fid.asm):00004         ;;;
                      (          fid.asm):00005         ;;; Entry:  None
                      (          fid.asm):00006         ;;;
                      (          fid.asm):00007         ;;; Exit:   A = The process ID of the caller's process.
                      (          fid.asm):00008         ;;;         Y = The user ID of the caller's process.
                      (          fid.asm):00009         ;;;        CC = Carry flag clear to indicate success.
                      (          fid.asm):00010         ;;;
                      (          fid.asm):00011         ;;; The process ID is a byte value in the range 1 to 255. The kernel assigns each process a unique process ID.
                      (          fid.asm):00012         ;;; The user ID is an integer from 0 to 65535. Several processes can have the same user ID.
                      (          fid.asm):00013         
03A3 9E4B             (          fid.asm):00014         FID                 ldx       <D.Proc   ; get the current process descriptor
03A5 A684             (          fid.asm):00015                             lda       P$ID,x    ; get the process ID
03A7 A741             (          fid.asm):00016                             sta       R$A,u     ; put in in the caller's A
03A9 EC09             (          fid.asm):00017                             ldd       P$User,x  ; get the user ID
03AB ED46             (          fid.asm):00018                             std       R$Y,u     ; put it in the caller's Y
03AD 5F               (          fid.asm):00019                             clrb                ; clear carry
03AE 39               (          fid.asm):00020                             rts                 ; return to the caller
                      (          fid.asm):00021         
                      (/kernel/krnp2.asm):00152                             use       fsswi.asm ; include source file fsswi.asm
                      (        fsswi.asm):00001         ;;; F$SSWI
                      (        fsswi.asm):00002         ;;;
                      (        fsswi.asm):00003         ;;; Set software interrupt vectors for a process.
                      (        fsswi.asm):00004         ;;;
                      (        fsswi.asm):00005         ;;; Entry:  A = The software interrupt code (1 - 3).
                      (        fsswi.asm):00006         ;;;         X = The address of the new software interrupt routine.
                      (        fsswi.asm):00007         ;;;
                      (        fsswi.asm):00008         ;;; Exit:   None.
                      (        fsswi.asm):00009         ;;;
                      (        fsswi.asm):00010         ;;; Error:  B = A non-zero error code.
                      (        fsswi.asm):00011         ;;;        CC = Carry flag set to indicate error.
                      (        fsswi.asm):00012         ;;;
                      (        fsswi.asm):00013         ;;; F$SSWI sets the interrupt vectors for SWI, SWI2, and SWI3 instructions. Each process descriptor has its own
                      (        fsswi.asm):00014         ;;; local vectors that the kernel sets up at creation. Set the appropriate vector according to the code you pass
                      (        fsswi.asm):00015         ;;; in A:
                      (        fsswi.asm):00016         ;;;
                      (        fsswi.asm):00017         ;;;     1 = SWI
                      (        fsswi.asm):00018         ;;;     2 = SWI2
                      (        fsswi.asm):00019         ;;;     3 = SWI3
                      (        fsswi.asm):00020         ;;;
                      (        fsswi.asm):00021         ;;; Note: kernel system calls are invoked using SWI2. If you change this vector, system calls stop working.
                      (        fsswi.asm):00022                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (        fsswi.asm):00023         
03AF 9E4B             (        fsswi.asm):00024         FSSWI               ldx       <D.Proc   ; get current process descriptor
03B1 318814           (        fsswi.asm):00025                             leay      P$SWI,x   ; point to the SWI vectors
03B4 E641             (        fsswi.asm):00026                             ldb       R$A,u     ; get the desired interrupt code to change from the caller's A
03B6 5A               (        fsswi.asm):00027                             decb                ; decrement it
03B7 C103             (        fsswi.asm):00028                             cmpb      #$03      ; is it higher than the allowed value?
03B9 2406             (        fsswi.asm):00029                             bcc       errex@    ; branch if so, it's an error
03BB 58               (        fsswi.asm):00030                             lslb                ; else multiply by 2 to get the 16-bit offset
03BC AE44             (        fsswi.asm):00031                             ldx       R$X,u     ; get the address of the new software interrupt routine from the caller's X
03BE AFA5             (        fsswi.asm):00032                             stx       b,y       ; and store it in the appropriate vector in the process descriptor
03C0 39               (        fsswi.asm):00033                             rts                 ; return to the caller
03C1 53               (        fsswi.asm):00034         errex@              comb                ; set the carry to indicate an error
03C2 C6E3             (        fsswi.asm):00035                             ldb       #E$ISWI   ; invalid SWI number
03C4 39               (        fsswi.asm):00036                             rts                 ; return to the caller
                      (        fsswi.asm):00037         
                      (        fsswi.asm):00038                           ELSE
                      (        fsswi.asm):00039         
03C5.                 (        fsswi.asm):00040         FSSWI               ldx       <D.Proc   ; get current process
                      (        fsswi.asm):00041                             ldb       R$A,u     ; get type code
                      (        fsswi.asm):00042                             decb                ; adjust for offset
                      (        fsswi.asm):00043                             cmpb      #3        ; legal value?
                      (        fsswi.asm):00044                             bcc       BadSWI    ; no, return error
                      (        fsswi.asm):00045                             lslb                ; account for 2 bytes entry
                      (        fsswi.asm):00046                             addb      #P$SWI    ; go to start of P$SWI pointers
                      (        fsswi.asm):00047                             ldu       R$X,u     ; get address
                      (        fsswi.asm):00048                             stu       b,x       ; save to descriptor
                      (        fsswi.asm):00049                             rts                 ; return
                      (        fsswi.asm):00050         
03C5.                 (        fsswi.asm):00051         BadSWI              comb                ; update processor state
                      (        fsswi.asm):00052                             ldb       #E$ISWI   ; load B from #E$ISWI
                      (        fsswi.asm):00053                             rts                 ; return to caller
                      (        fsswi.asm):00054         
                      (        fsswi.asm):00055                           ENDC
                      (/kernel/krnp2.asm):00153                             use       fstime.asm ; include source file fstime.asm
                      (       fstime.asm):00001         ;;; F$STime
                      (       fstime.asm):00002         ;;;
                      (       fstime.asm):00003         ;;; Set the current system time.
                      (       fstime.asm):00004         ;;;
                      (       fstime.asm):00005         ;;; Entry:  X = The address of the current time.
                      (       fstime.asm):00006         ;;;
                      (       fstime.asm):00007         ;;; Exit:   The system's time is updated.
                      (       fstime.asm):00008         ;;;
                      (       fstime.asm):00009         ;;; Error:  B = A non-zero error code.
                      (       fstime.asm):00010         ;;;        CC = Carry flag set to indicate error.
                      (       fstime.asm):00011         ;;;
                      (       fstime.asm):00012         ;;; F$STime sets the current system date and time. The packet format is:
                      (       fstime.asm):00013         ;;;     - Year (one byte from 0-255 representing 1900-2155)
                      (       fstime.asm):00014         ;;;     - Month (one byte from 1-12 representing the month)
                      (       fstime.asm):00015         ;;;     - Day (one byte from 0-31 representing the day)
                      (       fstime.asm):00016         ;;;     - Hour (one byte from 0-23 representing the hour)
                      (       fstime.asm):00017         ;;;     - Minute (one byte from 0-59 representing the minute)
                      (       fstime.asm):00018         ;;;     - Second (one byte from 0-59 representing the second)
                      (       fstime.asm):00019         
                      (       fstime.asm):00020                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (       fstime.asm):00021         
03C5 436C6F63EB       (       fstime.asm):00022         ClkName             fcs       /Clock/
                      (       fstime.asm):00023         
03CA AE44             (       fstime.asm):00024         FSTime              ldx       R$X,u     ; get caller's pointer to time packet
03CC EC84             (       fstime.asm):00025                             ldd       ,x        ; get year and month
03CE DD53             (       fstime.asm):00026                             std       <D.Year   ; save to globals
03D0 EC02             (       fstime.asm):00027                             ldd       2,x       ; get day and hour
03D2 DD55             (       fstime.asm):00028                             std       <D.Day    ; save to globals
03D4 EC04             (       fstime.asm):00029                             ldd       4,x       ; get minute and second
03D6 DD57             (       fstime.asm):00030                             std       <D.Min    ; save to globals
03D8 86C1             (       fstime.asm):00031                             lda       #Systm+Objct ; specify type and language
03DA 308CE8           (       fstime.asm):00032                             leax      <ClkName,pcr ; point to module name
03DD 103F00           (       fstime.asm):00033                             os9       F$Link    ; link to the module
03E0 2503             (       fstime.asm):00034                             bcs       ex@       ; branch if there's an error
03E2 6EA4             (       fstime.asm):00035                             jmp       ,y        ; jump into the initialization entry point
03E4 5F               (       fstime.asm):00036                             clrb                ; else clear B (this is useless and should be removed!)
03E5 39               (       fstime.asm):00037         ex@                 rts                 ; return to caller
                      (       fstime.asm):00038         
                      (       fstime.asm):00039                           ELSE
                      (       fstime.asm):00040         
03E6.                 (       fstime.asm):00041         FSTime              ldx       R$X,u     ; get address that user wants time packet
                      (       fstime.asm):00042         ***         tfr   dp,a            Set MSB of D to direct page
                      (       fstime.asm):00043         ***         ldb   #D.Time         Offset to Time packet in direct page
                      (       fstime.asm):00044         ***         tfr   d,u             Point U to it
                      (       fstime.asm):00045                             ldu       #D.Time   ; --- DP=0 always
                      (       fstime.asm):00046                             ldy       <D.Proc   ; get ptr to process that called us
                      (       fstime.asm):00047                             lda       P$Task,y  ; get task # from process
                      (       fstime.asm):00048                             ldb       <D.SysTsk ; get task # of system process
                      (       fstime.asm):00049                             ldy       #6        ; 6 byte packet to move
                      (       fstime.asm):00050                             os9       F$Move    ; go move it
                      (       fstime.asm):00051                             ldx       <D.Proc   ; get ptr to process that called us
                      (       fstime.asm):00052                             pshs      x         ; preserve it
                      (       fstime.asm):00053                             ldx       <D.SysPrc ; get ptr to system process
                      (       fstime.asm):00054                             stx       <D.Proc   ; save as current process
                      (       fstime.asm):00055                             lda       #Systm+Objct ; link to Clock module
                      (       fstime.asm):00056                             leax      ClockNam,pc ; compute ClockNam,pc into X
                      (       fstime.asm):00057                             os9       F$Link    ; call OS-9 service F$Link
                      (       fstime.asm):00058                             puls      x         ; get back ptr to user's process
                      (       fstime.asm):00059                             stx       <D.Proc   ; make it the active process again
                      (       fstime.asm):00060                             bcs       ex@       ; if error in Link, exit with error code
                      (       fstime.asm):00061                             jmp       ,y        ; jump into Clock
03E6.                 (       fstime.asm):00062         ex@                 rts                 ; return to caller
                      (       fstime.asm):00063         
03E6.                 (       fstime.asm):00064         ClockNam            fcs       /Clock/
                      (       fstime.asm):00065         
                      (       fstime.asm):00066                           ENDC
                      (/kernel/krnp2.asm):00154                             use       ffind64.asm ; include source file ffind64.asm
                      (      ffind64.asm):00001         ;;; F$Find64
                      (      ffind64.asm):00002         ;;;
                      (      ffind64.asm):00003         ;;; Return the address of a 64 byte memory block.
                      (      ffind64.asm):00004         ;;;
                      (      ffind64.asm):00005         ;;; Entry:  A = The block number.
                      (      ffind64.asm):00006         ;;;         X = The base address of the page table.
                      (      ffind64.asm):00007         ;;;
                      (      ffind64.asm):00008         ;;; Exit:   Y = The address of the found block.
                      (      ffind64.asm):00009         ;;;        CC = Carry flag clear to indicate success.
                      (      ffind64.asm):00010         ;;;
                      (      ffind64.asm):00011         ;;; Error:  B = A non-zero error code.
                      (      ffind64.asm):00012         ;;;        CC = Carry flag set to indicate error.
                      (      ffind64.asm):00013         ;;;
                      (      ffind64.asm):00014         ;;; F$Find64 locates a 64 byte block, such as a path or process descriptor, when
                      (      ffind64.asm):00015         ;;; given their block number. The block number can be any positive integer.
                      (      ffind64.asm):00016         
03E6 A641             (      ffind64.asm):00017         FFind64             lda       R$A,u     ; get the caller's block number
03E8 AE44             (      ffind64.asm):00018                             ldx       R$X,u     ; and the base address of the page table
03EA 8D06             (      ffind64.asm):00019                             bsr       FindBlock ; perform the location
03EC 2503             (      ffind64.asm):00020                             bcs       ex@       ; branch if error
03EE 10AF46           (      ffind64.asm):00021                             sty       R$Y,u     ; save found block to caller's Y
03F1 39               (      ffind64.asm):00022         ex@                 rts                 ; return to caller
                      (      ffind64.asm):00023         
03F2 3406             (      ffind64.asm):00024         FindBlock           pshs      b,a       ; save off D
03F4 4D               (      ffind64.asm):00025                             tsta                ; is the block greater than zero?
03F5 270F             (      ffind64.asm):00026                             beq       errex@    ; no; illegal block
03F7 5F               (      ffind64.asm):00027                             clrb                ; else clear B
03F8 44               (      ffind64.asm):00028                             lsra                ; divide D
03F9 56               (      ffind64.asm):00029                             rorb                ; by 2
03FA 44               (      ffind64.asm):00030                             lsra                ; then divide D
03FB 56               (      ffind64.asm):00031                             rorb                ; by 2 again, now D = D / 4
03FC A686             (      ffind64.asm):00032                             lda       a,x       ; move upper 8 bits of 16 bit address from page into A
03FE 1F02             (      ffind64.asm):00033                             tfr       d,y       ; D is now address of 64 byte block; move into Y
0400 2704             (      ffind64.asm):00034                             beq       errex@    ; branch if Y is zero; error
0402 6DA4             (      ffind64.asm):00035                             tst       ,y        ; is first byte at block zero?
0404 2601             (      ffind64.asm):00036                             bne       ex@       ; branch if not; Y is our address!
0406 43               (      ffind64.asm):00037         errex@              coma                ; set carry to indicate error
0407 3586             (      ffind64.asm):00038         ex@                 puls      pc,b,a    ; restore registers and return
                      (/kernel/krnp2.asm):00155                             use       fall64.asm ; include source file fall64.asm
                      (       fall64.asm):00001         ;;; F$All64
                      (       fall64.asm):00002         ;;;
                      (       fall64.asm):00003         ;;; Allocate a 64 byte block of memory.
                      (       fall64.asm):00004         ;;;
                      (       fall64.asm):00005         ;;; Entry:  X = The base address of the page table; 0 = allocate the page table.
                      (       fall64.asm):00006         ;;;
                      (       fall64.asm):00007         ;;; Exit:   A = The block number of the allocated 64 byte block.
                      (       fall64.asm):00008         ;;;         X = The base address of the page table.
                      (       fall64.asm):00009         ;;;         Y = The address of the block.
                      (       fall64.asm):00010         ;;;
                      (       fall64.asm):00011         ;;; Error:  B = A non-zero error code.
                      (       fall64.asm):00012         ;;;        CC = Carry flag set to indicate error.
                      (       fall64.asm):00013         ;;;
                      (       fall64.asm):00014         ;;; F$All64 allocates a 64 byte block of memory by splitting 256 byte pages into four 64 byte blocks.
                      (       fall64.asm):00015         ;;; The kernel uses the first 64 bytes of the base page as a page table. The page table holds up to 64
                      (       fall64.asm):00016         ;;; MSB (most significant byte) references to allocated 256 byte pages.
                      (       fall64.asm):00017         ;;;
                      (       fall64.asm):00018         ;;; If you call F$All64 with X set to zero, F$All64 allocates a new base page and the first 64 byte memory block.
                      (       fall64.asm):00019         ;;;
                      (       fall64.asm):00020         ;;; Whenever a new 256 byte page is needed, F$All64 calls F$SRqMem to allocate 256 bytes of memory.
                      (       fall64.asm):00021         ;;;
                      (       fall64.asm):00022         ;;; The first byte of each block contains the block number, so only the remaining 63 bytes are usable.
                      (       fall64.asm):00023         ;;; Routines using F$All64 shouldn't alter this first byte.
                      (       fall64.asm):00024         ;;; 
                      (       fall64.asm):00025         ;;; The following diagram shows how 64 byte blocks might be allocated in two 256 byte pages located at $3000 ad
                      (       fall64.asm):00026         ;;; $3600, respectively:
                      (       fall64.asm):00027         ;;;
                      (       fall64.asm):00028         ;;;                 -------------------------
                      (       fall64.asm):00029         ;;; Base Page -->  | $30/$36     | $30       |
                      (       fall64.asm):00030         ;;;  $3000         | Page Table  |           |
                      (       fall64.asm):00031         ;;;                | 64 bytes    | 64 bytes  |
                      (       fall64.asm):00032         ;;;                |------------ ------------|
                      (       fall64.asm):00033         ;;;                | $30         | $30       |
                      (       fall64.asm):00034         ;;;                | 64 bytes    | 64 bytes  |
                      (       fall64.asm):00035         ;;;                 -------------------------
                      (       fall64.asm):00036         ;;;
                      (       fall64.asm):00037         ;;;                 -------------------------
                      (       fall64.asm):00038         ;;; Next Page -->  | $36         | $36       |
                      (       fall64.asm):00039         ;;;  $3600         | 64 bytes    | 64 bytes  |
                      (       fall64.asm):00040         ;;;                |-------------------------|
                      (       fall64.asm):00041         ;;;                | $36         |           |
                      (       fall64.asm):00042         ;;;                | 64 bytes    | 64 bytes  |
                      (       fall64.asm):00043         ;;;                 -------------------------
                      (       fall64.asm):00044         ;;;
                      (       fall64.asm):00045         ;;; In this example, the first 256 byte page at $3000 is the base page. All four of its 64 byte blocks are allocated
                      (       fall64.asm):00046         ;;; with the first block acting as the page table. Its first two bytes are $30 and $36 which are the MSBs of the addresses
                      (       fall64.asm):00047         ;;; of the allocated pages.
                      (       fall64.asm):00048         ;;; The next 256 byte page at $3600 has three of its four 64 byte blocks allocated and one remaining free. The first byte
                      (       fall64.asm):00049         ;;; of each of the allocated 64 byte blocks contains the MSB of the 256 byte address of its block.
                      (       fall64.asm):00050         
0409 AE44             (       fall64.asm):00051         FAll64              ldx       R$X,u     ; get base address of page table
040B 2608             (       fall64.asm):00052                             bne       notempty@ ; branch if not empty
040D 8D10             (       fall64.asm):00053                             bsr       Alloc256Bytes ; otherwise allocate memory for a new page table
040F 250D             (       fall64.asm):00054                             bcs       ex@       ; exit if error
0411 AF84             (       fall64.asm):00055                             stx       ,x        ; save off address of page table in newly allocated page
0413 AF44             (       fall64.asm):00056                             stx       R$X,u     ; and in caller's X
0415 8D1E             (       fall64.asm):00057         notempty@           bsr       Alloc64Bytes ; find a free 64 byte block to allocate
0417 2505             (       fall64.asm):00058                             bcs       ex@       ; branch if error
0419 A741             (       fall64.asm):00059                             sta       R$A,u     ; save the block number to caller's A
041B 10AF46           (       fall64.asm):00060                             sty       R$Y,u     ; and the address to the caller's Y
041E 39               (       fall64.asm):00061         ex@                 rts                 ; return to caller
                      (       fall64.asm):00062         
                      (       fall64.asm):00063         * Allocate a 256 byte page from system RAM
                      (       fall64.asm):00064         *
                      (       fall64.asm):00065         * Exit:  D = 0
                      (       fall64.asm):00066         *        X = The address of a newly allocated and cleared 256 bytes of RAM.
                      (       fall64.asm):00067         *       CC = Carry flag clear to indicate success.
                      (       fall64.asm):00068         *
                      (       fall64.asm):00069         * Error:  B = A non-zero error code.
                      (       fall64.asm):00070         *        CC = Carry flag set to indicate error.
041F 3440             (       fall64.asm):00071         Alloc256Bytes       pshs      u         ; save off caller's registers
0421 CC0100           (       fall64.asm):00072                             ldd       #256      ; we want to allocate 256 bytes
0424 103F28           (       fall64.asm):00073                             os9       F$SRqMem  ; request from system memory
0427 30C4             (       fall64.asm):00074                             leax      ,u        ; point X to start of newly allocated area
0429 3540             (       fall64.asm):00075                             puls      u         ; and recover U saved earlier
042B 2507             (       fall64.asm):00076                             bcs       ex@       ; branch if error
                      (       fall64.asm):00077         * clear out the newly allocated area
042D 4F               (       fall64.asm):00078                             clra                ; A = 0 (used to for clearing byte)
042E 5F               (       fall64.asm):00079                             clrb                ; B = 0 (used for 256 loop counter)
042F A78B             (       fall64.asm):00080         loop@               sta       d,x       ; clear byte at ,X
0431 5C               (       fall64.asm):00081                             incb                ; count loop up
0432 26FB             (       fall64.asm):00082                             bne       loop@     ; branch not zero (more to clear)
0434 39               (       fall64.asm):00083         ex@                 rts                 ; return to caller
                      (       fall64.asm):00084         
                      (       fall64.asm):00085         * Walk the 64 byte page table to allocate a 64 byte block of memory.
                      (       fall64.asm):00086         *
                      (       fall64.asm):00087         * Entry: X = The base address of the page table.
                      (       fall64.asm):00088         *
                      (       fall64.asm):00089         * Exit:  A = The allocated block number.
                      (       fall64.asm):00090         *        Y = The address of the allocated 64 byte block.
0435 3450             (       fall64.asm):00091         Alloc64Bytes        pshs      u,x       ; save caller's regs and base address of page table
0437 4F               (       fall64.asm):00092                             clra                ; A = 0
0438 3402             (       fall64.asm):00093         searchnext@         pshs      a         ; save on stack
043A 5F               (       fall64.asm):00094                             clrb                ; B = 0
043B A686             (       fall64.asm):00095                             lda       a,x       ; get byte at page table from index A; D now is address
043D 270B             (       fall64.asm):00096                             beq       pagefree@ ; branch if zero (no page allocated)
043F 1F02             (       fall64.asm):00097                             tfr       d,y       ; else put D in Y
0441 4F               (       fall64.asm):00098                             clra                ; clear A
0442 6DAB             (       fall64.asm):00099         checkpage@          tst       d,y       ; is this 64 byte page available?
0444 2706             (       fall64.asm):00100                             beq       pagefree2@ ; branch if it is
0446 CB40             (       fall64.asm):00101                             addb      #64       ; else add block size of 64 to B
0448 24F8             (       fall64.asm):00102                             bcc       checkpage@ ; and go check next block if B < 256
044A 1A01             (       fall64.asm):00103         pagefree@           orcc      #Carry    ; set carry flag to indicate this page is free and can be allocated
044C 31AB             (       fall64.asm):00104         pagefree2@          leay      d,y       ; point Y to the free 64 byte block
044E 3502             (       fall64.asm):00105                             puls      a         ; recover A from stack
0450 2425             (       fall64.asm):00106                             bcc       mark2@    ; branch if no page allocated (carry set earlier)
0452 4C               (       fall64.asm):00107                             inca                ; increment A
0453 8140             (       fall64.asm):00108                             cmpa      #64       ; at 64?
0455 25E1             (       fall64.asm):00109                             bcs       searchnext@ ; branch if less than 64
0457 4F               (       fall64.asm):00110                             clra                ; A = 0
