                      (       bin_rom.as):00001         ;;; BIN_HEX
                      (       bin_rom.as):00002         ;;;
                      (       bin_rom.as):00003         ;;; Binary to Roman number string conversion.
                      (       bin_rom.as):00004         ;;;
                      (       bin_rom.as):00005         ;;; Entry:  D = The binary value to convert.
                      (       bin_rom.as):00006         ;;;         X = The address of the 20-byte buffer that holds the roman numerals.
                      (       bin_rom.as):00007         ;;;
                      (       bin_rom.as):00008         ;;; Exit:  None.
                      (       bin_rom.as):00009         ;;;
                      (       bin_rom.as):00010         ;;; Note: the buffer should be set to 20 bytes. This permits the
                      (       bin_rom.as):00011         ;;; longest possible number to be converted without a buffer overflow.
                      (       bin_rom.as):00012         ;;; This routine truncates any numbers >8191 to ensure that no number
                      (       bin_rom.as):00013         ;;; is longer than 19 characters (plus the null terminator).
                      (       bin_rom.as):00014         ;;; The number 7888 converts to a 19 character string. To permit larger
                      (       bin_rom.as):00015         ;;; number conversions one could delete the anda #%00011111 statement.
                      (       bin_rom.as):00016         ;;;
                      (       bin_rom.as):00017         ;;; All registers (except CC) are preserved.
                      (       bin_rom.as):00018         
                      (       bin_rom.as):00019         * This routine has been converted from the BASIC09 sample in
                      (       bin_rom.as):00020         * the Basic09 Reference Manual (Microware) page a-3.
                      (       bin_rom.as):00021         
