0005                  (       cocovtio.d):00343         Wnd.VBar            RMB       1                   Vertical scroll bar marker 3D look
0006                  (       cocovtio.d):00344         Wnd.HBar            RMB       1                   Horizontal scroll bar marker 3D look
                      (       cocovtio.d):00345         **********************
                      (       cocovtio.d):00346         * Co(name) - Co-module screen driver entry points (CoWin, CoGrf, CoVDG, etc)
                      (       cocovtio.d):00347                             ORG       0
0000                  (       cocovtio.d):00348         CoInit              RMB       3                   $00 = Init Co-module entry
0003                  (       cocovtio.d):00349         CoWrite             RMB       3                   $03 = Write Co-module entry
0006                  (       cocovtio.d):00350         CoGetStt            RMB       3                   $06 = GetStat Co-module entry
0009                  (       cocovtio.d):00351         CoSetStt            RMB       3                   $09 = SetStat Co-module entry
000C                  (       cocovtio.d):00352         CoTerm              RMB       3                   $0C = Term Co-module entry
000F                  (       cocovtio.d):00353         CoWinSpc            RMB       3                   $0F = Window special processing functions (see below)
                      (       cocovtio.d):00354         *                                                  (sub function # in A on entry)
                      (       cocovtio.d):00355         
                      (       cocovtio.d):00356         **********************
                      (       cocovtio.d):00357         * CoWinSpc special functions (in A when CoWinSpc called)
                      (       cocovtio.d):00358                             ORG       0
0000                  (       cocovtio.d):00359         WnSpSlct            RMB       1                   $00 = Select different window
0001                  (       cocovtio.d):00360         WnSpStat            RMB       1                   $01 = Update Pt.Stat (mouse in content,control,external regions)
0002                  (       cocovtio.d):00361         WnSpUpCr            RMB       1                   $02 = Update text & mouse cursors
0003                  (       cocovtio.d):00362         WnSpAMse            RMB       1                   $03 = Update auto-follow mouse cursor
                      (       cocovtio.d):00363         
                      (       cocovtio.d):00364         * NOTE: KeyDrv merged back into VTIO in EOU Beta 6 (saves memory in OS9Boot, and 10 bytes
                      (       cocovtio.d):00365         *  in CC3 Global mem. And all third party keyboards plug into regular Coco keyboard anyways)
                      (       cocovtio.d):00366         **********************
                      (       cocovtio.d):00367         * KeyDrv Entry Points
                      (       cocovtio.d):00368         *               ORG       0
                      (       cocovtio.d):00369         *K$Init         RMB       3                   keyboard initialization (does nothing)
                      (       cocovtio.d):00370         *K$Term         RMB       3                   keyboard termination (does nothing)
                      (       cocovtio.d):00371         *K$FnKey        RMB       3                   get function key states (Gets F1/F2 key state)
                      (       cocovtio.d):00372         *K$RdKey        RMB       3                   get key states (Gets all other key states)
                      (       cocovtio.d):00373         
                      (       cocovtio.d):00374         **********************
                      (       cocovtio.d):00375         * JoyDrv Entry Points
                      (       cocovtio.d):00376                             ORG       0
0000                  (       cocovtio.d):00377         J$Init              RMB       3                   joystick initialization
0003                  (       cocovtio.d):00378         J$Term              RMB       3                   joystick termination
0006                  (       cocovtio.d):00379         J$MsBtn             RMB       3                   get mouse button states
0009                  (       cocovtio.d):00380         J$MsXY              RMB       3                   get mouse X/Y coordinates (returns high res values)
000C                  (       cocovtio.d):00381         J$JyBtn             RMB       3                   get joystick button states
000F                  (       cocovtio.d):00382         J$JyXY              RMB       3                   get joystick X/Y coordinates (returns low res values)
                      (       cocovtio.d):00383         
                      (       cocovtio.d):00384         **********************
                      (       cocovtio.d):00385         * SndDrv Entry Points
                      (       cocovtio.d):00386                             ORG       0
0000                  (       cocovtio.d):00387         S$Init              RMB       3                   sound initialization
0003                  (       cocovtio.d):00388         S$GetStt            RMB       3                   sound GetStats
0006                  (       cocovtio.d):00389         S$SetStt            RMB       3                   sound SetStats
0009                  (       cocovtio.d):00390         S$Term              RMB       3                   sound termination
                      (       cocovtio.d):00391         
                      (       cocovtio.d):00392         ********************************
                      (       cocovtio.d):00393         * Window/Menu Bar Data Structure
                      (       cocovtio.d):00394         *
                      (       cocovtio.d):00395         * To be used in SS.WnSet SETSTAT to set up a Framed Window
                      (       cocovtio.d):00396         * for use in the high level windowing package.
                      (       cocovtio.d):00397         *
     000A             (       cocovtio.d):00398         NUMMENS             EQU       10                  maximum number of menus on menu bar
     0014             (       cocovtio.d):00399         NUMITMS             EQU       20                  maximum number of items in a menu
     000F             (       cocovtio.d):00400         MXTTLEN             EQU       15                  max chars for menu and item names
     C0C0             (       cocovtio.d):00401         WINSYNC             EQU       $C0C0               synch bytes for window validation
                      (       cocovtio.d):00402         *
                      (       cocovtio.d):00403         * Menu Item Descriptor : (MN.ITEMS)
                      (       cocovtio.d):00404         * one required for each item within the menu
                      (       cocovtio.d):00405         *
                      (       cocovtio.d):00406                             ORG       0
0000                  (       cocovtio.d):00407         MI.TTL              RMB       MXTTLEN             item name
000F                  (       cocovtio.d):00408         MI.ENBL             RMB       1                   enable flag
0010                  (       cocovtio.d):00409         MI.RES              RMB       5                   reserved bytes
     0015             (       cocovtio.d):00410         MI.SIZ              EQU       .                   size of menu item descriptor
                      (       cocovtio.d):00411         *
                      (       cocovtio.d):00412         * Menu Descriptor :
                      (       cocovtio.d):00413         * one for each menu on the manu bar
                      (       cocovtio.d):00414         * each is pointed to by MB.MPTR below
                      (       cocovtio.d):00415         *
                      (       cocovtio.d):00416                             ORG       0
0000                  (       cocovtio.d):00417         MN.TTL              RMB       MXTTLEN             menu title
000F                  (       cocovtio.d):00418         MN.ID               RMB       1                   menu id number (1-255)
0010                  (       cocovtio.d):00419         MN.XSIZ             RMB       1                   horiz. size of desired pull down
0011                  (       cocovtio.d):00420         MN.NITS             RMB       1                   number of items in menu
0012                  (       cocovtio.d):00421         MN.ENBL             RMB       1                   enable flag
0013                  (       cocovtio.d):00422         MN.RES              RMB       2                   reserved bytes
0015                  (       cocovtio.d):00423         MN.ITEMS            RMB       2                   pointer to array of menu items
     0017             (       cocovtio.d):00424         MN.SIZ              EQU       .                   size of menu descriptor
                      (       cocovtio.d):00425         *
                      (       cocovtio.d):00426         * Window Descriptor:
                      (       cocovtio.d):00427         * one required for each application in a framed window
                      (       cocovtio.d):00428         *
                      (       cocovtio.d):00429                             ORG       0
0000                  (       cocovtio.d):00430         WN.TTL              RMB       20                  title of window for title bar
0014                  (       cocovtio.d):00431         WN.NMNS             RMB       1                   number of menus in menu bar
0015                  (       cocovtio.d):00432         WN.XMIN             RMB       1                   minimal horiz. size for application to run
0016                  (       cocovtio.d):00433         WN.YMIN             RMB       1                   minimal vert. size for application to run
0017                  (       cocovtio.d):00434         WN.SYNC             RMB       2                   synch bytes ($C0C0)
0019                  (       cocovtio.d):00435         WN.RES              RMB       7                   reserved bytes
0020                  (       cocovtio.d):00436         WN.BAR              RMB       2                   pointer to arry of menu descriptors
     0022             (       cocovtio.d):00437         WN.SIZ              EQU       .                   size of window/menu bar descriptor
                      (       cocovtio.d):00438         
                      (       cocovtio.d):00439         *************************
                      (       cocovtio.d):00440         * Window Type Definitions
                      (       cocovtio.d):00441         *
                      (       cocovtio.d):00442         * To be used in setting up the border of the window in
                      (       cocovtio.d):00443         * the SS.WnSel SETSTAT
                      (       cocovtio.d):00444         *
                      (       cocovtio.d):00445                             ORG       0
0000                  (       cocovtio.d):00446         WT.NBox             RMB       1                   No Box
0001                  (       cocovtio.d):00447         WT.FWin             RMB       1                   Framed Window
0002                  (       cocovtio.d):00448         WT.FSWin            RMB       1                   Framed Window w/Scroll Bars
0003                  (       cocovtio.d):00449         WT.SBox             RMB       1                   Shadowed Box
0004                  (       cocovtio.d):00450         WT.DBox             RMB       1                   Double Box
0005                  (       cocovtio.d):00451         WT.PBox             RMB       1                   Plain Box
                      (       cocovtio.d):00452         
                      (       cocovtio.d):00453         *************************************
                      (       cocovtio.d):00454         * Pre-Defined Menu IDs for the system
                      (       cocovtio.d):00455         *
                      (       cocovtio.d):00456                             ORG       1
0001                  (       cocovtio.d):00457         MId.Mov             RMB       1                   move box
0002                  (       cocovtio.d):00458         MId.Cls             RMB       1                   close box
0003                  (       cocovtio.d):00459         MId.Grw             RMB       1                   grow box
0004                  (       cocovtio.d):00460         MId.SUp             RMB       1                   scroll up
0005                  (       cocovtio.d):00461         MId.SDn             RMB       1                   scroll down
0006                  (       cocovtio.d):00462         MId.SRt             RMB       1                   scroll right
0007                  (       cocovtio.d):00463         MId.SLt             RMB       1                   scroll left
0008                  (       cocovtio.d):00464         MId.Chr             RMB       1                   character was depressed
                      (       cocovtio.d):00465                             ORG       20
0014                  (       cocovtio.d):00466         MId.Tdy             RMB       1                   Tandy menu
0015                  (       cocovtio.d):00467         MId.Fil             RMB       1                   Files Menu
0016                  (       cocovtio.d):00468         MId.Edt             RMB       1                   Edit Menu
0017                  (       cocovtio.d):00469         MId.Sty             RMB       1                   Styles menu
0018                  (       cocovtio.d):00470         MId.Fnt             RMB       1                   Font menu
