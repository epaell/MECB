                      (       cocovtio.d):00895         *****************************************************************************
                      (       cocovtio.d):00896         * Screen table entrys
                      (       cocovtio.d):00897         * These tables sit in system block 0 base=$1A80
                      (       cocovtio.d):00898         
     0010             (       cocovtio.d):00899         STblMax             EQU       16                  Maximum number of screen tables
     1A80             (       cocovtio.d):00900         STblBse             EQU       $1A80               base address of screen tables
                      (       cocovtio.d):00901                             ORG       0
0000                  (       cocovtio.d):00902         St.Sty              RMB       1                   Screen type                         $00
0001                  (       cocovtio.d):00903         St.SBlk             RMB       1                   Ram block start #                   $01
0002                  (       cocovtio.d):00904         St.LStrt            RMB       2                   Screen logical start (for GIME)     $02
0004                  (       cocovtio.d):00905         St.BRow             RMB       1                   Bytes per row                       $04
0005                  (       cocovtio.d):00906         St.Brdr             RMB       1                   Border palette register #           $05
0006                  (       cocovtio.d):00907         St.Fore             RMB       1                   Foreground palette register #       $06
0007                  (       cocovtio.d):00908         St.Back             RMB       1                   Background palette register #       $07
0008                  (       cocovtio.d):00909         St.ScSiz            RMB       1                   screen size: 24..28 lines           $08
0009                  (       cocovtio.d):00910         St.Res              RMB       7                   UNUSED???                           $09
                      (       cocovtio.d):00911         * NOTE: SHOULD USE ONE OF THESE UNUSED BYTES TO KEEP THE # OF DEVICE WINDOW
                      (       cocovtio.d):00912         * TABLES THAT ARE USING THIS SCREEN TABLE. DWSET & DWEND WOULD KEEP TRACK OF
                      (       cocovtio.d):00913         * THESE, AND THE WINDINT TITLE BAR ROUTINE WOULD CHECK IT. IF IT IS ONLY 1,
                      (       cocovtio.d):00914         * IT WON'T BOTHER CHANGING THE TITLE BAR WHEN SELECTING WINDOWS
                      (       cocovtio.d):00915         * Other possibilities: Offset into screen to display (if we enable screens taller than
                      (       cocovtio.d):00916         *   a single screen), etc.
0010                  (       cocovtio.d):00917         St.Pals             RMB       16                  Palette register contents           $10
     0020             (       cocovtio.d):00918         St.Siz              EQU       .
