                      (       cocovtio.d):00920         *****************************************************************************
                      (       cocovtio.d):00921         * Graphics buffer tables
                      (       cocovtio.d):00922         * They contain a 20 byte header (shown below), followed by the raw pixel
                      (       cocovtio.d):00923         * data.
                      (       cocovtio.d):00924                             ORG       0
0000                  (       cocovtio.d):00925         Grf.Bck             RMB       1                   back block link #                   $00
0001                  (       cocovtio.d):00926         Grf.Off             RMB       2                   back block header offset            $01
0003                  (       cocovtio.d):00927         Grf.Grp             RMB       1                   group #                             $03
0004                  (       cocovtio.d):00928         Grf.Buff            RMB       1                   buffer #                            $04
0005                  (       cocovtio.d):00929         Grf.BSz             RMB       2                   buffer size (not including header)  $05
0007                  (       cocovtio.d):00930         Grf.XSz             RMB       2                   X size (in pixels)                  $07
0009                  (       cocovtio.d):00931         Grf.YSz             RMB       2                   Y size (in pixels/bytes)            $09
000B                  (       cocovtio.d):00932         Grf.XBSz            RMB       1                   X size in bytes                     $0B
000C                  (       cocovtio.d):00933         Grf.LfPx            RMB       1                   # pixels used in first byte of line $0C
000D                  (       cocovtio.d):00934         Grf.RtPx            RMB       1                   # pixels used in last byte of line  $0D
000E                  (       cocovtio.d):00935         Grf.STY             RMB       1                   Screen type buffer intended for     $0E
000F                  (       cocovtio.d):00936         Grf.NBlk            RMB       1                   number blocks used                  $0F
0010                  (       cocovtio.d):00937         Grf.Pal             RMB       16                  THIS IS NOT PALETTE REGISTERS.      $10
                      (       cocovtio.d):00938         * Grf.Pal seems to be "reserved for future use", and we can use for the 8 char font names
                      (       cocovtio.d):00939         * that the level 2 upgrade used, with 8 reserved for future use? Could it be used for other
                      (       cocovtio.d):00940         * purposes with general get/put buffers as well, like block link #/offset to background masks
                      (       cocovtio.d):00941         * etc for sprites?
     0020             (       cocovtio.d):00942         Grf.Siz             EQU       .                   $20
                      (       cocovtio.d):00943         
                      (       cocovtio.d):00944         *****************************************************************************
                      (       cocovtio.d):00945         * GFX tables (1 for each window, 18 ($12) bytes each) pointed to by
                      (       cocovtio.d):00946         * $1075-$0176
                      (       cocovtio.d):00947         * GRFINT only uses gt0001-gt0004, the rest is exclusive to WINDINT
                      (       cocovtio.d):00948                             ORG       0
0000                  (       cocovtio.d):00949         Gt.WTyp             RMB       1                   WindInt window type (Framed, Scroll Bar, etc.) $00
0001                  (       cocovtio.d):00950         Gt.GXCur            RMB       2                   X coord of graphics cursor                     $01
0003                  (       cocovtio.d):00951         Gt.GYCur            RMB       2                   Y coord of graphics cursor                     $03
0005                  (       cocovtio.d):00952         Gt.DPtr             RMB       2                   Ptr to WindInt window descriptor               $05
0007                  (       cocovtio.d):00953         Gt.FClr             RMB       1                   Foreground color                               $07
0008                  (       cocovtio.d):00954         Gt.BClr             RMB       1                   Background color                               $08
0009                  (       cocovtio.d):00955         Gt.FMsk             RMB       1                   Foreground mask                                $09
000A                  (       cocovtio.d):00956         Gt.BMsk             RMB       1                   Background mask                                $0A
000B                  (       cocovtio.d):00957         Gt.GBlk             RMB       1                   Block # of graphics cursor                     $0B
000C                  (       cocovtio.d):00958         Gt.GOff             RMB       2                   Offset into block of graphics cursor           $0C
000E                  (       cocovtio.d):00959         Gt.Proc             RMB       1                   Process # of window creator                    $0E
000F                  (       cocovtio.d):00960         Gt.PBlk             RMB       1                   Process descriptor block # of creator          $0F
0010                  (       cocovtio.d):00961         Gt.Res              RMB       2                   ??? RESERVED ???                               $10
     0012             (       cocovtio.d):00962         GTabSz              EQU       .
