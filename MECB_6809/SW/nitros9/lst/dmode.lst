                      (l1/cmds/dmode.asm):00001         ********************************************************************
                      (l1/cmds/dmode.asm):00002         * DMode - Disk descriptor utility
                      (l1/cmds/dmode.asm):00003         *
                      (l1/cmds/dmode.asm):00004         * RBF descriptor utility similar to xmode.
                      (l1/cmds/dmode.asm):00005         * Use: dmode </devicename> [options]
                      (l1/cmds/dmode.asm):00006         *      dmode -<filename>   [options]
                      (l1/cmds/dmode.asm):00007         *       (allows dmode use on a saved desc)
                      (l1/cmds/dmode.asm):00008         *       (-filename will use data dir for default)
                      (l1/cmds/dmode.asm):00009         *      dmode -?  will give bit definitions
                      (l1/cmds/dmode.asm):00010         * If no options given, just returns desc info.
                      (l1/cmds/dmode.asm):00011         * All numbers must be in HEX.
                      (l1/cmds/dmode.asm):00012         * dmode
                      (l1/cmds/dmode.asm):00013         * dmode /h0 cyl=0200 sas=8 ilv=4
                      (l1/cmds/dmode.asm):00014         * dmode /d0
                      (l1/cmds/dmode.asm):00015         * dmode -?
                      (l1/cmds/dmode.asm):00016         * dmode -/d1/modules/d2.dd cyl=0028
                      (l1/cmds/dmode.asm):00017         *
                      (l1/cmds/dmode.asm):00018         * Edt/Rev  YYYY/MM/DD  Modified by
                      (l1/cmds/dmode.asm):00019         * Comment
