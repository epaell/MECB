                      (         defsfile):00002             use rbf.d
                      (            rbf.d):00001                             IFNE      RBF.D-1
                      (            rbf.d):00002         
     0001             (            rbf.d):00003         RBF.D               SET       1
                      (            rbf.d):00004         
                      (            rbf.d):00005         ********************************************************************
                      (            rbf.d):00006         * rbf.d - Random Block File Manager Definitions
                      (            rbf.d):00007         *
                      (            rbf.d):00008         * RBF stands for 'Random Block Filemanager' and is a package of subroutines
                      (            rbf.d):00009         * that define the logical structure of a disk and allows access to the files
                      (            rbf.d):00010         * in that structure.
                      (            rbf.d):00011         *
                      (            rbf.d):00012         * The data structures in this file give RBF its 'personality' and are used
                      (            rbf.d):00013         * by RBF itself, as well as applications that will require disk I/O.
                      (            rbf.d):00014         *
                      (            rbf.d):00015         * Edt/Rev  YYYY/MM/DD  Modified by
                      (            rbf.d):00016         * Comment
                      (            rbf.d):00017         * ------------------------------------------------------------------
                      (            rbf.d):00018         *          1982/07/13  Robert F. Doggett
                      (            rbf.d):00019         * PD.Exten added to path descriptor and PE Entries defined.
                      (            rbf.d):00020         *
                      (            rbf.d):00021         *          1982/07/15  Robert F. Doggett
                      (            rbf.d):00022         * V.FileHd inserted in driver static storage.
                      (            rbf.d):00023         *
                      (            rbf.d):00024         *          1982/09/10  WGP
                      (            rbf.d):00025         * Level One/Level Two condionals added.
                      (            rbf.d):00026         *
                      (            rbf.d):00027         *          1982/09/17  WGP
                      (            rbf.d):00028         *
                      (            rbf.d):00029         *          1982/09/17  Robert F. Doggett
                      (            rbf.d):00030         * PD.SLE renamed to PD.Creat.
                      (            rbf.d):00031         *
                      (            rbf.d):00032         *          1982/09/17  Robert F. Doggett
                      (            rbf.d):00033         * V.DiskID, V.BMapSz, V.MapSct added for smart multi-sector bitmap searching.
                      (            rbf.d):00034         *
                      (            rbf.d):00035         *          1982/09/20  Robert F. Doggett
                      (            rbf.d):00036         * Reserved areas added in static storage.
                      (            rbf.d):00037         
                      (            rbf.d):00038         *          1983/06/07  Robert F. Doggett
                      (            rbf.d):00039         * Added InDriver flag in PD.SMF.
                      (            rbf.d):00040         *
                      (            rbf.d):00041         *          1983/06/13  Robert F. Doggett
                      (            rbf.d):00042         * Added PE.Req tmp save for PE.Lock.
                      (            rbf.d):00043         *
                      (            rbf.d):00044         *          1983/08/08  Robert F. Doggett
                      (            rbf.d):00045         * Reserved PD.SToff for Japanese.
                      (            rbf.d):00046         *
                      (            rbf.d):00047         *          1983/11/19  Robert F. Doggett
                      (            rbf.d):00048         * Added V.ResBit in drive tables.
                      (            rbf.d):00049         *
                      (            rbf.d):00050         *          1983/12/12  Robert F. Doggett
                      (            rbf.d):00051         * Added PE.Prior to save process priority.
                      (            rbf.d):00052         *
                      (            rbf.d):00053         *          1983/12/13  Robert F. Doggett
                      (            rbf.d):00054         * Added BufBusy bit in state flag (PD.SMF).
                      (            rbf.d):00055         *
                      (            rbf.d):00056         *          1984/07/06  Mark G. Hawkins
                      (            rbf.d):00057         * Added Bit Definitions for DD.FMT.
                      (            rbf.d):00058         *
                      (            rbf.d):00059         *          1987/06/23  Kevin K. Darling
                      (            rbf.d):00060         * Updated with Dev Desc Info
                      (            rbf.d):00061         *
                      (            rbf.d):00062         *          2003/06/02  Boisy G. Pitre
                      (            rbf.d):00063         * Updated comments for clarity.
                      (            rbf.d):00064         * Added TYP.256-TYP.2048 definitions for future expansion.
                      (            rbf.d):00065         *
                      (            rbf.d):00066         *          2004/04/14  Boisy G. Pitre
                      (            rbf.d):00067         * Added new entries to device descriptor as per OS-9 Level One V2.00.00
