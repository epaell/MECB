     FFC0             (           coco.d):00133         A.TermV             SET       $FFC0               VDG Term
     FFC1             (           coco.d):00134         A.V1                SET       $FFC1               Possible additional VDG Devices
     FFC2             (           coco.d):00135         A.V2                SET       $FFC2
     FFC3             (           coco.d):00136         A.V3                SET       $FFC3
     FFC4             (           coco.d):00137         A.V4                SET       $FFC4
     FFC5             (           coco.d):00138         A.V5                SET       $FFC5
     FFC6             (           coco.d):00139         A.V6                SET       $FFC6
     FFC7             (           coco.d):00140         A.V7                SET       $FFC7
                      (           coco.d):00141         
                      (           coco.d):00142         
                      (           coco.d):00143                             IFEQ      Level-1
                      (           coco.d):00144         
                      (           coco.d):00145         ********************************
                      (           coco.d):00146         * Boot defs for NitrOS-9 Level 1
                      (           coco.d):00147         *
                      (           coco.d):00148         * These defs are not strictly for 'Boot', but are for booting the
                      (           coco.d):00149         * system.
                      (           coco.d):00150         *
     EE00             (           coco.d):00151         Bt.Start            EQU       $EE00               Start address of the boot track in memory
                      (           coco.d):00152         
                      (           coco.d):00153                             ELSE
                      (           coco.d):00154         
                      (           coco.d):00155         ******************************************
                      (           coco.d):00156         * Boot defs for NitrOS-9 Level 2 and above
                      (           coco.d):00157         *
                      (           coco.d):00158         * These defs are not strictly for 'Boot', but are for booting the
                      (           coco.d):00159         * system.
                      (           coco.d):00160         *
0004                  (           coco.d):00161         Bt.Start            SET       $ED00               Start address of the boot track in memory
0004                  (           coco.d):00162         Bt.Block            EQU       $3B                 Block to map in for the 'OS9BOOT' screen
0004                  (           coco.d):00163         Bt.Flag             EQU       $8A34               Flag in Bt.Block to verify that it's unchanged
0004                  (           coco.d):00164         Bt.Offst            EQU       2                   Offset into the screen where the current ptr is
                      (           coco.d):00165         
                      (           coco.d):00166                             ENDC
                      (           coco.d):00167         
                      (           coco.d):00168         * On the CoCo, the boot track is all of track 34
                      (           coco.d):00169         
     0022             (           coco.d):00170         Bt.Track            EQU       34                  Boot track
     0000             (           coco.d):00171         Bt.Sec              EQU       0                   Start LSN of boot area on boot track
                      (           coco.d):00172         
                      (           coco.d):00173         
     1080             (           coco.d):00174         Bt.Size             EQU       $1080               Maximum size of bootfile
                      (           coco.d):00175         
                      (           coco.d):00176         
                      (           coco.d):00177                             IFEQ      Level-1
                      (           coco.d):00178         
                      (           coco.d):00179         *************************************************
                      (           coco.d):00180         *
                      (           coco.d):00181         * NitrOS-9 Level 1 Section
                      (           coco.d):00182         *
                      (           coco.d):00183         *************************************************
                      (           coco.d):00184         
     00FF             (           coco.d):00185         HW.Page             SET       $FF                 Device descriptor hardware page
                      (           coco.d):00186         
                      (           coco.d):00187                             ELSE
                      (           coco.d):00188         
                      (           coco.d):00189         *************************************************
                      (           coco.d):00190         *
                      (           coco.d):00191         * NitrOS-9 Level 2 Section
                      (           coco.d):00192         *
                      (           coco.d):00193         *************************************************
                      (           coco.d):00194         
                      (           coco.d):00195         ****************************************
                      (           coco.d):00196         * Dynamic Address Translator Definitions
                      (           coco.d):00197         *
0004                  (           coco.d):00198         DAT.BlCt            EQU       8                   D.A.T. blocks/address space
0004                  (           coco.d):00199         DAT.BlSz            EQU       (256/DAT.BlCt)*256  D.A.T. block size
0004                  (           coco.d):00200         DAT.ImSz            EQU       DAT.BlCt*2          D.A.T. Image size
0004                  (           coco.d):00201         DAT.Addr            EQU       -(DAT.BlSz/256)     D.A.T. MSB Address bits
0004                  (           coco.d):00202         DAT.Task            EQU       $FF91               Task Register address
0004                  (           coco.d):00203         DAT.TkCt            EQU       32                  Number of DAT Tasks
0004                  (           coco.d):00204         DAT.Regs            EQU       $FFA0               DAT Block Registers base address
0004                  (           coco.d):00205         DAT.Free            EQU       $333E               Free Block Number
0004                  (           coco.d):00206         DAT.BlMx            EQU       $3F                 Maximum Block number
0004                  (           coco.d):00207         DAT.BMSz            EQU       $40                 Memory Block Map size
0004                  (           coco.d):00208         DAT.WrPr            EQU       0                   no write protect
0004                  (           coco.d):00209         DAT.WrEn            EQU       0                   no write enable
0004                  (           coco.d):00210         SysTask             EQU       0                   Coco System Task number
0004                  (           coco.d):00211         IOBlock             EQU       $3F
0004                  (           coco.d):00212         ROMBlock            EQU       $3F
0004                  (           coco.d):00213         IOAddr              EQU       $7F
0004                  (           coco.d):00214         ROMCount            EQU       1                   number of blocks of ROM (High RAM Block)
0004                  (           coco.d):00215         RAMCount            EQU       1                   initial blocks of RAM
0004                  (           coco.d):00216         MoveBlks            EQU       DAT.BlCt-ROMCount-2 Block numbers used for copies
0004                  (           coco.d):00217         BlockTyp            EQU       1                   chk only first bytes of RAM block
0004                  (           coco.d):00218         ByteType            EQU       2                   chk entire block of RAM
0004                  (           coco.d):00219         Limited             EQU       1                   chk only upper memory for ROM modules
0004                  (           coco.d):00220         UnLimitd            EQU       2                   chk all NotRAM for modules
                      (           coco.d):00221         * NOTE: this check assumes any NotRAM with a module will
                      (           coco.d):00222         *       always start with $87CD in first two bytes of block
0004                  (           coco.d):00223         RAMCheck            EQU       BlockTyp            chk only beg bytes of block
0004                  (           coco.d):00224         ROMCheck            EQU       Limited             chk only upper few blocks for ROM
0004                  (           coco.d):00225         LastRAM             EQU       IOBlock             maximum RAM block number
                      (           coco.d):00226         
                      (           coco.d):00227         ***************************
                      (           coco.d):00228         * Color Computer 3 Specific
                      (           coco.d):00229         *
0004                  (           coco.d):00230         MappedIO            EQU       true                (Actually False but it works better this way)
                      (           coco.d):00231         
                      (           coco.d):00232         ********************
                      (           coco.d):00233         * Hardware addresses
                      (           coco.d):00234         *
0004                  (           coco.d):00235         GIMERegs            EQU       $FF00               Base address of GIME registers
0004                  (           coco.d):00236         IrqEnR              EQU       $FF92               GIME IRQ enable/status register
0004                  (           coco.d):00237         BordReg             EQU       $FF9A               Border color register
0004                  (           coco.d):00238         PalAdr              EQU       $FFB0               Palette registers
                      (           coco.d):00239         
0004                  (           coco.d):00240         HW.Page             SET       $07                 Device descriptor hardware page
                      (           coco.d):00241         
                      (           coco.d):00242         * KrnBlk defines the block number of the 8K RAM block that is mapped to
                      (           coco.d):00243         * the top of CPU address space ($E000-$FFFF) for the system process, and
                      (           coco.d):00244         * which holds the Kernel. The top 2 pages of this CPU address space ($FFE0-
                      (           coco.d):00245         * $FFFF) has two special properties. Firstly, it contains the I/O space.
                      (           coco.d):00246         * Secondly, the parts that contain RAM map are not affected by the DAT
                      (           coco.d):00247         * mappings but, instead, *always* map that RAM to a fixed RAM block
                      (           coco.d):00248         * (KrnBlk). When a user process is mapped in, and requests enough memory,
                      (           coco.d):00249         * it will end up with its own block assigned for CPU address space $E000-
                      (           coco.d):00250         * $FFFF but the top of the address space is unusable by the user process:
                      (           coco.d):00251         * it still contains the I/O and the bit of RAM that's mapped to KrnBlk.
                      (           coco.d):00252         * Usually, the value of KrnBlk is fixed for a particular hardware design;
                      (           coco.d):00253         * For the COCO GIME, it's always $3F.
0004                  (           coco.d):00254         KrnBlk              SET       $3F
                      (           coco.d):00255         
                      (           coco.d):00256                             ENDC
                      (           coco.d):00257                             ENDC
                      (           coco.d):00258         
                      (        ccide.asm):00171                             endc
                      (        ccide.asm):00172         
     00E1             (        ccide.asm):00173         tylg                set       Drivr+Objct
     0081             (        ccide.asm):00174         atrv                set       ReEnt+rev
     0001             (        ccide.asm):00175         rev                 set       $01
     0008             (        ccide.asm):00176         edition             equ       8
                      (        ccide.asm):00177         
0000 87CD0669000EE181 (        ccide.asm):00178                             mod       eom,name,tylg,atrv,start,size
     B4013C03DE
                      (        ccide.asm):00179         
                      (        ccide.asm):00180         * NOTE: OS9 WILL ALWAYS ASSIGN DRIVER MEM SPACE ON AN EVEN 256 BYTE PAGE,
                      (        ccide.asm):00181         *   SO TAKE ADVANTAGE OF "EXTRA" SPACE!
                      (        ccide.asm):00182         
                      (        ccide.asm):00183                             org       0
0000.                 (        ccide.asm):00184                             rmb       DRVBEG+(DRVMEM*NUMDRIVE)
                      (        ccide.asm):00185         * Start of driver-specific statics
01B1.                 (        ccide.asm):00186         SlpCntr             rmb       2                   # ticks left before we give up on a read/write
01B3.                 (        ccide.asm):00187         PhysDrv             rmb       1                   Physical drive # (for quick lookup)
01B4.                 (        ccide.asm):00188         DriveFlg            rmb       NUMDRIVE            1 byte per drive (bit flags)
01BF.                 (        ccide.asm):00189         OS9LSN              rmb       3                   LSN of current OS-9 256-byte sector
                      (        ccide.asm):00190         * IDE spec can handle 28 bits (4 bits of 4th byte) for LBA mode. Since OS9
                      (        ccide.asm):00191         *   can't get that high anyways, we only work with 3, and then use the offset
                      (        ccide.asm):00192         *   partition value to bump it up beyond the 4 GB mark.
01C2.                 (        ccide.asm):00193         OS9PSN              rmb       3                   PSN of current OS9 sector (512 byte)
01C5.                 (        ccide.asm):00194         DrivMask            rmb       1                   Drive # (0 or 1) for IDE (in proper bit position)
01C6.                 (        ccide.asm):00195         idecmd              rmb       1                   1 byte IDE command code
01C7.                 (        ccide.asm):00196         identcmd            rmb       1                   1 byte IDE Identify drive code
                      (        ccide.asm):00197         
                      (        ccide.asm):00198         * Following flag is because the IDE interface can NOT access a 2nd drive
                      (        ccide.asm):00199         *   while the 1st drive is completing a read or write. Because of shared
                      (        ccide.asm):00200         *   device memory variables, this flag is set even on cached entries.
01C8.                 (        ccide.asm):00201         drvrbusy            rmb       1                   Driver busy flag (0=not busy)
                      (        ccide.asm):00202         
                      (        ccide.asm):00203         * Following for CHS mode drives only!
01C9.                 (        ccide.asm):00204         Head                rmb       1                   Head # (s/b base 0)
01CA.                 (        ccide.asm):00205         Cylinder            rmb       2                   Cylinder #
01CC.                 (        ccide.asm):00206         CHSSect             rmb       1                   CHS mode sector #
01CD.                 (        ccide.asm):00207         CHSSPT              rmb       2                   CHS mode sectors/track
                      (        ccide.asm):00208         
                      (        ccide.asm):00209         * Buffer/cache variables
01CF.                 (        ccide.asm):00210         LSN0Flag            rmb       1                   $FF=Not LSN0, $00=LSN0
01D0.                 (        ccide.asm):00211         Sect0Drv            rmb       1                   Drive # of LSN0 currently buffered ($FF=none)
01D1.                 (        ccide.asm):00212         Sect0Ofs            rmb       2                   Offset value for current LSN0 buffered drive
01D3.                 (        ccide.asm):00213         TempHalf            rmb       3                   Temp spot to hold other half calculation
01D6.                 (        ccide.asm):00214         HalfDrv             rmb       1                   Drive # of HalfBuff buffered ($FF=none)
01D7.                 (        ccide.asm):00215         HalfOfs             rmb       2                   Offset value for drive for current cached sector
01D9.                 (        ccide.asm):00216         HalfSct             rmb       3                   OS9 sector # of half sector not asked for
01DC.                 (        ccide.asm):00217         TempOfs             rmb       2                   Temporary copy of partition offset
                      (        ccide.asm):00218         
                      (        ccide.asm):00219         * NOTE: When 8k block buffering is added, move both of these to that block.
                      (        ccide.asm):00220         *   Of course, if removable media, re-read LSN0 physically every time. At that
                      (        ccide.asm):00221         *   time, we should make tables here instead (32 entries per drive up to the
                      (        ccide.asm):00222         *   maximum # of drives) of LSN #'s buffered (3 bytes/entry).
01DE.                 (        ccide.asm):00223         Sect0               rmb       256                 Buffer for LSN0
02DE.                 (        ccide.asm):00224         HalfBuff            rmb       256                 Buffer for other half of 512 byte phys. sector
     03DE             (        ccide.asm):00225         size                equ       .
                      (        ccide.asm):00226         
000D FF               (        ccide.asm):00227                             fcb       $FF                 mode byte
                      (        ccide.asm):00228         
000E 43434944C5       (        ccide.asm):00229         name                fcs       /CCIDE/             module name
                      (        ccide.asm):00230         
                      (        ccide.asm):00231         * INIT - appears to only be called on 1ST try on ANY IDE device IF link counts
                      (        ccide.asm):00232         *   are 0.
                      (        ccide.asm):00233         * Y = address of path descriptor (but
                      (        ccide.asm):00234         * U = address of driver memory (ie, of V.PAGE)
                      (        ccide.asm):00235         * Inits the drive table, and the DriveFlg table
0013 CC800B           (        ccide.asm):00236         Init                ldd       #$8000+NUMDRIVE     Flag that special drive flags are all unused
0016 30C901B4         (        ccide.asm):00237                             leax      DriveFlg,u
001A A780             (        ccide.asm):00238         DrvFlgLp            sta       ,x+
001C 5A               (        ccide.asm):00239                             decb
001D 26FB             (        ccide.asm):00240                             bne       DrvFlgLp
001F 304F             (        ccide.asm):00241         GoInit              leax      DRVBEG,u            Point to start of drive tables
0021 CCFF0B           (        ccide.asm):00242                             ldd       #$FF00+NUMDRIVE
0024 E746             (        ccide.asm):00243                             stb       V.NDRV,u            Max # of drives
0026 A7C901D0         (        ccide.asm):00244                             sta       Sect0Drv,u          Flag that no LSN0 is buffered
002A A7C901D6         (        ccide.asm):00245                             sta       HalfDrv,u           Flag that we have no half sector buffered
002E A784             (        ccide.asm):00246         NextDrv             sta       DD.TOT,x            Set Total # of sectors to illegal value
0030 A78815           (        ccide.asm):00247                             sta       V.TRAK,x            Non 0, so 1st seek can read Track 0
0033 308826           (        ccide.asm):00248                             leax      DRVMEM,x            Point to next drive
0036 5A               (        ccide.asm):00249                             decb                          Dec # of drives left
0037 26F5             (        ccide.asm):00250                             bne       NextDrv             Still more, init them too
0039 5F               (        ccide.asm):00251                             clrb                          No error & return
003A 39               (        ccide.asm):00252                             rts
                      (        ccide.asm):00253         
                      (        ccide.asm):00254         * Do drive diagnostic (use CHS mode) - Do not worry about ATAPI at this point
                      (        ccide.asm):00255         * Entry: U=driver mem ptr
                      (        ccide.asm):00256         *        Y=path descriptor
                      (        ccide.asm):00257         *        B=Identify command
                      (        ccide.asm):00258         * Exit:  CC clear - drive ready to send info
                      (        ccide.asm):00259         *        CC set   - error from drive, B contains raw error register
                      (        ccide.asm):00260         * TRASHES X - does timeout (CHECK - WILL SOME DRIVES TAKE TOO LONG?)
                      (        ccide.asm):00261         * This is called by INIT, and should also be called by a GETSTAT at some
                      (        ccide.asm):00262         *  point.
003B 3420             (        ccide.asm):00263         Ident               pshs      y                   Save path descriptor
003D E7C901C7         (        ccide.asm):00264                             stb       identcmd,u          Save which Ident we are doing
0041 10AE41           (        ccide.asm):00265                             ldy       V.PORT,u            Get IDE controller address
0044 A6C901C5         (        ccide.asm):00266         DoIdent             lda       DrivMask,u          Get drive # requested
0048 8AA0             (        ccide.asm):00267                             ora       #%10100000          Mask in head 0 & CHS mode
004A ED26             (        ccide.asm):00268                             std       DevHead,y           Send drive/head to controller, and IDENTIFY
                      (        ccide.asm):00269         * Note, if person booting from ROM, drive may not have spun up yet. See if
                      (        ccide.asm):00270         *   we can check some sort of status or error flag that indicates drive is
                      (        ccide.asm):00271         *   still firing up, if this is a problem.
004C 8EA000           (        ccide.asm):00272                             ldx       #$a000              Arbitrary amount of time to give up
004F A627             (        ccide.asm):00273         WaitIdnt            lda       Status,y            Get Status register
0051 2B08             (        ccide.asm):00274                             bmi       NoErr               Busy, drop counter
0053 8501             (        ccide.asm):00275                             bita      #ErrorFnd           Error?
0055 2704             (        ccide.asm):00276                             beq       NoErr               No, continue
0057 E621             (        ccide.asm):00277                             ldb       Error,y             Get error code
0059 200A             (        ccide.asm):00278                             bra       BadIdent
                      (        ccide.asm):00279         
005B 8158             (        ccide.asm):00280         NoErr               cmpa      #DrvReady+SeekDone+DataReq Drive ready to send Identify data?
005D 2709             (        ccide.asm):00281                             beq       GotIdent            Yep, exit out
005F 301F             (        ccide.asm):00282                             leax      -1,x                Drop timer
0061 26EC             (        ccide.asm):00283                             bne       WaitIdnt            Keep trying
0063 C6F6             (        ccide.asm):00284                             ldb       #E$NotRdy           Timed out, device not ready error
0065 43               (        ccide.asm):00285         BadIdent            coma                          Flag error
0066 35A0             (        ccide.asm):00286                             puls      y,pc                Restore path descriptor & return
                      (        ccide.asm):00287         
0068 5F               (        ccide.asm):00288         GotIdent            clrb                          No error
0069 35A0             (        ccide.asm):00289                             puls      y,pc                Restore path descriptor & return
                      (        ccide.asm):00290         
                      (        ccide.asm):00291         * Send Identify drive command (ATA or ATAPI - see identcmd,u), update DriveFlg
                      (        ccide.asm):00292         *   table
                      (        ccide.asm):00293         * PLEASE NOTE: The 2 identify commands are mutually exclusive; it will fail
                      (        ccide.asm):00294         *  with an 'Aborted' error if the wrong Identify is used.
                      (        ccide.asm):00295         *  UNLIKE A NORMAL READ OF A SECTOR, THE INFORMATION CONTAINED IN THE IDENTIFY
                      (        ccide.asm):00296         *  DRIVE COMMAND IS ALL IN INTEL ORDER WORD (16 BITS)
                      (        ccide.asm):00297         * Entry: Y=Ptr to path descriptor
                      (        ccide.asm):00298         *        U=Ptr to driver memory
                      (        ccide.asm):00299         * X IS DESTROYED!
                      (        ccide.asm):00300         * Exit:  CC=0 if DriveFlg properly updated
                      (        ccide.asm):00301         *          & A=DriveFlg value from update entry in table
                      (        ccide.asm):00302         *        CC=1, B=error if Identify Drive failed
                      (        ccide.asm):00303         *        DriveFlg,u - the proper flags for the specified controller/drive are
                      (        ccide.asm):00304         *                     updated
                      (        ccide.asm):00305         *        Sect0 contains 1st 256 bytes, HalfBuff contains 2nd half
