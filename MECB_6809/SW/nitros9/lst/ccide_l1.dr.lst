006E C6EC             (        ccide.asm):00307                             ldb       #Identify
0070 8DC9             (        ccide.asm):00308                             bsr       Ident               Send identify drive command to controller
0072 240A             (        ccide.asm):00309                             bcc       DoInfo              Worked, Do info
0074 C504             (        ccide.asm):00310                             bitb      #%00000100          Error, Aborted Flag set?
0076 2757             (        ccide.asm):00311                             beq       ExitIdnt            No, exit with other error
0078 C6A1             (        ccide.asm):00312                             ldb       #PIIdent            Try ATAPI identify
007A 8DBF             (        ccide.asm):00313                             bsr       Ident
007C 2551             (        ccide.asm):00314                             bcs       ExitIdnt            That didn't work either, abort
007E 30C901DE         (        ccide.asm):00315         DoInfo              leax      Sect0,u             Point to buffer
                      (        ccide.asm):00316         * NOTE: INIT routine only gets called when the DRIVER is Initing...not every
                      (        ccide.asm):00317         *   device. Hence, READ/WRITE must check the DriveFlg settings and make sure
                      (        ccide.asm):00318         *   the hi bit is clear for the drive it is using, to indicate that it HAS
