                      (       setup90.as):00626         *
                      (       setup90.as):00627         *   The SETUPB routine is used to insert the PROCESS I.D. number into
                      (       setup90.as):00628         * the GROUP BUFFER numbers of the GETBLK and PUTBLK strings.
                      (       setup90.as):00629         *   This had me stumped for a while because the draw codes are in FCB's
                      (       setup90.as):00630         * in the program area, which legally in OS9 can't be changed. The way I
                      (       setup90.as):00631         * found to get around this is that since the memory area for the board array
                      (       setup90.as):00632         * has already been allocated (3726 bytes), but it has not yet been filled,
                      (       setup90.as):00633         * all the object draw fcb's can be transfered to this memory area and as
                      (       setup90.as):00634         * the data is transfered I change the dummy GROUP BUFFER (254) number in
                      (       setup90.as):00635         * the GETBLK and PUTBLK commands, to the PROCESS I.D. number.
                      (       setup90.as):00636         *
                      (       setup90.as):00637         
0F72 31C90000         (       setup90.as):00638         SETUPB              leay      ARRAY,U             Point to where data is to go
0F76 308DF086         (       setup90.as):00639                             leax      PALSET,pcr          Point to FCB's to read
0F7A A680             (       setup90.as):00640         TRLOOP              lda       ,X+                 Get a byte from program area
0F7C 81FF             (       setup90.as):00641                             cmpa      #255                255 = end of data
0F7E 270B             (       setup90.as):00642                             beq       WRTOUT              If so, then go write it out
0F80 81FE             (       setup90.as):00643                             cmpa      #254                Do we put I.D. here ?
0F82 2603             (       setup90.as):00644                             bne       TRSTOR              If not, then store this byte
0F84 B60000           (       setup90.as):00645                             lda       PROCID              If so, then get process I.D. byte
0F87 A7A0             (       setup90.as):00646         TRSTOR              sta       ,Y+                 Store byte in data area
0F89 20EF             (       setup90.as):00647                             bra       TRLOOP              Loop till end of FCB's (255)
                      (       setup90.as):00648         
                      (       setup90.as):00649         *     The fcb's have been transfered so now output them to path
                      (       setup90.as):00650         
0F8B 30C90000         (       setup90.as):00651         WRTOUT              leax      ARRAY,U             Point to where FCB data was put
0F8F 108E08A7         (       setup90.as):00652                             ldy       #SETLEN-1           Get byte count to output
0F93 B60000           (       setup90.as):00653                             lda       PATH                Set output path
0F96 103F00           (       setup90.as):00654                             os9       I$Write             Go output data
0F99 10250000         (       setup90.as):00655                             lbcs      ERR1                Branch if any errors
0F9D 39               (       setup90.as):00656                             rts
