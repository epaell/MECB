                      (       datmod.asm):00001         * F$DatMod
                      (       datmod.asm):00002         *
                      (       datmod.asm):00003         * Entry:
                      (       datmod.asm):00004         *     A = Type/Language
                      (       datmod.asm):00005         *     B = Attr/Rev
                      (       datmod.asm):00006         *     X = address of name
                      (       datmod.asm):00007         *     Y = size
                      (       datmod.asm):00008         *
                      (       datmod.asm):00009         * Exit:
                      (       datmod.asm):00010         *     X = address of last byte of name + 1
                      (       datmod.asm):00011         *     Y = module entry point address
                      (       datmod.asm):00012         *     U = module header address
                      (       datmod.asm):00013         
     0001             (       datmod.asm):00014         Level               equ       1
                      (       datmod.asm):00015         
                      (       datmod.asm):00016                             ifp1
                      (       datmod.asm):00017                             use       defsfile
                      (         defsfile):00001                 IFEQ    Level
0000                  (         defsfile):00002         Level   equ     2
                      (         defsfile):00003                 ENDC
                      (         defsfile):00004         
                      (         defsfile):00005                 use     os9.d
                      (            os9.d):00001                             IFNE      OS9.D-1
                      (            os9.d):00002         
     0001             (            os9.d):00003         OS9.D               SET       1
