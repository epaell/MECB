     0001             (           coco.d):00002         COCO.D              SET       1
                      (           coco.d):00003         
                      (           coco.d):00004         ********************************************************************
                      (           coco.d):00005         * CoCoDefs - NitrOS-9 System Definitions for the Tandy Color Computer
                      (           coco.d):00006         *
                      (           coco.d):00007         * Edt/Rev  YYYY/MM/DD  Modified by
                      (           coco.d):00008         * Comment
                      (           coco.d):00009         * ------------------------------------------------------------------
                      (           coco.d):00010         *          1998/10/13  Boisy G. Pitre
                      (           coco.d):00011         * Added defs by Bruce Isted from his Eliminator archive.
                      (           coco.d):00012         *
                      (           coco.d):00013         *          1998/10/31  Boisy G. Pitre
                      (           coco.d):00014         * Merged cc3global.defs into this file.
                      (           coco.d):00015         *
                      (           coco.d):00016         *          2002/04/30  Boisy G. Pitre
                      (           coco.d):00017         * Merged Level One and Level Two sysdefs.
                      (           coco.d):00018         *
                      (           coco.d):00019         *          2002/06/22  Boisy G. Pitre
                      (           coco.d):00020         * Removed PIA.U4 and PIA.U8, improved comments
                      (           coco.d):00021         *
                      (           coco.d):00022         *          2003/11/05  Robert Gault
                      (           coco.d):00023         * Made changes in window globals and grfdrv memory to handle regW
                      (           coco.d):00024         * in 6809 systems.
                      (           coco.d):00025         *
                      (           coco.d):00026         *          2003/11/30  Boisy G. Pitre
                      (           coco.d):00027         * Statics now are prefaced with V. to identify them easier in source.
                      (           coco.d):00028         *
                      (           coco.d):00029         *          2004/07/18  Boisy G. Pitre
                      (           coco.d):00030         * Moved CoCo 3 Window stuff into cc3iodefs
                      (           coco.d):00031         *
                      (           coco.d):00032         *          2012/02/24  Boisy G. Pitre
                      (           coco.d):00033         * Consolidated all CoCo-specific defs files into here.
                      (           coco.d):00034         
                      (           coco.d):00035                             NAM       CoCoDefs
                      (           coco.d):00036                             IFEQ      Level-1
                      (           coco.d):00037                             TTL       NitrOS-9            System Definitions for the Tandy Color Computer
                      (           coco.d):00038                             ELSE
                      (           coco.d):00039                             IFEQ      Level-2
                      (           coco.d):00040                             TTL       NitrOS-9            Level 2 System Type Definitions
                      (           coco.d):00041                             ELSE
                      (           coco.d):00042                             IFEQ      Level-3
                      (           coco.d):00043                             TTL       NitrOS-9            Level 3 System Type Definitions
                      (           coco.d):00044                             ENDC
                      (           coco.d):00045                             ENDC
                      (           coco.d):00046                             ENDC
                      (           coco.d):00047         
                      (           coco.d):00048         
                      (           coco.d):00049         **********************
                      (           coco.d):00050         * CPU Type Definitions
                      (           coco.d):00051         *
     0001             (           coco.d):00052         Color               SET       1
     0002             (           coco.d):00053         Color3              SET       2
                      (           coco.d):00054                             IFEQ      Level-1
     0001             (           coco.d):00055         CPUType             SET       Color
                      (           coco.d):00056                             ELSE
00FF                  (           coco.d):00057         CPUType             SET       Color3
                      (           coco.d):00058                             ENDC
                      (           coco.d):00059         
                      (           coco.d):00060         
                      (           coco.d):00061         ******************************
                      (           coco.d):00062         * Clock Speed Type Definitions
                      (           coco.d):00063         *
     0001             (           coco.d):00064         OneMHz              EQU       1
     0002             (           coco.d):00065         TwoMHz              EQU       2
                      (           coco.d):00066                             IFEQ      CPUType-Color
     0001             (           coco.d):00067         CPUSpeed            SET       OneMHz
                      (           coco.d):00068                             ELSE
00FF                  (           coco.d):00069         CPUSpeed            SET       TwoMHz
                      (           coco.d):00070                             ENDC
                      (           coco.d):00071         
                      (           coco.d):00072         
                      (           coco.d):00073         **********************************
                      (           coco.d):00074         * Power Line Frequency Definitions
                      (           coco.d):00075         *
     0032             (           coco.d):00076         Hz50                EQU       50                  Assemble clock for 50 hz power
     003C             (           coco.d):00077         Hz60                EQU       60                  Assemble clock for 60 hz power
                      (           coco.d):00078                             IFNDEF    PwrLnFrq
     003C             (           coco.d):00079         PwrLnFrq            SET       Hz60                Set to Appropriate freq
                      (           coco.d):00080                             ENDC
                      (           coco.d):00081         
                      (           coco.d):00082         
                      (           coco.d):00083         **********************************
                      (           coco.d):00084         * Ticks per second
                      (           coco.d):00085         *
                      (           coco.d):00086                             IFNDEF    TkPerSec
                      (           coco.d):00087                             IFEQ      PwrLnFrq-Hz50
00FF                  (           coco.d):00088         TkPerSec            SET       50
                      (           coco.d):00089                             ELSE
     003C             (           coco.d):00090         TkPerSec            SET       60
                      (           coco.d):00091                             ENDC
                      (           coco.d):00092                             ENDC
                      (           coco.d):00093         
                      (           coco.d):00094         
                      (           coco.d):00095         ******************
                      (           coco.d):00096         * ACIA type set up
                      (           coco.d):00097         *
                      (           coco.d):00098                             ORG       1
0001                  (           coco.d):00099         ACIA6850            RMB       1                   MC6850 acia.
0002                  (           coco.d):00100         ACIA6551            RMB       1                   SY6551 acia.
0003                  (           coco.d):00101         ACIA2661            RMB       1                   SC2661 acia.
     0002             (           coco.d):00102         ACIATYPE            SET       ACIA6551
                      (           coco.d):00103         
                      (           coco.d):00104         
                      (           coco.d):00105         ****************************************
                      (           coco.d):00106         * Special character Bit position equates
                      (           coco.d):00107         *
     0001             (           coco.d):00108         SHIFTBIT            EQU       %00000001
     0002             (           coco.d):00109         CNTRLBIT            EQU       %00000010
     0004             (           coco.d):00110         ALTERBIT            EQU       %00000100
     0008             (           coco.d):00111         UPBIT               EQU       %00001000
     0010             (           coco.d):00112         DOWNBIT             EQU       %00010000
     0020             (           coco.d):00113         LEFTBIT             EQU       %00100000
     0040             (           coco.d):00114         RIGHTBIT            EQU       %01000000
     0080             (           coco.d):00115         SPACEBIT            EQU       %10000000
                      (           coco.d):00116         
                      (           coco.d):00117         
                      (           coco.d):00118         ******************
                      (           coco.d):00119         * Device addresses for miscellaneous hardware
                      (           coco.d):00120         *
     FF68             (           coco.d):00121         A.AciaP             SET       $FF68               Aciapak Address
     FF6C             (           coco.d):00122         A.ModP              SET       $FF6C               ModPak Address
     FF40             (           coco.d):00123         DPort               SET       $FF40               Disk controller base address
     FF7F             (           coco.d):00124         MPI.Slct            SET       $FF7F               Multi-Pak slot select
     0003             (           coco.d):00125         MPI.Slot            SET       $03                 Multi-Pak default slot
     FF00             (           coco.d):00126         PIA0Base            EQU       $FF00
     FF20             (           coco.d):00127         PIA1Base            EQU       $FF20
                      (           coco.d):00128         
                      (           coco.d):00129         
                      (           coco.d):00130         ******************
                      (           coco.d):00131         * VDG Devices
                      (           coco.d):00132         *
     FFC0             (           coco.d):00133         A.TermV             SET       $FFC0               VDG Term
     FFC1             (           coco.d):00134         A.V1                SET       $FFC1               Possible additional VDG Devices
     FFC2             (           coco.d):00135         A.V2                SET       $FFC2
     FFC3             (           coco.d):00136         A.V3                SET       $FFC3
     FFC4             (           coco.d):00137         A.V4                SET       $FFC4
     FFC5             (           coco.d):00138         A.V5                SET       $FFC5
     FFC6             (           coco.d):00139         A.V6                SET       $FFC6
     FFC7             (           coco.d):00140         A.V7                SET       $FFC7
                      (           coco.d):00141         
                      (           coco.d):00142         
                      (           coco.d):00143                             IFEQ      Level-1
                      (           coco.d):00144         
                      (           coco.d):00145         ********************************
                      (           coco.d):00146         * Boot defs for NitrOS-9 Level 1
                      (           coco.d):00147         *
                      (           coco.d):00148         * These defs are not strictly for 'Boot', but are for booting the
                      (           coco.d):00149         * system.
                      (           coco.d):00150         *
     EE00             (           coco.d):00151         Bt.Start            EQU       $EE00               Start address of the boot track in memory
                      (           coco.d):00152         
                      (           coco.d):00153                             ELSE
                      (           coco.d):00154         
                      (           coco.d):00155         ******************************************
                      (           coco.d):00156         * Boot defs for NitrOS-9 Level 2 and above
                      (           coco.d):00157         *
                      (           coco.d):00158         * These defs are not strictly for 'Boot', but are for booting the
                      (           coco.d):00159         * system.
                      (           coco.d):00160         *
0004                  (           coco.d):00161         Bt.Start            SET       $ED00               Start address of the boot track in memory
0004                  (           coco.d):00162         Bt.Block            EQU       $3B                 Block to map in for the 'OS9BOOT' screen
0004                  (           coco.d):00163         Bt.Flag             EQU       $8A34               Flag in Bt.Block to verify that it's unchanged
0004                  (           coco.d):00164         Bt.Offst            EQU       2                   Offset into the screen where the current ptr is
                      (           coco.d):00165         
                      (           coco.d):00166                             ENDC
                      (           coco.d):00167         
                      (           coco.d):00168         * On the CoCo, the boot track is all of track 34
                      (           coco.d):00169         
     0022             (           coco.d):00170         Bt.Track            EQU       34                  Boot track
     0000             (           coco.d):00171         Bt.Sec              EQU       0                   Start LSN of boot area on boot track
                      (           coco.d):00172         
                      (           coco.d):00173         
     1080             (           coco.d):00174         Bt.Size             EQU       $1080               Maximum size of bootfile
                      (           coco.d):00175         
                      (           coco.d):00176         
                      (           coco.d):00177                             IFEQ      Level-1
                      (           coco.d):00178         
                      (           coco.d):00179         *************************************************
                      (           coco.d):00180         *
                      (           coco.d):00181         * NitrOS-9 Level 1 Section
                      (           coco.d):00182         *
                      (           coco.d):00183         *************************************************
                      (           coco.d):00184         
     00FF             (           coco.d):00185         HW.Page             SET       $FF                 Device descriptor hardware page
                      (           coco.d):00186         
                      (           coco.d):00187                             ELSE
                      (           coco.d):00188         
                      (           coco.d):00189         *************************************************
                      (           coco.d):00190         *
                      (           coco.d):00191         * NitrOS-9 Level 2 Section
                      (           coco.d):00192         *
                      (           coco.d):00193         *************************************************
                      (           coco.d):00194         
                      (           coco.d):00195         ****************************************
                      (           coco.d):00196         * Dynamic Address Translator Definitions
                      (           coco.d):00197         *
0004                  (           coco.d):00198         DAT.BlCt            EQU       8                   D.A.T. blocks/address space
0004                  (           coco.d):00199         DAT.BlSz            EQU       (256/DAT.BlCt)*256  D.A.T. block size
0004                  (           coco.d):00200         DAT.ImSz            EQU       DAT.BlCt*2          D.A.T. Image size
0004                  (           coco.d):00201         DAT.Addr            EQU       -(DAT.BlSz/256)     D.A.T. MSB Address bits
0004                  (           coco.d):00202         DAT.Task            EQU       $FF91               Task Register address
0004                  (           coco.d):00203         DAT.TkCt            EQU       32                  Number of DAT Tasks
0004                  (           coco.d):00204         DAT.Regs            EQU       $FFA0               DAT Block Registers base address
0004                  (           coco.d):00205         DAT.Free            EQU       $333E               Free Block Number
0004                  (           coco.d):00206         DAT.BlMx            EQU       $3F                 Maximum Block number
0004                  (           coco.d):00207         DAT.BMSz            EQU       $40                 Memory Block Map size
0004                  (           coco.d):00208         DAT.WrPr            EQU       0                   no write protect
0004                  (           coco.d):00209         DAT.WrEn            EQU       0                   no write enable
0004                  (           coco.d):00210         SysTask             EQU       0                   Coco System Task number
0004                  (           coco.d):00211         IOBlock             EQU       $3F
0004                  (           coco.d):00212         ROMBlock            EQU       $3F
0004                  (           coco.d):00213         IOAddr              EQU       $7F
0004                  (           coco.d):00214         ROMCount            EQU       1                   number of blocks of ROM (High RAM Block)
0004                  (           coco.d):00215         RAMCount            EQU       1                   initial blocks of RAM
0004                  (           coco.d):00216         MoveBlks            EQU       DAT.BlCt-ROMCount-2 Block numbers used for copies
0004                  (           coco.d):00217         BlockTyp            EQU       1                   chk only first bytes of RAM block
0004                  (           coco.d):00218         ByteType            EQU       2                   chk entire block of RAM
0004                  (           coco.d):00219         Limited             EQU       1                   chk only upper memory for ROM modules
0004                  (           coco.d):00220         UnLimitd            EQU       2                   chk all NotRAM for modules
                      (           coco.d):00221         * NOTE: this check assumes any NotRAM with a module will
                      (           coco.d):00222         *       always start with $87CD in first two bytes of block
0004                  (           coco.d):00223         RAMCheck            EQU       BlockTyp            chk only beg bytes of block
0004                  (           coco.d):00224         ROMCheck            EQU       Limited             chk only upper few blocks for ROM
0004                  (           coco.d):00225         LastRAM             EQU       IOBlock             maximum RAM block number
                      (           coco.d):00226         
                      (           coco.d):00227         ***************************
                      (           coco.d):00228         * Color Computer 3 Specific
                      (           coco.d):00229         *
0004                  (           coco.d):00230         MappedIO            EQU       true                (Actually False but it works better this way)
                      (           coco.d):00231         
                      (           coco.d):00232         ********************
                      (           coco.d):00233         * Hardware addresses
                      (           coco.d):00234         *
0004                  (           coco.d):00235         GIMERegs            EQU       $FF00               Base address of GIME registers
0004                  (           coco.d):00236         IrqEnR              EQU       $FF92               GIME IRQ enable/status register
0004                  (           coco.d):00237         BordReg             EQU       $FF9A               Border color register
0004                  (           coco.d):00238         PalAdr              EQU       $FFB0               Palette registers
                      (           coco.d):00239         
0004                  (           coco.d):00240         HW.Page             SET       $07                 Device descriptor hardware page
                      (           coco.d):00241         
                      (           coco.d):00242         * KrnBlk defines the block number of the 8K RAM block that is mapped to
                      (           coco.d):00243         * the top of CPU address space ($E000-$FFFF) for the system process, and
                      (           coco.d):00244         * which holds the Kernel. The top 2 pages of this CPU address space ($FFE0-
                      (           coco.d):00245         * $FFFF) has two special properties. Firstly, it contains the I/O space.
                      (           coco.d):00246         * Secondly, the parts that contain RAM map are not affected by the DAT
                      (           coco.d):00247         * mappings but, instead, *always* map that RAM to a fixed RAM block
                      (           coco.d):00248         * (KrnBlk). When a user process is mapped in, and requests enough memory,
                      (           coco.d):00249         * it will end up with its own block assigned for CPU address space $E000-
                      (           coco.d):00250         * $FFFF but the top of the address space is unusable by the user process:
                      (           coco.d):00251         * it still contains the I/O and the bit of RAM that's mapped to KrnBlk.
                      (           coco.d):00252         * Usually, the value of KrnBlk is fixed for a particular hardware design;
                      (           coco.d):00253         * For the COCO GIME, it's always $3F.
0004                  (           coco.d):00254         KrnBlk              SET       $3F
                      (           coco.d):00255         
                      (           coco.d):00256                             ENDC
                      (           coco.d):00257                             ENDC
                      (           coco.d):00258         
                      (       datmod.asm):00018                             endc
                      (       datmod.asm):00019         
     0011             (       datmod.asm):00020         Type                set       Prgrm+Objct
     0081             (       datmod.asm):00021         Revs                set       ReEnt+1
     0001             (       datmod.asm):00022         edition             set       $01
                      (       datmod.asm):00023         
0000 87CD00DD000D1181 (       datmod.asm):00024                             mod       eom,name,Type,Revs,start,256
     F500140100
                      (       datmod.asm):00025         
000D 4461744D6FE4     (       datmod.asm):00026         name                fcs       "DatMod"
0013 01               (       datmod.asm):00027                             fcb       $01
                      (       datmod.asm):00028         
                      (       datmod.asm):00029         * routine cold
0014 4F               (       datmod.asm):00030         start               clra
0015 308CF5           (       datmod.asm):00031                             leax      name,pcr
0018 103F00           (       datmod.asm):00032                             os9       F$Link
001B 2507             (       datmod.asm):00033                             bcs       error
001D 318C07           (       datmod.asm):00034                             leay      SvcTbl,pcr
0020 103F32           (       datmod.asm):00035                             os9       F$SSvc
0023 5F               (       datmod.asm):00036                             clrb
0024 103F06           (       datmod.asm):00037         error               os9       F$Exit
                      (       datmod.asm):00038         
     0025             (       datmod.asm):00039         F$DatMod            equ       $25
                      (       datmod.asm):00040         
     0027             (       datmod.asm):00041         SvcTbl              equ       *
