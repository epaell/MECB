                      (       jsr_cmd.as):00001         ;;; JSR_CMD
                      (       jsr_cmd.as):00002         ;;;
                      (       jsr_cmd.as):00003         ;;; Jump to a subroutine from a one character command table.
                      (       jsr_cmd.as):00004         ;;;
                      (       jsr_cmd.as):00005         ;;; Entry:  A = One character command.
                      (       jsr_cmd.as):00006         ;;;         X = The start of the jump table.
                      (       jsr_cmd.as):00007         ;;;
                      (       jsr_cmd.as):00008         ;;; Exit:  CC = Carry set if entry isn't found.
                      (       jsr_cmd.as):00009         ;;;
                      (       jsr_cmd.as):00010         ;;; Each table entry is composed of three bytes:
                      (       jsr_cmd.as):00011         ;;;     - Byte 0: The command character.
                      (       jsr_cmd.as):00012         ;;;     - Byte 1: The upper 8 bits of the address of the routine.
                      (       jsr_cmd.as):00013         ;;;     - Byte 1: The lower 8 bits of the address of the routine.
                      (       jsr_cmd.as):00014         ;;;
                      (       jsr_cmd.as):00015         ;;; Mark the end of the table with a null byte.
                      (       jsr_cmd.as):00016         ;;;
                      (       jsr_cmd.as):00017         ;;; The commands are case significant.
                      (       jsr_cmd.as):00018         ;;;
                      (       jsr_cmd.as):00019         ;;; Here's an example:
                      (       jsr_cmd.as):00020         ;;;
                      (       jsr_cmd.as):00021         ;;;    fcc /A/
                      (       jsr_cmd.as):00022         ;;;    fdb routineA-*
                      (       jsr_cmd.as):00023         ;;;    fcc /B/
                      (       jsr_cmd.as):00024         ;;;    fdb routineB-*
                      (       jsr_cmd.as):00025         ;;;    fcb 0
                      (       jsr_cmd.as):00026         
                      (       jsr_cmd.as):00027                             section   .text
                      (       jsr_cmd.as):00028         
