001B 8E0400           (/cmds/megaread.as):00047                             ldx       #ChnkCnt            seed X with count value to read target size
001E 3506             (/cmds/megaread.as):00048                             puls      d
0020 10830000         (/cmds/megaread.as):00049                             cmpd      #0                  is command line number given?
0024 2702             (/cmds/megaread.as):00050                             beq       loop                no, so use default (in X)
0026 1F01             (/cmds/megaread.as):00051                             tfr       d,x                 yes, use it
0028 3410             (/cmds/megaread.as):00052         loop                pshs      x                   save counter
002A 30C90000         (/cmds/megaread.as):00053                             leax      KiloBuff,u          point (X) to buffer
002E 108E0400         (/cmds/megaread.as):00054                             ldy       #ChunkSz            read predetermined chunk
0032 4F               (/cmds/megaread.as):00055                             clra                          std input
0033 103F00           (/cmds/megaread.as):00056                             os9       I$Read
0036 2508             (/cmds/megaread.as):00057                             bcs       eofchk
0038 3510             (/cmds/megaread.as):00058                             puls      x                   recover counter
003A 301F             (/cmds/megaread.as):00059                             leax      -1,x                done yet?
003C 26EA             (/cmds/megaread.as):00060                             bne       loop                no, go get another chunk
003E 2004             (/cmds/megaread.as):00061                             bra       fini                yes, exit
