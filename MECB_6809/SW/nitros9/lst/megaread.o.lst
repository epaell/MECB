                      (/cmds/megaread.as):00001         ***********************************************************************
                      (/cmds/megaread.as):00002         * MegaRead - Disk Performance Utility
                      (/cmds/megaread.as):00003         *
                      (/cmds/megaread.as):00004         * Modified from an original program by Caveh Jalali
                      (/cmds/megaread.as):00005         * Edt/Rev  YYYY/MM/DD  Modified by
                      (/cmds/megaread.as):00006         * Comment
                      (/cmds/megaread.as):00007         * ------------------------------------------------------------------
                      (/cmds/megaread.as):00008         *  01/01   1987/05/30  Bruce Isted (CIS PPN 76625,2273)
                      (/cmds/megaread.as):00009         * Released to the public domain
                      (/cmds/megaread.as):00010         *
                      (/cmds/megaread.as):00011         *  01/00   2004/04/22  Boisy G. Pitre
                      (/cmds/megaread.as):00012         * Ported to NitrOS-9 style, no error on exit
                      (/cmds/megaread.as):00013         *
                      (/cmds/megaread.as):00014         *  01/01   2004/04/22  Rodney V. Hamilton
                      (/cmds/megaread.as):00015         * Added EOF check for floppy
                      (/cmds/megaread.as):00016         *
                      (/cmds/megaread.as):00017         *  01/02   2009/03/14  Bob Devries
                      (/cmds/megaread.as):00018         * Added functionality to read a number of 1K blocks as specified on the command line.
                      (/cmds/megaread.as):00019         * Command line is now: megaread #####
                      (/cmds/megaread.as):00020         * where ##### is the number of 1K blocks to read; default 1024
                      (/cmds/megaread.as):00021         *
                      (/cmds/megaread.as):00022         *  01/02   2010/05/22  Boisy G. Pitre
                      (/cmds/megaread.as):00023         * Made source more configurable in terms of read chunk size and total read count
                      (/cmds/megaread.as):00024         
     0400             (/cmds/megaread.as):00025         ChunkSz             equ       1024
     0400             (/cmds/megaread.as):00026         ChnkCnt             equ       1024^2/ChunkSz      1024^2 is 1 megabyte (modify as desired)
                      (/cmds/megaread.as):00027         
                      (/cmds/megaread.as):00028                             section   bss
0000                  (/cmds/megaread.as):00029         StartTm             rmb       6
0006                  (/cmds/megaread.as):00030         EndTm               rmb       6
000C                  (/cmds/megaread.as):00031         KiloBuff            rmb       ChunkSz
040C                  (/cmds/megaread.as):00032                             rmb       200                 stack space
                      (/cmds/megaread.as):00033                             endsection
                      (/cmds/megaread.as):00034                             
