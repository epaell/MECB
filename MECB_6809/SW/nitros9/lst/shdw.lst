0004                  (       cocovtio.d):00103         V.KeyFlg            RMB       1                   key flag
0004                  (       cocovtio.d):00104         V.AltDwn            RMB       1                   ALT key down
0004                  (       cocovtio.d):00105         V.KySns             RMB       1                   key sense flags
0004                  (       cocovtio.d):00106         V.KySame            RMB       1                   key same as last flag
0004                  (       cocovtio.d):00107         V.KySnsF            RMB       1                   key sense flag
0004                  (       cocovtio.d):00108         V.Spcl              RMB       1
0004                  (       cocovtio.d):00109         V.KTblLC            RMB       1                   key table entry #
0004                  (       cocovtio.d):00110         V.6F                RMB       1                   ???
0004                  (       cocovtio.d):00111         V.COLoad            RMB       1                   CO-module loaded flags
0004                  (       cocovtio.d):00112         V.CFlag             RMB       1                   true lowercase flag $10=true, $00=false
0004                  (       cocovtio.d):00113         V.GrfDrvE           RMB       2                   GrfDrv entry point
0004                  (       cocovtio.d):00114         V.CoVDGE            RMB       2                   CoVDG entry point
0004                  (       cocovtio.d):00115         V.CoWPE             RMB       2                   CoWP entry point
0004                  (       cocovtio.d):00116         V.CoHRE             RMB       2                   CoHR entry point
0004                  (       cocovtio.d):00117         V.Co42E             RMB       2                   Co42 entry point
0004                  (       cocovtio.d):00118         V.CoVGAE            RMB       2                   CoVGA entry point
0004                  (       cocovtio.d):00119         V.Co80E             RMB       2                   Co80 entry point
0004                  (       cocovtio.d):00120         V.CoDPlusE          RMB       2                   CoDPlus entry point
0004                  (       cocovtio.d):00121         V.Flash             RMB       2                   Cursor flash routine address.
0004                  (       cocovtio.d):00122         v.FlashTime         RMB       1                   Cursor flash time
0004                  (       cocovtio.d):00123         v.FlashCount        RMB       1                   Cursor flash count
0004                  (       cocovtio.d):00124         V.NoFlash           RMB       1                   When this is non-zero do not flash cursor
                      (       cocovtio.d):00125         * If we make ClrBlk vector, throw it in here so the various comoduels, as well as VTIO,
                      (       cocovtio.d):00126         * can all use it (clearing text/graphics screens, clearing full width line (pure text or
                      (       cocovtio.d):00127         * CoHr/Co42 graphics lines), and possibly Clear to end of line could all use it.
0004                  (       cocovtio.d):00128         V.ClrBlk            RMB       2                   Vector to mini-stack blast clearing routine
0004                  (       cocovtio.d):00129         V.CpyBlk            RMB       2                   Vector to mini-stack blast copying routine
                      (       cocovtio.d):00130         * CoHR vars
0004                  (       cocovtio.d):00131         V.51ScrnA           RMB       2                   * Screen address.
0004                  (       cocovtio.d):00132         V.51XPos            RMB       1                   * X co-ordinate
0004                  (       cocovtio.d):00133         V.51YPos            RMB       1                   * Y co-ordinate
0004                  (       cocovtio.d):00134         V.51EscSeq          RMB       1                   * In escape sequence
0004                  (       cocovtio.d):00135         V.51ReverseFlag     RMB       1                   * Reverse video flag
0004                  (       cocovtio.d):00136         V.51UnderlineFlag   RMB       1                   * Underline flag
0004                  (       cocovtio.d):00137         V.51CtrlDispatch    RMB       2                   * Ctrl char dispatch address, currently processing
0004                  (       cocovtio.d):00138         V.51BytePixOffset   RMB       1                   * byte offset in screen line, of character X position
0004                  (       cocovtio.d):00139         V.51OldCursorPosX   RMB       1                   * Position of old cursor before update
0004                  (       cocovtio.d):00140         V.51OldCursorPosY   RMB       1
0004                  (       cocovtio.d):00141         V.51CursorChanged   RMB       1                   * Has cursor position changed ? 1=yes,0=no
0004                  (       cocovtio.d):00142         V.51CursorOn        RMB       1                   * Is cursor on ? 1=yes 0=no
0004                  (       cocovtio.d):00143         V.51XORFlag         RMB       1                   * and data to screen (0) or Xor (1)
0004                  (       cocovtio.d):00144         V.51ScreenMask1     RMB       1                   * screen masks for drawing characters on screen
0004                  (       cocovtio.d):00145         V.51ScreenMask2     RMB       1
                      (       cocovtio.d):00146         * End of CoHR vars
                      (       cocovtio.d):00147         **** Note these have to come at the end of the defs, or the keyboard ****
                      (       cocovtio.d):00148         **** code can clobber variables defined after these !                ****
0004                  (       cocovtio.d):00149         V.IBufH             RMB       1                   input buffer head
0004                  (       cocovtio.d):00150         V.IBufT             RMB       1                   input buffer tail
0004                  (       cocovtio.d):00151         V.InBuf             RMB       1                   input buffer ptr
0004                  (       cocovtio.d):00152         V.51End             RMB       1
                      (       cocovtio.d):00153                             RMB       250-.
0004                  (       cocovtio.d):00154         V.Last              EQU       .
