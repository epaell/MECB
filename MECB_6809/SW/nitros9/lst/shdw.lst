                      (       cocovtio.d):00171         * Defs for V.COLoad flags.
                      (       cocovtio.d):00172         *
                      (       cocovtio.d):00173         
0004                  (       cocovtio.d):00174         ModCoVDG            EQU       %00000010           CoVDG, Built-in VDG 32x16.
0004                  (       cocovtio.d):00175         ModCoWP             EQU       %00000100           CoWP, WordPak, 80x25
0004                  (       cocovtio.d):00176         ModCoHR             EQU       %00001000           CoHR, PMODE 4 51x25 text
0004                  (       cocovtio.d):00177         ModCo42             EQU       %00010000           Co42, PMODE 4 42x25 text
0004                  (       cocovtio.d):00178         ModCoVGA            EQU       %00100000           CoVGA, 64x32 text
0004                  (       cocovtio.d):00179         ModCo80             EQU       %01000000           Co80, CRT9128 WordPak, 80x25
0004                  (       cocovtio.d):00180         ModCoDPlus          EQU       %10000000           Dragon Plus, 6545, 80x24
                      (       cocovtio.d):00181         
                      (       cocovtio.d):00182         *
                      (       cocovtio.d):00183         * Defs for cursor flash counter
                      (       cocovtio.d):00184         *
                      (       cocovtio.d):00185         
0004                  (       cocovtio.d):00186         CFlash50hz          EQU       25                  * 50Hz flash counter
0004                  (       cocovtio.d):00187         CFlash60Hz          EQU       30                  * 60Hz flash counter
