                      ( ../objs/shdw.asm):00082         * VIEW OBJECTS FLAGS
                      ( ../objs/shdw.asm):00083         
     0001             ( ../objs/shdw.asm):00084         O_DRAWN             equ       $01       * 0  - object has been drawn
     0002             ( ../objs/shdw.asm):00085         O_BLKIGNORE         equ       $02       * 1  - ignore blocks and condition lines
     0004             ( ../objs/shdw.asm):00086         O_PRIFIXED          equ       $04       * 2  - fixes priority agi cannot change it based on position
     0008             ( ../objs/shdw.asm):00087         O_HRZNIGNORE        equ       $08       * 3  - ignore horizon
     0010             ( ../objs/shdw.asm):00088         O_UPDATE            equ       $10       * 4  - update every cycle
     0020             ( ../objs/shdw.asm):00089         O_CYCLE             equ       $20       * 5  - the object cycles
     0040             ( ../objs/shdw.asm):00090         O_ANIMATE           equ       $40       * 6  - animated
     0080             ( ../objs/shdw.asm):00091         O_BLOCK             equ       $80       * 7  - resting on a block
     0100             ( ../objs/shdw.asm):00092         O_WATER             equ       $100      * 8  - only allowed on water
     0200             ( ../objs/shdw.asm):00093         O_OBJIGNORE         equ       $200      * 9  - ignore other objects when determining contacts
     0400             ( ../objs/shdw.asm):00094         O_REPOS             equ       $400      * 10 - set whenever a obj is repositioned
                      ( ../objs/shdw.asm):00095         *                                that way the interpeter doesn't check it's next movement for one cycle
     0800             ( ../objs/shdw.asm):00096         O_LAND              equ       $800      * 11 - only allowed on land
     1000             ( ../objs/shdw.asm):00097         O_SKIPUPDATE        equ       $1000     * 12 - does not update obj for one cycle
     2000             ( ../objs/shdw.asm):00098         O_LOOPFIXED         equ       $2000     * 13 - agi cannot set the loop depending on direction
     4000             ( ../objs/shdw.asm):00099         O_MOTIONLESS        equ       $4000     * 14 - no movement.
                      ( ../objs/shdw.asm):00100         *                                if position is same as position in last cycle then this flag is set.
                      ( ../objs/shdw.asm):00101         *                                follow/wander code can then create a new direction
                      ( ../objs/shdw.asm):00102         *                                (ie, if it hits a wall or something)
     8000             ( ../objs/shdw.asm):00103         O_UNUSED            equ       $8000
