0059 170000           (      ghosts90.as):00076                             lbsr      PUTGHT
                      (      ghosts90.as):00077         
005C 3510             (      ghosts90.as):00078                             puls      X                   Restore X reg.
                      (      ghosts90.as):00079         
005E CC013D           (      ghosts90.as):00080                             ldd       #317                Set new X screen location
0061 ED02             (      ghosts90.as):00081                             std       2,X
