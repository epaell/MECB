                      (      ghosts90.as):00005         *     Program segment to be compiled using Level II RMA
                      (      ghosts90.as):00006         *          This is not a mainline program segment
                      (      ghosts90.as):00007         *                 Written by Larry Olson
                      (      ghosts90.as):00008         
                      (      ghosts90.as):00009                             ifp1
                      (      ghosts90.as):00010         *         use   /dd/defs/os9defs.a
                      (      ghosts90.as):00011                             endc
                      (      ghosts90.as):00012         
     00FA             (      ghosts90.as):00013         STACK               equ       250
                      (      ghosts90.as):00014         
                      (      ghosts90.as):00015                             section   bss
                      (      ghosts90.as):00016         
                      (      ghosts90.as):00017         *     Lcoal Variables
                      (      ghosts90.as):00018         
0000                  (      ghosts90.as):00019                             rmb       STACK
                      (      ghosts90.as):00020         
                      (      ghosts90.as):00021         
                      (      ghosts90.as):00022                             endsect
                      (      ghosts90.as):00023         
                      (      ghosts90.as):00024                             section   code
                      (      ghosts90.as):00025         
                      (      ghosts90.as):00026         *     Subtract 20 from ghost counter
                      (      ghosts90.as):00027         *     Then check ghost status to determine what action
                      (      ghosts90.as):00028         *     is to be preformed on ghost.
                      (      ghosts90.as):00029         
0000 B60000           (      ghosts90.as):00030         GHCHCK              lda       GCOUNT              Get ghost counter
0003 8014             (      ghosts90.as):00031                             suba      #20                 Subtract 20 from it
0005 2A02             (      ghosts90.as):00032                             bpl       CKSTAT              If =>0 then check status
0007 863C             (      ghosts90.as):00033                             lda       #60                 Reset counter to zero
0009 B70000           (      ghosts90.as):00034         CKSTAT              sta       GCOUNT              Save ghost counter
000C 30C90000         (      ghosts90.as):00035                             leax      G1OFST,U            Point to start of tables
0010 3086             (      ghosts90.as):00036                             leax      A,X                 Move to current ghost table
0012 A60A             (      ghosts90.as):00037                             lda       10,X                Get ghost status
0014 10270000         (      ghosts90.as):00038                             lbeq      MOVING              If so then move it again
0018 102B0000         (      ghosts90.as):00039                             lbmi      CAGED               Check caged status
                      (      ghosts90.as):00040         
001C 31C90000         (      ghosts90.as):00041         GHMOVE              leay      ARRAY,U             Point to start of array
0020 EC84             (      ghosts90.as):00042                             ldd       ,X                  Get ghost array offset
0022 31AB             (      ghosts90.as):00043                             leay      D,Y                 Move to that spot in array
0024 A6A4             (      ghosts90.as):00044                             lda       ,Y                  Get the byte there
0026 8501             (      ghosts90.as):00045                             bita      #1                  Check for intersection
0028 2710             (      ghosts90.as):00046                             beq       NOWALL              If = then no intersection
                      (      ghosts90.as):00047         
002A A60A             (      ghosts90.as):00048                             lda       10,X                Check status
002C 8101             (      ghosts90.as):00049                             cmpa      #1                  Are we chasing pacman?
002E 2705             (      ghosts90.as):00050                             beq       NORUN
0030 170000           (      ghosts90.as):00051                             lbsr      RUN                 If not, then run
0033 2005             (      ghosts90.as):00052                             bra       NOWALL
0035 EC84             (      ghosts90.as):00053         NORUN               ldd       ,X
0037 170000           (      ghosts90.as):00054                             lbsr      HUNT                At intersection, so go hunt
                      (      ghosts90.as):00055         
                      (      ghosts90.as):00056         *      This routine is used to calc and add the offsets and
                      (      ghosts90.as):00057         *      fill the PUTBLK string, in order to move the ghosts
                      (      ghosts90.as):00058         *      Old ghost will be erased when new ghost is put on
                      (      ghosts90.as):00059         *      the screen.
                      (      ghosts90.as):00060         
003A A60E             (      ghosts90.as):00061         NOWALL              lda       14,X                Get direction flag
003C 2661             (      ghosts90.as):00062                             bne       LEFT
                      (      ghosts90.as):00063         *     Move ghost up screen
003E EC84             (      ghosts90.as):00064         UP                  ldd       ,X                  Get ghost array offset
0040 10830021         (      ghosts90.as):00065                             cmpd      #33                 At top of screen?
0044 2639             (      ghosts90.as):00066                             bne       STGH1
                      (      ghosts90.as):00067         
0046 3410             (      ghosts90.as):00068                             pshs      X                   Save X reg.
                      (      ghosts90.as):00069         
0048 8601             (      ghosts90.as):00070                             lda       #1                  Set for blank ghost
004A B70000           (      ghosts90.as):00071                             sta       PGBFN
