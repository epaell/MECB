     D40B             (  ../defs/atari.d):00317         VCOUNT              equ       ANTIC+$0B           ;vertical line counter
     D40C             (  ../defs/atari.d):00318         PENH                equ       ANTIC+$0C           ;light pen horizontal position
     D40D             (  ../defs/atari.d):00319         PENV                equ       ANTIC+$0D           ;light pen vertical position
     D40F             (  ../defs/atari.d):00320         NMIST               equ       ANTIC+$0F           ;NMI interrupt status
                      (  ../defs/atari.d):00321         
