                      (    ../defs/scf.d):00095                             PAG
                      (    ../defs/scf.d):00096         ********************
                      (    ../defs/scf.d):00097         * SCF Static Storage
                      (    ../defs/scf.d):00098         *
                      (    ../defs/scf.d):00099         * SCF devices must reserve this space for SCF
                      (    ../defs/scf.d):00100         *
                      (    ../defs/scf.d):00101                             ORG       V.USER
0006                  (    ../defs/scf.d):00102         V.TYPE              RMB       1                   Device type or parity
0007                  (    ../defs/scf.d):00103         V.LINE              RMB       1                   Lines left until end of page
0008                  (    ../defs/scf.d):00104         V.PAUS              RMB       1                   Immediate Pause request
0009                  (    ../defs/scf.d):00105         V.DEV2              RMB       2                   Attached device's static
000B                  (    ../defs/scf.d):00106         V.INTR              RMB       1                   Interrupt char
000C                  (    ../defs/scf.d):00107         V.QUIT              RMB       1                   Quit char
000D                  (    ../defs/scf.d):00108         V.PCHR              RMB       1                   Pause char
000E                  (    ../defs/scf.d):00109         V.ERR               RMB       1                   Accumulated errors
000F                  (    ../defs/scf.d):00110         V.XON               RMB       1                   X-On char
0010                  (    ../defs/scf.d):00111         V.XOFF              RMB       1                   X-Off char
0011                  (    ../defs/scf.d):00112         V.KANJI             RMB       1                   Kanji mode flag
0012                  (    ../defs/scf.d):00113         V.KBUF              RMB       2                   Kana - Kanji convert routine work address
0014                  (    ../defs/scf.d):00114         V.MODADR            RMB       2                   Kana - Kanji convert module address
0016                  (    ../defs/scf.d):00115         V.PDLHd             RMB       2                   Open path descriptor list head pointer
0018                  (    ../defs/scf.d):00116         V.RSV               RMB       5                   Reserve bytes for future expansion
     001D             (    ../defs/scf.d):00117         V.SCF               EQU       .                   Total SCF manager static overhead
                      (    ../defs/scf.d):00118         
                      (    ../defs/scf.d):00119         
                      (    ../defs/scf.d):00120                             PAG
                      (    ../defs/scf.d):00121         ***********************
                      (    ../defs/scf.d):00122         * Character Definitions
                      (    ../defs/scf.d):00123         *
     0000             (    ../defs/scf.d):00124         C$NULL              SET       0                   Null char
     0001             (    ../defs/scf.d):00125         C$RPET              SET       $01                 (CTRL-A - SOH) Repeat last input line
     0003             (    ../defs/scf.d):00126         C$INTR              SET       $03                 (CTRL-C - ETX) Keyboard interrupt
     0004             (    ../defs/scf.d):00127         C$RPRT              SET       $04                 (CTRL-D - EOT) Reprint current input line
     0005             (    ../defs/scf.d):00128         C$QUIT              SET       $05                 (CTRL-E - ENQ) Keyboard Abort
     0007             (    ../defs/scf.d):00129         C$BELL              SET       $07                 (CTRL-G - BEL) Line overflow warning
     0008             (    ../defs/scf.d):00130         C$BSP               SET       $08                 (CTRL-H - BS ) Back space
     0009             (    ../defs/scf.d):00131         C$RARR              SET       $09                 Right Arrow
     0005             (    ../defs/scf.d):00132         C$EL                SET       $05                 Erase Line
     000A             (    ../defs/scf.d):00133         C$LF                SET       $0A                 Line feed
     000B             (    ../defs/scf.d):00134         C$HOME              SET       $0B                 Home position Code
     0015             (    ../defs/scf.d):00135         C$Clsgr             SET       $15                 Graphic screen clear (use FM-11)
     0016             (    ../defs/scf.d):00136         C$Clsall            SET       $16                 Graphic & character clear (use FM-11)
     000D             (    ../defs/scf.d):00137         C$CR                SET       $0D                 Carriage return
     000C             (    ../defs/scf.d):00138         C$FORM              SET       $0C                 (CTRL-L - FF ) Form Feed ... screen clear
     000F             (    ../defs/scf.d):00139         C$SI                SET       $0F                 Shift IN Code
     000E             (    ../defs/scf.d):00140         C$SO                SET       $0E                 Shift OUT Code
     0010             (    ../defs/scf.d):00141         C$DELETE            SET       $10                 Delete char (for SCF enhanced line editing)
     0011             (    ../defs/scf.d):00142         C$XON               SET       $11                 (CTRL-Q - DC1) Transmit Enable
     0011             (    ../defs/scf.d):00143         C$INSERT            SET       C$XON               Insert char (for SCF enhanced line editing)
     0013             (    ../defs/scf.d):00144         C$XOFF              SET       $13                 (CTRL-S - DC3) Transmit Disable
     0013             (    ../defs/scf.d):00145         C$PLINE             SET       C$XOFF              Print remaining line (for SCF enhanced line editing)
     0017             (    ../defs/scf.d):00146         C$PAUS              SET       $17                 (CTRL-W - ETB) Pause character
     0018             (    ../defs/scf.d):00147         C$DEL               SET       $18                 (CTRL-X - CAN) Delete line
     0019             (    ../defs/scf.d):00148         C$SHRARR            SET       $19                 Shift Right-Arrow
     001B             (    ../defs/scf.d):00149         C$EOF               SET       $1B                 (CTRL-[ - ESC) END of file
     001C             (    ../defs/scf.d):00150         C$RGT               SET       $1C                 Cursor right
     001D             (    ../defs/scf.d):00151         C$LFT               SET       $1D                 Cursor left
     001E             (    ../defs/scf.d):00152         C$UP                SET       $1E                 Cursor up
     001F             (    ../defs/scf.d):00153         C$DWN               SET       $1F                 Cursor down
     0020             (    ../defs/scf.d):00154         C$SPAC              SET       $20                 Space
     002E             (    ../defs/scf.d):00155         C$PERD              SET       '.
     002C             (    ../defs/scf.d):00156         C$COMA              SET       ',
                      (    ../defs/scf.d):00157         
                      (    ../defs/scf.d):00158         
                      (    ../defs/scf.d):00159                             PAG
                      (    ../defs/scf.d):00160         *********************************************
                      (    ../defs/scf.d):00161         * Sequential Character Path Descriptor Format
                      (    ../defs/scf.d):00162         *
                      (    ../defs/scf.d):00163         * A path descriptor is created for every new path that is open
                      (    ../defs/scf.d):00164         * via the I$Open system call (processed by IOMan).  Process
                      (    ../defs/scf.d):00165         * descriptors track state information of a path.
                      (    ../defs/scf.d):00166         *
                      (    ../defs/scf.d):00167                             ORG       PD.FST
000A                  (    ../defs/scf.d):00168         PD.DV2              RMB       2                   Output device table pointer
000C                  (    ../defs/scf.d):00169         PD.RAW              RMB       1                   Read/Write or ReadLn/WritLn mode
000D                  (    ../defs/scf.d):00170         PD.MAX              RMB       2                   ReadLn high byte count
000F                  (    ../defs/scf.d):00171         PD.MIN              RMB       1                   Devices are "mine" if clear
0010                  (    ../defs/scf.d):00172         PD.STS              RMB       2                   Status routine module addr
0012                  (    ../defs/scf.d):00173         PD.STM              RMB       2                   Reserved for status routine
                      (    ../defs/scf.d):00174                             ORG       PD.OPT
0020                  (    ../defs/scf.d):00175                             RMB       1                   Device type
0021                  (    ../defs/scf.d):00176         PD.UPC              RMB       1                   Case (0=both, 1=upper only)
0022                  (    ../defs/scf.d):00177         PD.BSO              RMB       1                   Backspace (0=BSE, 1=BSE,SP,BSE)
0023                  (    ../defs/scf.d):00178         PD.DLO              RMB       1                   Delete (0=BSE over line, 1=CRLF)
0024                  (    ../defs/scf.d):00179         PD.EKO              RMB       1                   Echo (0=No Echo)
0025                  (    ../defs/scf.d):00180         PD.ALF              RMB       1                   Auto linefeed (0=No auto LF)
0026                  (    ../defs/scf.d):00181         PD.NUL              RMB       1                   End of Line null count
0027                  (    ../defs/scf.d):00182         PD.PAU              RMB       1                   Page pause (0=No end of page pause)
0028                  (    ../defs/scf.d):00183         PD.PAG              RMB       1                   Lines per page
0029                  (    ../defs/scf.d):00184         PD.BSP              RMB       1                   Backspace character
002A                  (    ../defs/scf.d):00185         PD.DEL              RMB       1                   Delete Line character
002B                  (    ../defs/scf.d):00186         PD.EOR              RMB       1                   End of Record character (read only)
002C                  (    ../defs/scf.d):00187         PD.EOF              RMB       1                   End of File character
002D                  (    ../defs/scf.d):00188         PD.RPR              RMB       1                   Repront Line character
002E                  (    ../defs/scf.d):00189         PD.DUP              RMB       1                   Dup Last Line character
002F                  (    ../defs/scf.d):00190         PD.PSC              RMB       1                   Pause character
0030                  (    ../defs/scf.d):00191         PD.INT              RMB       1                   Keyboard interrupt character (CTRL-C)
0031                  (    ../defs/scf.d):00192         PD.QUT              RMB       1                   Keyboard quit character (CTRL-E)
0032                  (    ../defs/scf.d):00193         PD.BSE              RMB       1                   Backspace echo character
0033                  (    ../defs/scf.d):00194         PD.OVF              RMB       1                   Line overflow character (BELL)
0034                  (    ../defs/scf.d):00195         PD.PAR              RMB       1                   Parity code
0035                  (    ../defs/scf.d):00196         PD.BAU              RMB       1                   ACIA baud rate (Color Computer)
0036                  (    ../defs/scf.d):00197         PD.D2P              RMB       2                   Offset of DEV2 name
0038                  (    ../defs/scf.d):00198         PD.XON              RMB       1                   ACIA X-ON character
0039                  (    ../defs/scf.d):00199         PD.XOFF             RMB       1                   ACIA X-OFF character
     001A             (    ../defs/scf.d):00200         OPTCNT              EQU       .-PD.OPT            Total user settable options
003A                  (    ../defs/scf.d):00201         PD.ERR              RMB       1                   Most recent I/O error status
003B                  (    ../defs/scf.d):00202         PD.TBL              RMB       2                   Device table addr (copy)
003D                  (    ../defs/scf.d):00203         PD.PLP              RMB       2                   Path Descriptor List Pointer
003F                  (    ../defs/scf.d):00204         PD.PST              RMB       1                   Current path status
                      (    ../defs/scf.d):00205         
                      (    ../defs/scf.d):00206         
                      (    ../defs/scf.d):00207         * PD.PST values Path Descriptor Status byte
                      (    ../defs/scf.d):00208         *
     0001             (    ../defs/scf.d):00209         PST.DCD             EQU       %00000001           Set if DCD is lost on Serial port
                      (    ../defs/scf.d):00210         
                      (    ../defs/scf.d):00211         
                      (    ../defs/scf.d):00212         * PD.PAR definitions
                      (    ../defs/scf.d):00213         *
                      (    ../defs/scf.d):00214         * Parity
     0000             (    ../defs/scf.d):00215         PARNONE             EQU       %00000000
     0020             (    ../defs/scf.d):00216         PARODD              EQU       %00100000
     0060             (    ../defs/scf.d):00217         PAREVEN             EQU       %01100000
     00A0             (    ../defs/scf.d):00218         PARMARK             EQU       %10100000
     00E0             (    ../defs/scf.d):00219         PARSPACE            EQU       %11100000
     00E0             (    ../defs/scf.d):00220         PARMASK             EQU       %11100000
                      (    ../defs/scf.d):00221         
                      (    ../defs/scf.d):00222         * PD.BAU definitions
                      (    ../defs/scf.d):00223         *
                      (    ../defs/scf.d):00224         * Baud rate
     0000             (    ../defs/scf.d):00225         B110                EQU       %00000000
     0001             (    ../defs/scf.d):00226         B300                EQU       %00000001
     0002             (    ../defs/scf.d):00227         B600                EQU       %00000010
     0003             (    ../defs/scf.d):00228         B1200               EQU       %00000011
     0004             (    ../defs/scf.d):00229         B2400               EQU       %00000100
     0005             (    ../defs/scf.d):00230         B4800               EQU       %00000101
     0006             (    ../defs/scf.d):00231         B9600               EQU       %00000110
     0007             (    ../defs/scf.d):00232         B19200              EQU       %00000111
     0008             (    ../defs/scf.d):00233         B38400              EQU       %00001000
     0009             (    ../defs/scf.d):00234         B57600              EQU       %00001001
     000A             (    ../defs/scf.d):00235         B115200             EQU       %00001010
                      (    ../defs/scf.d):00236         * Word size
     0000             (    ../defs/scf.d):00237         WORD8               EQU       %00000000
     0020             (    ../defs/scf.d):00238         WORD7               EQU       %00100000
                      (    ../defs/scf.d):00239         * Stop bits
     0000             (    ../defs/scf.d):00240         STOP1               EQU       %00000000
     0010             (    ../defs/scf.d):00241         STOP2               EQU       %00010000
                      (    ../defs/scf.d):00242         
                      (    ../defs/scf.d):00243                             ENDC
                      (     sys6809l1.as):00011                             use       ../defs/pipe.d
                      (   ../defs/pipe.d):00001                             IFNE      PIPE.D-1
                      (   ../defs/pipe.d):00002         
     0001             (   ../defs/pipe.d):00003         PIPE.D              SET       1
                      (   ../defs/pipe.d):00004         
                      (   ../defs/pipe.d):00005         ********************************************************************
                      (   ../defs/pipe.d):00006         * PipeDefs - Pipe File Manager Definitions
                      (   ../defs/pipe.d):00007         *
                      (   ../defs/pipe.d):00008         * Edt/Rev  YYYY/MM/DD  Modified by
                      (   ../defs/pipe.d):00009         * Comment
                      (   ../defs/pipe.d):00010         * ------------------------------------------------------------------
                      (   ../defs/pipe.d):00011         *          1988/12/03  Chris J. Burke
                      (   ../defs/pipe.d):00012         * Coded from new PIPEMAN comments.
                      (   ../defs/pipe.d):00013         
                      (   ../defs/pipe.d):00014                             NAM       PipeDefs
                      (   ../defs/pipe.d):00015                             TTL       Pipe                File Manager Definitions
                      (   ../defs/pipe.d):00016         
                      (   ../defs/pipe.d):00017         *
                      (   ../defs/pipe.d):00018         *   IOMan equates duplicated for PipeMan use
                      (   ../defs/pipe.d):00019         *
                      (   ../defs/pipe.d):00020         
     0010             (   ../defs/pipe.d):00021         NPATHS              SET       16                  ;Maximum local paths per task -- must match IOMan
     001D             (   ../defs/pipe.d):00022         NameMax             SET       29                  ;Maximum length of a file name
                      (   ../defs/pipe.d):00023         
                      (   ../defs/pipe.d):00024         *
                      (   ../defs/pipe.d):00025         *   Device Driver Static Storage Layout
                      (   ../defs/pipe.d):00026         *
                      (   ../defs/pipe.d):00027                             ORG       V.User
FFFF                  (   ../defs/pipe.d):00028         V.List              RMB       2                   ;Pointer to 1st pipe's pipe buffer
     ????             (   ../defs/pipe.d):00029         PManMem             EQU       .                   ;Device driver memory (drive table equivalent)
                      (   ../defs/pipe.d):00030         
                      (   ../defs/pipe.d):00031         *
                      (   ../defs/pipe.d):00032         *   Pipe Buffer Data Structure
                      (   ../defs/pipe.d):00033         *
                      (   ../defs/pipe.d):00034                             ORG       0
0000                  (   ../defs/pipe.d):00035         PP.PD               RMB       2                   ;Pointer to shared path descriptor
0002                  (   ../defs/pipe.d):00036         PP.Next             RMB       2                   ;Pointer to next pipe buffer in system map
0004                  (   ../defs/pipe.d):00037         PP.Prev             RMB       2                   ;Pointer to previous pipe buffer in system map
0006                  (   ../defs/pipe.d):00038         PP.Rsrv             RMB       2                   ;Reserved
     0008             (   ../defs/pipe.d):00039         PP.Data             EQU       .                   ;Data buffer begins at this offset
                      (   ../defs/pipe.d):00040         
                      (   ../defs/pipe.d):00041         *
                      (   ../defs/pipe.d):00042         *   Unique Path Descriptor Variables
                      (   ../defs/pipe.d):00043         *
                      (   ../defs/pipe.d):00044                             ORG       PD.FST
                      (   ../defs/pipe.d):00045         *** PP.Read must have bit 4 clear; PP.Writ must be PP.Read XOR 4
     000A             (   ../defs/pipe.d):00046         PD.Read             EQU       .
000A                  (   ../defs/pipe.d):00047         PD.RPID             RMB       1                   ;Process ID of reader waiting on signal
000B                  (   ../defs/pipe.d):00048         PD.RCT              RMB       1                   ;Number of blocked readers
000C                  (   ../defs/pipe.d):00049         PD.RSIG             RMB       1                   ;Signal to send reader
000D                  (   ../defs/pipe.d):00050         PD.REOR             RMB       1                   ;Read EOR character
     000E             (   ../defs/pipe.d):00051         PD.Writ             EQU       .
000E                  (   ../defs/pipe.d):00052         PD.WPID             RMB       1                   ;Process ID of writer waiting on signal
000F                  (   ../defs/pipe.d):00053         PD.WCT              RMB       1                   ;Number of blocked writers
0010                  (   ../defs/pipe.d):00054         PD.WSIG             RMB       1                   ;Signal to send writer
0011                  (   ../defs/pipe.d):00055         PD.WEOR             RMB       1                   ;Write EOR character (dummy)
                      (   ../defs/pipe.d):00056         *** End of special section
0012                  (   ../defs/pipe.d):00057         PD.End              RMB       2                   ;Pointer to end of pipe buffer
0014                  (   ../defs/pipe.d):00058         PD.NxtI             RMB       2                   ;Next in pointer
0016                  (   ../defs/pipe.d):00059         PD.NxtO             RMB       2                   ;Next out pointer
0018                  (   ../defs/pipe.d):00060         PD.RFlg             RMB       1                   ;"Ready" flag
0019                  (   ../defs/pipe.d):00061         PD.Wrtn             RMB       1                   ;"Written" flag
001A                  (   ../defs/pipe.d):00062         PD.BCnt             RMB       2                   ;# queue elements currently bufered
001C                  (   ../defs/pipe.d):00063         PD.Own              RMB       1                   ;Process ID of pipe original creator
001D                  (   ../defs/pipe.d):00064         PD.Keep             RMB       1                   ;Non-zero if pipe has been kept open artificailly
001E                  (   ../defs/pipe.d):00065         PD.QSiz             RMB       2                   ;Max. elements in queue (copied from OPT section)
                      (   ../defs/pipe.d):00066         
                      (   ../defs/pipe.d):00067         *
                      (   ../defs/pipe.d):00068         *   Path descriptor option section
                      (   ../defs/pipe.d):00069         *
                      (   ../defs/pipe.d):00070         *   Note that PD.Name overlaps with the last byte of PD.ECnt.
                      (   ../defs/pipe.d):00071         *   PD.ECnt is copied to PD.QSiz as part of OPEN or CREATE,
                      (   ../defs/pipe.d):00072         *   to make room for the pipe name.
                      (   ../defs/pipe.d):00073         *
                      (   ../defs/pipe.d):00074                             ORG       (PD.OPT+1)
0021                  (   ../defs/pipe.d):00075         PD.ESiz             RMB       1                   ;Size of each queue element
0022                  (   ../defs/pipe.d):00076         PD.ECnt             RMB       2                   ;Max. elements in queue (initial position)
                      (   ../defs/pipe.d):00077                             IFGT      Level-1
                      (   ../defs/pipe.d):00078                             ORG       (PD.OPT+3)
0024                  (   ../defs/pipe.d):00079         PD.Name             RMB       NameMax
                      (   ../defs/pipe.d):00080                             ENDC
                      (   ../defs/pipe.d):00081         
                      (   ../defs/pipe.d):00082         *
                      (   ../defs/pipe.d):00083         *   Device Descriptor definitions
                      (   ../defs/pipe.d):00084         *
     0012             (   ../defs/pipe.d):00085         IT.PDC              EQU       $12                 ;Pipe device class (like IT.DTP, IT.DVC)
                      (   ../defs/pipe.d):00086                             ORG       IT.PDC
0012                  (   ../defs/pipe.d):00087                             RMB       1                   ;Leave room for device class
0013                  (   ../defs/pipe.d):00088         IT.ESiz             RMB       1                   ;Size of each queue element
0014                  (   ../defs/pipe.d):00089         IT.ECnt             RMB       2                   ;Max. elements in queue (initial position)
                      (   ../defs/pipe.d):00090         
                      (   ../defs/pipe.d):00091         *   End of pipe.d
                      (   ../defs/pipe.d):00092         
                      (   ../defs/pipe.d):00093                             ENDC
                      (   ../defs/pipe.d):00094         
                      (     sys6809l1.as):00012                             use       ../defs/rbsuper.d
                      (../defs/rbsuper.d):00001                             IFNE      RBSUPER.D-1
     0001             (../defs/rbsuper.d):00002         RBSUPER.D           SET       1
                      (../defs/rbsuper.d):00003         
                      (../defs/rbsuper.d):00004         ********************************************************************
                      (../defs/rbsuper.d):00005         * rbsuper.d - rbsuper definitions
                      (../defs/rbsuper.d):00006         *
                      (../defs/rbsuper.d):00007         * (C) 2004 Boisy G. Pitre - Licensed to Cloud-9
                      (../defs/rbsuper.d):00008         *
                      (../defs/rbsuper.d):00009         * These definitions make up the static storage environment for the
                      (../defs/rbsuper.d):00010         * rbsuper driver.  Low level drivers share these variables with
                      (../defs/rbsuper.d):00011         * rbsuper, and also have an area reserved exclusively for their use.
                      (../defs/rbsuper.d):00012         *
                      (../defs/rbsuper.d):00013         * Edt/Rev  YYYY/MM/DD  Modified by
                      (../defs/rbsuper.d):00014         * Comment
                      (../defs/rbsuper.d):00015         * ------------------------------------------------------------------
                      (../defs/rbsuper.d):00016         *          2004/04/10  Boisy G. Pitre
                      (../defs/rbsuper.d):00017         * Created.
                      (../defs/rbsuper.d):00018         *
                      (../defs/rbsuper.d):00019         *          2005/11/27  Boisy G. Pitre
                      (../defs/rbsuper.d):00020         * Moved SCSI base addresses and I/O offsets to here.
                      (../defs/rbsuper.d):00021         *
                      (../defs/rbsuper.d):00022         *          2005/12/13  Boisy G. Pitre
                      (../defs/rbsuper.d):00023         * Employed a "trick" whereby driver's U is pointed UOFFSET bytes
                      (../defs/rbsuper.d):00024         * into the static storage for faster, smaller code generation.
                      (../defs/rbsuper.d):00025         *
                      (../defs/rbsuper.d):00026         *          2005/12/13  Boisy G. Pitre
                      (../defs/rbsuper.d):00027         * Rearranged order of driver statics for smaller code size
                      (../defs/rbsuper.d):00028         
                      (../defs/rbsuper.d):00029         * Interface Address
     FF00             (../defs/rbsuper.d):00030         SDAddr              SET       $FF00
     00FF             (../defs/rbsuper.d):00031         SDMPI               SET       $FF
                      (../defs/rbsuper.d):00032         
                      (../defs/rbsuper.d):00033         *
                      (../defs/rbsuper.d):00034         * IT.DNS Definitions for all Low Level Drivers
                      (../defs/rbsuper.d):00035         *
     0008             (../defs/rbsuper.d):00036         DNS.HDB             EQU       %00001000
                      (../defs/rbsuper.d):00037         
                      (../defs/rbsuper.d):00038         *
                      (../defs/rbsuper.d):00039         * IT.DNS Definitions for Low Level SCSI Driver
                      (../defs/rbsuper.d):00040         *
     0010             (../defs/rbsuper.d):00041         DNS.TURBO           EQU       %00010000
                      (../defs/rbsuper.d):00042         
     0800             (../defs/rbsuper.d):00043         maxcache            SET       2048
     0008             (../defs/rbsuper.d):00044         DrvCount            EQU       8
     0040             (../defs/rbsuper.d):00045         llreserve           EQU       64
                      (../defs/rbsuper.d):00046         
     013F             (../defs/rbsuper.d):00047         UOFFSET             EQU       DRVBEG+(DRVMEM*DrvCount)
                      (../defs/rbsuper.d):00048         
                      (../defs/rbsuper.d):00049                             ORG       0
0000                  (../defs/rbsuper.d):00050         V.LLSema            RMB       1                   low-level semaphore variable
0001                  (../defs/rbsuper.d):00051         V.LastDrv           RMB       1                   last drive to access cache
0002                  (../defs/rbsuper.d):00052         V.PhysSect          RMB       3                   physical (HW) sector
0005                  (../defs/rbsuper.d):00053         V.LogSect           RMB       3                   logical (256 byte) sector
0008                  (../defs/rbsuper.d):00054         V.SectSize          RMB       1                   sector size
0009                  (../defs/rbsuper.d):00055         V.SectCnt           RMB       1                   number of hw sectors to read from interface
000A                  (../defs/rbsuper.d):00056         V.Log2Phys          RMB       1                   number of logical (256) byte sectors to 1 physical sector
000B                  (../defs/rbsuper.d):00057         V.CchAddr           RMB       2                   address of cache in system memory
000D                  (../defs/rbsuper.d):00058         V.CchSize           RMB       2                   size of cache in bytes
000F                  (../defs/rbsuper.d):00059         V.CchPSpot          RMB       2                   pointer to target physical sector in cache
0011                  (../defs/rbsuper.d):00060         V.CchLSpot          RMB       2                   pointer to target logical sector in cache
0013                  (../defs/rbsuper.d):00061         V.CchDirty          RMB       1                   cache dirty flag (0 = cache is stable, !0 = cache is dirty)
0014                  (../defs/rbsuper.d):00062         V.CchBase           RMB       3                   logical sector at start of cache
0017                  (../defs/rbsuper.d):00063         V.HDBDrive          RMB       1                   IT.STP (used as HDB-DOS drive number if HDB-DOS partition)
0018                  (../defs/rbsuper.d):00064         V.HDBPart           RMB       1                   HDB-DOS partition flag (0 = not HDB-DOS partition, !0 = is)
0019                  (../defs/rbsuper.d):00065         V.SSCache           RMB       DrvCount            sector size cache table for each drive
0021                  (../defs/rbsuper.d):00066         V.LLAddr            RMB       2                   low level module address
0023                  (../defs/rbsuper.d):00067         V.LLInit            RMB       2                   low level init entry point
0025                  (../defs/rbsuper.d):00068         V.LLRead            RMB       2                   low level read entry point
0027                  (../defs/rbsuper.d):00069         V.LLWrite           RMB       2                   low level write entry point
0029                  (../defs/rbsuper.d):00070         V.LLGtSt            RMB       2                   low level getstat entry point
002B                  (../defs/rbsuper.d):00071         V.LLStSt            RMB       2                   low level setstat entry point
002D                  (../defs/rbsuper.d):00072         V.LLTerm            RMB       2                   low level term entry point
                      (../defs/rbsuper.d):00073         * Low Level Driver Memory starts here
     002F             (../defs/rbsuper.d):00074         V.LLMem             EQU       .                   start of low level driver memory
002F                  (../defs/rbsuper.d):00075                             RMB       llreserve           reserved area... low level driver uses this as it wants
     0040             (../defs/rbsuper.d):00076         V.LLMemSz           EQU       .-V.LLMem
                      (../defs/rbsuper.d):00077         * Note: we trick rbsuper too so that it thinks its static storage starts at
                      (../defs/rbsuper.d):00078         * zero when it really starts beyond DRVBEG+(DRVMEM*DrvCount).
006F                  (../defs/rbsuper.d):00079                             RMB       UOFFSET
     01AE             (../defs/rbsuper.d):00080         V.RBSuper           EQU       .                   end of RBSuper's (and ll driver's) memory requirements
                      (../defs/rbsuper.d):00081         
                      (../defs/rbsuper.d):00082                             ENDC
                      (../defs/rbsuper.d):00083         
                      (     sys6809l1.as):00013                             use       ../defs/drivewire.d
                      (/defs/drivewire.d):00001                             IFNE      DRIVEWIRE.D-1
     0001             (/defs/drivewire.d):00002         DRIVEWIRE.D         SET       1
                      (/defs/drivewire.d):00003         ********************************************************************
                      (/defs/drivewire.d):00004         * drivewire.d - DriveWire Definitions File
                      (/defs/drivewire.d):00005         *
                      (/defs/drivewire.d):00006         * Ed.    Comments                                       Who YY/MM/DD
                      (/defs/drivewire.d):00007         * ------------------------------------------------------------------
                      (/defs/drivewire.d):00008         *   1    Started                                        BGP 03/04/03
                      (/defs/drivewire.d):00009         *   2    Added DWGLOBS area                             BGP 09/12/27
                      (/defs/drivewire.d):00010         
                      (/defs/drivewire.d):00011                             nam       drivewire.d
                      (/defs/drivewire.d):00012                             ttl       DriveWire Definitions File
                      (/defs/drivewire.d):00013         
                      (/defs/drivewire.d):00014         * Addresses
     FF20             (/defs/drivewire.d):00015         BBOUT               equ       $FF20
     FF22             (/defs/drivewire.d):00016         BBIN                equ       $FF22
                      (/defs/drivewire.d):00017         
                      (/defs/drivewire.d):00018          IFNE MEGAMINIMPI
01AE                  (/defs/drivewire.d):00019         MPIREG      equ    $FF7F        MPI Register
01AE                  (/defs/drivewire.d):00020         CTSMASK     equ    $F0          Get CTS
01AE                  (/defs/drivewire.d):00021         CTSSHIFT    equ    $4           Number of shifts for CTS
01AE                  (/defs/drivewire.d):00022         SCSMASK     equ    $0F          Get SCS
                      (/defs/drivewire.d):00023         
01AE                  (/defs/drivewire.d):00024         MMMSLT      equ    $05          MPI Slot(SCS) for MegaMiniMPI
                      (/defs/drivewire.d):00025         
                      (/defs/drivewire.d):00026         * Uart Base Address
01AE                  (/defs/drivewire.d):00027         MMMU1A      equ    $FF40        Address for UART 1
01AE                  (/defs/drivewire.d):00028         MMMU2A      equ    $FF50        Address for UART 2
                      (/defs/drivewire.d):00029          IFEQ MMMUART-1
01AE                  (/defs/drivewire.d):00030         MMMUARTB    equ    MMMU1A
                      (/defs/drivewire.d):00031          ENDC
                      (/defs/drivewire.d):00032          IFEQ MMMUART-2
01AE                  (/defs/drivewire.d):00033         MMMUARTB    equ    MMMU2A
                      (/defs/drivewire.d):00034          ENDC
                      (/defs/drivewire.d):00035          IFNDEF MMMUARTB
                      (/defs/drivewire.d):00036          ERROR MMMUART not defined, build with -DMMMUART=1 or -DMMMUART-2
                      (/defs/drivewire.d):00037          ENDC
                      (/defs/drivewire.d):00038         
                      (/defs/drivewire.d):00039         * 16550 Register offsets
01AE                  (/defs/drivewire.d):00040         THR         equ    $00          Transmit Holding Register
01AE                  (/defs/drivewire.d):00041         RHR         equ    $00          Recieve Holding Resister
01AE                  (/defs/drivewire.d):00042         IER         equ    $01          Interrupt Enable Register
01AE                  (/defs/drivewire.d):00043         IIR         equ    $02          Interrupt Identification Register
01AE                  (/defs/drivewire.d):00044         FCR         equ    $02          FIFO Control Register
01AE                  (/defs/drivewire.d):00045         LCR         equ    $03          Line Control Register
01AE                  (/defs/drivewire.d):00046         MCR         equ    $04          Modem Control Register
01AE                  (/defs/drivewire.d):00047         LSR         equ    $05          Line Status Register
01AE                  (/defs/drivewire.d):00048         MSR         equ    $06          Modem Status Register
01AE                  (/defs/drivewire.d):00049         SCR         equ    $07          Scratch Register
01AE                  (/defs/drivewire.d):00050         RST         equ    $08          Reset
01AE                  (/defs/drivewire.d):00051         DLL         equ    $00          Divisor Latch LSB
01AE                  (/defs/drivewire.d):00052         DLM         equ    $01          Divisor Latch MSB
01AE                  (/defs/drivewire.d):00053         DL16        equ    $0A          16-bit divisor window
                      (/defs/drivewire.d):00054         
                      (/defs/drivewire.d):00055         * 16550 Line Control Register
01AE                  (/defs/drivewire.d):00056         LCR5BIT     equ    %00000000
01AE                  (/defs/drivewire.d):00057         LCR6BIT     equ    %00000001
01AE                  (/defs/drivewire.d):00058         LCR7BIT     equ    %00000010
01AE                  (/defs/drivewire.d):00059         LCR8BIT     equ    %00000011
01AE                  (/defs/drivewire.d):00060         LCRPARN     equ    %00000000
01AE                  (/defs/drivewire.d):00061         LCRPARE     equ    %00000100
01AE                  (/defs/drivewire.d):00062         LCRPARO     equ    %00001100
                      (/defs/drivewire.d):00063         * BREAK
01AE                  (/defs/drivewire.d):00064         BRKEN       equ    %01000000
01AE                  (/defs/drivewire.d):00065         BRKDIS      equ    %10111111
                      (/defs/drivewire.d):00066         * 16550 DLAB
01AE                  (/defs/drivewire.d):00067         DLABEN      equ    %10000000
01AE                  (/defs/drivewire.d):00068         DLABDIS     equ    %01111111
                      (/defs/drivewire.d):00069         
                      (/defs/drivewire.d):00070         * 16550 Baud Rate Definitions
01AE                  (/defs/drivewire.d):00071         MMMB600        equ    3072
01AE                  (/defs/drivewire.d):00072         MMMB1200       equ    1536
01AE                  (/defs/drivewire.d):00073         MMMB2400       equ    768
01AE                  (/defs/drivewire.d):00074         MMMB4800       equ    384
01AE                  (/defs/drivewire.d):00075         MMMB9600       equ    192
01AE                  (/defs/drivewire.d):00076         MMMB19200      equ    96
01AE                  (/defs/drivewire.d):00077         MMMB38400      equ    48
01AE                  (/defs/drivewire.d):00078         MMMB57600      equ    32
01AE                  (/defs/drivewire.d):00079         MMMB115200     equ    16
01AE                  (/defs/drivewire.d):00080         MMMB230400     equ    8
01AE                  (/defs/drivewire.d):00081         MMMB460800     equ    4
01AE                  (/defs/drivewire.d):00082         MMMB921600     equ    2
01AE                  (/defs/drivewire.d):00083         MMMB1843200    equ    1
                      (/defs/drivewire.d):00084         
                      (/defs/drivewire.d):00085         * 16550 Line Status Register Defs
01AE                  (/defs/drivewire.d):00086         LSRDR       equ    %00000001    LSR:Data Ready
01AE                  (/defs/drivewire.d):00087         LSRTHRE     equ    %00100000    LSR:Transmit Holding Register Empty
01AE                  (/defs/drivewire.d):00088         LSRTE       equ    %01000000    LSR:Transmit Empty
                      (/defs/drivewire.d):00089         
                      (/defs/drivewire.d):00090         * 16550 Fifo Control Register
01AE                  (/defs/drivewire.d):00091         FCRFEN     equ    %00000001    Enable RX and TX FIFOs
01AE                  (/defs/drivewire.d):00092         FCRFDIS    equ    %11111110    Disable RX and TX FIFOs
01AE                  (/defs/drivewire.d):00093         FCRRXFCLR  equ    %00000010    Clear RX FIFO
01AE                  (/defs/drivewire.d):00094         FCRTXFCLR  equ    %00000100    Clear TX FIFO
01AE                  (/defs/drivewire.d):00095         FCRTRG1B   equ    %00000000    1-Byte FIFO Trigger
01AE                  (/defs/drivewire.d):00096         FCRTRG4B   equ    %01000000    4-Byte FIFO Trigger
01AE                  (/defs/drivewire.d):00097         FCRTRG8B   equ    %10000000    8-Byte FIFO Trigger
01AE                  (/defs/drivewire.d):00098         FCRTRG14B  equ    %11000000    14-Byte FIFO Trigger
                      (/defs/drivewire.d):00099         
                      (/defs/drivewire.d):00100         * 16550 Modem Control Register
01AE                  (/defs/drivewire.d):00101         MCRDTREN   equ    %00000001    Enable DTR Output
01AE                  (/defs/drivewire.d):00102         MCRDTRDIS  equ    %11111110    Disable DTR Output
01AE                  (/defs/drivewire.d):00103         MCRRTSEN   equ    %00000010    Enable RTS Output
01AE                  (/defs/drivewire.d):00104         MCRRTSDIS  equ    %11111101    Disable RTS Output
01AE                  (/defs/drivewire.d):00105         MCRAFEEN   equ    %00100000    Enable Auto Flow Control
01AE                  (/defs/drivewire.d):00106         MCRAFEDIS  equ    %11011111    Disable Auto Flow Control
                      (/defs/drivewire.d):00107          ENDC
                      (/defs/drivewire.d):00108         
                      (/defs/drivewire.d):00109         
                      (/defs/drivewire.d):00110         
                      (/defs/drivewire.d):00111         * Opcodes
     0001             (/defs/drivewire.d):00112         OP_NAMEOBJ_MOUNT    equ       $01                 Named Object Mount
     0002             (/defs/drivewire.d):00113         OP_NAMEOBJ_CREATE   equ       $02                 Named Object Create
     0000             (/defs/drivewire.d):00114         OP_NOP              equ       $00                 No-Op
     00FE             (/defs/drivewire.d):00115         OP_RESET1           equ       $FE                 Server Reset
     00FF             (/defs/drivewire.d):00116         OP_RESET2           equ       $FF                 Server Reset
     00F8             (/defs/drivewire.d):00117         OP_RESET3           equ       $F8                 Server Reset
     005A             (/defs/drivewire.d):00118         OP_DWINIT           equ       'Z                  DriveWire dw3 init/OS9 boot
     0023             (/defs/drivewire.d):00119         OP_TIME             equ       '#                  Current time requested
     0024             (/defs/drivewire.d):00120         OP_SETTIME          equ       '$                  Current time requested
     0049             (/defs/drivewire.d):00121         OP_INIT             equ       'I                  Init routine called
     0052             (/defs/drivewire.d):00122         OP_READ             equ       'R                  Read one sector
     0072             (/defs/drivewire.d):00123         OP_REREAD           equ       'r                  Re-read one sector
     00D2             (/defs/drivewire.d):00124         OP_READEX           equ       'R+128              Read one sector
     00F2             (/defs/drivewire.d):00125         OP_REREADEX         equ       'r+128              Re-read one sector
     0057             (/defs/drivewire.d):00126         OP_WRITE            equ       'W                  Write one sector
     0077             (/defs/drivewire.d):00127         OP_REWRIT           equ       'w                  Re-write one sector
     0047             (/defs/drivewire.d):00128         OP_GETSTA           equ       'G                  GetStat routine called
     0053             (/defs/drivewire.d):00129         OP_SETSTA           equ       'S                  SetStat routine called
     0054             (/defs/drivewire.d):00130         OP_TERM             equ       'T                  Term routine called
     0045             (/defs/drivewire.d):00131         OP_SERINIT          equ       'E
     00C5             (/defs/drivewire.d):00132         OP_SERTERM          equ       'E+128
                      (/defs/drivewire.d):00133         
                      (/defs/drivewire.d):00134         * Printer opcodes
     0050             (/defs/drivewire.d):00135         OP_PRINT            equ       'P                  Print byte to the print buffer
     0046             (/defs/drivewire.d):00136         OP_PRINTFLUSH       equ       'F                  Flush the server print buffer
                      (/defs/drivewire.d):00137         
                      (/defs/drivewire.d):00138         * Serial opcodes
     0043             (/defs/drivewire.d):00139         OP_SERREAD          equ       'C
     0063             (/defs/drivewire.d):00140         OP_SERREADM         equ       'c
     00C3             (/defs/drivewire.d):00141         OP_SERWRITE         equ       'C+128
     0044             (/defs/drivewire.d):00142         OP_SERGETSTAT       equ       'D
     00C4             (/defs/drivewire.d):00143         OP_SERSETSTAT       equ       'D+128
                      (/defs/drivewire.d):00144         
     0081             (/defs/drivewire.d):00145         SS.Timer            equ       $81
     0082             (/defs/drivewire.d):00146         SS.EE               equ       $82
                      (/defs/drivewire.d):00147         
                      (/defs/drivewire.d):00148         * for dw vfm
     00D6             (/defs/drivewire.d):00149         OP_VFM              equ       'V+128
                      (/defs/drivewire.d):00150         
                      (/defs/drivewire.d):00151         * WireBug opcodes (Server-initiated)
     0042             (/defs/drivewire.d):00152         OP_WIREBUG_MODE     equ       'B
                      (/defs/drivewire.d):00153         * WireBug opcodes (Server-initiated)
     0052             (/defs/drivewire.d):00154         OP_WIREBUG_READREGS equ       'R                  Read the CoCo's registers
     0072             (/defs/drivewire.d):00155         OP_WIREBUG_WRITEREGS equ       'r                  Write the CoCo's registers
     004D             (/defs/drivewire.d):00156         OP_WIREBUG_READMEM  equ       'M                  Read the CoCo's memory
     006D             (/defs/drivewire.d):00157         OP_WIREBUG_WRITEMEM equ       'm                  Write the CoCo's memory
     0047             (/defs/drivewire.d):00158         OP_WIREBUG_GO       equ       'G                  Tell CoCo to get out of WireBug mode and continue execution
                      (/defs/drivewire.d):00159         
                      (/defs/drivewire.d):00160         * VPort opcodes (CoCo-initiated)
     0056             (/defs/drivewire.d):00161         OP_VPORT_READ       equ       'V
     0076             (/defs/drivewire.d):00162         OP_VPORT_WRITE      equ       'v
                      (/defs/drivewire.d):00163         
                      (/defs/drivewire.d):00164         * Error definitions
     00F3             (/defs/drivewire.d):00165         E_CRC               equ       $F3                 Same as NitrOS-9 E$CRC
                      (/defs/drivewire.d):00166         
                      (/defs/drivewire.d):00167         * DW Globals Page Definitions (must be 256 bytes max)
     001F             (/defs/drivewire.d):00168         DW.StatCnt          equ       15+16
                      (/defs/drivewire.d):00169                             org       $00
0000                  (/defs/drivewire.d):00170         DW.StatTbl          rmb       DW.StatCnt          page pointers for terminal device static storage
001F                  (/defs/drivewire.d):00171         DW.VIRQPkt          rmb       Vi.PkSz
0024                  (/defs/drivewire.d):00172         DW.VIRQNOP          rmb       1
                      (/defs/drivewire.d):00173         
                      (/defs/drivewire.d):00174         
                      (/defs/drivewire.d):00175         *****************************************
                      (/defs/drivewire.d):00176         * dw3 subroutine module entry points
                      (/defs/drivewire.d):00177         *
     0000             (/defs/drivewire.d):00178         DW$Init             equ       0
     0003             (/defs/drivewire.d):00179         DW$Read             equ       3
     0006             (/defs/drivewire.d):00180         DW$Write            equ       6
     0009             (/defs/drivewire.d):00181         DW$Term             equ       9
                      (/defs/drivewire.d):00182         
                      (/defs/drivewire.d):00183         
                      (/defs/drivewire.d):00184         
                      (/defs/drivewire.d):00185         *****************************************
                      (/defs/drivewire.d):00186         * SCF Multi Terminal Driver Definitions
                      (/defs/drivewire.d):00187         *
                      (/defs/drivewire.d):00188                             org       V.SCF               ;V.SCF: free memory for driver to use
001D                  (/defs/drivewire.d):00189         SSigID              rmb       1                   ;process ID for signal on data ready
001E                  (/defs/drivewire.d):00190         SSigSg              rmb       1                   ;signal on data ready code
001F                  (/defs/drivewire.d):00191         RxDatLen            rmb       1                   ;current length of data in Rx buffer
0020                  (/defs/drivewire.d):00192         RxBufSiz            rmb       1                   ;Rx buffer size
0021                  (/defs/drivewire.d):00193         RxBufEnd            rmb       2                   ;end of Rx buffer
0023                  (/defs/drivewire.d):00194         RxBufGet            rmb       2                   ;Rx buffer output pointer
0025                  (/defs/drivewire.d):00195         RxBufPut            rmb       2                   ;Rx buffer input pointer
0027                  (/defs/drivewire.d):00196         RxGrab              rmb       1                   ;bytes to grab in multiread
0028                  (/defs/drivewire.d):00197         RxBufPtr            rmb       2                   ;pointer to Rx buffer
     00D6             (/defs/drivewire.d):00198         RxBufDSz            equ       256-.               ;default Rx buffer gets remainder of page...
002A                  (/defs/drivewire.d):00199         RxBuff              rmb       RxBufDSz            ;default Rx buffer
     0100             (/defs/drivewire.d):00200         SCFDrvMemSz         equ       .
                      (/defs/drivewire.d):00201         
                      (/defs/drivewire.d):00202                             ENDC
                      (/defs/drivewire.d):00203         
                      (     sys6809l1.as):00014         
                      (     sys6809l1.as):00015                             endsect
                      (         atari.as):00002         
                      (         atari.as):00003                             section   _constant
                      (         atari.as):00004         
                      (         atari.as):00005                             use       ../defs/atari.d
                      (  ../defs/atari.d):00001                             ifne      ATARI.D-1
     0001             (  ../defs/atari.d):00002         ATARI.D             set       1
                      (  ../defs/atari.d):00003         
                      (  ../defs/atari.d):00004         ********************************************************************
                      (  ../defs/atari.d):00005         * AtariDefs - NitrOS-9 System Definitions for the Atari XE/XL
                      (  ../defs/atari.d):00006         *
                      (  ../defs/atari.d):00007         * This is a high level view of the Atari XE/XL memory map as setup by
                      (  ../defs/atari.d):00008         * NitrOS-9.
                      (  ../defs/atari.d):00009         *
                      (  ../defs/atari.d):00010         *     $0000----> ==================================
                      (  ../defs/atari.d):00011         *               |                                  |
                      (  ../defs/atari.d):00012         *               |      NitrOS-9 Globals/Stack      |
                      (  ../defs/atari.d):00013         *               |                                  |
                      (  ../defs/atari.d):00014         *     $0500---->|==================================|
                      (  ../defs/atari.d):00015         *               |                                  |
                      (  ../defs/atari.d):00016         *               |               Atari              |
                      (  ../defs/atari.d):00017         *  $0500-$08BF  |           Screen Memory          |
                      (  ../defs/atari.d):00018         *               |              (40x24)             |
                      (  ../defs/atari.d):00019         *               |                                  |
                      (  ../defs/atari.d):00020         *               |----------------------------------|
                      (  ../defs/atari.d):00021         *  $08C0-$08FF  |         ANTIC Display List       |
                      (  ../defs/atari.d):00022         *     $9000---->|----------------------------------|
                      (  ../defs/atari.d):00023         *               |                                  |
                      (  ../defs/atari.d):00024         *                 . . . . . . . . . . . . . . . . .
                      (  ../defs/atari.d):00025         *               |                                  |
                      (  ../defs/atari.d):00026         *               |   RAM available for allocation   |
                      (  ../defs/atari.d):00027         *               |       by NitrOS-9 and Apps       |
                      (  ../defs/atari.d):00028         *               |                                  |
                      (  ../defs/atari.d):00029         *                 . . . . . . . . . . . . . . . . .
                      (  ../defs/atari.d):00030         *               |                                  |
                      (  ../defs/atari.d):00031         *     $C000---->|==================================|
                      (  ../defs/atari.d):00032         *               |                                  |
                      (  ../defs/atari.d):00033         *  $C000-$CFFF  |               ROM                |
                      (  ../defs/atari.d):00034         *               |                                  |
                      (  ../defs/atari.d):00035         *     $D000---->|==================================|
                      (  ../defs/atari.d):00036         *               |                                  |
                      (  ../defs/atari.d):00037         *               |   XEGS Memory Mapped I/O Region  |
                      (  ../defs/atari.d):00038         *               |(may differ in location on others)|
                      (  ../defs/atari.d):00039         *               |                                  |
                      (  ../defs/atari.d):00040         *     $D800---->|==================================|
                      (  ../defs/atari.d):00041         *               |                                  |
                      (  ../defs/atari.d):00042         *  $D800-$FFFF  |               ROM                |
                      (  ../defs/atari.d):00043         *               |                                  |
                      (  ../defs/atari.d):00044         *               |==================================|
                      (  ../defs/atari.d):00045         *
                      (  ../defs/atari.d):00046         * Note that ROM above becomes RAM if booting from DriveWire.
                      (  ../defs/atari.d):00047         *
                      (  ../defs/atari.d):00048         * Atari Hardware is documented here:
                      (  ../defs/atari.d):00049         *   http://user.xmission.com/~trevin/atari/pokey_regs.html
                      (  ../defs/atari.d):00050         *
                      (  ../defs/atari.d):00051         * Edt/Rev  YYYY/MM/DD  Modified by
                      (  ../defs/atari.d):00052         * Comment
                      (  ../defs/atari.d):00053         * ------------------------------------------------------------------
                      (  ../defs/atari.d):00054         *          2012/02/23  Boisy G. Pitre
                      (  ../defs/atari.d):00055         * Started
                      (  ../defs/atari.d):00056         
                      (  ../defs/atari.d):00057                             nam       AtariDefs
                      (  ../defs/atari.d):00058                             ttl       NitrOS-9 System Definitions for the Atari XE/XL
                      (  ../defs/atari.d):00059         
                      (  ../defs/atari.d):00060         
                      (  ../defs/atari.d):00061         
                      (  ../defs/atari.d):00062         **********************************
                      (  ../defs/atari.d):00063         * Power Line Frequency Definitions
                      (  ../defs/atari.d):00064         *
     0032             (  ../defs/atari.d):00065         Hz50                equ       50                  Assemble clock for 50 hz power
     003C             (  ../defs/atari.d):00066         Hz60                equ       60                  Assemble clock for 60 hz power
                      (  ../defs/atari.d):00067                             IFNDEF    PwrLnFrq
     003C             (  ../defs/atari.d):00068         PwrLnFrq            set       Hz60                Set to Appropriate freq
                      (  ../defs/atari.d):00069                             ENDC
                      (  ../defs/atari.d):00070         
                      (  ../defs/atari.d):00071         
                      (  ../defs/atari.d):00072         **********************************
                      (  ../defs/atari.d):00073         * Ticks per second
                      (  ../defs/atari.d):00074         *
                      (  ../defs/atari.d):00075                             IFNDEF    TkPerSec
                      (  ../defs/atari.d):00076                             ifeq      PwrLnFrq-Hz50
0000                  (  ../defs/atari.d):00077         TkPerSec            set       50
                      (  ../defs/atari.d):00078                             else
     003C             (  ../defs/atari.d):00079         TkPerSec            set       60
                      (  ../defs/atari.d):00080                             endc
                      (  ../defs/atari.d):00081                             ENDC
                      (  ../defs/atari.d):00082         
                      (  ../defs/atari.d):00083         
                      (  ../defs/atari.d):00084         *************************************************
                      (  ../defs/atari.d):00085         *
                      (  ../defs/atari.d):00086         * NitrOS-9 Level 1 Section
                      (  ../defs/atari.d):00087         *
                      (  ../defs/atari.d):00088         *************************************************
                      (  ../defs/atari.d):00089         
                      (  ../defs/atari.d):00090         ********************************
                      (  ../defs/atari.d):00091         * Boot defs for NitrOS-9 Level 1
                      (  ../defs/atari.d):00092         *
                      (  ../defs/atari.d):00093         * These defs are not strictly for 'Boot', but are for booting the
                      (  ../defs/atari.d):00094         * system.
                      (  ../defs/atari.d):00095         *
     8000             (  ../defs/atari.d):00096         Bt.Start            set       $8000
     1080             (  ../defs/atari.d):00097         Bt.Size             EQU       $1080               Maximum size of bootfile
     0000             (  ../defs/atari.d):00098         Bt.Track            EQU       $0000
     0000             (  ../defs/atari.d):00099         Bt.Sec              EQU       0
     00FF             (  ../defs/atari.d):00100         HW.Page             set       $FF                 Device descriptor hardware page
                      (  ../defs/atari.d):00101         
                      (  ../defs/atari.d):00102         
                      (  ../defs/atari.d):00103         ********************************************************************
                      (  ../defs/atari.d):00104         * NitrOS-9 Memory Definitions for the Atari XE/XL
                      (  ../defs/atari.d):00105         *
                      (  ../defs/atari.d):00106         * The Atari's support chips have certain alignment restrictions for
                      (  ../defs/atari.d):00107         * things like screen memory, display lists and character maps.  For this
                      (  ../defs/atari.d):00108         * reason, we reserve some low memory for the screen.
                      (  ../defs/atari.d):00109         *
                      (  ../defs/atari.d):00110         * Screen memory range is $0500-$08FF (1K).  Of that, 40*24 (960) bytes
                      (  ../defs/atari.d):00111         * are for the screen buffer and the remaining 64 bytes are for the
                      (  ../defs/atari.d):00112         * ANTIC's Display List
     0028             (  ../defs/atari.d):00113         G.Cols              equ       40
     0018             (  ../defs/atari.d):00114         G.Rows              equ       24
     0500             (  ../defs/atari.d):00115         G.ScrStart          equ       $0500
     08C0             (  ../defs/atari.d):00116         G.ScrEnd            equ       G.ScrStart+(G.Cols*G.Rows)
                      (  ../defs/atari.d):00117         
                      (  ../defs/atari.d):00118         * The Character Set must be aligned to a 4K address.  We can really only
                      (  ../defs/atari.d):00119         * guarnatee that in the Krn module, which is always at the end of RAM.  So
                      (  ../defs/atari.d):00120         * for now, the character set is located at $F800
     F800             (  ../defs/atari.d):00121         G.CharSetAddr       equ       $F800
                      (  ../defs/atari.d):00122         
                      (  ../defs/atari.d):00123         * POKEY requires shadow registers.  We allocate them in the kernel's DP
                      (  ../defs/atari.d):00124         * (Yes, we are stealing an existing variable that is so old it should be
                      (  ../defs/atari.d):00125         *  removed from os9defs)
     0002             (  ../defs/atari.d):00126         D.IRQENShdw         equ       $02                 ; was D.WDBtDr
     0003             (  ../defs/atari.d):00127         D.SKCTLShdw         equ       $03                 ; was D.SWPage
                      (  ../defs/atari.d):00128         
                      (  ../defs/atari.d):00129         * The clock interrupt is driven by the unmaskable NMI.  Therefore,
                      (  ../defs/atari.d):00130         * the rbdw3 driver uses the DWIOSEMA flag in the D.ATARIFLAGS field as
                      (  ../defs/atari.d):00131         * a signal, setting it before doing an DW operation and clearing it after.
                      (  ../defs/atari.d):00132         * The clock ISR checks if this flag is set, and, if so, defers the OP_TIME
                      (  ../defs/atari.d):00133         * command to the server.
     0080             (  ../defs/atari.d):00134         DWIOSEMA            equ       %10000000
                      (  ../defs/atari.d):00135         
                      (  ../defs/atari.d):00136         
                      (  ../defs/atari.d):00137         ********************************************************************
                      (  ../defs/atari.d):00138         * Atari XE/XL Hardware Definitions
                      (  ../defs/atari.d):00139         *
                      (  ../defs/atari.d):00140         * These were lifted from the Atari OS disassembly, and represents all
                      (  ../defs/atari.d):00141         * of the hardware registers available on the Atari XE/XL
                      (  ../defs/atari.d):00142         *
                      (  ../defs/atari.d):00143         
                      (  ../defs/atari.d):00144         
                      (  ../defs/atari.d):00145         *************************************************
                      (  ../defs/atari.d):00146         **      CTIA/GTIA Address Equates
     D000             (  ../defs/atari.d):00147         CTIA                equ       $D000               ;CTIA/GTIA area
                      (  ../defs/atari.d):00148         
                      (  ../defs/atari.d):00149         *       Read/Write Addresses
     D01F             (  ../defs/atari.d):00150         CONSOL              equ       CTIA+$1F            ;console switches and speaker control
                      (  ../defs/atari.d):00151         
                      (  ../defs/atari.d):00152         *       Read Addresses
     D000             (  ../defs/atari.d):00153         M0PF                equ       CTIA+$00            ;missle 0 and playfield collision
     D001             (  ../defs/atari.d):00154         M1PF                equ       CTIA+$01            ;missle 1 and playfield collision
     D002             (  ../defs/atari.d):00155         M2PF                equ       CTIA+$02            ;missle 2 and playfield collision
     D003             (  ../defs/atari.d):00156         M3PF                equ       CTIA+$03            ;missle 3 and playfield collision
                      (  ../defs/atari.d):00157         
     D004             (  ../defs/atari.d):00158         P0PF                equ       CTIA+$04            ;player 0 and playfield collision
     D005             (  ../defs/atari.d):00159         P1PF                equ       CTIA+$05            ;player 1 and playfield collision
     D006             (  ../defs/atari.d):00160         P2PF                equ       CTIA+$06            ;player 2 and playfield collision
     D007             (  ../defs/atari.d):00161         P3PF                equ       CTIA+$07            ;player 3 and playfield collision
                      (  ../defs/atari.d):00162         
     D008             (  ../defs/atari.d):00163         M0PL                equ       CTIA+$08            ;missle 0 and player collision
     D009             (  ../defs/atari.d):00164         M1PL                equ       CTIA+$09            ;missle 1 and player collision
     D00A             (  ../defs/atari.d):00165         M2PL                equ       CTIA+$0A            ;missle 2 and player collision
     D00B             (  ../defs/atari.d):00166         M3PL                equ       CTIA+$0B            ;missle 3 and player collision
                      (  ../defs/atari.d):00167         
     D00C             (  ../defs/atari.d):00168         P0PL                equ       CTIA+$0C            ;player 0 and player collision
     D00D             (  ../defs/atari.d):00169         P1PL                equ       CTIA+$0D            ;player 1 and player collision
     D00E             (  ../defs/atari.d):00170         P2PL                equ       CTIA+$0E            ;player 2 and player collision
     D00F             (  ../defs/atari.d):00171         P3PL                equ       CTIA+$0F            ;player 3 and player collision
                      (  ../defs/atari.d):00172         
     D010             (  ../defs/atari.d):00173         TRIG0               equ       CTIA+$10            ;joystick trigger 0
     D011             (  ../defs/atari.d):00174         TRIG1               equ       CTIA+$11            ;joystick trigger 1
                      (  ../defs/atari.d):00175         
     D012             (  ../defs/atari.d):00176         TRIG2               equ       CTIA+$12            ;cartridge interlock
     D013             (  ../defs/atari.d):00177         TRIG3               equ       CTIA+$13            ;ACMI module interlock
                      (  ../defs/atari.d):00178         
     D014             (  ../defs/atari.d):00179         PAL                 equ       CTIA+$14            ;PAL/NTSC indicator
                      (  ../defs/atari.d):00180         
                      (  ../defs/atari.d):00181         * Write Addresses
     D000             (  ../defs/atari.d):00182         HPOSP0              equ       CTIA+$00            ;player 0 horizontal position
     D001             (  ../defs/atari.d):00183         HPOSP1              equ       CTIA+$01            ;player 1 horizontal position
     D002             (  ../defs/atari.d):00184         HPOSP2              equ       CTIA+$02            ;player 2 horizontal position
     D003             (  ../defs/atari.d):00185         HPOSP3              equ       CTIA+$03            ;player 3 horizontal position
                      (  ../defs/atari.d):00186         
     D004             (  ../defs/atari.d):00187         HPOSM0              equ       CTIA+$04            ;missle 0 horizontal position
     D005             (  ../defs/atari.d):00188         HPOSM1              equ       CTIA+$05            ;missle 1 horizontal position
     D006             (  ../defs/atari.d):00189         HPOSM2              equ       CTIA+$06            ;missle 2 horizontal position
     D007             (  ../defs/atari.d):00190         HPOSM3              equ       CTIA+$07            ;missle 3 horizontal position
                      (  ../defs/atari.d):00191         
     D008             (  ../defs/atari.d):00192         SIZEP0              equ       CTIA+$08            ;player 0 size
     D009             (  ../defs/atari.d):00193         SIZEP1              equ       CTIA+$09            ;player 1 size
     D00A             (  ../defs/atari.d):00194         SIZEP2              equ       CTIA+$0A            ;player 2 size
     D00B             (  ../defs/atari.d):00195         SIZEP3              equ       CTIA+$0B            ;player 3 size
                      (  ../defs/atari.d):00196         
     D00C             (  ../defs/atari.d):00197         SIZEM               equ       CTIA+$0C            ;missle sizes
                      (  ../defs/atari.d):00198         
     D00D             (  ../defs/atari.d):00199         GRAFP0              equ       CTIA+$0D            ;player 0 graphics
     D00E             (  ../defs/atari.d):00200         GRAFP1              equ       CTIA+$0E            ;player 1 graphics
     D00F             (  ../defs/atari.d):00201         GRAFP2              equ       CTIA+$0F            ;player 2 graphics
     D010             (  ../defs/atari.d):00202         GRAFP3              equ       CTIA+$10            ;player 3 graphics
                      (  ../defs/atari.d):00203         
     D011             (  ../defs/atari.d):00204         GRAFM               equ       CTIA+$11            ;missle graphics
                      (  ../defs/atari.d):00205         
