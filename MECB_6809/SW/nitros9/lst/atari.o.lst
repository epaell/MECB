                      (/defs/atarivtio.d):00004         ********************************************************************
                      (/defs/atarivtio.d):00005         * VTIO Defs for the Atari XE/XL
                      (/defs/atarivtio.d):00006         * Everything that the VTIO driver needs is defined here, including
                      (/defs/atarivtio.d):00007         * static memory definitions
                      (/defs/atarivtio.d):00008         
                      (/defs/atarivtio.d):00009         * Constant Definitions
     0008             (/defs/atarivtio.d):00010         KBufSz              EQU       8                   circular buffer size
                      (/defs/atarivtio.d):00011         
                      (/defs/atarivtio.d):00012         * Driver static memory.
                      (/defs/atarivtio.d):00013                             ORG       V.SCF
001D                  (/defs/atarivtio.d):00014         V.CurRow            RMB       1                   the current row where the next character goes
001E                  (/defs/atarivtio.d):00015         V.CurCol            RMB       1                   the current column where the next character goes
001F                  (/defs/atarivtio.d):00016         V.CurChr            RMB       1                   the character under the cursor
0020                  (/defs/atarivtio.d):00017         V.CapsLck           RMB       1                   the CAPS LOCK key up/down flag ($00 = up)
0021                  (/defs/atarivtio.d):00018         V.KySns             RMB       1                   the key sense flags
0022                  (/defs/atarivtio.d):00019         V.EscCh1            RMB       2                   the escape vector handler for the first character after the escape code
0024                  (/defs/atarivtio.d):00020         V.EscVect           RMB       2                   the escape vector handle
0026                  (/defs/atarivtio.d):00021         V.Reverse           RMB       1                   the reverse video flag ($00 = off, $FF = on)
0027                  (/defs/atarivtio.d):00022         V.FBCol             RMB       1                   the currently selected foreground and background color
0028                  (/defs/atarivtio.d):00023         V.BordCol           RMB       1                   the currently selected border color
0029                  (/defs/atarivtio.d):00024         V.KCVect            RMB       2                   the PS/2 key code handler
002B                  (/defs/atarivtio.d):00025         V.IBufH             RMB       1                   the input buffer head pointer
002C                  (/defs/atarivtio.d):00026         V.IBufT             RMB       1                   the input buffer tail pointer
002D                  (/defs/atarivtio.d):00027         V.CrsrOff            RMB       1                  the cursor off flag
002E                  (/defs/atarivtio.d):00028         V.EscParms          RMB       20
                      (/defs/atarivtio.d):00029         * DWSet Parameters
     002E             (/defs/atarivtio.d):00030         V.DWType            set       V.EscParms+0
     002F             (/defs/atarivtio.d):00031         V.DWStartX          set       V.EscParms+1
     0030             (/defs/atarivtio.d):00032         V.DWStartY          set       V.EscParms+2
     0031             (/defs/atarivtio.d):00033         V.DWWidth           set       V.EscParms+3
     0032             (/defs/atarivtio.d):00034         V.DWHeight          set       V.EscParms+4
     0033             (/defs/atarivtio.d):00035         V.DWFore            set       V.EscParms+5
     0034             (/defs/atarivtio.d):00036         V.DWBack            set       V.EscParms+6
     0035             (/defs/atarivtio.d):00037         V.DWBorder          set       V.EscParms+7
                      (/defs/atarivtio.d):00038         
0042                  (/defs/atarivtio.d):00039         V.InBuf             RMB       KBufSz              the input buffer
004A                  (/defs/atarivtio.d):00040                             RMB       250-.
     00FA             (/defs/atarivtio.d):00041         V.Last              EQU       .
                      (/defs/atarivtio.d):00042                             ENDC
                      (         atari.as):00007         
                      (         atari.as):00008                             endsect

