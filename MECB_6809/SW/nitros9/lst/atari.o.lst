                      (  ../defs/atari.d):00294         ** PIA Address Equates
     D300             (  ../defs/atari.d):00295         PIA                 equ       $D300               ;PIA area
                      (  ../defs/atari.d):00296         
                      (  ../defs/atari.d):00297         * Read/Write Addresses
     D300             (  ../defs/atari.d):00298         PORTA               equ       PIA+$00             ;port A direction register or jacks 0 and 1
     D301             (  ../defs/atari.d):00299         PORTB               equ       PIA+$01             ;port B direction register or memory control
                      (  ../defs/atari.d):00300         
     D302             (  ../defs/atari.d):00301         PACTL               equ       PIA+$02             ;port A control
     D303             (  ../defs/atari.d):00302         PBCTL               equ       PIA+$03             ;port B control
                      (  ../defs/atari.d):00303         
                      (  ../defs/atari.d):00304         * PIA bit assignments for XEGS:
                      (  ../defs/atari.d):00305         * bit 7 0 = Self-Test switched in, but only if OS Rom is also switched in
                      (  ../defs/atari.d):00306         * bit 6 0 = Missile Command @ $A000 but ony if Basic Rom is switched out
                      (  ../defs/atari.d):00307         *
                      (  ../defs/atari.d):00308         * bit 1 0 = Basic switched in
                      (  ../defs/atari.d):00309         * bit 0 1 = OS Rom switched in, opposite behaviour for this bit vs all the others relating to Rom.
                      (  ../defs/atari.d):00310         
                      (  ../defs/atari.d):00311         
                      (  ../defs/atari.d):00312         *************************************************
