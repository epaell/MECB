0005                  (            os9.d):01137         R$X                 EQU       4                   X Index register
0005                  (            os9.d):01138         R$Y                 EQU       6                   Y Index register
0005                  (            os9.d):01139         R$U                 EQU       8                   User Stack register
0005                  (            os9.d):01140         R$PC                EQU       10                  Program Counter register
0005                  (            os9.d):01141         R$Size              EQU       12                  Total register package size
                      (            os9.d):01142                             ENDC
