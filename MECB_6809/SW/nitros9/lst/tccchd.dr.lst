                      (       tccchd.asm):00022         * experimental no DP version 9-11-90
                      (       tccchd.asm):00023         **************************************************************
                      (       tccchd.asm):00024         *     T C C C (TC^3)                                         *
                      (       tccchd.asm):00025         *     H A R D   D I S K       device driver for CoCo OS9     *
                      (       tccchd.asm):00026         *                             written by Robert E. Brose II  *
                      (       tccchd.asm):00027         *     uses Western digital WD 1002-shd or Xebec 5" controller*
                      (       tccchd.asm):00028         *     host adapter modeled after example in Xebec manual     *
                      (       tccchd.asm):00029         *     Allows use of 2 different drives with separate offsets *
                      (       tccchd.asm):00030         *     for partitioning (ms 13 bits of 21 bit sector #)       *
                      (       tccchd.asm):00031         **************************************************************
                      (       tccchd.asm):00032         *
                      (       tccchd.asm):00033         *
                      (       tccchd.asm):00034         * physical drive number stored in IT.DNS.
                      (       tccchd.asm):00035         *
                      (       tccchd.asm):00036         * revision history
                      (       tccchd.asm):00037         *------------------------------------
                      (       tccchd.asm):00038         * 2.0 Totally revamped
                      (       tccchd.asm):00039         *     Controller number gotten from the PD (PD.DNS lower 4 bits).
                      (       tccchd.asm):00040         *     Avoids use of DP, it's faster without it.
                      (       tccchd.asm):00041         *     Most subroutines moved to inline code to increase speed
                      (       tccchd.asm):00042         *     Added time slice release if controller is busy 12/01/90
                      (       tccchd.asm):00043         *     set blocks in init instead of doing it on every packet 12/01/90
                      (       tccchd.asm):00044         * 2.1 Added adaptec conditional statements 02-23-92
                      (       tccchd.asm):00045         *     Uniform descriptors, params adaptec doesn't need are ignored 02-23-92
                      (       tccchd.asm):00046         * 2.2 init/don't init drive, bit 6 of PD.DNS. 1=don't init 1-15-94
                      (       tccchd.asm):00047         *     resets drive in setup routine 1-16-94
                      (       tccchd.asm):00048         *     locks scsi packet, elims conflict on multiple drives on the same
                      (       tccchd.asm):00049         *     host adapter. 1-16-94
                      (       tccchd.asm):00050         *     altered format to work with seagate drives. 1-16-94
                      (       tccchd.asm):00051         * 5/6.x changed revisn and versn below to match up with this history 1-19-94
                      (       tccchd.asm):00052         * 5.x 256 byte sectors version.
                      (       tccchd.asm):00053         * 6.x 1K HD sectors version. 1-19-94
                      (       tccchd.asm):00054         * 5/6.2 added HOG flag for maximum speed, to hog the cpu
                      (       tccchd.asm):00055         * 5/6/7/8.3 Added MEDSEC for 512 byte sectors
                      (       tccchd.asm):00056         * 5/6/7/8.4 much 6309 optimisation
                      (       tccchd.asm):00057         * 9.x Redid version/revision stuff again. Version is now 9, revision
                      (       tccchd.asm):00058         *     indicates sector size. 6809: 1=256 by/sec 2=512 by/sec 3=1024 by/sec
                      (       tccchd.asm):00059         *     Nitros 6309  4=256 by/sec 5=512 by/sec 6=1024 by/sec
                      (       tccchd.asm):00060         *10.x Changes to allow >1 drive with large sectors. 11-5-94
                      (       tccchd.asm):00061         *     UGH removed for now, flush is too complicated with BIGSEC
                      (       tccchd.asm):00062         *     changed 6309 block moves to I/O to allow for a gap to service serial
                      (       tccchd.asm):00063         *      interrupts every 256 moves (affects sector sizes >256 bytes). 3-25-95
                      (       tccchd.asm):00064         *11.x Optimizations from better understanding about when the driver can
                      (       tccchd.asm):00065         *     be interupted, thanks Alan DeKok. 1-7-96
                      (       tccchd.asm):00066         *     Handles inits of several scsi id'd devices. 1-7-96
                      (       tccchd.asm):00067         *     Fixed Calcsec, logread and logwrit to handle 512 bytes/sector 1-8-96
                      (       tccchd.asm):00068         *12.x Added DISTO HD II support 3-9-96
                      (       tccchd.asm):00069         *      notes: sleep causes the only possible reentrant situation (~HOG)
                      (       tccchd.asm):00070         *              in this case cmd block and cache buffer must be preserved.
                      (       tccchd.asm):00071         *             To make multiple drives/driver work for 512 and 1024 (BUFSEC)
                      (       tccchd.asm):00072         *              cases will require info like drive, lun, offset, etc to be
                      (       tccchd.asm):00073         *              save for the previous sector so a cache flush can be done. YUK!
                      (       tccchd.asm):00074         *     Added sector 0 cache because rbf accesses it all the darn time! 6-8-96
                      (       tccchd.asm):00075         
     0001             (       tccchd.asm):00076         H6309               equ       1                   if 6309 cpu, 0=on!
                      (       tccchd.asm):00077         
                      (       tccchd.asm):00078                             ttl       equates
     0001             (       tccchd.asm):00079         DBHS                equ       1                   data requires req handshake version 0=ON! (i.e. adaptec)
     0001             (       tccchd.asm):00080         BIGSEC              equ       1                   use 1024 byte physical sectors (0=ON!)
     0000             (       tccchd.asm):00081         MEDSEC              equ       0                   use 512 byte physical sectors (0=ON!)
     0001             (       tccchd.asm):00082         HOG                 equ       1                   hog the cpu on waits (speeds up disk access 0=ON!)
     0001             (       tccchd.asm):00083         DISTO               equ       1                   use HD II ports and status bits (0=ON!)
     0001             (       tccchd.asm):00084         MDRIVES             equ       1                   can use more than 1 drive / driver in BUFSEC case (0=ON!)
     0001             (       tccchd.asm):00085         MPAK                equ       1                   includes multipak switching code (needed for DISTO w/ MPAK 0=ON!)
     0000             (       tccchd.asm):00086         CANFORM             equ       0                   drive formatting allowed (0=ON!)
     0001             (       tccchd.asm):00087         CACHE               equ       1                   sector 0 cache (0=ON!).
                      (       tccchd.asm):00088         
                      (       tccchd.asm):00089         
                      (       tccchd.asm):00090         * BUFSEC below means a buffer is used when reading/writing physical secs
                      (       tccchd.asm):00091         * (0=on)
                      (       tccchd.asm):00092         
                      (       tccchd.asm):00093                             ifeq      BIGSEC
0000                  (       tccchd.asm):00094         BUFSEC              equ       $0
0000                  (       tccchd.asm):00095         m.smask             equ       %11111100
0000                  (       tccchd.asm):00096         m.nsmask            equ       %00000011
                      (       tccchd.asm):00097                             else
                      (       tccchd.asm):00098         
                      (       tccchd.asm):00099                             ifeq      MEDSEC
     0000             (       tccchd.asm):00100         BUFSEC              equ       $0
     00FE             (       tccchd.asm):00101         m.smask             equ       %11111110
     0001             (       tccchd.asm):00102         m.nsmask            equ       %00000001
                      (       tccchd.asm):00103                             else
                      (       tccchd.asm):00104         
0000                  (       tccchd.asm):00105         BUFSEC              equ       $1
                      (       tccchd.asm):00106                             endc
                      (       tccchd.asm):00107                             endc
                      (       tccchd.asm):00108         
                      (       tccchd.asm):00109                             ifeq      H6309
                      (       tccchd.asm):00110         
                      (       tccchd.asm):00111                             ifeq      BIGSEC
0000                  (       tccchd.asm):00112         revisn              equ       6
                      (       tccchd.asm):00113                             else
                      (       tccchd.asm):00114                             ifeq      MEDSEC
0000                  (       tccchd.asm):00115         revisn              equ       5
                      (       tccchd.asm):00116                             else
0000                  (       tccchd.asm):00117         revisn              equ       4
                      (       tccchd.asm):00118                             endc
                      (       tccchd.asm):00119                             endc
                      (       tccchd.asm):00120         
                      (       tccchd.asm):00121                             else
                      (       tccchd.asm):00122         
                      (       tccchd.asm):00123                             ifeq      BIGSEC
0000                  (       tccchd.asm):00124         revisn              equ       3
                      (       tccchd.asm):00125                             else
                      (       tccchd.asm):00126                             ifeq      MEDSEC
     0002             (       tccchd.asm):00127         revisn              equ       2
                      (       tccchd.asm):00128                             else
0000                  (       tccchd.asm):00129         revisn              equ       1
                      (       tccchd.asm):00130                             endc
                      (       tccchd.asm):00131                             endc
                      (       tccchd.asm):00132         
                      (       tccchd.asm):00133                             endc
                      (       tccchd.asm):00134         
     000C             (       tccchd.asm):00135         verson              equ       12
                      (       tccchd.asm):00136         
     0004             (       tccchd.asm):00137         numdrvs             equ       4                   number of drives supported by driver (logical)
                      (       tccchd.asm):00138         * status byte mask
                      (       tccchd.asm):00139         
     0002             (       tccchd.asm):00140         m.error             equ       %00000010           error flag
                      (       tccchd.asm):00141         
                      (       tccchd.asm):00142         * status register bit masks
                      (       tccchd.asm):00143         
                      (       tccchd.asm):00144                             ifeq      DISTO
0000                  (       tccchd.asm):00145         m.req               equ       %10000000           data request line
0000                  (       tccchd.asm):00146         m.busy              equ       %00000001           busy status line
                      (       tccchd.asm):00147         * broken on disto??? m.msg  equ %00000100 end of message status line
0000                  (       tccchd.asm):00148         m.msg               equ       %00000000           end of message status line
0000                  (       tccchd.asm):00149         m.cmd               equ       %01000000           command/data status line
0000                  (       tccchd.asm):00150         m.in                equ       %00100000           input/output status line
                      (       tccchd.asm):00151         * broken msg on disto ??? m.nnc  equ %11100101 unconnected lines = ignore mask
0000                  (       tccchd.asm):00152         m.nnc               equ       %11100001           unconnected lines = ignore mask
                      (       tccchd.asm):00153         
                      (       tccchd.asm):00154                             else
                      (       tccchd.asm):00155         
                      (       tccchd.asm):00156         * normal TCCC defs
     0001             (       tccchd.asm):00157         m.req               equ       %00000001           data request line
     0002             (       tccchd.asm):00158         m.busy              equ       %00000010           busy status line
     0004             (       tccchd.asm):00159         m.msg               equ       %00000100           end of message status line
     0008             (       tccchd.asm):00160         m.cmd               equ       %00001000           command/data status line
     0010             (       tccchd.asm):00161         m.in                equ       %00010000           input/output status line
                      (       tccchd.asm):00162         
                      (       tccchd.asm):00163                             endc
                      (       tccchd.asm):00164         
     0020             (       tccchd.asm):00165         m.phys              equ       %00100000           physical drive mask (LUN on Controller)
     0040             (       tccchd.asm):00166         m.init              equ       %01000000           initialize drive on change flag
     000F             (       tccchd.asm):00167         m.cont              equ       %00001111           controller address mask
     0010             (       tccchd.asm):00168         m.recal             equ       %00010000           do a recal (home) on 1st drive access
     0080             (       tccchd.asm):00169         m.format            equ       %10000000           enable format command
                      (       tccchd.asm):00170         
                      (       tccchd.asm):00171                             ifeq      MPAK
0000                  (       tccchd.asm):00172         m.mpscs             equ       %11110000           Mpak slot select SCS clearing mask
0000                  (       tccchd.asm):00173         mpsel               equ       $FF7F               multipak select latch addr, used for disto.
0000                  (       tccchd.asm):00174         EXTPRM              equ       25                  extra params in descriptor
                      (       tccchd.asm):00175                             else
     0018             (       tccchd.asm):00176         EXTPRM              equ       24                  extra params in descriptor
                      (       tccchd.asm):00177                             endc
                      (       tccchd.asm):00178         
                      (       tccchd.asm):00179         * input and output ports offsets for HOST ADAPTER bus
                      (       tccchd.asm):00180         
                      (       tccchd.asm):00181                             ifeq      DISTO
0000                  (       tccchd.asm):00182         datapo              equ       3                   read and write data
0000                  (       tccchd.asm):00183         rstpo               equ       1                   software reset
0000                  (       tccchd.asm):00184         selpo               equ       2                   controller select
0000                  (       tccchd.asm):00185         statpo              equ       1                   read status
                      (       tccchd.asm):00186                             else
                      (       tccchd.asm):00187         
                      (       tccchd.asm):00188         * Normal TCCC defines
     0000             (       tccchd.asm):00189         datapo              equ       0                   read and write data
     0001             (       tccchd.asm):00190         rstpo               equ       1                   software reset
     0002             (       tccchd.asm):00191         selpo               equ       2                   controller select
     0003             (       tccchd.asm):00192         selrst              equ       3                   reset of select (scuzzie adapters)
     0001             (       tccchd.asm):00193         statpo              equ       1                   read status
                      (       tccchd.asm):00194         
                      (       tccchd.asm):00195                             endc
                      (       tccchd.asm):00196         
                      (       tccchd.asm):00197         * controller opcodes
                      (       tccchd.asm):00198         
     0000             (       tccchd.asm):00199         o.ready             equ       $00                 test for drive ready
     000C             (       tccchd.asm):00200         o.param             equ       $0c                 set parameters for the drives
     0008             (       tccchd.asm):00201         o.read              equ       $08                 read sector(s)
     000A             (       tccchd.asm):00202         o.write             equ       $0a                 write sector(s)
     0004             (       tccchd.asm):00203         o.formt             equ       $04                 format drive
     0001             (       tccchd.asm):00204         o.recal             equ       $01                 recalibrate drive (head to track 0)
                      (       tccchd.asm):00205         
                      (       tccchd.asm):00206                             ifp1
                      (       tccchd.asm):00207                             use       defsfile
     0002             (         defsfile):00001         Level   equ     2
                      (         defsfile):00002                 use     os9.d
                      (            os9.d):00001                             IFNE      OS9.D-1
