                      (       tccchd.asm):00211         
                      (       tccchd.asm):00212                             org       DRVBEG
000F                  (       tccchd.asm):00213         tables              rmb       DRVMEM*numdrvs      reserve space for system tables
                      (       tccchd.asm):00214         
                      (       tccchd.asm):00215         * command packet for controller
                      (       tccchd.asm):00216         
     00A7             (       tccchd.asm):00217         packet              equ       .
                      (       tccchd.asm):00218         
00A7                  (       tccchd.asm):00219         opcode              rmb       1                   command opcode
00A8                  (       tccchd.asm):00220         lun                 rmb       1                   logical unit number : ms part of lsn
00A9                  (       tccchd.asm):00221         lsn                 rmb       2                   logical sector number
00AB                  (       tccchd.asm):00222         blocks              rmb       1                   interleave or block count
00AC                  (       tccchd.asm):00223         control             rmb       1                   control byte set at packet send time
00AD                  (       tccchd.asm):00224         plocked             rmb       1                   above control block in use, locked
00AE                  (       tccchd.asm):00225         blocked             rmb       1                   buffer sector (caching) in use, locked
                      (       tccchd.asm):00226         
                      (       tccchd.asm):00227         * extra parameters read in from the descriptor.
                      (       tccchd.asm):00228         
00AF                  (       tccchd.asm):00229         param               rmb       8                   physical drive 0 params
00B7                  (       tccchd.asm):00230         param1              rmb       8                   physical drive 1 params
                      (       tccchd.asm):00231         
                      (       tccchd.asm):00232         * logical drive offsets
                      (       tccchd.asm):00233         
00BF                  (       tccchd.asm):00234         offsd1              rmb       2
00C1                  (       tccchd.asm):00235         offsd2              rmb       2
00C3                  (       tccchd.asm):00236         offsd3              rmb       2
00C5                  (       tccchd.asm):00237         offsd4              rmb       2
                      (       tccchd.asm):00238         
                      (       tccchd.asm):00239                             ifeq      MPAK
                      (       tccchd.asm):00240         * Multipak latch temp storage and slot.
00C7                  (       tccchd.asm):00241         mpslot              rmb       1                   From descriptor, FF = no mpak
                      (       tccchd.asm):00242                             endc
                      (       tccchd.asm):00243         
                      (       tccchd.asm):00244         * end of extra params read in from descriptor
                      (       tccchd.asm):00245         
                      (       tccchd.asm):00246                             ifeq      MPAK
00C7                  (       tccchd.asm):00247         mpstor              rmb       1                   Current multipak value outside of this driver.
                      (       tccchd.asm):00248                             endc
00C7                  (       tccchd.asm):00249         didflag             rmb       1                   read lsn 0 flag
00C8                  (       tccchd.asm):00250         lastphy             rmb       1                   last drive accessed (physical)
00C9                  (       tccchd.asm):00251         sec0fl              rmb       numdrvs             (recal (home) completed flag)
00CD                  (       tccchd.asm):00252         tempw1              rmb       2                   word temp var
00CF                  (       tccchd.asm):00253         tempw2              rmb       2                   word temp var
                      (       tccchd.asm):00254         
00D1                  (       tccchd.asm):00255         iniflg              rmb       numdrvs             whether or not the device has been initalized
                      (       tccchd.asm):00256         
                      (       tccchd.asm):00257                             ifeq      BUFSEC
                      (       tccchd.asm):00258         
                      (       tccchd.asm):00259                             ifeq      BIGSEC
00D5                  (       tccchd.asm):00260         secbuf              rmb       1024                buffer for physical sector
                      (       tccchd.asm):00261                             else
00D5                  (       tccchd.asm):00262         secbuf              rmb       512                 buffer for physical sector
                      (       tccchd.asm):00263                             endc
                      (       tccchd.asm):00264         
                      (       tccchd.asm):00265                             ifeq      CACHE
02D5                  (       tccchd.asm):00266         sec0                rmb       256*numdrvs         optional sector 0 cache
                      (       tccchd.asm):00267                             endc
                      (       tccchd.asm):00268         
02D5                  (       tccchd.asm):00269         lastdrv             rmb       1                   last LOGICAL drive accessed
02D6                  (       tccchd.asm):00270         lsech               rmb       1                   24 bit address, sector in buffer (logical w/o least sig 2 bits)
02D7                  (       tccchd.asm):00271         lsecm               rmb       1                   (part of above)
02D8                  (       tccchd.asm):00272         lsecl               rmb       1                   "
02D9                  (       tccchd.asm):00273         physech             rmb       1                   24 bit address, sector in buffer (physical sector in buffer)
02DA                  (       tccchd.asm):00274         physecm             rmb       1                   (part of above)
02DB                  (       tccchd.asm):00275         physecl             rmb       1                   "
02DC                  (       tccchd.asm):00276         cached              rmb       1                   cache is dirty flag
02DD                  (       tccchd.asm):00277         secidx              rmb       1                   index into physical sector
                      (       tccchd.asm):00278                             endc
                      (       tccchd.asm):00279         
     02DE             (       tccchd.asm):00280         endmem              equ       .
