                      (      jsr_cmd2.as):00001         ;;; JSR_CMD
                      (      jsr_cmd2.as):00002         ;;;
                      (      jsr_cmd2.as):00003         ;;; Jump to a subroutine from a two character command table.
                      (      jsr_cmd2.as):00004         ;;;
                      (      jsr_cmd2.as):00005         ;;; Entry:  D = Two character command.
                      (      jsr_cmd2.as):00006         ;;;         X = The start of the jump table.
                      (      jsr_cmd2.as):00007         ;;;
                      (      jsr_cmd2.as):00008         ;;; Exit:  CC = Carry set if entry isn't found.
                      (      jsr_cmd2.as):00009         ;;;
                      (      jsr_cmd2.as):00010         ;;; Each table entry is composed of four bytes:
                      (      jsr_cmd2.as):00011         ;;;     - Byte 0: The first command character.
                      (      jsr_cmd2.as):00012         ;;;     - Byte 1: The second command character.
                      (      jsr_cmd2.as):00013         ;;;     - Byte 2: The upper 8 bits of the address of the routine.
                      (      jsr_cmd2.as):00014         ;;;     - Byte 3: The lower 8 bits of the address of the routine.
                      (      jsr_cmd2.as):00015         ;;;
                      (      jsr_cmd2.as):00016         ;;; Mark the end of the table with a null byte.
                      (      jsr_cmd2.as):00017         ;;;
                      (      jsr_cmd2.as):00018         ;;; The commands are case significant.
                      (      jsr_cmd2.as):00019         ;;;
                      (      jsr_cmd2.as):00020         ;;; Here's an example:
                      (      jsr_cmd2.as):00021         ;;;
                      (      jsr_cmd2.as):00022         ;;;    fcc /A1/
                      (      jsr_cmd2.as):00023         ;;;    fdb routineA-*
                      (      jsr_cmd2.as):00024         ;;;    fcc /B1/
                      (      jsr_cmd2.as):00025         ;;;    fdb routineB-*
                      (      jsr_cmd2.as):00026         ;;;    fcb 0
                      (      jsr_cmd2.as):00027         
