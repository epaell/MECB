                      (       getclk.asm):00010         * MPI slot selection code
                      (       getclk.asm):00011         * $33 = Slot 4
                      (       getclk.asm):00012         * $22 = Slot 3
                      (       getclk.asm):00013         * $11 = Slot 2
                      (       getclk.asm):00014         * $00 = Slot 1
     0033             (       getclk.asm):00015         MPISlot             equ       $33
                      (       getclk.asm):00016         
     0011             (       getclk.asm):00017         tylg                set       Prgrm+Objct
     0082             (       getclk.asm):00018         atrv                set       ReEnt+rev
     0002             (       getclk.asm):00019         rev                 set       $02
