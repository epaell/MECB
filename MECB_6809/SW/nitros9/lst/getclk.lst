00D3                  (            os9.d):01280         E$EOF               RMB       1                   End of File
00D4                  (            os9.d):01281                             RMB       1
00D5                  (            os9.d):01282         E$NES               RMB       1                   Non-Existing Segment
00D6                  (            os9.d):01283         E$FNA               RMB       1                   File Not Accesible
00D7                  (            os9.d):01284         E$BPNam             RMB       1                   Bad Path Name
00D8                  (            os9.d):01285         E$PNNF              RMB       1                   Path Name Not Found
00D9                  (            os9.d):01286         E$SLF               RMB       1                   Segment List Full
00DA                  (            os9.d):01287         E$CEF               RMB       1                   Creating Existing File
00DB                  (            os9.d):01288         E$IBA               RMB       1                   Illegal Block Address
00DC                  (            os9.d):01289         E$HangUp            RMB       1                   Carrier Detect Lost
00DD                  (            os9.d):01290         E$MNF               RMB       1                   Module Not Found
00DE                  (            os9.d):01291                             RMB       1
00DF                  (            os9.d):01292         E$DelSP             RMB       1                   Deleting Stack Pointer memory
00E0                  (            os9.d):01293         E$IPrcID            RMB       1                   Illegal Process ID
     00E0             (            os9.d):01294         E$BPrcID            EQU       E$IPrcID            Bad Process ID (formerly #238)
00E1                  (            os9.d):01295                             RMB       1
00E2                  (            os9.d):01296         E$NoChld            RMB       1                   No Children
00E3                  (            os9.d):01297         E$ISWI              RMB       1                   Illegal SWI code
00E4                  (            os9.d):01298         E$PrcAbt            RMB       1                   Process Aborted
00E5                  (            os9.d):01299         E$PrcFul            RMB       1                   Process Table Full
