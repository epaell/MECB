     0001             (            rbf.d):00003         RBF.D               SET       1
                      (            rbf.d):00004         
                      (            rbf.d):00005         ********************************************************************
                      (            rbf.d):00006         * rbf.d - Random Block File Manager Definitions
                      (            rbf.d):00007         *
                      (            rbf.d):00008         * RBF stands for 'Random Block Filemanager' and is a package of subroutines
                      (            rbf.d):00009         * that define the logical structure of a disk and allows access to the files
                      (            rbf.d):00010         * in that structure.
                      (            rbf.d):00011         *
                      (            rbf.d):00012         * The data structures in this file give RBF its 'personality' and are used
                      (            rbf.d):00013         * by RBF itself, as well as applications that will require disk I/O.
                      (            rbf.d):00014         *
                      (            rbf.d):00015         * Edt/Rev  YYYY/MM/DD  Modified by
                      (            rbf.d):00016         * Comment
                      (            rbf.d):00017         * ------------------------------------------------------------------
                      (            rbf.d):00018         *          1982/07/13  Robert F. Doggett
                      (            rbf.d):00019         * PD.Exten added to path descriptor and PE Entries defined.
                      (            rbf.d):00020         *
                      (            rbf.d):00021         *          1982/07/15  Robert F. Doggett
                      (            rbf.d):00022         * V.FileHd inserted in driver static storage.
                      (            rbf.d):00023         *
                      (            rbf.d):00024         *          1982/09/10  WGP
                      (            rbf.d):00025         * Level One/Level Two condionals added.
                      (            rbf.d):00026         *
                      (            rbf.d):00027         *          1982/09/17  WGP
                      (            rbf.d):00028         *
                      (            rbf.d):00029         *          1982/09/17  Robert F. Doggett
                      (            rbf.d):00030         * PD.SLE renamed to PD.Creat.
                      (            rbf.d):00031         *
                      (            rbf.d):00032         *          1982/09/17  Robert F. Doggett
                      (            rbf.d):00033         * V.DiskID, V.BMapSz, V.MapSct added for smart multi-sector bitmap searching.
                      (            rbf.d):00034         *
                      (            rbf.d):00035         *          1982/09/20  Robert F. Doggett
                      (            rbf.d):00036         * Reserved areas added in static storage.
                      (            rbf.d):00037         
                      (            rbf.d):00038         *          1983/06/07  Robert F. Doggett
                      (            rbf.d):00039         * Added InDriver flag in PD.SMF.
                      (            rbf.d):00040         *
                      (            rbf.d):00041         *          1983/06/13  Robert F. Doggett
                      (            rbf.d):00042         * Added PE.Req tmp save for PE.Lock.
                      (            rbf.d):00043         *
                      (            rbf.d):00044         *          1983/08/08  Robert F. Doggett
                      (            rbf.d):00045         * Reserved PD.SToff for Japanese.
                      (            rbf.d):00046         *
                      (            rbf.d):00047         *          1983/11/19  Robert F. Doggett
                      (            rbf.d):00048         * Added V.ResBit in drive tables.
                      (            rbf.d):00049         *
                      (            rbf.d):00050         *          1983/12/12  Robert F. Doggett
                      (            rbf.d):00051         * Added PE.Prior to save process priority.
                      (            rbf.d):00052         *
                      (            rbf.d):00053         *          1983/12/13  Robert F. Doggett
                      (            rbf.d):00054         * Added BufBusy bit in state flag (PD.SMF).
                      (            rbf.d):00055         *
                      (            rbf.d):00056         *          1984/07/06  Mark G. Hawkins
                      (            rbf.d):00057         * Added Bit Definitions for DD.FMT.
                      (            rbf.d):00058         *
                      (            rbf.d):00059         *          1987/06/23  Kevin K. Darling
                      (            rbf.d):00060         * Updated with Dev Desc Info
                      (            rbf.d):00061         *
                      (            rbf.d):00062         *          2003/06/02  Boisy G. Pitre
                      (            rbf.d):00063         * Updated comments for clarity.
                      (            rbf.d):00064         * Added TYP.256-TYP.2048 definitions for future expansion.
                      (            rbf.d):00065         *
                      (            rbf.d):00066         *          2004/04/14  Boisy G. Pitre
                      (            rbf.d):00067         * Added new entries to device descriptor as per OS-9 Level One V2.00.00
                      (            rbf.d):00068         * addendum.  Pointed out by Rodney Hamilton.
                      (            rbf.d):00069         *
                      (            rbf.d):00070         *              2005/05/31  P.Harvey-Smith.
                      (            rbf.d):00071         * Added defines for bit 2 of IT.DNS, which the format command uses to
                      (            rbf.d):00072         * determine if a drive should have it's track 0 as single or double density
                      (            rbf.d):00073         *
                      (            rbf.d):00074         *          2005/11/23  Robert Gault
                      (            rbf.d):00075         * Added IT.MPI giving it duplicate location with IT.TFM. This will not be
                      (            rbf.d):00076         * transferred to the path descriptor, thus the  equ *  rahter than  rmb 1.
                      (            rbf.d):00077         *
                      (            rbf.d):00078         *          2005/12/11  Boisy G. Pitre
                      (            rbf.d):00079         * Added IT.SOFF1-ITSOFF3 and IT.LLDRV for SuperDrivers.
                      (            rbf.d):00080         
                      (            rbf.d):00081                             NAM       rbf.d
                      (            rbf.d):00082                             TTL       Random              Block File Manager Definitions
                      (            rbf.d):00083         
                      (            rbf.d):00084                             PAG
                      (            rbf.d):00085         *******************************
                      (            rbf.d):00086         * RBF Device Descriptor Offsets
                      (            rbf.d):00087         *
                      (            rbf.d):00088         * These definitions are for RBF device descriptors.
                      (            rbf.d):00089         
                      (            rbf.d):00090                             ORG       M$DTyp
0012                  (            rbf.d):00091                             RMB       1                   Device type (DT.RBF)
0013                  (            rbf.d):00092         IT.DRV              RMB       1                   Drive number
0014                  (            rbf.d):00093         IT.STP              RMB       1                   Step rate
0015                  (            rbf.d):00094         IT.TYP              RMB       1                   Disk device type information
0016                  (            rbf.d):00095         IT.DNS              RMB       1                   Density capability
0017                  (            rbf.d):00096         IT.CYL              RMB       2                   Number of cylinders
0019                  (            rbf.d):00097         IT.SID              RMB       1                   Number of surfaces
001A                  (            rbf.d):00098         IT.VFY              RMB       1                   Verify disk writes (0 = verify, 1 = don't)
001B                  (            rbf.d):00099         IT.SCT              RMB       2                   Default sectors/track
001D                  (            rbf.d):00100         IT.T0S              RMB       2                   Default sectors/track for track 0 sector 0
001F                  (            rbf.d):00101         IT.ILV              RMB       1                   Sector interleave offset
0020                  (            rbf.d):00102         IT.SAS              RMB       1                   Segment allocation size
                      (            rbf.d):00103         * The following fields are from the OS-9 Level One V2.00.00 Addendum
0021                  (            rbf.d):00104         IT.TFM              RMB       1                   DMA Transfer Mode
0022                  (            rbf.d):00105         IT.Exten            RMB       2                   Path Extension (PE) for record locking
0024                  (            rbf.d):00106         IT.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
                      (            rbf.d):00107         * The following fields are not copied to the path descriptor
0025                  (            rbf.d):00108         IT.WPC              RMB       1                   Write precomp cyl/4 (HD)
0026                  (            rbf.d):00109         IT.OFS              RMB       2                   Starting cylinder offset (HD)
0028                  (            rbf.d):00110         IT.RWC              RMB       2                   Reduced write current cylinder (HD)
                      (            rbf.d):00111         * These fields have been added because of SuperDriver.  They probably
                      (            rbf.d):00112         * can be used in other drivers
                      (            rbf.d):00113                             ORG       IT.WPC
0025                  (            rbf.d):00114         IT.SOFF1            RMB       1
0026                  (            rbf.d):00115         IT.SOFF2            RMB       1
0027                  (            rbf.d):00116         IT.SOFF3            RMB       1
0028                  (            rbf.d):00117         IT.LLDRV            RMB       2
002A                  (            rbf.d):00118         IT.MPI              RMB       1
                      (            rbf.d):00119         
                      (            rbf.d):00120         
                      (            rbf.d):00121         * IT.TYP Definitions
                      (            rbf.d):00122         *
     0080             (            rbf.d):00123         TYP.HARD            EQU       %10000000           Hard disk
     0000             (            rbf.d):00124         TYP.FLP             EQU       %00000000           Floppy disk
     0040             (            rbf.d):00125         TYP.NSF             EQU       %01000000           Non-standard format
     0000             (            rbf.d):00126         TYP.SOF             EQU       %00000000           Standard NitrOS-9 format
                      (            rbf.d):00127         
                      (            rbf.d):00128         * IT.TYP bit definitions if bit 7 of IT.TYP is set (hard disk)
     0000             (            rbf.d):00129         TYPH.256            EQU       %00000000           256 byte sector media
     0001             (            rbf.d):00130         TYPH.512            EQU       %00000001           512 byte sector media
     0002             (            rbf.d):00131         TYPH.1024           EQU       %00000010           1024 byte sector media
     0003             (            rbf.d):00132         TYPH.2048           EQU       %00000011           2048 byte sector media
     0003             (            rbf.d):00133         TYPH.SSM            EQU       %00000011           Sector size mask
     000C             (            rbf.d):00134         TYPH.DRSV           EQU       %00001100           Driver-reserved bits
     0010             (            rbf.d):00135         TYPH.DSQ            EQU       %00010000           Drive size query flag
                      (            rbf.d):00136         
                      (            rbf.d):00137         * IT.TYP bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (            rbf.d):00138         TYP.5               EQU       %00000000           5" media
     0001             (            rbf.d):00139         TYP.3               EQU       %00000001           3.5" media
     0002             (            rbf.d):00140         TYP.SBO             EQU       %00000010           Sector base offset (clear = 0; sect = 1)
     0000             (            rbf.d):00141         TYP.256             EQU       %00000000           256 byte sector media
     0004             (            rbf.d):00142         TYP.512             EQU       %00000100           512 byte sector media
     0020             (            rbf.d):00143         TYP.CCF             EQU       %00100000           CoCo format
     0000             (            rbf.d):00144         TYP.NCCF            EQU       %00000000           Non-CoCo format
                      (            rbf.d):00145         
                      (            rbf.d):00146         * IT.DNS Definitions
                      (            rbf.d):00147         *
                      (            rbf.d):00148         
                      (            rbf.d):00149         * If bit 7 of IT.TYP is set, IT.DNS is driver-dependent
                      (            rbf.d):00150         
                      (            rbf.d):00151         * IT.DNS bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (            rbf.d):00152         DNS.FM              EQU       %00000000           Single-density (FM)
     0001             (            rbf.d):00153         DNS.MFM             EQU       %00000001           Double-density (MFM)
     0000             (            rbf.d):00154         DNS.STD             EQU       %00000000           Single track distance (48/135 tpi)
     0002             (            rbf.d):00155         DNS.DTD             EQU       %00000010           Double track distance (96 tpi)
                      (            rbf.d):00156         
                      (            rbf.d):00157         * Added PHS,2005-05-31, as format seems to use these
     0000             (            rbf.d):00158         DNS.FM0             EQU       %00000000           Single density track 0
     0004             (            rbf.d):00159         DNS.MFM0            EQU       %00000100           Double density track 0
                      (            rbf.d):00160         
                      (            rbf.d):00161         * Floppy disk step rate definitions
     0000             (            rbf.d):00162         STP.30ms            EQU       0                   30ms step rate
     0001             (            rbf.d):00163         STP.20ms            EQU       1                   20ms step rate
     0002             (            rbf.d):00164         STP.12ms            EQU       2                   12ms step rate
     0003             (            rbf.d):00165         STP.6ms             EQU       3                   6ms step rate
                      (            rbf.d):00166         
                      (            rbf.d):00167                             PAG
                      (            rbf.d):00168         *************************************
                      (            rbf.d):00169         * Random Block Path Descriptor Format
                      (            rbf.d):00170         *
                      (            rbf.d):00171         * A path descriptor is created for every new path that is open
                      (            rbf.d):00172         * via the I$Open system call (processed by IOMan).  Process
                      (            rbf.d):00173         * descriptors track state information of a path.
                      (            rbf.d):00174         *
                      (            rbf.d):00175                             ORG       PD.FST
000A                  (            rbf.d):00176         PD.SMF              RMB       1                   State flags
000B                  (            rbf.d):00177         PD.CP               RMB       4                   Current logical byte position
000F                  (            rbf.d):00178         PD.SIZ              RMB       4                   File size
0013                  (            rbf.d):00179         PD.SBL              RMB       3                   Segment beginning lsn
0016                  (            rbf.d):00180         PD.SBP              RMB       3                   Segment beginning psn
0019                  (            rbf.d):00181         PD.SSZ              RMB       3                   Segment size
001C                  (            rbf.d):00182         PD.DSK              RMB       2                   Disk id
001E                  (            rbf.d):00183         PD.DTB              RMB       2                   Drive table ptr
                      (            rbf.d):00184                             ORG       PD.OPT
0020                  (            rbf.d):00185                             RMB       1                   Device type
0021                  (            rbf.d):00186         PD.DRV              RMB       1                   Drive number
0022                  (            rbf.d):00187         PD.STP              RMB       1                   Step rate
0023                  (            rbf.d):00188         PD.TYP              RMB       1                   Disk device type (5" 8" other)
0024                  (            rbf.d):00189         PD.DNS              RMB       1                   Density capability
0025                  (            rbf.d):00190         PD.CYL              RMB       2                   Number of cylinders
0027                  (            rbf.d):00191         PD.SID              RMB       1                   Number of surfaces
0028                  (            rbf.d):00192         PD.VFY              RMB       1                   0=verify disk writes
0029                  (            rbf.d):00193         PD.SCT              RMB       2                   Default sectors/track
002B                  (            rbf.d):00194         PD.T0S              RMB       2                   Default sectors/track tr00,s0
002D                  (            rbf.d):00195         PD.ILV              RMB       1                   Sector interleave offset
002E                  (            rbf.d):00196         PD.SAS              RMB       1                   Segment allocation size
002F                  (            rbf.d):00197         PD.TFM              RMB       1                   DMA Transfer Mode
0030                  (            rbf.d):00198         PD.Exten            RMB       2                   Path Extension (PE) for record locking
0032                  (            rbf.d):00199         PD.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
0033                  (            rbf.d):00200         PD.ATT              RMB       1                   File attributes
0034                  (            rbf.d):00201         PD.FD               RMB       3                   File descriptor psn (i.e. 3-byte inode number)
0037                  (            rbf.d):00202         PD.DFD              RMB       3                   Directory file descriptor psn (i.e. 3-byte inode number)
003A                  (            rbf.d):00203         PD.DCP              RMB       4                   File directory entry ptr
003E                  (            rbf.d):00204         PD.DVT              RMB       2                   User readable dev tbl ptr
                      (            rbf.d):00205         
                      (            rbf.d):00206         * State Flags
     0001             (            rbf.d):00207         BUFMOD              EQU       $01                 Buffer modified
     0002             (            rbf.d):00208         SINBUF              EQU       $02                 Sector in buffer
     0004             (            rbf.d):00209         FDBUF               EQU       $04                 File descriptor in buffer
                      (            rbf.d):00210         *EOFSEC equ $08 End of file sector
                      (            rbf.d):00211         *EOF equ $10 End of file
     0020             (            rbf.d):00212         InDriver            EQU       $20                 Currently in Disk Driver, or queued
     0040             (            rbf.d):00213         BufBusy             EQU       $40                 Buffer is currently busy
                      (            rbf.d):00214         
                      (            rbf.d):00215                             IFNE      Level-1
                      (            rbf.d):00216         ************************************
                      (            rbf.d):00217         * Random Block Path Extension Format
                      (            rbf.d):00218         *
                      (            rbf.d):00219         * RBF paths under Level Two have additional information that
                      (            rbf.d):00220         * is referenced by the path extension area.  These are 64-byte
                      (            rbf.d):00221         * allocs from the same table (D.PthDBT) as the Path Descriptors.
                      (            rbf.d):00222         *
                      (            rbf.d):00223                             ORG       0
0040                  (            rbf.d):00224         PE.PE               RMB       1                   PE path number
0040                  (            rbf.d):00225         PE.PDptr            RMB       2                   Back ptr to this PE's Path Descriptor
0040                  (            rbf.d):00226         PE.NxFil            RMB       2                   Drive Open-File list ptr
0040                  (            rbf.d):00227         PE.Confl            RMB       2                   Circular File Conflict list
0040                  (            rbf.d):00228         PE.Lock             RMB       1                   Path lockout status
0040                  (            rbf.d):00229         PE.LoLck            RMB       4                   Low Locked Logical addr
0040                  (            rbf.d):00230         PE.HiLck            RMB       4                   High Locked Logical addr
0040                  (            rbf.d):00231         PE.Wait             RMB       2                   PE ptr to (next) locked-out PE
0040                  (            rbf.d):00232         PE.TmOut            RMB       2                   Max ticks to wait for locked segment
0040                  (            rbf.d):00233         PE.Owner            RMB       1                   Process ID of owner of locked segment
0040                  (            rbf.d):00234         PE.Req              RMB       1                   Temp for PE.Lock in GAIN when LockSeg fails
0040                  (            rbf.d):00235         PE.Prior            RMB       1                   Temp for process priority while in driver
0040                  (            rbf.d):00236         PE.SigSg            RMB       1                   Signal code to send
0040                  (            rbf.d):00237         PE.SigID            RMB       1                   Process ID to send the signal to
                      (            rbf.d):00238                             RMB       32-.                Reserved
0040                  (            rbf.d):00239         PE.FilNm            RMB       32                  Temp for filename during directory search
                      (            rbf.d):00240         
                      (            rbf.d):00241         * PE.Lock status codes
0040                  (            rbf.d):00242         Unlocked            EQU       0                   No portion of file is locked
0040                  (            rbf.d):00243         RcdLock             EQU       1                   Record from LoLck to HiLck locked
0040                  (            rbf.d):00244         FileLock            EQU       2                   Entire file locked
0040                  (            rbf.d):00245         EofLock             EQU       4                   End of file is locked
                      (            rbf.d):00246                             ENDC
                      (            rbf.d):00247         
                      (            rbf.d):00248         
                      (            rbf.d):00249                             PAG
                      (            rbf.d):00250         ***********************
                      (            rbf.d):00251         * LSN0 Disk Data Format
                      (            rbf.d):00252         *
                      (            rbf.d):00253         * Logical Sector Number 0 is the first sector on an RBF formatted device
                      (            rbf.d):00254         * and contains information about the device's size and format.
                      (            rbf.d):00255         *
                      (            rbf.d):00256                             ORG       0
0000                  (            rbf.d):00257         DD.TOT              RMB       3                   Total number of sectors
0003                  (            rbf.d):00258         DD.TKS              RMB       1                   Track size in sectors
0004                  (            rbf.d):00259         DD.MAP              RMB       2                   Number of bytes in allocation bit map
0006                  (            rbf.d):00260         DD.BIT              RMB       2                   Number of sectors/bit
0008                  (            rbf.d):00261         DD.DIR              RMB       3                   Address of root directory fd
000B                  (            rbf.d):00262         DD.OWN              RMB       2                   Owner
000D                  (            rbf.d):00263         DD.ATT              RMB       1                   Attributes
000E                  (            rbf.d):00264         DD.DSK              RMB       2                   Disk ID
0010                  (            rbf.d):00265         DD.FMT              RMB       1                   Disk format; density/sides
0011                  (            rbf.d):00266         DD.SPT              RMB       2                   Sectors/track
0013                  (            rbf.d):00267         DD.RES              RMB       2                   Reserved for future use
     0015             (            rbf.d):00268         DD.SIZ              EQU       .                   Device descriptor minimum size
0015                  (            rbf.d):00269         DD.BT               RMB       3                   System bootstrap sector
0018                  (            rbf.d):00270         DD.BSZ              RMB       2                   Size of system bootstrap
001A                  (            rbf.d):00271         DD.DAT              RMB       5                   Creation date
001F                  (            rbf.d):00272         DD.NAM              RMB       32                  Volume name
003F                  (            rbf.d):00273         DD.OPT              RMB       32                  Option area
                      (            rbf.d):00274         
                      (            rbf.d):00275         *************************
                      (            rbf.d):00276         * 2012/11/09 Gene Heskett - Some additions for bootlink etc use.
                      (            rbf.d):00277                             ORG       $60                 More options from device descriptor
0060                  (            rbf.d):00278         VD.STP              RMB       1                   This is for the /sh and /ih virtual disks in HDBDOS
0061                  (            rbf.d):00279         VD.OFS              RMB       3                   This is DT.WPC and DT.OSF combined, might be more
                      (            rbf.d):00280         
                      (            rbf.d):00281         * DD.FMT Bit Definitions - valid only if device is a floppy disk
     0001             (            rbf.d):00282         FMT.SIDE            EQU       %00000001           Single Sided=0, Double Sided=1
     0002             (            rbf.d):00283         FMT.DNS             EQU       %00000010           Single Density=0, Double Density=1
     0004             (            rbf.d):00284         FMT.TDNS            EQU       %00000100           Track Density: 48/135 TPI=0, 96 TPI=1
     0020             (            rbf.d):00285         FMT.T0DN            EQU       %00100000           Track 0 Density, see FMT.DNS
                      (            rbf.d):00286         
                      (            rbf.d):00287         
                      (            rbf.d):00288                             PAG
                      (            rbf.d):00289         ************************
                      (            rbf.d):00290         * File Descriptor Format
                      (            rbf.d):00291         *
                      (            rbf.d):00292         * The file descriptor is a sector that is present for every file
                      (            rbf.d):00293         * on an RBF device.  It contains attributes, modification dates,
                      (            rbf.d):00294         * and segment information on a file.
                      (            rbf.d):00295         *
                      (            rbf.d):00296                             ORG       0
0000                  (            rbf.d):00297         FD.ATT              RMB       1                   Attributes
0001                  (            rbf.d):00298         FD.OWN              RMB       2                   Owner
0003                  (            rbf.d):00299         FD.DAT              RMB       5                   Date last modified
0008                  (            rbf.d):00300         FD.LNK              RMB       1                   Link count
0009                  (            rbf.d):00301         FD.SIZ              RMB       4                   File size
000D                  (            rbf.d):00302         FD.Creat            RMB       3                   File creation date (YY/MM/DD)
     0010             (            rbf.d):00303         FD.SEG              EQU       .                   Beginning of segment list
                      (            rbf.d):00304         * Segment List Entry Format
                      (            rbf.d):00305                             ORG       0
0000                  (            rbf.d):00306         FDSL.A              RMB       3                   Segment beginning physical sector number
0003                  (            rbf.d):00307         FDSL.B              RMB       2                   Segment size
     0005             (            rbf.d):00308         FDSL.S              EQU       .                   Segment list entry size
     00FB             (            rbf.d):00309         FD.LS1              EQU       FD.SEG+((256-FD.SEG)/FDSL.S-1)*FDSL.S
     00FA             (            rbf.d):00310         FD.LS2              EQU       (256/FDSL.S-1)*FDSL.S
     0010             (            rbf.d):00311         MINSEC              SET       16
                      (            rbf.d):00312         
                      (            rbf.d):00313         
                      (            rbf.d):00314                             PAG
                      (            rbf.d):00315         ************************
                      (            rbf.d):00316         * Directory Entry Format
                      (            rbf.d):00317         *
                      (            rbf.d):00318         * Directory entries are part of a directory and define the name
                      (            rbf.d):00319         * of the file, as well as a pointer to its file descriptor.
                      (            rbf.d):00320         *
                      (            rbf.d):00321                             ORG       0
0000                  (            rbf.d):00322         DIR.NM              RMB       29                  File name
001D                  (            rbf.d):00323         DIR.FD              RMB       3                   File descriptor physical sector number
     0020             (            rbf.d):00324         DIR.SZ              EQU       .                   Directory record size
                      (            rbf.d):00325         
                      (            rbf.d):00326         
                      (            rbf.d):00327                             PAG
                      (            rbf.d):00328         ********************
                      (            rbf.d):00329         * RBF Static Storage
                      (            rbf.d):00330         *
                      (            rbf.d):00331         * Overall Disk Static Storage
                      (            rbf.d):00332         *
                      (            rbf.d):00333         * Note:  This does not reserve any memory for drive tables.  Each
                      (            rbf.d):00334         *        driver is responsible for reserving sufficient memory for
                      (            rbf.d):00335         *        the appropriate number of tables.
                      (            rbf.d):00336         *
                      (            rbf.d):00337                             ORG       V.USER              Reserve required           ($06)
0006                  (            rbf.d):00338         V.NDRV              RMB       1                   Number of drives           ($07)
0007                  (            rbf.d):00339                             RMB       8                   reserved                   ($08)
     000F             (            rbf.d):00340         DRVBEG              EQU       .                   Beginning of drive tables  ($10)
                      (            rbf.d):00341         
                      (            rbf.d):00342         
                      (            rbf.d):00343                             PAG
                      (            rbf.d):00344         ****************
                      (            rbf.d):00345         * Global Storage For Disk Drive Tables
                      (            rbf.d):00346         *
                      (            rbf.d):00347         * Each table contains the first 'DD.SIZ' bytes from
                      (            rbf.d):00348         * LSN 0, and the current track, stepping rate,
                      (            rbf.d):00349         * bitmap use flag, and disk type.
                      (            rbf.d):00350         *
                      (            rbf.d):00351                             ORG       0
0000                  (            rbf.d):00352                             RMB       DD.SIZ              Device descriptor, LSN 0
0015                  (            rbf.d):00353         V.TRAK              RMB       2                   Current track
0017                  (            rbf.d):00354         V.BMB               RMB       1                   Bit-map use flag
0018                  (            rbf.d):00355         V.FileHd            RMB       2                   Open file list for this drive
001A                  (            rbf.d):00356         V.DiskID            RMB       2                   Disk ID
001C                  (            rbf.d):00357         V.BMapSz            RMB       1                   Bitmap Size
001D                  (            rbf.d):00358         V.MapSct            RMB       1                   Lowest reasonable bitmap sector
001E                  (            rbf.d):00359         V.ResBit            RMB       1                   Reserved bitmap sector (for compaction)
001F                  (            rbf.d):00360         V.ScTkOf            RMB       1                   Sector/Track byte (Combined from descriptor)
0020                  (            rbf.d):00361         V.ScOfst            RMB       1                   Sector offset split from byte above
0021                  (            rbf.d):00362         V.TkOfst            RMB       1                   Track offset split from byte above
0022                  (            rbf.d):00363                             RMB       4                   Reserved
     0026             (            rbf.d):00364         DRVMEM              EQU       .
                      (            rbf.d):00365         
                      (            rbf.d):00366                             ENDC
                      (            rbf.d):00367         
                      (         defsfile):00006                  use   mecb.d
                      (           mecb.d):00001                             ifne      MECB.D-1
     0001             (           mecb.d):00002         MECB.D              set       1
                      (           mecb.d):00003         
                      (           mecb.d):00004         ********************************************************************
                      (           mecb.d):00005         * mecb.d - NitrOS-9 System Definitions for the Digicool MECB 6809
                      (           mecb.d):00006         *
                      (           mecb.d):00007         * This is a high level view of the Digicool MECB 6809 memory map as setup by
                      (           mecb.d):00008         * NitrOS-9.
                      (           mecb.d):00009         *
                      (           mecb.d):00010         *     $0000----> ==================================
                      (           mecb.d):00011         *               |                                  |
                      (           mecb.d):00012         *               |      NitrOS-9 Globals/Stack      |
                      (           mecb.d):00013         *               |                                  |
                      (           mecb.d):00014         *     $0500---->|==================================|
                      (           mecb.d):00015         *               |                                  |
                      (           mecb.d):00016         *                 . . . . . . . . . . . . . . . . .
                      (           mecb.d):00017         *               |                                  |
                      (           mecb.d):00018         *               |   RAM available for allocation   |
                      (           mecb.d):00019         *               |       by NitrOS-9 and Apps       |
                      (           mecb.d):00020         *               |                                  |
                      (           mecb.d):00021         *                 . . . . . . . . . . . . . . . . .
                      (           mecb.d):00022         *               |                                  |
                      (           mecb.d):00023         *     $DFFF---->|==================================|
                      (           mecb.d):00024         *               |                                  |
                      (           mecb.d):00025         *  $E000-$E0FF  |    Memory Mapped I/O Region      |
                      (           mecb.d):00026         *               |                                  |
                      (           mecb.d):00027         *     $E100---->|==================================|
                      (           mecb.d):00028         *               |                                  |
                      (           mecb.d):00029         *  $E100-$FFFF  |               ROM                |
                      (           mecb.d):00030         *               |                                  |
                      (           mecb.d):00031         *               |==================================|
                      (           mecb.d):00032         * Edt/Rev  YYYY/MM/DD  Modified by
                      (           mecb.d):00033         * Comment
                      (           mecb.d):00034         * ------------------------------------------------------------------
                      (           mecb.d):00035         *          2017/04/29  Boisy G. Pitre
                      (           mecb.d):00036         * Started
                      (           mecb.d):00037         
                      (           mecb.d):00038                             nam       mecb.d
                      (           mecb.d):00039                             ttl       NitrOS-9 System Definitions for the Digicool MECB 6809
                      (           mecb.d):00040         
                      (           mecb.d):00041         **********************************
                      (           mecb.d):00042         * Ticks per second
                      (           mecb.d):00043         *
                      (           mecb.d):00044                             IFNDEF    TkPerSec
     0032             (           mecb.d):00045         TkPerSec            SET       50
                      (           mecb.d):00046                             ENDC
                      (           mecb.d):00047         
                      (           mecb.d):00048         
                      (           mecb.d):00049         *************************************************
                      (           mecb.d):00050         *
                      (           mecb.d):00051         * NitrOS-9 Level 1 Section
                      (           mecb.d):00052         *
                      (           mecb.d):00053         *************************************************
                      (           mecb.d):00054         
                      (           mecb.d):00055         ; Presumably indicates where hardware is? epaell
     00E0             (           mecb.d):00056         HW.Page             set       $E0                 Device descriptor hardware page
                      (           mecb.d):00057         
                      (           mecb.d):00058         
                      (           mecb.d):00059         ********************************************************************
                      (           mecb.d):00060         * NitrOS-9 Memory Definitions for the DigiCool MECB 6809
                      (           mecb.d):00061         *
                      (           mecb.d):00062         
                      (           mecb.d):00063         ********************************************************************
                      (           mecb.d):00064         * Digicool MECB 6809 Hardware Definitions
                      (           mecb.d):00065         *
                      (           mecb.d):00066         
     FFE3             (           mecb.d):00067         S.FNexec            EQU       $FFE3
     FFE5             (           mecb.d):00068         S.Hex2Out           EQU       $FFE5
     FFE7             (           mecb.d):00069         S.Hex4Out           EQU       $FFE7
     FFE9             (           mecb.d):00070         S.CharOut           EQU       $FFE9
     FFEB             (           mecb.d):00071         S.StringOut         EQU       $FFEB
                      (           mecb.d):00072         
     E000             (           mecb.d):00073         IOBASE              equ       $E000
                      (           mecb.d):00074         
                      (           mecb.d):00075         ;----------------------------------------------------
                      (           mecb.d):00076         ;
                      (           mecb.d):00077         ; Which slot the parallel board is in.  This needs to
                      (           mecb.d):00078         ; be set for the system in use.  As long as the user
                      (           mecb.d):00079         ; programs only call functions in here, no other
                      (           mecb.d):00080         ; file/application should know which slot the board
                      (           mecb.d):00081         ; is in.
                      (           mecb.d):00082         
     E000             (           mecb.d):00083         PTMBase              equ      IOBASE+$0000
     E008             (           mecb.d):00084         UARTBase             equ      IOBASE+$0008
     E010             (           mecb.d):00085         PIA0Base             equ      IOBASE+$0010
     E0C0             (           mecb.d):00086         RTCBase              equ      IOBASE+$00C0
     E0C1             (           mecb.d):00087         IOPORTBase           equ      IOBASE+$00C1
     E0C2             (           mecb.d):00088         FNBASE               equ      IOBASE+$00C2
                      (           mecb.d):00089         
     E000             (           mecb.d):00090         PTM                  equ      PTMBase
     E000             (           mecb.d):00091         PTMCR13              equ      PTMBase         ; Timer Control Registers 1 & 3
     E001             (           mecb.d):00092         PTMSR                equ      PTMBase+1       ; Timer Status Register
     E001             (           mecb.d):00093         PTMCR2               equ      PTMBase+1       ; Timer Control Register 2
     E002             (           mecb.d):00094         PTMT1MSB             equ      PTMBase+2       ; MSB Buffer Register
     E003             (           mecb.d):00095         PTMT1LSB             equ      PTMBase+3       ; Timer #1 Latches
                      (           mecb.d):00096         
                      (           mecb.d):00097                             org       $DFC0
DFC0                  (           mecb.d):00098         C.STACK             RMB       2                   TOP OF INTERNAL STACK / USER VECTOR
DFC2                  (           mecb.d):00099         C.SWI3              RMB       2                   SOFTWARE INTERRUPT VECTOR #3
DFC4                  (           mecb.d):00100         C.SWI2              RMB       2                   SOFTWARE INTERRUPT VECTOR #2
DFC6                  (           mecb.d):00101         C.FIRQ              RMB       2                   FAST INTERRUPT VECTOR
DFC8                  (           mecb.d):00102         C.IRQ               RMB       2                   INTERRUPT VECTOR
DFCA                  (           mecb.d):00103         C.SWI               RMB       2                   SOFTWARE INTERRUPT VECTOR
DFCC                  (           mecb.d):00104         SVCVO               RMB       2                   SUPERVISOR CALL VECTOR ORGIN
DFCE                  (           mecb.d):00105         SVCVL               RMB       2                   SUPERVISOR CALL VECTOR LIMIT
DFD0                  (           mecb.d):00106         LRARAM              RMB       16                  LRA ADDRESSES
                      (           mecb.d):00107         
     E100             (           mecb.d):00108         Bt.Start            EQU       $E100               Start address of the boot ROM in memory
     1F00             (           mecb.d):00109         Bt.Size             EQU       $1F00
     0000             (           mecb.d):00110         Bt.Track            EQU       0
     0000             (           mecb.d):00111         Bt.Sec              EQU       0
                      (           mecb.d):00112         
                      (           mecb.d):00113         ; FujiNet SPI has the following bits:
                      (           mecb.d):00114         ;
                      (           mecb.d):00115         ;  Input:
                      (           mecb.d):00116         ;      Bit 7 = BUS_READY*     (MASK_CMD_READY, BIT_CMD_RDY)
                      (           mecb.d):00117         ;      Bit 6 = BUS_PROCEED*   (MASK_PROCEED, BIT_PROCEED)
                      (           mecb.d):00118         ;      Bit 1-5 = UNUSED
                      (           mecb.d):00119         ;      Bit 0 = BUS_MISO       (MASK_MISO, BIT_MISO)
                      (           mecb.d):00120         ;
     0080             (           mecb.d):00121         MASK_CMD_RDY               equ   $80
     0040             (           mecb.d):00122         MASK_PROCEED               equ   $40
     0001             (           mecb.d):00123         MASK_MISO                  equ   $01
     0007             (           mecb.d):00124         BIT_CMD_RDY                equ   7
     0006             (           mecb.d):00125         BIT_PROCEED                equ   6
     0000             (           mecb.d):00126         BIT_MISO                   equ   0
                      (           mecb.d):00127         
                      (           mecb.d):00128         ;
                      (           mecb.d):00129         ; Output:
                      (           mecb.d):00130         ;      Bit 7 = BUS_CMD*       (MASK_CMD,BIT_CMD)
                      (           mecb.d):00131         ;      Bit 6 = BUS_DATA*
                      (           mecb.d):00132         ;      Bit 3-5 = UNUSED
                      (           mecb.d):00133         ;      Bit 2 = BUS_CS*
                      (           mecb.d):00134         ;      Bit 1 = BUS_MOSI       (MASK_MOSI,BIT_MOSI)
                      (           mecb.d):00135         ;      Bit 0 = BUS_CLK
                      (           mecb.d):00136         ;
     0080             (           mecb.d):00137         MASK_CMD                   equ   $80
     0002             (           mecb.d):00138         MASK_MOSI                  equ   $02
     00FC             (           mecb.d):00139         MASK_SPI                   equ   $fc   ; Mask out all but BUS_CLK and BUS_MOSI
     00FE             (           mecb.d):00140         FN_INIT                    equ   $fe   ; BUS_CLK low, BUS_MOSI high
     0007             (           mecb.d):00141         BIT_CMD                    equ   7
     0001             (           mecb.d):00142         BIT_MOSI                   equ   1
     0000             (           mecb.d):00143         BIT_CLK                    equ   0
                      (           mecb.d):00144         
     007A             (           mecb.d):00145         MSCNT1MHZ   equ   122      ; number of loops to delay 1 mS with 1 MHz 6809 CPU
     00F7             (           mecb.d):00146         MSCNT2MHZ   equ   247      ; number of loops to delay 1 mS with 2 MHz 6809 CPU
                      (           mecb.d):00147         
                      (           mecb.d):00148         ;****************************************************
                      (           mecb.d):00149         ; FujiNet protocol
                      (           mecb.d):00150         ;
     0031             (           mecb.d):00151         RC2014_DEVICEID_DISK                equ   $31
     003F             (           mecb.d):00152         RC2014_DEVICEID_DISK_LAST           equ   $3F
                      (           mecb.d):00153         
     0041             (           mecb.d):00154         RC2014_DEVICEID_PRINTER             equ   $41
     0044             (           mecb.d):00155         RC2014_DEVICEID_PRINTER_LAST        equ   $44
                      (           mecb.d):00156         
     0061             (           mecb.d):00157         RC2014_DEVICEID_FILE                equ   $61
                      (           mecb.d):00158         
     0070             (           mecb.d):00159         RC2014_DEVICEID_FUJINET             equ   $70
     0071             (           mecb.d):00160         RC2014_DEVICEID_NETWORK             equ   $71
     0078             (           mecb.d):00161         RC2014_DEVICEID_NETWORK_LAST        equ   $78
                      (           mecb.d):00162         
     0050             (           mecb.d):00163         RC2014_DEVICEID_MODEM               equ   $50
                      (           mecb.d):00164         
     005A             (           mecb.d):00165         RC2014_DEVICEID_CPM                 equ   $5A
                      (           mecb.d):00166         ;
                      (           mecb.d):00167         ; Device commands
                      (           mecb.d):00168         ;
     004F             (           mecb.d):00169         DEVICE_OPEN                         equ   'O'
     0053             (           mecb.d):00170         DEVICE_STATUS                       equ   'S'
     0052             (           mecb.d):00171         DEVICE_READ                         equ   'R'
     0057             (           mecb.d):00172         DEVICE_WRITE                        equ   'W'
     0043             (           mecb.d):00173         DEVICE_CLOSE                        equ   'C'
     0051             (           mecb.d):00174         DEVICE_QUERY                        equ   'Q'
     0050             (           mecb.d):00175         DEVICE_PARSE                        equ   'P'
     00FD             (           mecb.d):00176         DEVICE_LOGIN                        equ   $FD
     00FC             (           mecb.d):00177         DEVICE_CHANNEL_MODE                 equ   $FC
                      (           mecb.d):00178         ;
                      (           mecb.d):00179         ;
                      (           mecb.d):00180         ; Definition of DCB offsets from common section
                      (           mecb.d):00181         ;
     0000             (           mecb.d):00182         DCB_DEVICE                          equ   0
     0001             (           mecb.d):00183         DCB_COMMAND                         equ   1
     0002             (           mecb.d):00184         DCB_AUX1                            equ   2
     0003             (           mecb.d):00185         DCB_AUX2                            equ   3
     0004             (           mecb.d):00186         DCB_CHECKSUM                        equ   4
     0004             (           mecb.d):00187         DCB_TX_BUFFER                       equ   4
     0006             (           mecb.d):00188         DCB_TX_BUFFER_LEN                   equ   6
     0008             (           mecb.d):00189         DCB_RX_BUFFER                       equ   8
     000A             (           mecb.d):00190         DCB_RX_BUFFER_LEN                   equ   10
     000C             (           mecb.d):00191         DCB_TIMEOUT                         equ   12
                      (           mecb.d):00192         
     000E             (           mecb.d):00193         DCB_SIZE                            equ   14
                      (           mecb.d):00194         
                      (           mecb.d):00195         ;
                      (           mecb.d):00196         ; FUJINET_RC
                      (           mecb.d):00197         ;
     0000             (           mecb.d):00198         FUJINET_RC_OK                       equ   0
     0001             (           mecb.d):00199         FUJINET_RC_NOT_IMPLEMENTED          equ   1
     0002             (           mecb.d):00200         FUJINET_RC_NOT_SUPPORTED            equ   2
     0003             (           mecb.d):00201         FUJINET_RC_INVALID                  equ   3
     0004             (           mecb.d):00202         FUJINET_RC_TIMEOUT                  equ   4
     0005             (           mecb.d):00203         FUJINET_RC_NO_ACK                   equ   5
     0006             (           mecb.d):00204         FUJINET_RC_NO_COMPLETE              equ   6
                      (           mecb.d):00205         ;
                      (           mecb.d):00206         ; WiFi Status Codes
                      (           mecb.d):00207         ;
     0000             (           mecb.d):00208         WIFI_IDLE                           equ   0
     0001             (           mecb.d):00209         WIFI_NOSSID                         equ   1
     0002             (           mecb.d):00210         WIFI_SCAN_COMPLETE                  equ   2
     0003             (           mecb.d):00211         WIFI_CONNECTED                      equ   3
     0004             (           mecb.d):00212         WIFI_CONNECT_FAIL                   equ   4
     0005             (           mecb.d):00213         WIFI_CONNECTION_LOST                equ   5
     0006             (           mecb.d):00214         WIFI_DISCONNECTED                   equ   6
                      (           mecb.d):00215         
                      (           mecb.d):00216         ; Network extended_error
     0001             (           mecb.d):00217         NETWORK_ERROR_SUCCESS                        equ   1     ; $01
     0083             (           mecb.d):00218         NETWORK_ERROR_WRITE_ONLY                     equ   131   ; $83
     0084             (           mecb.d):00219         NETWORK_ERROR_INVALID_COMMAND                equ   132   ; $84
     0087             (           mecb.d):00220         NETWORK_ERROR_READ_ONLY                      equ   135   ; $87
     0088             (           mecb.d):00221         NETWORK_ERROR_END_OF_FILE                    equ   136   ; $88
     008A             (           mecb.d):00222         NETWORK_ERROR_GENERAL_TIMEOUT                equ   138   ; $8a
     0090             (           mecb.d):00223         NETWORK_ERROR_GENERAL                        equ   144   ; $90
     0092             (           mecb.d):00224         NETWORK_ERROR_NOT_IMPLEMENTED                equ   146   ; $92
     0097             (           mecb.d):00225         NETWORK_ERROR_FILE_EXISTS                    equ   151   ; $97
     00A2             (           mecb.d):00226         NETWORK_ERROR_NO_SPACE_ON_DEVICE             equ   162   ; $a2
     00A5             (           mecb.d):00227         NETWORK_ERROR_INVALID_DEVICESPEC             equ   165   ; $a5
     00A7             (           mecb.d):00228         NETWORK_ERROR_ACCESS_DENIED                  equ   167   ; $a7
     00AA             (           mecb.d):00229         NETWORK_ERROR_FILE_NOT_FOUND                 equ   170   ; $aa
     00C8             (           mecb.d):00230         NETWORK_ERROR_CONNECTION_REFUSED             equ   200   ; $c8
     00C9             (           mecb.d):00231         NETWORK_ERROR_NETWORK_UNREACHABLE            equ   201   ; $c9
     00CA             (           mecb.d):00232         NETWORK_ERROR_SOCKET_TIMEOUT                 equ   202   ; $ca
     00CB             (           mecb.d):00233         NETWORK_ERROR_NETWORK_DOWN                   equ   203   ; $cb
     00CC             (           mecb.d):00234         NETWORK_ERROR_CONNECTION_RESET               equ   204   ; $cc
     00CD             (           mecb.d):00235         NETWORK_ERROR_CONNECTION_ALREADY_IN_PROGRESS equ   205   ; $cd
     00CE             (           mecb.d):00236         NETWORK_ERROR_ADDRESS_IN_USE                 equ   206   ; $ce
     00CF             (           mecb.d):00237         NETWORK_ERROR_NOT_CONNECTED                  equ   207   ; $cf
     00D0             (           mecb.d):00238         NETWORK_ERROR_SERVER_NOT_RUNNING             equ   208   ; $d0
     00D1             (           mecb.d):00239         NETWORK_ERROR_NO_CONNECTION_WAITING          equ   209   ; $d1
     00D2             (           mecb.d):00240         NETWORK_ERROR_SERVICE_NOT_AVAILABLE          equ   210   ; $d2
     00D3             (           mecb.d):00241         NETWORK_ERROR_CONNECTION_ABORTED             equ   211   ; $d3
     00D4             (           mecb.d):00242         NETWORK_ERROR_INVALID_USERNAME_OR_PASSWORD   equ   212   ; $d4
     00FF             (           mecb.d):00243         NETWORK_ERROR_COULD_NOT_ALLOCATE_BUFFERS     equ   255   ; $ff
                      (           mecb.d):00244         
