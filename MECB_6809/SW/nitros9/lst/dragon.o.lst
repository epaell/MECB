                      ( ../defs/dragon.d):00029         
     00FF             ( ../defs/dragon.d):00030         HW.Page             SET       $FF                 Device descriptor hardware page
                      ( ../defs/dragon.d):00031         
                      ( ../defs/dragon.d):00032         **********************************
                      ( ../defs/dragon.d):00033         * Power Line Frequency Definitions
                      ( ../defs/dragon.d):00034         *
     0032             ( ../defs/dragon.d):00035         Hz50                EQU       50                  Assemble clock for 50 hz power
     003C             ( ../defs/dragon.d):00036         Hz60                EQU       60                  Assemble clock for 60 hz power
                      ( ../defs/dragon.d):00037                             IFNDEF    PwrLnFrq
     003C             ( ../defs/dragon.d):00038         PwrLnFrq            SET       Hz60                Set to Appropriate freq
                      ( ../defs/dragon.d):00039                             ENDC
                      ( ../defs/dragon.d):00040         
                      ( ../defs/dragon.d):00041         
                      ( ../defs/dragon.d):00042         **********************************
                      ( ../defs/dragon.d):00043         * Ticks per second
                      ( ../defs/dragon.d):00044         *
                      ( ../defs/dragon.d):00045                             IFNDEF    TkPerSec
                      ( ../defs/dragon.d):00046                             IFEQ      PwrLnFrq-Hz50
0100                  ( ../defs/dragon.d):00047         TkPerSec            SET       50
                      ( ../defs/dragon.d):00048                             ELSE
     003C             ( ../defs/dragon.d):00049         TkPerSec            SET       60
                      ( ../defs/dragon.d):00050                             ENDC
                      ( ../defs/dragon.d):00051                             ENDC
                      ( ../defs/dragon.d):00052         
                      ( ../defs/dragon.d):00053         
