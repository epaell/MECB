                      (/defs/drivewire.d):00014         * Addresses
     FF20             (/defs/drivewire.d):00015         BBOUT               equ       $FF20
     FF22             (/defs/drivewire.d):00016         BBIN                equ       $FF22
                      (/defs/drivewire.d):00017         
                      (/defs/drivewire.d):00018          IFNE MEGAMINIMPI
0016                  (/defs/drivewire.d):00019         MPIREG      equ    $FF7F        MPI Register
0016                  (/defs/drivewire.d):00020         CTSMASK     equ    $F0          Get CTS
0016                  (/defs/drivewire.d):00021         CTSSHIFT    equ    $4           Number of shifts for CTS
0016                  (/defs/drivewire.d):00022         SCSMASK     equ    $0F          Get SCS
                      (/defs/drivewire.d):00023         
0016                  (/defs/drivewire.d):00024         MMMSLT      equ    $05          MPI Slot(SCS) for MegaMiniMPI
                      (/defs/drivewire.d):00025         
                      (/defs/drivewire.d):00026         * Uart Base Address
0016                  (/defs/drivewire.d):00027         MMMU1A      equ    $FF40        Address for UART 1
0016                  (/defs/drivewire.d):00028         MMMU2A      equ    $FF50        Address for UART 2
                      (/defs/drivewire.d):00029          IFEQ MMMUART-1
0016                  (/defs/drivewire.d):00030         MMMUARTB    equ    MMMU1A
                      (/defs/drivewire.d):00031          ENDC
                      (/defs/drivewire.d):00032          IFEQ MMMUART-2
0016                  (/defs/drivewire.d):00033         MMMUARTB    equ    MMMU2A
                      (/defs/drivewire.d):00034          ENDC
                      (/defs/drivewire.d):00035          IFNDEF MMMUARTB
                      (/defs/drivewire.d):00036          ERROR MMMUART not defined, build with -DMMMUART=1 or -DMMMUART-2
                      (/defs/drivewire.d):00037          ENDC
