                      (/defs/drivewire.d):00039         * 16550 Register offsets
0016                  (/defs/drivewire.d):00040         THR         equ    $00          Transmit Holding Register
0016                  (/defs/drivewire.d):00041         RHR         equ    $00          Recieve Holding Resister
0016                  (/defs/drivewire.d):00042         IER         equ    $01          Interrupt Enable Register
0016                  (/defs/drivewire.d):00043         IIR         equ    $02          Interrupt Identification Register
0016                  (/defs/drivewire.d):00044         FCR         equ    $02          FIFO Control Register
0016                  (/defs/drivewire.d):00045         LCR         equ    $03          Line Control Register
0016                  (/defs/drivewire.d):00046         MCR         equ    $04          Modem Control Register
0016                  (/defs/drivewire.d):00047         LSR         equ    $05          Line Status Register
0016                  (/defs/drivewire.d):00048         MSR         equ    $06          Modem Status Register
0016                  (/defs/drivewire.d):00049         SCR         equ    $07          Scratch Register
0016                  (/defs/drivewire.d):00050         RST         equ    $08          Reset
0016                  (/defs/drivewire.d):00051         DLL         equ    $00          Divisor Latch LSB
0016                  (/defs/drivewire.d):00052         DLM         equ    $01          Divisor Latch MSB
0016                  (/defs/drivewire.d):00053         DL16        equ    $0A          16-bit divisor window
                      (/defs/drivewire.d):00054         
                      (/defs/drivewire.d):00055         * 16550 Line Control Register
0016                  (/defs/drivewire.d):00056         LCR5BIT     equ    %00000000
0016                  (/defs/drivewire.d):00057         LCR6BIT     equ    %00000001
0016                  (/defs/drivewire.d):00058         LCR7BIT     equ    %00000010
0016                  (/defs/drivewire.d):00059         LCR8BIT     equ    %00000011
0016                  (/defs/drivewire.d):00060         LCRPARN     equ    %00000000
0016                  (/defs/drivewire.d):00061         LCRPARE     equ    %00000100
0016                  (/defs/drivewire.d):00062         LCRPARO     equ    %00001100
                      (/defs/drivewire.d):00063         * BREAK
0016                  (/defs/drivewire.d):00064         BRKEN       equ    %01000000
0016                  (/defs/drivewire.d):00065         BRKDIS      equ    %10111111
                      (/defs/drivewire.d):00066         * 16550 DLAB
0016                  (/defs/drivewire.d):00067         DLABEN      equ    %10000000
0016                  (/defs/drivewire.d):00068         DLABDIS     equ    %01111111
                      (/defs/drivewire.d):00069         
                      (/defs/drivewire.d):00070         * 16550 Baud Rate Definitions
0016                  (/defs/drivewire.d):00071         MMMB600        equ    3072
0016                  (/defs/drivewire.d):00072         MMMB1200       equ    1536
0016                  (/defs/drivewire.d):00073         MMMB2400       equ    768
0016                  (/defs/drivewire.d):00074         MMMB4800       equ    384
0016                  (/defs/drivewire.d):00075         MMMB9600       equ    192
0016                  (/defs/drivewire.d):00076         MMMB19200      equ    96
0016                  (/defs/drivewire.d):00077         MMMB38400      equ    48
0016                  (/defs/drivewire.d):00078         MMMB57600      equ    32
0016                  (/defs/drivewire.d):00079         MMMB115200     equ    16
0016                  (/defs/drivewire.d):00080         MMMB230400     equ    8
0016                  (/defs/drivewire.d):00081         MMMB460800     equ    4
0016                  (/defs/drivewire.d):00082         MMMB921600     equ    2
0016                  (/defs/drivewire.d):00083         MMMB1843200    equ    1
                      (/defs/drivewire.d):00084         
                      (/defs/drivewire.d):00085         * 16550 Line Status Register Defs
0016                  (/defs/drivewire.d):00086         LSRDR       equ    %00000001    LSR:Data Ready
0016                  (/defs/drivewire.d):00087         LSRTHRE     equ    %00100000    LSR:Transmit Holding Register Empty
0016                  (/defs/drivewire.d):00088         LSRTE       equ    %01000000    LSR:Transmit Empty
                      (/defs/drivewire.d):00089         
                      (/defs/drivewire.d):00090         * 16550 Fifo Control Register
0016                  (/defs/drivewire.d):00091         FCRFEN     equ    %00000001    Enable RX and TX FIFOs
0016                  (/defs/drivewire.d):00092         FCRFDIS    equ    %11111110    Disable RX and TX FIFOs
0016                  (/defs/drivewire.d):00093         FCRRXFCLR  equ    %00000010    Clear RX FIFO
0016                  (/defs/drivewire.d):00094         FCRTXFCLR  equ    %00000100    Clear TX FIFO
0016                  (/defs/drivewire.d):00095         FCRTRG1B   equ    %00000000    1-Byte FIFO Trigger
0016                  (/defs/drivewire.d):00096         FCRTRG4B   equ    %01000000    4-Byte FIFO Trigger
0016                  (/defs/drivewire.d):00097         FCRTRG8B   equ    %10000000    8-Byte FIFO Trigger
0016                  (/defs/drivewire.d):00098         FCRTRG14B  equ    %11000000    14-Byte FIFO Trigger
                      (/defs/drivewire.d):00099         
                      (/defs/drivewire.d):00100         * 16550 Modem Control Register
0016                  (/defs/drivewire.d):00101         MCRDTREN   equ    %00000001    Enable DTR Output
0016                  (/defs/drivewire.d):00102         MCRDTRDIS  equ    %11111110    Disable DTR Output
0016                  (/defs/drivewire.d):00103         MCRRTSEN   equ    %00000010    Enable RTS Output
0016                  (/defs/drivewire.d):00104         MCRRTSDIS  equ    %11111101    Disable RTS Output
0016                  (/defs/drivewire.d):00105         MCRAFEEN   equ    %00100000    Enable Auto Flow Control
0016                  (/defs/drivewire.d):00106         MCRAFEDIS  equ    %11011111    Disable Auto Flow Control
                      (/defs/drivewire.d):00107          ENDC
