     0001             (   ../defs/pipe.d):00003         PIPE.D              SET       1
                      (   ../defs/pipe.d):00004         
                      (   ../defs/pipe.d):00005         ********************************************************************
                      (   ../defs/pipe.d):00006         * PipeDefs - Pipe File Manager Definitions
                      (   ../defs/pipe.d):00007         *
                      (   ../defs/pipe.d):00008         * Edt/Rev  YYYY/MM/DD  Modified by
                      (   ../defs/pipe.d):00009         * Comment
                      (   ../defs/pipe.d):00010         * ------------------------------------------------------------------
                      (   ../defs/pipe.d):00011         *          1988/12/03  Chris J. Burke
                      (   ../defs/pipe.d):00012         * Coded from new PIPEMAN comments.
                      (   ../defs/pipe.d):00013         
                      (   ../defs/pipe.d):00014                             NAM       PipeDefs
                      (   ../defs/pipe.d):00015                             TTL       Pipe                File Manager Definitions
                      (   ../defs/pipe.d):00016         
                      (   ../defs/pipe.d):00017         *
                      (   ../defs/pipe.d):00018         *   IOMan equates duplicated for PipeMan use
                      (   ../defs/pipe.d):00019         *
                      (   ../defs/pipe.d):00020         
     0010             (   ../defs/pipe.d):00021         NPATHS              SET       16                  ;Maximum local paths per task -- must match IOMan
     001D             (   ../defs/pipe.d):00022         NameMax             SET       29                  ;Maximum length of a file name
                      (   ../defs/pipe.d):00023         
                      (   ../defs/pipe.d):00024         *
                      (   ../defs/pipe.d):00025         *   Device Driver Static Storage Layout
                      (   ../defs/pipe.d):00026         *
                      (   ../defs/pipe.d):00027                             ORG       V.User
FFFF                  (   ../defs/pipe.d):00028         V.List              RMB       2                   ;Pointer to 1st pipe's pipe buffer
     ????             (   ../defs/pipe.d):00029         PManMem             EQU       .                   ;Device driver memory (drive table equivalent)
                      (   ../defs/pipe.d):00030         
                      (   ../defs/pipe.d):00031         *
                      (   ../defs/pipe.d):00032         *   Pipe Buffer Data Structure
                      (   ../defs/pipe.d):00033         *
                      (   ../defs/pipe.d):00034                             ORG       0
0000                  (   ../defs/pipe.d):00035         PP.PD               RMB       2                   ;Pointer to shared path descriptor
0002                  (   ../defs/pipe.d):00036         PP.Next             RMB       2                   ;Pointer to next pipe buffer in system map
0004                  (   ../defs/pipe.d):00037         PP.Prev             RMB       2                   ;Pointer to previous pipe buffer in system map
0006                  (   ../defs/pipe.d):00038         PP.Rsrv             RMB       2                   ;Reserved
     0008             (   ../defs/pipe.d):00039         PP.Data             EQU       .                   ;Data buffer begins at this offset
                      (   ../defs/pipe.d):00040         
                      (   ../defs/pipe.d):00041         *
                      (   ../defs/pipe.d):00042         *   Unique Path Descriptor Variables
                      (   ../defs/pipe.d):00043         *
                      (   ../defs/pipe.d):00044                             ORG       PD.FST
                      (   ../defs/pipe.d):00045         *** PP.Read must have bit 4 clear; PP.Writ must be PP.Read XOR 4
     000A             (   ../defs/pipe.d):00046         PD.Read             EQU       .
000A                  (   ../defs/pipe.d):00047         PD.RPID             RMB       1                   ;Process ID of reader waiting on signal
000B                  (   ../defs/pipe.d):00048         PD.RCT              RMB       1                   ;Number of blocked readers
000C                  (   ../defs/pipe.d):00049         PD.RSIG             RMB       1                   ;Signal to send reader
000D                  (   ../defs/pipe.d):00050         PD.REOR             RMB       1                   ;Read EOR character
     000E             (   ../defs/pipe.d):00051         PD.Writ             EQU       .
000E                  (   ../defs/pipe.d):00052         PD.WPID             RMB       1                   ;Process ID of writer waiting on signal
000F                  (   ../defs/pipe.d):00053         PD.WCT              RMB       1                   ;Number of blocked writers
0010                  (   ../defs/pipe.d):00054         PD.WSIG             RMB       1                   ;Signal to send writer
0011                  (   ../defs/pipe.d):00055         PD.WEOR             RMB       1                   ;Write EOR character (dummy)
                      (   ../defs/pipe.d):00056         *** End of special section
0012                  (   ../defs/pipe.d):00057         PD.End              RMB       2                   ;Pointer to end of pipe buffer
0014                  (   ../defs/pipe.d):00058         PD.NxtI             RMB       2                   ;Next in pointer
0016                  (   ../defs/pipe.d):00059         PD.NxtO             RMB       2                   ;Next out pointer
0018                  (   ../defs/pipe.d):00060         PD.RFlg             RMB       1                   ;"Ready" flag
0019                  (   ../defs/pipe.d):00061         PD.Wrtn             RMB       1                   ;"Written" flag
001A                  (   ../defs/pipe.d):00062         PD.BCnt             RMB       2                   ;# queue elements currently bufered
001C                  (   ../defs/pipe.d):00063         PD.Own              RMB       1                   ;Process ID of pipe original creator
001D                  (   ../defs/pipe.d):00064         PD.Keep             RMB       1                   ;Non-zero if pipe has been kept open artificailly
001E                  (   ../defs/pipe.d):00065         PD.QSiz             RMB       2                   ;Max. elements in queue (copied from OPT section)
                      (   ../defs/pipe.d):00066         
                      (   ../defs/pipe.d):00067         *
                      (   ../defs/pipe.d):00068         *   Path descriptor option section
                      (   ../defs/pipe.d):00069         *
                      (   ../defs/pipe.d):00070         *   Note that PD.Name overlaps with the last byte of PD.ECnt.
                      (   ../defs/pipe.d):00071         *   PD.ECnt is copied to PD.QSiz as part of OPEN or CREATE,
                      (   ../defs/pipe.d):00072         *   to make room for the pipe name.
                      (   ../defs/pipe.d):00073         *
                      (   ../defs/pipe.d):00074                             ORG       (PD.OPT+1)
0021                  (   ../defs/pipe.d):00075         PD.ESiz             RMB       1                   ;Size of each queue element
0022                  (   ../defs/pipe.d):00076         PD.ECnt             RMB       2                   ;Max. elements in queue (initial position)
                      (   ../defs/pipe.d):00077                             IFGT      Level-1
                      (   ../defs/pipe.d):00078                             ORG       (PD.OPT+3)
0024                  (   ../defs/pipe.d):00079         PD.Name             RMB       NameMax
                      (   ../defs/pipe.d):00080                             ENDC
                      (   ../defs/pipe.d):00081         
                      (   ../defs/pipe.d):00082         *
                      (   ../defs/pipe.d):00083         *   Device Descriptor definitions
                      (   ../defs/pipe.d):00084         *
     0012             (   ../defs/pipe.d):00085         IT.PDC              EQU       $12                 ;Pipe device class (like IT.DTP, IT.DVC)
                      (   ../defs/pipe.d):00086                             ORG       IT.PDC
0012                  (   ../defs/pipe.d):00087                             RMB       1                   ;Leave room for device class
0013                  (   ../defs/pipe.d):00088         IT.ESiz             RMB       1                   ;Size of each queue element
0014                  (   ../defs/pipe.d):00089         IT.ECnt             RMB       2                   ;Max. elements in queue (initial position)
                      (   ../defs/pipe.d):00090         
                      (   ../defs/pipe.d):00091         *   End of pipe.d
                      (   ../defs/pipe.d):00092         
                      (   ../defs/pipe.d):00093                             ENDC
