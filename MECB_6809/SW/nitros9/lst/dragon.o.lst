00FA                  (./defs/cocovtio.d):00782         gr0072              RMB       2                   Screen address of pixel we are doing
00FA                  (./defs/cocovtio.d):00783         gr0074              RMB       1                   Pixel mask for pixel we are doing
00FA                  (./defs/cocovtio.d):00784         gr0075              RMB       2                   Error term used in LINE
00FA                  (./defs/cocovtio.d):00785         gr0077              RMB       2                   Vector for right direction FFill
00FA                  (./defs/cocovtio.d):00786         gr0079              RMB       1                   bit mask for 1st pixel in byte for right dir. FFill
00FA                  (./defs/cocovtio.d):00787         gr007A              RMB       2                   Vector for left direction FFill
00FA                  (./defs/cocovtio.d):00788         gr007C              RMB       1                   bit mask for last pixel in byte for left dir. FFill
00FA                  (./defs/cocovtio.d):00789         gr007D              RMB       1                   buffer block #
00FA                  (./defs/cocovtio.d):00790         gr007E              RMB       2                   buffer offset #
00FA                  (./defs/cocovtio.d):00791         gr0080              RMB       2                   Buffer length (in bytes)
00FA                  (./defs/cocovtio.d):00792         gr0082              RMB       3                   3 byte extended screen address
00FA                  (./defs/cocovtio.d):00793         gr0085              RMB       2                   temp
00FA                  (./defs/cocovtio.d):00794         gr0087              RMB       16                  grfdrv (sysmap 1) DAT image
00FA                  (./defs/cocovtio.d):00795         gr0097              RMB       1                   temp
00FA                  (./defs/cocovtio.d):00796         gr0098              RMB       1                   temp
                      (./defs/cocovtio.d):00797         * In ARC, 97-98 is the width of the clip line in pixels (after scaling)
00FA                  (./defs/cocovtio.d):00798         gr0099              RMB       2                   temp
                      (./defs/cocovtio.d):00799         * In ARC, 99-9A is the height of the clip line in pixels (after scaling)
00FA                  (./defs/cocovtio.d):00800         gr009B              RMB       1                   MSB of temp
00FA                  (./defs/cocovtio.d):00801         gr009C              RMB       1                   LSB of temp
00FA                  (./defs/cocovtio.d):00802         gr009D              RMB       2                   offset to buffer in block
00FA                  (./defs/cocovtio.d):00803         gr009F              RMB       1                   # of MMU blocks used for GP buffer
00FA                  (./defs/cocovtio.d):00804         gr00A0              RMB       1                   # lines left to do of GP buffer onto screen
00FA                  (./defs/cocovtio.d):00805         gr00A1              RMB       2                   vector routine for (changes lots)
                      (./defs/cocovtio.d):00806         * In ARC A1-A2 is the vector to the proper clipping routine
00FA                  (./defs/cocovtio.d):00807         gr00A3              RMB       2                   Vector for shifting GP buffers
00FA                  (./defs/cocovtio.d):00808         gr00A5              RMB       2                   Vector for shifting GP buffers (can dupe A1)
00FA                  (./defs/cocovtio.d):00809         gr00A7              RMB       2                   Stack overflow counter in FFill (was UNUSED)
00FA                  (./defs/cocovtio.d):00810         gr00A9              RMB       2                   NEW: Window tbl ptr for last window GRFDRV used
00FA                  (./defs/cocovtio.d):00811         grBigFnt            RMB       2                   Flag for 224 char font/gfx mode on (0=No) V2.00a
00FA                  (./defs/cocovtio.d):00812         gr00AD              RMB       2                   FFill:orig. start left X coord|Circ/Ell saved start X
00FA                  (./defs/cocovtio.d):00813         gr00AF              RMB       2                   FFill:orig. start Y coord|Circ/Ell saved end X
00FA                  (./defs/cocovtio.d):00814         gr00B1              RMB       1                   Flag in FFill: 1=1st time through, 0=not 1st time
00FA                  (./defs/cocovtio.d):00815         gr00B2              RMB       1                   Filled (circle,ellipse) flag 0=Not filled
00FA                  (./defs/cocovtio.d):00816         gr00B3              RMB       1                   temp variable grfdrv
00FA                  (./defs/cocovtio.d):00817         gr00B4              RMB       1                   temp variable grfdrv
00FA                  (./defs/cocovtio.d):00818         gr00B5              RMB       1                   regE for grfdrv/6809
00FA                  (./defs/cocovtio.d):00819         gr00B6              RMB       1                   regF for grfdrv/6809
00FA                  (./defs/cocovtio.d):00820         gr00B7              RMB       2                   UNUSED
00FA                  (./defs/cocovtio.d):00821         gr00B9              RMB       2                   previously used in grfdrv at $B2 but not for Filled Flag
00FA                  (./defs/cocovtio.d):00822         gr00BB              RMB       2                   previously used in grfdrv at $B4
00FA                  (./defs/cocovtio.d):00823         gr00BD              RMB       2                   previously used in grfdrv at $B6
                      (./defs/cocovtio.d):00824         * EOU Beta 2 & up
00FA                  (./defs/cocovtio.d):00825         grScrtch            RMB       2                   Scratch var for Grfdrv - use DP instead of stack for
                      (./defs/cocovtio.d):00826         *                                            anything that does immediate calculations
                      (./defs/cocovtio.d):00827         * EOU Beta 6 & up
00FA                  (./defs/cocovtio.d):00828         grResv01            RMB       1                   1 byte reserved for future use
00FA                  (./defs/cocovtio.d):00829         grOrgLtX            RMB       2                   Fill: orig. left X coord
00FA                  (./defs/cocovtio.d):00830         grOrgRtX            RMB       2                   Fill: orig. right X coord
00FA                  (./defs/cocovtio.d):00831         grCrPMsk            RMB       1                   Used in font routine - Current pixel mask
00FA                  (./defs/cocovtio.d):00832         grDbCMsk            RMB       2                   Used for word size color mask for Logic routines
00FA                  (./defs/cocovtio.d):00833         grRsrved            RMB       256-.               Reserved for future use
                      (./defs/cocovtio.d):00834         
                      (./defs/cocovtio.d):00835         * GPLoad buffer - $1200 in system block    . Currently ends at $1247, and $1248-$127f is unused
00FA                  (./defs/cocovtio.d):00836         GPBuf               EQU       $1200               Useful address (start of GP buffer copy memory)
00FA                  (./defs/cocovtio.d):00837         GPBufSz             RMB       gb0000              common move buffer for gpload/get/put (72 bytes default)
                      (./defs/cocovtio.d):00838         
                      (./defs/cocovtio.d):00839         *****************************************************************************
                      (./defs/cocovtio.d):00840         * Window table entry structure
                      (./defs/cocovtio.d):00841         * These tables sit in system block 0 and there is 1 for every window init'd
                      (./defs/cocovtio.d):00842         * including any overlay windows.
00FA                  (./defs/cocovtio.d):00843         MaxWind             EQU       32                  maximum allowable window tables
00FA                  (./defs/cocovtio.d):00844         WinBase             EQU       $1290               base address to start of window tables
                      (./defs/cocovtio.d):00845                             ORG       -$10
00FA                  (./defs/cocovtio.d):00846         Wt.STbl             RMB       2                   Screen table pointer ($FFFF=Not used)       -$10
00FA                  (./defs/cocovtio.d):00847         Wt.BLnk             RMB       1                   overlay window parent entry # ($FF=base)    -$0E
00FA                  (./defs/cocovtio.d):00848         Wt.LStrt            RMB       2                   screen logical start address                -$0D
00FA                  (./defs/cocovtio.d):00849         Wt.CPX              RMB       1                   current X coord. start                      -$0B
00FA                  (./defs/cocovtio.d):00850         Wt.CPY              RMB       1                   current Y coord. start                      -$0A
00FA                  (./defs/cocovtio.d):00851         Wt.SZX              RMB       1                   current X size (CWArea)                     -$09
00FA                  (./defs/cocovtio.d):00852         Wt.SZY              RMB       1                   current Y size (CWArea)                     -$08
00FA                  (./defs/cocovtio.d):00853         Wt.SXFct            RMB       1                   X scaling factor                            -$07
00FA                  (./defs/cocovtio.d):00854         Wt.SYFct            RMB       1                   Y scaling factor (0=no scaling)             -$06
00FA                  (./defs/cocovtio.d):00855         Wt.Cur              RMB       2                   cursor physical address on screen           -$05
00FA                  (./defs/cocovtio.d):00856         Wt.FMsk             RMB       1                   font bit mask (based from left)             -$03
00FA                  (./defs/cocovtio.d):00857         Wt.CurX             RMB       2                   X coord of cursor                           -$02
00FA                  (./defs/cocovtio.d):00858         Wt.CurY             RMB       2                   Y Coord of cursor                            $00
00FA                  (./defs/cocovtio.d):00859         Wt.XBCnt            RMB       1                   width of window (in bytes)                   $02
00FA                  (./defs/cocovtio.d):00860         Wt.CWTmp            RMB       1                   bytes wide each text chr (1,2,4)             $03
00FA                  (./defs/cocovtio.d):00861         Wt.BRow             RMB       2                   bytes/text row (8x width in gfx)             $04
00FA                  (./defs/cocovtio.d):00862         Wt.Fore             RMB       1                   foreground palette #                         $06
00FA                  (./defs/cocovtio.d):00863         Wt.Back             RMB       1                   background palette #                         $07
00FA                  (./defs/cocovtio.d):00864         Wt.Attr             RMB       1                   default attributes (FUTTTBBB)                $08
00FA                  (./defs/cocovtio.d):00865         Wt.BSW              RMB       1                   character BSW switches                       $09
00FA                  (./defs/cocovtio.d):00866         Wt.LSet             RMB       1                   LSet type                                    $0A
00FA                  (./defs/cocovtio.d):00867         Wt.FBlk             RMB       1                   Font memory block #                          $0B
00FA                  (./defs/cocovtio.d):00868         Wt.FOff             RMB       2                   Font offset in block                         $0C
00FA                  (./defs/cocovtio.d):00869         Wt.PBlk             RMB       1                   PSet memory block #                          $0E
00FA                  (./defs/cocovtio.d):00870         Wt.POff             RMB       2                   PSet offset in block                         $0F
00FA                  (./defs/cocovtio.d):00871         Wt.OBlk             RMB       1                   Overlay memory block #                       $11
00FA                  (./defs/cocovtio.d):00872         Wt.OOff             RMB       2                   Overlay offset in block                      $12
00FA                  (./defs/cocovtio.d):00873         Wt.LVec             RMB       2                   LSet vector                                  $14
00FA                  (./defs/cocovtio.d):00874         Wt.PVec             RMB       2                   PSet vector                                  $16
00FA                  (./defs/cocovtio.d):00875         Wt.GBlk             RMB       1                   GCursor memory block #                       $18
00FA                  (./defs/cocovtio.d):00876         Wt.GOff             RMB       2                   GCursor offset in block                      $19
00FA                  (./defs/cocovtio.d):00877         Wt.MaxX             RMB       2                   Maximum X cord. (0-79,0-639)                 $1B
00FA                  (./defs/cocovtio.d):00878         Wt.MaxY             RMB       2                   Maximum Y cord. (0-24/25,0-191/199)          $1D
00FA                  (./defs/cocovtio.d):00879         Wt.BLen             RMB       2                   bytes left in GPLoad block below             $1F
00FA                  (./defs/cocovtio.d):00880         Wt.NBlk             RMB       1                   memory block # for next GPLoad               $21
00FA                  (./defs/cocovtio.d):00881         Wt.NOff             RMB       2                   Offset in block for next GPLoad              $22
00FA                  (./defs/cocovtio.d):00882         Wt.LStDf            RMB       2                   screen logical start default                 $24
                      (./defs/cocovtio.d):00883         * NOTE: The following default settings are what the window was initialized
                      (./defs/cocovtio.d):00884         *       with, and thus are the MAXIMUM start/size the window can handle
                      (./defs/cocovtio.d):00885         *       until it is restarted (DWEnd & DWSet)
                      (./defs/cocovtio.d):00886         *       They also appear to be used in WindInt to determine the coords &
                      (./defs/cocovtio.d):00887         *       sizes for control+content regions
00FA                  (./defs/cocovtio.d):00888         Wt.DfCPX            RMB       1                   default X cord. start                        $26
00FA                  (./defs/cocovtio.d):00889         Wt.DfCPY            RMB       1                   default Y cord. start                        $27
00FA                  (./defs/cocovtio.d):00890         Wt.DfSZX            RMB       1                   default X size                               $28
00FA                  (./defs/cocovtio.d):00891         Wt.DfSZY            RMB       1                   default Y size                               $29
00FA                  (./defs/cocovtio.d):00892         Wt.Res              RMB       6                   unused                                   $2A-$2F
00FA                  (./defs/cocovtio.d):00893         Wt.Siz              EQU       .+$10
                      (./defs/cocovtio.d):00894         
                      (./defs/cocovtio.d):00895         *****************************************************************************
                      (./defs/cocovtio.d):00896         * Screen table entrys
                      (./defs/cocovtio.d):00897         * These tables sit in system block 0 base=$1A80
                      (./defs/cocovtio.d):00898         
00FA                  (./defs/cocovtio.d):00899         STblMax             EQU       16                  Maximum number of screen tables
00FA                  (./defs/cocovtio.d):00900         STblBse             EQU       $1A80               base address of screen tables
                      (./defs/cocovtio.d):00901                             ORG       0
00FA                  (./defs/cocovtio.d):00902         St.Sty              RMB       1                   Screen type                         $00
00FA                  (./defs/cocovtio.d):00903         St.SBlk             RMB       1                   Ram block start #                   $01
00FA                  (./defs/cocovtio.d):00904         St.LStrt            RMB       2                   Screen logical start (for GIME)     $02
00FA                  (./defs/cocovtio.d):00905         St.BRow             RMB       1                   Bytes per row                       $04
00FA                  (./defs/cocovtio.d):00906         St.Brdr             RMB       1                   Border palette register #           $05
00FA                  (./defs/cocovtio.d):00907         St.Fore             RMB       1                   Foreground palette register #       $06
00FA                  (./defs/cocovtio.d):00908         St.Back             RMB       1                   Background palette register #       $07
00FA                  (./defs/cocovtio.d):00909         St.ScSiz            RMB       1                   screen size: 24..28 lines           $08
00FA                  (./defs/cocovtio.d):00910         St.Res              RMB       7                   UNUSED???                           $09
                      (./defs/cocovtio.d):00911         * NOTE: SHOULD USE ONE OF THESE UNUSED BYTES TO KEEP THE # OF DEVICE WINDOW
                      (./defs/cocovtio.d):00912         * TABLES THAT ARE USING THIS SCREEN TABLE. DWSET & DWEND WOULD KEEP TRACK OF
                      (./defs/cocovtio.d):00913         * THESE, AND THE WINDINT TITLE BAR ROUTINE WOULD CHECK IT. IF IT IS ONLY 1,
                      (./defs/cocovtio.d):00914         * IT WON'T BOTHER CHANGING THE TITLE BAR WHEN SELECTING WINDOWS
                      (./defs/cocovtio.d):00915         * Other possibilities: Offset into screen to display (if we enable screens taller than
                      (./defs/cocovtio.d):00916         *   a single screen), etc.
00FA                  (./defs/cocovtio.d):00917         St.Pals             RMB       16                  Palette register contents           $10
00FA                  (./defs/cocovtio.d):00918         St.Siz              EQU       .
                      (./defs/cocovtio.d):00919         
                      (./defs/cocovtio.d):00920         *****************************************************************************
                      (./defs/cocovtio.d):00921         * Graphics buffer tables
                      (./defs/cocovtio.d):00922         * They contain a 20 byte header (shown below), followed by the raw pixel
                      (./defs/cocovtio.d):00923         * data.
                      (./defs/cocovtio.d):00924                             ORG       0
00FA                  (./defs/cocovtio.d):00925         Grf.Bck             RMB       1                   back block link #                   $00
00FA                  (./defs/cocovtio.d):00926         Grf.Off             RMB       2                   back block header offset            $01
00FA                  (./defs/cocovtio.d):00927         Grf.Grp             RMB       1                   group #                             $03
00FA                  (./defs/cocovtio.d):00928         Grf.Buff            RMB       1                   buffer #                            $04
00FA                  (./defs/cocovtio.d):00929         Grf.BSz             RMB       2                   buffer size (not including header)  $05
00FA                  (./defs/cocovtio.d):00930         Grf.XSz             RMB       2                   X size (in pixels)                  $07
00FA                  (./defs/cocovtio.d):00931         Grf.YSz             RMB       2                   Y size (in pixels/bytes)            $09
00FA                  (./defs/cocovtio.d):00932         Grf.XBSz            RMB       1                   X size in bytes                     $0B
00FA                  (./defs/cocovtio.d):00933         Grf.LfPx            RMB       1                   # pixels used in first byte of line $0C
00FA                  (./defs/cocovtio.d):00934         Grf.RtPx            RMB       1                   # pixels used in last byte of line  $0D
00FA                  (./defs/cocovtio.d):00935         Grf.STY             RMB       1                   Screen type buffer intended for     $0E
00FA                  (./defs/cocovtio.d):00936         Grf.NBlk            RMB       1                   number blocks used                  $0F
00FA                  (./defs/cocovtio.d):00937         Grf.Pal             RMB       16                  THIS IS NOT PALETTE REGISTERS.      $10
                      (./defs/cocovtio.d):00938         * Grf.Pal seems to be "reserved for future use", and we can use for the 8 char font names
                      (./defs/cocovtio.d):00939         * that the level 2 upgrade used, with 8 reserved for future use? Could it be used for other
                      (./defs/cocovtio.d):00940         * purposes with general get/put buffers as well, like block link #/offset to background masks
                      (./defs/cocovtio.d):00941         * etc for sprites?
00FA                  (./defs/cocovtio.d):00942         Grf.Siz             EQU       .                   $20
                      (./defs/cocovtio.d):00943         
                      (./defs/cocovtio.d):00944         *****************************************************************************
                      (./defs/cocovtio.d):00945         * GFX tables (1 for each window, 18 ($12) bytes each) pointed to by
                      (./defs/cocovtio.d):00946         * $1075-$0176
                      (./defs/cocovtio.d):00947         * GRFINT only uses gt0001-gt0004, the rest is exclusive to WINDINT
                      (./defs/cocovtio.d):00948                             ORG       0
00FA                  (./defs/cocovtio.d):00949         Gt.WTyp             RMB       1                   WindInt window type (Framed, Scroll Bar, etc.) $00
00FA                  (./defs/cocovtio.d):00950         Gt.GXCur            RMB       2                   X coord of graphics cursor                     $01
00FA                  (./defs/cocovtio.d):00951         Gt.GYCur            RMB       2                   Y coord of graphics cursor                     $03
00FA                  (./defs/cocovtio.d):00952         Gt.DPtr             RMB       2                   Ptr to WindInt window descriptor               $05
00FA                  (./defs/cocovtio.d):00953         Gt.FClr             RMB       1                   Foreground color                               $07
00FA                  (./defs/cocovtio.d):00954         Gt.BClr             RMB       1                   Background color                               $08
00FA                  (./defs/cocovtio.d):00955         Gt.FMsk             RMB       1                   Foreground mask                                $09
00FA                  (./defs/cocovtio.d):00956         Gt.BMsk             RMB       1                   Background mask                                $0A
00FA                  (./defs/cocovtio.d):00957         Gt.GBlk             RMB       1                   Block # of graphics cursor                     $0B
00FA                  (./defs/cocovtio.d):00958         Gt.GOff             RMB       2                   Offset into block of graphics cursor           $0C
00FA                  (./defs/cocovtio.d):00959         Gt.Proc             RMB       1                   Process # of window creator                    $0E
00FA                  (./defs/cocovtio.d):00960         Gt.PBlk             RMB       1                   Process descriptor block # of creator          $0F
00FA                  (./defs/cocovtio.d):00961         Gt.Res              RMB       2                   ??? RESERVED ???                               $10
00FA                  (./defs/cocovtio.d):00962         GTabSz              EQU       .
                      (./defs/cocovtio.d):00963         
                      (./defs/cocovtio.d):00964         *****************************************************************************
                      (./defs/cocovtio.d):00965         * This table is located in the graphics table memory and is offset from
                      (./defs/cocovtio.d):00966         * graphics table pointer stored at $1075-$1076. This is used exclusively by
                      (./defs/cocovtio.d):00967         * WindInt.
                      (./defs/cocovtio.d):00968         * NOTE: USING UNUSED BYTES IN CC3 GLOBAL MEM, SET UP SEPARATE PTRS FOR EACH
                      (./defs/cocovtio.d):00969         *  OF THE BELOW SO WE CAN SPEED UP ACCESS BY NOT HAVING TO DO A LOAD/LEAx
                      (./defs/cocovtio.d):00970         *  COMBINATION EVERY TIME
                      (./defs/cocovtio.d):00971                             ORG       $0240
                      (./defs/cocovtio.d):00972                             RMB       WN.SIZ              (+$240) copy of last accessed window descriptor
                      (./defs/cocovtio.d):00973                             RMB       MN.SIZ              (+$262) copy of last accessed menu descriptor
                      (./defs/cocovtio.d):00974                             RMB       MI.SIZ              (+$279) copy of last accessed item descriptor
                      (./defs/cocovtio.d):00975                             RMB       65                  (+$28E) menu handling table (16 entrys of 4 bytes)
                      (./defs/cocovtio.d):00976         
                      (./defs/cocovtio.d):00977         *****************************************************************************
                      (./defs/cocovtio.d):00978         * WindInt menu handling table entry definition
                      (./defs/cocovtio.d):00979                             ORG       0
00FA                  (./defs/cocovtio.d):00980         MnuXNum             RMB       1                   menu #
00FA                  (./defs/cocovtio.d):00981         MnuXStrt            RMB       1                   X start text co-ordinate
00FA                  (./defs/cocovtio.d):00982         MnuXEnd             RMB       1                   X end text co-ordinate
                      (./defs/cocovtio.d):00983                             RMB       1                   unused?
00FA                  (./defs/cocovtio.d):00984         MnuHSiz             EQU       .
                      (./defs/cocovtio.d):00985         
                      (./defs/cocovtio.d):00986         *****************************************************************************
                      (./defs/cocovtio.d):00987         * Character binary switches
00FA                  (./defs/cocovtio.d):00988         Blink               EQU       %10000000           Blink characters (hardware text only)
00FA                  (./defs/cocovtio.d):00989         TChr                EQU       %10000000           transparent characters (both currently)
00FA                  (./defs/cocovtio.d):00990         Under               EQU       %01000000           underline characters (both)
00FA                  (./defs/cocovtio.d):00991         Bold                EQU       %00100000           bold characters (gfx only, maybe txt with color changes?)
00FA                  (./defs/cocovtio.d):00992         Prop                EQU       %00010000           proportional spacing of characters (gfx only)
00FA                  (./defs/cocovtio.d):00993         Scale               EQU       %00001000           automatic window scaling (gfx only)
00FA                  (./defs/cocovtio.d):00994         Invers              EQU       %00000100           inverse characters (both)
00FA                  (./defs/cocovtio.d):00995         NoCurs              EQU       %00000010           no cursor display (both)
00FA                  (./defs/cocovtio.d):00996         Protect             EQU       %00000001           device window protection (both)
                      (./defs/cocovtio.d):00997         
                      (./defs/cocovtio.d):00998         *****************************************************************************
                      (./defs/cocovtio.d):00999         * Screen types (high bit set=hardware text, else graphics) in GRFDRV
00FA                  (./defs/cocovtio.d):01000         Current             EQU       $ff                 Current screen
                      (./defs/cocovtio.d):01001         *         equ   1          640x200x2
                      (./defs/cocovtio.d):01002         *         equ   2          320x200x4
                      (./defs/cocovtio.d):01003         *         equ   3          640x200x4
                      (./defs/cocovtio.d):01004         *         equ   4          320x200x16
                      (./defs/cocovtio.d):01005         *         equ   $85        80 column text
                      (./defs/cocovtio.d):01006         *         equ   $86        40 column text
                      (./defs/cocovtio.d):01007         
                      (./defs/cocovtio.d):01008         *************************************
                      (./defs/cocovtio.d):01009         * Window default palette color codes
                      (./defs/cocovtio.d):01010         *
                      (./defs/cocovtio.d):01011                             ORG       0
00FA                  (./defs/cocovtio.d):01012         White.              RMB       1
