                      (    ../defs/scf.d):00046         * SCF Device Descriptor Offsets
                      (    ../defs/scf.d):00047         *
                      (    ../defs/scf.d):00048         * These definitions are for SCF device descriptors.
                      (    ../defs/scf.d):00049         
                      (    ../defs/scf.d):00050                             ORG       M$DTyp
0012                  (    ../defs/scf.d):00051         IT.DVC              RMB       1                   Device type (DT.SCF)
0013                  (    ../defs/scf.d):00052         IT.UPC              RMB       1                   Uppercase flag
0014                  (    ../defs/scf.d):00053         IT.BSO              RMB       1                   Backspace behavior
0015                  (    ../defs/scf.d):00054         IT.DLO              RMB       1                   Delete behavior
0016                  (    ../defs/scf.d):00055         IT.EKO              RMB       1                   Echo flag
0017                  (    ../defs/scf.d):00056         IT.ALF              RMB       1                   Auto linefeed flag
0018                  (    ../defs/scf.d):00057         IT.NUL              RMB       1                   End-of-line null count
0019                  (    ../defs/scf.d):00058         IT.PAU              RMB       1                   Page pause flag
001A                  (    ../defs/scf.d):00059         IT.PAG              RMB       1                   Number of lines per page
001B                  (    ../defs/scf.d):00060         IT.BSP              RMB       1                   Backspace character
001C                  (    ../defs/scf.d):00061         IT.DEL              RMB       1                   Delete-line character
001D                  (    ../defs/scf.d):00062         IT.EOR              RMB       1                   End-of-record character
001E                  (    ../defs/scf.d):00063         IT.EOF              RMB       1                   End-of-file character
001F                  (    ../defs/scf.d):00064         IT.RPR              RMB       1                   Reprint-line character
0020                  (    ../defs/scf.d):00065         IT.DUP              RMB       1                   Duplicate-last-line character
0021                  (    ../defs/scf.d):00066         IT.PSC              RMB       1                   Pause character
0022                  (    ../defs/scf.d):00067         IT.INT              RMB       1                   Interrupt character
0023                  (    ../defs/scf.d):00068         IT.QUT              RMB       1                   Quit character
0024                  (    ../defs/scf.d):00069         IT.BSE              RMB       1                   Backspace echo character
0025                  (    ../defs/scf.d):00070         IT.OVF              RMB       1                   Bell character
0026                  (    ../defs/scf.d):00071         IT.PAR              RMB       1                   Parity
0027                  (    ../defs/scf.d):00072         IT.BAU              RMB       1                   Baud rate
0028                  (    ../defs/scf.d):00073         IT.D2P              RMB       2                   Attached device name string offset
002A                  (    ../defs/scf.d):00074         IT.XON              RMB       1                   X-ON character
002B                  (    ../defs/scf.d):00075         IT.XOFF             RMB       1                   X-OFF character
002C                  (    ../defs/scf.d):00076         IT.COL              RMB       1                   Number of columns for display
002D                  (    ../defs/scf.d):00077         IT.ROW              RMB       1                   Number of rows for display
002E                  (    ../defs/scf.d):00078         IT.XTYP             RMB       1                   Extended type (added by BRI)
                      (    ../defs/scf.d):00079         
                      (    ../defs/scf.d):00080                             IFGT      Level-1
                      (    ../defs/scf.d):00081         * Window Descriptor Additions
                      (    ../defs/scf.d):00082         * For CoCo window, where IT.PAR = $80
                      (    ../defs/scf.d):00083                             ORG       IT.ROW+1
002F                  (    ../defs/scf.d):00084         IT.WND              RMB       1                   Window number (matches device name) ($2E)
002F                  (    ../defs/scf.d):00085         IT.VAL              RMB       1                   Use defaults on Init (0=no, 1=yes)
002F                  (    ../defs/scf.d):00086         IT.STY              RMB       1                   Screen type default
002F                  (    ../defs/scf.d):00087         IT.CPX              RMB       1                   Column start default
