     0002             (./defs/cocovtio.d):00174         ModCoVDG            EQU       %00000010           CoVDG, Built-in VDG 32x16.
     0004             (./defs/cocovtio.d):00175         ModCoWP             EQU       %00000100           CoWP, WordPak, 80x25
     0008             (./defs/cocovtio.d):00176         ModCoHR             EQU       %00001000           CoHR, PMODE 4 51x25 text
     0010             (./defs/cocovtio.d):00177         ModCo42             EQU       %00010000           Co42, PMODE 4 42x25 text
     0020             (./defs/cocovtio.d):00178         ModCoVGA            EQU       %00100000           CoVGA, 64x32 text
     0040             (./defs/cocovtio.d):00179         ModCo80             EQU       %01000000           Co80, CRT9128 WordPak, 80x25
