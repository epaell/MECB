                      (./defs/cocovtio.d):00346         * Co(name) - Co-module screen driver entry points (CoWin, CoGrf, CoVDG, etc)
                      (./defs/cocovtio.d):00347                             ORG       0
00FA                  (./defs/cocovtio.d):00348         CoInit              RMB       3                   $00 = Init Co-module entry
00FA                  (./defs/cocovtio.d):00349         CoWrite             RMB       3                   $03 = Write Co-module entry
00FA                  (./defs/cocovtio.d):00350         CoGetStt            RMB       3                   $06 = GetStat Co-module entry
00FA                  (./defs/cocovtio.d):00351         CoSetStt            RMB       3                   $09 = SetStat Co-module entry
00FA                  (./defs/cocovtio.d):00352         CoTerm              RMB       3                   $0C = Term Co-module entry
00FA                  (./defs/cocovtio.d):00353         CoWinSpc            RMB       3                   $0F = Window special processing functions (see below)
                      (./defs/cocovtio.d):00354         *                                                  (sub function # in A on entry)
                      (./defs/cocovtio.d):00355         
                      (./defs/cocovtio.d):00356         **********************
                      (./defs/cocovtio.d):00357         * CoWinSpc special functions (in A when CoWinSpc called)
                      (./defs/cocovtio.d):00358                             ORG       0
00FA                  (./defs/cocovtio.d):00359         WnSpSlct            RMB       1                   $00 = Select different window
00FA                  (./defs/cocovtio.d):00360         WnSpStat            RMB       1                   $01 = Update Pt.Stat (mouse in content,control,external regions)
00FA                  (./defs/cocovtio.d):00361         WnSpUpCr            RMB       1                   $02 = Update text & mouse cursors
00FA                  (./defs/cocovtio.d):00362         WnSpAMse            RMB       1                   $03 = Update auto-follow mouse cursor
                      (./defs/cocovtio.d):00363         
                      (./defs/cocovtio.d):00364         * NOTE: KeyDrv merged back into VTIO in EOU Beta 6 (saves memory in OS9Boot, and 10 bytes
                      (./defs/cocovtio.d):00365         *  in CC3 Global mem. And all third party keyboards plug into regular Coco keyboard anyways)
                      (./defs/cocovtio.d):00366         **********************
                      (./defs/cocovtio.d):00367         * KeyDrv Entry Points
                      (./defs/cocovtio.d):00368         *               ORG       0
                      (./defs/cocovtio.d):00369         *K$Init         RMB       3                   keyboard initialization (does nothing)
                      (./defs/cocovtio.d):00370         *K$Term         RMB       3                   keyboard termination (does nothing)
                      (./defs/cocovtio.d):00371         *K$FnKey        RMB       3                   get function key states (Gets F1/F2 key state)
                      (./defs/cocovtio.d):00372         *K$RdKey        RMB       3                   get key states (Gets all other key states)
                      (./defs/cocovtio.d):00373         
                      (./defs/cocovtio.d):00374         **********************
                      (./defs/cocovtio.d):00375         * JoyDrv Entry Points
                      (./defs/cocovtio.d):00376                             ORG       0
00FA                  (./defs/cocovtio.d):00377         J$Init              RMB       3                   joystick initialization
00FA                  (./defs/cocovtio.d):00378         J$Term              RMB       3                   joystick termination
00FA                  (./defs/cocovtio.d):00379         J$MsBtn             RMB       3                   get mouse button states
00FA                  (./defs/cocovtio.d):00380         J$MsXY              RMB       3                   get mouse X/Y coordinates (returns high res values)
00FA                  (./defs/cocovtio.d):00381         J$JyBtn             RMB       3                   get joystick button states
00FA                  (./defs/cocovtio.d):00382         J$JyXY              RMB       3                   get joystick X/Y coordinates (returns low res values)
                      (./defs/cocovtio.d):00383         
                      (./defs/cocovtio.d):00384         **********************
                      (./defs/cocovtio.d):00385         * SndDrv Entry Points
                      (./defs/cocovtio.d):00386                             ORG       0
00FA                  (./defs/cocovtio.d):00387         S$Init              RMB       3                   sound initialization
00FA                  (./defs/cocovtio.d):00388         S$GetStt            RMB       3                   sound GetStats
00FA                  (./defs/cocovtio.d):00389         S$SetStt            RMB       3                   sound SetStats
00FA                  (./defs/cocovtio.d):00390         S$Term              RMB       3                   sound termination
                      (./defs/cocovtio.d):00391         
                      (./defs/cocovtio.d):00392         ********************************
                      (./defs/cocovtio.d):00393         * Window/Menu Bar Data Structure
                      (./defs/cocovtio.d):00394         *
                      (./defs/cocovtio.d):00395         * To be used in SS.WnSet SETSTAT to set up a Framed Window
                      (./defs/cocovtio.d):00396         * for use in the high level windowing package.
                      (./defs/cocovtio.d):00397         *
00FA                  (./defs/cocovtio.d):00398         NUMMENS             EQU       10                  maximum number of menus on menu bar
00FA                  (./defs/cocovtio.d):00399         NUMITMS             EQU       20                  maximum number of items in a menu
00FA                  (./defs/cocovtio.d):00400         MXTTLEN             EQU       15                  max chars for menu and item names
00FA                  (./defs/cocovtio.d):00401         WINSYNC             EQU       $C0C0               synch bytes for window validation
                      (./defs/cocovtio.d):00402         *
                      (./defs/cocovtio.d):00403         * Menu Item Descriptor : (MN.ITEMS)
                      (./defs/cocovtio.d):00404         * one required for each item within the menu
                      (./defs/cocovtio.d):00405         *
                      (./defs/cocovtio.d):00406                             ORG       0
00FA                  (./defs/cocovtio.d):00407         MI.TTL              RMB       MXTTLEN             item name
00FA                  (./defs/cocovtio.d):00408         MI.ENBL             RMB       1                   enable flag
00FA                  (./defs/cocovtio.d):00409         MI.RES              RMB       5                   reserved bytes
00FA                  (./defs/cocovtio.d):00410         MI.SIZ              EQU       .                   size of menu item descriptor
                      (./defs/cocovtio.d):00411         *
                      (./defs/cocovtio.d):00412         * Menu Descriptor :
                      (./defs/cocovtio.d):00413         * one for each menu on the manu bar
                      (./defs/cocovtio.d):00414         * each is pointed to by MB.MPTR below
                      (./defs/cocovtio.d):00415         *
                      (./defs/cocovtio.d):00416                             ORG       0
00FA                  (./defs/cocovtio.d):00417         MN.TTL              RMB       MXTTLEN             menu title
00FA                  (./defs/cocovtio.d):00418         MN.ID               RMB       1                   menu id number (1-255)
00FA                  (./defs/cocovtio.d):00419         MN.XSIZ             RMB       1                   horiz. size of desired pull down
00FA                  (./defs/cocovtio.d):00420         MN.NITS             RMB       1                   number of items in menu
00FA                  (./defs/cocovtio.d):00421         MN.ENBL             RMB       1                   enable flag
00FA                  (./defs/cocovtio.d):00422         MN.RES              RMB       2                   reserved bytes
00FA                  (./defs/cocovtio.d):00423         MN.ITEMS            RMB       2                   pointer to array of menu items
00FA                  (./defs/cocovtio.d):00424         MN.SIZ              EQU       .                   size of menu descriptor
                      (./defs/cocovtio.d):00425         *
                      (./defs/cocovtio.d):00426         * Window Descriptor:
                      (./defs/cocovtio.d):00427         * one required for each application in a framed window
                      (./defs/cocovtio.d):00428         *
                      (./defs/cocovtio.d):00429                             ORG       0
00FA                  (./defs/cocovtio.d):00430         WN.TTL              RMB       20                  title of window for title bar
00FA                  (./defs/cocovtio.d):00431         WN.NMNS             RMB       1                   number of menus in menu bar
00FA                  (./defs/cocovtio.d):00432         WN.XMIN             RMB       1                   minimal horiz. size for application to run
00FA                  (./defs/cocovtio.d):00433         WN.YMIN             RMB       1                   minimal vert. size for application to run
00FA                  (./defs/cocovtio.d):00434         WN.SYNC             RMB       2                   synch bytes ($C0C0)
00FA                  (./defs/cocovtio.d):00435         WN.RES              RMB       7                   reserved bytes
00FA                  (./defs/cocovtio.d):00436         WN.BAR              RMB       2                   pointer to arry of menu descriptors
00FA                  (./defs/cocovtio.d):00437         WN.SIZ              EQU       .                   size of window/menu bar descriptor
                      (./defs/cocovtio.d):00438         
                      (./defs/cocovtio.d):00439         *************************
                      (./defs/cocovtio.d):00440         * Window Type Definitions
