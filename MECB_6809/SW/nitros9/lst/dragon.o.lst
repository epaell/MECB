                      ( ../defs/dragon.d):00055         * Special character Bit position equates
                      ( ../defs/dragon.d):00056         *
     0001             ( ../defs/dragon.d):00057         SHIFTBIT            EQU       %00000001
     0002             ( ../defs/dragon.d):00058         CNTRLBIT            EQU       %00000010
     0004             ( ../defs/dragon.d):00059         ALTERBIT            EQU       %00000100
     0008             ( ../defs/dragon.d):00060         UPBIT               EQU       %00001000
     0010             ( ../defs/dragon.d):00061         DOWNBIT             EQU       %00010000
     0020             ( ../defs/dragon.d):00062         LEFTBIT             EQU       %00100000
     0040             ( ../defs/dragon.d):00063         RIGHTBIT            EQU       %01000000
     0080             ( ../defs/dragon.d):00064         SPACEBIT            EQU       %10000000
                      ( ../defs/dragon.d):00065         
                      ( ../defs/dragon.d):00066         ******************
                      ( ../defs/dragon.d):00067         * VDG Devices
                      ( ../defs/dragon.d):00068         *
     FFC0             ( ../defs/dragon.d):00069         A.TermV             SET       $FFC0               VDG Term
     FFC1             ( ../defs/dragon.d):00070         A.V1                SET       $FFC1               Possible additional VDG Devices
     FFC2             ( ../defs/dragon.d):00071         A.V2                SET       $FFC2
     FFC3             ( ../defs/dragon.d):00072         A.V3                SET       $FFC3
     FFC4             ( ../defs/dragon.d):00073         A.V4                SET       $FFC4
     FFC5             ( ../defs/dragon.d):00074         A.V5                SET       $FFC5
     FFC6             ( ../defs/dragon.d):00075         A.V6                SET       $FFC6
     FFC7             ( ../defs/dragon.d):00076         A.V7                SET       $FFC7
                      ( ../defs/dragon.d):00077         
                      ( ../defs/dragon.d):00078         ********************
                      ( ../defs/dragon.d):00079         * VTIO Static Memory
                      ( ../defs/dragon.d):00080         *
                      ( ../defs/dragon.d):00081         * Definitions for ports on Dragon 32/64/Alpha.
                      ( ../defs/dragon.d):00082         *
                      ( ../defs/dragon.d):00083         *
     FF00             ( ../defs/dragon.d):00084         IO                  equ       $ff00               IO page on Dragon
                      ( ../defs/dragon.d):00085         
                      ( ../defs/dragon.d):00086         *
                      ( ../defs/dragon.d):00087         * Most of these symbols will be defined twice, as some
                      ( ../defs/dragon.d):00088         * of the Dragon code, sets DP=$FF, and uses direct page
                      ( ../defs/dragon.d):00089         * addressing to access the io ports, whilst some of it
                      ( ../defs/dragon.d):00090         * uses absolute addressing.
                      ( ../defs/dragon.d):00091         * The versions starting DP must be used with DP=$FF.
                      ( ../defs/dragon.d):00092         *
                      ( ../defs/dragon.d):00093         
                      ( ../defs/dragon.d):00094         * PIA 0 and 1 standard on all Dragons.
     0000             ( ../defs/dragon.d):00095         DPPIA0DA            EQU       $00                 Side A Data/DDR
     FF00             ( ../defs/dragon.d):00096         PIA0Base            EQU       DPPIA0DA+IO
     0001             ( ../defs/dragon.d):00097         DPPIA0CRA           EQU       $01                 Side A Control.
     0002             ( ../defs/dragon.d):00098         DPPIA0DB            EQU       $02                 Side B Data/DDR
     0003             ( ../defs/dragon.d):00099         DPPIA0CRB           EQU       $03                 Side B Control.
                      ( ../defs/dragon.d):00100         
     FF00             ( ../defs/dragon.d):00101         PIA0DA              EQU       DPPIA0DA+IO         Side A Data/DDR
     FF01             ( ../defs/dragon.d):00102         PIA0CRA             EQU       DPPIA0CRA+IO        Side A Control.
     FF02             ( ../defs/dragon.d):00103         PIA0DB              EQU       DPPIA0DB+IO         Side A Data/DDR
     FF03             ( ../defs/dragon.d):00104         PIA0CRB             EQU       DPPIA0CRB+IO        Side A Control.
                      ( ../defs/dragon.d):00105         
     0020             ( ../defs/dragon.d):00106         DPPIA1DA            EQU       $20                 Side A Data/DDR
     FF20             ( ../defs/dragon.d):00107         PIA1Base            EQU       DPPIA1DA+IO
     0021             ( ../defs/dragon.d):00108         DPPIA1CRA           EQU       $21                 Side A Control.
     0022             ( ../defs/dragon.d):00109         DPPIA1DB            EQU       $22                 Side B Data/DDR
     0023             ( ../defs/dragon.d):00110         DPPIA1CRB           EQU       $23                 Side B Control.
                      ( ../defs/dragon.d):00111         
     FF20             ( ../defs/dragon.d):00112         PIA1DA              EQU       DPPIA1DA+IO         Side A Data/DDR
     FF21             ( ../defs/dragon.d):00113         PIA1CRA             EQU       DPPIA1CRA+IO        Side A Control.
     FF22             ( ../defs/dragon.d):00114         PIA1DB              EQU       DPPIA1DB+IO         Side A Data/DDR
     FF23             ( ../defs/dragon.d):00115         PIA1CRB             EQU       DPPIA1CRB+IO        Side A Control.
                      ( ../defs/dragon.d):00116         
                      ( ../defs/dragon.d):00117         * Dragon Alpha has a third PIA at $FF24.
     0024             ( ../defs/dragon.d):00118         DPPIA2DA            EQU       $24                 Side A Data/DDR
     0025             ( ../defs/dragon.d):00119         DPPIA2CRA           EQU       $25                 Side A Control.
     0026             ( ../defs/dragon.d):00120         DPPIA2DB            EQU       $26                 Side B Data/DDR
     0027             ( ../defs/dragon.d):00121         DPPIA2CRB           EQU       $27                 Side B Control.
                      ( ../defs/dragon.d):00122         
     FF24             ( ../defs/dragon.d):00123         PIA2DA              EQU       DPPIA2DA+IO         Side A Data/DDR
     FF25             ( ../defs/dragon.d):00124         PIA2CRA             EQU       DPPIA2CRA+IO        Side A Control.
     FF26             ( ../defs/dragon.d):00125         PIA2DB              EQU       DPPIA2DB+IO         Side A Data/DDR
     FF27             ( ../defs/dragon.d):00126         PIA2CRB             EQU       DPPIA2CRB+IO        Side A Control.
                      ( ../defs/dragon.d):00127         
                      ( ../defs/dragon.d):00128         * WD2797 Floppy disk controler, used in Alpha Note registers in reverse order !
     002F             ( ../defs/dragon.d):00129         DPCmdRegA           EQU       $2F                 command/status
     002E             ( ../defs/dragon.d):00130         DPTrkRegA           EQU       $2E                 Track register
     002D             ( ../defs/dragon.d):00131         DPSecRegA           EQU       $2D                 Sector register
     002C             ( ../defs/dragon.d):00132         DPDataRegA          EQU       $2C                 Data register
                      ( ../defs/dragon.d):00133         
     ????             ( ../defs/dragon.d):00134         CmdRegA             EQU       DPCMDREGA+IO        command/status
     ????             ( ../defs/dragon.d):00135         TrkRegA             EQU       DPTRKREGA+IO        Track register
     ????             ( ../defs/dragon.d):00136         SecRegA             EQU       DPSECREGA+IO        Sector register
     ????             ( ../defs/dragon.d):00137         DataRegA            EQU       DPDATAREGA+IO       Data register
                      ( ../defs/dragon.d):00138         
     ????             ( ../defs/dragon.d):00139         DPort               SET       DataRegA            Disk controller base address
                      ( ../defs/dragon.d):00140         
                      ( ../defs/dragon.d):00141         * Constants for Alpha AY-8912 sound chip, which is used to control
                      ( ../defs/dragon.d):00142         * Drive select and motor on the Alpha
     000E             ( ../defs/dragon.d):00143         AYIOREG             EQU       $0E                 AY-8912, IO Register number.
     0000             ( ../defs/dragon.d):00144         AYIdle              EQU       $00                 Make AY Idle.
     0001             ( ../defs/dragon.d):00145         AYWriteReg          EQU       $01                 Write AY Register
     0002             ( ../defs/dragon.d):00146         AYReadReg           EQU       $02                 Read AY Register
     0003             ( ../defs/dragon.d):00147         AYREGLatch          EQU       $03                 Latch register into AY
                      ( ../defs/dragon.d):00148         
     0003             ( ../defs/dragon.d):00149         DSMask              EQU       $03                 Drive select mask.
     0004             ( ../defs/dragon.d):00150         MotorMask           EQU       $04                 Motor enable mask
     0008             ( ../defs/dragon.d):00151         DDENMask            EQU       $08                 DDEN Mask
     0010             ( ../defs/dragon.d):00152         ENPMask             EQU       $10                 Enable Precomp mask
     0020             ( ../defs/dragon.d):00153         NMIMask             EQU       $20                 NMI enable Mask
                      ( ../defs/dragon.d):00154         
                      ( ../defs/dragon.d):00155         * Dragon 64/Alpha Serial port.
     0004             ( ../defs/dragon.d):00156         DPAciaData          EQU       $04                 ACIA Rx/Tx Register
     0005             ( ../defs/dragon.d):00157         DPAciaStat          EQU       $05                 ACIA status register
     0006             ( ../defs/dragon.d):00158         DPAciaCmd           EQU       $06                 ACIA command register
     0007             ( ../defs/dragon.d):00159         DPAciaCtrl          EQU       $07                 ACIA control register
                      ( ../defs/dragon.d):00160         
     FF04             ( ../defs/dragon.d):00161         AciaData            EQU       DPAciaData+IO       ACIA Rx/Tx Register
     FF05             ( ../defs/dragon.d):00162         AciaStat            EQU       DPAciaStat+IO       ACIA status register
     FF06             ( ../defs/dragon.d):00163         AciaCmd             EQU       DPAciaCmd+IO        ACIA command register
     FF07             ( ../defs/dragon.d):00164         AciaCtrl            EQU       DPAciaCtrl+IO       ACIA control register
                      ( ../defs/dragon.d):00165         
                      ( ../defs/dragon.d):00166         * DragonDos Cartrage IO for WD2797
                      ( ../defs/dragon.d):00167         * WD2797 Floppy disk controler, used in DragonDos.
     0040             ( ../defs/dragon.d):00168         DPCmdRegD           EQU       $40                 command/status
     0041             ( ../defs/dragon.d):00169         DPTrkRegD           EQU       $41                 Track register
     0042             ( ../defs/dragon.d):00170         DPSecRegD           EQU       $42                 Sector register
     0043             ( ../defs/dragon.d):00171         DPDataRegD          EQU       $43                 Data register
                      ( ../defs/dragon.d):00172         
     ????             ( ../defs/dragon.d):00173         CmdRegD             EQU       DPCMDREGD+IO        command/status
     ????             ( ../defs/dragon.d):00174         TrkRegD             EQU       DPTRKREGD+IO        Track register
     ????             ( ../defs/dragon.d):00175         SecRegD             EQU       DPSECREGD+IO        Sector register
     ????             ( ../defs/dragon.d):00176         DataRegD            EQU       DPDATAREGD+IO       Data register
                      ( ../defs/dragon.d):00177         
     0048             ( ../defs/dragon.d):00178         DPDSKCTL            EQU       $48                 Disk DS/motor control reg
     FF48             ( ../defs/dragon.d):00179         DSKCTL              EQU       DPDSKCTL+IO
                      ( ../defs/dragon.d):00180         
                      ( ../defs/dragon.d):00181         * Disk IO bitmasks (DragonDos).
     0020             ( ../defs/dragon.d):00182         NMIEnD              EQU       %00100000
     0010             ( ../defs/dragon.d):00183         WPCEnD              EQU       %00010000
     0008             ( ../defs/dragon.d):00184         SDensEnD            EQU       %00001000
     0004             ( ../defs/dragon.d):00185         MotorOnD            EQU       %00000100
     0000             ( ../defs/dragon.d):00186         Drive0D             EQU       %00000000
     0001             ( ../defs/dragon.d):00187         Drive1D             EQU       %00000001
     0002             ( ../defs/dragon.d):00188         Drive2D             EQU       %00000010
     0003             ( ../defs/dragon.d):00189         Drive3D             EQU       %00000011
     0003             ( ../defs/dragon.d):00190         DDosDriveMask       EQU       %00000011           Mask out all non drive select bits
     00FC             ( ../defs/dragon.d):00191         DDosCtrlMask        EQU       %11111100           Mask in all non drive select bits
                      ( ../defs/dragon.d):00192         
                      ( ../defs/dragon.d):00193         
                      ( ../defs/dragon.d):00194         * Disk IO bitmasks (Dragon Alpha).
     0008             ( ../defs/dragon.d):00195         PIANMIEnA           EQU       %00001000           PIA2, CA2, used to enable/disable NMI
     00F7             ( ../defs/dragon.d):00196         PIANMIDisA          EQU       %11110111           Bitmask to force CA2 off, and disable NMI
                      ( ../defs/dragon.d):00197         
     0080             ( ../defs/dragon.d):00198         NMIEnA              EQU       %10000000           Flag to enable disable NMI, passed to AlphaDskCtl
     0040             ( ../defs/dragon.d):00199         WPCEnA              EQU       %01000000           According to circuit trace by R.Harding.
     0020             ( ../defs/dragon.d):00200         SDensEnA            EQU       %00100000           DDen, from circuit trace on R.Harding's machine.
     0010             ( ../defs/dragon.d):00201         MotorOnA            EQU       %00010000
     0001             ( ../defs/dragon.d):00202         Drive0A             EQU       %00000001
     0002             ( ../defs/dragon.d):00203         Drive1A             EQU       %00000010
     0004             ( ../defs/dragon.d):00204         Drive2A             EQU       %00000100
     0008             ( ../defs/dragon.d):00205         Drive3A             EQU       %00001000
     000F             ( ../defs/dragon.d):00206         AlphaDrvMask        EQU       %00001111           Mask out all non drive select bits
     00F0             ( ../defs/dragon.d):00207         AlphaCtrlMask       EQU       %11110000           Mask in all non drive select bits
                      ( ../defs/dragon.d):00208         
     007F             ( ../defs/dragon.d):00209         Mask58              EQU       %01111111           And mask to make sure 5.25" clock selected by WD2797
                      ( ../defs/dragon.d):00210         
     003C             ( ../defs/dragon.d):00211         NMICA2En            EQU       $3C                 Value for PIA CRA to enable NMI
     0034             ( ../defs/dragon.d):00212         NMICA2Dis           EQU       $34                 Value for PIA CRA to disable NMI
                      ( ../defs/dragon.d):00213         
                      ( ../defs/dragon.d):00214         * Disk Commands
     00D0             ( ../defs/dragon.d):00215         FrcInt              EQU       %11010000
     0088             ( ../defs/dragon.d):00216         ReadCmnd            EQU       %10001000
     0000             ( ../defs/dragon.d):00217         RestCmnd            EQU       %00000000
     0010             ( ../defs/dragon.d):00218         SeekCmnd            EQU       %00010000
     0040             ( ../defs/dragon.d):00219         StpICmnd            EQU       %01000000
     00A8             ( ../defs/dragon.d):00220         WritCmnd            EQU       %10101000
     00F0             ( ../defs/dragon.d):00221         WtTkCmnd            EQU       %11110000
     0002             ( ../defs/dragon.d):00222         Sid2Sel             EQU       %00000010
                      ( ../defs/dragon.d):00223         
                      ( ../defs/dragon.d):00224         * Disk Status Bits
     0001             ( ../defs/dragon.d):00225         BusyMask            EQU       %00000001
     0004             ( ../defs/dragon.d):00226         LostMask            EQU       %00000100
     00F8             ( ../defs/dragon.d):00227         ErrMask             EQU       %11111000
     0008             ( ../defs/dragon.d):00228         CRCMask             EQU       %00001000
     0010             ( ../defs/dragon.d):00229         RNFMask             EQU       %00010000
     0020             ( ../defs/dragon.d):00230         RTypMask            EQU       %00100000
     0040             ( ../defs/dragon.d):00231         WPMask              EQU       %01000000
     0080             ( ../defs/dragon.d):00232         NotRMask            EQU       %10000000
                      ( ../defs/dragon.d):00233         
     0001             ( ../defs/dragon.d):00234         DensMask            EQU       %00000001
     0002             ( ../defs/dragon.d):00235         T80Mask             EQU       %00000010
                      ( ../defs/dragon.d):00236         
                      ( ../defs/dragon.d):00237         ********************************
                      ( ../defs/dragon.d):00238         * Boot defs for NitrOS-9 Level 1
                      ( ../defs/dragon.d):00239         *
                      ( ../defs/dragon.d):00240         * These defs are not strictly for 'Boot', but are for booting the
                      ( ../defs/dragon.d):00241         * system.
                      ( ../defs/dragon.d):00242         *
                      ( ../defs/dragon.d):00243         * Boot area size on Dragon is only 16 sectors=4K
     1000             ( ../defs/dragon.d):00244         Bt.Size             EQU       $1000               Max size of boot file
                      ( ../defs/dragon.d):00245         * Boot area on the Dragon starts on track 0 sector 2, immediately
                      ( ../defs/dragon.d):00246         * after the blockmap.
     0000             ( ../defs/dragon.d):00247         Bt.Track            EQU       0                   Boot track
     0002             ( ../defs/dragon.d):00248         Bt.Sec              EQU       2                   Start LSN of boot area on boot track
     EE00             ( ../defs/dragon.d):00249         Bt.Start            EQU       $EE00               Start address of the boot track in memory
                      ( ../defs/dragon.d):00250         
                      ( ../defs/dragon.d):00251                             ENDC
                      (        dragon.as):00013                             use       ../defs/cocovtio.d
                      (./defs/cocovtio.d):00001                             IFNE      COCOVTIO.D-1
     0001             (./defs/cocovtio.d):00002         COCOVTIO.D          SET       1
                      (./defs/cocovtio.d):00003         
                      (./defs/cocovtio.d):00004                             IFEQ      Level-1
                      (./defs/cocovtio.d):00005         
                      (./defs/cocovtio.d):00006         ********************************************************************
                      (./defs/cocovtio.d):00007         * VTIODefs - Video Terminal I/O Definitions for CoCo 1/2
                      (./defs/cocovtio.d):00008         *
                      (./defs/cocovtio.d):00009         * Edt/Rev  YYYY/MM/DD  Modified by
                      (./defs/cocovtio.d):00010         * Comment
                      (./defs/cocovtio.d):00011         * ------------------------------------------------------------------
                      (./defs/cocovtio.d):00012         *          2004/11/29  P.Harvey-Smith.
                      (./defs/cocovtio.d):00013         * Added symbolic defines for bits in V.CoLoad.
                      (./defs/cocovtio.d):00014         *
                      (./defs/cocovtio.d):00015         *          2004/12/02  P.Harvey-Smith.
                      (./defs/cocovtio.d):00016         * Moved over all variables from co51.asm
                      (./defs/cocovtio.d):00017         *
                      (./defs/cocovtio.d):00018         *          2005/04/09  P.Harvey-Smith.
                      (./defs/cocovtio.d):00019         * Decoded rest of the CoHR memory locations.
                      (./defs/cocovtio.d):00020         *
                      (./defs/cocovtio.d):00021         *              2005/04/24  P.Harvey-Smith.
                      (./defs/cocovtio.d):00022         * Added variables for cursor flash, currently only implemented in co51
                      (./defs/cocovtio.d):00023         *
                      (./defs/cocovtio.d):00024         *          2020/07/14  L. Curtis Boyle
                      (./defs/cocovtio.d):00025         * EOU Beta 6 added defs, removed G.KeyEnt (2 bytes), G.KeyMem (8 bytes) static mem buffer,
                      (./defs/cocovtio.d):00026         *   as Keydrv has been merged back into VTIO to save some system RAM and CC3 Global Mem.
                      (./defs/cocovtio.d):00027         *   Added labels for the buffered write routines for SCF and GRFDRV as well.
                      (./defs/cocovtio.d):00028         *   (There appears to still be room for a CoVDG buffer as well, if we want to add one)
                      (./defs/cocovtio.d):00029         
                      (./defs/cocovtio.d):00030                             NAM       VTIODefs
                      (./defs/cocovtio.d):00031                             TTL       Video               Terminal I/O Definitions for CoCo 1/2
                      (./defs/cocovtio.d):00032         
                      (./defs/cocovtio.d):00033         ********************
                      (./defs/cocovtio.d):00034         * VTIO Static Memory
                      (./defs/cocovtio.d):00035         *
                      (./defs/cocovtio.d):00036                             ORG       V.SCF
001D                  (./defs/cocovtio.d):00037         V.ScrnA             RMB       2                   (2) screen start address in system memory
001F                  (./defs/cocovtio.d):00038         V.ScrnE             RMB       2                   (2) address of end of screen
0021                  (./defs/cocovtio.d):00039         V.CrsrA             RMB       1                   (2) cursor address
0022                  (./defs/cocovtio.d):00040         V.CrsAL             RMB       1                   cursor address low
0023                  (./defs/cocovtio.d):00041         V.CChar             RMB       1                   value of character under cursor
0024                  (./defs/cocovtio.d):00042         V.Mode              RMB       1                   mode: 0=256x192 x2, 1=128x192 x4
0025                  (./defs/cocovtio.d):00043         V.NGChr             RMB       1                   number of additional characters to get
0026                  (./defs/cocovtio.d):00044         V.RTAdd             RMB       2                   (2) return address after getting characters
0028                  (./defs/cocovtio.d):00045         V.NChar             RMB       1                   character to process
