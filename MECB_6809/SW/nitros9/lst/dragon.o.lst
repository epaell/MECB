     0072             (/defs/drivewire.d):00123         OP_REREAD           equ       'r                  Re-read one sector
     00D2             (/defs/drivewire.d):00124         OP_READEX           equ       'R+128              Read one sector
     00F2             (/defs/drivewire.d):00125         OP_REREADEX         equ       'r+128              Re-read one sector
     0057             (/defs/drivewire.d):00126         OP_WRITE            equ       'W                  Write one sector
