                      (s/wildbits_vtio.d):00069         ********************************************************************
                      (s/wildbits_vtio.d):00070         * vtio graphics definitions - 53 bytes + 
                      (s/wildbits_vtio.d):00071         ********************************************************************
                      (s/wildbits_vtio.d):00072         
0063                  (s/wildbits_vtio.d):00073         V.ST                RMB       1                    screen type 0=Term 1=Gfx
                      (s/wildbits_vtio.d):00074         
                      (s/wildbits_vtio.d):00075         * VICKY MASTER CONTROL REGISTER to enable graphics and capabilities
                      (s/wildbits_vtio.d):00076         * | 7 |   6   |    5   |   4  |    3   |   2   |   1   |   0  |
                      (s/wildbits_vtio.d):00077         * | X | GAMMA | SPRITE | TILE | BITMAP | GRAPH | OVRLY | TEXT |
                      (s/wildbits_vtio.d):00078         * |   -----   | FON_SET|FON_OV| MON_SLP| DBL_Y | DBL_X | CLK70|
                      (s/wildbits_vtio.d):00079         * $FFC0 MASTER_CTRL_REG_L, MASTER_CTRL_REG_H
                      (s/wildbits_vtio.d):00080         * See constants below for settings used with SS.DSCrn in vtio
                      (s/wildbits_vtio.d):00081         
0064                  (s/wildbits_vtio.d):00082         V.V_MCR             RMB       2                   2 bytes for Vicky Control Register
                      (s/wildbits_vtio.d):00083         
                      (s/wildbits_vtio.d):00084         * VICKY LAYER CONTROL REGISTER to set bitmaps and/or tile maps for display
                      (s/wildbits_vtio.d):00085         * | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |
                      (s/wildbits_vtio.d):00086         * | - |   LAYER1  | - |  LAYER 0  |
                      (s/wildbits_vtio.d):00087         * |       ------      |  LAYER 2  |
                      (s/wildbits_vtio.d):00088         * 000=BM0 001=BM1 010=BM2 100=TM0 101=TM1 110=TM2
                      (s/wildbits_vtio.d):00089         * $FFC2 VKY_RESERVED_00, VKY_RESERVED_01
                      (s/wildbits_vtio.d):00090         * See SS.PScrn in vtio
                      (s/wildbits_vtio.d):00091         
0066                  (s/wildbits_vtio.d):00092         V.V_LayerCTL       RMB        2
                      (s/wildbits_vtio.d):00093         
                      (s/wildbits_vtio.d):00094         * BITMAPS
                      (s/wildbits_vtio.d):00095         * Store starting page for bitmaps, and CLUT# and bitmap enable bits.  Must be in first 512K RAM.
                      (s/wildbits_vtio.d):00096         * $01_0000-$07_FFFF (OS9 Memory Blocks $01-$3F)
                      (s/wildbits_vtio.d):00097         * Byte 1 of Bitmap register is CLUT(4 CLUTS:0-3)/Enable
                      (s/wildbits_vtio.d):00098         * | 7 | 6 | 5 | 4 | 3 | 2 | 1 |   0    |
                      (s/wildbits_vtio.d):00099         * |       -----       |  CLUT | ENABLE |
                      (s/wildbits_vtio.d):00100         * Next 3 bytes in register used for physical 19 bit address for bitmap
                      (s/wildbits_vtio.d):00101         * Max address is 07FFFF (must be in 1st 512K), which is 19 bits
                      (s/wildbits_vtio.d):00102         * Store block# and then convert to 19 bit address in driver
                      (s/wildbits_vtio.d):00103         
0068                  (s/wildbits_vtio.d):00104         V.BM0Blk            RMB       1                   bitmap0 block
0069                  (s/wildbits_vtio.d):00105         V.BM0Cl_En          RMB       1                   bitmap0 |clut|enable|
006A                  (s/wildbits_vtio.d):00106         V.BM1Blk            RMB       1                   bitmap1 block
006B                  (s/wildbits_vtio.d):00107         V.BM1Cl_En          RMB       1                   bitmap1 |clut|enable|
006C                  (s/wildbits_vtio.d):00108         V.BM2Blk            RMB       1                   bitmap2 block
006D                  (s/wildbits_vtio.d):00109         V.BM2Cl_En          RMB       1                   bitmap2 |clut|enable|
                      (s/wildbits_vtio.d):00110         
                      (s/wildbits_vtio.d):00111         * CLUT - need to store mirror of CLUT data so switching windows will work
                      (s/wildbits_vtio.d):00112         * Store block# where high 4k is CLUT mirror.  Could store in last 4k of BM blocks.
                      (s/wildbits_vtio.d):00113         
006E                  (s/wildbits_vtio.d):00114         V.CLUTBlk           RMB       1                   block where high 4k mirrored CLUT data,0=Default CLUT
006F                  (s/wildbits_vtio.d):00115         V.CLUT              RMB       1                   which CLUTs are active 00001111
                      (s/wildbits_vtio.d):00116         
                      (s/wildbits_vtio.d):00117         * TILE MAPS - 3 tile maps.  Registers are 12 bytes, 2 are reserved and
                      (s/wildbits_vtio.d):00118         * 3 are the plysical address for the Tile Set.  Use Blk# for address here.
                      (s/wildbits_vtio.d):00119         * So only need 8 bytes per tile map.  In the Map each tile is 2 bytes
                      (s/wildbits_vtio.d):00120         * byte0=Tile number, byte1=CLUT+Tile Set. So relationship between Tile Map
                      (s/wildbits_vtio.d):00121         * and Tile Set is set in the actual tile map data, not here.
                      (s/wildbits_vtio.d):00122         * A tile map could be 2.4K (40x30) to 132K (256x256)
                      (s/wildbits_vtio.d):00123         
0070                  (s/wildbits_vtio.d):00124         V.TM0               RMB      1                    bit4 is yile size (1=8x8,0=16x16) bit0 is enable
0071                  (s/wildbits_vtio.d):00125         V.TM0Blk            RMB      1                    starting block# of Tile Map
0072                  (s/wildbits_vtio.d):00126         V.TM0MapX           RMB      1                    map size X (max 255)
0073                  (s/wildbits_vtio.d):00127         V.TM0MapY           RMB      1                    map size Y (max 255)
0074                  (s/wildbits_vtio.d):00128         V.TM0ScrlX          RMB      2                    2 bytes for scroll X info
0076                  (s/wildbits_vtio.d):00129         V.TM0ScrlY          RMB      2                    2 bytes for scroll Y info                 
0078                  (s/wildbits_vtio.d):00130         V.TM1               RMB      1                    bit4 is tile size (1=8x8,0=16x16) bit0 is enable
0079                  (s/wildbits_vtio.d):00131         V.TM1Blk            RMB      1                    starting block# of tile set
007A                  (s/wildbits_vtio.d):00132         V.TM1MapX           RMB      1                    map size X (max 255)
007B                  (s/wildbits_vtio.d):00133         V.TM1MapY           RMB      1                    map size Y (max 255)
007C                  (s/wildbits_vtio.d):00134         V.TM1ScrlX          RMB      2                    2 bytes for scroll X info
007E                  (s/wildbits_vtio.d):00135         V.TM1ScrlY          RMB      2                    2 bytes for scroll Y info
0080                  (s/wildbits_vtio.d):00136         V.TM2               RMB      1                    bit4 is tile size (1=8x8,0=16x16) bit0 is enable
0081                  (s/wildbits_vtio.d):00137         V.TM2Blk            RMB      1                    starting block# of tile set
0082                  (s/wildbits_vtio.d):00138         V.TM2MapX           RMB      1                    map size X (max 255)
0083                  (s/wildbits_vtio.d):00139         V.TM2MapY           RMB      1                    map size Y (max 255)
0084                  (s/wildbits_vtio.d):00140         V.TM2ScrlX          RMB      2                    2 bytes for scroll X info
0086                  (s/wildbits_vtio.d):00141         V.TM2ScrlY          RMB      2                    2 bytes for scroll Y info
                      (s/wildbits_vtio.d):00142         
                      (s/wildbits_vtio.d):00143         * TILE SETS - there are 8 tile sets.  Tile Set registers contain a physical address, and
                      (s/wildbits_vtio.d):00144         * a Square bit to determine if Tile Set is LINEAR or SQUARE
                      (s/wildbits_vtio.d):00145         * Tile Sets are either 16K (8x8) or 64K (16x16)
                      (s/wildbits_vtio.d):00146         
0088                  (s/wildbits_vtio.d):00147         V.TS0Blk            RMB      1                    starting block# of tile set
0089                  (s/wildbits_vtio.d):00148         V.TS0SQR            RMB      1                    square or linear (bit 3)
008A                  (s/wildbits_vtio.d):00149         V.TS1Blk            RMB      1                    starting block# of tile set
008B                  (s/wildbits_vtio.d):00150         V.TS1SQR            RMB      1                    square or linear (bit 3)
008C                  (s/wildbits_vtio.d):00151         V.TS2Blk            RMB      1                    starting block# of tile set
008D                  (s/wildbits_vtio.d):00152         V.TS2SQR            RMB      1                    square or linear (bit 3)
008E                  (s/wildbits_vtio.d):00153         V.TS3Blk            RMB      1                    starting block# of tile set
008F                  (s/wildbits_vtio.d):00154         V.TS3SQR            RMB      1                    square or linear (bit 3)
0090                  (s/wildbits_vtio.d):00155         V.TS4Blk            RMB      1                    starting block# of tile set
0091                  (s/wildbits_vtio.d):00156         V.TS4SQR            RMB      1                    square or linear (bit 3)
0092                  (s/wildbits_vtio.d):00157         V.TS5Blk            RMB      1                    starting block# of tile set
0093                  (s/wildbits_vtio.d):00158         V.TS5SQR            RMB      1                    square or linear (bit 3)
0094                  (s/wildbits_vtio.d):00159         V.TS6Blk            RMB      1                    starting block# of tile set
0095                  (s/wildbits_vtio.d):00160         V.TS6SQR            RMB      1                    square or linear (bit 3)
0096                  (s/wildbits_vtio.d):00161         V.TS7Blk            RMB      1                    starting block# of tile set
0097                  (s/wildbits_vtio.d):00162         V.TS7SQR            RMB      1                    square or linear (bit 3)
                      (s/wildbits_vtio.d):00163         
                      (s/wildbits_vtio.d):00164         * GRAPHICS CURSORS,LINES, COLORS
0098                  (s/wildbits_vtio.d):00165         V.GCX               RMB      2                    graphics cursor X
009A                  (s/wildbits_vtio.d):00166         V.GCY               RMB      1                    graphics cursor Y
009B                  (s/wildbits_vtio.d):00167         V.GCOLOR            RMB      1                    graphics color
009C                  (s/wildbits_vtio.d):00168         V.LX                RMB      2                    line coordiate for X
009E                  (s/wildbits_vtio.d):00169         V.LY                RMB      1                    line coordinate for Y
009F                  (s/wildbits_vtio.d):00170         V.GCADDR            RMB      3                    address of cursor on screen
00A2                  (s/wildbits_vtio.d):00171         V.GCAD8K            RMB      2                    address in 8K window
00A4                  (s/wildbits_vtio.d):00172         V.GMAPBLK           RMB      2                    mapped in logical address of block
