                      (    ../defs/rbf.d):00085         *******************************
                      (    ../defs/rbf.d):00086         * RBF Device Descriptor Offsets
                      (    ../defs/rbf.d):00087         *
                      (    ../defs/rbf.d):00088         * These definitions are for RBF device descriptors.
                      (    ../defs/rbf.d):00089         
                      (    ../defs/rbf.d):00090                             ORG       M$DTyp
0012                  (    ../defs/rbf.d):00091                             RMB       1                   Device type (DT.RBF)
0013                  (    ../defs/rbf.d):00092         IT.DRV              RMB       1                   Drive number
0014                  (    ../defs/rbf.d):00093         IT.STP              RMB       1                   Step rate
0015                  (    ../defs/rbf.d):00094         IT.TYP              RMB       1                   Disk device type information
0016                  (    ../defs/rbf.d):00095         IT.DNS              RMB       1                   Density capability
0017                  (    ../defs/rbf.d):00096         IT.CYL              RMB       2                   Number of cylinders
0019                  (    ../defs/rbf.d):00097         IT.SID              RMB       1                   Number of surfaces
001A                  (    ../defs/rbf.d):00098         IT.VFY              RMB       1                   Verify disk writes (0 = verify, 1 = don't)
001B                  (    ../defs/rbf.d):00099         IT.SCT              RMB       2                   Default sectors/track
001D                  (    ../defs/rbf.d):00100         IT.T0S              RMB       2                   Default sectors/track for track 0 sector 0
001F                  (    ../defs/rbf.d):00101         IT.ILV              RMB       1                   Sector interleave offset
0020                  (    ../defs/rbf.d):00102         IT.SAS              RMB       1                   Segment allocation size
                      (    ../defs/rbf.d):00103         * The following fields are from the OS-9 Level One V2.00.00 Addendum
0021                  (    ../defs/rbf.d):00104         IT.TFM              RMB       1                   DMA Transfer Mode
0022                  (    ../defs/rbf.d):00105         IT.Exten            RMB       2                   Path Extension (PE) for record locking
0024                  (    ../defs/rbf.d):00106         IT.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
                      (    ../defs/rbf.d):00107         * The following fields are not copied to the path descriptor
0025                  (    ../defs/rbf.d):00108         IT.WPC              RMB       1                   Write precomp cyl/4 (HD)
0026                  (    ../defs/rbf.d):00109         IT.OFS              RMB       2                   Starting cylinder offset (HD)
0028                  (    ../defs/rbf.d):00110         IT.RWC              RMB       2                   Reduced write current cylinder (HD)
                      (    ../defs/rbf.d):00111         * These fields have been added because of SuperDriver.  They probably
                      (    ../defs/rbf.d):00112         * can be used in other drivers
                      (    ../defs/rbf.d):00113                             ORG       IT.WPC
0025                  (    ../defs/rbf.d):00114         IT.SOFF1            RMB       1
0026                  (    ../defs/rbf.d):00115         IT.SOFF2            RMB       1
0027                  (    ../defs/rbf.d):00116         IT.SOFF3            RMB       1
0028                  (    ../defs/rbf.d):00117         IT.LLDRV            RMB       2
002A                  (    ../defs/rbf.d):00118         IT.MPI              RMB       1
                      (    ../defs/rbf.d):00119         
                      (    ../defs/rbf.d):00120         
                      (    ../defs/rbf.d):00121         * IT.TYP Definitions
                      (    ../defs/rbf.d):00122         *
     0080             (    ../defs/rbf.d):00123         TYP.HARD            EQU       %10000000           Hard disk
     0000             (    ../defs/rbf.d):00124         TYP.FLP             EQU       %00000000           Floppy disk
     0040             (    ../defs/rbf.d):00125         TYP.NSF             EQU       %01000000           Non-standard format
     0000             (    ../defs/rbf.d):00126         TYP.SOF             EQU       %00000000           Standard NitrOS-9 format
                      (    ../defs/rbf.d):00127         
                      (    ../defs/rbf.d):00128         * IT.TYP bit definitions if bit 7 of IT.TYP is set (hard disk)
     0000             (    ../defs/rbf.d):00129         TYPH.256            EQU       %00000000           256 byte sector media
     0001             (    ../defs/rbf.d):00130         TYPH.512            EQU       %00000001           512 byte sector media
     0002             (    ../defs/rbf.d):00131         TYPH.1024           EQU       %00000010           1024 byte sector media
     0003             (    ../defs/rbf.d):00132         TYPH.2048           EQU       %00000011           2048 byte sector media
     0003             (    ../defs/rbf.d):00133         TYPH.SSM            EQU       %00000011           Sector size mask
     000C             (    ../defs/rbf.d):00134         TYPH.DRSV           EQU       %00001100           Driver-reserved bits
     0010             (    ../defs/rbf.d):00135         TYPH.DSQ            EQU       %00010000           Drive size query flag
                      (    ../defs/rbf.d):00136         
                      (    ../defs/rbf.d):00137         * IT.TYP bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (    ../defs/rbf.d):00138         TYP.5               EQU       %00000000           5" media
     0001             (    ../defs/rbf.d):00139         TYP.3               EQU       %00000001           3.5" media
     0002             (    ../defs/rbf.d):00140         TYP.SBO             EQU       %00000010           Sector base offset (clear = 0; sect = 1)
     0000             (    ../defs/rbf.d):00141         TYP.256             EQU       %00000000           256 byte sector media
     0004             (    ../defs/rbf.d):00142         TYP.512             EQU       %00000100           512 byte sector media
     0020             (    ../defs/rbf.d):00143         TYP.CCF             EQU       %00100000           CoCo format
     0000             (    ../defs/rbf.d):00144         TYP.NCCF            EQU       %00000000           Non-CoCo format
                      (    ../defs/rbf.d):00145         
                      (    ../defs/rbf.d):00146         * IT.DNS Definitions
                      (    ../defs/rbf.d):00147         *
                      (    ../defs/rbf.d):00148         
                      (    ../defs/rbf.d):00149         * If bit 7 of IT.TYP is set, IT.DNS is driver-dependent
                      (    ../defs/rbf.d):00150         
                      (    ../defs/rbf.d):00151         * IT.DNS bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (    ../defs/rbf.d):00152         DNS.FM              EQU       %00000000           Single-density (FM)
     0001             (    ../defs/rbf.d):00153         DNS.MFM             EQU       %00000001           Double-density (MFM)
     0000             (    ../defs/rbf.d):00154         DNS.STD             EQU       %00000000           Single track distance (48/135 tpi)
     0002             (    ../defs/rbf.d):00155         DNS.DTD             EQU       %00000010           Double track distance (96 tpi)
                      (    ../defs/rbf.d):00156         
                      (    ../defs/rbf.d):00157         * Added PHS,2005-05-31, as format seems to use these
     0000             (    ../defs/rbf.d):00158         DNS.FM0             EQU       %00000000           Single density track 0
     0004             (    ../defs/rbf.d):00159         DNS.MFM0            EQU       %00000100           Double density track 0
                      (    ../defs/rbf.d):00160         
                      (    ../defs/rbf.d):00161         * Floppy disk step rate definitions
     0000             (    ../defs/rbf.d):00162         STP.30ms            EQU       0                   30ms step rate
     0001             (    ../defs/rbf.d):00163         STP.20ms            EQU       1                   20ms step rate
     0002             (    ../defs/rbf.d):00164         STP.12ms            EQU       2                   12ms step rate
     0003             (    ../defs/rbf.d):00165         STP.6ms             EQU       3                   6ms step rate
                      (    ../defs/rbf.d):00166         
                      (    ../defs/rbf.d):00167                             PAG
                      (    ../defs/rbf.d):00168         *************************************
                      (    ../defs/rbf.d):00169         * Random Block Path Descriptor Format
                      (    ../defs/rbf.d):00170         *
                      (    ../defs/rbf.d):00171         * A path descriptor is created for every new path that is open
                      (    ../defs/rbf.d):00172         * via the I$Open system call (processed by IOMan).  Process
                      (    ../defs/rbf.d):00173         * descriptors track state information of a path.
                      (    ../defs/rbf.d):00174         *
                      (    ../defs/rbf.d):00175                             ORG       PD.FST
000A                  (    ../defs/rbf.d):00176         PD.SMF              RMB       1                   State flags
000B                  (    ../defs/rbf.d):00177         PD.CP               RMB       4                   Current logical byte position
000F                  (    ../defs/rbf.d):00178         PD.SIZ              RMB       4                   File size
0013                  (    ../defs/rbf.d):00179         PD.SBL              RMB       3                   Segment beginning lsn
0016                  (    ../defs/rbf.d):00180         PD.SBP              RMB       3                   Segment beginning psn
0019                  (    ../defs/rbf.d):00181         PD.SSZ              RMB       3                   Segment size
001C                  (    ../defs/rbf.d):00182         PD.DSK              RMB       2                   Disk id
001E                  (    ../defs/rbf.d):00183         PD.DTB              RMB       2                   Drive table ptr
                      (    ../defs/rbf.d):00184                             ORG       PD.OPT
0020                  (    ../defs/rbf.d):00185                             RMB       1                   Device type
0021                  (    ../defs/rbf.d):00186         PD.DRV              RMB       1                   Drive number
0022                  (    ../defs/rbf.d):00187         PD.STP              RMB       1                   Step rate
0023                  (    ../defs/rbf.d):00188         PD.TYP              RMB       1                   Disk device type (5" 8" other)
0024                  (    ../defs/rbf.d):00189         PD.DNS              RMB       1                   Density capability
0025                  (    ../defs/rbf.d):00190         PD.CYL              RMB       2                   Number of cylinders
0027                  (    ../defs/rbf.d):00191         PD.SID              RMB       1                   Number of surfaces
0028                  (    ../defs/rbf.d):00192         PD.VFY              RMB       1                   0=verify disk writes
0029                  (    ../defs/rbf.d):00193         PD.SCT              RMB       2                   Default sectors/track
002B                  (    ../defs/rbf.d):00194         PD.T0S              RMB       2                   Default sectors/track tr00,s0
002D                  (    ../defs/rbf.d):00195         PD.ILV              RMB       1                   Sector interleave offset
002E                  (    ../defs/rbf.d):00196         PD.SAS              RMB       1                   Segment allocation size
002F                  (    ../defs/rbf.d):00197         PD.TFM              RMB       1                   DMA Transfer Mode
0030                  (    ../defs/rbf.d):00198         PD.Exten            RMB       2                   Path Extension (PE) for record locking
0032                  (    ../defs/rbf.d):00199         PD.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
0033                  (    ../defs/rbf.d):00200         PD.ATT              RMB       1                   File attributes
0034                  (    ../defs/rbf.d):00201         PD.FD               RMB       3                   File descriptor psn (i.e. 3-byte inode number)
0037                  (    ../defs/rbf.d):00202         PD.DFD              RMB       3                   Directory file descriptor psn (i.e. 3-byte inode number)
003A                  (    ../defs/rbf.d):00203         PD.DCP              RMB       4                   File directory entry ptr
003E                  (    ../defs/rbf.d):00204         PD.DVT              RMB       2                   User readable dev tbl ptr
                      (    ../defs/rbf.d):00205         
                      (    ../defs/rbf.d):00206         * State Flags
     0001             (    ../defs/rbf.d):00207         BUFMOD              EQU       $01                 Buffer modified
     0002             (    ../defs/rbf.d):00208         SINBUF              EQU       $02                 Sector in buffer
     0004             (    ../defs/rbf.d):00209         FDBUF               EQU       $04                 File descriptor in buffer
                      (    ../defs/rbf.d):00210         *EOFSEC equ $08 End of file sector
                      (    ../defs/rbf.d):00211         *EOF equ $10 End of file
     0020             (    ../defs/rbf.d):00212         InDriver            EQU       $20                 Currently in Disk Driver, or queued
     0040             (    ../defs/rbf.d):00213         BufBusy             EQU       $40                 Buffer is currently busy
                      (    ../defs/rbf.d):00214         
                      (    ../defs/rbf.d):00215                             IFNE      Level-1
                      (    ../defs/rbf.d):00216         ************************************
                      (    ../defs/rbf.d):00217         * Random Block Path Extension Format
                      (    ../defs/rbf.d):00218         *
                      (    ../defs/rbf.d):00219         * RBF paths under Level Two have additional information that
                      (    ../defs/rbf.d):00220         * is referenced by the path extension area.  These are 64-byte
                      (    ../defs/rbf.d):00221         * allocs from the same table (D.PthDBT) as the Path Descriptors.
                      (    ../defs/rbf.d):00222         *
                      (    ../defs/rbf.d):00223                             ORG       0
0000                  (    ../defs/rbf.d):00224         PE.PE               RMB       1                   PE path number
0001                  (    ../defs/rbf.d):00225         PE.PDptr            RMB       2                   Back ptr to this PE's Path Descriptor
0003                  (    ../defs/rbf.d):00226         PE.NxFil            RMB       2                   Drive Open-File list ptr
0005                  (    ../defs/rbf.d):00227         PE.Confl            RMB       2                   Circular File Conflict list
0007                  (    ../defs/rbf.d):00228         PE.Lock             RMB       1                   Path lockout status
0008                  (    ../defs/rbf.d):00229         PE.LoLck            RMB       4                   Low Locked Logical addr
000C                  (    ../defs/rbf.d):00230         PE.HiLck            RMB       4                   High Locked Logical addr
0010                  (    ../defs/rbf.d):00231         PE.Wait             RMB       2                   PE ptr to (next) locked-out PE
0012                  (    ../defs/rbf.d):00232         PE.TmOut            RMB       2                   Max ticks to wait for locked segment
0014                  (    ../defs/rbf.d):00233         PE.Owner            RMB       1                   Process ID of owner of locked segment
0015                  (    ../defs/rbf.d):00234         PE.Req              RMB       1                   Temp for PE.Lock in GAIN when LockSeg fails
0016                  (    ../defs/rbf.d):00235         PE.Prior            RMB       1                   Temp for process priority while in driver
0017                  (    ../defs/rbf.d):00236         PE.SigSg            RMB       1                   Signal code to send
0018                  (    ../defs/rbf.d):00237         PE.SigID            RMB       1                   Process ID to send the signal to
0019                  (    ../defs/rbf.d):00238                             RMB       32-.                Reserved
0020                  (    ../defs/rbf.d):00239         PE.FilNm            RMB       32                  Temp for filename during directory search
                      (    ../defs/rbf.d):00240         
                      (    ../defs/rbf.d):00241         * PE.Lock status codes
     0000             (    ../defs/rbf.d):00242         Unlocked            EQU       0                   No portion of file is locked
     0001             (    ../defs/rbf.d):00243         RcdLock             EQU       1                   Record from LoLck to HiLck locked
     0002             (    ../defs/rbf.d):00244         FileLock            EQU       2                   Entire file locked
     0004             (    ../defs/rbf.d):00245         EofLock             EQU       4                   End of file is locked
                      (    ../defs/rbf.d):00246                             ENDC
                      (    ../defs/rbf.d):00247         
                      (    ../defs/rbf.d):00248         
                      (    ../defs/rbf.d):00249                             PAG
                      (    ../defs/rbf.d):00250         ***********************
                      (    ../defs/rbf.d):00251         * LSN0 Disk Data Format
                      (    ../defs/rbf.d):00252         *
                      (    ../defs/rbf.d):00253         * Logical Sector Number 0 is the first sector on an RBF formatted device
                      (    ../defs/rbf.d):00254         * and contains information about the device's size and format.
                      (    ../defs/rbf.d):00255         *
                      (    ../defs/rbf.d):00256                             ORG       0
0000                  (    ../defs/rbf.d):00257         DD.TOT              RMB       3                   Total number of sectors
0003                  (    ../defs/rbf.d):00258         DD.TKS              RMB       1                   Track size in sectors
0004                  (    ../defs/rbf.d):00259         DD.MAP              RMB       2                   Number of bytes in allocation bit map
0006                  (    ../defs/rbf.d):00260         DD.BIT              RMB       2                   Number of sectors/bit
0008                  (    ../defs/rbf.d):00261         DD.DIR              RMB       3                   Address of root directory fd
000B                  (    ../defs/rbf.d):00262         DD.OWN              RMB       2                   Owner
000D                  (    ../defs/rbf.d):00263         DD.ATT              RMB       1                   Attributes
000E                  (    ../defs/rbf.d):00264         DD.DSK              RMB       2                   Disk ID
0010                  (    ../defs/rbf.d):00265         DD.FMT              RMB       1                   Disk format; density/sides
0011                  (    ../defs/rbf.d):00266         DD.SPT              RMB       2                   Sectors/track
0013                  (    ../defs/rbf.d):00267         DD.RES              RMB       2                   Reserved for future use
     0015             (    ../defs/rbf.d):00268         DD.SIZ              EQU       .                   Device descriptor minimum size
0015                  (    ../defs/rbf.d):00269         DD.BT               RMB       3                   System bootstrap sector
0018                  (    ../defs/rbf.d):00270         DD.BSZ              RMB       2                   Size of system bootstrap
001A                  (    ../defs/rbf.d):00271         DD.DAT              RMB       5                   Creation date
001F                  (    ../defs/rbf.d):00272         DD.NAM              RMB       32                  Volume name
003F                  (    ../defs/rbf.d):00273         DD.OPT              RMB       32                  Option area
                      (    ../defs/rbf.d):00274         
                      (    ../defs/rbf.d):00275         *************************
                      (    ../defs/rbf.d):00276         * 2012/11/09 Gene Heskett - Some additions for bootlink etc use.
                      (    ../defs/rbf.d):00277                             ORG       $60                 More options from device descriptor
0060                  (    ../defs/rbf.d):00278         VD.STP              RMB       1                   This is for the /sh and /ih virtual disks in HDBDOS
0061                  (    ../defs/rbf.d):00279         VD.OFS              RMB       3                   This is DT.WPC and DT.OSF combined, might be more
                      (    ../defs/rbf.d):00280         
                      (    ../defs/rbf.d):00281         * DD.FMT Bit Definitions - valid only if device is a floppy disk
     0001             (    ../defs/rbf.d):00282         FMT.SIDE            EQU       %00000001           Single Sided=0, Double Sided=1
     0002             (    ../defs/rbf.d):00283         FMT.DNS             EQU       %00000010           Single Density=0, Double Density=1
     0004             (    ../defs/rbf.d):00284         FMT.TDNS            EQU       %00000100           Track Density: 48/135 TPI=0, 96 TPI=1
     0020             (    ../defs/rbf.d):00285         FMT.T0DN            EQU       %00100000           Track 0 Density, see FMT.DNS
                      (    ../defs/rbf.d):00286         
                      (    ../defs/rbf.d):00287         
                      (    ../defs/rbf.d):00288                             PAG
                      (    ../defs/rbf.d):00289         ************************
                      (    ../defs/rbf.d):00290         * File Descriptor Format
                      (    ../defs/rbf.d):00291         *
                      (    ../defs/rbf.d):00292         * The file descriptor is a sector that is present for every file
                      (    ../defs/rbf.d):00293         * on an RBF device.  It contains attributes, modification dates,
                      (    ../defs/rbf.d):00294         * and segment information on a file.
                      (    ../defs/rbf.d):00295         *
                      (    ../defs/rbf.d):00296                             ORG       0
0000                  (    ../defs/rbf.d):00297         FD.ATT              RMB       1                   Attributes
0001                  (    ../defs/rbf.d):00298         FD.OWN              RMB       2                   Owner
0003                  (    ../defs/rbf.d):00299         FD.DAT              RMB       5                   Date last modified
0008                  (    ../defs/rbf.d):00300         FD.LNK              RMB       1                   Link count
0009                  (    ../defs/rbf.d):00301         FD.SIZ              RMB       4                   File size
000D                  (    ../defs/rbf.d):00302         FD.Creat            RMB       3                   File creation date (YY/MM/DD)
     0010             (    ../defs/rbf.d):00303         FD.SEG              EQU       .                   Beginning of segment list
                      (    ../defs/rbf.d):00304         * Segment List Entry Format
                      (    ../defs/rbf.d):00305                             ORG       0
0000                  (    ../defs/rbf.d):00306         FDSL.A              RMB       3                   Segment beginning physical sector number
0003                  (    ../defs/rbf.d):00307         FDSL.B              RMB       2                   Segment size
     0005             (    ../defs/rbf.d):00308         FDSL.S              EQU       .                   Segment list entry size
     00FB             (    ../defs/rbf.d):00309         FD.LS1              EQU       FD.SEG+((256-FD.SEG)/FDSL.S-1)*FDSL.S
     00FA             (    ../defs/rbf.d):00310         FD.LS2              EQU       (256/FDSL.S-1)*FDSL.S
     0010             (    ../defs/rbf.d):00311         MINSEC              SET       16
                      (    ../defs/rbf.d):00312         
                      (    ../defs/rbf.d):00313         
                      (    ../defs/rbf.d):00314                             PAG
                      (    ../defs/rbf.d):00315         ************************
                      (    ../defs/rbf.d):00316         * Directory Entry Format
                      (    ../defs/rbf.d):00317         *
                      (    ../defs/rbf.d):00318         * Directory entries are part of a directory and define the name
                      (    ../defs/rbf.d):00319         * of the file, as well as a pointer to its file descriptor.
                      (    ../defs/rbf.d):00320         *
                      (    ../defs/rbf.d):00321                             ORG       0
0000                  (    ../defs/rbf.d):00322         DIR.NM              RMB       29                  File name
001D                  (    ../defs/rbf.d):00323         DIR.FD              RMB       3                   File descriptor physical sector number
     0020             (    ../defs/rbf.d):00324         DIR.SZ              EQU       .                   Directory record size
                      (    ../defs/rbf.d):00325         
                      (    ../defs/rbf.d):00326         
                      (    ../defs/rbf.d):00327                             PAG
                      (    ../defs/rbf.d):00328         ********************
                      (    ../defs/rbf.d):00329         * RBF Static Storage
                      (    ../defs/rbf.d):00330         *
                      (    ../defs/rbf.d):00331         * Overall Disk Static Storage
                      (    ../defs/rbf.d):00332         *
                      (    ../defs/rbf.d):00333         * Note:  This does not reserve any memory for drive tables.  Each
                      (    ../defs/rbf.d):00334         *        driver is responsible for reserving sufficient memory for
                      (    ../defs/rbf.d):00335         *        the appropriate number of tables.
                      (    ../defs/rbf.d):00336         *
                      (    ../defs/rbf.d):00337                             ORG       V.USER              Reserve required           ($06)
0006                  (    ../defs/rbf.d):00338         V.NDRV              RMB       1                   Number of drives           ($07)
0007                  (    ../defs/rbf.d):00339                             RMB       8                   reserved                   ($08)
     000F             (    ../defs/rbf.d):00340         DRVBEG              EQU       .                   Beginning of drive tables  ($10)
                      (    ../defs/rbf.d):00341         
                      (    ../defs/rbf.d):00342         
                      (    ../defs/rbf.d):00343                             PAG
                      (    ../defs/rbf.d):00344         ****************
                      (    ../defs/rbf.d):00345         * Global Storage For Disk Drive Tables
                      (    ../defs/rbf.d):00346         *
                      (    ../defs/rbf.d):00347         * Each table contains the first 'DD.SIZ' bytes from
                      (    ../defs/rbf.d):00348         * LSN 0, and the current track, stepping rate,
                      (    ../defs/rbf.d):00349         * bitmap use flag, and disk type.
                      (    ../defs/rbf.d):00350         *
                      (    ../defs/rbf.d):00351                             ORG       0
0000                  (    ../defs/rbf.d):00352                             RMB       DD.SIZ              Device descriptor, LSN 0
0015                  (    ../defs/rbf.d):00353         V.TRAK              RMB       2                   Current track
0017                  (    ../defs/rbf.d):00354         V.BMB               RMB       1                   Bit-map use flag
0018                  (    ../defs/rbf.d):00355         V.FileHd            RMB       2                   Open file list for this drive
001A                  (    ../defs/rbf.d):00356         V.DiskID            RMB       2                   Disk ID
001C                  (    ../defs/rbf.d):00357         V.BMapSz            RMB       1                   Bitmap Size
001D                  (    ../defs/rbf.d):00358         V.MapSct            RMB       1                   Lowest reasonable bitmap sector
001E                  (    ../defs/rbf.d):00359         V.ResBit            RMB       1                   Reserved bitmap sector (for compaction)
001F                  (    ../defs/rbf.d):00360         V.ScTkOf            RMB       1                   Sector/Track byte (Combined from descriptor)
0020                  (    ../defs/rbf.d):00361         V.ScOfst            RMB       1                   Sector offset split from byte above
0021                  (    ../defs/rbf.d):00362         V.TkOfst            RMB       1                   Track offset split from byte above
0022                  (    ../defs/rbf.d):00363                             RMB       4                   Reserved
     0026             (    ../defs/rbf.d):00364         DRVMEM              EQU       .
                      (    ../defs/rbf.d):00365         
                      (    ../defs/rbf.d):00366                             ENDC
                      (    ../defs/rbf.d):00367         
                      (     sys6809l2.as):00010                             use       ../defs/scf.d
                      (    ../defs/scf.d):00001                             IFNE      SCF.D-1
                      (    ../defs/scf.d):00002         
     0001             (    ../defs/scf.d):00003         SCF.D               SET       1
                      (    ../defs/scf.d):00004         
                      (    ../defs/scf.d):00005         ********************************************************************
                      (    ../defs/scf.d):00006         * scf.d - Sequential Character File Manager Definitions
                      (    ../defs/scf.d):00007         *
                      (    ../defs/scf.d):00008         * SCF stands for 'Sequential Character Filemanager' and is a package of subroutines
                      (    ../defs/scf.d):00009         * that define the logical structure of a serial device.
                      (    ../defs/scf.d):00010         *
                      (    ../defs/scf.d):00011         * The data structures in this file give SCF its 'personality' and are used
                      (    ../defs/scf.d):00012         * by SCF itself, as well as applications that will require disk I/O.
                      (    ../defs/scf.d):00013         *
                      (    ../defs/scf.d):00014         * Edt/Rev  YYYY/MM/DD  Modified by
                      (    ../defs/scf.d):00015         * Comment
                      (    ../defs/scf.d):00016         * ------------------------------------------------------------------
                      (    ../defs/scf.d):00017         *          1984/01/11  YO
                      (    ../defs/scf.d):00018         * Added V.KANJI, V.KBUF, V.MODADR for new kanji input process.
                      (    ../defs/scf.d):00019         *
                      (    ../defs/scf.d):00020         *          1985/04/20  Mark G. Hawkins
                      (    ../defs/scf.d):00021         * Added V.PDLHd Path Descriptor List Head.
                      (    ../defs/scf.d):00022         *
                      (    ../defs/scf.d):00023         *          1985/04/21  Mark G. Hawkins
                      (    ../defs/scf.d):00024         * Added PD.PLP and PD.PST for modem handling.
                      (    ../defs/scf.d):00025         *
                      (    ../defs/scf.d):00026         *          1987/06/23  Kevin K. Darling
                      (    ../defs/scf.d):00027         * Updated with Dev Desc info.
                      (    ../defs/scf.d):00028         *
                      (    ../defs/scf.d):00029         *          1998/10/03  Boisy G. Pitre
                      (    ../defs/scf.d):00030         * Consolidated L1/L2 scfdefs.
                      (    ../defs/scf.d):00031         *
                      (    ../defs/scf.d):00032         *          2003/01/21  Boisy G. Pitre
                      (    ../defs/scf.d):00033         * Added symbolics for enhanced SCF line editing.
                      (    ../defs/scf.d):00034         *
                      (    ../defs/scf.d):00035         *          2003/06/02  Boisy G. Pitre
                      (    ../defs/scf.d):00036         * Updated comments for clarity.
                      (    ../defs/scf.d):00037         *
                      (    ../defs/scf.d):00038         *          2004/05/17  Boisy G. Pitre
                      (    ../defs/scf.d):00039         * Added higher baud rates.
                      (    ../defs/scf.d):00040         
                      (    ../defs/scf.d):00041                             NAM       scf.d
                      (    ../defs/scf.d):00042                             TTL       Sequential          File Manager Definitions
                      (    ../defs/scf.d):00043         
                      (    ../defs/scf.d):00044                             PAG
                      (    ../defs/scf.d):00045         *******************************
                      (    ../defs/scf.d):00046         * SCF Device Descriptor Offsets
                      (    ../defs/scf.d):00047         *
                      (    ../defs/scf.d):00048         * These definitions are for SCF device descriptors.
                      (    ../defs/scf.d):00049         
                      (    ../defs/scf.d):00050                             ORG       M$DTyp
0012                  (    ../defs/scf.d):00051         IT.DVC              RMB       1                   Device type (DT.SCF)
0013                  (    ../defs/scf.d):00052         IT.UPC              RMB       1                   Uppercase flag
0014                  (    ../defs/scf.d):00053         IT.BSO              RMB       1                   Backspace behavior
0015                  (    ../defs/scf.d):00054         IT.DLO              RMB       1                   Delete behavior
0016                  (    ../defs/scf.d):00055         IT.EKO              RMB       1                   Echo flag
0017                  (    ../defs/scf.d):00056         IT.ALF              RMB       1                   Auto linefeed flag
0018                  (    ../defs/scf.d):00057         IT.NUL              RMB       1                   End-of-line null count
0019                  (    ../defs/scf.d):00058         IT.PAU              RMB       1                   Page pause flag
001A                  (    ../defs/scf.d):00059         IT.PAG              RMB       1                   Number of lines per page
001B                  (    ../defs/scf.d):00060         IT.BSP              RMB       1                   Backspace character
001C                  (    ../defs/scf.d):00061         IT.DEL              RMB       1                   Delete-line character
001D                  (    ../defs/scf.d):00062         IT.EOR              RMB       1                   End-of-record character
001E                  (    ../defs/scf.d):00063         IT.EOF              RMB       1                   End-of-file character
001F                  (    ../defs/scf.d):00064         IT.RPR              RMB       1                   Reprint-line character
0020                  (    ../defs/scf.d):00065         IT.DUP              RMB       1                   Duplicate-last-line character
0021                  (    ../defs/scf.d):00066         IT.PSC              RMB       1                   Pause character
0022                  (    ../defs/scf.d):00067         IT.INT              RMB       1                   Interrupt character
0023                  (    ../defs/scf.d):00068         IT.QUT              RMB       1                   Quit character
0024                  (    ../defs/scf.d):00069         IT.BSE              RMB       1                   Backspace echo character
0025                  (    ../defs/scf.d):00070         IT.OVF              RMB       1                   Bell character
0026                  (    ../defs/scf.d):00071         IT.PAR              RMB       1                   Parity
0027                  (    ../defs/scf.d):00072         IT.BAU              RMB       1                   Baud rate
0028                  (    ../defs/scf.d):00073         IT.D2P              RMB       2                   Attached device name string offset
002A                  (    ../defs/scf.d):00074         IT.XON              RMB       1                   X-ON character
002B                  (    ../defs/scf.d):00075         IT.XOFF             RMB       1                   X-OFF character
002C                  (    ../defs/scf.d):00076         IT.COL              RMB       1                   Number of columns for display
002D                  (    ../defs/scf.d):00077         IT.ROW              RMB       1                   Number of rows for display
002E                  (    ../defs/scf.d):00078         IT.XTYP             RMB       1                   Extended type (added by BRI)
                      (    ../defs/scf.d):00079         
                      (    ../defs/scf.d):00080                             IFGT      Level-1
                      (    ../defs/scf.d):00081         * Window Descriptor Additions
                      (    ../defs/scf.d):00082         * For CoCo window, where IT.PAR = $80
                      (    ../defs/scf.d):00083                             ORG       IT.ROW+1
002E                  (    ../defs/scf.d):00084         IT.WND              RMB       1                   Window number (matches device name) ($2E)
002F                  (    ../defs/scf.d):00085         IT.VAL              RMB       1                   Use defaults on Init (0=no, 1=yes)
0030                  (    ../defs/scf.d):00086         IT.STY              RMB       1                   Screen type default
0031                  (    ../defs/scf.d):00087         IT.CPX              RMB       1                   Column start default
0032                  (    ../defs/scf.d):00088         IT.CPY              RMB       1                   Row start default
0033                  (    ../defs/scf.d):00089         IT.FGC              RMB       1                   Foreground color default
0034                  (    ../defs/scf.d):00090         IT.BGC              RMB       1                   Background color default
0035                  (    ../defs/scf.d):00091         IT.BDC              RMB       1                   Border color default
                      (    ../defs/scf.d):00092                             ENDC
