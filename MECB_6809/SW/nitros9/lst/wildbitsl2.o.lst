                      (./defs/wildbits.d):00802                            org        $0
0000                  (./defs/wildbits.d):00803         MIDI_STATUS        rmb        1                   Read: Bit[1] = Rx_empty, Bit[2] = Tx_empty
0001                  (./defs/wildbits.d):00804         MIDI_FIFO_DATA     rmb        1                   Read and Write Data Port 
0002                  (./defs/wildbits.d):00805         MIDI_RXD_COUNT_LOW rmb        1                   Rx FIFO Data Count LOW
0003                  (./defs/wildbits.d):00806         MIDI_RXD_COUNT_HI  rmb        1                   Rx FIFO Data Count Hi - Only the 4 first bit are valid
0004                  (./defs/wildbits.d):00807         MIDI_TXD_COUNT_LOW rmb        1                   Tx FIFO Data Count LOW 
0005                  (./defs/wildbits.d):00808         MIDI_TXD_COUNT_HI  rmb        1                   Tx FIFO Data Count Hi - Only the 4 first bit are valid
