                      (./defs/wildbits.d):00564         * vtio graphics constants
                      (./defs/wildbits.d):00565         ********************************************************************
                      (./defs/wildbits.d):00566         * Constants used in SS.DScrn to set the display screen type
                      (./defs/wildbits.d):00567         
     0040             (./defs/wildbits.d):00568         FX_GAM             equ       %01000000              Gamma Correction On
     0020             (./defs/wildbits.d):00569         FX_SPR             equ       %00100000              Sprites On
     0010             (./defs/wildbits.d):00570         FX_TIL             equ       %00010000              Tile Maps On
     0008             (./defs/wildbits.d):00571         FX_BM              equ       %00001000              Bitmaps On
     0004             (./defs/wildbits.d):00572         FX_GRF             equ       %00000100              Graphics Mode On
     0002             (./defs/wildbits.d):00573         FX_OVR             equ       %00000010              Overlay Text on Graphics
     0001             (./defs/wildbits.d):00574         FX_TXT             equ       %00000001              Text Mode On
     0020             (./defs/wildbits.d):00575         FT_FSET            equ       %00100000              Font Set 1 On (0=Font Set 0)
     0010             (./defs/wildbits.d):00576         FT_FOVR            equ       %00010000              FG and BG colors displayed when overlay text 0=transparent
     0008             (./defs/wildbits.d):00577         FT_MON             equ       %00001000              Turn off monitor sync and sleep monitor
     0004             (./defs/wildbits.d):00578         FT_DBX             equ       %00000100              Double-wide text mode characters
     0002             (./defs/wildbits.d):00579         FT_DBY             equ       %00000010              Double-high text mode characters
     0001             (./defs/wildbits.d):00580         FT_CLK70           equ       %00000001              70 Hz screen (640x400 txt,320x200 grf)
     00FF             (./defs/wildbits.d):00581         FX_OMIT            equ       %11111111              Setting for SS.DScrn don't change first byte in MCR
     00FF             (./defs/wildbits.d):00582         FT_OMIT            equ       %11111111              Setting for SS.DScrn don't change second byte in MCR
                      (./defs/wildbits.d):00583         
                      (./defs/wildbits.d):00584         * FT_FOVR:  0=display only FG color, all others transparent
                      (./defs/wildbits.d):00585         *           1=display FG & BG color, only BG color 0 is transparent
                      (./defs/wildbits.d):00586         * CLK_70:   0=60 Hz screen (640x480 txt, 320x240 grf)
                      (./defs/wildbits.d):00587         *           0=70 Hz screen (640x400 txt, 32
                      (./defs/wildbits.d):00588         **  END OF DUPLICATE CONSTANTS
