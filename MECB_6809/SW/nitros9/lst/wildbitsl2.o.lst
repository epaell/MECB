     0001             (    ../defs/os9.d):00311         READ.               EQU       %00000001
     0002             (    ../defs/os9.d):00312         WRITE.              EQU       %00000010
     0003             (    ../defs/os9.d):00313         UPDAT.              EQU       READ.+WRITE.
     0004             (    ../defs/os9.d):00314         EXEC.               EQU       %00000100
     0008             (    ../defs/os9.d):00315         PREAD.              EQU       %00001000
     0010             (    ../defs/os9.d):00316         PWRIT.              EQU       %00010000
     0020             (    ../defs/os9.d):00317         PEXEC.              EQU       %00100000
     0040             (    ../defs/os9.d):00318         SHARE.              EQU       %01000000
     0080             (    ../defs/os9.d):00319         DIR.                EQU       %10000000
     0020             (    ../defs/os9.d):00320         ISIZ.               EQU       %00100000
