                      (s/wildbits_vtio.d):00004         ********************************************************************
                      (s/wildbits_vtio.d):00005         * vtio definitions for the Wildbits 6809
                      (s/wildbits_vtio.d):00006         *
                      (s/wildbits_vtio.d):00007         * Everything that the vtio driver needs is defined here, including
                      (s/wildbits_vtio.d):00008         * static memory definitions.
                      (s/wildbits_vtio.d):00009         
                      (s/wildbits_vtio.d):00010         * Constant definitions.
     0008             (s/wildbits_vtio.d):00011         KBufSz              EQU       8                   the circular buffer size
                      (s/wildbits_vtio.d):00012         
                      (s/wildbits_vtio.d):00013         * Driver static memory.
                      (s/wildbits_vtio.d):00014                             ORG       V.SCF
001D                  (s/wildbits_vtio.d):00015         V.CurRow            RMB       1                   current row where the next character goes
001E                  (s/wildbits_vtio.d):00016         V.CurCol            RMB       1                   current column where the next character goes
001F                  (s/wildbits_vtio.d):00017         V.CapsLck           RMB       1                   CAPS LOCK key up/down flag ($00 = up)
0020                  (s/wildbits_vtio.d):00018         V.KySns             RMB       1                   key sense flags
0021                  (s/wildbits_vtio.d):00019         V.LastCh            RMB       1                   Last character for key repeat
0022                  (s/wildbits_vtio.d):00020         V.CurLastCh         RMB       1
0023                  (s/wildbits_vtio.d):00021         V.KRTimer           RMB       1                   Key Repeat Timer
0024                  (s/wildbits_vtio.d):00022         V.LEDStates         RMB       1                   PS/2 LED flags (bit 2 = CAPS Lock, bit 1 = NUM Lock, bit 0 = Scroll Lock)
0025                  (s/wildbits_vtio.d):00023         V.EscVect           RMB       2                   escape vector handle
0027                  (s/wildbits_vtio.d):00024         V.Reverse           RMB       1                   reverse video flag ($00 = off, $FF = on)
0028                  (s/wildbits_vtio.d):00025         V.IBufH             RMB       1                   input buffer head pointer
0029                  (s/wildbits_vtio.d):00026         V.IBufT             RMB       1                   input buffer tail pointer
002A                  (s/wildbits_vtio.d):00027         V.SSigID            RMB       1                   data ready process ID
002B                  (s/wildbits_vtio.d):00028         V.SSigSg            RMB       1                   data ready signal code
002C                  (s/wildbits_vtio.d):00029         V.ScTyp             RMB       1                   screen type
002D                  (s/wildbits_vtio.d):00030         V.WWidth            RMB       1                   window width
002E                  (s/wildbits_vtio.d):00031         V.WHeight           RMB       1                   window height
002F                  (s/wildbits_vtio.d):00032         V.FBCol             RMB       1                   currently selected foreground and background color
0030                  (s/wildbits_vtio.d):00033         V.BordCol           RMB       1                   currently selected border color
0031                  (s/wildbits_vtio.d):00034         V.KeyDrvMPtr        RMB       2                   keydrv module address
0033                  (s/wildbits_vtio.d):00035         V.KeyDrvEPtr        RMB       2                   keydrv entry point address
                      (s/wildbits_vtio.d):00036                             ifgt      Level-1
0035                  (s/wildbits_vtio.d):00037         V.MSDrvMPtr         RMB       2                   mouse module address
0037                  (s/wildbits_vtio.d):00038         V.MSDrvEPtr         RMB       2                   mouse entry point address
0039                  (s/wildbits_vtio.d):00039         V.MouseVect         RMB       2
003B                  (s/wildbits_vtio.d):00040         V.MSButtons         RMB       1                   keeps the buttons for the SetStat call
003C                  (s/wildbits_vtio.d):00041         V.MSTimer           RMB       1                   this hides the cursor if inactive for more than 4 seconds
003D                  (s/wildbits_vtio.d):00042         V.MEMP              RMB       1                   Code to check PS2_STAT for empty buffer (channel 1 or 2)
003E                  (s/wildbits_vtio.d):00043         V.MS_IN             RMB       2                   Address of Channel 1 or 2
0040                  (s/wildbits_vtio.d):00044         V.M_WR              RMB       1                   PS2 Control Write Channel
0041                  (s/wildbits_vtio.d):00045         V.MCLR              RMB       1                   PS2 Clear FIFO Channel 1 or 2
0042                  (s/wildbits_vtio.d):00046         V.INT_PS2_MOUSE     RMB       1                   Interrupt Flag for Channel 1 or 2
0043                  (s/wildbits_vtio.d):00047         V.MSByte0           RMB       1                   mouse packet byte 1
0044                  (s/wildbits_vtio.d):00048         V.MSByte1           RMB       1                   mouse packet byte 2
0045                  (s/wildbits_vtio.d):00049         V.MSByte2           RMB       1                   mouse packet byte 3
0046                  (s/wildbits_vtio.d):00050         V.MSByteCnt         RMB       1                   mouse packet byte counter
                      (s/wildbits_vtio.d):00051                             endc
     0047             (s/wildbits_vtio.d):00052         V.KeyDrvStat        equ       .
0047                  (s/wildbits_vtio.d):00053                             RMB       8
                      (s/wildbits_vtio.d):00054         
004F                  (s/wildbits_vtio.d):00055         V.EscParms          RMB       20
                      (s/wildbits_vtio.d):00056         * DWSet Parameters
     004F             (s/wildbits_vtio.d):00057         V.DWType            set       V.EscParms+0
     0050             (s/wildbits_vtio.d):00058         V.DWStartX          set       V.EscParms+1
     0051             (s/wildbits_vtio.d):00059         V.DWStartY          set       V.EscParms+2
     0052             (s/wildbits_vtio.d):00060         V.DWWidth           set       V.EscParms+3
     0053             (s/wildbits_vtio.d):00061         V.DWHeight          set       V.EscParms+4
     0054             (s/wildbits_vtio.d):00062         V.DWFore            set       V.EscParms+5
     0055             (s/wildbits_vtio.d):00063         V.DWBack            set       V.EscParms+6
     0056             (s/wildbits_vtio.d):00064         V.DWBorder          set       V.EscParms+7
                      (s/wildbits_vtio.d):00065         
