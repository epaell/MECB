                      (./defs/wildbits.d):00270         * Mouse definitions
                      (./defs/wildbits.d):00271         * $FEA0-$FEAF
                      (./defs/wildbits.d):00272         * Mouse Mode is bit 1 of MS_MEM (Mouse Mode-Enable)
                      (./defs/wildbits.d):00273         * 0=System handles x/y  1=harware interprets PS/2 packets
                      (./defs/wildbits.d):00274         * Enable is bit 0.  1=show mouse pointer 0 = hide mouse pointer
     FEA0             (./defs/wildbits.d):00275         MS_MEN              equ       $FEA0     mouse mode-enable
     FEA2             (./defs/wildbits.d):00276         MS_XH               equ       $FEA2     mouse x low byte
     FEA3             (./defs/wildbits.d):00277         MS_XL               equ       $FEA3     mouse x high byte           
     FEA4             (./defs/wildbits.d):00278         MS_YH               equ       $FEA4     mouse y low byte
     FEA5             (./defs/wildbits.d):00279         MS_YL               equ       $FEA5     mouse y high byte
     FEA6             (./defs/wildbits.d):00280         MS_PS2B0            equ       $FEA6     mouse PS/2 Byte 0
     FEA7             (./defs/wildbits.d):00281         MS_PS2B1            equ       $FEA7     mouse PS/2 Byte 1
     FEA8             (./defs/wildbits.d):00282         MS_PS2B2            equ       $FEA8     mouse PS/2 Byte 2
     0028             (./defs/wildbits.d):00283         MS_SRATE            equ       $28       mouse sample rate $A,$14,$28,$3C,$50,$64,$C8
                      (./defs/wildbits.d):00284         
