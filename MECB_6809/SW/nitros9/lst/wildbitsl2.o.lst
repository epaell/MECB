                      (    wildbitsl2.as):00002         
                      (    wildbitsl2.as):00003                        section                       _constant
                      (    wildbitsl2.as):00004         
                      (    wildbitsl2.as):00005                        use       ../defs/wildbits.d
                      (./defs/wildbits.d):00001                           IFNE    WILDBITS.D-1
     0001             (./defs/wildbits.d):00002         WILDBITS.D              set       1
                      (./defs/wildbits.d):00003         
                      (./defs/wildbits.d):00004         ********************************************************************
                      (./defs/wildbits.d):00005         * WildbitsDefs - NitrOS-9 System Definitions for the Wildbits 6809
                      (./defs/wildbits.d):00006         *
                      (./defs/wildbits.d):00007         * This is a high level view of the memory map as setup by
                      (./defs/wildbits.d):00008         * NitrOS-9.
                      (./defs/wildbits.d):00009         *
                      (./defs/wildbits.d):00010         *     $0000----> ==================================
                      (./defs/wildbits.d):00011         *               |                                  |
                      (./defs/wildbits.d):00012         *               |      NitrOS-9 Globals/Stack      |
                      (./defs/wildbits.d):00013         *               |                                  |
                      (./defs/wildbits.d):00014         *     $0500---->|==================================|
                      (./defs/wildbits.d):00015         *               |                                  |
                      (./defs/wildbits.d):00016         *                 . . . . . . . . . . . . . . . . .
                      (./defs/wildbits.d):00017         *               |                                  |
                      (./defs/wildbits.d):00018         *               |   RAM available for allocation   |
                      (./defs/wildbits.d):00019         *               |       by NitrOS-9 and Apps       |
                      (./defs/wildbits.d):00020         *               |                                  |
                      (./defs/wildbits.d):00021         *                 . . . . . . . . . . . . . . . . .
                      (./defs/wildbits.d):00022         *               |                                  |
                      (./defs/wildbits.d):00023         *     $FD00---->|==================================|
                      (./defs/wildbits.d):00024         *               |    Constant RAM (for Level 2)    |
                      (./defs/wildbits.d):00025         *     $FE00---->|==================================|
                      (./defs/wildbits.d):00026         *               |                I/O               |
                      (./defs/wildbits.d):00027         *               |            &  Vectors            |
                      (./defs/wildbits.d):00028         *                ==================================
                      (./defs/wildbits.d):00029         *
                      (./defs/wildbits.d):00030         * Edt/Rev  YYYY/MM/DD  Modified by
                      (./defs/wildbits.d):00031         * Comment
                      (./defs/wildbits.d):00032         * ------------------------------------------------------------------
                      (./defs/wildbits.d):00033         *          2023/02/07  Boisy G. Pitre
                      (./defs/wildbits.d):00034         * Started.
                      (./defs/wildbits.d):00035         *
                      (./defs/wildbits.d):00036         *          2023/08/16  Boisy G. Pitre
                      (./defs/wildbits.d):00037         * Modified to address new memory map that Stefany created.
                      (./defs/wildbits.d):00038         
                      (./defs/wildbits.d):00039         ********************************************************************
                      (./defs/wildbits.d):00040         * Ticks per second.
                      (./defs/wildbits.d):00041         *
     003C             (./defs/wildbits.d):00042         TkPerSec            set       60
                      (./defs/wildbits.d):00043         
                      (./defs/wildbits.d):00044                           IFEQ    Level-1
                      (./defs/wildbits.d):00045         
                      (./defs/wildbits.d):00046         ********************************************************************
                      (./defs/wildbits.d):00047         *
                      (./defs/wildbits.d):00048         * NitrOS-9 Level 1 Section
                      (./defs/wildbits.d):00049         *
                      (./defs/wildbits.d):00050         ********************************************************************
                      (./defs/wildbits.d):00051         
                      (./defs/wildbits.d):00052         ********************************************************************
                      (./defs/wildbits.d):00053         * Boot definitions for NitrOS-9 Level 1
                      (./defs/wildbits.d):00054         *
                      (./defs/wildbits.d):00055         * These definitions are not strictly for 'Boot', but are for booting the
                      (./defs/wildbits.d):00056         * system.
                      (./defs/wildbits.d):00057         *
0000                  (./defs/wildbits.d):00058         HW.Page             set       $FF       device descriptor hardware page
                      (./defs/wildbits.d):00059         
                      (./defs/wildbits.d):00060                           ELSE
                      (./defs/wildbits.d):00061         
     0007             (./defs/wildbits.d):00062         HW.Page             set       $07       device descriptor hardware page
     EE00             (./defs/wildbits.d):00063         Bt.Start            set       $EE00     start address of where KRN is in memory
                      (./defs/wildbits.d):00064         
                      (./defs/wildbits.d):00065         *************************************************
                      (./defs/wildbits.d):00066         *
                      (./defs/wildbits.d):00067         * NitrOS-9 Level 2 Section
                      (./defs/wildbits.d):00068         *
                      (./defs/wildbits.d):00069         *************************************************
                      (./defs/wildbits.d):00070         
                      (./defs/wildbits.d):00071         ****************************************
                      (./defs/wildbits.d):00072         * Dynamic Address Translator Definitions
                      (./defs/wildbits.d):00073         *
     0008             (./defs/wildbits.d):00074         DAT.BlCt            EQU       8         DAT blocks/address space
     2000             (./defs/wildbits.d):00075         DAT.BlSz            EQU       (256/DAT.BlCt)*256 DAT block size
     0010             (./defs/wildbits.d):00076         DAT.ImSz            EQU       DAT.BlCt*2 DAT image size
     FFE0             (./defs/wildbits.d):00077         DAT.Addr            EQU       -(DAT.BlSz/256) DAT MSB address bits
     FFA0             (./defs/wildbits.d):00078         DAT.Task            EQU       $FFA0     task register address
     0020             (./defs/wildbits.d):00079         DAT.TkCt            EQU       32        number of DAT tasks
     FFA8             (./defs/wildbits.d):00080         DAT.Regs            EQU       $FFA8     DAT block registers base address
     333E             (./defs/wildbits.d):00081         DAT.Free            EQU       $333E     free block number
     003F             (./defs/wildbits.d):00082         DAT.BlMx            EQU       $3F       maximum block number
     0040             (./defs/wildbits.d):00083         DAT.BMSz            EQU       $40       memory block map size
     0000             (./defs/wildbits.d):00084         DAT.WrPr            EQU       0         no write protect
     0000             (./defs/wildbits.d):00085         DAT.WrEn            EQU       0         no write enable
     0000             (./defs/wildbits.d):00086         SysTask             EQU       0         CoCo system task number
     003F             (./defs/wildbits.d):00087         IOBlock             EQU       $3F
     003F             (./defs/wildbits.d):00088         ROMBlock            EQU       $3F
     007F             (./defs/wildbits.d):00089         IOAddr              EQU       $7F
     0001             (./defs/wildbits.d):00090         ROMCount            EQU       1         number of blocks of ROM (high RAM block)
     0001             (./defs/wildbits.d):00091         RAMCount            EQU       1         initial blocks of RAM
     0005             (./defs/wildbits.d):00092         MoveBlks            EQU       DAT.BlCt-ROMCount-2 block numbers used for copies
     0001             (./defs/wildbits.d):00093         BlockTyp            EQU       1         check only first bytes of RAM block
     0002             (./defs/wildbits.d):00094         ByteType            EQU       2         check entire block of RAM
     0001             (./defs/wildbits.d):00095         Limited             EQU       1         check only upper memory for ROM modules
     0002             (./defs/wildbits.d):00096         UnLimitd            EQU       2         check all NotRAM for modules
                      (./defs/wildbits.d):00097         * NOTE: this check assumes any NotRAM with a module will
                      (./defs/wildbits.d):00098         *       always start with $87CD in first two bytes of block
     0001             (./defs/wildbits.d):00099         RAMCheck            EQU       BlockTyp  check only beg bytes of block
     0001             (./defs/wildbits.d):00100         ROMCheck            EQU       Limited   check only upper few blocks for ROM
     003F             (./defs/wildbits.d):00101         LastRAM             EQU       IOBlock   maximum RAM block number
                      (./defs/wildbits.d):00102         
     0007             (./defs/wildbits.d):00103         HW.Page             SET       $7        device descriptor hardware page
                      (./defs/wildbits.d):00104         
                      (./defs/wildbits.d):00105         * KrnBlk defines the block number of the 8K RAM block that is mapped to
                      (./defs/wildbits.d):00106         * the top of CPU address space ($E000-$FFFF) for the system process, and
                      (./defs/wildbits.d):00107         * which holds the Kernel. The top 3 pages of this CPU address space ($FD00-
                      (./defs/wildbits.d):00108         * $FFFF) have two special properties. First, $FE00-$FFFF contains the I/O space.
                      (./defs/wildbits.d):00109         * Second, $FD00-$FDFFF isn't affected by the DAT mappings but, instead,
                      (./defs/wildbits.d):00110         * remains constant regardless of what block is mapped in at slot 7.
                      (./defs/wildbits.d):00111         * When a user process is mapped in, and requests enough memory, it will end up
                      (./defs/wildbits.d):00112         * with its own block assigned for CPU address space $E000-
                      (./defs/wildbits.d):00113         * $FFFF but $FD00-$FFFF is unusable by the user process.
     0007             (./defs/wildbits.d):00114         KrnBlk              SET       $7
                      (./defs/wildbits.d):00115         
                      (./defs/wildbits.d):00116                           ENDC
                      (./defs/wildbits.d):00117         
                      (./defs/wildbits.d):00118         ********************************************************************
                      (./defs/wildbits.d):00119         * Custom SetStats
                      (./defs/wildbits.d):00120         *
                      (./defs/wildbits.d):00121                             org       $C0
00C0                  (./defs/wildbits.d):00122         SS.FntLoadM         rmb       1
00C1                  (./defs/wildbits.d):00123         SS.FntLoadF         rmb       1
00C2                  (./defs/wildbits.d):00124         SS.FntChar          rmb       1
00C3                  (./defs/wildbits.d):00125         SS.SOLIRQ           rmb       1
00C4                  (./defs/wildbits.d):00126         SS.SOLMUTE          rmb       1
                      (./defs/wildbits.d):00127         
                      (./defs/wildbits.d):00128         ********************************************************************
                      (./defs/wildbits.d):00129         * System control definitions
                      (./defs/wildbits.d):00130         *
     FE00             (./defs/wildbits.d):00131         SYS0                equ       $FE00
     FE01             (./defs/wildbits.d):00132         SYS1                equ       $FE01
     FE02             (./defs/wildbits.d):00133         RST0                equ       $FE02
     FE03             (./defs/wildbits.d):00134         RST1                equ       $FE03
                      (./defs/wildbits.d):00135         
     0080             (./defs/wildbits.d):00136         SYS_RESET           equ       %10000000
     0020             (./defs/wildbits.d):00137         SYS_CAP_EN          equ       %00100000
     0010             (./defs/wildbits.d):00138         SYS_BUZZ            equ       %00010000
     0008             (./defs/wildbits.d):00139         SYS_L1              equ       %00001000
     0004             (./defs/wildbits.d):00140         SYS_L0              equ       %00000100
     0002             (./defs/wildbits.d):00141         SYS_SD_L            equ       %00000010
     0001             (./defs/wildbits.d):00142         SYS_PWR_L           equ       %00000001
                      (./defs/wildbits.d):00143         
     0080             (./defs/wildbits.d):00144         SYS_SD_WP           equ       %10000000
     0040             (./defs/wildbits.d):00145         SYS_SD_CD           equ       %01000000
     00C0             (./defs/wildbits.d):00146         SYS_L1_RATE         equ       %11000000
     0030             (./defs/wildbits.d):00147         SYS_L0_RATE         equ       %00110000
     0008             (./defs/wildbits.d):00148         SYS_SID_ST          equ       %00001000
     0004             (./defs/wildbits.d):00149         SYS_PSG_ST          equ       %00000100
     0002             (./defs/wildbits.d):00150         SYS_L1_MN           equ       %00000010
     0001             (./defs/wildbits.d):00151         SYS_L0_MN           equ       %00000001
                      (./defs/wildbits.d):00152         
                      (./defs/wildbits.d):00153         ********************************************************************
                      (./defs/wildbits.d):00154         * MMU definitions
                      (./defs/wildbits.d):00155         *
     FFA0             (./defs/wildbits.d):00156         MMU_MEM_CTRL        equ       $FFA0
     FFA1             (./defs/wildbits.d):00157         MMU_IO_CTRL         equ       $FFA1
     FFA8             (./defs/wildbits.d):00158         MMU_SLOT_BASE       equ       $FFA8
     FFA8             (./defs/wildbits.d):00159         MMU_SLOT_0          equ       MMU_SLOT_BASE+0 $0000-$1FFF
     FFA9             (./defs/wildbits.d):00160         MMU_SLOT_1          equ       MMU_SLOT_BASE+1 $2000-$3FFF
     FFAA             (./defs/wildbits.d):00161         MMU_SLOT_2          equ       MMU_SLOT_BASE+2 $4000-$5FFF
     FFAB             (./defs/wildbits.d):00162         MMU_SLOT_3          equ       MMU_SLOT_BASE+3 $6000-$7FFF
     FFAC             (./defs/wildbits.d):00163         MMU_SLOT_4          equ       MMU_SLOT_BASE+4 $8000-$9FFF
     FFAD             (./defs/wildbits.d):00164         MMU_SLOT_5          equ       MMU_SLOT_BASE+5 $A000-$BFFF
     FFAE             (./defs/wildbits.d):00165         MMU_SLOT_6          equ       MMU_SLOT_BASE+6 $C000-$DFFF
     FFAF             (./defs/wildbits.d):00166         MMU_SLOT_7          equ       MMU_SLOT_BASE+7 $E000-$FFFF
                      (./defs/wildbits.d):00167         
                      (./defs/wildbits.d):00168         * MMU_MEM_CTRL bits
     0030             (./defs/wildbits.d):00169         EDIT_LUT            equ       %00110000
     0000             (./defs/wildbits.d):00170         EDIT_LUT_0          equ       %00000000
     0010             (./defs/wildbits.d):00171         EDIT_LUT_1          equ       %00010000
     0020             (./defs/wildbits.d):00172         EDIT_LUT_2          equ       %00100000
     0030             (./defs/wildbits.d):00173         EDIT_LUT_3          equ       %00110000
     0000             (./defs/wildbits.d):00174         ACT_LUT             equ       %00000000
     0000             (./defs/wildbits.d):00175         ACT_LUT_0           equ       %00000000
     0001             (./defs/wildbits.d):00176         ACT_LUT_1           equ       %00000001
     0002             (./defs/wildbits.d):00177         ACT_LUT_2           equ       %00000010
     0003             (./defs/wildbits.d):00178         ACT_LUT_3           equ       %00000011
                      (./defs/wildbits.d):00179         
     0008             (./defs/wildbits.d):00180         LUT_BANK_0          equ       $0008
     0009             (./defs/wildbits.d):00181         LUT_BANK_1          equ       $0009
     000A             (./defs/wildbits.d):00182         LUT_BANK_2          equ       $000A
     000B             (./defs/wildbits.d):00183         LUT_BANK_3          equ       $000B
     000C             (./defs/wildbits.d):00184         LUT_BANK_4          equ       $000C
     000D             (./defs/wildbits.d):00185         LUT_BANK_5          equ       $000D
     000E             (./defs/wildbits.d):00186         LUT_BANK_6          equ       $000E
     000F             (./defs/wildbits.d):00187         LUT_BANK_7          equ       $000F
                      (./defs/wildbits.d):00188         
                      (./defs/wildbits.d):00189         * MMU_IO_CTRL bits
                      (./defs/wildbits.d):00190         * $FFA1 has 2 bits:
                      (./defs/wildbits.d):00191         *    FFA1[0] =
                      (./defs/wildbits.d):00192         *        1 = Enable internal RAM for segment $FD00-$FDFF.
                      (./defs/wildbits.d):00193         *        0 = Disable; RAM/FLASH is accessible.
                      (./defs/wildbits.d):00194         *
                      (./defs/wildbits.d):00195         *    FFA1[1] =
                      (./defs/wildbits.d):00196         *        1 = Enable internal RAM for segment $FFF0-$FFFF
                      (./defs/wildbits.d):00197         *        0 = Disable; RAM/FLASH is accessible.
                      (./defs/wildbits.d):00198         * When enabled, the areas supersede RAM/flash, but will be disabled by RESET. When the system resets,
                      (./defs/wildbits.d):00199         * those regions revert to RAM/flash. Also at RESET, the contents of RAM retain the old values until the
                      (./defs/wildbits.d):00200         * system powers off.
                      (./defs/wildbits.d):00201         
                      (./defs/wildbits.d):00202         ********************************************************************
                      (./defs/wildbits.d):00203         * Interrupt definitions
                      (./defs/wildbits.d):00204         *
                      (./defs/wildbits.d):00205         * Interrupt addresses
     FE20             (./defs/wildbits.d):00206         INT_PENDING_0       equ       $FE20
     FE24             (./defs/wildbits.d):00207         INT_POLARITY_0      equ       $FE24
     FE28             (./defs/wildbits.d):00208         INT_EDGE_0          equ       $FE28
