                      (    ../defs/os9.d):00832         * Module Type Values
                      (    ../defs/os9.d):00833         *
     00F0             (    ../defs/os9.d):00834         Devic               EQU       $F0                 Device Descriptor Module
     00E0             (    ../defs/os9.d):00835         Drivr               EQU       $E0                 Physical Device Driver
     00D0             (    ../defs/os9.d):00836         FlMgr               EQU       $D0                 File Manager
     00C0             (    ../defs/os9.d):00837         Systm               EQU       $C0                 System Module
     0050             (    ../defs/os9.d):00838         ShellSub            EQU       $50                 Shell+ shell sub module
     0040             (    ../defs/os9.d):00839         Data                EQU       $40                 Data Module
     0030             (    ../defs/os9.d):00840         Multi               EQU       $30                 Multi-Module
     0020             (    ../defs/os9.d):00841         Sbrtn               EQU       $20                 Subroutine Module
     0010             (    ../defs/os9.d):00842         Prgrm               EQU       $10                 Program Module
                      (    ../defs/os9.d):00843         
