                      (      koronis.asm):00001         ********************************************************************
                      (      koronis.asm):00002         * Koronis - Koronis Rift Program
                      (      koronis.asm):00003         *
                      (      koronis.asm):00004         * NOTE:  This code assembles to the EXACT same object code found on
                      (      koronis.asm):00005         *        the original Koronis Rift disk.
                      (      koronis.asm):00006         *
                      (      koronis.asm):00007         *        Module size: $5C68  #23656
                      (      koronis.asm):00008         *        Module CRC : $FA659A (Good)
                      (      koronis.asm):00009         *        Hdr parity : $1C
                      (      koronis.asm):00010         *        Exec. off  : $0014  #20
                      (      koronis.asm):00011         *        Data size  : $6000  #24576
                      (      koronis.asm):00012         *        Edition    : $30  #48
                      (      koronis.asm):00013         *        Ty/La At/Rv: $11 $81
                      (      koronis.asm):00014         *        Prog mod, 6809 Obj, re-ent, R/O
                      (      koronis.asm):00015         *
                      (      koronis.asm):00016         * Edt/Rev  YYYY/MM/DD  Modified by
                      (      koronis.asm):00017         * Comment
                      (      koronis.asm):00018         * ------------------------------------------------------------------
                      (      koronis.asm):00019         *          2003/01/12  Boisy G. Pitre
                      (      koronis.asm):00020         * Disassembled from original binary; patched so that standard output
                      (      koronis.asm):00021         * is used and /TERM is no longer assumed.
                      (      koronis.asm):00022         *          2011/08/01  Robert Gault
                      (      koronis.asm):00023         * Changed two routines that toggle the RS-232 line at $FF20 to the
                      (      koronis.asm):00024         * single bit sound line at $FF22. This preserves timing and prevents
                      (      koronis.asm):00025         * DriveWire complications. L5A1F, L5A2C
                      (      koronis.asm):00026         
                      (      koronis.asm):00027                             nam       Koronis
                      (      koronis.asm):00028                             ttl       Koronis Rift Program
                      (      koronis.asm):00029         
                      (      koronis.asm):00030                             ifp1
