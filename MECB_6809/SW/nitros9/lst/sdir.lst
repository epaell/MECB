                      (            os9.d):00322         **************
                      (            os9.d):00323         * Signal Codes
                      (            os9.d):00324         *
                      (            os9.d):00325                             ORG       0
0000                  (            os9.d):00326         S$Kill              RMB       1                   Non-Interceptable Abort
0001                  (            os9.d):00327         S$Wake              RMB       1                   Wake-up Sleeping Process
0002                  (            os9.d):00328         S$Abort             RMB       1                   Keyboard Abort
0003                  (            os9.d):00329         S$Intrpt            RMB       1                   Keyboard Interrupt
