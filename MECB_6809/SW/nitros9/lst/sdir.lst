                      (        cocosdc.d):00012                             IFNE      COCOSDC.D-1
     0001             (        cocosdc.d):00013         COCOSDC.D           SET       1
                      (        cocosdc.d):00014         
                      (        cocosdc.d):00015         
                      (        cocosdc.d):00016         * Main Port Address (V.PORT)
     FF4A             (        cocosdc.d):00017         SDAddr              SET       $FF4A
                      (        cocosdc.d):00018         
                      (        cocosdc.d):00019         * Hardware Addressing - CoCo Scheme
     FF40             (        cocosdc.d):00020         CTRLATCH            equ       $FF40               controller latch (write)
     FF48             (        cocosdc.d):00021         CMDREG              equ       $FF48               command register (write)
     FF48             (        cocosdc.d):00022         STATREG             equ       $FF48               status register (read)
     FF49             (        cocosdc.d):00023         PREG1               equ       $FF49               param register 1
     FF4A             (        cocosdc.d):00024         PREG2               equ       $FF4A               param register 2
     FF4B             (        cocosdc.d):00025         PREG3               equ       $FF4B               param register 3
     FF4A             (        cocosdc.d):00026         DATREGA             equ       PREG2               first data register
     FF4B             (        cocosdc.d):00027         DATREGB             equ       PREG3               second data register
     FF42             (        cocosdc.d):00028         FLSHDAT             equ       $FF42               flash data register
                      (        cocosdc.d):00029         
                      (        cocosdc.d):00030         * Status Register Masks
     0001             (        cocosdc.d):00031         BUSY                equ       %00000001           set while a command is executing
     0002             (        cocosdc.d):00032         READY               equ       %00000010           set when ready for a data transfer
     0080             (        cocosdc.d):00033         FAILED              equ       %10000000           set on command failure
                      (        cocosdc.d):00034         
                      (        cocosdc.d):00035         * Command and Mode Values
     0043             (        cocosdc.d):00036         CMDMODE             equ       $43                 control latch value to enable command mode
     0080             (        cocosdc.d):00037         CMDREAD             equ       $80                 read logical sector
     00A0             (        cocosdc.d):00038         CMDWRITE            equ       $A0                 write logical sector
     00C0             (        cocosdc.d):00039         CMDEX               equ       $C0                 extended command
     00E0             (        cocosdc.d):00040         CMDEXD              equ       $E0                 extended command with data block
                      (        cocosdc.d):00041         
                      (        cocosdc.d):00042         
                      (        cocosdc.d):00043                             ENDC
