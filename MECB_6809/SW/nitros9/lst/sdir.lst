                      (         sdir.asm):00120         *
                      (         sdir.asm):00121         * Here's how registers are set when this process is forked:
                      (         sdir.asm):00122         *
                      (         sdir.asm):00123         *   +-----------------+  <--  Y          (highest address)
                      (         sdir.asm):00124         *   !   Parameter     !
                      (         sdir.asm):00125         *   !     Area        !
                      (         sdir.asm):00126         *   +-----------------+  <-- X, SP
                      (         sdir.asm):00127         *   !   Data Area     !
                      (         sdir.asm):00128         *   +-----------------+
                      (         sdir.asm):00129         *   !   Direct Page   !
                      (         sdir.asm):00130         *   +-----------------+  <-- U, DP       (lowest address)
                      (         sdir.asm):00131         *
                      (         sdir.asm):00132         *   D = parameter area size
                      (         sdir.asm):00133         *  PC = module entry point abs. address
                      (         sdir.asm):00134         *  CC = F=0, I=0, others undefined
                      (         sdir.asm):00135         
