                      (        flink.asm):00172                             ldd       MD$Link,u ; load D from MD$Link,u
                      (        flink.asm):00173                           IFNE    H6309   ; begin conditional assembly for H6309
                      (        flink.asm):00174                             incd                ; update processor state
                      (        flink.asm):00175                           ELSE
                      (        flink.asm):00176                             addd      #$0001    ; add #$0001 to D
                      (        flink.asm):00177                           ENDC
                      (        flink.asm):00178                             beq       FLinkTarget3 ; branch if zero is set to FLinkTarget3
                      (        flink.asm):00179                             std       MD$Link,u ; store D at MD$Link,u
