                      (        flink.asm):00092                             bra       FLinkReEntrant ; skip ahead
                      (        flink.asm):00093         
                      (        flink.asm):00094         **************************************************
                      (        flink.asm):00095         * System Call: F$Link
                      (        flink.asm):00096         *
                      (        flink.asm):00097         * Function: Link to a memory module
                      (        flink.asm):00098         *
                      (        flink.asm):00099         * Input:  X = Address of module name
                      (        flink.asm):00100         *         A = Type/Language byte
                      (        flink.asm):00101         *
                      (        flink.asm):00102         * Output: X = Advanced past module name
                      (        flink.asm):00103         *         Y = Module entry point address
                      (        flink.asm):00104         *         U = Module header address
                      (        flink.asm):00105         *         A = Module type/language byte
                      (        flink.asm):00106         *         B = Module attributes/revision byte
                      (        flink.asm):00107         *
                      (        flink.asm):00108         * Error:  CC = C bit set; B = error code
                      (        flink.asm):00109         *
02CB.                 (        flink.asm):00110         FLink               equ       *         ; define assembler symbol
                      (        flink.asm):00111                             ldx       <D.Proc   ; get pointer to DAT image
                      (        flink.asm):00112                             leay      P$DATImg,x ; point to process DAT image
02CB.                 (        flink.asm):00113         FLinkTarget         pshs      u         ; preserve register stack pointer
                      (        flink.asm):00114                             ldx       R$X,u     ; get pointer to path name
                      (        flink.asm):00115                             lda       R$A,u     ; get module type
                      (        flink.asm):00116                             lbsr      FFmodulJoin ; search module directory
                      (        flink.asm):00117                             bcs       LinkErr   ; not there, exit with error
                      (        flink.asm):00118                             leay      ,u        ; point to module directory entry
                      (        flink.asm):00119                             ldu       ,s        ; get register stack pointer
                      (        flink.asm):00120                             stx       R$X,u     ; save updated module name pointer
                      (        flink.asm):00121                             std       R$D,u     ; save type/language
                      (        flink.asm):00122                             leax      ,y        ; point to directory entry
02CB.                 (        flink.asm):00123         FLinkReEntrant      bitb      #ReEnt    ; is it re-entrant?
                      (        flink.asm):00124                             bne       FLinkModule ; yes, skip ahead
                      (        flink.asm):00125                             ldd       MD$Link,x ; is module busy?
                      (        flink.asm):00126                             beq       FLinkModule ; no, go link it
                      (        flink.asm):00127                             ldb       #E$ModBsy ; return module busy error
                      (        flink.asm):00128                             bra       LinkErr   ; return
02CB.                 (        flink.asm):00129         FLinkModule         ldd       MD$MPtr,x ; get module pointer
                      (        flink.asm):00130                             pshs      d,x       ; preserve that & directory pointer
