                      (es/kernel/krn.asm):00325                             stb       ,x        ; mark $0000-$04FF as allocated
                      (es/kernel/krn.asm):00326                             ldb       #%11111111 ; load B from #%11111111
                      (es/kernel/krn.asm):00327                             stb       $1C,x     ; mark $E000-$E7FF I/O area as allocated
                      (es/kernel/krn.asm):00328                             stb       $1D,x     ; mark $E800-$EFFF I/O area as allocated
                      (es/kernel/krn.asm):00329         *]]] CORSHAM port
                      (es/kernel/krn.asm):00330                           ELSE
                      (es/kernel/krn.asm):00331                           IFNE    mecb ; begin conditional assembly for mecb
                      (es/kernel/krn.asm):00332         *[[[ MECB port
