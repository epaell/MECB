                      (es/kernel/krn.asm):00334         * 0000-00ff ,x %10000000 
                      (es/kernel/krn.asm):00335         * 0100-01ff ,x %01000000 
                      (es/kernel/krn.asm):00336         * 0200-02ff ,x %00100000 
                      (es/kernel/krn.asm):00337         * 0300-03ff ,x %00010000 
                      (es/kernel/krn.asm):00338         * 0400-04ff ,x %00001000
                      (es/kernel/krn.asm):00339         *
                      (es/kernel/krn.asm):00340         * 
                      (es/kernel/krn.asm):00341         * e000-e0ff $1c,x %10000000 ** where IO is
                      (es/kernel/krn.asm):00342         * e100-e1ff $1c,x %01000000 
                      (es/kernel/krn.asm):00343         * e200-e2ff $1c,x %00100000 
                      (es/kernel/krn.asm):00344         * e300-e3ff $1c,x %00010000 
                      (es/kernel/krn.asm):00345         * e400-e4ff $1c,x %00001000 
                      (es/kernel/krn.asm):00346         * e500-e5ff $1c,x %00000100 
                      (es/kernel/krn.asm):00347         * e600-e6ff $1c,x %00000010 
                      (es/kernel/krn.asm):00348         * e700-e7ff $1c,x %00000010 
                      (es/kernel/krn.asm):00349         * e800-e8ff $1d,x %10000000
                      (es/kernel/krn.asm):00350         * e900-e9ff $1d,x %01000000 
                      (es/kernel/krn.asm):00351         * ea00-eaff $1d,x %00100000 
                      (es/kernel/krn.asm):00352         * eb00-ebff $1d,x %00010000 
                      (es/kernel/krn.asm):00353         * ec00-ecff $1d,x %00001000 
                      (es/kernel/krn.asm):00354         * ed00-edff $1d,x %00000100 
                      (es/kernel/krn.asm):00355         * ee00-eeff $1d,x %00000010 
                      (es/kernel/krn.asm):00356         * ef00-efff $1d,x %00000001
                      (es/kernel/krn.asm):00357         *
                      (es/kernel/krn.asm):00358         * f000-f7ff $1e
                      (es/kernel/krn.asm):00359         * f800-ffff $1f
