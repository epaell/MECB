                      (       fchain.asm):00001         ;;; F$Chain
                      (       fchain.asm):00002         ;;;
                      (       fchain.asm):00003         ;;; Links or loads a module and replaces the calling process.
                      (       fchain.asm):00004         ;;;
                      (       fchain.asm):00005         ;;; Entry:  A = The type/language byte.
                      (       fchain.asm):00006         ;;;         B = Size of the optional data area (in pages).
                      (       fchain.asm):00007         ;;;         X = Address of the module name or filename.
                      (       fchain.asm):00008         ;;;         Y = Size of the parameter area (in pages). The default is 0.
                      (       fchain.asm):00009         ;;;         U = Starting address of the parameter area. This must be at least one page.
                      (       fchain.asm):00010         ;;;
                      (       fchain.asm):00011         ;;; Exit:   None.
                      (       fchain.asm):00012         ;;;
                      (       fchain.asm):00013         ;;; Error:  B = A non-zero error code.
                      (       fchain.asm):00014         ;;;        CC = Carry flag set to indicate error.
                      (       fchain.asm):00015         ;;;
                      (       fchain.asm):00016         ;;; F$Chain loads and executes a new primary module, but doesn't create a new process. F$Chain is similar to F$Fork followed
                      (       fchain.asm):00017         ;;; by F$Exit, but has less processing overhead. F$Chain resets the calling process' program and data memory areas, then begins
                      (       fchain.asm):00018         ;;;
                      (       fchain.asm):00019         ;;; F$Chain unlinks the process’ old primary module, then parses the name of the new process’ primary module  It searches the system module
                      (       fchain.asm):00020         ;;; directory for module with the same name, type, and language already in memory.
                      (       fchain.asm):00021         ;;; If the module is in memory, F$Chain links to it. If the module isn't in memory, F$Chain uses the name string as the pathlist
                      (       fchain.asm):00022         ;;; of a file to load into memory. Then, it links to the first module in this file. (Several modules can be loaded from a single file.)
                      (       fchain.asm):00023         ;;;
                      (       fchain.asm):00024         ;;; F$Chain then reconfigures the data memory area to the size specified in the new primary module’s header. Finally, it intercepts
                      (       fchain.asm):00025         ;;; and erases any pending signals.
                      (       fchain.asm):00026         
                      (       fchain.asm):00027                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (       fchain.asm):00028         
                      (       fchain.asm):00029         * F$Chain user state entry point.
04B1 8D2C             (       fchain.asm):00030         FChain              bsr       DoChain   ; do the F$Chain
04B3 2518             (       fchain.asm):00031                             bcs       chainerr@ ; branch if error
