                      (      fallbit.asm):00151         ;;; Searches the bitmap for a free area.
                      (      fallbit.asm):00152         ;;;
                      (      fallbit.asm):00153         ;;; Entry:  X = The address of the allocation bitmap.
                      (      fallbit.asm):00154         ;;;         D = The number of the first bit to start searching.
                      (      fallbit.asm):00155         ;;;         Y = The number of clear contiguous bits to search for.
                      (      fallbit.asm):00156         ;;;         U = The address of the end of the allocation bitmap
                      (      fallbit.asm):00157         ;;;
                      (      fallbit.asm):00158         ;;; Exit:   D = The starting bit number.
                      (      fallbit.asm):00159         ;;;         Y = The number of bits cleared.
                      (      fallbit.asm):00160         ;;;
                      (      fallbit.asm):00161         ;;; Error:  B = A non-zero error code.
                      (      fallbit.asm):00162         ;;;        CC = Carry flag set to indicate error.
                      (      fallbit.asm):00163         ;;;
                      (      fallbit.asm):00164         ;;; F$SchBit searches the specified allocation bit map for contiguous cleared bits of the required length. The search
                      (      fallbit.asm):00165         ;;; starts at the starting bit number. If no block of the specified size exists, the call returns with the carry set,
                      (      fallbit.asm):00166         ;;; starting bit number, and size of the largest block.
                      (      fallbit.asm):00167         
