0685 10AF46           (      fallbit.asm):00176                             sty       R$Y,u     ; and the number of bits cleared at that point in caller's Y
0688 39               (      fallbit.asm):00177                             rts                 ; return
0689 3476             (      fallbit.asm):00178         SchBit              pshs      u,y,x,b,a ; preserve registers
068B 3426             (      fallbit.asm):00179                             pshs      y,b,a     ; preserve more
