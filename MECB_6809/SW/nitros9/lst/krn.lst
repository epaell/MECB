                      (      fallbit.asm):00235         **************************************************
                      (      fallbit.asm):00236         * System Call: F$AllBit
                      (      fallbit.asm):00237         *
                      (      fallbit.asm):00238         * Function: Sets bits in an allocation bitmap
                      (      fallbit.asm):00239         *
                      (      fallbit.asm):00240         * Input:  X = Address of allocation bitmap
                      (      fallbit.asm):00241         *         D = Number of first bit to set
                      (      fallbit.asm):00242         *         Y = Bit count (number of bits to set)
                      (      fallbit.asm):00243         *
                      (      fallbit.asm):00244         * Output: None
                      (      fallbit.asm):00245         *
                      (      fallbit.asm):00246         * Error:  CC = C bit set; B = error code
                      (      fallbit.asm):00247         *
06D5.                 (      fallbit.asm):00248         FAllBit             ldd       R$D,u     ; get bit # to start with
                      (      fallbit.asm):00249                             ldx       R$X,u     ; get address of allocation bit map
                      (      fallbit.asm):00250                             bsr       CalcBit   ; calculate byte & position & get first bit mask
                      (      fallbit.asm):00251                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00252                             ldy       <D.Proc   ; get current task #
                      (      fallbit.asm):00253                             ldb       P$Task,y  ; get task number
                      (      fallbit.asm):00254                             bra       DoAllBit  ; go do it
                      (      fallbit.asm):00255         
                      (      fallbit.asm):00256         * F$AllBit (System State)
06D5.                 (      fallbit.asm):00257         FSAllBit            ldd       R$D,u     ; get bit # to start with
                      (      fallbit.asm):00258                             ldx       R$X,u     ; get address of allocation bit map
                      (      fallbit.asm):00259                             bsr       CalcBit   ; calculate byte & pos & get first bit mask
                      (      fallbit.asm):00260                             ldb       <D.SysTsk ; get system task #
                      (      fallbit.asm):00261                           ENDC
                      (      fallbit.asm):00262         
                      (      fallbit.asm):00263         * Main bit setting loop
06D5.                 (      fallbit.asm):00264         DoAllBit            equ       *         ; define assembler symbol
                      (      fallbit.asm):00265                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00266                             ldw       R$Y,u     get # bits to set
                      (      fallbit.asm):00267                           ELSE
                      (      fallbit.asm):00268                             ldy       R$Y,u     ; get # bits to set
                      (      fallbit.asm):00269                           ENDC
                      (      fallbit.asm):00270                             beq       BitEx     ; nothing to set, return
                      (      fallbit.asm):00271                             sta       ,-s       ; preserve current mask
                      (      fallbit.asm):00272                             bmi       SkpBit    ; if high bit set, skip ahead
                      (      fallbit.asm):00273                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00274                             os9       F$LDABX   ; go get original value from bit map
                      (      fallbit.asm):00275                           ELSE
                      (      fallbit.asm):00276                             lda       ,x        ; load A from ,x
                      (      fallbit.asm):00277                           ENDC
06D5.                 (      fallbit.asm):00278         NxtBitLp            ora       ,s        ; oR it with the current mask
                      (      fallbit.asm):00279                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00280                             decw                ; dec the bit counter
                      (      fallbit.asm):00281                           ELSE
                      (      fallbit.asm):00282                             leay      -1,y      ; compute -1,y into Y
                      (      fallbit.asm):00283                           ENDC
                      (      fallbit.asm):00284                             beq       BitStEx   ; done, go put the byte back into the task's map
                      (      fallbit.asm):00285                             lsr       ,s        ; shift out the lowest bit of original
                      (      fallbit.asm):00286                             bcc       NxtBitLp  ; if it is a 0, do next bit
                      (      fallbit.asm):00287                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00288                             os9       F$STABX   ; if it was a 1 (which means whole byte done),
                      (      fallbit.asm):00289                           ELSE
                      (      fallbit.asm):00290                             sta       ,x        ; store A at ,x
                      (      fallbit.asm):00291                           ENDC
                      (      fallbit.asm):00292                             leax      1,x       ; store finished byte and bump ptr
06D5.                 (      fallbit.asm):00293         SkpBit              lda       #$FF      ; preload a finished byte
                      (      fallbit.asm):00294                             bra       SkpBit2   ; skip ahead
                      (      fallbit.asm):00295         
06D5.                 (      fallbit.asm):00296         StFulByt            equ       *         ; define assembler symbol
                      (      fallbit.asm):00297                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00298                             os9       F$STABX   ; store full byte
                      (      fallbit.asm):00299                           ELSE
                      (      fallbit.asm):00300                             sta       ,x        ; store A at ,x
                      (      fallbit.asm):00301                           ENDC
                      (      fallbit.asm):00302                             leax      1,x       ; bump ptr up 1
                      (      fallbit.asm):00303                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00304                             subw      #8        bump counter down by 8
06D5.                 (      fallbit.asm):00305         SkpBit2             cmpw      #8        is there at least 8 more (a full byte) to do?
                      (      fallbit.asm):00306                           ELSE
                      (      fallbit.asm):00307                             leay      -8,y      ; compute -8,y into Y
06D5.                 (      fallbit.asm):00308         SkpBit2             cmpy      #$0008    ; compare Y with #$0008
                      (      fallbit.asm):00309                           ENDC
                      (      fallbit.asm):00310                             bhi       StFulByt  ; more than 1, go do current
                      (      fallbit.asm):00311                             beq       BitStEx   ; exactly 1 byte left, do final store & exit
                      (      fallbit.asm):00312         
                      (      fallbit.asm):00313         * Last byte: Not a full byte left loop
06D5.                 (      fallbit.asm):00314         FAllbitBumpOutLst   lsra                ; bump out least sig. bit
                      (      fallbit.asm):00315                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00316                             decw                ; dec the bit counter
                      (      fallbit.asm):00317                           ELSE
                      (      fallbit.asm):00318                             leay      -1,y      ; compute -1,y into Y
                      (      fallbit.asm):00319                           ENDC
                      (      fallbit.asm):00320                             bne       FAllbitBumpOutLst ; keep going until last one is shifted out
                      (      fallbit.asm):00321                             coma                ; invert byte to get proper result
                      (      fallbit.asm):00322                             sta       ,s        ; preserve a sec
                      (      fallbit.asm):00323                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00324                             os9       F$LDABX   ; get byte for original map
                      (      fallbit.asm):00325                           ELSE
                      (      fallbit.asm):00326                             lda       ,x        ; load A from ,x
                      (      fallbit.asm):00327                           ENDC
                      (      fallbit.asm):00328                             ora       ,s        ; merge with new mask
06D5.                 (      fallbit.asm):00329         BitStEx             equ       *         ; define assembler symbol
                      (      fallbit.asm):00330                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00331                             os9       F$STABX   ; store finished byte into task
                      (      fallbit.asm):00332                           ELSE
                      (      fallbit.asm):00333                             sta       ,x        ; store A at ,x
                      (      fallbit.asm):00334                           ENDC
                      (      fallbit.asm):00335                             leas      1,s       ; eat the working copy of the mask
06D5.                 (      fallbit.asm):00336         BitEx               clrb                ; no error & return
                      (      fallbit.asm):00337                             rts                 ; return to caller
                      (      fallbit.asm):00338         
                      (      fallbit.asm):00339         * Calculate address of first byte we want, and which bit in that byte, from
                      (      fallbit.asm):00340         *   a bit allocation map given the address of the map & the bit # we want to
                      (      fallbit.asm):00341         *   point to
                      (      fallbit.asm):00342         * Entry: D=Bit #
                      (      fallbit.asm):00343         *        X=Ptr to bit mask table
                      (      fallbit.asm):00344         * Exit:  A=Mask to point to bit # within byte we are starting on
                      (      fallbit.asm):00345         *        X=Ptr in allocation map to first byte we are starting on
06D5.                 (      fallbit.asm):00346         CalcBit             pshs      b,y       ; preserve registers
                      (      fallbit.asm):00347                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00348                             lsrd                ; divide bit # by 8 to calculate byte # to start
                      (      fallbit.asm):00349                             lsrd                ; allocating at
                      (      fallbit.asm):00350                             lsrd                ; shift or rotate and update condition codes
                      (      fallbit.asm):00351                             addr      d,x       ; offset that far into the map
                      (      fallbit.asm):00352                           ELSE
                      (      fallbit.asm):00353                             lsra                ; shift or rotate and update condition codes
                      (      fallbit.asm):00354                             rorb                ; shift or rotate and update condition codes
                      (      fallbit.asm):00355                             lsra                ; shift or rotate and update condition codes
                      (      fallbit.asm):00356                             rorb                ; shift or rotate and update condition codes
                      (      fallbit.asm):00357                             lsra                ; shift or rotate and update condition codes
                      (      fallbit.asm):00358                             rorb                ; shift or rotate and update condition codes
                      (      fallbit.asm):00359                             leax      d,x       ; compute d,x into X
                      (      fallbit.asm):00360                           ENDC
                      (      fallbit.asm):00361                             puls      b         ; restore bit position LSB
                      (      fallbit.asm):00362                             leay      <MaskTbl,pc ; point to mask table
                      (      fallbit.asm):00363                             andb      #7        ; round it down to nearest bit
                      (      fallbit.asm):00364                             lda       b,y       ; get bit mask
                      (      fallbit.asm):00365                             puls      y,pc      ; restore & return
                      (      fallbit.asm):00366         
                      (      fallbit.asm):00367         * Bit position table (NOTE that bit #'s are done by left to right)
06D5.                 (      fallbit.asm):00368         MaskTbl             fcb       $80,$40,$20,$10,$08,$04,$02,$01 ; define byte value(s) $80,$40,$20,$10,$08,$04,$02,$01
                      (      fallbit.asm):00369         
                      (      fallbit.asm):00370         
                      (      fallbit.asm):00371         **************************************************
                      (      fallbit.asm):00372         * System Call: F$DelBit
                      (      fallbit.asm):00373         *
                      (      fallbit.asm):00374         * Function: Clears bits in an allocation bitmap
                      (      fallbit.asm):00375         *
                      (      fallbit.asm):00376         * Input:  X = Address of allocation bitmap
                      (      fallbit.asm):00377         *         D = Number of first bit to clear
                      (      fallbit.asm):00378         *         Y = Bit count (number of bits to clear)
                      (      fallbit.asm):00379         *
                      (      fallbit.asm):00380         * Output: None
                      (      fallbit.asm):00381         *
                      (      fallbit.asm):00382         * Error:  CC = C bit set; B = error code
                      (      fallbit.asm):00383         *
06D5.                 (      fallbit.asm):00384         FDelBit             ldd       R$D,u     ; get bit # to start with
                      (      fallbit.asm):00385                             ldx       R$X,u     ; get addr. of bit allocation map
                      (      fallbit.asm):00386                             bsr       CalcBit   ; point to starting bit
                      (      fallbit.asm):00387                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00388                             ldy       <D.Proc   ; get current Task #
                      (      fallbit.asm):00389                             ldb       P$Task,y  ; get task #
                      (      fallbit.asm):00390                             bra       DoDelBit  ; do rest of 0 bits
                      (      fallbit.asm):00391         
                      (      fallbit.asm):00392         * F$DelBit entry point for system state
06D5.                 (      fallbit.asm):00393         FSDelBit            ldd       R$D,u     ; get bit # to start with
                      (      fallbit.asm):00394                             ldx       R$X,u     ; get addr. of bit allocation map
                      (      fallbit.asm):00395                             bsr       CalcBit   ; point to starting bit
                      (      fallbit.asm):00396                             ldb       <D.SysTsk ; get system task #
                      (      fallbit.asm):00397                           ENDC
                      (      fallbit.asm):00398         
06D5.                 (      fallbit.asm):00399         DoDelBit            equ       *         ; define assembler symbol
                      (      fallbit.asm):00400                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00401                             ldw       R$Y,u     get # bits to clear
                      (      fallbit.asm):00402                           ELSE
                      (      fallbit.asm):00403                             ldy       R$Y,u     ; get # bits to clear
                      (      fallbit.asm):00404                           ENDC
                      (      fallbit.asm):00405                             beq       FAllbitReturn ; none, return
                      (      fallbit.asm):00406                             coma                ; invert current bit mask
                      (      fallbit.asm):00407                             sta       ,-s       ; preserve on stack
                      (      fallbit.asm):00408                             bpl       FAllbitPrldClrd ; if high bit clear, skip ahead
                      (      fallbit.asm):00409                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00410                             os9       F$LDABX   ; go get byte from user's map
                      (      fallbit.asm):00411                           ELSE
                      (      fallbit.asm):00412                             lda       ,x        ; load A from ,x
                      (      fallbit.asm):00413                           ENDC
06D5.                 (      fallbit.asm):00414         FAllbitMask         anda      ,s        ; aND it with current mask
                      (      fallbit.asm):00415                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00416                             decw                ; dec the bits left counter
                      (      fallbit.asm):00417                           ELSE
                      (      fallbit.asm):00418                             leay      -1,y      ; compute -1,y into Y
                      (      fallbit.asm):00419                           ENDC
                      (      fallbit.asm):00420                             beq       BitDone   ; done, store finished byte back in task's map
                      (      fallbit.asm):00421                             asr       ,s        ; shift out lowest bit, leaving highest alone
                      (      fallbit.asm):00422                             bcs       FAllbitMask ; if it is a 1, do next bit
                      (      fallbit.asm):00423                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00424                             os9       F$STABX   ; if it was a 0 (which means whole byte done),
                      (      fallbit.asm):00425                           ELSE
                      (      fallbit.asm):00426                             sta       ,x        ; store A at ,x
                      (      fallbit.asm):00427                           ENDC
                      (      fallbit.asm):00428                             leax      1,x       ; store finished byte & inc. ptr
06D5.                 (      fallbit.asm):00429         FAllbitPrldClrd     clra                ; preload a cleared byte
                      (      fallbit.asm):00430                             bra       ChkFull   ; skip ahead
06D5.                 (      fallbit.asm):00431         FAllbitJoin         equ       *         ; define assembler symbol
                      (      fallbit.asm):00432                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00433                             os9       F$STABX   ; store full byte
                      (      fallbit.asm):00434                           ELSE
                      (      fallbit.asm):00435                             sta       ,x        ; store A at ,x
                      (      fallbit.asm):00436                           ENDC
                      (      fallbit.asm):00437                             leax      1,x       ; bump ptr up by 1
                      (      fallbit.asm):00438                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00439                             subw      #8        dec bits left counter by 8
06D5.                 (      fallbit.asm):00440         ChkFull             cmpw      #8        at least 1 full byte left?
                      (      fallbit.asm):00441                           ELSE
                      (      fallbit.asm):00442                             leay      -8,y      ; compute -8,y into Y
06D5.                 (      fallbit.asm):00443         ChkFull             cmpy      #8        ; compare Y with #8
                      (      fallbit.asm):00444                           ENDC
                      (      fallbit.asm):00445                             bhi       FAllbitJoin ; yes, do a whole byte in 1 shot
                      (      fallbit.asm):00446                             beq       BitDone   ; exactly 1, store byte & exit
                      (      fallbit.asm):00447                             coma                ; < full byte left, invert bits
06D5.                 (      fallbit.asm):00448         FAllbitShftOutRghtm lsra                ; shift out rightmost bit
                      (      fallbit.asm):00449                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00450                             decw                ; dec bits left counter
                      (      fallbit.asm):00451                           ELSE
                      (      fallbit.asm):00452                             leay      -1,y      ; compute -1,y into Y
                      (      fallbit.asm):00453                           ENDC
                      (      fallbit.asm):00454                             bne       FAllbitShftOutRghtm ; keep doing till done
                      (      fallbit.asm):00455                             sta       ,s        ; save finished mask
                      (      fallbit.asm):00456                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00457                             os9       F$LDABX   ; get original byte from task
                      (      fallbit.asm):00458                           ELSE
                      (      fallbit.asm):00459                             lda       ,x        ; load A from ,x
                      (      fallbit.asm):00460                           ENDC
                      (      fallbit.asm):00461                             anda      ,s        ; merge cleared bits with it
06D5.                 (      fallbit.asm):00462         BitDone             equ       *         ; define assembler symbol
                      (      fallbit.asm):00463                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00464                             os9       F$STABX   ; store finished byte into task
                      (      fallbit.asm):00465                           ELSE
                      (      fallbit.asm):00466                             sta       ,x        ; store A at ,x
                      (      fallbit.asm):00467                           ENDC
                      (      fallbit.asm):00468                             leas      1,s       ; eat working copy of mask
06D5.                 (      fallbit.asm):00469         FAllbitReturn       clrb                ; eat error & return
                      (      fallbit.asm):00470                             rts                 ; return to caller
                      (      fallbit.asm):00471         
                      (      fallbit.asm):00472         
                      (      fallbit.asm):00473         **************************************************
                      (      fallbit.asm):00474         * System Call: F$SchBit
                      (      fallbit.asm):00475         *
                      (      fallbit.asm):00476         * Function: Search bitmap for a free area
                      (      fallbit.asm):00477         *
                      (      fallbit.asm):00478         * Input:  X = Address of allocation bitmap
                      (      fallbit.asm):00479         *         D = Starting bit number
                      (      fallbit.asm):00480         *         Y = Bit count (free bit block size)
                      (      fallbit.asm):00481         *         U = Address of end of allocation bitmap
                      (      fallbit.asm):00482         *
                      (      fallbit.asm):00483         * Output: D = Beginning bit number
                      (      fallbit.asm):00484         *         Y = Bit count
                      (      fallbit.asm):00485         *
                      (      fallbit.asm):00486         * Error:  CC = C bit set; B = error code
                      (      fallbit.asm):00487         *
06D5.                 (      fallbit.asm):00488         FSchBit             ldd       R$D,u     ; get start bit #
                      (      fallbit.asm):00489                             ldx       R$X,u     ; get addr. of allocation bit map
                      (      fallbit.asm):00490                             bsr       CalcBit   ; point to starting bit
                      (      fallbit.asm):00491                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00492                             ldy       <D.Proc   ; get task #
                      (      fallbit.asm):00493                             ldb       P$Task,y  ; load B from P$Task,y
                      (      fallbit.asm):00494                             bra       DoSchBit  ; skip ahead
                      (      fallbit.asm):00495         
                      (      fallbit.asm):00496         * F$SchBit entry point for system
06D5.                 (      fallbit.asm):00497         FSSchBit            ldd       R$D,u     ; get start bit #
                      (      fallbit.asm):00498                             ldx       R$X,u     ; get addr. of allocation bit map
                      (      fallbit.asm):00499                             lbsr      CalcBit   ; point to starting bit
                      (      fallbit.asm):00500                             ldb       <D.SysTsk ; get task #
                      (      fallbit.asm):00501         * Stack: 0,s : byte we are working on (from original map)
                      (      fallbit.asm):00502         *        1,s : Mask of which bit in current byte to start on
                      (      fallbit.asm):00503         *        2,s : Task number the allocation bit map is in
                      (      fallbit.asm):00504         *        3,s : Largest block found so far
                      (      fallbit.asm):00505         *        5,s : Starting bit # of requested (or closest) size found
                      (      fallbit.asm):00506         *        7,s : Starting bit # of current block being checked (2 bytes) (NOW IN Y)
                      (      fallbit.asm):00507                           ENDC
06D5.                 (      fallbit.asm):00508         DoSchBit            equ       *         ; define assembler symbol
                      (      fallbit.asm):00509                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00510                             pshs      cc,d,x,y  ; preserve task # & bit mask & reserve stack space
                      (      fallbit.asm):00511                             clrd                ; faster than 2 memory clears
                      (      fallbit.asm):00512                           ELSE
                      (      fallbit.asm):00513                             pshs      cc,d,x,y,u ; preserve task # & bit mask & reserve stack space
                      (      fallbit.asm):00514                             clra                ; clear A
                      (      fallbit.asm):00515                             clrb                ; clear B
                      (      fallbit.asm):00516                           ENDC
                      (      fallbit.asm):00517                             std       3,s       ; preserve it
                      (      fallbit.asm):00518                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00519                             ldw       R$D,u     get start bit #
                      (      fallbit.asm):00520                             tfr       w,y       ; save as current block starting bit #
                      (      fallbit.asm):00521                           ELSE
                      (      fallbit.asm):00522                             ldy       R$D,u     ; load Y from R$D,u
                      (      fallbit.asm):00523                             sty       7,s       ; store Y at 7,s
                      (      fallbit.asm):00524                           ENDC
                      (      fallbit.asm):00525                             bra       Skipper   ; skip ahead
                      (      fallbit.asm):00526         
                      (      fallbit.asm):00527         * New start point for search at current location
06D5.                 (      fallbit.asm):00528         RstSrch             equ       *         ; define assembler symbol
                      (      fallbit.asm):00529                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00530                             tfr       w,y       ; preserve current block bit # start
                      (      fallbit.asm):00531                           ELSE
                      (      fallbit.asm):00532                             sty       7,s       ; store Y at 7,s
                      (      fallbit.asm):00533                           ENDC
                      (      fallbit.asm):00534         * Move to next bit position, and to next byte if current byte is done
06D5.                 (      fallbit.asm):00535         MoveBit             lsr       1,s       ; move to next bit position
                      (      fallbit.asm):00536                             bcc       CheckBit  ; if not the last one, check it
                      (      fallbit.asm):00537                             ror       1,s       ; move bit position marker to 1st bit again
                      (      fallbit.asm):00538                             leax      1,x       ; move byte ptr (in map) to next byte
                      (      fallbit.asm):00539         
                      (      fallbit.asm):00540         * Check if we are finished allocation map
06D5.                 (      fallbit.asm):00541         Skipper             cmpx      R$U,u     ; done entire map?
                      (      fallbit.asm):00542                             bhs       BadNews   ; yes, couldn't fit in 1 block, notify caller
                      (      fallbit.asm):00543                             ldb       2,s       ; get task number
                      (      fallbit.asm):00544                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fallbit.asm):00545                             os9       F$LDABX   ; get byte from bit allocation map
                      (      fallbit.asm):00546                           ELSE
                      (      fallbit.asm):00547                             lda       ,x        ; load A from ,x
                      (      fallbit.asm):00548                           ENDC
                      (      fallbit.asm):00549                             sta       ,s        ; preserve in scratch area
                      (      fallbit.asm):00550         
                      (      fallbit.asm):00551         * Main checking
06D5.                 (      fallbit.asm):00552         CheckBit            equ       *         ; define assembler symbol
                      (      fallbit.asm):00553                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00554                             incw                ; increment current bit #
                      (      fallbit.asm):00555                           ELSE
                      (      fallbit.asm):00556                             leay      1,y       ; compute 1,y into Y
                      (      fallbit.asm):00557                           ENDC
                      (      fallbit.asm):00558                             lda       ,s        ; get current byte
                      (      fallbit.asm):00559                             anda      1,s       ; mask out all but current bit position
                      (      fallbit.asm):00560                             bne       RstSrch   ; if bit not free, restart search from next bit
                      (      fallbit.asm):00561                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00562                             tfr       w,d       ; dup current bit # into D
                      (      fallbit.asm):00563                             subr      y,d       calculate size we have free so far
                      (      fallbit.asm):00564                           ELSE
                      (      fallbit.asm):00565                             tfr       y,d       ; transfer register value y,d
                      (      fallbit.asm):00566                             subd      7,s       ; subtract 7,s from D
                      (      fallbit.asm):00567                           ENDC
                      (      fallbit.asm):00568                             cmpd      R$Y,u     ; as big as user requested?
                      (      fallbit.asm):00569                             bhs       WereDone  ; yes, we are done
                      (      fallbit.asm):00570                             cmpd      $03,s     ; as big as the largest one we have found so far?
                      (      fallbit.asm):00571                             bls       MoveBit   ; no, move to next bit and keep going
                      (      fallbit.asm):00572                             std       $03,s     ; it is the largest, save current size
                      (      fallbit.asm):00573                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00574                             sty       $05,s     ; save as start bit # of largest block found so far
                      (      fallbit.asm):00575                           ELSE
                      (      fallbit.asm):00576                             ldd       7,s       ; load D from 7,s
                      (      fallbit.asm):00577                             std       5,s       ; store D at 5,s
                      (      fallbit.asm):00578                           ENDC
                      (      fallbit.asm):00579                             bra       MoveBit   ; move to next bit and keep going
                      (      fallbit.asm):00580         
                      (      fallbit.asm):00581         * Couldn't find requested size block; tell user where the closest was found
                      (      fallbit.asm):00582         *   and how big it was
06D5.                 (      fallbit.asm):00583         BadNews             ldd       $03,s     ; get size of largest block we found
                      (      fallbit.asm):00584                             std       R$Y,u     ; put into callers Y register
                      (      fallbit.asm):00585                             comb                ; set carry to indicate we couldn't get full size
                      (      fallbit.asm):00586                             ldd       5,s       ; get starting bit # of largest block we found
                      (      fallbit.asm):00587                             bra       BadSkip   ; skip ahead
                      (      fallbit.asm):00588         * Found one, tell user where it is
06D5.                 (      fallbit.asm):00589         WereDone            equ       *         ; define assembler symbol
                      (      fallbit.asm):00590                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00591                             tfr       y,d       ; get start bit # of the block we found
                      (      fallbit.asm):00592                           ELSE
                      (      fallbit.asm):00593                             ldd       7,s       ; load D from 7,s
                      (      fallbit.asm):00594                           ENDC
06D5.                 (      fallbit.asm):00595         BadSkip             std       R$D,u     ; put starting bit # of block into callers D register
                      (      fallbit.asm):00596                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00597                             leas      $07,s     ; eat our temporary stack area & return
                      (      fallbit.asm):00598                           ELSE
                      (      fallbit.asm):00599                             leas      $09,s     ; adjust stack pointer by $09,s
                      (      fallbit.asm):00600                           ENDC
                      (      fallbit.asm):00601                             rts                 ; return to caller
                      (      fallbit.asm):00602         
                      (      fallbit.asm):00603                           ENDC
                      (es/kernel/krn.asm):00577                             use       fprsnam.asm ; include source file fprsnam.asm
                      (      fprsnam.asm):00001         ;;; F$PrsNam
                      (      fprsnam.asm):00002         ;;;
                      (      fprsnam.asm):00003         ;;; Parse a pathlist.
                      (      fprsnam.asm):00004         ;;;
                      (      fprsnam.asm):00005         ;;; Entry:  X = The address of the pathlist to parse.
                      (      fprsnam.asm):00006         ;;;         U = Starting address of the routine’s memory area.
                      (      fprsnam.asm):00007         ;;;
                      (      fprsnam.asm):00008         ;;; Exit:   X = The address of the character past the optional "/".
                      (      fprsnam.asm):00009         ;;;         Y = The address of the last character plus one.
                      (      fprsnam.asm):00010         ;;;         A = The trailing delimiter character.
                      (      fprsnam.asm):00011         ;;;         B = The length of the pathlist.
                      (      fprsnam.asm):00012         ;;;        CC = Carry flag clear to indicate success.
                      (      fprsnam.asm):00013         ;;;
                      (      fprsnam.asm):00014         ;;; Error:  B = A non-zero error code.
                      (      fprsnam.asm):00015         ;;;         Y = The address of the first non-delimiter character.
                      (      fprsnam.asm):00016         ;;;        CC = Carry flag set to indicate error.
                      (      fprsnam.asm):00017         ;;;
                      (      fprsnam.asm):00018         ;;; F$PrsNam scans the input text string for a legal name. It terminates the name with any character that is not a legal name character.
                      (      fprsnam.asm):00019         ;;; It's useful for processing pathlist arguments passed to a new process.
                      (      fprsnam.asm):00020         ;;; Because it processes only one name, you need several calls to process a pathlist that has more than one name.
                      (      fprsnam.asm):00021         ;;; F$PrsNam completes with Y in position for the next element in the pathlist to parse.
                      (      fprsnam.asm):00022         ;;; If  Y is at the end of a pathlist, a bad path error returns.
                      (      fprsnam.asm):00023         ;;; It then moves the pointer in Y past any space characters so that it can parse the next pathlist in a command line.
                      (      fprsnam.asm):00024         ;;;
                      (      fprsnam.asm):00025         ;;; Before the Parse Name call:
                      (      fprsnam.asm):00026         ;;;
                      (      fprsnam.asm):00027         ;;; |  /  |  D  |  0  |  /  |  P  |  A  |  Y  |  R  |  O  |  L  |  L  |
                      (      fprsnam.asm):00028         ;;;    X
                      (      fprsnam.asm):00029         ;;;
                      (      fprsnam.asm):00030         ;;; After the Parse Name call:
                      (      fprsnam.asm):00031         ;;;
                      (      fprsnam.asm):00032         ;;; |  /  |  D  |  0  |  /  |  P  |  A  |  Y  |  R  |  O  |  L  |  L  |
                      (      fprsnam.asm):00033         ;;;          X       Y              B = 2
                      (      fprsnam.asm):00034         
                      (      fprsnam.asm):00035         
                      (      fprsnam.asm):00036                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fprsnam.asm):00037         
06D5.                 (      fprsnam.asm):00038         FPrsNam             ldx       <D.Proc   ; get the process descriptor
                      (      fprsnam.asm):00039                             leay      <P$DATImg,x ; and the DAT image pointer in it
                      (      fprsnam.asm):00040                             ldx       R$X,u     ; get the pathlist from the caller's X
                      (      fprsnam.asm):00041                             bsr       ParseNam  ; parse the pathlist
                      (      fprsnam.asm):00042                             std       R$D,u     ; D contains the length of the name; store it in the caller's D
                      (      fprsnam.asm):00043                             bcs       FPrsnamHasEndName ; branch if an error occurred
                      (      fprsnam.asm):00044                             stx       R$X,u     ; X contains the start of the name; store it in the caller's X
                      (      fprsnam.asm):00045                             abx                 ; add the length in B to X
06D5.                 (      fprsnam.asm):00046         FPrsnamHasEndName   stx       R$Y,u     ; X contains the end of the name plus one; store it in the caller's Y
                      (      fprsnam.asm):00047                             rts                 ; return to the caller
                      (      fprsnam.asm):00048         
                      (      fprsnam.asm):00049         * Parse name
06D5.                 (      fprsnam.asm):00050         ParseNam            equ       *         ; define assembler symbol
                      (      fprsnam.asm):00051                             pshs      y         ; save the DAT image pointer on the stack
                      (      fprsnam.asm):00052                             lbsr      AdjBlk0   ; go find the map block
                      (      fprsnam.asm):00053                             pshs      x,y       ; save the offset within the block (X) and the block pointer (Y)
                      (      fprsnam.asm):00054                             bsr       GoGetAXY  ; get the byte at X in block Y
                      (      fprsnam.asm):00055                             cmpa      #'.       ; is the first character a period?
                      (      fprsnam.asm):00056                             bne       IsSlash   ; no, do proper first character checking
                      (      fprsnam.asm):00057                             lbsr      FLdMMUBlockData ; do a LDAXY, without changing X or Y
                      (      fprsnam.asm):00058                             bsr       ChkFirst  ; is the next character non-period?
                      (      fprsnam.asm):00059                             lda       #'.       ; restore the period character the LDAXY destroyed
                      (      fprsnam.asm):00060                             bcc       Do.Loop   ; if it's a non-period character, skip first character checks
                      (      fprsnam.asm):00061         
06D5.                 (      fprsnam.asm):00062         IsSlash             cmpa      #PDELIM   ; is it a slash?
                      (      fprsnam.asm):00063                             bne       NotSlash  ; no, keep X offset and block Y
                      (      fprsnam.asm):00064                             bsr       GetChar   ; go get character
06D5.                 (      fprsnam.asm):00065         NotSlash            bsr       ChkFirst  ; check if we have a valid first character
                      (      fprsnam.asm):00066                             bcs       NotValid  ; branch if it isn't valid
06D5.                 (      fprsnam.asm):00067         Do.Loop             clrb                ; initialize the character counter
06D5.                 (      fprsnam.asm):00068         LastLoop            incb                ; add one character
                      (      fprsnam.asm):00069                             tsta                ; is it the last character of the name?
                      (      fprsnam.asm):00070                             bmi       LastChar  ; yes, return valid
                      (      fprsnam.asm):00071                             bsr       GoGetAXY  ; get next character
                      (      fprsnam.asm):00072                             bsr       ChkValid  ; check if it's valid character
                      (      fprsnam.asm):00073                             bcc       LastLoop  ; branch if valid
06D5.                 (      fprsnam.asm):00074         LastChar            andcc     #^Carry   ; else set the carry to indicate an error
                      (      fprsnam.asm):00075                             bra       RtnValid  ; and return to the caller
                      (      fprsnam.asm):00076         
06D5.                 (      fprsnam.asm):00077         GetChar
                      (      fprsnam.asm):00078                             stx       2,s       ; save the current offset over the old offset
                      (      fprsnam.asm):00079                             sty       4,s       ; save the current block pointer over the old block pointer
06D5.                 (      fprsnam.asm):00080         GoGetAXY            lbra      LDAXY     ; get the byte at X in block Y in A, then return
                      (      fprsnam.asm):00081         
06D5.                 (      fprsnam.asm):00082         NextLoop            bsr       GetChar   ; get the next character
06D5.                 (      fprsnam.asm):00083         NotValid            cmpa      #',       ; is it a comma?
                      (      fprsnam.asm):00084                             beq       NextLoop  ; yes, go get the next character
                      (      fprsnam.asm):00085                             cmpa      #C$SPAC   ; is it a space?
                      (      fprsnam.asm):00086                             beq       NextLoop  ; yes, go get the next character
                      (      fprsnam.asm):00087                             comb                ; else set the carry to indicate an error condition
                      (      fprsnam.asm):00088                             ldb       #E$BNam   ; 'Bad Name' error
06D5.                 (      fprsnam.asm):00089         RtnValid            equ       *         ; define assembler symbol
                      (      fprsnam.asm):00090                             puls      x,y       ; recover tje offset & pointer
                      (      fprsnam.asm):00091                             bra       FFmodulChar ; do a similar exit routine
                      (      fprsnam.asm):00092         
06D5.                 (      fprsnam.asm):00093         ChkFirst            pshs      a         ; save the character
                      (      fprsnam.asm):00094                             anda      #$7F      ; drop the most significant bit
                      (      fprsnam.asm):00095                             bra       ChkRst    ; skip the dash for the first character check
                      (      fprsnam.asm):00096         
                      (      fprsnam.asm):00097         * Determine if character in A is a valid filename character.
06D5.                 (      fprsnam.asm):00098         ChkValid            pshs      a         ; save the character
                      (      fprsnam.asm):00099                             anda      #$7F      ; drop the most significant bit
                      (      fprsnam.asm):00100                             cmpa      #'.       ; is it a period?
                      (      fprsnam.asm):00101                             beq       ValidChr  ; yes, return valid character
06D5.                 (      fprsnam.asm):00102         ChkRest             cmpa      #'-       ; is it a dash?
                      (      fprsnam.asm):00103                             beq       ValidChr  ; yes, it's valid
06D5.                 (      fprsnam.asm):00104         ChkRst              cmpa      #'z       ; is it greater than "z"?
                      (      fprsnam.asm):00105                             bhi       InvalidC  ; yes, return an invalid character
                      (      fprsnam.asm):00106                             cmpa      #'a       ; is it greater than or equal to "a"?
                      (      fprsnam.asm):00107                             bhs       ValidChr  ; yes, return a valid character
                      (      fprsnam.asm):00108                             cmpa      #'_       ; is it an underscore?
                      (      fprsnam.asm):00109                             beq       ValidChr  ; yes, return a valid character
                      (      fprsnam.asm):00110                             cmpa      #'Z       ; is it greater than "Z"?
                      (      fprsnam.asm):00111                             bhi       InvalidC  ; yes, return an invalid character
                      (      fprsnam.asm):00112                             cmpa      #'A       ; is it greater than or equal to "A"?
                      (      fprsnam.asm):00113                             bhs       ValidChr  ; yes, return a valid character
                      (      fprsnam.asm):00114                             cmpa      #'9       ; is it greater than "9"?
                      (      fprsnam.asm):00115                             bhi       InvalidC  ; yes, return an invalid character
                      (      fprsnam.asm):00116                             cmpa      #'0       ; is it greater than or equal to "0"?
                      (      fprsnam.asm):00117                             bhs       ValidChr  ; yes, return a valid character
                      (      fprsnam.asm):00118                             cmpa      #'$       ; is it a dollar symbol?
                      (      fprsnam.asm):00119                             beq       ValidChr  ; yes, return a valid character
06D5.                 (      fprsnam.asm):00120         InvalidC            coma                ; else it's an invalid character; set the carry bit to indicate error
06D5.                 (      fprsnam.asm):00121         ValidChr            puls      a,pc      ; return to the caller
                      (      fprsnam.asm):00122         
                      (      fprsnam.asm):00123                           ELSE
                      (      fprsnam.asm):00124         
06D5 AE44             (      fprsnam.asm):00125         FPrsNam             ldx       R$X,u     ; get pathlist pointer from caller
06D7 8D0A             (      fprsnam.asm):00126                             bsr       ParseNam  ; do the parsing of the name
06D9 ED41             (      fprsnam.asm):00127                             std       R$D,u     ; save the length
06DB 2502             (      fprsnam.asm):00128                             bcs       ex@       ; branch if the carry is set
06DD AF44             (      fprsnam.asm):00129                             stx       R$X,u     ; save the updated pathlist pointer
06DF 10AF46           (      fprsnam.asm):00130         ex@                 sty       R$Y,u     ; and the Y
06E2 39               (      fprsnam.asm):00131                             rts                 ; return to the caller
                      (      fprsnam.asm):00132         
06E3 A684             (      fprsnam.asm):00133         ParseNam            lda       ,x        ; get the first character
06E5 812F             (      fprsnam.asm):00134                             cmpa      #PDELIM   ; is it the pathlist character?
06E7 2602             (      fprsnam.asm):00135                             bne       next@     ; branch if not
06E9 3001             (      fprsnam.asm):00136                             leax      1,x       ; else go past it
06EB 3184             (      fprsnam.asm):00137         next@               leay      ,x        ; point Y to X
06ED 5F               (      fprsnam.asm):00138                             clrb                ; clear B
06EE A6A0             (      fprsnam.asm):00139                             lda       ,y+       ; get the next character
06F0 847F             (      fprsnam.asm):00140                             anda      #$7F      ; mask out the high bit
06F2 8D28             (      fprsnam.asm):00141                             bsr       chkrest@  ; go check the rest
06F4 2512             (      fprsnam.asm):00142                             bcs       comma@    ; branch if the carry is set
06F6 5C               (      fprsnam.asm):00143         loop@               incb                ; increment B
06F7 A63F             (      fprsnam.asm):00144                             lda       -1,y      ; get the previous character
06F9 2B0A             (      fprsnam.asm):00145                             bmi       ex@       ; if high bit is set on this character, we're done
06FB A6A0             (      fprsnam.asm):00146                             lda       ,y+       ; else get the next character
06FD 847F             (      fprsnam.asm):00147                             anda      #$7F      ; clear the high bit
06FF 8D17             (      fprsnam.asm):00148                             bsr       chkfirst@ ; and check first
0701 24F3             (      fprsnam.asm):00149                             bcc       loop@     ; branch if the carry is clear
0703 A6A2             (      fprsnam.asm):00150                             lda       ,-y       ; else get the previous character
0705 1CFE             (      fprsnam.asm):00151         ex@                 andcc     #^Carry   ; clear the carry
0707 39               (      fprsnam.asm):00152                             rts                 ; return to the caller
0708 812C             (      fprsnam.asm):00153         comma@              cmpa      #C$COMA   ; is it a comma?
070A 2602             (      fprsnam.asm):00154                             bne       space@    ; branch if not
070C A6A0             (      fprsnam.asm):00155         skip@               lda       ,y+       ; else get the next character
070E 8120             (      fprsnam.asm):00156         space@              cmpa      #C$SPAC   ; is it a space?
0710 27FA             (      fprsnam.asm):00157                             beq       skip@     ; branch if so
0712 A6A2             (      fprsnam.asm):00158                             lda       ,-y       ; else get the previous character
0714 53               (      fprsnam.asm):00159                             comb                ; set the carry
0715 C6EB             (      fprsnam.asm):00160                             ldb       #E$BNam   ; indicate a bad pathname error
0717 39               (      fprsnam.asm):00161                             rts                 ; and return to the caller
                      (      fprsnam.asm):00162         * Check for legal characters in a pathlist
0718 812E             (      fprsnam.asm):00163         chkfirst@           cmpa      #C$PERD   ; is the character a period?
071A 2743             (      fprsnam.asm):00164                             beq       Match     ; branch if so
071C 8130             (      fprsnam.asm):00165         chkrest@            cmpa      #'0       ; is it zero?
071E 2518             (      fprsnam.asm):00166                             bcs       errex@    ; branch if less than
0720 8139             (      fprsnam.asm):00167                             cmpa      #'9       ; is it a number?
0722 233B             (      fprsnam.asm):00168                             bls       Match     ; branch if it is between 0-9
0724 815F             (      fprsnam.asm):00169                             cmpa      #'_       ; is it an underscore?
0726 2737             (      fprsnam.asm):00170                             beq       Match     ; branch if so
0728 8141             (      fprsnam.asm):00171                             cmpa      #'A       ; is it A?
072A 250C             (      fprsnam.asm):00172                             bcs       errex@    ; branch if less than
072C 815A             (      fprsnam.asm):00173                             cmpa      #'Z       ; is it Z?
072E 232F             (      fprsnam.asm):00174                             bls       Match     ; branch if less than or equal (A-Z)
0730 8161             (      fprsnam.asm):00175                             cmpa      #'a       ; is it a?
0732 2504             (      fprsnam.asm):00176                             bcs       errex@    ; branch if less than
0734 817A             (      fprsnam.asm):00177                             cmpa      #'z       ; is it z?
0736 2327             (      fprsnam.asm):00178                             bls       Match     ; branch if less than or equal (a-z)
0738 1A01             (      fprsnam.asm):00179         errex@              orcc      #Carry    ; set the carry
073A 39               (      fprsnam.asm):00180                             rts                 ; return to the caller
                      (      fprsnam.asm):00181         
                      (      fprsnam.asm):00182                           ENDC
                      (es/kernel/krn.asm):00578                             use       fcmpnam.asm ; include source file fcmpnam.asm
                      (      fcmpnam.asm):00001         ;;; F$CmpNam
                      (      fcmpnam.asm):00002         ;;;
                      (      fcmpnam.asm):00003         ;;; Compare two names.
                      (      fcmpnam.asm):00004         ;;;
                      (      fcmpnam.asm):00005         ;;; Entry:  X = Address of the first name.
                      (      fcmpnam.asm):00006         ;;;         Y = Address of the second name.
                      (      fcmpnam.asm):00007         ;;;         B = Length of the first name.
                      (      fcmpnam.asm):00008         ;;;
                      (      fcmpnam.asm):00009         ;;; Exit: CC = Carry flag clear if names match; otherwise, set.
                      (      fcmpnam.asm):00010         ;;;
                      (      fcmpnam.asm):00011         ;;; F$CmpNam compares two names and indicates whether they match. Use this call with F$PrsNam. The second name
                      (      fcmpnam.asm):00012         ;;; must have the most significant bit (bit 7) of the last character set.
                      (      fcmpnam.asm):00013         
                      (      fcmpnam.asm):00014                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (      fcmpnam.asm):00015         
                      (      fcmpnam.asm):00016         * User state entry
                      (      fcmpnam.asm):00017                             ldy       M$Size,x  ; get module size in module header
073B.                 (      fcmpnam.asm):00018         FCmpNam             ldx       <D.Proc   ; get current process ptr
                      (      fcmpnam.asm):00019                             leay      P$DATImg,x ; point to the DAT image
                      (      fcmpnam.asm):00020                             ldx       R$X,u     ; get pointer to the first name
                      (      fcmpnam.asm):00021                             pshs      y,x       ; preserve 'em
                      (      fcmpnam.asm):00022                             bra       GetName2  ; branch unconditionally to GetName2
                      (      fcmpnam.asm):00023         * System state entry
073B.                 (      fcmpnam.asm):00024         FSCmpNam            ldx       <D.Proc   ; get current process descriptor pointer
                      (      fcmpnam.asm):00025                             leay      P$DATImg,x ; point to its DAT image
                      (      fcmpnam.asm):00026                             ldx       R$X,u     ; get pointer to the first name
                      (      fcmpnam.asm):00027                             pshs      x,y       ; save x,y on the stack
                      (      fcmpnam.asm):00028                             ldy       <D.SysDAT ; get pointer to system DAT
073B.                 (      fcmpnam.asm):00029         GetName2            ldx       R$Y,u     ; get pointer to the second name
                      (      fcmpnam.asm):00030                             pshs      y,x       ; preserve them
                      (      fcmpnam.asm):00031                             ldd       R$D,u     ; get length
                      (      fcmpnam.asm):00032                             leax      4,s       ; point to the first name's info packet
                      (      fcmpnam.asm):00033                             leay      ,s        ; point to the second name's info packet
                      (      fcmpnam.asm):00034                             bsr       FCmpnamTarget ; go compare 'em
                      (      fcmpnam.asm):00035                             leas      8,s       ; purge stack
                      (      fcmpnam.asm):00036                             rts                 ; return to caller
                      (      fcmpnam.asm):00037         
                      (      fcmpnam.asm):00038         * Compare 2 names
                      (      fcmpnam.asm):00039         *
                      (      fcmpnam.asm):00040         * Input:  D = Length of the first name (only requires B)
                      (      fcmpnam.asm):00041         *         X = Pointer to the first name's info packet
                      (      fcmpnam.asm):00042         *             0,X = DAT image pointer
                      (      fcmpnam.asm):00043         *             2,X = Pointer to name
                      (      fcmpnam.asm):00044         *         Y = Pointer to the second name's info packet
                      (      fcmpnam.asm):00045         *             0,Y = DAT image pointer
                      (      fcmpnam.asm):00046         *             2,Y = Pointer to name
                      (      fcmpnam.asm):00047         *         U = Register stack ptr
073B.                 (      fcmpnam.asm):00048         FCmpnamTarget       pshs      d,x,y,u   ; preserve registers
                      (      fcmpnam.asm):00049                             tfr       x,u       ; U=pointer to the first name packet
                      (      fcmpnam.asm):00050                             pulu      x,y       ; get DAT pointer to Y and name pointer to X
                      (      fcmpnam.asm):00051                             lbsr      AdjBlk0   ; adjust X to use block 0
                      (      fcmpnam.asm):00052                             pshu      x,y       ; put them back
                      (      fcmpnam.asm):00053                             ldu       4,s       ; get pointer to the second name's packet
                      (      fcmpnam.asm):00054                             pulu      x,y       ; get DAT pointer to Y and name pointer to X
                      (      fcmpnam.asm):00055                             lbsr      AdjBlk0   ; adjust X to block 0
                      (      fcmpnam.asm):00056                             bra       FCmpnamMapBlkGrab ; go compare the names
                      (      fcmpnam.asm):00057         
073B.                 (      fcmpnam.asm):00058         FCmpnamScndNmsPckt  ldu       4,s       ; get pointer to second name's packet
                      (      fcmpnam.asm):00059                             pulu      x,y       ; get DAT pointer to Y and name pointer to X
073B.                 (      fcmpnam.asm):00060         FCmpnamMapBlkGrab   lbsr      LDAXY     ; map in the block & grab a byte from name
                      (      fcmpnam.asm):00061                             pshu      x,y       ; put updated DAT & name pointer back
                      (      fcmpnam.asm):00062                             pshs      a         ; save the character
                      (      fcmpnam.asm):00063                             ldu       3,s       ; pointer to the first name packet
                      (      fcmpnam.asm):00064                             pulu      x,y       ; get DAT pointer to Y and name pointer to X
                      (      fcmpnam.asm):00065                             lbsr      LDAXY     ; get byte from the first name
                      (      fcmpnam.asm):00066                             pshu      y,x       ; put pointers back
                      (      fcmpnam.asm):00067                             eora      ,s        ; exclusive-OR A with ,s
                      (      fcmpnam.asm):00068                             tst       ,s+       ; was it high bit?
                      (      fcmpnam.asm):00069                             bmi       FCmpnamName ; yes, check if last character in the second name
                      (      fcmpnam.asm):00070                             decb                ; decrement B
                      (      fcmpnam.asm):00071                             beq       FCmpnamCarry ; branch if zero is set to FCmpnamCarry
                      (      fcmpnam.asm):00072                             anda      #$DF      ; match?
                      (      fcmpnam.asm):00073                             beq       FCmpnamScndNmsPckt ; yes, check next character
073B.                 (      fcmpnam.asm):00074         FCmpnamCarry        comb                ; set carry
                      (      fcmpnam.asm):00075                             puls      d,x,y,u,pc ; restore d,x,y,u,pc from the stack
                      (      fcmpnam.asm):00076         
073B.                 (      fcmpnam.asm):00077         FCmpnamName         decb                ; done whole name?
                      (      fcmpnam.asm):00078                             bne       FCmpnamCarry ; no, exit with no match
                      (      fcmpnam.asm):00079                             anda      #$5F      ; match?
                      (      fcmpnam.asm):00080                             bne       FCmpnamCarry ; yes, keep checking
                      (      fcmpnam.asm):00081                             clrb                ; names match, clear carry
                      (      fcmpnam.asm):00082                             puls      d,x,y,u,pc ; restore & return to caller
                      (      fcmpnam.asm):00083         
                      (      fcmpnam.asm):00084                           ELSE
                      (      fcmpnam.asm):00085         
                      (      fcmpnam.asm):00086         ;;; F$CmpNam
                      (      fcmpnam.asm):00087         ;;;
                      (      fcmpnam.asm):00088         ;;; Compare two names for a match.
                      (      fcmpnam.asm):00089         ;;;
                      (      fcmpnam.asm):00090         ;;; Entry:  B = The length of the first name.
                      (      fcmpnam.asm):00091         ;;;         X = The address of the first name.
                      (      fcmpnam.asm):00092         ;;;         Y = The address of the second name.
                      (      fcmpnam.asm):00093         ;;;
                      (      fcmpnam.asm):00094         ;;; Exit:  CC = Carry flag clear if names match; set if names don't match.
                      (      fcmpnam.asm):00095         ;;;
                      (      fcmpnam.asm):00096         ;;; F$CmpNam compares two names and indicates whether they match. Use this call with F$PrsNam. The second name
                      (      fcmpnam.asm):00097         ;;; must have the most significant bit of the last character set.
                      (      fcmpnam.asm):00098         
073B E642             (      fcmpnam.asm):00099         FCmpNam             ldb       R$B,u     ; get length of the first name
073D 3344             (      fcmpnam.asm):00100                             leau      R$X,u     ; point U to the caller's R$X
073F 3730             (      fcmpnam.asm):00101                             pulu      y,x       ; load caller's R$X and R$Y into X and Y in one call
0741 3436             (      fcmpnam.asm):00102         CmpNam              pshs      y,x,b,a   ; save registers
0743 A6A0             (      fcmpnam.asm):00103         loop@               lda       ,y+       ; get character of second name and increment pointer
0745 2B0D             (      fcmpnam.asm):00104                             bmi       hibitset@ ; branch if hi-bit set
0747 5A               (      fcmpnam.asm):00105                             decb                ; decrement length
0748 2706             (      fcmpnam.asm):00106                             beq       nomatch@  ; if counter is zero, length is different, so not a match
074A A880             (      fcmpnam.asm):00107                             eora      ,x+       ; xOR with character in same position from first name and increment pointer
074C 84DF             (      fcmpnam.asm):00108                             anda      #$DF      ; make result case insensitive
074E 27F3             (      fcmpnam.asm):00109                             beq       loop@     ; if zero, characters match, so continue to next character
0750 1A01             (      fcmpnam.asm):00110         nomatch@            orcc      #Carry    ; set carry to indicate no match
0752 35B6             (      fcmpnam.asm):00111                             puls      pc,y,x,b,a ; restore registers and return to caller
0754 5A               (      fcmpnam.asm):00112         hibitset@           decb                ; more?
0755 26F9             (      fcmpnam.asm):00113                             bne       nomatch@  ; branch if so, length is different so not a match.
0757 A884             (      fcmpnam.asm):00114                             eora      ,x        ; xOR with character in same position from first name
0759 845F             (      fcmpnam.asm):00115                             anda      #$5F      ; make result case insensitive
075B 26F3             (      fcmpnam.asm):00116                             bne       nomatch@  ; if not zero, not a match
075D 3536             (      fcmpnam.asm):00117                             puls      y,x,b,a   ; restore registers
075F 1CFE             (      fcmpnam.asm):00118         Match               andcc     #^Carry   ; clear carry to indicate a match
0761 39               (      fcmpnam.asm):00119                             rts                 ; return to caller
                      (      fcmpnam.asm):00120         
                      (      fcmpnam.asm):00121                           ENDC
                      (es/kernel/krn.asm):00579                             use       fssvc.asm ; include source file fssvc.asm
                      (        fssvc.asm):00001         ;;; F$SSvc
                      (        fssvc.asm):00002         ;;;
                      (        fssvc.asm):00003         ;;; Add or replace system calls.
                      (        fssvc.asm):00004         ;;;
                      (        fssvc.asm):00005         ;;; Entry:  Y = The address of the system call initialization table.
                      (        fssvc.asm):00006         ;;;
                      (        fssvc.asm):00007         ;;; Exit:   None.
                      (        fssvc.asm):00008         ;;;
                      (        fssvc.asm):00009         ;;; Error:  B = A non-zero error code.
                      (        fssvc.asm):00010         ;;;        CC = Carry flag set to indicate error.
                      (        fssvc.asm):00011         ;;;
                      (        fssvc.asm):00012         ;;; F$SSvc adds or replaces system calls in the kernel's user and system mode system call tables. Y holds the address of a
                      (        fssvc.asm):00013         ;;; table that contains the function codes and offsets for system call routines. The table has the following format:
                      (        fssvc.asm):00014         ;;;
                      (        fssvc.asm):00015         ;;; Relative
                      (        fssvc.asm):00016         ;;; Address      Use
                      (        fssvc.asm):00017         ;;; ----------------------------------
                      (        fssvc.asm):00018         ;;;| $00               Function code      |<-- First entry
                      (        fssvc.asm):00019         ;;;| $01         Offset from byte 3   |
                      (        fssvc.asm):00020         ;;;| $02         to function handler  |
                      (        fssvc.asm):00021         ;;;|..................................|
                      (        fssvc.asm):00022         ;;;| $03               Function code      |     <-- Second entry
                      (        fssvc.asm):00023         ;;;| $04         Offset From byte 6   |
                      (        fssvc.asm):00024         ;;;| $05         to function handler  |
                      (        fssvc.asm):00025         ;;;|..................................|
                      (        fssvc.asm):00026         ;;;|                                  |
                      (        fssvc.asm):00027         ;;;|           More Entries           |
                      (        fssvc.asm):00028         ;;;|                                  |
                      (        fssvc.asm):00029         ;;;|..................................|
                      (        fssvc.asm):00030         ;;;|               $80                | End-of-table mark
                      (        fssvc.asm):00031         ;;; ----------------------------------
                      (        fssvc.asm):00032         ;;;
                      (        fssvc.asm):00033         ;;; If the most significant bit of the function code is set, the kernel updates the system table only; otherwise, both
                      (        fssvc.asm):00034         ;;; system and user tables are updated.
                      (        fssvc.asm):00035         ;;; The function request codes are in the range $29-$34. I/O calls are in the range $80-$90.
                      (        fssvc.asm):00036         ;;; To use a privileged system call, you must be executing a program that's executing in the system state.
                      (        fssvc.asm):00037         ;;; The system call handler routine must process the system call and return from the subroutine with an RTS instruction.
                      (        fssvc.asm):00038         ;;; The handler routing may alter all CPU registers, except SP.
                      (        fssvc.asm):00039         ;;; U holds the address of the register stack to the system call hander as shown in the following diagram:
                      (        fssvc.asm):00040         ;;;
                      (        fssvc.asm):00041         ;;;               Relative
                      (        fssvc.asm):00042         ;;;               Address     Name
                      (        fssvc.asm):00043         ;;; -----------------------------------
                      (        fssvc.asm):00044         ;;; U -->       CC        $00       R$CC
                      (        fssvc.asm):00045         ;;;          A        $01       R$A (R$D)
                      (        fssvc.asm):00046         ;;;          B        $02       R$B
                      (        fssvc.asm):00047         ;;;         DP        $03       R$DP
                      (        fssvc.asm):00048         ;;;          X        $04       R$X
                      (        fssvc.asm):00049         ;;;          Y        $06       R$Y
                      (        fssvc.asm):00050         ;;;          U        $08       R$U
                      (        fssvc.asm):00051         ;;;         PC        $0A       R$PC
                      (        fssvc.asm):00052         
0762 10AE46           (        fssvc.asm):00053         FSSvc               ldy       R$Y,u     ; get pointer to table
0765 2020             (        fssvc.asm):00054                             bra       InstallSvc ; install the service
                      (        fssvc.asm):00055         * Main move loop
0767.                 (        fssvc.asm):00056         loop@
                      (        fssvc.asm):00057                           IFGT    Level-1 ; begin conditional assembly for Level-1
                      (        fssvc.asm):00058         *[[[ Level 2
                      (        fssvc.asm):00059                             clra                ; clear the MSB of the table offset
                      (        fssvc.asm):00060                             lslb                ; multiply the function # by 2 to get the offset into the table
                      (        fssvc.asm):00061                             tfr       d,u       ; copy it to U
                      (        fssvc.asm):00062                             ldd       ,y++      ; get the vector to the function handler
                      (        fssvc.asm):00063                             leax      d,y       ; offset X from current Y
                      (        fssvc.asm):00064                             ldd       <D.SysDis ; get the system dispatch table pointer
                      (        fssvc.asm):00065                             stx       d,u       ; save the vector into place
                      (        fssvc.asm):00066                             bcs       InstallSvc ; if it was a privileged call, skip ahead
                      (        fssvc.asm):00067                             ldd       <D.UsrDis ; else get the user dispatch table pointer
                      (        fssvc.asm):00068                             stx       d,u       ; and save the vector into place
                      (        fssvc.asm):00069         *]]] Level 2
                      (        fssvc.asm):00070                           ELSE
                      (        fssvc.asm):00071         *[[[ Level 1
0767 1F98             (        fssvc.asm):00072                             tfr       b,a       ; put the system call code in A
0769 847F             (        fssvc.asm):00073                             anda      #$7F      ; kill the high bit
076B 817F             (        fssvc.asm):00074                             cmpa      #$7F      ; is the system call code $7F? (I/O handler)
076D 2708             (        fssvc.asm):00075                             beq       ok@       ; branch if so
076F 8137             (        fssvc.asm):00076                             cmpa      #$37      ; compare against highest call allowed
0771 2504             (        fssvc.asm):00077                             bcs       ok@       ; branch if less than or equal to the highest call
0773 53               (        fssvc.asm):00078                             comb                ; else set the carry flag
0774 C6E3             (        fssvc.asm):00079                             ldb       #E$ISWI   ; and indicate an illegal code
0776 39               (        fssvc.asm):00080                             rts                 ; return to the caller
0777 58               (        fssvc.asm):00081         ok@                 lslb                ; B = B * 2
0778 DE46             (        fssvc.asm):00082                             ldu       <D.SysDis ; get the system dispatch table pointer
077A 33C5             (        fssvc.asm):00083                             leau      b,u       ; U points to entry in table
077C ECA1             (        fssvc.asm):00084                             ldd       ,y++      ; get the address of the routine in the table
077E 30AB             (        fssvc.asm):00085                             leax      d,y       ; set X to the absolute address
0780 AFC4             (        fssvc.asm):00086                             stx       ,u        ; and store in the system table
0782 2503             (        fssvc.asm):00087                             bcs       InstallSvc ; branch if this is a system service call only
0784 AFC870           (        fssvc.asm):00088                             stx       <$70,u    ; else store in user table also
                      (        fssvc.asm):00089         *]]] Level 1
                      (        fssvc.asm):00090                           ENDC
0787 E6A0             (        fssvc.asm):00091         InstallSvc          ldb       ,y+       ; get the system call code in B
0789 C180             (        fssvc.asm):00092                             cmpb      #$80      ; are we at the end of the table?
078B 26DA             (        fssvc.asm):00093                             bne       loop@     ; branch if not
078D 39               (        fssvc.asm):00094                             rts                 ; return to the caller
                      (es/kernel/krn.asm):00580         
                      (es/kernel/krn.asm):00581         * Validate modules in memory.
                      (es/kernel/krn.asm):00582         *
                      (es/kernel/krn.asm):00583         * Entry: X = The address to start searching.
                      (es/kernel/krn.asm):00584         *        Y = The address to stop (actually stops at Y-1).
078E 3420             (es/kernel/krn.asm):00585         ValMods             pshs      y         ; save off Y
0790 17FBA8           (es/kernel/krn.asm):00586         loop@               lbsr      ValMod    ; go validate module
0793 2506             (es/kernel/krn.asm):00587                             bcs       ValErr    ; branch if error
0795 EC02             (es/kernel/krn.asm):00588                             ldd       M$Size,x  ; get size of module into D
0797 308B             (es/kernel/krn.asm):00589                             leax      d,x       ; point X past module
