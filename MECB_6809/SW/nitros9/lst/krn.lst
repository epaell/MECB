                      (      fallbit.asm):00054         
                      (      fallbit.asm):00055         * Calculate address of first byte we want, and which bit in that byte, from
                      (      fallbit.asm):00056         * a bit allocation map given the address of the map & the bit # we want to point to.
                      (      fallbit.asm):00057         *
                      (      fallbit.asm):00058         * Entry: D = The bit number we want.
                      (      fallbit.asm):00059         *        X = The pointer to the bitmap table.
                      (      fallbit.asm):00060         *
                      (      fallbit.asm):00061         * Exit:  A = A mask that has the bit number within byte we are starting on.
                      (      fallbit.asm):00062         *        X = The pointer in allocation map to first byte we are starting on.
                      (      fallbit.asm):00063         *
                      (      fallbit.asm):00064         * Example 1:
                      (      fallbit.asm):00065         * We want bit 18 starting at address 1024. Pass 18 to D and 1024 to X.
                      (      fallbit.asm):00066         * We get back 128 in A (bit 7 set) and 1026 in D (the address of the bit).
                      (      fallbit.asm):00067         *
                      (      fallbit.asm):00068         * Example 2:
                      (      fallbit.asm):00069         * We want bit 5 starting at address 3000. Pass 5 to D and 3000 to X.
                      (      fallbit.asm):00070         * We get back 8 in A (bit 3 set) and 3000 in D (the address of the bit).
                      (      fallbit.asm):00071         
0626 3404             (      fallbit.asm):00072         CalcBit             pshs      b         ; preserve B
                      (      fallbit.asm):00073                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fallbit.asm):00074         *[[[ H6309
                      (      fallbit.asm):00075                             lsrd                ; divide D by 2
                      (      fallbit.asm):00076                             lsrd                ; then divide D by 2 again
                      (      fallbit.asm):00077                             lsrd                ; and again, now D = D / 8
                      (      fallbit.asm):00078                             addr      d,x       ; get the address of the byte in the bitmap to start
                      (      fallbit.asm):00079         *]]] H6309
                      (      fallbit.asm):00080                           ELSE
                      (      fallbit.asm):00081         *[[[ M6809
0628 44               (      fallbit.asm):00082                             lsra                ; divide D
0629 56               (      fallbit.asm):00083                             rorb                ; by 2
062A 44               (      fallbit.asm):00084                             lsra                ; then divide D
062B 56               (      fallbit.asm):00085                             rorb                ; by 2
062C 44               (      fallbit.asm):00086                             lsra                ; and divide D
062D 56               (      fallbit.asm):00087                             rorb                ; again by 2, now D = D/8, which is the byte offset
062E 308B             (      fallbit.asm):00088                             leax      d,x       ; get the address of the byte in the bitmap to start
                      (      fallbit.asm):00089         *]]] M6809
                      (      fallbit.asm):00090                           ENDC
0630 3504             (      fallbit.asm):00091                             puls      b         ; recover B to compute the bit
0632 8680             (      fallbit.asm):00092                             lda       #$80      ; load A with hi bit set
0634 C407             (      fallbit.asm):00093                             andb      #%0000111 ; mask out all but the lower 3 bits (0-7, the bit number)
0636 2704             (      fallbit.asm):00094                             beq       ex@       ; branch if 0 (the 0th bit)
0638 44               (      fallbit.asm):00095         loop@               lsra                ; else right shift A
0639 5A               (      fallbit.asm):00096                             decb                ; and decrement B (the bit counter)
063A 26FC             (      fallbit.asm):00097                             bne       loop@     ; until B reaches 0
063C 39               (      fallbit.asm):00098         ex@                 rts                 ; return to the caller
                      (      fallbit.asm):00099         
                      (      fallbit.asm):00100         ;;; F$DelBit
                      (      fallbit.asm):00101         ;;;
                      (      fallbit.asm):00102         ;;; Clears bits in an allocation bitmap.
                      (      fallbit.asm):00103         ;;;
                      (      fallbit.asm):00104         ;;; Entry:  D = The number of the first bit to clear.
                      (      fallbit.asm):00105         ;;;         X = The address of the allocation bitmap.
                      (      fallbit.asm):00106         ;;;         Y = The number of the bits to clear.
                      (      fallbit.asm):00107         ;;;
                      (      fallbit.asm):00108         ;;; Exit:   None.
                      (      fallbit.asm):00109         ;;;
                      (      fallbit.asm):00110         ;;; Error:  B = A non-zero error code.
                      (      fallbit.asm):00111         ;;;        CC = Carry flag set to indicate error.
                      (      fallbit.asm):00112         ;;;
                      (      fallbit.asm):00113         ;;; F$DelBit clears bits in the allocation bitmap. Bit numbers range from 0 to n-1, where n is the number of bits
                      (      fallbit.asm):00114         ;;; in the allocation bit map.
                      (      fallbit.asm):00115         ;;;
