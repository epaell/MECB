                      (       faproc.asm):00001         ;;; F$AProc
                      (       faproc.asm):00002         ;;;
                      (       faproc.asm):00003         ;;; Insert process into active process queue.
                      (       faproc.asm):00004         ;;;
                      (       faproc.asm):00005         ;;; Entry:  X = The address of the process descriptor to insert.
                      (       faproc.asm):00006         ;;;
                      (       faproc.asm):00007         ;;; Exit:   None.
                      (       faproc.asm):00008         ;;;
                      (       faproc.asm):00009         ;;; Error:  B = A non-zero error code.
                      (       faproc.asm):00010         ;;;        CC = Carry flag set to indicate error.
                      (       faproc.asm):00011         ;;;
                      (       faproc.asm):00012         ;;; F$AProc inserts a process into the active process queue so that the kernel can schedule the process for execution.
                      (       faproc.asm):00013         ;;; The kernel sorts all processes in the queue by process age (the count of how many process switches have occurred
                      (       faproc.asm):00014         ;;; since the process’s last time slice). When a process moves to the active process queue, the kernel sets its age
                      (       faproc.asm):00015         ;;; according to its priority. The higher the priority, the higher the age.
                      (       faproc.asm):00016         ;;;
                      (       faproc.asm):00017         ;;; An exception is a newly active process that was deactivated while in the system state. The kernel gives such a process
                      (       faproc.asm):00018         ;;; higher priority because it's typically executing critical routines that affect shared system resources.
                      (       faproc.asm):00019         
                      (       faproc.asm):00020                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (       faproc.asm):00021         
01A2 AE44             (       faproc.asm):00022         FAProc              ldx       R$X,u     ; get the pointer to process the to insert
01A4 3460             (       faproc.asm):00023         SFAProc             pshs      u,y       ; save U/Y on stack
01A6 CE003F           (       faproc.asm):00024                             ldu       #(D.AProcQ-P$Queue) ; load U with D.AProcQ-P$Queue so we're at the first process in the queue later
01A9 2007             (       faproc.asm):00025                             bra       getqueue@ ; start processing the active queue
                      (       faproc.asm):00026         * This loop increases the age of all active processes by 1.
01AB E64C             (       faproc.asm):00027         ageloop@            ldb       P$Age,u   ; get process age
01AD 5C               (       faproc.asm):00028                             incb                ; update it
01AE 2702             (       faproc.asm):00029                             beq       getqueue@ ; branch if wrap
01B0 E74C             (       faproc.asm):00030                             stb       P$Age,u   ; save it back to proc desc
01B2 EE4E             (       faproc.asm):00031         getqueue@           ldu       P$Queue,u ; get pointer to next process in queue
01B4 26F5             (       faproc.asm):00032                             bne       ageloop@  ; branch if process is in active queue
01B6 CE003F           (       faproc.asm):00033                             ldu       #(D.AProcQ-P$Queue) ; load U with D.AProcQ-P$Queue so we're at the first process in the queue later
01B9 A60B             (       faproc.asm):00034                             lda       P$Prior,x ; get process priority of process to insert
01BB A70C             (       faproc.asm):00035                             sta       P$Age,x   ; save it as its age
01BD 1A50             (       faproc.asm):00036                             orcc      #IntMasks ; mask interrupts
                      (       faproc.asm):00037         * This loop finds the process with the age lower than our age in the queue and inserts us
                      (       faproc.asm):00038         * in front of them.
01BF 31C4             (       faproc.asm):00039         loop2@              leay      ,u        ; point Y to process descriptor
01C1 EE4E             (       faproc.asm):00040                             ldu       P$Queue,u ; get pointer to next process in active queue
01C3 2704             (       faproc.asm):00041                             beq       ex@       ; branch if empty
01C5 A14C             (       faproc.asm):00042                             cmpa      P$Age,u   ; compare passed process' age to current in queue
01C7 23F6             (       faproc.asm):00043                             bls       loop2@    ; if lower or same, keep going
01C9 EF0E             (       faproc.asm):00044         ex@                 stu       P$Queue,x ; insert process with lower age as the next one in P$Queue of passed process
01CB AF2E             (       faproc.asm):00045                             stx       P$Queue,y ; and put passed process descriptor pointer in current
01CD 5F               (       faproc.asm):00046                             clrb                ; clear carry
01CE 35E0             (       faproc.asm):00047                             puls      pc,u,y    ; restore U/Y and return
                      (       faproc.asm):00048         
                      (       faproc.asm):00049                           ELSE
                      (       faproc.asm):00050         
01D0.                 (       faproc.asm):00051         FAProc              ldx       R$X,u     ; get ptr to process to activate
01D0.                 (       faproc.asm):00052         FAprocTarget        clrb                ; clear B
                      (       faproc.asm):00053                             pshs      cc,b,x,y,u ; save cc,b,x,y,u on the stack
                      (       faproc.asm):00054                             lda       P$Prior,x ; get process priority
                      (       faproc.asm):00055                             sta       P$Age,x   ; save it as age (How long it's been around)
                      (       faproc.asm):00056                             orcc      #IntMasks ; shut down IRQ's
                      (       faproc.asm):00057                             ldu       #(D.AProcQ-P$Queue) ; get ptr to active process queue
                      (       faproc.asm):00058                             bra       FAprocProcess ; go through the chain
                      (       faproc.asm):00059         * Update active process queue
                      (       faproc.asm):00060         *  X=Process to activate
                      (       faproc.asm):00061         *  U=Current process in queue links
01D0.                 (       faproc.asm):00062         FAprocProcessAge    inc       P$Age,u   ; update current process age
                      (       faproc.asm):00063                             bne       FAprocMtchProcAges ; wrap?
                      (       faproc.asm):00064                             dec       P$Age,u   ; yes, reset it to max.
01D0.                 (       faproc.asm):00065         FAprocMtchProcAges  cmpa      P$Age,u   ; match process ages??
                      (       faproc.asm):00066                             bhi       FAprocProcessChain ; no, skip update
01D0.                 (       faproc.asm):00067         FAprocProcess       leay      ,u        ; point Y to current process
01D0.                 (       faproc.asm):00068         FAprocProcessChain  ldu       P$Queue,u ; get pointer to next process in chain
                      (       faproc.asm):00069                             bne       FAprocProcessAge ; still more in chain, keep going
                      (       faproc.asm):00070                             ldd       P$Queue,y ; load D from P$Queue,y
                      (       faproc.asm):00071                             stx       P$Queue,y ; save new process to chain
                      (       faproc.asm):00072                             std       P$Queue,x ; store D at P$Queue,x
                      (       faproc.asm):00073                             puls      cc,b,x,y,u,pc ; restore cc,b,x,y,u,pc from the stack
                      (       faproc.asm):00074         
