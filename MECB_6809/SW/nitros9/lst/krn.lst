                      (      fvmodul.asm):00564                           ELSE
                      (      fvmodul.asm):00565                             puls      b,x,y     ; yes, restore CRC
                      (      fvmodul.asm):00566                           ENDC
                      (      fvmodul.asm):00567                             cmpb      #CRCCon1  ; cRC MSB match constant?
                      (      fvmodul.asm):00568                             bne       FVmodulBadModCRC ; no, exit with error
                      (      fvmodul.asm):00569                             cmpx      #CRCCon23 ; lSW match constant?
                      (      fvmodul.asm):00570                             beq       FVmodulExit ; yes, skip ahead
03E8.                 (      fvmodul.asm):00571         FVmodulBadModCRC    ldb       #E$BMCRC  ; bad Module CRC error
03E8.                 (      fvmodul.asm):00572         FVmodulUpError      orcc      #Carry    ; set up for error
03E8.                 (      fvmodul.asm):00573         FVmodulExit         puls      x,y,pc    ; exit
                      (      fvmodul.asm):00574         
                      (      fvmodul.asm):00575         * Calculate 24 bit CRC
                      (      fvmodul.asm):00576         * Entry: A=Byte to add to CRC
                      (      fvmodul.asm):00577         *        U=Pointer to 24 bit CRC accumulator
                      (      fvmodul.asm):00578         *
                      (      fvmodul.asm):00579         * Future reference note: Do not use W unless preserved, contains module
                      (      fvmodul.asm):00580         *                        byte counts from routines that come here!!
03E8.                 (      fvmodul.asm):00581         CRCCalc             eora      ,u        ; exclusive-OR A with ,u
                      (      fvmodul.asm):00582                             pshs      a         ; save a on the stack
                      (      fvmodul.asm):00583                             ldd       1,u       ; load D from 1,u
                      (      fvmodul.asm):00584                             std       ,u        ; store D at ,u
                      (      fvmodul.asm):00585                             clra                ; clear A
                      (      fvmodul.asm):00586                             ldb       ,s        ; load B from ,s
                      (      fvmodul.asm):00587                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00588                             lsld                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00589                           ELSE
                      (      fvmodul.asm):00590                             aslb                ; update processor state
                      (      fvmodul.asm):00591                             rola                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00592                           ENDC
                      (      fvmodul.asm):00593                             eora      1,u       ; exclusive-OR A with 1,u
                      (      fvmodul.asm):00594                             std       1,u       ; store D at 1,u
                      (      fvmodul.asm):00595                             clrb                ; clear B
                      (      fvmodul.asm):00596                             lda       ,s        ; load A from ,s
                      (      fvmodul.asm):00597                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00598                             lsrd                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00599                             lsrd                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00600                             eord      1,u
                      (      fvmodul.asm):00601                           ELSE
                      (      fvmodul.asm):00602                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00603                             rorb                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00604                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00605                             rorb                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00606                             eora      1,u       ; exclusive-OR A with 1,u
                      (      fvmodul.asm):00607                             eorb      2,u       ; exclusive-OR B with 2,u
                      (      fvmodul.asm):00608                           ENDC
                      (      fvmodul.asm):00609                             std       1,u       ; store D at 1,u
                      (      fvmodul.asm):00610                             lda       ,s        ; load A from ,s
                      (      fvmodul.asm):00611                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00612                             eora      ,s        ; exclusive-OR A with ,s
                      (      fvmodul.asm):00613                             sta       ,s        ; store A at ,s
                      (      fvmodul.asm):00614                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00615                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00616                             eora      ,s        ; exclusive-OR A with ,s
                      (      fvmodul.asm):00617                             sta       ,s        ; store A at ,s
                      (      fvmodul.asm):00618                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00619                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00620                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00621                             lsla                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00622                             eora      ,s+       ; exclusive-OR A with ,s+
                      (      fvmodul.asm):00623                             bpl       FVmodulReturn ; branch if negative is clear to FVmodulReturn
                      (      fvmodul.asm):00624                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00625                             eim       #$80,,u
                      (      fvmodul.asm):00626                             eim       #$21,2,u
                      (      fvmodul.asm):00627                           ELSE
                      (      fvmodul.asm):00628                             ldd       #$8021    ; load D from #$8021
                      (      fvmodul.asm):00629                             eora      ,u        ; exclusive-OR A with ,u
                      (      fvmodul.asm):00630                             sta       ,u        ; store A at ,u
                      (      fvmodul.asm):00631                             eorb      2,u       ; exclusive-OR B with 2,u
                      (      fvmodul.asm):00632                             stb       2,u       ; store B at 2,u
                      (      fvmodul.asm):00633                           ENDC
03E8.                 (      fvmodul.asm):00634         FVmodulReturn       rts                 ; return to caller
