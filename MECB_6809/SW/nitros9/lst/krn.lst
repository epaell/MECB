                      (es/kernel/krn.asm):00304         * Setup the free memory bitmap.
                      (es/kernel/krn.asm):00305         * This area of the kernel is highly platform-dependent.
                      (es/kernel/krn.asm):00306         *
                      (es/kernel/krn.asm):00307         * The free memory bitmap has the following structure:
                      (es/kernel/krn.asm):00308         *   bit 7 of 0,x corresponds to page 0, bit 6 to page 1 etc.
                      (es/kernel/krn.asm):00309         *   bit 7 of 1,x corresponds to page 8, bit 6 to page 9 etc.
00B8 9E20             (es/kernel/krn.asm):00310                             ldx       <D.FMBM   ; get free memory bitmap in X
                      (es/kernel/krn.asm):00311                           IFNE    atari   ; begin conditional assembly for atari
                      (es/kernel/krn.asm):00312         *[[[ ATARI LIBER809 port
                      (es/kernel/krn.asm):00313         * Atari needs $0000-$08FF and $D000-$D7FF reserved.
                      (es/kernel/krn.asm):00314                             ldb       #%11111111 ; load B from #%11111111
                      (es/kernel/krn.asm):00315                             stb       ,x        ; mark $0000-$07FF as allocated
                      (es/kernel/krn.asm):00316                             stb       $1A,x     ; mark $D000-$D7FF I/O area as allocated
                      (es/kernel/krn.asm):00317                             ldb       #%10000000 ; load B from #%10000000
                      (es/kernel/krn.asm):00318                             stb       1,x       ; mark $0800-$08FF as allocated
                      (es/kernel/krn.asm):00319         *]]] ATARI LIBER809 port
                      (es/kernel/krn.asm):00320                           ELSE
                      (es/kernel/krn.asm):00321                           IFNE    corsham ; begin conditional assembly for corsham
                      (es/kernel/krn.asm):00322         *[[[ CORSHAM port
