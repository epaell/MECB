     00C1             (es/kernel/krn.asm):00071         tylg                set       Systm+Objct ; define assembler symbol
     0080             (es/kernel/krn.asm):00072         atrv                set       ReEnt+rev ; define assembler symbol
     0000             (es/kernel/krn.asm):00073         rev                 set       $00       ; define assembler symbol
     0010             (es/kernel/krn.asm):00074         edition             set       16        ; define assembler symbol
                      (es/kernel/krn.asm):00075         
0000 87CD0819000DC180 (es/kernel/krn.asm):00076         ModTop              mod       eom,name,tylg,atrv,OS9Cold,size ; define OS-9 module header
     E800110000
                      (es/kernel/krn.asm):00077         
     0000             (es/kernel/krn.asm):00078         size                equ       .         ; define assembler symbol
                      (es/kernel/krn.asm):00079         
000D 4B72EE           (es/kernel/krn.asm):00080         name                fcs       /Krn/
0010 10               (es/kernel/krn.asm):00081                             fcb       edition   ; define byte value(s) edition
                      (es/kernel/krn.asm):00082         
                      (es/kernel/krn.asm):00083         **************************
                      (es/kernel/krn.asm):00084         * Kernel entry point
                      (es/kernel/krn.asm):00085         *
                      (es/kernel/krn.asm):00086         * Entry (Wildbits Port):
                      (es/kernel/krn.asm):00087         *     X = The starting address of the bootfile.
                      (es/kernel/krn.asm):00088         *     Y = The size of the bootfile in bytes.
     0011             (es/kernel/krn.asm):00089         OS9Cold             equ       *         ; define assembler symbol
0011 1A50             (es/kernel/krn.asm):00090                             orcc      #IntMasks ; mask interrupts
0013 10CE0500         (es/kernel/krn.asm):00091                             lds       #$500     ; set the system stack
                      (es/kernel/krn.asm):00092                           IFNE    wildbits ; begin conditional assembly for wildbits
                      (es/kernel/krn.asm):00093         *[[[ Wildbits port
                      (es/kernel/krn.asm):00094         * In RAM mode, the Wildbits memory map looks like this:
                      (es/kernel/krn.asm):00095         *    $0000-$1FFF - RAM at $000000-$001FFF
                      (es/kernel/krn.asm):00096         *    $2000-$3FFF - RAM at $002000-$003FFF
                      (es/kernel/krn.asm):00097         *    $4000-$5FFF - RAM at $004000-$005FFF
                      (es/kernel/krn.asm):00098         *    $6000-$7FFF - RAM at $006000-$007FFF
                      (es/kernel/krn.asm):00099         *    $8000-$9FFF - RAM at $008000-$009FFF
                      (es/kernel/krn.asm):00100         *    $A000-$BFFF - RAM at $00A000-$00BFFF
                      (es/kernel/krn.asm):00101         *    $C000-$DFFF - RAM at $00C000-$00DFFF
                      (es/kernel/krn.asm):00102         *    $E000-$FFFF - RAM at $00E000-$00FFFF
                      (es/kernel/krn.asm):00103         * Wildbits-specific initialization to get the Wildbits to a sane state.
                      (es/kernel/krn.asm):00104                             pshs      x,y       ; save the bootfile pointer and size
                      (es/kernel/krn.asm):00105                             lda       #$FF      ; A = $FF
                      (es/kernel/krn.asm):00106                             sta       INT_MASK_0 ; mask all set 0 interrupts
                      (es/kernel/krn.asm):00107                             sta       INT_MASK_1 ; mask all set 1 interrupts
                      (es/kernel/krn.asm):00108                             sta       INT_PENDING_0 ; clear any pending set 0 interrupts
                      (es/kernel/krn.asm):00109                             sta       INT_PENDING_1 ; clear any pending set 0 interrupts
                      (es/kernel/krn.asm):00110         *]]] Wildbits port
                      (es/kernel/krn.asm):00111                           ENDC
                      (es/kernel/krn.asm):00112         
                      (es/kernel/krn.asm):00113         * Clear out system globals from $0000-$0400.
0017 8E0000           (es/kernel/krn.asm):00114                             ldx       #$0000    ; start clearing memory at $0000
001A 108E0400         (es/kernel/krn.asm):00115                             ldy       #$0400    ; get the number of bytes to clear
001E 4F               (es/kernel/krn.asm):00116                             clra                ; clear A
001F 5F               (es/kernel/krn.asm):00117                             clrb                ; clear B (D now $0000)
0020 1F9B             (es/kernel/krn.asm):00118                             tfr       b,dp      ; transfer to DP
0022 ED81             (es/kernel/krn.asm):00119         loop@               std       ,x++      ; save off at X and increment
0024 313E             (es/kernel/krn.asm):00120                             leay      -2,y      ; decrement counter
0026 26FA             (es/kernel/krn.asm):00121                             bne       loop@     ; continue if not zero
                      (es/kernel/krn.asm):00122         
                      (es/kernel/krn.asm):00123         * Set up the system globals area.
0028 4C               (es/kernel/krn.asm):00124                             inca                ; D = $100
0029 4C               (es/kernel/krn.asm):00125                             inca                ; D = $200
002A DD20             (es/kernel/krn.asm):00126                             std       <D.FMBM   ; $200 = start of the free memory bitmap
002C CB20             (es/kernel/krn.asm):00127                             addb      #$20      ; D = $220
002E DD22             (es/kernel/krn.asm):00128                             std       <D.FMBM+2 ; $220 = end of the free memory bitmap
0030 CB02             (es/kernel/krn.asm):00129                             addb      #$02      ; D = $222
0032 DD46             (es/kernel/krn.asm):00130                             std       <D.SysDis ; $222 = address of the system dispatch table
0034 CB70             (es/kernel/krn.asm):00131                             addb      #$70      ; D = $292
0036 DD44             (es/kernel/krn.asm):00132                             std       <D.UsrDis ; $292 = address of the user dispatch table
0038 5F               (es/kernel/krn.asm):00133                             clrb                ; D = $200
0039 4C               (es/kernel/krn.asm):00134                             inca                ; D = $300
003A DD26             (es/kernel/krn.asm):00135                             std       <D.ModDir ; $300 = module directory starting address
003C 9F28             (es/kernel/krn.asm):00136                             stx       <D.ModDir+2 ; X = $400 = module directory ending address
                      (es/kernel/krn.asm):00137         
                      (es/kernel/krn.asm):00138         * This routine checks for RAM by writing a pattern at an address
                      (es/kernel/krn.asm):00139         * then reading it back for validation. It may not be needed, so it's
                      (es/kernel/krn.asm):00140         * conditionalized.
                      (es/kernel/krn.asm):00141                           IFNE    CHECK_FOR_VALID_RAM ; begin conditional assembly for CHECK_FOR_VALID_RAM
                      (es/kernel/krn.asm):00142         *[[[ CHECK_FOR_VALID_RAM
                      (es/kernel/krn.asm):00143                           IFNE    wildbits ; begin conditional assembly for wildbits
                      (es/kernel/krn.asm):00144         *[[[ Wildbits port
                      (es/kernel/krn.asm):00145                             ldx       ,s        ; get start of bootfile
                      (es/kernel/krn.asm):00146         *]]] Wildbits port
                      (es/kernel/krn.asm):00147                           ELSE
                      (es/kernel/krn.asm):00148         *[[[ NOT(Wildbits port)
                      (es/kernel/krn.asm):00149         * Check for valid RAM starting at $400
                      (es/kernel/krn.asm):00150                             ldx       #Bt.Start ; end at bootfile start
                      (es/kernel/krn.asm):00151         *]]] NOT(Wildbits port)
                      (es/kernel/krn.asm):00152                           ENDC
                      (es/kernel/krn.asm):00153                             pshs      x         ; save it on the stack
003E.                 (es/kernel/krn.asm):00154         ChkRAM              leay      ,x        ; point Y to X ($400)
                      (es/kernel/krn.asm):00155                             ldd       ,y        ; store org contents in D
                      (es/kernel/krn.asm):00156                             ldx       #$00FF    ; set X to pattern to write
                      (es/kernel/krn.asm):00157                             stx       ,y        ; write pattern to ,Y
                      (es/kernel/krn.asm):00158                             cmpx      ,y        ; same as what we wrote?
                      (es/kernel/krn.asm):00159                             bne       EndOfRAM@ ; nope, not RAM here!
                      (es/kernel/krn.asm):00160                             ldx       #$FF00    ; try different pattern
                      (es/kernel/krn.asm):00161                             stx       ,y        ; write it to ,Y
                      (es/kernel/krn.asm):00162                             cmpx      ,y        ; same as what we wrote?
                      (es/kernel/krn.asm):00163                             bne       EndOfRAM@ ; nope, not RAM here!
                      (es/kernel/krn.asm):00164                             std       ,y        ; else restore org contents
                      (es/kernel/krn.asm):00165                             leax      >$0100,y  ; check top of next 256 block
                      (es/kernel/krn.asm):00166                             cmpx      ,s        ; stop short kernel
                      (es/kernel/krn.asm):00167                             bcs       ChkRAM    ; branch if not done
                      (es/kernel/krn.asm):00168                             leay      ,x        ; point Y to X (end of RAM)
003E.                 (es/kernel/krn.asm):00169         EndOfRAM@           leax      ,y        ; X = end of RAM
                      (es/kernel/krn.asm):00170                             leas      2,s       ; adjust stack pointer by 2,s
                      (es/kernel/krn.asm):00171         *]]] CHECK_FOR_VALID_RAM
                      (es/kernel/krn.asm):00172                           ELSE
                      (es/kernel/krn.asm):00173         *[[[ NOT(CHECK_FOR_VALID_RAM)
                      (es/kernel/krn.asm):00174                           IFNE    wildbits ; begin conditional assembly for wildbits
                      (es/kernel/krn.asm):00175         *[[[ Wildbits port
                      (es/kernel/krn.asm):00176         * NOTE: Krn must be the FIRST module in the bootlist.
                      (es/kernel/krn.asm):00177                             puls      x         ; get bootfile start
                      (es/kernel/krn.asm):00178                             tfr       x,d       ; transfer it to D
                      (es/kernel/krn.asm):00179                             addd      ,s++      ; add the bootfile length to D
                      (es/kernel/krn.asm):00180                             std       <D.BTHI   ; save as the bootfile high marker
                      (es/kernel/krn.asm):00181                             stx       <D.BTLO   ; and x as the bootfile low marker
                      (es/kernel/krn.asm):00182         *]]] Wildbits port
                      (es/kernel/krn.asm):00183                           ELSE
                      (es/kernel/krn.asm):00184         *[[[ NOT(Wildbits port)
                      (es/kernel/krn.asm):00185         * Check for valid RAM starting at $400
003E 8EE100           (es/kernel/krn.asm):00186                             ldx       #Bt.Start ; end at bootfile start
                      (es/kernel/krn.asm):00187         *]]] NOT(Wildbits port)
                      (es/kernel/krn.asm):00188         *]]] NOT(CHECK_FOR_VALID_RAM)
                      (es/kernel/krn.asm):00189                           ENDC
                      (es/kernel/krn.asm):00190                           ENDC
0041 9F24             (es/kernel/krn.asm):00191                             stx       <D.MLIM   ; save off as the memory limit
                      (es/kernel/krn.asm):00192         
                      (es/kernel/krn.asm):00193                           IFNE    wildbits ; begin conditional assembly for wildbits
                      (es/kernel/krn.asm):00194         *[[[ Wildbits port
                      (es/kernel/krn.asm):00195         * X = top of Krn, so start searching for modules there.
                      (es/kernel/krn.asm):00196         *]]] Wildbits port
                      (es/kernel/krn.asm):00197                           ENDC
                      (es/kernel/krn.asm):00198         
                      (es/kernel/krn.asm):00199         * Copy vector code over to D.XSWI3 ($0100).
0043 3410             (es/kernel/krn.asm):00200                             pshs      x         ; save off X
0045 308D075E         (es/kernel/krn.asm):00201                             leax      >VectCode,pcr ; point X to vector code
0049 108E0100         (es/kernel/krn.asm):00202                             ldy       #D.XSWI3  ; point Y to vector base in low RAM
004D C629             (es/kernel/krn.asm):00203                             ldb       #VectCSz  ; get size of vector code in B
004F A680             (es/kernel/krn.asm):00204         loop@               lda       ,x+       ; get source byte
0051 A7A0             (es/kernel/krn.asm):00205                             sta       ,y+       ; save in destination
0053 5A               (es/kernel/krn.asm):00206                             decb                ; decrement counter
0054 26F9             (es/kernel/krn.asm):00207                             bne       loop@     ; branch if not done
0056 3510             (es/kernel/krn.asm):00208                             puls      x         ; recover the saved RAM upper limit
                      (es/kernel/krn.asm):00209         
                      (es/kernel/krn.asm):00210         * Atari has bootfile already in memory
                      (es/kernel/krn.asm):00211                           IFNE    atari   ; begin conditional assembly for atari
