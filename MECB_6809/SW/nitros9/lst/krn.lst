                      (        flink.asm):00156         
02CB.                 (        flink.asm):00157         FLinkMemBlksProc    lbsr      FFreehbTheseOnto ; copy memory blocks into process DAT image
02CB.                 (        flink.asm):00158         FLinkMemBlkLink     ldb       #P$Links  ; point to memory block link counts
                      (        flink.asm):00159                             abx                 ; smaller and faster than leax P$Links,x
