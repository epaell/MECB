                      (      fvmodul.asm):00554                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00555                             decw                ; dec # bytes left to calculate CRC with
                      (      fvmodul.asm):00556                           ELSE
                      (      fvmodul.asm):00557                             ldd       3,s       ; load D from 3,s
                      (      fvmodul.asm):00558                             subd      #$0001    ; subtract #$0001 from D
                      (      fvmodul.asm):00559                             std       3,s       ; store D at 3,s
                      (      fvmodul.asm):00560                           ENDC
