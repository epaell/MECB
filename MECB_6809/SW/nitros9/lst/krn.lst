                      (es/kernel/krn.asm):00001         ********************************************************************
                      (es/kernel/krn.asm):00002         * Krn - NitrOS-9 Level 1 Kernel
                      (es/kernel/krn.asm):00003         *
                      (es/kernel/krn.asm):00004         * This is how the memory map looks after the kernel has initialized:
                      (es/kernel/krn.asm):00005         *
                      (es/kernel/krn.asm):00006         *     $0000----> ==================================
                      (es/kernel/krn.asm):00007         *               |                                  |
                      (es/kernel/krn.asm):00008         *               |                                  |
                      (es/kernel/krn.asm):00009         *  $0020-$0111  |  System Globals (D.FMBM-D.XNMI)  |
                      (es/kernel/krn.asm):00010         *               |                                  |
                      (es/kernel/krn.asm):00011         *               |                                  |
                      (es/kernel/krn.asm):00012         *     $0200---->|==================================|
                      (es/kernel/krn.asm):00013         *               |        Free Memory Bitmap        |
                      (es/kernel/krn.asm):00014         *  $0200-$021F  |     (1 bit = 256 byte page)      |
                      (es/kernel/krn.asm):00015         *               |----------------------------------|
                      (es/kernel/krn.asm):00016         *  $0220-$0221  |      IOMan I/O Call Pointer      |
                      (es/kernel/krn.asm):00017         *               |----------------------------------|
                      (es/kernel/krn.asm):00018         *               |      System Dispatch Table       |
                      (es/kernel/krn.asm):00019         *  $0222-$0291  |     (Room for 56 addresses)      |
                      (es/kernel/krn.asm):00020         *               |----------------------------------|
                      (es/kernel/krn.asm):00021         *  $0292-$02FF  |       User Dispatch Table        |
                      (es/kernel/krn.asm):00022         *               |     (Room for 56 addresses)      |
                      (es/kernel/krn.asm):00023         *     $0300---->|==================================|
                      (es/kernel/krn.asm):00024         *               |                                  |
                      (es/kernel/krn.asm):00025         *               |                                  |
                      (es/kernel/krn.asm):00026         *  $0300-$03FF  |     Module Directory Entries     |
                      (es/kernel/krn.asm):00027         *               |      (Room for 64 entries)       |
                      (es/kernel/krn.asm):00028         *               |                                  |
                      (es/kernel/krn.asm):00029         *     $0400---->|==================================|
                      (es/kernel/krn.asm):00030         *               |                                  |
                      (es/kernel/krn.asm):00031         *  $0400-$04FF  |           System Stack           |
                      (es/kernel/krn.asm):00032         *               |                                  |
                      (es/kernel/krn.asm):00033         *     $0500---->|==================================|
                      (es/kernel/krn.asm):00034         *               |                                  |
                      (es/kernel/krn.asm):00035         *               |                                  |
                      (es/kernel/krn.asm):00036         *               |                                  |
                      (es/kernel/krn.asm):00037         *  $0500-$08FF  |    Screen Memory (Atari Only)    |
                      (es/kernel/krn.asm):00038         *               |                                  |
                      (es/kernel/krn.asm):00039         *               |                                  |
                      (es/kernel/krn.asm):00040         *               |                                  |
                      (es/kernel/krn.asm):00041         *     $0900---->|==================================|
                      (es/kernel/krn.asm):00042         *
                      (es/kernel/krn.asm):00043         * Edt/Rev  YYYY/MM/DD  Modified by
                      (es/kernel/krn.asm):00044         * Comment
                      (es/kernel/krn.asm):00045         * ------------------------------------------------------------------
                      (es/kernel/krn.asm):00046         *  14      1985/??/??
                      (es/kernel/krn.asm):00047         * From Tandy OS-9 Level One VR 02.00.00
                      (es/kernel/krn.asm):00048         *
                      (es/kernel/krn.asm):00049         *  15      2002/07/21  Boisy G. Pitre
                      (es/kernel/krn.asm):00050         * Module validation consists only of module header parity check.
                      (es/kernel/krn.asm):00051         * CRC check is not done unless D.CRC is set to 1, which is NOT the
                      (es/kernel/krn.asm):00052         * default case.  By default, D.CRC is set to 0, thus there is no
                      (es/kernel/krn.asm):00053         * CRC checking.  Speeds up module loads quite a bit. The Init module
                      (es/kernel/krn.asm):00054         * has a bit in a compatibility byte that can turn on/off CRC checking
                      (es/kernel/krn.asm):00055         *
                      (es/kernel/krn.asm):00056         *  15r1    2003/12/09  Boisy G. Pitre
                      (es/kernel/krn.asm):00057         * Kernel no longer scans for modules in I/O space.  Also, F$PrsNam now
                      (es/kernel/krn.asm):00058         * allows _ and 0-9 as first chars of a filename.
                      (es/kernel/krn.asm):00059         *
                      (es/kernel/krn.asm):00060         *  15r1    2004/05/23  Boisy G. Pitre
                      (es/kernel/krn.asm):00061         * Renamed to 'krn'
                      (es/kernel/krn.asm):00062         *
                      (es/kernel/krn.asm):00063         *  16      2004/05/23  Boisy G. Pitre
                      (es/kernel/krn.asm):00064         * Added changes for Atari port
                      (es/kernel/krn.asm):00065         
                      (es/kernel/krn.asm):00066                             nam       krn
                      (es/kernel/krn.asm):00067                             ttl       NitrOS-9 Level 1 Kernel
                      (es/kernel/krn.asm):00068         
                      (es/kernel/krn.asm):00069                             use       defsfile  ; include source file defsfile
     0001             (         defsfile):00001         Level    equ   1
                      (         defsfile):00002         
                      (         defsfile):00003                  use   os9.d
                      (            os9.d):00001                             IFNE      OS9.D-1
                      (            os9.d):00002         
     0001             (            os9.d):00003         OS9.D               SET       1
                      (            os9.d):00004         
