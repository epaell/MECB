                      (      fvmodul.asm):00473         * Entry: X=Block offset of module
                      (      fvmodul.asm):00474         *        Y=DAT image pointer of module
03E8.                 (      fvmodul.asm):00475         FVmodulBlkOffDAT2   pshs      x,y       ; save block offset & DAT pointer
                      (      fvmodul.asm):00476                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00477                             clrd                ; m$ID offset
                      (      fvmodul.asm):00478                           ELSE
                      (      fvmodul.asm):00479                             clra                ; m$ID offset
