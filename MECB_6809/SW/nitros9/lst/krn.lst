                      (      fvmodul.asm):00404                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00405                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00406                             lsra                ; shift or rotate and update condition codes
