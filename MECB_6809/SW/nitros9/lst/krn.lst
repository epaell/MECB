                      (        flink.asm):00132                             ldd       MD$MBSiz,x ; get block size
                      (        flink.asm):00133                             addd      #$1FFF    ; round it up
                      (        flink.asm):00134                             tfr       a,b       ; transfer register value a,b
                      (        flink.asm):00135                             lsrb                ; shift or rotate and update condition codes
                      (        flink.asm):00136                             lsrb                ; shift or rotate and update condition codes
                      (        flink.asm):00137                             lsrb                ; shift or rotate and update condition codes
                      (        flink.asm):00138                             lsrb                ; shift or rotate and update condition codes
                      (        flink.asm):00139                             lsrb                ; shift or rotate and update condition codes
                      (        flink.asm):00140         *         adda   #$02
                      (        flink.asm):00141                             lsra                ; shift or rotate and update condition codes
                      (        flink.asm):00142                             inca                ; instead of adda #2, above
                      (        flink.asm):00143                             lsra                ; shift or rotate and update condition codes
                      (        flink.asm):00144                             lsra                ; shift or rotate and update condition codes
                      (        flink.asm):00145                             lsra                ; shift or rotate and update condition codes
                      (        flink.asm):00146                             lsra                ; shift or rotate and update condition codes
                      (        flink.asm):00147                             pshs      a         ; save a on the stack
                      (        flink.asm):00148                             leau      ,y        ; point to module DAT image
                      (        flink.asm):00149                             bsr       FLinkProcess ; is it already linked in process space?
                      (        flink.asm):00150                             bcc       FLinkMemBlkLink ; yes, skip ahead
                      (        flink.asm):00151                             lda       ,s        ; load A from ,s
                      (        flink.asm):00152                             lbsr      FFreehbInvertWithin ; find free low block in process DAT image
                      (        flink.asm):00153                             bcc       FLinkMemBlksProc ; found some, skip ahead
