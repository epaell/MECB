                      (      fvmodul.asm):00332                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00333                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00334                             lsra                ; shift or rotate and update condition codes
                      (      fvmodul.asm):00335                             ldy       MD$MPDAT,u ; load Y from MD$MPDAT,u
