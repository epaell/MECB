                      (es/kernel/krn.asm):00570                             use       flink.asm ; include source file flink.asm
                      (        flink.asm):00001         ;;; F$Link
                      (        flink.asm):00002         ;;;
                      (        flink.asm):00003         ;;; Link to a memory module that has the specified name, language, and type.
                      (        flink.asm):00004         ;;;
                      (        flink.asm):00005         ;;; Entry: A = The desired type/language byte.
                      (        flink.asm):00006         ;;;        X = The address of the desired module name.
                      (        flink.asm):00007         ;;;
                      (        flink.asm):00008         ;;; Exit:  A = The module's type/language byte.
                      (        flink.asm):00009         ;;;        B = The module's attributes/revision byte.
                      (        flink.asm):00010         ;;;        X = The address of the last byte of the module name, plus 1.
                      (        flink.asm):00011         ;;;        Y = The address of the module’s execution entry point.
                      (        flink.asm):00012         ;;;        U = The address of the module header.
                      (        flink.asm):00013         ;;;       CC = Carry flag clear to indicate no error.
                      (        flink.asm):00014         ;;;
                      (        flink.asm):00015         ;;; Error:  B = A non-zero error code.
                      (        flink.asm):00016         ;;;        CC = Carry flag set to indicate error.
                      (        flink.asm):00017         ;;;
                      (        flink.asm):00018         ;;; A module's link count indicates how many processes are using it. F$Link increases the module’s
                      (        flink.asm):00019         ;;; link count count by one. If the module requested isn't shareable (not re-entrant), only one process
                      (        flink.asm):00020         ;;; can link to it at a time, and any additional link attempts return E$ModBsy.
                      (        flink.asm):00021         ;;;
                      (        flink.asm):00022         ;;; F$Link searches the module directory for a module that has the specified name, language, and type.
                      (        flink.asm):00023         ;;; If it finds the module, it returns the address of the module’s header in U, and the absolute address of the
                      (        flink.asm):00024         ;;; module’s execution entry point in Y. If F$Link can't find the desired module, it returns E$MNF.
                      (        flink.asm):00025                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (        flink.asm):00026         
0295 3440             (        flink.asm):00027         FLink               pshs      u         ; save caller regs
0297 EC41             (        flink.asm):00028                             ldd       R$A,u     ; get desired type/language byte
0299 AE44             (        flink.asm):00029                             ldx       R$X,u     ; get pointer to desired module name to link to
029B 17002D           (        flink.asm):00030                             lbsr      FindModule ; go find the module
029E 2404             (        flink.asm):00031                             bcc       ok@       ; branch if found
02A0 C6DD             (        flink.asm):00032                             ldb       #E$MNF    ; ...else Module Not Found error
02A2 2025             (        flink.asm):00033                             bra       ex@       ; and return to caller
02A4 10AEC4           (        flink.asm):00034         ok@                 ldy       MD$MPtr,u ; get module directory ptr
02A7 E627             (        flink.asm):00035                             ldb       M$Revs,y  ; get revision byte
02A9 C580             (        flink.asm):00036                             bitb      #ReEnt    ; reentrant?
02AB 2609             (        flink.asm):00037                             bne       inc@      ; branch if so
02AD 6D42             (        flink.asm):00038                             tst       MD$Link,u ; link count zero?
02AF 2705             (        flink.asm):00039                             beq       inc@      ; yep, ok to link to non-reentrant
02B1 53               (        flink.asm):00040                             comb                ; ...else set carry
02B2 C6D1             (        flink.asm):00041                             ldb       #E$ModBsy ; load B with Module Busy
02B4 2013             (        flink.asm):00042                             bra       ex@       ; and return to caller
02B6 6C42             (        flink.asm):00043         inc@                inc       MD$Link,u ; increment link count
02B8 EEE4             (        flink.asm):00044                             ldu       ,s        ; get caller register pointer from stack
02BA AF44             (        flink.asm):00045                             stx       R$X,u     ; save off updated name pointer
02BC 10AF48           (        flink.asm):00046                             sty       R$U,u     ; save off address of found module
02BF EC26             (        flink.asm):00047                             ldd       M$Type,y  ; get type/language byte from found module
02C1 ED41             (        flink.asm):00048                             std       R$D,u     ; and place it in caller's D register
02C3 EC29             (        flink.asm):00049                             ldd       M$IDSize,y ; get the module ID size in D
02C5 30AB             (        flink.asm):00050                             leax      d,y       ; advance X to the start of the body of the module
02C7 AF46             (        flink.asm):00051                             stx       R$Y,u     ; store X in caller's Y register
02C9 35C0             (        flink.asm):00052         ex@                 puls      pc,u      ; return to caller
                      (        flink.asm):00053         
                      (        flink.asm):00054                           ELSE
                      (        flink.asm):00055         
                      (        flink.asm):00056         ;;; F$SLink
                      (        flink.asm):00057         ;;;
                      (        flink.asm):00058         ;;; Link to a memory module that has the specified name, language, and type.
                      (        flink.asm):00059         ;;;
                      (        flink.asm):00060         ;;; Entry: A = The desired type/language byte.
                      (        flink.asm):00061         ;;;        X = The address of the desired module name.
                      (        flink.asm):00062         ;;;        Y = The DAT image pointer to the name string.
                      (        flink.asm):00063         ;;;
                      (        flink.asm):00064         ;;; Exit:  A = The module's type/language byte.
                      (        flink.asm):00065         ;;;        B = The module's attributes/revision byte.
                      (        flink.asm):00066         ;;;        X = The address of the last byte of the module name, plus 1.
                      (        flink.asm):00067         ;;;        Y = The address of the module’s execution entry point.
                      (        flink.asm):00068         ;;;        U = The address of the module header.
                      (        flink.asm):00069         ;;;       CC = Carry flag clear to indicate no error.
                      (        flink.asm):00070         ;;;
                      (        flink.asm):00071         ;;; Error:  B = A non-zero error code.
                      (        flink.asm):00072         ;;;        CC = Carry flag set to indicate error.
                      (        flink.asm):00073         ;;;
                      (        flink.asm):00074         
02CB.                 (        flink.asm):00075         FSLink              ldy       R$Y,u     ; get DAT image pointer of name
                      (        flink.asm):00076                             bra       FLinkTarget ; skip ahead
                      (        flink.asm):00077         
                      (        flink.asm):00078         ;;; F$ELink
                      (        flink.asm):00079         ;;;
                      (        flink.asm):00080         ;;; Link to a memory module using the module directory entry.
                      (        flink.asm):00081         ;;;
                      (        flink.asm):00082         ;;; Entry: B = The module type.
                      (        flink.asm):00083         ;;;        X = The pointer to the module directory entry.
                      (        flink.asm):00084         ;;;
                      (        flink.asm):00085         ;;; Error:  B = A non-zero error code.
                      (        flink.asm):00086         ;;;        CC = Carry flag set to indicate error.
                      (        flink.asm):00087         ;;;
                      (        flink.asm):00088         
02CB.                 (        flink.asm):00089         FELink              pshs      u         ; preserve register stack pointer
                      (        flink.asm):00090                             ldb       R$B,u     ; get module type
