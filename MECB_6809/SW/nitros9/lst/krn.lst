                      (      fvmodul.asm):00636         **************************************************
                      (      fvmodul.asm):00637         * System Call: F$CRC
                      (      fvmodul.asm):00638         *
                      (      fvmodul.asm):00639         * Function: Compute CRC
                      (      fvmodul.asm):00640         *
                      (      fvmodul.asm):00641         * Input:  X = Address to start computation
                      (      fvmodul.asm):00642         *         Y = Byte count
                      (      fvmodul.asm):00643         *         U = Address of 3 byte CRC accumulator
                      (      fvmodul.asm):00644         *
                      (      fvmodul.asm):00645         * Output: CRC accumulator is updated
                      (      fvmodul.asm):00646         *
                      (      fvmodul.asm):00647         * Error:  CC = C bit set; B = error code
                      (      fvmodul.asm):00648         *
03E8.                 (      fvmodul.asm):00649         FCRC                ldd       R$Y,u     ; get # bytes to do
                      (      fvmodul.asm):00650                             beq       FVmodulError ; nothing there, so nothing to do, return
                      (      fvmodul.asm):00651                             ldx       R$X,u     ; get caller's buffer pointer
                      (      fvmodul.asm):00652                             pshs      d,x       ; save # bytes & buffer pointer
                      (      fvmodul.asm):00653                             leas      -3,s      ; allocate a 3 byte buffer
                      (      fvmodul.asm):00654                             ldx       <D.Proc   ; point to current process descriptor
                      (      fvmodul.asm):00655                             lda       P$Task,x  ; get its task number
                      (      fvmodul.asm):00656                             ldb       <D.SysTsk ; get the system task number
                      (      fvmodul.asm):00657                             ldx       R$U,u     ; point to user's 24 bit CRC accumulator
                      (      fvmodul.asm):00658                             ldy       #3        ; number of bytes to move
                      (      fvmodul.asm):00659                             leau      ,s        ; point to our temp buffer
                      (      fvmodul.asm):00660                             pshs      d,x,y     ; save [D]=task #'s,[X]=Buff,[Y]=3
                      (      fvmodul.asm):00661                             lbsr      FMoveTarget ; move CRC accumulator to temp buffer
                      (      fvmodul.asm):00662                             ldx       <D.Proc   ; point to current process descriptor
                      (      fvmodul.asm):00663                             leay      <P$DATImg,x ; point to its DAT image
                      (      fvmodul.asm):00664                             ldx       11,s      ; restore the buffer pointer
                      (      fvmodul.asm):00665                             lbsr      AdjBlk0   ; make callers buffer visible
                      (      fvmodul.asm):00666                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00667                             ldw       9,s       get byte count
                      (      fvmodul.asm):00668                           ENDC
03E8.                 (      fvmodul.asm):00669         FVmodulBuffer       lbsr      LDAXY     ; get byte from callers buffer
                      (      fvmodul.asm):00670                             bsr       CRCCalc   ; add it to CRC
                      (      fvmodul.asm):00671                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00672                             decw                ; done?
                      (      fvmodul.asm):00673                           ELSE
                      (      fvmodul.asm):00674                             ldd       9,s       ; load D from 9,s
                      (      fvmodul.asm):00675                             subd      #$0001    ; subtract #$0001 from D
                      (      fvmodul.asm):00676                             std       9,s       ; store D at 9,s
                      (      fvmodul.asm):00677                           ENDC
                      (      fvmodul.asm):00678                             bne       FVmodulBuffer ; no, keep going
                      (      fvmodul.asm):00679                             puls      d,x,y     ; restore pointers
                      (      fvmodul.asm):00680                             exg       a,b       ; swap around the task numbers
                      (      fvmodul.asm):00681                             exg       x,u       ; and the pointers
                      (      fvmodul.asm):00682                             lbsr      FMoveTarget ; move accumulator back to user
                      (      fvmodul.asm):00683                             leas      7,s       ; clean up stack
03E8.                 (      fvmodul.asm):00684         FVmodulError        clrb                ; no error
                      (      fvmodul.asm):00685                             rts                 ; return to caller
                      (      fvmodul.asm):00686         
                      (      fvmodul.asm):00687                           ENDC
                      (es/kernel/krn.asm):00572                             use       fcrc.asm  ; include source file fcrc.asm
                      (         fcrc.asm):00001         ;;; F$CRC
                      (         fcrc.asm):00002         ;;;
                      (         fcrc.asm):00003         ;;; Compute the CRC of bytes in memory.
                      (         fcrc.asm):00004         ;;;
                      (         fcrc.asm):00005         ;;; Entry:  X = The starting address.
                      (         fcrc.asm):00006         ;;;         Y = The number of bytes.
                      (         fcrc.asm):00007         ;;;         U = The address of the 3 byte accumulator.
                      (         fcrc.asm):00008         ;;;
                      (         fcrc.asm):00009         ;;; Exit:   U = The address of the updated 3 byte accumulator.
                      (         fcrc.asm):00010         ;;;
                      (         fcrc.asm):00011         ;;; F$CRC calculates the Cyclic Redundancy Count (CRC) of a series of bytes in memory.
                      (         fcrc.asm):00012         ;;; Compilers, assemblers, and other module generators use this system call.
                      (         fcrc.asm):00013         ;;; The calculation begins at the starting address and continues over the specified number of bytes.
                      (         fcrc.asm):00014         ;;; You don't need to cover an entire module in one call since the CRC accumulates over several calls.
                      (         fcrc.asm):00015         ;;; The CRC accumulator can be any 3-byte memory area. You must initialize it to $FFFFFF before the first F$CRC call.
                      (         fcrc.asm):00016         ;;; The updated accumulator doesn't include the last three bytes of the module. The 3 CRC bytes are stored there.
                      (         fcrc.asm):00017         ;;; Initialize the CRC accumulator only once for each module check.
                      (         fcrc.asm):00018         
03E8 AE44             (         fcrc.asm):00019         FCRC                ldx       R$X,u     ; get the starting address in X
03EA 10AE46           (         fcrc.asm):00020                             ldy       R$Y,u     ; and the number of bytes in Y
03ED 270A             (         fcrc.asm):00021                             beq       FCRCEx    ; if number of bytes is zero, return
03EF EE48             (         fcrc.asm):00022                             ldu       R$U,u     ; get the address of the 3 byte accumulator in U
03F1 A680             (         fcrc.asm):00023         FCRCLoop            lda       ,x+       ; get the next byte at X and increment X
03F3 8D06             (         fcrc.asm):00024                             bsr       CRCAlgo   ; perform the CRC algorithm
03F5 313F             (         fcrc.asm):00025                             leay      -1,y      ; decrement the count
03F7 26F8             (         fcrc.asm):00026                             bne       FCRCLoop  ; branch if there are more bytes
03F9 5F               (         fcrc.asm):00027         FCRCEx              clrb                ; clear the error code and carry
03FA 39               (         fcrc.asm):00028                             rts                 ; return to the caller
                      (         fcrc.asm):00029         
03FB A8C4             (         fcrc.asm):00030         CRCAlgo             eora      ,u        ; xOR A with first byte of accumulator
03FD 3402             (         fcrc.asm):00031                             pshs      a         ; push the result
03FF EC41             (         fcrc.asm):00032                             ldd       $01,u     ; get the second and third bytes of the accumulator
0401 EDC4             (         fcrc.asm):00033                             std       ,u        ; save in the first and second accumulator locations
0403 4F               (         fcrc.asm):00034                             clra                ; clear A
0404 E6E4             (         fcrc.asm):00035                             ldb       ,s        ; get XOR'ed value pushed earlier
0406 58               (         fcrc.asm):00036                             lslb                ; left shift B
0407 49               (         fcrc.asm):00037                             rola                ; left roll A
0408 A841             (         fcrc.asm):00038                             eora      1,u       ; xOR A with the second byte of the accumulator
040A ED41             (         fcrc.asm):00039                             std       1,u       ; and store D in the second and third bytes of the accumulator
040C 5F               (         fcrc.asm):00040                             clrb                ; clear B
040D A6E4             (         fcrc.asm):00041                             lda       ,s        ; get the XOR'ed value pushed earlier
040F 44               (         fcrc.asm):00042                             lsra                ; right shift A
0410 56               (         fcrc.asm):00043                             rorb                ; right roll B
0411 44               (         fcrc.asm):00044                             lsra                ; right shift A
0412 56               (         fcrc.asm):00045                             rorb                ; right roll B
0413 A841             (         fcrc.asm):00046                             eora      1,u       ; xOR A with the second byte of the accumulator
0415 E842             (         fcrc.asm):00047                             eorb      2,u       ; xOR B with the third byte of the accumulator
0417 ED41             (         fcrc.asm):00048                             std       1,u       ; store the result in the second and third bytes of the accumulator
0419 A6E4             (         fcrc.asm):00049                             lda       ,s        ; get the XOR'ed value pushed earlier
041B 48               (         fcrc.asm):00050                             lsla                ; left shift A
041C A8E4             (         fcrc.asm):00051                             eora      ,s        ; xOR A with the XOR'ed value pushed earlier
041E A7E4             (         fcrc.asm):00052                             sta       ,s        ; and update the value on the stack
0420 48               (         fcrc.asm):00053                             lsla                ; left shift A
0421 48               (         fcrc.asm):00054                             lsla                ; left shift A
0422 A8E4             (         fcrc.asm):00055                             eora      ,s        ; xOR A with the XOR'ed value pushed earlier
0424 A7E4             (         fcrc.asm):00056                             sta       ,s        ; and update the value on the stack
0426 48               (         fcrc.asm):00057                             lsla                ; left shift A
0427 48               (         fcrc.asm):00058                             lsla                ; left shift A
0428 48               (         fcrc.asm):00059                             lsla                ; left shift A
0429 48               (         fcrc.asm):00060                             lsla                ; left shift A
042A A8E0             (         fcrc.asm):00061                             eora      ,s+       ; xOR A with the XOR'ed value pushed earlier and pop the value
042C 2A0B             (         fcrc.asm):00062                             bpl       ex@       ; branch if the hi-bit is clear
042E CC8021           (         fcrc.asm):00063                             ldd       #$8021    ; else load D with this value
0431 A8C4             (         fcrc.asm):00064                             eora      ,u        ; xOR A with the first byte of the accumulator
0433 A7C4             (         fcrc.asm):00065                             sta       ,u        ; and save the result to the first byte of the accumulator
0435 E842             (         fcrc.asm):00066                             eorb      2,u       ; xOR B with the third byte of the accumulator
0437 E742             (         fcrc.asm):00067                             stb       2,u       ; and save the result to the third byte of the accumulator
0439 39               (         fcrc.asm):00068         ex@                 rts                 ; return to the caller
                      (es/kernel/krn.asm):00573                             use       ffork.asm ; include source file ffork.asm
                      (        ffork.asm):00001         ;;; F$Fork
                      (        ffork.asm):00002         ;;;
                      (        ffork.asm):00003         ;;; Links or loads a module and create a new process.
                      (        ffork.asm):00004         ;;;
                      (        ffork.asm):00005         ;;; Entry:  A = The type/language byte.
                      (        ffork.asm):00006         ;;;         B = Size of the optional data area (in pages).
                      (        ffork.asm):00007         ;;;         X = Address of the module name or filename.
                      (        ffork.asm):00008         ;;;         Y = Size of the parameter area (in bytes). The default is 0.
                      (        ffork.asm):00009         ;;;         U = Starting address of the parameter area. This must be at least one page.
                      (        ffork.asm):00010         ;;;
                      (        ffork.asm):00011         ;;; Exit:   A = New process I/O number.
                      (        ffork.asm):00012         ;;;         X = Address of the last byte of the name plus 1.
                      (        ffork.asm):00013         ;;;        CC = Carry flag clear to indicate success.
                      (        ffork.asm):00014         ;;;
                      (        ffork.asm):00015         ;;; Error:  B = A non-zero error code.
                      (        ffork.asm):00016         ;;;        CC = Carry flag set to indicate error.
                      (        ffork.asm):00017         ;;;
                      (        ffork.asm):00018         ;;; F$Fork creates a new child process of the calling process. It also sets up the child process’ memory,
                      (        ffork.asm):00019         ;;; 6809 registers, and standard I/O paths.
                      (        ffork.asm):00020         ;;;
                      (        ffork.asm):00021         ;;; Upon success, X hold the address of the character past the name. For example, before the call:
                      (        ffork.asm):00022         ;;;
                      (        ffork.asm):00023         ;;;   X
                      (        ffork.asm):00024         ;;;  _|__________________
                      (        ffork.asm):00025         ;;; | T | E | S | T | \n |
                      (        ffork.asm):00026         ;;;  --------------------
                      (        ffork.asm):00027         ;;;
                      (        ffork.asm):00028         ;;; And after the call:
                      (        ffork.asm):00029         ;;;
                      (        ffork.asm):00030         ;;;                    X
                      (        ffork.asm):00031         ;;;  __________________|_
                      (        ffork.asm):00032         ;;; | T | E | S | T | \n |
                      (        ffork.asm):00033         ;;;  --------------------
                      (        ffork.asm):00034         ;;;
                      (        ffork.asm):00035         ;;; When the system call starts, it parses the passed name, then searches
                      (        ffork.asm):00036         ;;; the module directory to see if the module is already in memory. If it is,
                      (        ffork.asm):00037         ;;; then F$Fork calls F$Link and inserts it into the active process queue.
                      (        ffork.asm):00038         ;;;
                      (        ffork.asm):00039         ;;; If F$Link fails, then F$Fork calls F$Load to load the module from the current execution directory on the disk.
                      (        ffork.asm):00040         ;;; It looks for a filename that matches the address of module name passed in X. If more than one module exists in the
                      (        ffork.asm):00041         ;;; file, only the first one has its link count set. The first module in a file is the primary module.
                      (        ffork.asm):00042         ;;;
                      (        ffork.asm):00043         ;;; F$Fork then inspects the primary module to determine its data area, then allocates contiguous RAM for that amount.
                      (        ffork.asm):00044         ;;; If the allocation succeeds, F$Fork copies the parameters at U into the data area, then sets the registers for the
                      (        ffork.asm):00045         ;;; child process like this:
                      (        ffork.asm):00046         ;;;
                      (        ffork.asm):00047         ;;;   ------------------  <- Y (Highest address)
                      (        ffork.asm):00048         ;;;  |  Parameter area  |
                      (        ffork.asm):00049         ;;;  |------------------| <- X, SP
                      (        ffork.asm):00050         ;;;  |                  |
                      (        ffork.asm):00051         ;;;  |     Data area    |
                      (        ffork.asm):00052         ;;;  |                  |
                      (        ffork.asm):00053         ;;;  |------------------|
                      (        ffork.asm):00054         ;;;  |                  |
                      (        ffork.asm):00055         ;;;  |    Direct page   |
                      (        ffork.asm):00056         ;;;  |                  |
                      (        ffork.asm):00057         ;;;   ------------------  <- U, DP (Lowest address)
                      (        ffork.asm):00058         ;;;
                      (        ffork.asm):00059         ;;; D holds the size of the parameter area in bytes, the PC points to the primary module's execution entry point, and
                      (        ffork.asm):00060         ;;; CC's FIRQ and IRQ mask flags are clear.
                      (        ffork.asm):00061         ;;;
                      (        ffork.asm):00062         ;;; Registers Y and U (the top-of-memory and bottom-of-memory pointers, respectively) always have values at page
                      (        ffork.asm):00063         ;;; boundaries.
                      (        ffork.asm):00064         ;;; If the parent process doesn't specify the size of the parameter area, the size defaults to zero.
                      (        ffork.asm):00065         ;;; The minimum data area size is one page.
                      (        ffork.asm):00066         ;;;
                      (        ffork.asm):00067         ;;; When the shell processes a command line, it passes a string in the parameter area. The string is a copy of the parameter
                      (        ffork.asm):00068         ;;; part of the command line. To simplify string-oriented processing, the shell also inserts an end-of-line character at the
                      (        ffork.asm):00069         ;;; end of the parameter string.
                      (        ffork.asm):00070         ;;;
                      (        ffork.asm):00071         ;;; X points to the starting byte of the parameter string. If the command line includes the optional memory size specification
                      (        ffork.asm):00072         ;;; (#n or #nK), the shell passes that size as the requested memory size when executing F$Fork.
                      (        ffork.asm):00073         ;;;
                      (        ffork.asm):00074         ;;; If any part of F$Fork is unsuccessful, it terminates and returns an error to the caller.
                      (        ffork.asm):00075         ;;;
                      (        ffork.asm):00076         ;;; The child and parent processes execute at the same time unless the parent calls F$Wait immediately after F$Fork.
                      (        ffork.asm):00077         ;;; In this case, the parent waits until the child dies before it resumes execution.
                      (        ffork.asm):00078         ;;;
                      (        ffork.asm):00079         ;;; Be careful when recursively calling a program that uses F$Fork. Another new child process appears with each new execution
                      (        ffork.asm):00080         ;;; and continues until the process table becomes full.
                      (        ffork.asm):00081         ;;;
                      (        ffork.asm):00082         ;;; Don't call F$Fork with a memory size of zero.
                      (        ffork.asm):00083         
                      (        ffork.asm):00084                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (        ffork.asm):00085         
043A 9E49             (        ffork.asm):00086         FFork               ldx       <D.PrcDBT ; get the pointer to the process descriptor table
043C 103F30           (        ffork.asm):00087                             os9       F$All64   ; allocate a 64 byte page of RAM
043F 256C             (        ffork.asm):00088                             bcs       errex@    ; branch if error
0441 9E4B             (        ffork.asm):00089                             ldx       <D.Proc   ; get the parent (current) process descriptor
0443 3410             (        ffork.asm):00090                             pshs      x         ; save it on the stack
0445 EC09             (        ffork.asm):00091                             ldd       P$User,x  ; get the user ID of the parent process
0447 ED29             (        ffork.asm):00092                             std       P$User,y  ; save it in the child process descriptor
0449 A60B             (        ffork.asm):00093                             lda       P$Prior,x ; get the priority of the parent process
044B 5F               (        ffork.asm):00094                             clrb                ; B = 0
044C ED2B             (        ffork.asm):00095                             std       P$Prior,y ; store it in the child process descriptor
044E C680             (        ffork.asm):00096                             ldb       #SysState ; get system state flag into B
0450 E72D             (        ffork.asm):00097                             stb       P$State,y ; set the System State flag in the child process descriptor
0452 109F4B           (        ffork.asm):00098                             sty       <D.Proc   ; make the child process the current process
                      (        ffork.asm):00099         **** I/O related process descriptor setup
0455 EC883B           (        ffork.asm):00100                             ldd       <P$NIO,x  ; get the parent process' Net I/O pointer
0458 EDA83B           (        ffork.asm):00101                             std       <P$NIO,y  ; save it in the child process descriptor
045B EC883D           (        ffork.asm):00102                             ldd       <P$NIO+2,x ; copy next two bytes
045E EDA83D           (        ffork.asm):00103                             std       <P$NIO+2,y ; over to child process descriptor
0461 30881A           (        ffork.asm):00104                             leax      <P$DIO,x  ; point X to the the parent process' Disk I/O section
0464 31A81A           (        ffork.asm):00105                             leay      <P$DIO,y  ; point Y to the child process' Disk I/O section
0467 C60C             (        ffork.asm):00106                             ldb       #DefIOSiz ; get the size of the section
0469 A680             (        ffork.asm):00107         loop@               lda       ,x+       ; get byte at x and increment
046B A7A0             (        ffork.asm):00108                             sta       ,y+       ; save byte at y and increment
