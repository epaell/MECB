                      (      fsrqmem.asm):00001                           IFEQ    Level-1 ; begin conditional assembly for Level-1
                      (      fsrqmem.asm):00002         
                      (      fsrqmem.asm):00003         ;;; F$SRqMem
                      (      fsrqmem.asm):00004         ;;;
                      (      fsrqmem.asm):00005         ;;; Allocate one or more pages of memory.
                      (      fsrqmem.asm):00006         ;;;
                      (      fsrqmem.asm):00007         ;;; Entry:  D = The number of bytes to allocate.
                      (      fsrqmem.asm):00008         ;;;
                      (      fsrqmem.asm):00009         ;;; Exit:   D = The number of bytes allocated.
                      (      fsrqmem.asm):00010         ;;;         U = The address of the newly allocated area.
                      (      fsrqmem.asm):00011         ;;;        CC = Carry flag clear to indicate success.
                      (      fsrqmem.asm):00012         ;;;
                      (      fsrqmem.asm):00013         ;;; Error:  B = A non-zero error code.
                      (      fsrqmem.asm):00014         ;;;        CC = Carry flag set to indicate error.
                      (      fsrqmem.asm):00015         ;;;
                      (      fsrqmem.asm):00016         ;;; F$SRqMem allocates contiguous memory from the system in 256 byte pages. There are 256 of these 256 byte pages
                      (      fsrqmem.asm):00017         ;;; in the entire address space. It returns memory from the top of the system RAM map down, and rounds the size
                      (      fsrqmem.asm):00018         ;;; request to the next 256 byte page boundary.
                      (      fsrqmem.asm):00019         
                      (      fsrqmem.asm):00020         **************************************************
                      (      fsrqmem.asm):00021         * F$SRqMem - Level 1 implementation
                      (      fsrqmem.asm):00022         *
057F EC41             (      fsrqmem.asm):00023         FSRqMem             ldd       R$D,u     ; get memory allocation size requested from the caller's D
0581 C300FF           (      fsrqmem.asm):00024                             addd      #$00FF    ; round it up to nearest 256 byte page (e.g. $1FF = $2FE)
0584 5F               (      fsrqmem.asm):00025                             clrb                ; just keep # of pages (e.g. $2FE = $200)
0585 ED41             (      fsrqmem.asm):00026                             std       R$D,u     ; save rounded version back to caller's D
                      (      fsrqmem.asm):00027         * Start searching from the top of free memory allocation bitmap down, searching for 'D' contiguous bits
0587 9E22             (      fsrqmem.asm):00028                             ldx       <D.FMBM+2 ; get the pointer to the end of the free memory allocation bitmap
0589 CC01FF           (      fsrqmem.asm):00029                             ldd       #$01FF    ; A = $01 (RAM IN USE flag), B = $FF ("first free 256 byte page")
058C 3406             (      fsrqmem.asm):00030                             pshs      b,a       ; save the values on stack
     0000             (      fsrqmem.asm):00031         _stk1A@             set       0         ; bit flag indicating RAM IN USE
     0001             (      fsrqmem.asm):00032         _stk1B@             set       1         ; offset to first free 256 byte page (assuming enough memory is found)
     0002             (      fsrqmem.asm):00033         _stk1L@             set       2         ; length of stack
058E 200A             (      fsrqmem.asm):00034                             bra       top@      ; start the search
0590 6A61             (      fsrqmem.asm):00035         loop@               dec       _stk1B@,s ; decrement "first free 256 byte page" value on stack
0592 E661             (      fsrqmem.asm):00036                             ldb       _stk1B@,s ; and load it into B
0594 68E4             (      fsrqmem.asm):00037         nextbit@            lsl       _stk1A@,s ; shift left: bit 7 of _stk1A goes in carry, 0 goes in bit 0 of _stk1A
0596 2408             (      fsrqmem.asm):00038                             bcc       checkbit@ ; branch if high bit in _stk1A was 0
0598 69E4             (      fsrqmem.asm):00039                             rol       _stk1A@,s ; put set carry in bit 0, put MSB of bit (1) in carry
059A 301F             (      fsrqmem.asm):00040         top@                leax      -1,x      ; backup into free memory bitmap
059C 9C20             (      fsrqmem.asm):00041                             cmpx      <D.FMBM   ; did we move past the beginning?
059E 2516             (      fsrqmem.asm):00042                             bcs       doalloc@  ; branch if so (carry set if X < D.FMBM)
05A0 A684             (      fsrqmem.asm):00043         checkbit@           lda       ,x        ; get byte in current location of free memory allocation bitmap
05A2 A4E4             (      fsrqmem.asm):00044                             anda      _stk1A@,s ; aND with mask on stack
05A4 26EA             (      fsrqmem.asm):00045                             bne       loop@     ; branch if not 0, meaning there are bits set in A (pages allocated) so continue searching
05A6 6A61             (      fsrqmem.asm):00046                             dec       _stk1B@,s ; decrement "first free 256 byte page" value on stack
05A8 E061             (      fsrqmem.asm):00047                             subb      _stk1B@,s ; subtract "first free 256 byte page" value on stack from B
05AA E141             (      fsrqmem.asm):00048                             cmpb      R$A,u     ; compare B to the requested number of pages in caller's A (may set carry)
05AC 46               (      fsrqmem.asm):00049                             rora                ; shift carry into A's bit 7, and bit 0 of A into carry (saves carry bit in bit 7 of A)
05AD EB61             (      fsrqmem.asm):00050                             addb      _stk1B@,s ; add back "first free 256 byte page" value on stack to B
05AF 49               (      fsrqmem.asm):00051                             rola                ; roll A's bit 7 into carry, and carry into A's bit 0 (restores original carry)
05B0 25E2             (      fsrqmem.asm):00052                             bcs       nextbit@  ; branch if the carry is set
05B2 E661             (      fsrqmem.asm):00053                             ldb       _stk1B@,s ; get the contiguous free memory bit count
05B4 4F               (      fsrqmem.asm):00054                             clra                ; clear A
05B5 5C               (      fsrqmem.asm):00055                             incb                ; increment B
05B6 3262             (      fsrqmem.asm):00056         doalloc@            leas      _stk1L@,s ; recover stack from earlier push
05B8 2511             (      fsrqmem.asm):00057                             bcs       ex@       ; branch if error
05BA 9E20             (      fsrqmem.asm):00058                             ldx       <D.FMBM   ; else get pointer to start of free memory bitmap
05BC 1F02             (      fsrqmem.asm):00059                             tfr       d,y       ; put D (number of first bit to set) into Y
05BE E641             (      fsrqmem.asm):00060                             ldb       R$A,u     ; get MSB into B (this will be bit count)
05C0 4F               (      fsrqmem.asm):00061                             clra                ; clear A; D now holds number of bits to set
05C1 1E02             (      fsrqmem.asm):00062                             exg       d,y       ; swap D and Y so that parameters are correct
                      (      fsrqmem.asm):00063         * X = address of allocation bitmap
                      (      fsrqmem.asm):00064         * D = Number of first bit to set
                      (      fsrqmem.asm):00065         * Y = Bit count (number of bits to set)
05C3 8D2B             (      fsrqmem.asm):00066                             bsr       AllocBit  ; call into F$AllBit to allocate Y bits starting at bit D in the table X
05C5 1E89             (      fsrqmem.asm):00067                             exg       a,b       ; swap A and B
05C7 ED48             (      fsrqmem.asm):00068                             std       R$U,u     ; put allocated address into caller's U
05C9 4F               (      fsrqmem.asm):00069         okex                clra                ; clear carry
05CA 39               (      fsrqmem.asm):00070                             rts                 ; return to the caller
05CB 53               (      fsrqmem.asm):00071         ex@                 comb                ; set carry
05CC C6CF             (      fsrqmem.asm):00072                             ldb       #E$MemFul ; indicate memory is full
05CE 39               (      fsrqmem.asm):00073                             rts                 ; return to the caller
                      (      fsrqmem.asm):00074         
                      (      fsrqmem.asm):00075         ;;; F$SRtMem
                      (      fsrqmem.asm):00076         ;;;
                      (      fsrqmem.asm):00077         ;;; Return one or more pages of memory to the free memory pool.
                      (      fsrqmem.asm):00078         ;;;
                      (      fsrqmem.asm):00079         ;;; Entry:  D = The number of bytes to return.
                      (      fsrqmem.asm):00080         ;;;         U = The address of the memory to return.
                      (      fsrqmem.asm):00081         ;;;
                      (      fsrqmem.asm):00082         ;;; Exit:   None.
                      (      fsrqmem.asm):00083         ;;;
                      (      fsrqmem.asm):00084         ;;; Error:  B = A non-zero error code.
                      (      fsrqmem.asm):00085         ;;;        CC = Carry flag set to indicate error.
                      (      fsrqmem.asm):00086         ;;;
                      (      fsrqmem.asm):00087         ;;; F$SRtMem returns memory allocated by F$SRqMem to the system.
                      (      fsrqmem.asm):00088         
05CF EC41             (      fsrqmem.asm):00089         FSRtMem             ldd       R$D,u     ; get the memory allocation size requested from the caller's D
05D1 C300FF           (      fsrqmem.asm):00090                             addd      #$00FF    ; round it up to nearest 256 byte page (e.g. $1FF = $2FE)
05D4 1F89             (      fsrqmem.asm):00091                             tfr       a,b       ; put MSB into B
05D6 4F               (      fsrqmem.asm):00092                             clra                ; now D reflects number of 256 byte pages to return
05D7 1F02             (      fsrqmem.asm):00093                             tfr       d,y       ; put the 16 bit page count into Y
05D9 EC48             (      fsrqmem.asm):00094                             ldd       R$U,u     ; get the address of memory to free from the caller's U
05DB 27EC             (      fsrqmem.asm):00095                             beq       okex      ; if user passed 0, ignore
05DD 5D               (      fsrqmem.asm):00096                             tstb                ; check for B = 0 (it should!)
05DE 2704             (      fsrqmem.asm):00097                             beq       returnmem@ ; it does... return it to the system
05E0 53               (      fsrqmem.asm):00098                             comb                ; the user has passed B<>0 for the address
05E1 C6D2             (      fsrqmem.asm):00099                             ldb       #E$BPAddr ; the error is bad page address
05E3 39               (      fsrqmem.asm):00100                             rts                 ; return to the caller
05E4 1E89             (      fsrqmem.asm):00101         returnmem@          exg       a,b       ; swap A/B
05E6 9E20             (      fsrqmem.asm):00102                             ldx       <D.FMBM   ; get pointer to free memory bitmap
05E8 2059             (      fsrqmem.asm):00103                             bra       DelBit    ; call into F$DelBit to delete bits
                      (      fsrqmem.asm):00104         
                      (      fsrqmem.asm):00105                           ELSE
                      (      fsrqmem.asm):00106         
                      (      fsrqmem.asm):00107         **************************************************
                      (      fsrqmem.asm):00108         * F$SRqMem - Level 2 implementation
                      (      fsrqmem.asm):00109         *
                      (      fsrqmem.asm):00110         * CoCo 3 note: Memory is allocated from the top of the system RAM map downwards.
                      (      fsrqmem.asm):00111         * rel/boot/krn also reside in this area, and are loaded from $ED00-$FFFF.
                      (      fsrqmem.asm):00112         * Since this area is always allocated, we start searching for free pages from page
                      (      fsrqmem.asm):00113         * $EC downward.
                      (      fsrqmem.asm):00114         *
                      (      fsrqmem.asm):00115         * F$SRqMem also updates the system memory map according to 8K DAT blocks. If an
                      (      fsrqmem.asm):00116         * empty block is found, this routine re-does the 32 entries in the SMAP table to
                      (      fsrqmem.asm):00117         * indicate that they are free.
                      (      fsrqmem.asm):00118         
05EA.                 (      fsrqmem.asm):00119         FSRqMem             ldd       R$D,u     ; get the memory allocation size requested
                      (      fsrqmem.asm):00120                             addd      #$00FF    ; round it up to the nearest 256 byte page (e.g. $1FF = $2FE)
                      (      fsrqmem.asm):00121                             clrb                ; just keep the number of pages (and the starting 8K block number, e.g. $2FE = $200)
                      (      fsrqmem.asm):00122                             std       R$D,u     ; save the rounded up version back to the user's D
                      (      fsrqmem.asm):00123                             pshs      d         ; reserve a byte and put 0 byte on stack
                      (      fsrqmem.asm):00124         
                      (      fsrqmem.asm):00125         * IMPORTANT!!!
                      (      fsrqmem.asm):00126         * The following code was put in some time back to fix a problem.  That problem was not documented
                      (      fsrqmem.asm):00127         * so I cannot recall why this code was in place.  What it appears to do is reset the system page
                      (      fsrqmem.asm):00128         * memory map based upon the state of the system DAT image.
                      (      fsrqmem.asm):00129         * This code really slows down F$SRqMem and since that system call is used quite often in the system,
                      (      fsrqmem.asm):00130         * I am commenting it out in the hopes that I can remember what the hell I put it in for. -- Boisy
                      (      fsrqmem.asm):00131                           IFEQ    1       ; begin conditional assembly for 1
                      (      fsrqmem.asm):00132                             ldy       <D.SysMem ; get ptr to SMAP table
                      (      fsrqmem.asm):00133         * This loop updates the SMAP table if anything can be marked as unused
05EA.                 (      fsrqmem.asm):00134         FSrqmemSysDATBlk    ldx       <D.SysDAT ; get pointer to system DAT block list
                      (      fsrqmem.asm):00135                             lslb                ; adjust block offset for 2 bytes/entry
                      (      fsrqmem.asm):00136                             ldd       b,x       ; get block type/# from system DAT
                      (      fsrqmem.asm):00137                             cmpd      #DAT.Free ; unused block?
                      (      fsrqmem.asm):00138                             beq       FSrqmemFillSysPg ; yes, mark it free in SMAP table
                      (      fsrqmem.asm):00139                             ldx       <D.BlkMap ; no, get ptr to MMAP table
                      (      fsrqmem.asm):00140                             lda       d,x       ; get block marker for 2 meg mem map
                      (      fsrqmem.asm):00141                             cmpa      #RAMinUse ; is it in use (not free, ROM or used by module)?
                      (      fsrqmem.asm):00142                             bne       FSrqmemPut ; no, mark it as type it is in SMAP table
                      (      fsrqmem.asm):00143                             leay      32,y      ; yes, move to next block in pages
                      (      fsrqmem.asm):00144                             bra       FSrqmemBumpUpBlk ; move to next block & try again
                      (      fsrqmem.asm):00145         * Free RAM:
05EA.                 (      fsrqmem.asm):00146         FSrqmemFillSysPg    clra                ; byte to fill system page map with (0=Not in use)
                      (      fsrqmem.asm):00147         * NOT! RAMinUse:
                      (      fsrqmem.asm):00148                           IFNE    H6309   ; begin conditional assembly for H6309
05EA.                 (      fsrqmem.asm):00149         FSrqmemPut          sta       ,s        ; put it on stack
                      (      fsrqmem.asm):00150                             ldw       #$0020    Get size of 8K block in pages
                      (      fsrqmem.asm):00151                             tfm       s,y+      Mark entire block's worth of pages with A
                      (      fsrqmem.asm):00152                           ELSE
05EA.                 (      fsrqmem.asm):00153         FSrqmemPut          ldb       #32       ; count = 32 pages
05EA.                 (      fsrqmem.asm):00154         FSrqmemMarkRAM      sta       ,y+       ; mark the RAM
                      (      fsrqmem.asm):00155                             decb                ; decrement B
                      (      fsrqmem.asm):00156                             bne       FSrqmemMarkRAM ; branch if zero is clear to FSrqmemMarkRAM
                      (      fsrqmem.asm):00157                           ENDC
05EA.                 (      fsrqmem.asm):00158         FSrqmemBumpUpBlk    inc       1,s       ; bump up to next block to check
                      (      fsrqmem.asm):00159                             ldb       1,s       ; get it
                      (      fsrqmem.asm):00160                             cmpb      #DAT.BlCt ; done whole 64k system space?
                      (      fsrqmem.asm):00161                             blo       FSrqmemSysDATBlk ; no, keep checking
                      (      fsrqmem.asm):00162                           ENDC
                      (      fsrqmem.asm):00163         
                      (      fsrqmem.asm):00164         
                      (      fsrqmem.asm):00165         * Now we can actually attempt to allocate the system RAM requested
                      (      fsrqmem.asm):00166         * NOTE: Opt for CoCo/TC9 OS9 ONLY: skip last 256 - Bt.Start pages since
                      (      fsrqmem.asm):00167         * they are: Kernel (REL/BOOT/KRN - 17 pages), vector RAM & I/O (2 pages)
                      (      fsrqmem.asm):00168         * (Already permanently marked @ L01D2)
                      (      fsrqmem.asm):00169         * At the start, Y is pointing to the end of the SMAP table+1
                      (      fsrqmem.asm):00170                             ldx       <D.SysMem ; get the starting address of the system free memory map
                      (      fsrqmem.asm):00171                           IFNE    wildbits ; begin conditional assembly for wildbits
                      (      fsrqmem.asm):00172         * Under OS-9 Level 2 for the Wildbits, the entire bootfile is loaded into RAM by FEU.
                      (      fsrqmem.asm):00173         * There is no F$Boot. Because of this, we start searching for free memory at the
                      (      fsrqmem.asm):00174         * very end of the system free memory map.
                      (      fsrqmem.asm):00175                             leay      256,x     ; point Y to very end of system free memory map
                      (      fsrqmem.asm):00176                           ELSE
                      (      fsrqmem.asm):00177                             leay      Bt.Start/256,x ; point Y to starting page where the bootfile was loaded
                      (      fsrqmem.asm):00178                           ENDC
                      (      fsrqmem.asm):00179                             ldb       #32       ; skip block 0: it's always full
                      (      fsrqmem.asm):00180                             abx                 ; update X to point to the starting place to search for
05EA.                 (      fsrqmem.asm):00181         FSrqmemNumPgsReq    ldb       R$A,u     ; get the number of 256 byte pages requested
                      (      fsrqmem.asm):00182         * Loop from the end of the system free memory map) to look for the number continuous pages requested
05EA.                 (      fsrqmem.asm):00183         FSrqmemJoin         equ       *         ; define assembler symbol
                      (      fsrqmem.asm):00184                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fsrqmem.asm):00185                             cmpr      x,y       do we still have any system RAM left to try?
                      (      fsrqmem.asm):00186                           ELSE
                      (      fsrqmem.asm):00187                             pshs      x         ; save X
                      (      fsrqmem.asm):00188                             cmpy      ,s++      ; compare Y to X
                      (      fsrqmem.asm):00189                           ENDC
                      (      fsrqmem.asm):00190                             bhi       FSrqmemPgMrkrStrtn ; if Y (end) is higher than X (start), continue looking
                      (      fsrqmem.asm):00191                             comb                ; else set the carry
                      (      fsrqmem.asm):00192                             ldb       #E$NoRAM  ; load the "no system RAM" error
                      (      fsrqmem.asm):00193                             bra       FSrqmemExit ; and branch to return
                      (      fsrqmem.asm):00194         
05EA.                 (      fsrqmem.asm):00195         FSrqmemPgMrkrStrtn  lda       ,-y       ; get the page marker (starting at the end of the system free memory map)
                      (      fsrqmem.asm):00196                             bne       FSrqmemNumPgsReq ; branch if it's not zero (the page is allocated, so test the next lower one)
                      (      fsrqmem.asm):00197                             decb                ; found 1 page, decrement the number of pages we need to allocate
                      (      fsrqmem.asm):00198                             bne       FSrqmemJoin ; branch if we still more pages needed to see if we can get more
                      (      fsrqmem.asm):00199                             sty       ,s        ; here, we've found all of the free contiguous pages, so save the pointer
                      (      fsrqmem.asm):00200                             lda       1,s       ; get the LSB of the pointer
                      (      fsrqmem.asm):00201                             lsra                ; A = A / 2
                      (      fsrqmem.asm):00202                             lsra                ; A = A / 4
                      (      fsrqmem.asm):00203                             lsra                ; A = A / 8
                      (      fsrqmem.asm):00204                             lsra                ; A = A / 16
                      (      fsrqmem.asm):00205                             lsra                ; A = A / 32 to obtain the starting 8KB block number
                      (      fsrqmem.asm):00206                             ldb       1,s       ; get the LSB of the pointer
                      (      fsrqmem.asm):00207                             andb      #%00011111 ; keep the offset within the 8KB block
                      (      fsrqmem.asm):00208                             addb      R$A,u     ; add the number of pages requested
                      (      fsrqmem.asm):00209                             addb      #$1F      ; round up to the nearest 8KB block
                      (      fsrqmem.asm):00210                             lsrb                ; B = B / 2
                      (      fsrqmem.asm):00211                             lsrb                ; B = B / 4
                      (      fsrqmem.asm):00212                             lsrb                ; B = B / 8
                      (      fsrqmem.asm):00213                             lsrb                ; B = B / 16
                      (      fsrqmem.asm):00214                             lsrb                ; divide by 32 to obtain the ending 8KB block number
                      (      fsrqmem.asm):00215                             ldx       <D.SysPrc ; get the pointer to the system process descriptor
                      (      fsrqmem.asm):00216         **************************
                      (      fsrqmem.asm):00217         * The following code addresses a bug where the call into F$AllImg could fail if the number of blocks
                      (      fsrqmem.asm):00218         * in B was 2, thereby crossing an 8KB boundary. The specific case that surfaced this was early on
                      (      fsrqmem.asm):00219         * the kernel's bootstrap. A was 4 and B was 2, and the kernel had slots 0, 5, 6, and 7 assigned to
                      (      fsrqmem.asm):00220         * 8KB blocks. Because B was 2, F$AllImg was asked to allocate 8KB blocks for slots 4 and 5. Since
                      (      fsrqmem.asm):00221         * slot 5 was already holding an 8KB block, F$AllImg returned an error and this call failed, causing
                      (      fsrqmem.asm):00222         * the kernel to crash.
                      (      fsrqmem.asm):00223         * The following code checks the system's DAT image in the process descriptor to ensure that the
                      (      fsrqmem.asm):00224         * slots that it's asking to obtain 8KB blocks for are indeed available; if not, it decrements the
                      (      fsrqmem.asm):00225         * number of blocks to request in B.
                      (      fsrqmem.asm):00226         * Boisy - 10/27/23
                      (      fsrqmem.asm):00227                             pshs      d,x       ; save registers
                      (      fsrqmem.asm):00228                             leax      P$DATImg,x ; point into the DAT image of the process descriptor
05EA.                 (      fsrqmem.asm):00229         l@                  ldb       ,s        ; get the starting block
                      (      fsrqmem.asm):00230                             decb                ; decrement it since we're adding the number next
                      (      fsrqmem.asm):00231                             addb      1,s       ; add the number of blocks
                      (      fsrqmem.asm):00232                             lslb                ; A = A * 2
                      (      fsrqmem.asm):00233                             ldd       b,x       ; get the entry in the DAT image
                      (      fsrqmem.asm):00234                             cmpd      #DAT.Free ; is it free?
                      (      fsrqmem.asm):00235                             beq       ok@       ; branch if so
                      (      fsrqmem.asm):00236                             dec       ,s        ; else decrement starting block
                      (      fsrqmem.asm):00237                             bne       l@        ; and go try next
05EA.                 (      fsrqmem.asm):00238         ok@                 puls      d,x       ; recover registers
                      (      fsrqmem.asm):00239         **************************
                      (      fsrqmem.asm):00240                             lbsr      FAllimgTarget ; allocate an image with our start/end block numbers
                      (      fsrqmem.asm):00241                             bcs       FSrqmemExit ; branch if we couldn't do it
                      (      fsrqmem.asm):00242                             ldb       R$A,u     ; else get the number of requested pages
                      (      fsrqmem.asm):00243         *         lda   #RAMinUse    Get SMAP in use flag
                      (      fsrqmem.asm):00244         *L088A    sta   ,y+          Mark all the pages requested as In Use
05EA.                 (      fsrqmem.asm):00245         FSrqmemSncRamUseWe  inc       ,y+       ; since RAMinUse is 1, we can save space by INC'ing from 0->1
                      (      fsrqmem.asm):00246                             decb                ; decrement the counter
                      (      fsrqmem.asm):00247                             bne       FSrqmemSncRamUseWe ; continue if not at 0
                      (      fsrqmem.asm):00248                             lda       1,s       ; get the MSB of the pointer to the start of the newly allocated system RAM
                      (      fsrqmem.asm):00249                             std       R$U,u     ; save to the caller's U
                      (      fsrqmem.asm):00250                             clrb                ; clear the error code and carry
05EA.                 (      fsrqmem.asm):00251         FSrqmemExit         puls      u,pc      ; return (U is changed after it exits)
                      (      fsrqmem.asm):00252         
                      (      fsrqmem.asm):00253         
                      (      fsrqmem.asm):00254         **************************************************
                      (      fsrqmem.asm):00255         * F$SRtMem - Level 2 implementation
                      (      fsrqmem.asm):00256         *
05EA.                 (      fsrqmem.asm):00257         FSRtMem             ldd       R$D,u     ; get the number of pages to free up
                      (      fsrqmem.asm):00258                             beq       FSrqmemErrorCarry ; branch if the caller passed 0 (nothing to free!)
                      (      fsrqmem.asm):00259                             addd      #$00FF    ; else round up the value to nearest page
                      (      fsrqmem.asm):00260                             ldb       R$U+1,u   ; get the LSB of the address
                      (      fsrqmem.asm):00261                             beq       FSrqmemMsbPage ; it's a even page, so skip ahead
                      (      fsrqmem.asm):00262                             comb                ; else set the carry
                      (      fsrqmem.asm):00263                             ldb       #E$BPAddr ; load the "bad page address" error number
                      (      fsrqmem.asm):00264                             rts                 ; return
                      (      fsrqmem.asm):00265         
05EA.                 (      fsrqmem.asm):00266         FSrqmemMsbPage      ldb       R$U,u     ; get the MSB of the page address
                      (      fsrqmem.asm):00267                             beq       FSrqmemErrorCarry ; branc if it's 0 (not a legal page)
                      (      fsrqmem.asm):00268                             ldx       <D.SysMem ; get the pointer to the system free memory map
                      (      fsrqmem.asm):00269                             abx                 ; set the pointer into the map
05EA.                 (      fsrqmem.asm):00270         FSrqmemJoin2        equ       *         ; define assembler symbol
                      (      fsrqmem.asm):00271                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fsrqmem.asm):00272                             aim       #^RAMinUse,,x+ clear the "RAM in use" bit
                      (      fsrqmem.asm):00273                           ELSE
                      (      fsrqmem.asm):00274                             ldb       ,x        ; get the page byte
                      (      fsrqmem.asm):00275                             andb      #^RAMinUse ; clear the "RAM in use" bit
                      (      fsrqmem.asm):00276                             stb       ,x+       ; save the page byte back and increment the index register
                      (      fsrqmem.asm):00277                           ENDC
                      (      fsrqmem.asm):00278                             deca                ; decrement the counter
                      (      fsrqmem.asm):00279                             bne       FSrqmemJoin2 ; branch if not done
                      (      fsrqmem.asm):00280         * Scan the DAT image to find the memory blocks to free up.
                      (      fsrqmem.asm):00281                             ldx       <D.SysDAT ; get the pointer to the system DAT image
                      (      fsrqmem.asm):00282                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fsrqmem.asm):00283                             lde       #DAT.BlCt get the number of blocks to check
                      (      fsrqmem.asm):00284                           ELSE
                      (      fsrqmem.asm):00285                             ldy       #DAT.BlCt ; get the number of blocks to check
                      (      fsrqmem.asm):00286                           ENDC
05EA.                 (      fsrqmem.asm):00287         FSrqmemBlockImage   ldd       ,x        ; get the block image
                      (      fsrqmem.asm):00288                             cmpd      #DAT.Free ; is it already free?
                      (      fsrqmem.asm):00289                             beq       FSrqmemDATBlock ; yes, skip to the next one
