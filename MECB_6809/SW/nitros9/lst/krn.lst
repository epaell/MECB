                      (        ffork.asm):00154                             bcc       GotNPrc   ; went ok, keep going
                      (        ffork.asm):00155                             puls      u,pc      ; restore & return with error
                      (        ffork.asm):00156         
                      (        ffork.asm):00157         * Copy user # & priority
04B1.                 (        ffork.asm):00158         GotNPrc             pshs      u         ; save pointer to new descriptor
