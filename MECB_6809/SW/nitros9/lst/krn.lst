     0005             (      fallbit.asm):00197         _stk1A@             set       _stk1A@+1 ; define assembler symbol
     0006             (      fallbit.asm):00198         _stk1B@             set       _stk1B@+1 ; define assembler symbol
     0007             (      fallbit.asm):00199         _stk1X@             set       _stk1X@+1 ; define assembler symbol
