063F 3344             (      fallbit.asm):00119                             leau      R$X,u     ; point U to the address of the caller's register pointer
0641 3730             (      fallbit.asm):00120                             pulu      y,x       ; load X/Y/U with this slick trick
0643 3436             (      fallbit.asm):00121         DelBit              pshs      y,x,b,a   ; preserve registers
0645 8DDF             (      fallbit.asm):00122                             bsr       CalcBit   ; calculate byte and position, and get first bit mask
