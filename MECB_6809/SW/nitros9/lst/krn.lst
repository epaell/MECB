                      (      fvmodul.asm):00001         * Search the module directory for a module of name pointed by X.
                      (      fvmodul.asm):00002         *
                      (      fvmodul.asm):00003         * Entry:  A = Type of module to link.
                      (      fvmodul.asm):00004         *         X = Pointer to name of module.
                      (      fvmodul.asm):00005         *
                      (      fvmodul.asm):00006         * Exit:   X = Pointer to first character after the module's name
                      (      fvmodul.asm):00007         *         U = Pointer to the module directory entry of found entry (if found)
                      (      fvmodul.asm):00008         *        CC = Carry flag clear to indicate success.
                      (      fvmodul.asm):00009         *
                      (      fvmodul.asm):00010         * Error:  B = A non-zero error code.
                      (      fvmodul.asm):00011         *        CC = Carry flag set to indicate error.
                      (      fvmodul.asm):00012         
                      (      fvmodul.asm):00013                           IFEQ    Level-1 ; begin conditional assembly for Level-1
02CB.                 (      fvmodul.asm):00014         FindModule
02CB CE0000           (      fvmodul.asm):00015                             ldu       #$0000    ; initialize U with $0000
02CE 1F89             (      fvmodul.asm):00016                             tfr       a,b       ; copy A to B
02D0 84F0             (      fvmodul.asm):00017                             anda      #TypeMask ; preserve type bits in A
02D2 C40F             (      fvmodul.asm):00018                             andb      #LangMask ; preserve language bits in B
02D4 3476             (      fvmodul.asm):00019                             pshs      u,y,x,b,a ; save important registers
     0000             (      fvmodul.asm):00020         _stk1A@             set       0         ; define assembler symbol
     0001             (      fvmodul.asm):00021         _stk1B@             set       1         ; define assembler symbol
     0002             (      fvmodul.asm):00022         _stk1X@             set       2         ; define assembler symbol
     0004             (      fvmodul.asm):00023         _stk1Y@             set       4         ; define assembler symbol
     0006             (      fvmodul.asm):00024         _stk1U@             set       6         ; define assembler symbol
02D6 8D4F             (      fvmodul.asm):00025                             bsr       eatspace@ ; move X past any spaces
02D8 812F             (      fvmodul.asm):00026                             cmpa      #PDELIM   ; pathlist char?
02DA 2748             (      fvmodul.asm):00027                             beq       exerr@    ; branch if so
02DC 170404           (      fvmodul.asm):00028                             lbsr      ParseNam  ; parse name
02DF 2544             (      fvmodul.asm):00029                             bcs       ex@       ; branch if error
02E1 DE26             (      fvmodul.asm):00030                             ldu       <D.ModDir ; get pointer to module directory
02E3 3464             (      fvmodul.asm):00031         FindLoop            pshs      u,y,b     ; save important registers
     0000             (      fvmodul.asm):00032         _stk2B@             set       0         ; B = pathname length
     0001             (      fvmodul.asm):00033         _stk2Y@             set       1         ; Y =
     0003             (      fvmodul.asm):00034         _stk2U@             set       3         ; U = address of next module in module directory
     0005             (      fvmodul.asm):00035         _stk1A@             set       0+_stk2U@+2 ; define assembler symbol
     0006             (      fvmodul.asm):00036         _stk1B@             set       1+_stk2U@+2 ; define assembler symbol
     0007             (      fvmodul.asm):00037         _stk1X@             set       2+_stk2U@+2 ; define assembler symbol
     0009             (      fvmodul.asm):00038         _stk1Y@             set       4+_stk2U@+2 ; define assembler symbol
     000B             (      fvmodul.asm):00039         _stk1U@             set       6+_stk2U@+2 ; define assembler symbol
02E5 EEC4             (      fvmodul.asm):00040                             ldu       MD$MPtr,u ; get pointer to next module to compare names with
02E7 272A             (      fvmodul.asm):00041                             beq       CheckEnd  ; empty entry... continue to next module in list
02E9 EC44             (      fvmodul.asm):00042                             ldd       M$Name,u  ; get module name offset in module
02EB 31CB             (      fvmodul.asm):00043                             leay      d,u       ; point Y to module name
02ED E6E4             (      fvmodul.asm):00044                             ldb       _stk2B@,s ; get length of pathname on stack
02EF 17044F           (      fvmodul.asm):00045                             lbsr      CmpNam    ; compare name of modules
02F2 2527             (      fvmodul.asm):00046                             bcs       NextMod   ; branch if not same name
02F4 A665             (      fvmodul.asm):00047                             lda       _stk1A@,s ; get saved type byte on stack
02F6 2706             (      fvmodul.asm):00048                             beq       ChkLang   ; same... now check language
02F8 A846             (      fvmodul.asm):00049                             eora      M$Type,u  ; eOR with type in module
02FA 84F0             (      fvmodul.asm):00050                             anda      #TypeMask ; preserve type bits
02FC 261D             (      fvmodul.asm):00051                             bne       NextMod   ; branch if not same type
02FE A666             (      fvmodul.asm):00052         ChkLang             lda       _stk1B@,s ; get saved language byte on stack
0300 2706             (      fvmodul.asm):00053                             beq       ModFound  ; branch if 0
0302 A846             (      fvmodul.asm):00054                             eora      M$Type,u  ; eOR with language in module
0304 840F             (      fvmodul.asm):00055                             anda      #LangMask ; preserve language bits
0306 2613             (      fvmodul.asm):00056                             bne       NextMod   ; branch if not same language
0308 3554             (      fvmodul.asm):00057         ModFound            puls      u,x,b     ; module found... restore regs
     0000             (      fvmodul.asm):00058         _stk1A@             set       0         ; define assembler symbol
     0001             (      fvmodul.asm):00059         _stk1B@             set       1         ; define assembler symbol
     0002             (      fvmodul.asm):00060         _stk1X@             set       2         ; define assembler symbol
     0004             (      fvmodul.asm):00061         _stk1Y@             set       4         ; define assembler symbol
     0006             (      fvmodul.asm):00062         _stk1U@             set       6         ; define assembler symbol
030A EF66             (      fvmodul.asm):00063                             stu       _stk1U@,s ; save off found module in caller's U
030C 8D19             (      fvmodul.asm):00064                             bsr       eatspace@ ; move past any spaces
030E AF62             (      fvmodul.asm):00065                             stx       _stk1X@,s ; save off character past module name in caller's X
0310 4F               (      fvmodul.asm):00066                             clra                ; clear carry
0311 2012             (      fvmodul.asm):00067                             bra       ex@       ; branch to exit of routine
     0000             (      fvmodul.asm):00068         _stk2B@             set       0         ; define assembler symbol
     0001             (      fvmodul.asm):00069         _stk2Y@             set       1         ; define assembler symbol
     0003             (      fvmodul.asm):00070         _stk2U@             set       3         ; define assembler symbol
     0005             (      fvmodul.asm):00071         _stk1A@             set       0+_stk2U@+2 ; define assembler symbol
     0006             (      fvmodul.asm):00072         _stk1B@             set       1+_stk2U@+2 ; define assembler symbol
     0007             (      fvmodul.asm):00073         _stk1X@             set       2+_stk2U@+2 ; define assembler symbol
     0009             (      fvmodul.asm):00074         _stk1Y@             set       4+_stk2U@+2 ; define assembler symbol
     000B             (      fvmodul.asm):00075         _stk1U@             set       6+_stk2U@+2 ; define assembler symbol
0313 EC6B             (      fvmodul.asm):00076         CheckEnd            ldd       _stk1U@,s ; get saved pointer in module directory
0315 2604             (      fvmodul.asm):00077                             bne       NextMod   ; branch to get next module in directory
0317 EC63             (      fvmodul.asm):00078                             ldd       _stk2U@,s ; get saved U
0319 ED6B             (      fvmodul.asm):00079                             std       _stk1U@,s ; put in saved U in earlier stack
031B 3564             (      fvmodul.asm):00080         NextMod             puls      u,y,b     ; restore pushed regs
031D 3344             (      fvmodul.asm):00081                             leau      MD$ESize,u ; advance to next module directory entry
031F 119328           (      fvmodul.asm):00082                             cmpu      <D.ModDir+2 ; at end of directory?
0322 25BF             (      fvmodul.asm):00083                             bcs       FindLoop  ; no... continue searching
0324 53               (      fvmodul.asm):00084         exerr@              comb                ; set carry
0325 35F6             (      fvmodul.asm):00085         ex@                 puls      pc,u,y,x,b,a ; return to caller
                      (      fvmodul.asm):00086         * Advance past any leading spaces in a string.
                      (      fvmodul.asm):00087         *
                      (      fvmodul.asm):00088         * Entry: X = Pointer to string.
                      (      fvmodul.asm):00089         *
                      (      fvmodul.asm):00090         * Exit:  A = First non-space character.
                      (      fvmodul.asm):00091         *        X = Pointer to first non-space character.
0327 8620             (      fvmodul.asm):00092         eatspace@           lda       #C$SPAC   ; load A with space character
0329 A180             (      fvmodul.asm):00093         loop@               cmpa      ,x+       ; compare with character at X and increment
032B 27FC             (      fvmodul.asm):00094                             beq       loop@     ; if space, keep going
032D A682             (      fvmodul.asm):00095                             lda       ,-x       ; else get non-space character at X-1
032F 39               (      fvmodul.asm):00096                             rts                 ; return
                      (      fvmodul.asm):00097         
                      (      fvmodul.asm):00098         ;;; F$VModul
                      (      fvmodul.asm):00099         ;;;
                      (      fvmodul.asm):00100         ;;; Validate the validity of a module.
                      (      fvmodul.asm):00101         ;;;
                      (      fvmodul.asm):00102         ;;; Entry:  X = The address of the module to verify.
                      (      fvmodul.asm):00103         ;;;
                      (      fvmodul.asm):00104         ;;; Exit:   U = The absolute address of the module header.
                      (      fvmodul.asm):00105         ;;;        CC = Carry flag clear to indicate success.
                      (      fvmodul.asm):00106         ;;;
                      (      fvmodul.asm):00107         ;;; Error:  B = A non-zero error code.
                      (      fvmodul.asm):00108         ;;;        CC = Carry flag set to indicate error.
                      (      fvmodul.asm):00109         ;;;
                      (      fvmodul.asm):00110         ;;; F$VModul validates that a module exists at the passed address, and if so, searches the module directory
                      (      fvmodul.asm):00111         ;;; for a module with the same name. If one exists, the module with the higher revision level remains in memory.
                      (      fvmodul.asm):00112         ;;; If both modules have the same revision level, F$VModul retains the module in memory.
                      (      fvmodul.asm):00113         ;;;
                      (      fvmodul.asm):00114         ;;; If the module integrity feature flag is turned on at build time, F$VModul will verify the module's header and
                      (      fvmodul.asm):00115         ;;; CRC to ensure the module is completely correct; otherwise, these checks aren't done.
                      (      fvmodul.asm):00116         
0330 3440             (      fvmodul.asm):00117         FVModul             pshs      u         ; save caller's registers
0332 AE44             (      fvmodul.asm):00118                             ldx       R$X,u     ; get caller's X (address of module name)
0334 8D05             (      fvmodul.asm):00119                             bsr       ValMod    ; perform the validation
0336 3520             (      fvmodul.asm):00120                             puls      y         ; pull the caller's registers
0338 EF28             (      fvmodul.asm):00121                             stu       R$U,y     ; save the new (if any) module address
033A 39               (      fvmodul.asm):00122                             rts                 ; return to caller
                      (      fvmodul.asm):00123         
                      (      fvmodul.asm):00124         * X = address of module to validate
033B 8D57             (      fvmodul.asm):00125         ValMod              bsr       ChkMHCRC  ; check the module header and CRC
033D 254C             (      fvmodul.asm):00126                             bcs       ex@       ; ... exit if error
033F A606             (      fvmodul.asm):00127                             lda       M$Type,x  ; get the type byte
0341 3412             (      fvmodul.asm):00128                             pshs      x,a       ; save off module address
0343 EC04             (      fvmodul.asm):00129                             ldd       M$Name,x  ; get module name offset
0345 308B             (      fvmodul.asm):00130                             leax      d,x       ; set X to address of name in module
0347 3502             (      fvmodul.asm):00131                             puls      a         ; restore type byte
0349 17FF7F           (      fvmodul.asm):00132                             lbsr      FindModule ; attempt to locate module in module directory of same name
034C 3510             (      fvmodul.asm):00133                             puls      x         ; restore passed module address
                      (      fvmodul.asm):00134         * Now, X points to module that was passed by caller, and
                      (      fvmodul.asm):00135         * U points to module dirctory entry of the module of the same name that was found (if any)
                      (      fvmodul.asm):00136         * already in module directory
034E 253C             (      fvmodul.asm):00137                             bcs       isempty@  ; branch if FindModule returned error (no module found of the same name)
0350 C6E7             (      fvmodul.asm):00138                             ldb       #E$KwnMod ; prepare possible error
0352 ACC4             (      fvmodul.asm):00139                             cmpx      MD$MPtr,u ; is the returned module directory entry the same?
0354 273C             (      fvmodul.asm):00140                             beq       errex@    ; branch if so
                      (      fvmodul.asm):00141         * Here, we've established another module of the same name as the one we're validating already
                      (      fvmodul.asm):00142         * exists in the module directory, and it's NOT this same module.
                      (      fvmodul.asm):00143         * Check the revision to see if this one is newer and should replace the existing one.
0356 A607             (      fvmodul.asm):00144                             lda       M$Revs,x  ; else get revision byte of passed module
0358 840F             (      fvmodul.asm):00145                             anda      #RevsMask ; mask out all but revision
035A 3402             (      fvmodul.asm):00146                             pshs      a         ; save off
035C 10AEC4           (      fvmodul.asm):00147                             ldy       MD$MPtr,u ; get pointer to found module (different)
035F A627             (      fvmodul.asm):00148                             lda       M$Revs,y  ; get revision byte of found module
0361 840F             (      fvmodul.asm):00149                             anda      #RevsMask ; mask out all but revision
0363 A1E0             (      fvmodul.asm):00150                             cmpa      ,s+       ; compare revisions
0365 242B             (      fvmodul.asm):00151                             bcc       errex@    ; if same or lower, return to caller
0367 3430             (      fvmodul.asm):00152                             pshs      y,x       ; save off pointer to modules
0369 E642             (      fvmodul.asm):00153                             ldb       MD$Link,u ; get link count of module
036B 2619             (      fvmodul.asm):00154                             bne       pulsaveandex@ ; branch if not zero
036D AEC4             (      fvmodul.asm):00155                             ldx       MD$MPtr,u ; get address of module into X
036F 9C66             (      fvmodul.asm):00156                             cmpx      <D.BTLO   ; compare against Boot low memory pointer
0371 2413             (      fvmodul.asm):00157                             bcc       pulsaveandex@ ; branch if higher
                      (      fvmodul.asm):00158         * Here, we've determined the module we're validating is newer than the one that already
                      (      fvmodul.asm):00159         * exists in memory.
0373 EC02             (      fvmodul.asm):00160                             ldd       M$Size,x  ; else get module size from module header
0375 C300FF           (      fvmodul.asm):00161                             addd      #$00FF    ; round up to next page
0378 1F89             (      fvmodul.asm):00162                             tfr       a,b       ; divide by 256 (# of pages to clear)
037A 4F               (      fvmodul.asm):00163                             clra                ; D = rounded up value of module's memory footprint (number of bits to clear)
037B 1F02             (      fvmodul.asm):00164                             tfr       d,y       ; transfer to Y
037D E6C4             (      fvmodul.asm):00165                             ldb       MD$MPtr,u ; put high byte of module address into B (D = first bit in allocation table to clear)
037F 9E20             (      fvmodul.asm):00166                             ldx       <D.FMBM   ; get pointer to free memory bitmap
0381 103F14           (      fvmodul.asm):00167                             os9       F$DelBit  ; delete from allocation table (D = first bit to clear, X = bitmap address, Y = # of bits to clear)
0384 6F42             (      fvmodul.asm):00168                             clr       MD$Link,u ; clear link count in module directory entry
0386 3530             (      fvmodul.asm):00169         pulsaveandex@       puls      y,x       ; restore X and Y
0388 AFC4             (      fvmodul.asm):00170         saveandex@          stx       MD$MPtr,u ; save newly validated module into module directory entry of deallocated modulke
038A 5F               (      fvmodul.asm):00171                             clrb                ; clear carry and error code
038B 39               (      fvmodul.asm):00172         ex@                 rts                 ; return
038C 31C4             (      fvmodul.asm):00173         isempty@            leay      MD$MPtr,u ; get module pointer in Y
038E 26F8             (      fvmodul.asm):00174                             bne       saveandex@ ; branch if module exists
0390 C6CE             (      fvmodul.asm):00175                             ldb       #E$DirFul ; module directory is full
0392 43               (      fvmodul.asm):00176         errex@              coma                ; set carry
0393 39               (      fvmodul.asm):00177                             rts                 ; return to caller
                      (      fvmodul.asm):00178         
                      (      fvmodul.asm):00179         * Check module header and CRC
                      (      fvmodul.asm):00180         *
                      (      fvmodul.asm):00181         * Entry: X = Address of potential module.
0394 EC84             (      fvmodul.asm):00182         ChkMHCRC            ldd       ,x        ; get two bytes at start of potential module
0396 108387CD         (      fvmodul.asm):00183                             cmpd      #M$ID12   ; are these module sync bytes?
039A 2606             (      fvmodul.asm):00184                             bne       errex@    ; nope, not a module here
039C 3108             (      fvmodul.asm):00185                             leay      M$Parity,x ; else point Y to the parity byte in the module
039E 8D15             (      fvmodul.asm):00186                             bsr       ChkMHPar  ; check header parity
03A0 2404             (      fvmodul.asm):00187                             bcc       Chk4CRC   ; branch if ok
03A2 53               (      fvmodul.asm):00188         errex@              comb                ; else set carry
03A3 C6CD             (      fvmodul.asm):00189                             ldb       #E$BMID   ; and load B with error
03A5 39               (      fvmodul.asm):00190                             rts                 ; return to caller
                      (      fvmodul.asm):00191         
                      (      fvmodul.asm):00192         * Check module CRC
                      (      fvmodul.asm):00193         *
                      (      fvmodul.asm):00194         * Entry: X = Address of module to check.
03A6.                 (      fvmodul.asm):00195         Chk4CRC
03A6 9689             (      fvmodul.asm):00196                             lda       <D.CRC    ; is CRC checking on?
03A8 2602             (      fvmodul.asm):00197                             bne       DoCRCCk   ; branch if so
03AA 5F               (      fvmodul.asm):00198                             clrb                ; else clear carry
03AB 39               (      fvmodul.asm):00199                             rts                 ; return to caller
                      (      fvmodul.asm):00200         
                      (      fvmodul.asm):00201         * Check if module CRC checking is on
                      (      fvmodul.asm):00202         *
                      (      fvmodul.asm):00203         * Entry: X = Address of module to check.
03AC 3410             (      fvmodul.asm):00204         DoCRCCk             pshs      x         ; save off module address onto stack
03AE 10AE02           (      fvmodul.asm):00205                             ldy       M$Size,x  ; get module size in module header
03B1 8D0F             (      fvmodul.asm):00206                             bsr       ChkMCRC   ; check module CRC
03B3 3590             (      fvmodul.asm):00207                             puls      pc,x      ; restore pc,x from the stack
                      (      fvmodul.asm):00208         
                      (      fvmodul.asm):00209         * Check module header parity
                      (      fvmodul.asm):00210         *
                      (      fvmodul.asm):00211         * Entry: X = Module header to check.
                      (      fvmodul.asm):00212         *        Y = Pointer to parity byte.
03B5 3430             (      fvmodul.asm):00213         ChkMHPar            pshs      y,x       ; save off X and Y
     0000             (      fvmodul.asm):00214         _stk1X@             set       0         ; define assembler symbol
     0002             (      fvmodul.asm):00215         _stk1Y@             set       2         ; define assembler symbol
03B7 4F               (      fvmodul.asm):00216                             clra                ; A = 0
03B8 A880             (      fvmodul.asm):00217         loop@               eora      ,x+       ; xOR with
03BA AC62             (      fvmodul.asm):00218                             cmpx      _stk1Y@,s ; compare to address of parity byte
03BC 23FA             (      fvmodul.asm):00219                             bls       loop@     ; branch if not there yet
03BE 81FF             (      fvmodul.asm):00220                             cmpa      #$FF      ; parity check done... is it correct?
03C0 35B0             (      fvmodul.asm):00221                             puls      pc,y,x    ; restore regs and return
                      (      fvmodul.asm):00222         
                      (      fvmodul.asm):00223         * Check module CRC
                      (      fvmodul.asm):00224         *
                      (      fvmodul.asm):00225         * Entry: X = Address of potential module.
                      (      fvmodul.asm):00226         *        Y = Size of module.
03C2 CCFFFF           (      fvmodul.asm):00227         ChkMCRC             ldd       #$FFFF    ; initialize D to $FFFF
03C5 3406             (      fvmodul.asm):00228                             pshs      b,a       ; save off stack
03C7 3406             (      fvmodul.asm):00229                             pshs      b,a       ; 32 bits
03C9 3361             (      fvmodul.asm):00230                             leau      1,s       ; advance one byte (24 byte CRC)
03CB A680             (      fvmodul.asm):00231         loop@               lda       ,x+       ; get next byte of module
03CD 8D2C             (      fvmodul.asm):00232                             bsr       CRCAlgo   ; perform algorithm
03CF 313F             (      fvmodul.asm):00233                             leay      -1,y      ; decrement Y (size of module)
03D1 26F8             (      fvmodul.asm):00234                             bne       loop@     ; continue if not at end
03D3 6F5F             (      fvmodul.asm):00235                             clr       -1,u      ; clear first 8 bits of 32 bits
03D5 A6C4             (      fvmodul.asm):00236                             lda       ,u        ; get first byte of CRC
03D7 8180             (      fvmodul.asm):00237                             cmpa      #CRCCon1  ; is it what we expect?
03D9 2608             (      fvmodul.asm):00238                             bne       err@      ; branch if not
03DB EC41             (      fvmodul.asm):00239                             ldd       1,u       ; get next two bytes of CRC
03DD 10830FE3         (      fvmodul.asm):00240                             cmpd      #CRCCon23 ; is it what we expect?
03E1 2703             (      fvmodul.asm):00241                             beq       ex@       ; branch if what we expect
03E3 53               (      fvmodul.asm):00242         err@                comb                ; ...else set carry
03E4 C6E8             (      fvmodul.asm):00243                             ldb       #E$BMCRC  ; load B with error
03E6 35B0             (      fvmodul.asm):00244         ex@                 puls      pc,y,x    ; return to caller
                      (      fvmodul.asm):00245         
                      (      fvmodul.asm):00246                           ELSE
                      (      fvmodul.asm):00247         
03E8.                 (      fvmodul.asm):00248         FVModul             pshs      u         ; preserve register stack pointer
                      (      fvmodul.asm):00249                             ldx       R$X,u     ; get block offset
                      (      fvmodul.asm):00250                             ldy       R$D,u     ; get DAT image pointer
                      (      fvmodul.asm):00251                             bsr       FVmodulBlkOffDAT ; validate it
                      (      fvmodul.asm):00252                             ldx       ,s        ; get register stack pointer
                      (      fvmodul.asm):00253                             stu       R$U,x     ; save address of module directory entry
                      (      fvmodul.asm):00254                             puls      u,pc      ; restore & return
                      (      fvmodul.asm):00255         
                      (      fvmodul.asm):00256         * Validate module - shortcut for calls within OS9p1 go here (ex. OS9Boot)
                      (      fvmodul.asm):00257         * Entry: X=Module block offset
                      (      fvmodul.asm):00258         *        Y=Module DAT image pointer
03E8.                 (      fvmodul.asm):00259         FVmodulBlkOffDAT    pshs      x,y       ; save block offset & DAT Image ptr
                      (      fvmodul.asm):00260                             lbsr      FVmodulBlkOffDAT2 ; go check module ID & header parity
                      (      fvmodul.asm):00261                             bcs       FVmodulTarget ; error, exit
                      (      fvmodul.asm):00262                             ldd       #M$Type   ; get offset to module type
                      (      fvmodul.asm):00263                             lbsr      FLdTarget ; go get 2 bytes (module type)
                      (      fvmodul.asm):00264                             andb      #LangMask ; just keep language mask
                      (      fvmodul.asm):00265                             pshs      d         ; preserve ??? & language
                      (      fvmodul.asm):00266                             ldd       #M$Name   ; get offset to module name
                      (      fvmodul.asm):00267                             lbsr      FLdTarget ; go get 2 bytes (offset)
                      (      fvmodul.asm):00268                             leax      d,x       ; point X to module name
                      (      fvmodul.asm):00269                             puls      a         ; restore type/language
