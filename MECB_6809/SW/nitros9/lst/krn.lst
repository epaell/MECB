                      (       fnproc.asm):00012         ;;; F$NProc
                      (       fnproc.asm):00013         ;;;
                      (       fnproc.asm):00014         ;;; Execute the next process in the active process queue.
                      (       fnproc.asm):00015         ;;;
                      (       fnproc.asm):00016         ;;; Entry: None.
                      (       fnproc.asm):00017         ;;;
                      (       fnproc.asm):00018         ;;; Exit:  None. Control doesn't return to the caller.
                      (       fnproc.asm):00019         ;;;
                      (       fnproc.asm):00020         ;;; F$NProc takes the next process out of the active process queue and initiates its execution.
                      (       fnproc.asm):00021         ;;; If the queue doesn't contain a process, the kernel waits for an interrupt and then checks the
                      (       fnproc.asm):00022         ;;; queue again. The process calling F$NProc must already be in one of the three process queues.
                      (       fnproc.asm):00023         ;;; If it isn't, it becomes unknown to the system even though the process descriptor still exists
                      (       fnproc.asm):00024         ;;; and can be displayed by `procs`.
                      (       fnproc.asm):00025         
