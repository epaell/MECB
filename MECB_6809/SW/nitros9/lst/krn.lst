                      (      fvmodul.asm):00481                           ENDC
                      (      fvmodul.asm):00482                             lbsr      FLdTarget ; get module ID
                      (      fvmodul.asm):00483                             cmpd      #M$ID12   ; legal module?
                      (      fvmodul.asm):00484                             beq       FVmodulStartLctnHdr ; yes, calculate header parity
                      (      fvmodul.asm):00485                             ldb       #E$BMID   ; get bad module ID error
                      (      fvmodul.asm):00486                             bra       FVmodulUpError ; return error
                      (      fvmodul.asm):00487         * Calculate module header parity
03E8.                 (      fvmodul.asm):00488         FVmodulStartLctnHdr leax      2,x       ; point to start location of header calc
                      (      fvmodul.asm):00489                             lbsr      AdjBlk0   ; adjust it for block 0
                      (      fvmodul.asm):00490                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00491                             ldw       #($4A*256+M$Revs) Get initial value & count (7 bytes of header)
03E8.                 (      fvmodul.asm):00492         FVmodulModule       lbsr      LDAXY     ; get a byte from module
                      (      fvmodul.asm):00493                             eorr      a,e       add it into running parity
                      (      fvmodul.asm):00494                             decf                ; done full header?
                      (      fvmodul.asm):00495                             bne       FVmodulModule ; no, keep going
                      (      fvmodul.asm):00496                             ince                ; valid parity?
                      (      fvmodul.asm):00497                           ELSE
                      (      fvmodul.asm):00498                             leas      -1,s      ; make var
                      (      fvmodul.asm):00499                             ldd       #($4A*256+M$Revs) ; get initial value & count (7 bytes of header)
03E8.                 (      fvmodul.asm):00500         FVmodulModule       sta       ,s        ; save crc
                      (      fvmodul.asm):00501                             lbsr      LDAXY     ; get next byte
                      (      fvmodul.asm):00502                             eora      ,s        ; do crc
                      (      fvmodul.asm):00503                             decb                ; more?
                      (      fvmodul.asm):00504                             bne       FVmodulModule ; ..loop
                      (      fvmodul.asm):00505                             leas      1,s       ; drop var
                      (      fvmodul.asm):00506                             inca                ; $FF+1 = 00
                      (      fvmodul.asm):00507                           ENDC
                      (      fvmodul.asm):00508                             beq       FVmodulModuleDAT ; yes, skip ahead
                      (      fvmodul.asm):00509                             ldb       #E$BMHP   ; get module header parity error
                      (      fvmodul.asm):00510                             bra       FVmodulUpError ; return with error
                      (      fvmodul.asm):00511         
03E8.                 (      fvmodul.asm):00512         FVmodulModuleDAT    puls      x,y       ; restore module pointer & DAT pointer
                      (      fvmodul.asm):00513         * this checks if the module CRC checking is on or off
                      (      fvmodul.asm):00514                             lda       <D.CRC    ; is CRC checking on?
                      (      fvmodul.asm):00515                             bne       FVmodulOffModSize ; yes - go check it
                      (      fvmodul.asm):00516                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00517                             clrd                ; no, clear out
                      (      fvmodul.asm):00518                           ELSE
                      (      fvmodul.asm):00519                             clra                ; clear A
                      (      fvmodul.asm):00520                             clrb                ; clear B
                      (      fvmodul.asm):00521                           ENDC
                      (      fvmodul.asm):00522                             rts                 ; and return
                      (      fvmodul.asm):00523         
                      (      fvmodul.asm):00524         * Begin checking Module CRC
                      (      fvmodul.asm):00525         * Entry: X=Module pointer
                      (      fvmodul.asm):00526         *        Y=DAT image pointer of module
03E8.                 (      fvmodul.asm):00527         FVmodulOffModSize   ldd       #M$Size   ; get offset to module size
                      (      fvmodul.asm):00528                             lbsr      FLdTarget ; get module size
                      (      fvmodul.asm):00529                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00530                             tfr       d,w       ; move length to W
                      (      fvmodul.asm):00531                             pshs      y,x       ; preserve [X]=Buffer pointer,[Y]=DAT pointer
                      (      fvmodul.asm):00532                           ELSE
                      (      fvmodul.asm):00533                             pshs      y,x,d     ; preserve [X]=Buffer pointer,[Y]=DAT pointer
                      (      fvmodul.asm):00534                           ENDC
                      (      fvmodul.asm):00535                             ldd       #$FFFF    ; initial CRC value of $FFFFFF
                      (      fvmodul.asm):00536                             pshs      d         ; set up local 24 bit variable
                      (      fvmodul.asm):00537                             pshs      b         ; save b on the stack
                      (      fvmodul.asm):00538                             lbsr      AdjBlk0   ; adjust module pointer into block 0 for mapping
                      (      fvmodul.asm):00539                             leau      ,s        ; point to CRC accumulator
                      (      fvmodul.asm):00540         * Loop: W=# bytes left to use in CRC calc
03E8.                 (      fvmodul.asm):00541         FVmodulJoin         equ       *         ; define assembler symbol
                      (      fvmodul.asm):00542                           IFNE    H6309   ; begin conditional assembly for H6309
                      (      fvmodul.asm):00543                             tstf                ; on 256 byte boundary?
                      (      fvmodul.asm):00544                           ELSE
                      (      fvmodul.asm):00545                             tstb                ; test B and update condition codes
                      (      fvmodul.asm):00546                           ENDC
                      (      fvmodul.asm):00547                             bne       FVmodulModule2 ; no, keep going
                      (      fvmodul.asm):00548                             pshs      x         ; give up some time to system
                      (      fvmodul.asm):00549                             ldx       #1        ; load X from #1
                      (      fvmodul.asm):00550                             os9       F$Sleep   ; call OS-9 service F$Sleep
                      (      fvmodul.asm):00551                             puls      x         ; restore module pointer
03E8.                 (      fvmodul.asm):00552         FVmodulModule2      lbsr      LDAXY     ; get a byte from module into A
