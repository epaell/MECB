                      (        ffork.asm):00162                             std       P$User,u  ; save user # in new process
                      (        ffork.asm):00163                             ste       P$Prior,u Save priority in new process
                      (        ffork.asm):00164                           ELSE
                      (        ffork.asm):00165                             ldd       P$User,x  ; load D from P$User,x
                      (        ffork.asm):00166                             std       P$User,u  ; store D at P$User,u
                      (        ffork.asm):00167                             lda       P$Prior,x ; load A from P$Prior,x
                      (        ffork.asm):00168                             sta       P$Prior,u ; store A at P$Prior,u
                      (        ffork.asm):00169                           ENDC
