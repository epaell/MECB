04C0 103F02           (       fchain.asm):00037                             os9       F$Unlink  ; unlink it
04C3 103F2C           (       fchain.asm):00038                             os9       F$AProc   ; add it to active process queue
04C6 103F2D           (       fchain.asm):00039                             os9       F$NProc   ; activate it
                      (       fchain.asm):00040         * F$Chain system state entry point.
04C9 8D14             (       fchain.asm):00041         SFChain             bsr       DoChain   ; do the F$Chain
04CB 24F0             (       fchain.asm):00042                             bcc       resched@  ; branch if OK
04CD 3404             (       fchain.asm):00043         chainerr@           pshs      b         ; save off B for now
04CF E78836           (       fchain.asm):00044                             stb       <P$Signal,x ; save off error code
04D2 E60D             (       fchain.asm):00045                             ldb       P$State,x ; get process state
