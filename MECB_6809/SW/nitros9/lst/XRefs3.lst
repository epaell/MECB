                      (/../../defs/os9.d):01124                             IFNE      H6309
0005                  (/../../defs/os9.d):01125         R$E                 EQU       3                   E Accumulator
0005                  (/../../defs/os9.d):01126         R$F                 EQU       4                   F Accumulator
0005                  (/../../defs/os9.d):01127         R$W                 EQU       R$E                 Combined E:F Accumulator
0005                  (/../../defs/os9.d):01128         R$Q                 EQU       R$A                 Combined A:B:E:F Accumulator
