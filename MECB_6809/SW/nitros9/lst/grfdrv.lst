                      (       cocovtio.d):00243         * Pointer Device Packet Definition
                      (       cocovtio.d):00244         *
                      (       cocovtio.d):00245                             ORG       0
0000                  (       cocovtio.d):00246         Pt.Valid            RMB       1                   Is returned info valid (0=no/1=yes)
0001                  (       cocovtio.d):00247         Pt.Actv             RMB       1                   Active Side 0=off/1=Right/2=left
0002                  (       cocovtio.d):00248         Pt.ToTm             RMB       1                   Time out Initial value
0003                  (       cocovtio.d):00249                             RMB       2                   reserved
0005                  (       cocovtio.d):00250         Pt.TTTo             RMB       1                   Time Till Timeout
0006                  (       cocovtio.d):00251         Pt.TSSt             RMB       2                   Time Since Start Counter
0008                  (       cocovtio.d):00252         Pt.CBSA             RMB       1                   Current Button State Button A
0009                  (       cocovtio.d):00253         Pt.CBSB             RMB       1                   Current Button State Button B
000A                  (       cocovtio.d):00254         Pt.CCtA             RMB       1                   Click Count Button A
000B                  (       cocovtio.d):00255         Pt.CCtB             RMB       1                   Click Count Button B
000C                  (       cocovtio.d):00256         Pt.TTSA             RMB       1                   Time This State Counter Button A
000D                  (       cocovtio.d):00257         Pt.TTSB             RMB       1                   Time This State Counter Button B
000E                  (       cocovtio.d):00258         Pt.TLSA             RMB       1                   Time Last State Counter Button A
000F                  (       cocovtio.d):00259         Pt.TLSB             RMB       1                   Time Last State Counter Button B
0010                  (       cocovtio.d):00260                             RMB       2                   Reserved
0012                  (       cocovtio.d):00261         Pt.BDX              RMB       2                   Button down X value EXPERIMENTAL
0014                  (       cocovtio.d):00262         Pt.BDY              RMB       2                   Button down Y value
0016                  (       cocovtio.d):00263         Pt.Stat             RMB       1                   Window Pointer type location
0017                  (       cocovtio.d):00264         Pt.Res              RMB       1                   Resolution (0..640 by: 0=ten/1=one)
0018                  (       cocovtio.d):00265         Pt.AcX              RMB       2                   Actual X Value
001A                  (       cocovtio.d):00266         Pt.AcY              RMB       2                   Actual Y Value
001C                  (       cocovtio.d):00267         Pt.WRX              RMB       2                   Window Relative X
001E                  (       cocovtio.d):00268         Pt.WRY              RMB       2                   Window Relative Y
     0020             (       cocovtio.d):00269         Pt.Siz              EQU       .                   Packet Size 32 bytes
