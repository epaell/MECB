0004                  (       cocovtio.d):00142         V.51CursorOn        RMB       1                   * Is cursor on ? 1=yes 0=no
0004                  (       cocovtio.d):00143         V.51XORFlag         RMB       1                   * and data to screen (0) or Xor (1)
0004                  (       cocovtio.d):00144         V.51ScreenMask1     RMB       1                   * screen masks for drawing characters on screen
0004                  (       cocovtio.d):00145         V.51ScreenMask2     RMB       1
                      (       cocovtio.d):00146         * End of CoHR vars
                      (       cocovtio.d):00147         **** Note these have to come at the end of the defs, or the keyboard ****
                      (       cocovtio.d):00148         **** code can clobber variables defined after these !                ****
0004                  (       cocovtio.d):00149         V.IBufH             RMB       1                   input buffer head
0004                  (       cocovtio.d):00150         V.IBufT             RMB       1                   input buffer tail
0004                  (       cocovtio.d):00151         V.InBuf             RMB       1                   input buffer ptr
0004                  (       cocovtio.d):00152         V.51End             RMB       1
                      (       cocovtio.d):00153                             RMB       250-.
0004                  (       cocovtio.d):00154         V.Last              EQU       .
                      (       cocovtio.d):00155         
                      (       cocovtio.d):00156         
                      (       cocovtio.d):00157         * Unknown for now
                      (       cocovtio.d):00158         *VD.FFMem rmb   2  (2) bottom of stack for flood fill
                      (       cocovtio.d):00159         *VD.FFSPt rmb   2  (2) flood fill stack pointer
                      (       cocovtio.d):00160         *VD.FFSTp rmb   2  (2) flood fill stack top pointer
                      (       cocovtio.d):00161         *VD.FF6   rmb   1   flood fill flag
                      (       cocovtio.d):00162         *VD.MCol2 rmb   1  color
                      (       cocovtio.d):00163         *VD.FF1   rmb   1  data for flood fill
                      (       cocovtio.d):00164         *VD.FF2   rmb   1  data for flood fill
                      (       cocovtio.d):00165         *VD.FFMsk rmb   1  flood fill mask
                      (       cocovtio.d):00166         *VD.FFFlg rmb   1  flood fill flag
                      (       cocovtio.d):00167         *VD.Palet rmb   16 (16) current palette values
                      (       cocovtio.d):00168         *VD.PlFlg rmb   1  initialized to $08 by L00DB, and then unused!
                      (       cocovtio.d):00169         
                      (       cocovtio.d):00170         *
                      (       cocovtio.d):00171         * Defs for V.COLoad flags.
                      (       cocovtio.d):00172         *
                      (       cocovtio.d):00173         
0004                  (       cocovtio.d):00174         ModCoVDG            EQU       %00000010           CoVDG, Built-in VDG 32x16.
0004                  (       cocovtio.d):00175         ModCoWP             EQU       %00000100           CoWP, WordPak, 80x25
0004                  (       cocovtio.d):00176         ModCoHR             EQU       %00001000           CoHR, PMODE 4 51x25 text
0004                  (       cocovtio.d):00177         ModCo42             EQU       %00010000           Co42, PMODE 4 42x25 text
0004                  (       cocovtio.d):00178         ModCoVGA            EQU       %00100000           CoVGA, 64x32 text
0004                  (       cocovtio.d):00179         ModCo80             EQU       %01000000           Co80, CRT9128 WordPak, 80x25
0004                  (       cocovtio.d):00180         ModCoDPlus          EQU       %10000000           Dragon Plus, 6545, 80x24
                      (       cocovtio.d):00181         
                      (       cocovtio.d):00182         *
                      (       cocovtio.d):00183         * Defs for cursor flash counter
                      (       cocovtio.d):00184         *
                      (       cocovtio.d):00185         
0004                  (       cocovtio.d):00186         CFlash50hz          EQU       25                  * 50Hz flash counter
0004                  (       cocovtio.d):00187         CFlash60Hz          EQU       30                  * 60Hz flash counter
