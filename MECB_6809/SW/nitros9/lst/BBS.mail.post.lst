                      (            os9.d):01053         *****************************
                      (            os9.d):01054         * Device Driver Entry Offsets
                      (            os9.d):01055         *
                      (            os9.d):01056                             ORG       0
0000                  (            os9.d):01057         D$INIT              RMB       3                   Device Initialization
0003                  (            os9.d):01058         D$READ              RMB       3                   Read from Device
0006                  (            os9.d):01059         D$WRIT              RMB       3                   Write to Device
0009                  (            os9.d):01060         D$GSTA              RMB       3                   Get Device Status
000C                  (            os9.d):01061         D$PSTA              RMB       3                   Put Device Status
000F                  (            os9.d):01062         D$TERM              RMB       3                   Device Termination
                      (            os9.d):01063         
                      (            os9.d):01064         *********************
                      (            os9.d):01065         * Device Table Format
                      (            os9.d):01066         *
                      (            os9.d):01067                             ORG       0
0000                  (            os9.d):01068         V$DRIV              RMB       2                   Device Driver module
0002                  (            os9.d):01069         V$STAT              RMB       2                   Device Driver Static storage
0004                  (            os9.d):01070         V$DESC              RMB       2                   Device Descriptor module
0006                  (            os9.d):01071         V$FMGR              RMB       2                   File Manager module
0008                  (            os9.d):01072         V$USRS              RMB       1                   use count
                      (            os9.d):01073                             IFGT      Level-1
0009                  (            os9.d):01074         V$DRIVEX            RMB       2                   Device Driver execution address
000B                  (            os9.d):01075         V$FMGREX            RMB       2                   File Manager execution address
                      (            os9.d):01076                             ENDC
     000D             (            os9.d):01077         DEVSIZ              EQU       .
                      (            os9.d):01078         
                      (            os9.d):01079         *******************************
                      (            os9.d):01080         * Device Static Storage Offsets
                      (            os9.d):01081         *
                      (            os9.d):01082                             ORG       0
0000                  (            os9.d):01083         V.PAGE              RMB       1                   Port Extended Address
0001                  (            os9.d):01084         V.PORT              RMB       2                   Device 'Base' Port Address
0003                  (            os9.d):01085         V.LPRC              RMB       1                   Last Active Process ID
0004                  (            os9.d):01086         V.BUSY              RMB       1                   Active Process ID (0=UnBusy)
0005                  (            os9.d):01087         V.WAKE              RMB       1                   Active PD if Driver MUST Wake-up
     0006             (            os9.d):01088         V.USER              EQU       .                   Driver Allocation Origin
                      (            os9.d):01089         
                      (            os9.d):01090         ********************************
                      (            os9.d):01091         * Interrupt Polling Table Format
                      (            os9.d):01092         *
                      (            os9.d):01093                             ORG       0
0000                  (            os9.d):01094         Q$POLL              RMB       2                   Absolute Polling Address
0002                  (            os9.d):01095         Q$FLIP              RMB       1                   Flip (EOR) Byte ..normally Zero
0003                  (            os9.d):01096         Q$MASK              RMB       1                   Polling Mask (after Flip)
0004                  (            os9.d):01097         Q$SERV              RMB       2                   Absolute Service routine Address
0006                  (            os9.d):01098         Q$STAT              RMB       2                   Static Storage Address
0008                  (            os9.d):01099         Q$PRTY              RMB       1                   Priority (Low Numbers=Top Priority)
                      (            os9.d):01100                             IFGT      Level-1
0009                  (            os9.d):01101         Q$MAP               RMB       2                   NitrOS-9 Level 2 and above
                      (            os9.d):01102                             ENDC
     000B             (            os9.d):01103         POLSIZ              EQU       .
                      (            os9.d):01104         
                      (            os9.d):01105         ********************
                      (            os9.d):01106         * VIRQ packet format
                      (            os9.d):01107         *
                      (            os9.d):01108                             ORG       0
0000                  (            os9.d):01109         Vi.Cnt              RMB       2                   count down counter
0002                  (            os9.d):01110         Vi.Rst              RMB       2                   reset value for counter
0004                  (            os9.d):01111         Vi.Stat             RMB       1                   status byte
     0005             (            os9.d):01112         Vi.PkSz             EQU       .
                      (            os9.d):01113         
     0001             (            os9.d):01114         Vi.IFlag            EQU       %00000001           status byte virq flag
                      (            os9.d):01115         
                      (            os9.d):01116                             PAG
                      (            os9.d):01117         *************************************
                      (            os9.d):01118         * Machine Characteristics Definitions
                      (            os9.d):01119         *
     0000             (            os9.d):01120         R$CC                EQU       0                   Condition Codes register
     0001             (            os9.d):01121         R$A                 EQU       1                   A Accumulator
     0002             (            os9.d):01122         R$B                 EQU       2                   B Accumulator
     0001             (            os9.d):01123         R$D                 EQU       R$A                 Combined A:B Accumulator
                      (            os9.d):01124                             IFNE      H6309
0005                  (            os9.d):01125         R$E                 EQU       3                   E Accumulator
0005                  (            os9.d):01126         R$F                 EQU       4                   F Accumulator
0005                  (            os9.d):01127         R$W                 EQU       R$E                 Combined E:F Accumulator
0005                  (            os9.d):01128         R$Q                 EQU       R$A                 Combined A:B:E:F Accumulator
0005                  (            os9.d):01129         R$DP                EQU       5                   Direct Page register
0005                  (            os9.d):01130         R$X                 EQU       6                   X Index register
0005                  (            os9.d):01131         R$Y                 EQU       8                   Y Index register
0005                  (            os9.d):01132         R$U                 EQU       10                  User Stack register
0005                  (            os9.d):01133         R$PC                EQU       12                  Program Counter register
0005                  (            os9.d):01134         R$Size              EQU       14                  Total register package size
                      (            os9.d):01135                             ELSE
     0003             (            os9.d):01136         R$DP                EQU       3                   Direct Page register
     0004             (            os9.d):01137         R$X                 EQU       4                   X Index register
     0006             (            os9.d):01138         R$Y                 EQU       6                   Y Index register
     0008             (            os9.d):01139         R$U                 EQU       8                   User Stack register
     000A             (            os9.d):01140         R$PC                EQU       10                  Program Counter register
     000C             (            os9.d):01141         R$Size              EQU       12                  Total register package size
                      (            os9.d):01142                             ENDC
                      (            os9.d):01143         
                      (            os9.d):01144         * MD register masks
                      (            os9.d):01145         * 6309 definitions
     0080             (            os9.d):01146         DIV0                EQU       %10000000           division by 0 trap flag       : 1 = trap occured
     0040             (            os9.d):01147         badinstr            EQU       %01000000           illegal instruction trap flag : 1 = trap occured
                      (            os9.d):01148         
     0080             (            os9.d):01149         Entire              EQU       %10000000           Full Register Stack flag
     0040             (            os9.d):01150         FIRQMask            EQU       %01000000           Fast-Interrupt Mask bit
     0020             (            os9.d):01151         HalfCrry            EQU       %00100000           Half Carry flag
     0010             (            os9.d):01152         IRQMask             EQU       %00010000           Interrupt Mask bit
     0008             (            os9.d):01153         Negative            EQU       %00001000           Negative flag
     0004             (            os9.d):01154         Zero                EQU       %00000100           Zero flag
     0002             (            os9.d):01155         TwosOvfl            EQU       %00000010           Two's Comp Overflow flag
     0001             (            os9.d):01156         Carry               EQU       %00000001           Carry bit
     0050             (            os9.d):01157         IntMasks            EQU       IRQMask+FIRQMask
     0080             (            os9.d):01158         Sign                EQU       %10000000           sign bit
