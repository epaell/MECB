                      (            os9.d):01144         * MD register masks
                      (            os9.d):01145         * 6309 definitions
     0080             (            os9.d):01146         DIV0                EQU       %10000000           division by 0 trap flag       : 1 = trap occured
     0040             (            os9.d):01147         badinstr            EQU       %01000000           illegal instruction trap flag : 1 = trap occured
                      (            os9.d):01148         
     0080             (            os9.d):01149         Entire              EQU       %10000000           Full Register Stack flag
     0040             (            os9.d):01150         FIRQMask            EQU       %01000000           Fast-Interrupt Mask bit
     0020             (            os9.d):01151         HalfCrry            EQU       %00100000           Half Carry flag
     0010             (            os9.d):01152         IRQMask             EQU       %00010000           Interrupt Mask bit
     0008             (            os9.d):01153         Negative            EQU       %00001000           Negative flag
     0004             (            os9.d):01154         Zero                EQU       %00000100           Zero flag
     0002             (            os9.d):01155         TwosOvfl            EQU       %00000010           Two's Comp Overflow flag
     0001             (            os9.d):01156         Carry               EQU       %00000001           Carry bit
     0050             (            os9.d):01157         IntMasks            EQU       IRQMask+FIRQMask
     0080             (            os9.d):01158         Sign                EQU       %10000000           sign bit
