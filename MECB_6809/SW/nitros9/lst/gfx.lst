                      (s/basic09/gfx.asm):00264         
                      (s/basic09/gfx.asm):00265         ;;; LINE - Draw a line.
                      (s/basic09/gfx.asm):00266         ;;;
                      (s/basic09/gfx.asm):00267         ;;; Calling syntax: RUN GFX("Line",x2,y2)
                      (s/basic09/gfx.asm):00268         ;;;                 RUN GFX("Line",x2,y2,Color)
                      (s/basic09/gfx.asm):00269         ;;;                 RUN GFX("Line,xl,yl,x2,y2)
                      (s/basic09/gfx.asm):00270         ;;;                 RUN GFX("Line,xl,yl,x2,y2,Color)
                      (s/basic09/gfx.asm):00271         ;;;
                      (s/basic09/gfx.asm):00272         ;;; LINE draws lines in various ways. If one coordinate is given, the
                      (s/basic09/gfx.asm):00273         ;;; line will be drawn from the current graphics cursor position to the
                      (s/basic09/gfx.asm):00274         ;;; coordinates specified, If two sets of coordinates are given, they
                      (s/basic09/gfx.asm):00275         ;;; are used as the start and end points of the line. The line will be
                      (s/basic09/gfx.asm):00276         ;;; drawn in the current foreground color unless a new color is given as
                      (s/basic09/gfx.asm):00277         ;;; a parameter. After the line is drawn the graphics cursor will be
                      (s/basic09/gfx.asm):00278         ;;; positioned at x2,y2.
                      (s/basic09/gfx.asm):00279         ;;;
                      (s/basic09/gfx.asm):00280         ;;; This example draws a line from (O,O) to (0,192):
                      (s/basic09/gfx.asm):00281         ;;;
                      (s/basic09/gfx.asm):00282         ;;;    RUN GFX("Line",0,0,0,192)
                      (s/basic09/gfx.asm):00283         ;;;
