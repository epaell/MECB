007D 4D               (s/basic09/gfx.asm):00131                             tsta                          parameter count greater than 255?
007E 2634             (s/basic09/gfx.asm):00132                             bne       BadFunc             yep, branch to error
0080 338DFF8D         (s/basic09/gfx.asm):00133                             leau      >FuncTbl,pcr        point to function pointer table
0084 10AEC1           (s/basic09/gfx.asm):00134         nextentry           ldy       ,u++                get pointer to function
0087 2727             (s/basic09/gfx.asm):00135                             beq       NoFunc              branch if zero (end of table)
                      (s/basic09/gfx.asm):00136         
