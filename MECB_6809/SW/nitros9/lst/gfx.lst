                      (            os9.d):01118         * Machine Characteristics Definitions
                      (            os9.d):01119         *
     0000             (            os9.d):01120         R$CC                EQU       0                   Condition Codes register
     0001             (            os9.d):01121         R$A                 EQU       1                   A Accumulator
     0002             (            os9.d):01122         R$B                 EQU       2                   B Accumulator
     0001             (            os9.d):01123         R$D                 EQU       R$A                 Combined A:B Accumulator
                      (            os9.d):01124                             IFNE      H6309
0005                  (            os9.d):01125         R$E                 EQU       3                   E Accumulator
0005                  (            os9.d):01126         R$F                 EQU       4                   F Accumulator
0005                  (            os9.d):01127         R$W                 EQU       R$E                 Combined E:F Accumulator
0005                  (            os9.d):01128         R$Q                 EQU       R$A                 Combined A:B:E:F Accumulator
0005                  (            os9.d):01129         R$DP                EQU       5                   Direct Page register
0005                  (            os9.d):01130         R$X                 EQU       6                   X Index register
0005                  (            os9.d):01131         R$Y                 EQU       8                   Y Index register
0005                  (            os9.d):01132         R$U                 EQU       10                  User Stack register
0005                  (            os9.d):01133         R$PC                EQU       12                  Program Counter register
0005                  (            os9.d):01134         R$Size              EQU       14                  Total register package size
                      (            os9.d):01135                             ELSE
     0003             (            os9.d):01136         R$DP                EQU       3                   Direct Page register
     0004             (            os9.d):01137         R$X                 EQU       4                   X Index register
     0006             (            os9.d):01138         R$Y                 EQU       6                   Y Index register
     0008             (            os9.d):01139         R$U                 EQU       8                   User Stack register
     000A             (            os9.d):01140         R$PC                EQU       10                  Program Counter register
     000C             (            os9.d):01141         R$Size              EQU       12                  Total register package size
                      (            os9.d):01142                             ENDC
