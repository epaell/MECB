                      (s/basic09/gfx.asm):00170         ;;; MODE - Set the graphics mode.
                      (s/basic09/gfx.asm):00171         ;;;
                      (s/basic09/gfx.asm):00172         ;;; Calling syntax: RUN GFX("Mode",Format,Color)
                      (s/basic09/gfx.asm):00173         ;;;
                      (s/basic09/gfx.asm):00174         ;;; MODE switches the screen from alphanumeric to graphics display mode,
                      (s/basic09/gfx.asm):00175         ;;; and selects the screen mode and color code. "Format" determines
                      (s/basic09/gfx.asm):00176         ;;; between two-color (Format= 0), or four-color (Format= 1) graphics
                      (s/basic09/gfx.asm):00177         ;;; modes. "Color" is the initial color code that specifies the
                      (s/basic09/gfx.asm):00178         ;;; foreground color and color set.
                      (s/basic09/gfx.asm):00179         ;;;
                      (s/basic09/gfx.asm):00180         ;;; This command must be given before any other graphics command is
                      (s/basic09/gfx.asm):00181         ;;; used. The first time MODE is called, it requests 6KB of memory
                      (s/basic09/gfx.asm):00182         ;;; from OS-9 for use as the graphics display memory. MODE will return
                      (s/basic09/gfx.asm):00183         ;;; an error if sufficient free memory is not available.
                      (s/basic09/gfx.asm):00184         ;;;
                      (s/basic09/gfx.asm):00185         ;;; This example selects four-color mode graphics with a red foreground
                      (s/basic09/gfx.asm):00186         ;;; color.
                      (s/basic09/gfx.asm):00187         ;;;
                      (s/basic09/gfx.asm):00188         ;;;    RUN GFX("Mode",1,3)
00BA 860F             (s/basic09/gfx.asm):00189         Mode                lda       #$0F                load the function code
00BC 2002             (s/basic09/gfx.asm):00190                             bra       ThreeParms          process the parameters
                      (s/basic09/gfx.asm):00191         
                      (s/basic09/gfx.asm):00192         ;;; MOVE - Move the graphics cursor.
                      (s/basic09/gfx.asm):00193         ;;;
                      (s/basic09/gfx.asm):00194         ;;; Calling syntax: RUN GFX("Move",X,Y)
                      (s/basic09/gfx.asm):00195         ;;;
                      (s/basic09/gfx.asm):00196         ;;; MOVE positions the invisible graphics cursor to the specified
                      (s/basic09/gfx.asm):00197         ;;; location without changing the display. X and Y are the coordinates
                      (s/basic09/gfx.asm):00198         ;;; of the new position.
                      (s/basic09/gfx.asm):00199         ;;;
                      (s/basic09/gfx.asm):00200         ;;; This example positions the cursor in the lower left-hand corner.
                      (s/basic09/gfx.asm):00201         ;;;
                      (s/basic09/gfx.asm):00202         ;;;   RUN GFX("Move",0,0)
00BE 8615             (s/basic09/gfx.asm):00203         Move                lda       #$15                load the "get graphics cursor" code
00C0 C103             (s/basic09/gfx.asm):00204         ThreeParms          cmpb      #$03                this number of parameters?
00C2 26F0             (s/basic09/gfx.asm):00205                             bne       BadFunc             branch if not (error out)
00C4 204C             (s/basic09/gfx.asm):00206                             bra       StoreAppend2Write   write it out
                      (s/basic09/gfx.asm):00207         
                      (s/basic09/gfx.asm):00208         ;;; COLOR - Set the foreground color.
                      (s/basic09/gfx.asm):00209         ;;;
                      (s/basic09/gfx.asm):00210         ;;; Calling syntax: RUN GFX("Color",Color)
                      (s/basic09/gfx.asm):00211         ;;;
                      (s/basic09/gfx.asm):00212         ;;; COLOR changes the current foreground color (and possibly the color
                      (s/basic09/gfx.asm):00213         ;;; set). The current graphics mode and cursor position are not
                      (s/basic09/gfx.asm):00214         ;;; changed.
                      (s/basic09/gfx.asm):00215         ;;;
                      (s/basic09/gfx.asm):00216         ;;; This example changes the foreground color to green in four-color format (or black
                      (s/basic09/gfx.asm):00217         ;;; in two-color format):
                      (s/basic09/gfx.asm):00218         ;;;
                      (s/basic09/gfx.asm):00219         ;;;    RUN GFX("Color",O)
00C6 8611             (s/basic09/gfx.asm):00220         CColor              lda       #$11                load the "color" code
00C8 201B             (s/basic09/gfx.asm):00221                             bra       TwoParms            process two parameters
                      (s/basic09/gfx.asm):00222         
                      (s/basic09/gfx.asm):00223         ;;; POINT - Set a pixel at a point.
                      (s/basic09/gfx.asm):00224         ;;;
                      (s/basic09/gfx.asm):00225         ;;; Calling syntax: RUN GFX("Point",X,Y)
                      (s/basic09/gfx.asm):00226         ;;;                 RUN GFX("Point",X,Y,Color)
                      (s/basic09/gfx.asm):00227         ;;;
                      (s/basic09/gfx.asm):00228         ;;; POINT moves the graphics cursor to the specified X,Y coordinate and
                      (s/basic09/gfx.asm):00229         ;;; sets the pixel at that coordinate to the current foreground color.
                      (s/basic09/gfx.asm):00230         ;;; If the optional "Color" is specified, the current foreground color
                      (s/basic09/gfx.asm):00231         ;;; is set to the given "Color".
                      (s/basic09/gfx.asm):00232         ;;;
                      (s/basic09/gfx.asm):00233         ;;; This example moves the cursor to the upper left-hand corner and changes the
                      (s/basic09/gfx.asm):00234         ;;; foreground color to green in two-color format, or it changes the
                      (s/basic09/gfx.asm):00235         ;;; color to yellow in the four-color format.
                      (s/basic09/gfx.asm):00236         ;;;
                      (s/basic09/gfx.asm):00237         ;;;    RUN GFX("Point",0,192,1)
