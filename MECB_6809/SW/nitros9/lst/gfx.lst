                      (s/basic09/gfx.asm):00247         
                      (s/basic09/gfx.asm):00248         ;;; CLEAR - Reset all points on the screen.
                      (s/basic09/gfx.asm):00249         ;;;
                      (s/basic09/gfx.asm):00250         ;;; Calling syntax: RUN GFX("Clear")
                      (s/basic09/gfx.asm):00251         ;;;                 RUN GFX("Clear", color)
                      (s/basic09/gfx.asm):00252         ;;;
                      (s/basic09/gfx.asm):00253         ;;; CLEAR resets all points on the screen to the background color, or if the optional
                      (s/basic09/gfx.asm):00254         ;;; color is given, presets the screen to that color. The current graphics cursor is
                      (s/basic09/gfx.asm):00255         ;;; reset to (0,0).
