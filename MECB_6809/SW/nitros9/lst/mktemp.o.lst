                      (        mktemp.as):00002         ;;;
                      (        mktemp.as):00003         ;;; Create a temporary file.
                      (        mktemp.as):00004         ;;;
                      (        mktemp.as):00005         ;;; Other modules needed: BIN_HEX
                      (        mktemp.as):00006         ;;;
                      (        mktemp.as):00007         ;;; Entry:  D = The address of the filename.
                      (        mktemp.as):00008         ;;;
                      (        mktemp.as):00009         ;;; All registers except CC are preserved.
                      (        mktemp.as):00010         ;;;
                      (        mktemp.as):00011         ;;; This subroutine creates a temporary filename by adding a "." and a two digit hexadecimal
                      (        mktemp.as):00012         ;;; value based on the process ID.
                      (        mktemp.as):00013         ;;;
                      (        mktemp.as):00014         ;;; IMPORTANT: there must be room after the filename
                      (        mktemp.as):00015         ;;; for at least 6 bytes. Filenames must be in variable
                      (        mktemp.as):00016         ;;; area, not parameter or program sections.
                      (        mktemp.as):00017         
                      (        mktemp.as):00018                             section   .text
                      (        mktemp.as):00019         
