1F6D 260A             (       board90.as):01054                             bne       SEL5
1F6F 308DEA6E         (       board90.as):01055                             leax      B4STRT,pcr
1F73 108E035D         (       board90.as):01056                             ldy       #B4END
1F77 202F             (       board90.as):01057                             bra       BRDOUT
1F79 4A               (       board90.as):01058         SEL5                deca
1F7A 260A             (       board90.as):01059                             bne       SEL6
1F7C 308DEDBE         (       board90.as):01060                             leax      B5STRT,pcr
1F80 108E03D5         (       board90.as):01061                             ldy       #B5END
1F84 2022             (       board90.as):01062                             bra       BRDOUT
1F86 4A               (       board90.as):01063         SEL6                deca
1F87 260A             (       board90.as):01064                             bne       SEL7
1F89 308DF186         (       board90.as):01065                             leax      B6STRT,pcr
1F8D 108E04CB         (       board90.as):01066                             ldy       #B6END
1F91 2015             (       board90.as):01067                             bra       BRDOUT
1F93 4A               (       board90.as):01068         SEL7                deca
1F94 260A             (       board90.as):01069                             bne       SEL8
1F96 308DF644         (       board90.as):01070                             leax      B7STRT,pcr
1F9A 108E04FB         (       board90.as):01071                             ldy       #B7END
1F9E 2008             (       board90.as):01072                             bra       BRDOUT
1FA0 308DFB35         (       board90.as):01073         SEL8                leax      B8STRT,pcr
1FA4 108E0441         (       board90.as):01074                             ldy       #B8END
                      (       board90.as):01075         
1FA8 A6C90000         (       board90.as):01076         BRDOUT              lda       PATH,U
1FAC 103F00           (       board90.as):01077                             os9       I$Write
1FAF 10250000         (       board90.as):01078                             lbcs      ERR1
                      (       board90.as):01079         
                      (       board90.as):01080         *   Now put board number at bottom of screen
                      (       board90.as):01081         
1FB3 B60000           (       board90.as):01082         SCNUMB              lda       BRDNUM              Get current board #
1FB6 8B30             (       board90.as):01083                             adda      #48                 Convert to ascii
1FB8 30C90000         (       board90.as):01084                             leax      SCNNUM,U            Point to string
1FBC A70B             (       board90.as):01085                             sta       11,X                Put board# in string
1FBE 108E000C         (       board90.as):01086                             ldy       #12                 Output 12 bytes
1FC2 170000           (       board90.as):01087                             lbsr      OUTSTR
                      (       board90.as):01088         
1FC5 39               (       board90.as):01089                             rts
                      (       board90.as):01090         
                      (       board90.as):01091         *   These routines are used at start of game, after
                      (       board90.as):01092         *   being used once then BOARDB is used.
                      (       board90.as):01093         
1FC6 12               (       board90.as):01094         BOARDC              nop
1FC7 30C90000         (       board90.as):01095                             leax      FSCORE,U            Point to high score array
1FCB 300F             (       board90.as):01096                             leax      15,X                Point to highest score
1FCD 31C90000         (       board90.as):01097                             leay      HSCASC,U
1FD1 C606             (       board90.as):01098                             ldb       #6
1FD3 A680             (       board90.as):01099         HLOOP               lda       ,X+                 Transfer file high score
1FD5 A7A0             (       board90.as):01100                             sta       ,Y+
1FD7 5A               (       board90.as):01101                             decb
1FD8 26F9             (       board90.as):01102                             bne       HLOOP
                      (       board90.as):01103         
                      (       board90.as):01104         *    These 9 bytes are used to put the board
                      (       board90.as):01105         *         number on screen
                      (       board90.as):01106         
1FDA 308DFF58         (       board90.as):01107         SETSCN              leax      SCNSET,pcr
1FDE 31C90000         (       board90.as):01108                             leay      SCNNUM,U
1FE2 C60C             (       board90.as):01109                             ldb       #12                 Transfer 12 bytes
1FE4 A680             (       board90.as):01110         SELOOP              lda       ,X+                 Get a byte
1FE6 A7A0             (       board90.as):01111                             sta       ,Y+                 Transfer it
1FE8 5A               (       board90.as):01112                             decb
1FE9 26F9             (       board90.as):01113                             bne       SELOOP              Loop till done
                      (       board90.as):01114         
1FEB 17FF54           (       board90.as):01115                             lbsr      BOARDB              Go select start screen
                      (       board90.as):01116         
                      (       board90.as):01117         *     Transfer score set bytes to the rmb's in MAIN
                      (       board90.as):01118         
1FEE 308DFF28         (       board90.as):01119         SETSCR              leax      SCRSET,pcr          Point to bytes to transfer
1FF2 31C90000         (       board90.as):01120                             leay      SCRPOS,U            Point to where bytes go
1FF6 C61C             (       board90.as):01121                             ldb       #28                 Transfer 28 bytes
1FF8 A680             (       board90.as):01122         SLOOP               lda       ,X+                 Get a byte
1FFA A7A0             (       board90.as):01123                             sta       ,Y+                 Store it
1FFC 5A               (       board90.as):01124                             decb                          Decrement counter
1FFD 26F9             (       board90.as):01125                             bne       SLOOP               Loop till done
                      (       board90.as):01126         
                      (       board90.as):01127         *     This routine will place the DOTS and POWER PILLS on the screen
                      (       board90.as):01128         *      This routine will also be used to reset the screen when
                      (       board90.as):01129         *      pacman gets caught by the ghosts.
                      (       board90.as):01130         
1FFF 30C90000         (       board90.as):01131         PDOTS               leax      ARRAY,U             Point to start of array
2003 308846           (       board90.as):01132                             leax      70,X                Set X reg. to first dot location
