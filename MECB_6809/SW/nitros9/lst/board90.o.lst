                      (       board90.as):01036         *
1F42 B60000           (       board90.as):01037         BOARDB              lda       BRDNUM              Get board number
1F45 4A               (       board90.as):01038                             deca
1F46 260A             (       board90.as):01039                             bne       SEL2
1F48 308DE0B4         (       board90.as):01040                             leax      B1STRT,pcr
1F4C 108E0321         (       board90.as):01041                             ldy       #B1END
1F50 2056             (       board90.as):01042                             bra       BRDOUT
1F52 4A               (       board90.as):01043         SEL2                deca
1F53 260A             (       board90.as):01044                             bne       SEL3
1F55 308DE3C8         (       board90.as):01045                             leax      B2STRT,pcr
1F59 108E0327         (       board90.as):01046                             ldy       #B2END
1F5D 2049             (       board90.as):01047                             bra       BRDOUT
1F5F 4A               (       board90.as):01048         SEL3                deca
1F60 260A             (       board90.as):01049                             bne       SEL4
1F62 308DE6E2         (       board90.as):01050                             leax      B3STRT,pcr
1F66 108E0399         (       board90.as):01051                             ldy       #B3END
1F6A 203C             (       board90.as):01052                             bra       BRDOUT
