                      (           rnd.as):00001         ;;; RND
                      (           rnd.as):00002         ;;;
                      (           rnd.as):00003         ;;; Generate a random number.
                      (           rnd.as):00004         ;;;
                      (           rnd.as):00005         ;;; Entry:  D = The maximum value of the random number.
                      (           rnd.as):00006         ;;;
                      (           rnd.as):00007         ;;; Exit:   D = The random number.
                      (           rnd.as):00008         
                      (           rnd.as):00009         * Subroutine to calc. a random number
                      (           rnd.as):00010         * Based on routine by L.A. Middaugh
                      (           rnd.as):00011         *                     The Rainbow Jan/85 p. 277
                      (           rnd.as):00012         * Value truncated so that it is =>0 and <=passed value in D.
                      (           rnd.as):00013         
                      (           rnd.as):00014                             section   .bss
                      (           rnd.as):00015         
0000                  (           rnd.as):00016         SEED                rmb       4
                      (           rnd.as):00017         
                      (           rnd.as):00018                             endsect
                      (           rnd.as):00019         
