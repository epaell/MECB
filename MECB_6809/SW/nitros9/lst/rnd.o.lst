0005 C608             (           rnd.as):00025                             ldb       #8                  number of shifts
0007 A603             (           rnd.as):00026         loop                lda       3,x                 exclusive or bit 28 with 31
0009 46               (           rnd.as):00027                             rora
000A 46               (           rnd.as):00028                             rora
000B 46               (           rnd.as):00029                             rora
000C A803             (           rnd.as):00030                             eora      3,x
000E 46               (           rnd.as):00031                             rora                          result in carry
000F 46               (           rnd.as):00032                             rora
0010 6600             (           rnd.as):00033                             ror       0,x                 rotate carry into bit0
0012 6601             (           rnd.as):00034                             ror       1,x
0014 6602             (           rnd.as):00035                             ror       2,x
0016 6603             (           rnd.as):00036                             ror       3,x
0018 5A               (           rnd.as):00037                             decb                          do 8 times
0019 26EC             (           rnd.as):00038                             bne       loop
001B EC01             (           rnd.as):00039                             ldd       1,x                 get rnd value
001D 2606             (           rnd.as):00040                             bne       trunc               ensure we never return a 0
001F 6C01             (           rnd.as):00041                             inc       1,x                 fudge it so we get a non-zero
0021 6C03             (           rnd.as):00042                             inc       3,x
0023 20DD             (           rnd.as):00043                             bra       rnd0
                      (           rnd.as):00044         
0025 10A3E4           (           rnd.as):00045         trunc               cmpd      ,s                  in range specified?
