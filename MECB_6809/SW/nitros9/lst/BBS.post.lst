                      (            rbf.d):00085         *******************************
                      (            rbf.d):00086         * RBF Device Descriptor Offsets
                      (            rbf.d):00087         *
                      (            rbf.d):00088         * These definitions are for RBF device descriptors.
                      (            rbf.d):00089         
                      (            rbf.d):00090                             ORG       M$DTyp
0012                  (            rbf.d):00091                             RMB       1                   Device type (DT.RBF)
0013                  (            rbf.d):00092         IT.DRV              RMB       1                   Drive number
0014                  (            rbf.d):00093         IT.STP              RMB       1                   Step rate
0015                  (            rbf.d):00094         IT.TYP              RMB       1                   Disk device type information
0016                  (            rbf.d):00095         IT.DNS              RMB       1                   Density capability
0017                  (            rbf.d):00096         IT.CYL              RMB       2                   Number of cylinders
0019                  (            rbf.d):00097         IT.SID              RMB       1                   Number of surfaces
001A                  (            rbf.d):00098         IT.VFY              RMB       1                   Verify disk writes (0 = verify, 1 = don't)
001B                  (            rbf.d):00099         IT.SCT              RMB       2                   Default sectors/track
001D                  (            rbf.d):00100         IT.T0S              RMB       2                   Default sectors/track for track 0 sector 0
001F                  (            rbf.d):00101         IT.ILV              RMB       1                   Sector interleave offset
0020                  (            rbf.d):00102         IT.SAS              RMB       1                   Segment allocation size
                      (            rbf.d):00103         * The following fields are from the OS-9 Level One V2.00.00 Addendum
0021                  (            rbf.d):00104         IT.TFM              RMB       1                   DMA Transfer Mode
0022                  (            rbf.d):00105         IT.Exten            RMB       2                   Path Extension (PE) for record locking
0024                  (            rbf.d):00106         IT.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
                      (            rbf.d):00107         * The following fields are not copied to the path descriptor
0025                  (            rbf.d):00108         IT.WPC              RMB       1                   Write precomp cyl/4 (HD)
0026                  (            rbf.d):00109         IT.OFS              RMB       2                   Starting cylinder offset (HD)
0028                  (            rbf.d):00110         IT.RWC              RMB       2                   Reduced write current cylinder (HD)
                      (            rbf.d):00111         * These fields have been added because of SuperDriver.  They probably
                      (            rbf.d):00112         * can be used in other drivers
                      (            rbf.d):00113                             ORG       IT.WPC
0025                  (            rbf.d):00114         IT.SOFF1            RMB       1
0026                  (            rbf.d):00115         IT.SOFF2            RMB       1
0027                  (            rbf.d):00116         IT.SOFF3            RMB       1
0028                  (            rbf.d):00117         IT.LLDRV            RMB       2
002A                  (            rbf.d):00118         IT.MPI              RMB       1
                      (            rbf.d):00119         
                      (            rbf.d):00120         
                      (            rbf.d):00121         * IT.TYP Definitions
                      (            rbf.d):00122         *
     0080             (            rbf.d):00123         TYP.HARD            EQU       %10000000           Hard disk
     0000             (            rbf.d):00124         TYP.FLP             EQU       %00000000           Floppy disk
     0040             (            rbf.d):00125         TYP.NSF             EQU       %01000000           Non-standard format
     0000             (            rbf.d):00126         TYP.SOF             EQU       %00000000           Standard NitrOS-9 format
                      (            rbf.d):00127         
                      (            rbf.d):00128         * IT.TYP bit definitions if bit 7 of IT.TYP is set (hard disk)
     0000             (            rbf.d):00129         TYPH.256            EQU       %00000000           256 byte sector media
     0001             (            rbf.d):00130         TYPH.512            EQU       %00000001           512 byte sector media
     0002             (            rbf.d):00131         TYPH.1024           EQU       %00000010           1024 byte sector media
     0003             (            rbf.d):00132         TYPH.2048           EQU       %00000011           2048 byte sector media
     0003             (            rbf.d):00133         TYPH.SSM            EQU       %00000011           Sector size mask
     000C             (            rbf.d):00134         TYPH.DRSV           EQU       %00001100           Driver-reserved bits
     0010             (            rbf.d):00135         TYPH.DSQ            EQU       %00010000           Drive size query flag
                      (            rbf.d):00136         
                      (            rbf.d):00137         * IT.TYP bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (            rbf.d):00138         TYP.5               EQU       %00000000           5" media
     0001             (            rbf.d):00139         TYP.3               EQU       %00000001           3.5" media
     0002             (            rbf.d):00140         TYP.SBO             EQU       %00000010           Sector base offset (clear = 0; sect = 1)
     0000             (            rbf.d):00141         TYP.256             EQU       %00000000           256 byte sector media
     0004             (            rbf.d):00142         TYP.512             EQU       %00000100           512 byte sector media
     0020             (            rbf.d):00143         TYP.CCF             EQU       %00100000           CoCo format
     0000             (            rbf.d):00144         TYP.NCCF            EQU       %00000000           Non-CoCo format
                      (            rbf.d):00145         
                      (            rbf.d):00146         * IT.DNS Definitions
                      (            rbf.d):00147         *
                      (            rbf.d):00148         
                      (            rbf.d):00149         * If bit 7 of IT.TYP is set, IT.DNS is driver-dependent
                      (            rbf.d):00150         
                      (            rbf.d):00151         * IT.DNS bit definitions if bit 7 of IT.TYP is clear (floppy disk)
     0000             (            rbf.d):00152         DNS.FM              EQU       %00000000           Single-density (FM)
     0001             (            rbf.d):00153         DNS.MFM             EQU       %00000001           Double-density (MFM)
     0000             (            rbf.d):00154         DNS.STD             EQU       %00000000           Single track distance (48/135 tpi)
     0002             (            rbf.d):00155         DNS.DTD             EQU       %00000010           Double track distance (96 tpi)
                      (            rbf.d):00156         
                      (            rbf.d):00157         * Added PHS,2005-05-31, as format seems to use these
     0000             (            rbf.d):00158         DNS.FM0             EQU       %00000000           Single density track 0
     0004             (            rbf.d):00159         DNS.MFM0            EQU       %00000100           Double density track 0
                      (            rbf.d):00160         
                      (            rbf.d):00161         * Floppy disk step rate definitions
     0000             (            rbf.d):00162         STP.30ms            EQU       0                   30ms step rate
     0001             (            rbf.d):00163         STP.20ms            EQU       1                   20ms step rate
     0002             (            rbf.d):00164         STP.12ms            EQU       2                   12ms step rate
     0003             (            rbf.d):00165         STP.6ms             EQU       3                   6ms step rate
                      (            rbf.d):00166         
                      (            rbf.d):00167                             PAG
                      (            rbf.d):00168         *************************************
                      (            rbf.d):00169         * Random Block Path Descriptor Format
                      (            rbf.d):00170         *
                      (            rbf.d):00171         * A path descriptor is created for every new path that is open
                      (            rbf.d):00172         * via the I$Open system call (processed by IOMan).  Process
                      (            rbf.d):00173         * descriptors track state information of a path.
                      (            rbf.d):00174         *
                      (            rbf.d):00175                             ORG       PD.FST
000A                  (            rbf.d):00176         PD.SMF              RMB       1                   State flags
000B                  (            rbf.d):00177         PD.CP               RMB       4                   Current logical byte position
000F                  (            rbf.d):00178         PD.SIZ              RMB       4                   File size
0013                  (            rbf.d):00179         PD.SBL              RMB       3                   Segment beginning lsn
0016                  (            rbf.d):00180         PD.SBP              RMB       3                   Segment beginning psn
0019                  (            rbf.d):00181         PD.SSZ              RMB       3                   Segment size
001C                  (            rbf.d):00182         PD.DSK              RMB       2                   Disk id
001E                  (            rbf.d):00183         PD.DTB              RMB       2                   Drive table ptr
                      (            rbf.d):00184                             ORG       PD.OPT
0020                  (            rbf.d):00185                             RMB       1                   Device type
0021                  (            rbf.d):00186         PD.DRV              RMB       1                   Drive number
0022                  (            rbf.d):00187         PD.STP              RMB       1                   Step rate
0023                  (            rbf.d):00188         PD.TYP              RMB       1                   Disk device type (5" 8" other)
0024                  (            rbf.d):00189         PD.DNS              RMB       1                   Density capability
0025                  (            rbf.d):00190         PD.CYL              RMB       2                   Number of cylinders
0027                  (            rbf.d):00191         PD.SID              RMB       1                   Number of surfaces
0028                  (            rbf.d):00192         PD.VFY              RMB       1                   0=verify disk writes
0029                  (            rbf.d):00193         PD.SCT              RMB       2                   Default sectors/track
002B                  (            rbf.d):00194         PD.T0S              RMB       2                   Default sectors/track tr00,s0
002D                  (            rbf.d):00195         PD.ILV              RMB       1                   Sector interleave offset
002E                  (            rbf.d):00196         PD.SAS              RMB       1                   Segment allocation size
002F                  (            rbf.d):00197         PD.TFM              RMB       1                   DMA Transfer Mode
0030                  (            rbf.d):00198         PD.Exten            RMB       2                   Path Extension (PE) for record locking
0032                  (            rbf.d):00199         PD.SToff            RMB       1                   Sector/Track offsets (for "foreign" disk formats)
0033                  (            rbf.d):00200         PD.ATT              RMB       1                   File attributes
0034                  (            rbf.d):00201         PD.FD               RMB       3                   File descriptor psn (i.e. 3-byte inode number)
0037                  (            rbf.d):00202         PD.DFD              RMB       3                   Directory file descriptor psn (i.e. 3-byte inode number)
003A                  (            rbf.d):00203         PD.DCP              RMB       4                   File directory entry ptr
003E                  (            rbf.d):00204         PD.DVT              RMB       2                   User readable dev tbl ptr
                      (            rbf.d):00205         
                      (            rbf.d):00206         * State Flags
     0001             (            rbf.d):00207         BUFMOD              EQU       $01                 Buffer modified
     0002             (            rbf.d):00208         SINBUF              EQU       $02                 Sector in buffer
     0004             (            rbf.d):00209         FDBUF               EQU       $04                 File descriptor in buffer
                      (            rbf.d):00210         *EOFSEC equ $08 End of file sector
                      (            rbf.d):00211         *EOF equ $10 End of file
     0020             (            rbf.d):00212         InDriver            EQU       $20                 Currently in Disk Driver, or queued
     0040             (            rbf.d):00213         BufBusy             EQU       $40                 Buffer is currently busy
                      (            rbf.d):00214         
                      (            rbf.d):00215                             IFNE      Level-1
                      (            rbf.d):00216         ************************************
                      (            rbf.d):00217         * Random Block Path Extension Format
                      (            rbf.d):00218         *
                      (            rbf.d):00219         * RBF paths under Level Two have additional information that
                      (            rbf.d):00220         * is referenced by the path extension area.  These are 64-byte
                      (            rbf.d):00221         * allocs from the same table (D.PthDBT) as the Path Descriptors.
                      (            rbf.d):00222         *
                      (            rbf.d):00223                             ORG       0
0000                  (            rbf.d):00224         PE.PE               RMB       1                   PE path number
0001                  (            rbf.d):00225         PE.PDptr            RMB       2                   Back ptr to this PE's Path Descriptor
0003                  (            rbf.d):00226         PE.NxFil            RMB       2                   Drive Open-File list ptr
0005                  (            rbf.d):00227         PE.Confl            RMB       2                   Circular File Conflict list
0007                  (            rbf.d):00228         PE.Lock             RMB       1                   Path lockout status
0008                  (            rbf.d):00229         PE.LoLck            RMB       4                   Low Locked Logical addr
000C                  (            rbf.d):00230         PE.HiLck            RMB       4                   High Locked Logical addr
0010                  (            rbf.d):00231         PE.Wait             RMB       2                   PE ptr to (next) locked-out PE
0012                  (            rbf.d):00232         PE.TmOut            RMB       2                   Max ticks to wait for locked segment
0014                  (            rbf.d):00233         PE.Owner            RMB       1                   Process ID of owner of locked segment
0015                  (            rbf.d):00234         PE.Req              RMB       1                   Temp for PE.Lock in GAIN when LockSeg fails
0016                  (            rbf.d):00235         PE.Prior            RMB       1                   Temp for process priority while in driver
0017                  (            rbf.d):00236         PE.SigSg            RMB       1                   Signal code to send
0018                  (            rbf.d):00237         PE.SigID            RMB       1                   Process ID to send the signal to
0019                  (            rbf.d):00238                             RMB       32-.                Reserved
0020                  (            rbf.d):00239         PE.FilNm            RMB       32                  Temp for filename during directory search
                      (            rbf.d):00240         
                      (            rbf.d):00241         * PE.Lock status codes
     0000             (            rbf.d):00242         Unlocked            EQU       0                   No portion of file is locked
     0001             (            rbf.d):00243         RcdLock             EQU       1                   Record from LoLck to HiLck locked
     0002             (            rbf.d):00244         FileLock            EQU       2                   Entire file locked
     0004             (            rbf.d):00245         EofLock             EQU       4                   End of file is locked
                      (            rbf.d):00246                             ENDC
                      (            rbf.d):00247         
                      (            rbf.d):00248         
                      (            rbf.d):00249                             PAG
                      (            rbf.d):00250         ***********************
                      (            rbf.d):00251         * LSN0 Disk Data Format
                      (            rbf.d):00252         *
                      (            rbf.d):00253         * Logical Sector Number 0 is the first sector on an RBF formatted device
                      (            rbf.d):00254         * and contains information about the device's size and format.
                      (            rbf.d):00255         *
                      (            rbf.d):00256                             ORG       0
0000                  (            rbf.d):00257         DD.TOT              RMB       3                   Total number of sectors
0003                  (            rbf.d):00258         DD.TKS              RMB       1                   Track size in sectors
0004                  (            rbf.d):00259         DD.MAP              RMB       2                   Number of bytes in allocation bit map
0006                  (            rbf.d):00260         DD.BIT              RMB       2                   Number of sectors/bit
0008                  (            rbf.d):00261         DD.DIR              RMB       3                   Address of root directory fd
000B                  (            rbf.d):00262         DD.OWN              RMB       2                   Owner
000D                  (            rbf.d):00263         DD.ATT              RMB       1                   Attributes
000E                  (            rbf.d):00264         DD.DSK              RMB       2                   Disk ID
0010                  (            rbf.d):00265         DD.FMT              RMB       1                   Disk format; density/sides
0011                  (            rbf.d):00266         DD.SPT              RMB       2                   Sectors/track
0013                  (            rbf.d):00267         DD.RES              RMB       2                   Reserved for future use
     0015             (            rbf.d):00268         DD.SIZ              EQU       .                   Device descriptor minimum size
0015                  (            rbf.d):00269         DD.BT               RMB       3                   System bootstrap sector
0018                  (            rbf.d):00270         DD.BSZ              RMB       2                   Size of system bootstrap
001A                  (            rbf.d):00271         DD.DAT              RMB       5                   Creation date
001F                  (            rbf.d):00272         DD.NAM              RMB       32                  Volume name
003F                  (            rbf.d):00273         DD.OPT              RMB       32                  Option area
                      (            rbf.d):00274         
                      (            rbf.d):00275         *************************
                      (            rbf.d):00276         * 2012/11/09 Gene Heskett - Some additions for bootlink etc use.
                      (            rbf.d):00277                             ORG       $60                 More options from device descriptor
0060                  (            rbf.d):00278         VD.STP              RMB       1                   This is for the /sh and /ih virtual disks in HDBDOS
0061                  (            rbf.d):00279         VD.OFS              RMB       3                   This is DT.WPC and DT.OSF combined, might be more
                      (            rbf.d):00280         
                      (            rbf.d):00281         * DD.FMT Bit Definitions - valid only if device is a floppy disk
     0001             (            rbf.d):00282         FMT.SIDE            EQU       %00000001           Single Sided=0, Double Sided=1
     0002             (            rbf.d):00283         FMT.DNS             EQU       %00000010           Single Density=0, Double Density=1
     0004             (            rbf.d):00284         FMT.TDNS            EQU       %00000100           Track Density: 48/135 TPI=0, 96 TPI=1
     0020             (            rbf.d):00285         FMT.T0DN            EQU       %00100000           Track 0 Density, see FMT.DNS
                      (            rbf.d):00286         
                      (            rbf.d):00287         
                      (            rbf.d):00288                             PAG
                      (            rbf.d):00289         ************************
                      (            rbf.d):00290         * File Descriptor Format
                      (            rbf.d):00291         *
                      (            rbf.d):00292         * The file descriptor is a sector that is present for every file
                      (            rbf.d):00293         * on an RBF device.  It contains attributes, modification dates,
                      (            rbf.d):00294         * and segment information on a file.
                      (            rbf.d):00295         *
                      (            rbf.d):00296                             ORG       0
0000                  (            rbf.d):00297         FD.ATT              RMB       1                   Attributes
0001                  (            rbf.d):00298         FD.OWN              RMB       2                   Owner
0003                  (            rbf.d):00299         FD.DAT              RMB       5                   Date last modified
0008                  (            rbf.d):00300         FD.LNK              RMB       1                   Link count
0009                  (            rbf.d):00301         FD.SIZ              RMB       4                   File size
000D                  (            rbf.d):00302         FD.Creat            RMB       3                   File creation date (YY/MM/DD)
     0010             (            rbf.d):00303         FD.SEG              EQU       .                   Beginning of segment list
                      (            rbf.d):00304         * Segment List Entry Format
                      (            rbf.d):00305                             ORG       0
0000                  (            rbf.d):00306         FDSL.A              RMB       3                   Segment beginning physical sector number
0003                  (            rbf.d):00307         FDSL.B              RMB       2                   Segment size
     0005             (            rbf.d):00308         FDSL.S              EQU       .                   Segment list entry size
     00FB             (            rbf.d):00309         FD.LS1              EQU       FD.SEG+((256-FD.SEG)/FDSL.S-1)*FDSL.S
     00FA             (            rbf.d):00310         FD.LS2              EQU       (256/FDSL.S-1)*FDSL.S
     0010             (            rbf.d):00311         MINSEC              SET       16
                      (            rbf.d):00312         
                      (            rbf.d):00313         
                      (            rbf.d):00314                             PAG
                      (            rbf.d):00315         ************************
                      (            rbf.d):00316         * Directory Entry Format
                      (            rbf.d):00317         *
                      (            rbf.d):00318         * Directory entries are part of a directory and define the name
                      (            rbf.d):00319         * of the file, as well as a pointer to its file descriptor.
                      (            rbf.d):00320         *
                      (            rbf.d):00321                             ORG       0
0000                  (            rbf.d):00322         DIR.NM              RMB       29                  File name
001D                  (            rbf.d):00323         DIR.FD              RMB       3                   File descriptor physical sector number
     0020             (            rbf.d):00324         DIR.SZ              EQU       .                   Directory record size
                      (            rbf.d):00325         
                      (            rbf.d):00326         
                      (            rbf.d):00327                             PAG
                      (            rbf.d):00328         ********************
                      (            rbf.d):00329         * RBF Static Storage
                      (            rbf.d):00330         *
                      (            rbf.d):00331         * Overall Disk Static Storage
                      (            rbf.d):00332         *
                      (            rbf.d):00333         * Note:  This does not reserve any memory for drive tables.  Each
                      (            rbf.d):00334         *        driver is responsible for reserving sufficient memory for
                      (            rbf.d):00335         *        the appropriate number of tables.
                      (            rbf.d):00336         *
                      (            rbf.d):00337                             ORG       V.USER              Reserve required           ($06)
0006                  (            rbf.d):00338         V.NDRV              RMB       1                   Number of drives           ($07)
0007                  (            rbf.d):00339                             RMB       8                   reserved                   ($08)
     000F             (            rbf.d):00340         DRVBEG              EQU       .                   Beginning of drive tables  ($10)
                      (            rbf.d):00341         
                      (            rbf.d):00342         
                      (            rbf.d):00343                             PAG
                      (            rbf.d):00344         ****************
                      (            rbf.d):00345         * Global Storage For Disk Drive Tables
                      (            rbf.d):00346         *
                      (            rbf.d):00347         * Each table contains the first 'DD.SIZ' bytes from
                      (            rbf.d):00348         * LSN 0, and the current track, stepping rate,
                      (            rbf.d):00349         * bitmap use flag, and disk type.
                      (            rbf.d):00350         *
                      (            rbf.d):00351                             ORG       0
0000                  (            rbf.d):00352                             RMB       DD.SIZ              Device descriptor, LSN 0
0015                  (            rbf.d):00353         V.TRAK              RMB       2                   Current track
0017                  (            rbf.d):00354         V.BMB               RMB       1                   Bit-map use flag
0018                  (            rbf.d):00355         V.FileHd            RMB       2                   Open file list for this drive
001A                  (            rbf.d):00356         V.DiskID            RMB       2                   Disk ID
001C                  (            rbf.d):00357         V.BMapSz            RMB       1                   Bitmap Size
001D                  (            rbf.d):00358         V.MapSct            RMB       1                   Lowest reasonable bitmap sector
001E                  (            rbf.d):00359         V.ResBit            RMB       1                   Reserved bitmap sector (for compaction)
001F                  (            rbf.d):00360         V.ScTkOf            RMB       1                   Sector/Track byte (Combined from descriptor)
0020                  (            rbf.d):00361         V.ScOfst            RMB       1                   Sector offset split from byte above
0021                  (            rbf.d):00362         V.TkOfst            RMB       1                   Track offset split from byte above
0022                  (            rbf.d):00363                             RMB       4                   Reserved
     0026             (            rbf.d):00364         DRVMEM              EQU       .
                      (            rbf.d):00365         
                      (            rbf.d):00366                             ENDC
