                      (/../../defs/scf.d):00159                             PAG
                      (/../../defs/scf.d):00160         *********************************************
                      (/../../defs/scf.d):00161         * Sequential Character Path Descriptor Format
                      (/../../defs/scf.d):00162         *
                      (/../../defs/scf.d):00163         * A path descriptor is created for every new path that is open
                      (/../../defs/scf.d):00164         * via the I$Open system call (processed by IOMan).  Process
                      (/../../defs/scf.d):00165         * descriptors track state information of a path.
                      (/../../defs/scf.d):00166         *
                      (/../../defs/scf.d):00167                             ORG       PD.FST
000A                  (/../../defs/scf.d):00168         PD.DV2              RMB       2                   Output device table pointer
000C                  (/../../defs/scf.d):00169         PD.RAW              RMB       1                   Read/Write or ReadLn/WritLn mode
000D                  (/../../defs/scf.d):00170         PD.MAX              RMB       2                   ReadLn high byte count
000F                  (/../../defs/scf.d):00171         PD.MIN              RMB       1                   Devices are "mine" if clear
0010                  (/../../defs/scf.d):00172         PD.STS              RMB       2                   Status routine module addr
0012                  (/../../defs/scf.d):00173         PD.STM              RMB       2                   Reserved for status routine
                      (/../../defs/scf.d):00174                             ORG       PD.OPT
0020                  (/../../defs/scf.d):00175                             RMB       1                   Device type
0021                  (/../../defs/scf.d):00176         PD.UPC              RMB       1                   Case (0=both, 1=upper only)
0022                  (/../../defs/scf.d):00177         PD.BSO              RMB       1                   Backspace (0=BSE, 1=BSE,SP,BSE)
0023                  (/../../defs/scf.d):00178         PD.DLO              RMB       1                   Delete (0=BSE over line, 1=CRLF)
0024                  (/../../defs/scf.d):00179         PD.EKO              RMB       1                   Echo (0=No Echo)
0025                  (/../../defs/scf.d):00180         PD.ALF              RMB       1                   Auto linefeed (0=No auto LF)
0026                  (/../../defs/scf.d):00181         PD.NUL              RMB       1                   End of Line null count
0027                  (/../../defs/scf.d):00182         PD.PAU              RMB       1                   Page pause (0=No end of page pause)
0028                  (/../../defs/scf.d):00183         PD.PAG              RMB       1                   Lines per page
0029                  (/../../defs/scf.d):00184         PD.BSP              RMB       1                   Backspace character
002A                  (/../../defs/scf.d):00185         PD.DEL              RMB       1                   Delete Line character
002B                  (/../../defs/scf.d):00186         PD.EOR              RMB       1                   End of Record character (read only)
002C                  (/../../defs/scf.d):00187         PD.EOF              RMB       1                   End of File character
002D                  (/../../defs/scf.d):00188         PD.RPR              RMB       1                   Repront Line character
002E                  (/../../defs/scf.d):00189         PD.DUP              RMB       1                   Dup Last Line character
002F                  (/../../defs/scf.d):00190         PD.PSC              RMB       1                   Pause character
0030                  (/../../defs/scf.d):00191         PD.INT              RMB       1                   Keyboard interrupt character (CTRL-C)
0031                  (/../../defs/scf.d):00192         PD.QUT              RMB       1                   Keyboard quit character (CTRL-E)
0032                  (/../../defs/scf.d):00193         PD.BSE              RMB       1                   Backspace echo character
0033                  (/../../defs/scf.d):00194         PD.OVF              RMB       1                   Line overflow character (BELL)
0034                  (/../../defs/scf.d):00195         PD.PAR              RMB       1                   Parity code
0035                  (/../../defs/scf.d):00196         PD.BAU              RMB       1                   ACIA baud rate (Color Computer)
0036                  (/../../defs/scf.d):00197         PD.D2P              RMB       2                   Offset of DEV2 name
0038                  (/../../defs/scf.d):00198         PD.XON              RMB       1                   ACIA X-ON character
0039                  (/../../defs/scf.d):00199         PD.XOFF             RMB       1                   ACIA X-OFF character
     001A             (/../../defs/scf.d):00200         OPTCNT              EQU       .-PD.OPT            Total user settable options
003A                  (/../../defs/scf.d):00201         PD.ERR              RMB       1                   Most recent I/O error status
003B                  (/../../defs/scf.d):00202         PD.TBL              RMB       2                   Device table addr (copy)
003D                  (/../../defs/scf.d):00203         PD.PLP              RMB       2                   Path Descriptor List Pointer
003F                  (/../../defs/scf.d):00204         PD.PST              RMB       1                   Current path status
                      (/../../defs/scf.d):00205         
                      (/../../defs/scf.d):00206         
                      (/../../defs/scf.d):00207         * PD.PST values Path Descriptor Status byte
                      (/../../defs/scf.d):00208         *
     0001             (/../../defs/scf.d):00209         PST.DCD             EQU       %00000001           Set if DCD is lost on Serial port
                      (/../../defs/scf.d):00210         
                      (/../../defs/scf.d):00211         
                      (/../../defs/scf.d):00212         * PD.PAR definitions
                      (/../../defs/scf.d):00213         *
                      (/../../defs/scf.d):00214         * Parity
     0000             (/../../defs/scf.d):00215         PARNONE             EQU       %00000000
     0020             (/../../defs/scf.d):00216         PARODD              EQU       %00100000
     0060             (/../../defs/scf.d):00217         PAREVEN             EQU       %01100000
     00A0             (/../../defs/scf.d):00218         PARMARK             EQU       %10100000
     00E0             (/../../defs/scf.d):00219         PARSPACE            EQU       %11100000
     00E0             (/../../defs/scf.d):00220         PARMASK             EQU       %11100000
                      (/../../defs/scf.d):00221         
                      (/../../defs/scf.d):00222         * PD.BAU definitions
                      (/../../defs/scf.d):00223         *
                      (/../../defs/scf.d):00224         * Baud rate
     0000             (/../../defs/scf.d):00225         B110                EQU       %00000000
     0001             (/../../defs/scf.d):00226         B300                EQU       %00000001
     0002             (/../../defs/scf.d):00227         B600                EQU       %00000010
     0003             (/../../defs/scf.d):00228         B1200               EQU       %00000011
     0004             (/../../defs/scf.d):00229         B2400               EQU       %00000100
     0005             (/../../defs/scf.d):00230         B4800               EQU       %00000101
     0006             (/../../defs/scf.d):00231         B9600               EQU       %00000110
     0007             (/../../defs/scf.d):00232         B19200              EQU       %00000111
     0008             (/../../defs/scf.d):00233         B38400              EQU       %00001000
     0009             (/../../defs/scf.d):00234         B57600              EQU       %00001001
     000A             (/../../defs/scf.d):00235         B115200             EQU       %00001010
                      (/../../defs/scf.d):00236         * Word size
     0000             (/../../defs/scf.d):00237         WORD8               EQU       %00000000
     0020             (/../../defs/scf.d):00238         WORD7               EQU       %00100000
                      (/../../defs/scf.d):00239         * Stop bits
     0000             (/../../defs/scf.d):00240         STOP1               EQU       %00000000
     0010             (/../../defs/scf.d):00241         STOP2               EQU       %00010000
                      (/../../defs/scf.d):00242         
                      (/../../defs/scf.d):00243                             ENDC
