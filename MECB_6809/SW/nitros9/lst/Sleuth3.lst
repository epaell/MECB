0005                  (/../../defs/os9.d):01130         R$X                 EQU       6                   X Index register
0005                  (/../../defs/os9.d):01131         R$Y                 EQU       8                   Y Index register
0005                  (/../../defs/os9.d):01132         R$U                 EQU       10                  User Stack register
0005                  (/../../defs/os9.d):01133         R$PC                EQU       12                  Program Counter register
0005                  (/../../defs/os9.d):01134         R$Size              EQU       14                  Total register package size
                      (/../../defs/os9.d):01135                             ELSE
     0003             (/../../defs/os9.d):01136         R$DP                EQU       3                   Direct Page register
     0004             (/../../defs/os9.d):01137         R$X                 EQU       4                   X Index register
     0006             (/../../defs/os9.d):01138         R$Y                 EQU       6                   Y Index register
     0008             (/../../defs/os9.d):01139         R$U                 EQU       8                   User Stack register
     000A             (/../../defs/os9.d):01140         R$PC                EQU       10                  Program Counter register
     000C             (/../../defs/os9.d):01141         R$Size              EQU       12                  Total register package size
                      (/../../defs/os9.d):01142                             ENDC
                      (/../../defs/os9.d):01143         
                      (/../../defs/os9.d):01144         * MD register masks
                      (/../../defs/os9.d):01145         * 6309 definitions
     0080             (/../../defs/os9.d):01146         DIV0                EQU       %10000000           division by 0 trap flag       : 1 = trap occured
     0040             (/../../defs/os9.d):01147         badinstr            EQU       %01000000           illegal instruction trap flag : 1 = trap occured
                      (/../../defs/os9.d):01148         
     0080             (/../../defs/os9.d):01149         Entire              EQU       %10000000           Full Register Stack flag
     0040             (/../../defs/os9.d):01150         FIRQMask            EQU       %01000000           Fast-Interrupt Mask bit
     0020             (/../../defs/os9.d):01151         HalfCrry            EQU       %00100000           Half Carry flag
     0010             (/../../defs/os9.d):01152         IRQMask             EQU       %00010000           Interrupt Mask bit
     0008             (/../../defs/os9.d):01153         Negative            EQU       %00001000           Negative flag
     0004             (/../../defs/os9.d):01154         Zero                EQU       %00000100           Zero flag
     0002             (/../../defs/os9.d):01155         TwosOvfl            EQU       %00000010           Two's Comp Overflow flag
     0001             (/../../defs/os9.d):01156         Carry               EQU       %00000001           Carry bit
     0050             (/../../defs/os9.d):01157         IntMasks            EQU       IRQMask+FIRQMask
     0080             (/../../defs/os9.d):01158         Sign                EQU       %10000000           sign bit
