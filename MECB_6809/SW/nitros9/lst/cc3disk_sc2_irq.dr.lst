                      (            os9.d):00308         *******************
                      (            os9.d):00309         * File Access Modes
                      (            os9.d):00310         *
     0001             (            os9.d):00311         READ.               EQU       %00000001
     0002             (            os9.d):00312         WRITE.              EQU       %00000010
     0003             (            os9.d):00313         UPDAT.              EQU       READ.+WRITE.
     0004             (            os9.d):00314         EXEC.               EQU       %00000100
     0008             (            os9.d):00315         PREAD.              EQU       %00001000
     0010             (            os9.d):00316         PWRIT.              EQU       %00010000
