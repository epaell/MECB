                      (3disk_sc2_irq.asm):00001         ********************************************************************
                      (3disk_sc2_irq.asm):00002         * CC3Disk - Disto No Halt Super Controller II disk driver
                      (3disk_sc2_irq.asm):00003         *
                      (3disk_sc2_irq.asm):00004         * This driver their interrupt driven driver. It is a no halt
                      (3disk_sc2_irq.asm):00005         * (multitasking) disk driver that uses interrupts. Care must be
                      (3disk_sc2_irq.asm):00006         * taken that no other hardware will conflict.
                      (3disk_sc2_irq.asm):00007         *
                      (3disk_sc2_irq.asm):00008         * Ed.    Comments                                       Who YY/MM/DD
                      (3disk_sc2_irq.asm):00009         * ------------------------------------------------------------------
                      (3disk_sc2_irq.asm):00010         *  02    Fist disassembled                              tjl 02/08/27
                      (3disk_sc2_irq.asm):00011         
                      (3disk_sc2_irq.asm):00012                             nam       CC3Disk
                      (3disk_sc2_irq.asm):00013                             ttl       os9 device driver
                      (3disk_sc2_irq.asm):00014         
                      (3disk_sc2_irq.asm):00015         * Disassembled 02/08/27 11:42:37 by Disasm v1.6 (C) 1988 by RML
                      (3disk_sc2_irq.asm):00016         
                      (3disk_sc2_irq.asm):00017         * Disto's Super Controller II supports two locations for its
                      (3disk_sc2_irq.asm):00018         * registers: $FF74 and $FF58
                      (3disk_sc2_irq.asm):00019         
     FF74             (3disk_sc2_irq.asm):00020         nh_base             equ       $FF74
     FF74             (3disk_sc2_irq.asm):00021         nh_stat             equ       nh_base
     FF76             (3disk_sc2_irq.asm):00022         nh_data             equ       nh_base+2
                      (3disk_sc2_irq.asm):00023         
                      (3disk_sc2_irq.asm):00024                             ifp1
