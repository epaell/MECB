;* CP/M-86 version of iomodule get routine

;* Last update: 13-Jan-1986  by Gerhard Stegemann

	NAME	GETREC

DATA	SEGMENT	PUBLIC

	INCLUDE	'FIBDEF.I86'

	EXTRN	@LFB : WORD	; ^FIB;

DATA	ENDS

CODE	SEGMENT	PUBLIC

	ASSUME	DS:DATA, CS:CODE

	EXTRN	@RNB : NEAR
	PUBLIC	GET

;    PROCEDURE GET(VAR F : FIB; SZ : INTEGER);

;    VAR
;        IS_EOLN : BOOLEAN;

is_eoln	EQU	BYTE PTR [BP-1]

;    BEGIN

GET	PROC	NEAR

	PUSH 	BP
	MOV 	BP,SP
	SUB  	SP,1

;      @LFB := ADDR(F);

	LES 	DI,DWORD PTR 6[BP]
	MOV 	@LFB,DI
	MOV 	@LFB + 2,ES

;      F.FEOLN := FALSE;     (* Default is that we reset it *)

	MOV 	ES:BYTE PTR feoln[DI],FALSE

;      IF F.FEOF THEN

	TEST	ES:BYTE PTR feof[DI],TRUE
	JZ	L0041

;        BEGIN
;          F.FEOLN := TRUE;

	MOV	ES:BYTE PTR feoln[DI],TRUE

;          EXIT;

	JMP 	SHORT L010F

;        END;

;      @RNB;                 (* Go read from the file/console *)

L0041:	CALL 	@RNB

;      IF F.FTEXT THEN       (* Text file, EOLN/EOF must be set *)

	LES	DI,DWORD PTR 6[BP]
	TEST	ES:BYTE PTR ftext[DI],TRUE
	JZ	L010F

;        BEGIN
;          IF F.FBUFFER[0] = CHR($1A) THEN
;            F.FEOF := TRUE;

	CMP 	ES:BYTE PTR fbuffer[DI],1AH
	JNZ 	L008B
	MOV 	ES:BYTE PTR feof[DI],TRUE

;         IS_EOLN := (F.FBUFFER[0] = CHR($0D)); (* $0D for CP/M-86 *)

L008B:	XOR	AX,AX
	CMP 	ES:BYTE PTR fbuffer[DI],0DH
	JNZ 	L00A7
	INC	AX
L00A7:	MOV 	is_eoln,AL

;          IF IS_EOLN OR F.FEOF THEN

	TEST	AL,TRUE
	JNZ	L00C5
	TEST	ES:BYTE PTR feof[DI],TRUE
	JZ 	L00CF

;            F.FEOLN := TRUE;

L00C5:	MOV	ES:BYTE PTR feoln[DI],TRUE

;          IF IS_EOLN THEN

L00CF:	TEST	is_eoln,TRUE
	JZ 	L00EE

;            IF F.OPTION = FRDWR THEN (* Gobble LF *)

	CMP	ES:BYTE PTR option[DI],2
	JNZ 	L00EE

;              @RNB;

	CALL 	@RNB

;          IF F.FEOLN THEN

L00EE:	LES	DI,DWORD PTR 6[BP]
	TEST 	ES:BYTE PTR feoln[DI],TRUE
	JZ 	L010F

;            F.FBUFFER[0] := ' ';

	MOV	ES:BYTE PTR fbuffer[DI],20H

;        END;
;
;    END;

L010F:	MOV 	SP,BP
	POP	BP
	RET 	6

GET	ENDP

CODE	ENDS

	END

